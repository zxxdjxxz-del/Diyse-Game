authoring_notes = "Audit75 CLOSED-AUTHORITY IMPLEMENTATION SHELL. S013 is approved/closed. Exact prior full dialogue was not serialized to a recoverable artifact. Preserve the completed-action Memory Scribe rule, flooded Archive attrition, Archive Leviathan one-HP-bar state progression, and the exact thirty-one-transfers discovery. Do not reconstruct missing dialogue here."
beats = [{"beat_id":"S013_B001","cues":{"staging":"Enter the flooded Sunken Archive through recognizable Diysean infrastructure. Current surprise is preservation/function at depth, not discovery that ancient underground sites existed."}},
{"beat_id":"S013_B002","cues":{"staging":"Hostile Archive traversal uses established ecology and encounter suppression around mandatory evidence pockets. Ancient storage location does not make every surviving notation ancient; modern Black Host entries can exist inside old infrastructure.","implementation_flags":["PLAYER_CONTROL","ARCHIVE_HOSTILE_LEG"]}},
{"beat_id":"S013_B003","cues":{"staging":"Memory Scribe may record only a completed eligible action. It copies the action/function, not the actor's body choreography, and never reads an uncompleted queued choice."}},
{"beat_id":"S013_B004","cues":{"staging":"Protected conditional wording: if Ilyra is actually the copied actor, the approved line is 'It copied me.' Otherwise use the actual copied actor's approved variant or the generic 'It copied that.' This shell intentionally does not serialize an unconditional speaker line because the dialogue Resource schema has no branching condition field.","implementation_flags":["CONDITIONAL_COPIED_ACTOR_LINE_NOT_SERIALIZED"]}},
{"beat_id":"S013_B005","cues":{"staging":"Archive Leviathan uses one HP bar with authored behavior/state progression. Do not create a second boss body or refill health."}},
{"beat_id":"S013_B006","cues":{"staging":"The protected exchange 'Same one?' / 'Yes.' is legal only if the active Recorded Pattern actually persists across the authored threshold. If it does not persist in the implemented state, omit that exchange.","implementation_flags":["CONDITIONAL_RECORDED_PATTERN_PERSISTS"]}},
{"beat_id":"S013_B007","cues":{"staging":"Physical evidence leads from Archive records toward transferred people/prisoner infrastructure. Preserve the discovery wording exactly as 'thirty-one transfers'. The surviving archive does not establish the original speaker assignment in this implementation shell, so do not invent one. It refers to transfer records, not thirty-one people standing together in one room."}},
{"beat_id":"S013_B008","cues":{"staging":"Substantial recovery after the Leviathan before prisoner-rescue pressure. End by leading into the Prisoner Galleries, not by resolving the human consequences in exposition.","implementation_flags":["HANDOFF_TO_S014"]}}]
