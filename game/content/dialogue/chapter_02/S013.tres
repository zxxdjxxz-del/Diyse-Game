authoring_notes = "Chapter 2 exact Resource conversion from docs/chapters/dialogue/chapter_02/S013.md under Complete Master Canon v1.64 / Audit79, Chapter transcript checkpoint Audit78. Spoken text is line-complete and must not be rewritten. Source staging/prose is preserved in cue metadata; source subsection and source speaker labels are carried in cues. Portrait slots remain empty until approved assets are wired. Spoken-sequence SHA-256: b226634d5dc6679090f368c797e3e0dc52638c5f87d11a79fa03b2f56a03c3b8."
beats = [
{"beat_id": "S013_B001", "speaker_id": "cyanis", "text": "It kept the water out.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — LOWERED STONE THROAT", "source_speaker_label": "CYANIS", "staging": "The party descends from Dunmere into the Archive. Water drips through seams. Pale preservation channels still function in sections of wall. The ramp ahead disappears into black water."}},
{"beat_id": "S013_B002", "speaker_id": "ilyra", "text": "Not all of it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — LOWERED STONE THROAT", "source_speaker_label": "ILYRA"}},
{"beat_id": "S013_B003", "speaker_id": "maevra", "text": "Then stay where the stone is still doing its job.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — LOWERED STONE THROAT", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S013_B004", "speaker_id": "torren", "text": "The floor drops ahead.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — LOWERED STONE THROAT", "source_speaker_label": "TORREN", "staging": "Torren checks the submerged floor."}},
{"beat_id": "S013_B005", "speaker_id": "cyanis", "text": "How far?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — LOWERED STONE THROAT", "source_speaker_label": "CYANIS"}},
{"beat_id": "S013_B006", "speaker_id": "torren", "text": "Far enough.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — LOWERED STONE THROAT", "source_speaker_label": "TORREN"}},
{"beat_id": "S013_B007", "speaker_id": "maevra", "text": "Rope.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "RETURN_PLAYER_CONTROL"], "source_section": "B001 — LOWERED STONE THROAT", "source_speaker_label": "MAEVRA", "staging": "Maevra takes out the rope.", "staging_after": "Control returns."}},
{"beat_id": "S013_B008", "speaker_id": "torren", "text": "Gets deeper.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 1 — FLOODED STACKS", "source_speaker_label": "TORREN", "staging": "A moderate first dungeon stretch. The player moves through partially submerged archive stacks, narrow raised walkways, and two connected preservation rooms. The same core environment kit is reused with different shelving arrangements and water levels.\n\nExpected first-pass pressure: roughly 2–3 random encounters, depending on movement and encounter rolls.\n\nEnemies begin simple enough for the player to learn the Archive ecology before combinations get harder.\n\nOne short optional side route contains a chest and a collapsed records alcove. No mandatory lore.\n\nMidway through the area, Torren secures the rope over a broken section."}},
{"beat_id": "S013_B009", "speaker_id": "cyanis", "text": "Of course it does.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 1 — FLOODED STACKS", "source_speaker_label": "CYANIS"}},
{"beat_id": "S013_B010", "speaker_id": "torren", "text": "Mostly solid.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 1 — FLOODED STACKS", "source_speaker_label": "TORREN", "staging": "Torren tests the next slab. A crack. Everyone stops."}},
{"beat_id": "S013_B011", "speaker_id": "cyanis", "text": "Mostly?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 1 — FLOODED STACKS", "source_speaker_label": "CYANIS"}},
{"beat_id": "S013_B012", "speaker_id": "torren", "text": "You want certainty, go back upstairs.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 1 — FLOODED STACKS", "source_speaker_label": "TORREN"}},
{"beat_id": "S013_B013", "speaker_id": "cyanis", "text": "Fair assumption.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 1 — FLOODED STACKS", "source_speaker_label": "CYANIS"}},
{"beat_id": "S013_B014", "speaker_id": "torren", "text": "Two ways.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 1 — FLOODED STACKS", "source_speaker_label": "TORREN", "staging": "They cross. A little later, the route forks."}},
{"beat_id": "S013_B015", "speaker_id": "maevra", "text": "Which one's dry?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 1 — FLOODED STACKS", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S013_B016", "speaker_id": "torren", "text": "Neither.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 1 — FLOODED STACKS", "source_speaker_label": "TORREN"}},
{"beat_id": "S013_B017", "speaker_id": "maevra", "text": "Which one's less wet?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 1 — FLOODED STACKS", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S013_B018", "speaker_id": "torren", "text": "Left.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 1 — FLOODED STACKS", "source_speaker_label": "TORREN", "staging": "Torren points."}},
{"beat_id": "S013_B019", "speaker_id": "cyanis", "text": "Excellent system.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 1 — FLOODED STACKS", "source_speaker_label": "CYANIS"}},
{"beat_id": "S013_B020", "speaker_id": "torren", "text": "You're welcome.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 1 — FLOODED STACKS", "source_speaker_label": "TORREN", "staging_after": "Control remains with the player. The left route leads toward the powered preservation wing."}},
{"beat_id": "S013_B021", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "A small powered records room interrupts the traversal. Not a long cutscene. A Memory Scribe activates as the party crosses the central floor.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "B002 — MEMORY SCRIBE CHAMBER"}},
{"beat_id": "S013_B022", "speaker_id": "ilyra", "text": "It copied me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF"], "source_section": "AUTHORED MEMORY SCRIBE ENCOUNTER", "source_speaker_label": "ILYRA", "staging": "The Scribe reacts only after an eligible action actually completes.\n\nIt does not read menu selections or predicted commands.\n\nOnce an action is recorded, it reproduces a weaker functional version.\n\nIf Ilyra was actually copied:"}},
{"beat_id": "S013_B023", "speaker_id": "party_actor", "text": "It copied that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF"], "source_section": "AUTHORED MEMORY SCRIBE ENCOUNTER", "source_speaker_label": "PARTY ACTOR", "staging": "If another actor was recorded, use that actor-specific equivalent or:"}},
{"beat_id": "S013_B024", "speaker_id": "maevra", "text": "When?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF"], "source_section": "AUTHORED MEMORY SCRIBE ENCOUNTER", "source_speaker_label": "MAEVRA", "staging": "The fight ends. Maevra looks at the inactive machine."}},
{"beat_id": "S013_B025", "speaker_id": "torren", "text": "After you moved.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF"], "source_section": "AUTHORED MEMORY SCRIBE ENCOUNTER", "source_speaker_label": "TORREN", "staging": "Torren wipes water from an arrow."}},
{"beat_id": "S013_B026", "speaker_id": "maevra", "text": "So it sees the action first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF"], "source_section": "AUTHORED MEMORY SCRIBE ENCOUNTER", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S013_B027", "speaker_id": "cyanis", "text": "Fair assumption.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF"], "source_section": "AUTHORED MEMORY SCRIBE ENCOUNTER", "source_speaker_label": "CYANIS"}},
{"beat_id": "S013_B028", "speaker_id": "maevra", "text": "Then change what you give it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF"], "source_section": "AUTHORED MEMORY SCRIBE ENCOUNTER", "source_speaker_label": "MAEVRA", "staging": "Maevra looks toward the next corridor."}},
{"beat_id": "S013_B029", "speaker_id": "torren", "text": "I was planning to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF"], "source_section": "AUTHORED MEMORY SCRIBE ENCOUNTER", "source_speaker_label": "TORREN", "staging": "Torren retrieves the rest of his arrows."}},
{"beat_id": "S013_B030", "speaker_id": "cyanis", "text": "Sure.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF"], "source_section": "AUTHORED MEMORY SCRIBE ENCOUNTER", "source_speaker_label": "CYANIS"}},
{"beat_id": "S013_B031", "speaker_id": "torren", "text": "Fuck off.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF"], "source_section": "AUTHORED MEMORY SCRIBE ENCOUNTER", "source_speaker_label": "TORREN", "staging_after": "They move."}},
{"beat_id": "S013_B032", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "Another moderate stretch rather than an immediate story room.\n\nExpected first-pass pressure: roughly 2–3 random encounters.\n\nMemory Scribes may now appear in normal formations, paired with simpler Archive enemies so the player gets to apply what the authored encounter just taught them.\n\nThe environment slowly changes. Ancient shelving remains, but newer repairs begin appearing: metal brackets, replaced hinges, fresh scrape marks, and sections where silt has recently been disturbed. Nobody stops to explain every clue. The player sees the pattern forming.\n\nOne optional side room has supplies or a chest.\n\nAnother contains damaged archive shelving and nothing important.\n\nToward the end of the stretch, the party reaches an old water-control room.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "EXPLORATION 2 — PRESERVATION / TRANSFER WING"}},
{"beat_id": "S013_B033", "speaker_id": "torren", "text": "Hold up.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHAT CAME THROUGH HERE", "source_speaker_label": "TORREN", "staging": "Torren stops."}},
{"beat_id": "S013_B034", "speaker_id": "ilyra", "text": "These aren't patrol tracks.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHAT CAME THROUGH HERE", "source_speaker_label": "ILYRA", "staging": "Everyone does. Tracks cross the wet floor. Some are normal footsteps. Others are uneven. One set drags on one side. Another becomes two parallel scrape marks.\n\nIlyra crouches."}},
{"beat_id": "S013_B035", "speaker_id": "maevra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHAT CAME THROUGH HERE", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S013_B036", "speaker_id": "torren", "text": "They came through there.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHAT CAME THROUGH HERE", "source_speaker_label": "TORREN", "staging": "Torren follows the marks toward a sealed service gate."}},
{"beat_id": "S013_B037", "speaker_id": "cyanis", "text": "Walking?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHAT CAME THROUGH HERE", "source_speaker_label": "CYANIS", "staging": "Cyanis looks at the floor."}},
{"beat_id": "S013_B038", "speaker_id": "ilyra", "text": "Some of them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHAT CAME THROUGH HERE", "source_speaker_label": "ILYRA", "staging": "Ilyra studies it."}},
{"beat_id": "S013_B039", "speaker_id": "ilyra", "text": "Not all.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHAT CAME THROUGH HERE", "source_speaker_label": "ILYRA", "staging": "She points to the deeper drag marks."}},
{"beat_id": "S013_B040", "speaker_id": "maevra", "text": "Can we open it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHAT CAME THROUGH HERE", "source_speaker_label": "MAEVRA", "staging": "Silence. Maevra tries the old release. Nothing."}},
{"beat_id": "S013_B041", "speaker_id": "torren", "text": "Not from here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHAT CAME THROUGH HERE", "source_speaker_label": "TORREN", "staging": "Torren checks the mechanism."}},
{"beat_id": "S013_B042", "speaker_id": "cyanis", "text": "Other way?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHAT CAME THROUGH HERE", "source_speaker_label": "CYANIS"}},
{"beat_id": "S013_B043", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHAT CAME THROUGH HERE", "source_speaker_label": "TORREN", "staging": "Torren looks toward the next flooded passage."}},
{"beat_id": "S013_B044", "speaker_id": "cyanis", "text": "Of course it's underwater.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHAT CAME THROUGH HERE", "source_speaker_label": "CYANIS", "staging": "Cyanis follows his gaze."}},
{"beat_id": "S013_B045", "speaker_id": "torren", "text": "Not all of it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHAT CAME THROUGH HERE", "source_speaker_label": "TORREN"}},
{"beat_id": "S013_B046", "speaker_id": "torren", "text": "Don't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHAT CAME THROUGH HERE", "source_speaker_label": "TORREN", "staging": "Ilyra looks at him. Torren realizes what he just said.", "staging_after": "She almost smiles. They move."}},
{"beat_id": "S013_B047", "speaker_id": "ilyra", "text": "How bad?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 3 — CURRENT GALLERIES", "source_speaker_label": "ILYRA", "staging": "This is the longest stretch in S013, but still moderate, not oversized.\n\nExpected first-pass pressure: roughly 3–4 random encounters before the recovery pocket.\n\nThe water is deeper in places, alternating between raised archive paths, knee-deep lanes, one section with a stronger lateral current, and a dry upper shelf that provides an optional treasure route.\n\nNo precision platforming. Traversal is simple positioning, ramps, stairs, and route choice.\n\nEnemy formations now mix previously introduced Archive enemies more aggressively.\n\nA Drowned Archive Maw can appear as a tougher regular/elite encounter here rather than requiring a separate story scene.\n\nAfter one particularly rough encounter, Cyanis braces against the wall. Ilyra sees it."}},
{"beat_id": "S013_B048", "speaker_id": "cyanis", "text": "I'm functional.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 3 — CURRENT GALLERIES", "source_speaker_label": "CYANIS"}},
{"beat_id": "S013_B049", "speaker_id": "ilyra", "text": "That wasn't the question.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 3 — CURRENT GALLERIES", "source_speaker_label": "ILYRA"}},
{"beat_id": "S013_B050", "speaker_id": "cyanis", "text": "It was the answer I had.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 3 — CURRENT GALLERIES", "source_speaker_label": "CYANIS"}},
{"beat_id": "S013_B051", "speaker_id": "ilyra", "text": "Anything broken?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 3 — CURRENT GALLERIES", "source_speaker_label": "ILYRA", "staging": "She steps closer."}},
{"beat_id": "S013_B052", "speaker_id": "cyanis", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 3 — CURRENT GALLERIES", "source_speaker_label": "CYANIS"}},
{"beat_id": "S013_B053", "speaker_id": "ilyra", "text": "Dizzy?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 3 — CURRENT GALLERIES", "source_speaker_label": "ILYRA"}},
{"beat_id": "S013_B054", "speaker_id": "cyanis", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 3 — CURRENT GALLERIES", "source_speaker_label": "CYANIS"}},
{"beat_id": "S013_B055", "speaker_id": "ilyra", "text": "Sick?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 3 — CURRENT GALLERIES", "source_speaker_label": "ILYRA"}},
{"beat_id": "S013_B056", "speaker_id": "cyanis", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 3 — CURRENT GALLERIES", "source_speaker_label": "CYANIS"}},
{"beat_id": "S013_B057", "speaker_id": "cyanis", "text": "Wet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 3 — CURRENT GALLERIES", "source_speaker_label": "CYANIS", "staging": "Beat."}},
{"beat_id": "S013_B058", "speaker_id": "ilyra", "text": "Tragic.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 3 — CURRENT GALLERIES", "source_speaker_label": "ILYRA"}},
{"beat_id": "S013_B059", "speaker_id": "cyanis", "text": "Thank you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 3 — CURRENT GALLERIES", "source_speaker_label": "CYANIS", "staging_after": "They keep moving. No bespoke medical animation."}},
{"beat_id": "S013_B060", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "A side branch contains the Archive Duplicant. It is optional. It may reward equipment/materials, but no mandatory story information is hidden behind it. The main route bypasses the room entirely.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "OPTIONAL ELITE ROOM"}},
{"beat_id": "S013_B061", "speaker_id": "cyanis", "text": "I'm throwing these away.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SAFE_DIALOGUE_POCKET"], "source_section": "RECOVERY POCKET", "source_speaker_label": "CYANIS", "staging": "Before the Leviathan basin, the party reaches a dry preservation alcove. This is a clear safe zone. Save/recovery/menu access as appropriate to the game’s established systems. No full camp scene.\n\nShort ambient exchange only if the player remains in the area. Cyanis wrings water from one glove."}},
{"beat_id": "S013_B062", "speaker_id": "torren", "text": "No, you're not.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SAFE_DIALOGUE_POCKET"], "source_section": "RECOVERY POCKET", "source_speaker_label": "TORREN"}},
{"beat_id": "S013_B063", "speaker_id": "cyanis", "text": "They're soaked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SAFE_DIALOGUE_POCKET"], "source_section": "RECOVERY POCKET", "source_speaker_label": "CYANIS"}},
{"beat_id": "S013_B064", "speaker_id": "torren", "text": "They're gloves.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SAFE_DIALOGUE_POCKET"], "source_section": "RECOVERY POCKET", "source_speaker_label": "TORREN"}},
{"beat_id": "S013_B065", "speaker_id": "cyanis", "text": "Wet gloves.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SAFE_DIALOGUE_POCKET"], "source_section": "RECOVERY POCKET", "source_speaker_label": "CYANIS"}},
{"beat_id": "S013_B066", "speaker_id": "torren", "text": "Still gloves.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SAFE_DIALOGUE_POCKET"], "source_section": "RECOVERY POCKET", "source_speaker_label": "TORREN"}},
{"beat_id": "S013_B067", "speaker_id": "maevra", "text": "I'm begging both of you to shut up.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SAFE_DIALOGUE_POCKET"], "source_section": "RECOVERY POCKET", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S013_B068", "speaker_id": "ilyra", "text": "Seconded.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "RETURN_PLAYER_CONTROL", "SAFE_DIALOGUE_POCKET"], "source_section": "RECOVERY POCKET", "source_speaker_label": "ILYRA", "staging": "Ilyra sits for a moment.", "staging_after": "Silence. Then control returns fully."}},
{"beat_id": "S013_B069", "speaker_id": "torren", "text": "Don't move.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — LEVIATHAN BASIN", "source_speaker_label": "TORREN", "staging": "The Archive opens into a large preservation basin. A records platform stands beyond the water. No portrait dialogue at first.\n\nSomething moves beneath the surface. Torren stops."}},
{"beat_id": "S013_B070", "speaker_id": "cyanis", "text": "That's large.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — LEVIATHAN BASIN", "source_speaker_label": "CYANIS", "staging": "A wake crosses below the walkway."}},
{"beat_id": "S013_B071", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — LEVIATHAN BASIN", "source_speaker_label": "TORREN"}},
{"beat_id": "S013_B072", "speaker_id": "maevra", "text": "Can we avoid it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — LEVIATHAN BASIN", "source_speaker_label": "MAEVRA", "staging": "Another wake. Closer. Maevra readies her weapon."}},
{"beat_id": "S013_B073", "speaker_id": "torren", "text": "Not if we're going there.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — LEVIATHAN BASIN", "source_speaker_label": "TORREN", "staging": "Torren looks toward the records platform."}},
{"beat_id": "S013_B074", "speaker_id": "ilyra", "text": "We're going there.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — LEVIATHAN BASIN", "source_speaker_label": "ILYRA", "staging": "Ilyra looks at the disturbed water.", "staging_after": "The water breaks."}},
{"beat_id": "S013_B075", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "One HP bar. Two authored behavior states. No refill.\n\nCheap 2.5D presentation: the battle arena uses the same basin environment.\n\nLeviathan body remains primarily a large readable 3D/battle-space threat.\n\nShort illustrated cut-in for the threshold.\n\nWater level/current and lighting shift, then battle resumes immediately.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING", "BOSS_HANDOFF"], "source_section": "BOSS — ARCHIVE LEVIATHAN"}},
{"beat_id": "S013_B076", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "The Leviathan uses the Archive's recorded-pattern behavior. Completed eligible actions may be recorded and answered by weaker functional equivalents. The state is visible to the player.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "STATE A"}},
{"beat_id": "S013_B077", "speaker_id": "cyanis", "text": "Same one?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SAME_BAR_THRESHOLD"], "source_section": "SAME-BAR THRESHOLD", "source_speaker_label": "CYANIS", "staging": "The Leviathan dives. Water pulls toward the basin center. Short visual beat. It resurfaces in the altered arena state. No damage from the transition itself. No second HP bar.\n\nIf a Recorded Pattern actually persists through the threshold:"}},
{"beat_id": "S013_B078", "speaker_id": "torren", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SAME_BAR_THRESHOLD"], "source_section": "SAME-BAR THRESHOLD", "source_speaker_label": "TORREN", "staging_after": "If none persists, the exchange does not happen."}},
{"beat_id": "S013_B079", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "The Leviathan becomes more physically aggressive. Higher direct pressure. Broader undertow/water control. Recorded patterns decay rather than building forever. The boss falls on the same HP bar.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "STATE B"}},
{"beat_id": "S013_B080", "speaker_id": "ilyra", "text": "These aren't ancient.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THIRTY-ONE", "source_speaker_label": "ILYRA", "staging": "The water settles. No victory pose. The records platform unlocks. The party crosses. Maevra checks the available exits while Ilyra examines records that are visibly newer than the surrounding Archive material."}},
{"beat_id": "S013_B081", "speaker_id": "maevra", "text": "These are transfers.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THIRTY-ONE", "source_speaker_label": "MAEVRA", "staging": "Maevra comes over. She reads."}},
{"beat_id": "S013_B082", "speaker_id": "maevra", "text": "Thirty-one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THIRTY-ONE", "source_speaker_label": "MAEVRA", "staging": "She scans the entries."}},
{"beat_id": "S013_B083", "speaker_id": "cyanis", "text": "Thirty-one what?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THIRTY-ONE", "source_speaker_label": "CYANIS"}},
{"beat_id": "S013_B084", "speaker_id": "maevra", "text": "People.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THIRTY-ONE", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S013_B085", "speaker_id": "ilyra", "text": "Where were they sent?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THIRTY-ONE", "source_speaker_label": "ILYRA", "staging": "Silence. Ilyra takes another sheet. Dates. Condition marks. Routing codes."}},
{"beat_id": "S013_B086", "speaker_id": "maevra", "text": "Deeper.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THIRTY-ONE", "source_speaker_label": "MAEVRA", "staging": "Maevra traces the route."}},
{"beat_id": "S013_B087", "speaker_id": "torren", "text": "Same direction as the tracks.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THIRTY-ONE", "source_speaker_label": "TORREN", "staging": "Torren looks toward the service gate."}},
{"beat_id": "S013_B088", "speaker_id": "maevra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THIRTY-ONE", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S013_B089", "speaker_id": "cyanis", "text": "Thirty-one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THIRTY-ONE", "source_speaker_label": "CYANIS", "staging": "Cyanis looks back at the page."}},
{"beat_id": "S013_B090", "speaker_id": "maevra", "text": "Recorded.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THIRTY-ONE", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S013_B091", "speaker_id": "ilyra", "text": "Meaning that's what this record accounts for.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THIRTY-ONE", "source_speaker_label": "ILYRA"}},
{"beat_id": "S013_B092", "speaker_id": "maevra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THIRTY-ONE", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S013_B093", "speaker_id": "torren", "text": "Not everyone who came through.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THIRTY-ONE", "source_speaker_label": "TORREN"}},
{"beat_id": "S013_B094", "speaker_id": "maevra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THIRTY-ONE", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S013_B095", "speaker_id": "cyanis", "text": "Open it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THIRTY-ONE", "source_speaker_label": "CYANIS", "staging": "Nobody tries to make the number more certain than it is.\n\nCyanis looks at the gate."}},
{"beat_id": "S013_B096", "speaker_id": "cyanis", "text": "Harth.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "BOSS_HANDOFF"], "source_section": "SHORT POST-BOSS TRAVERSAL — SERVICE ROUTE", "source_speaker_label": "CYANIS", "staging": "The gate opens from this side. The next stretch is deliberately short. No giant fourth dungeon section.\n\nThe player gets a few minutes of movement through a drier service corridor.\n\nThe architecture begins looking increasingly used: newer braces, recent footprints, replaced door hardware, scrapes on the walls.\n\nA small random encounter window can remain active at the start of this route—likely no more than one encounter on a normal first pass.\n\nThen the player crosses an authored threshold. Random encounters shut off.\n\nA barred structure becomes visible ahead. Movement behind it. A faint sound. Everyone stops.\n\nA cough. Human. Cyanis looks at Torren."}},
{"beat_id": "S013_B097", "speaker_id": "torren", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "BOSS_HANDOFF"], "source_section": "SHORT POST-BOSS TRAVERSAL — SERVICE ROUTE", "source_speaker_label": "TORREN", "staging_after": "No joke. They move forward. Another cough.\n\n**END S013. S014 — Prisoner Galleries begins immediately beyond the bars.**"}}
]
