{"beat_id": "S016_B060", "speaker_id": "torren", "text": "Accessible.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — USEFUL", "source_speaker_label": "TORREN"}},
