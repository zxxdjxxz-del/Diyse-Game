beats = [
{"beat_id": "S016_B001", "speaker_id": "maevra", "text": "Causeway?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SAFE_DIALOGUE_POCKET"], "source_section": "B001 — SAFE POCKET", "source_speaker_label": "MAEVRA", "staging": "Same Prisoner Galleries room from S014. Only a few prisoner sprites are visible. Everyone else is implied through voices and offscreen movement.\n\nTorren returns from checking the route."}},
{"beat_id": "S016_B002", "speaker_id": "torren", "text": "Walking, yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SAFE_DIALOGUE_POCKET"], "source_section": "B001 — SAFE POCKET", "source_speaker_label": "TORREN"}},
{"beat_id": "S016_B003", "speaker_id": "ilyra", "text": "That, no.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SAFE_DIALOGUE_POCKET"], "source_section": "B001 — SAFE POCKET", "source_speaker_label": "ILYRA", "staging": "Ilyra looks toward the injured people."}},
{"beat_id": "S016_B004", "speaker_id": "torren", "text": "Then it isn’t open.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SAFE_DIALOGUE_POCKET"], "source_section": "B001 — SAFE POCKET", "source_speaker_label": "TORREN", "staging": "Torren looks over."}},
{"beat_id": "S016_B005", "speaker_id": "cyanis", "text": "What needs moving?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SAFE_DIALOGUE_POCKET"], "source_section": "B001 — SAFE POCKET", "source_speaker_label": "CYANIS"}},
{"beat_id": "S016_B006", "speaker_id": "torren", "text": "Come on.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SAFE_DIALOGUE_POCKET"], "source_section": "B001 — SAFE POCKET", "source_speaker_label": "TORREN"}},
{"beat_id": "S016_B007", "speaker_id": "torren", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "SHORT PLAYABLE INTERACTION", "source_speaker_label": "TORREN", "staging": "Same Causeway environment. Cyanis and Torren clear one obstruction. Existing interaction poses. One environment-state swap.\n\nTorren checks the opening.", "staging_after": "Cut back."}},
{"beat_id": "S016_B008", "speaker_id": "maevra", "text": "Move.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — MOVE", "source_speaker_label": "MAEVRA", "staging": "Maevra faces the prisoners.", "staging_after": "A few visible sprites begin walking. The rest of the column is conveyed through footsteps and voices. Transition to Causeway."}},
{"beat_id": "S016_B009", "speaker_id": "maevra", "text": "Keep walking.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — CAUSEWAY", "source_speaker_label": "MAEVRA", "staging": "One primary Causeway environment. Three or four evacuee sprites appear at different positions to represent the larger column."}},
{"beat_id": "S016_B010", "speaker_id": "maevra", "text": "Do not run.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — CAUSEWAY", "source_speaker_label": "MAEVRA", "staging": "Movement gets faster behind them."}},
{"beat_id": "S016_B011", "speaker_id": "maevra", "text": "Follow Harth.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — CAUSEWAY", "source_speaker_label": "MAEVRA", "staging": "Torren moves ahead.", "staging_after": "Control remains with the player. No random encounters."}},
{"beat_id": "S016_B012", "speaker_id": "evacuee", "text": "My brother.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — MY BROTHER", "source_speaker_label": "EVACUEE", "staging": "An evacuee stops beside the barred side route established earlier."}},
{"beat_id": "S016_B013", "speaker_id": "torren", "text": "I don’t know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — MY BROTHER", "source_speaker_label": "TORREN", "staging": "Torren stops."}},
{"beat_id": "S016_B014", "speaker_id": "evacuee", "text": "That’s where they were sent.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — MY BROTHER", "source_speaker_label": "EVACUEE"}},
{"beat_id": "S016_B015", "speaker_id": "torren", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — MY BROTHER", "source_speaker_label": "TORREN", "staging": "Torren looks through the bars."}},
{"beat_id": "S016_B016", "speaker_id": "torren", "text": "We can’t go that way now.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — MY BROTHER", "source_speaker_label": "TORREN", "staging": "The evacuee stays there.", "staging_after": "No promise. No invented answer. After a moment, the evacuee rejoins the column."}},
{"beat_id": "S016_B017", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "The camera does not make a dramatic reveal out of the branch. But the player sees the sealed route one more time. The branch remains inaccessible during the evacuation. That matters later.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "IMPORTANT WORLD-STATE SETUP"}},
{"beat_id": "S016_B018", "speaker_id": "torren", "text": "They’re cutting the column.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE JUNCTION", "source_speaker_label": "TORREN", "staging": "Same Causeway kit, alternate camera position. Torren sees Black Host movement."}},
{"beat_id": "S016_B019", "speaker_id": "cyanis", "text": "Then we don’t let them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE JUNCTION", "source_speaker_label": "CYANIS", "staging": "Cyanis turns."}},
{"beat_id": "S016_B020", "speaker_id": "ilyra", "text": "Hold this.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE JUNCTION", "source_speaker_label": "ILYRA", "staging": "Ilyra gives an evacuee a folded dressing."}},
{"beat_id": "S016_B021", "speaker_id": "evacuee", "text": "Here?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE JUNCTION", "source_speaker_label": "EVACUEE"}},
{"beat_id": "S016_B022", "speaker_id": "ilyra", "text": "Hard.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE JUNCTION", "source_speaker_label": "ILYRA"}},
{"beat_id": "S016_B023", "speaker_id": "ilyra", "text": "Keep holding it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE JUNCTION", "source_speaker_label": "ILYRA", "staging": "He presses down.", "staging_after": "Battle transition."}},
{"beat_id": "S016_B024", "speaker_id": "maevra", "text": "Center.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF", "MANDATORY_COMBAT_01_OF_01"], "source_section": "HOLD THE JUNCTION", "source_speaker_label": "MAEVRA", "staging": "Only mandatory combat in S016. Same Causeway battle environment. The evacuee column stays mostly offscreen.\n\nScale comes from footsteps, voices, silhouettes, and simple progress scripting. Finite enemy pressure. No separate second encounter.\n\nShort barks only."}},
{"beat_id": "S016_B025", "speaker_id": "torren", "text": "Got it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF", "MANDATORY_COMBAT_01_OF_01"], "source_section": "HOLD THE JUNCTION", "source_speaker_label": "TORREN"}},
{"beat_id": "S016_B026", "speaker_id": "cyanis", "text": "Left.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF", "MANDATORY_COMBAT_01_OF_01"], "source_section": "HOLD THE JUNCTION", "source_speaker_label": "CYANIS"}},
{"beat_id": "S016_B027", "speaker_id": "ilyra", "text": "They’re through.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF", "MANDATORY_COMBAT_01_OF_01"], "source_section": "HOLD THE JUNCTION", "source_speaker_label": "ILYRA", "staging": "Later:", "staging_after": "The immediate force is defeated. No victory pose."}},
{"beat_id": "S016_B028", "speaker_id": "cyanis", "text": "Route?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — KEEP MOVING", "source_speaker_label": "CYANIS", "staging": "Return to Causeway exploration state."}},
{"beat_id": "S016_B029", "speaker_id": "torren", "text": "I do right now.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — KEEP MOVING", "source_speaker_label": "TORREN"}},
{"beat_id": "S016_B030", "speaker_id": "cyanis", "text": "Good enough.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — KEEP MOVING", "source_speaker_label": "CYANIS"}},
{"beat_id": "S016_B031", "speaker_id": "torren", "text": "Upper side.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — KEEP MOVING", "source_speaker_label": "TORREN", "staging": "Torren points."}},
{"beat_id": "S016_B032", "speaker_id": "maevra", "text": "Upper route!", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — KEEP MOVING", "source_speaker_label": "MAEVRA", "staging": "Maevra calls back.", "staging_after": "Offscreen acknowledgment. Short movement. Fade."}},
{"beat_id": "S016_B033", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "Same Causeway environment. The gate opens. A few evacuee sprites cross. Fade. The same sprites are repositioned on the safe side. That represents the larger extraction.\n\nThe evacuee looking for his brother reaches safety. He turns back toward the gate. Still watches. No answer.\n\n> **FINAL EXTRACTION THRESHOLD.**\n\nFrom this point forward: No combat.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING", "NO_COMBAT_AFTER_THIS_BEAT"], "source_section": "B007 — FINAL GATE"}},
{"beat_id": "S016_B034", "speaker_id": "ilyra", "text": "How’s the knee?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — SAFE SIDE", "source_speaker_label": "ILYRA", "staging": "Reuse Dunmere emergency staging from S012. Different lighting. Minimal additions: a few evacuees, one healer, blankets, water barrels.\n\nIlyra checks the injured man."}},
{"beat_id": "S016_B035", "speaker_id": "injured_man", "text": "Still attached.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — SAFE SIDE", "source_speaker_label": "INJURED MAN"}},
{"beat_id": "S016_B036", "speaker_id": "ilyra", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — SAFE SIDE", "source_speaker_label": "ILYRA"}},
{"beat_id": "S016_B037", "speaker_id": "injured_man", "text": "That’s it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — SAFE SIDE", "source_speaker_label": "INJURED MAN"}},
{"beat_id": "S016_B038", "speaker_id": "ilyra", "text": "For now.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — SAFE SIDE", "source_speaker_label": "ILYRA"}},
{"beat_id": "S016_B039", "speaker_id": "maevra", "text": "Stay there.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — SAFE SIDE", "source_speaker_label": "MAEVRA", "staging": "Nearby, Cyanis sits against a crate. Maevra passes."}},
{"beat_id": "S016_B040", "speaker_id": "cyanis", "text": "Wasn’t moving.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — SAFE SIDE", "source_speaker_label": "CYANIS"}},
{"beat_id": "S016_B041", "speaker_id": "maevra", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — SAFE SIDE", "source_speaker_label": "MAEVRA", "staging_after": "She keeps walking."}},
{"beat_id": "S016_B042", "speaker_id": "maevra", "text": "Causeway?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — USEFUL", "source_speaker_label": "MAEVRA", "staging": "Torren returns from the Causeway."}},
{"beat_id": "S016_B043", "speaker_id": "torren", "text": "Do you want the short answer or the useful one?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — USEFUL", "source_speaker_label": "TORREN"}},
{"beat_id": "S016_B044", "speaker_id": "maevra", "text": "Useful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — USEFUL", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S016_B045", "speaker_id": "torren", "text": "West brace is done.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — USEFUL", "source_speaker_label": "TORREN"}},
{"beat_id": "S016_B046", "speaker_id": "torren", "text": "Center should hold until morning.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — USEFUL", "source_speaker_label": "TORREN", "staging": "Beat."}},
{"beat_id": "S016_B047", "speaker_id": "maevra", "text": "Should?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — USEFUL", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S016_B048", "speaker_id": "torren", "text": "You asked for useful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — USEFUL", "source_speaker_label": "TORREN"}},
{"beat_id": "S016_B049", "speaker_id": "maevra", "text": "What does Marr need?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — USEFUL", "source_speaker_label": "MAEVRA", "staging": "Maevra looks toward the route."}},
{"beat_id": "S016_B050", "speaker_id": "torren", "text": "Timber.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — USEFUL", "source_speaker_label": "TORREN"}},
{"beat_id": "S016_B051", "speaker_id": "maevra", "text": "How much?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — USEFUL", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S016_B052", "speaker_id": "torren", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — USEFUL", "source_speaker_label": "TORREN", "staging": "Torren looks back."}},
{"beat_id": "S016_B053", "speaker_id": "maevra", "text": "Helpful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — USEFUL", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S016_B054", "speaker_id": "torren", "text": "Usually am.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — USEFUL", "source_speaker_label": "TORREN"}},
{"beat_id": "S016_B055", "speaker_id": "torren", "text": "One more thing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — USEFUL", "source_speaker_label": "TORREN", "staging": "He starts to leave. Then stops."}},
{"beat_id": "S016_B056", "speaker_id": "torren", "text": "Bastion controls dropped the west branch lock.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — USEFUL", "source_speaker_label": "TORREN", "staging": "Maevra looks at him."}},
