beats = [
{"beat_id": "C06_B001", "speaker_id": "cyanis", "text": "You seen my glove?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — THE GLOVE", "source_speaker_label": "CYANIS", "staging": "Later. Same Dunmere staging area from S016. Most activity has moved offscreen. A lantern sits on a rough table.\n\nTorren is seated, sorting a short length of cord and a few pieces of damaged gear. One chair beside him is empty. Cyanis stands nearby looking through his things."}},
{"beat_id": "C06_B002", "speaker_id": "torren", "text": "Which one?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — THE GLOVE", "source_speaker_label": "TORREN"}},
{"beat_id": "C06_B003", "speaker_id": "cyanis", "text": "My glove.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — THE GLOVE", "source_speaker_label": "CYANIS"}},
{"beat_id": "C06_B004", "speaker_id": "cyanis", "text": "Left.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — THE GLOVE", "source_speaker_label": "CYANIS", "staging": "Beat."}},
{"beat_id": "C06_B005", "speaker_id": "torren", "text": "Your other left.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — THE GLOVE", "source_speaker_label": "TORREN", "staging": "Torren looks at him."}},
{"beat_id": "C06_B006", "speaker_id": "cyanis", "text": "Fuck you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — THE GLOVE", "source_speaker_label": "CYANIS", "staging": "Cyanis looks down. The glove is tucked under his opposite arm. Beat.", "staging_after": "Torren goes back to what he was doing. Ilyra arrives carrying a cup. She looks at the empty chair. Then at the other two. Nobody says anything about it. She sits. That was her seat."}},
{"beat_id": "C06_B007", "speaker_id": "ilyra", "text": "What happened to that?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STRING WITH CONFIDENCE", "source_speaker_label": "ILYRA", "staging": "Ilyra looks at what Torren is working on."}},
{"beat_id": "C06_B008", "speaker_id": "torren", "text": "Nothing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STRING WITH CONFIDENCE", "source_speaker_label": "TORREN"}},
{"beat_id": "C06_B009", "speaker_id": "torren", "text": "Nothing important.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STRING WITH CONFIDENCE", "source_speaker_label": "TORREN", "staging": "The cord is visibly frayed. Ilyra looks at him."}},
{"beat_id": "C06_B010", "speaker_id": "cyanis", "text": "This is rope?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STRING WITH CONFIDENCE", "source_speaker_label": "CYANIS", "staging": "Cyanis picks up the loose end."}},
{"beat_id": "C06_B011", "speaker_id": "torren", "text": "Cord.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STRING WITH CONFIDENCE", "source_speaker_label": "TORREN"}},
{"beat_id": "C06_B012", "speaker_id": "cyanis", "text": "It’s string with confidence.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STRING WITH CONFIDENCE", "source_speaker_label": "CYANIS", "staging": "Cyanis turns it over."}},
{"beat_id": "C06_B013", "speaker_id": "torren", "text": "Fuck you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STRING WITH CONFIDENCE", "source_speaker_label": "TORREN", "staging": "Torren looks up."}},
{"beat_id": "C06_B014", "speaker_id": "ilyra", "text": "He has a point.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STRING WITH CONFIDENCE", "source_speaker_label": "ILYRA", "staging": "Ilyra takes a drink."}},
{"beat_id": "C06_B015", "speaker_id": "torren", "text": "I liked you better an hour ago.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STRING WITH CONFIDENCE", "source_speaker_label": "TORREN"}},
{"beat_id": "C06_B016", "speaker_id": "ilyra", "text": "No, you didn’t.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STRING WITH CONFIDENCE", "source_speaker_label": "ILYRA"}},
{"beat_id": "C06_B017", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STRING WITH CONFIDENCE", "source_speaker_label": "TORREN", "staging": "Torren considers that."}},
{"beat_id": "C06_B018", "speaker_id": "ilyra", "text": "This feels organized.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — ORGANIZED", "source_speaker_label": "ILYRA", "staging": "The table is covered with gear that has somehow divided itself into three small piles. Ilyra looks over it."}},
{"beat_id": "C06_B019", "speaker_id": "torren", "text": "It isn’t.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — ORGANIZED", "source_speaker_label": "TORREN", "staging": "Torren does not look up."}},
{"beat_id": "C06_B020", "speaker_id": "cyanis", "text": "Manageable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — ORGANIZED", "source_speaker_label": "CYANIS", "staging": "Cyanis pushes one item from his pile into Torren’s. Torren pushes it back."}},
{"beat_id": "C06_B021", "speaker_id": "ilyra", "text": "Your faces did.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — ORGANIZED", "source_speaker_label": "ILYRA", "staging": "Ilyra looks at Cyanis. Then Torren."}},
{"beat_id": "C06_B022", "speaker_id": "cyanis", "text": "What did my face do?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — ORGANIZED", "source_speaker_label": "CYANIS", "staging": "Cyanis looks at Torren."}},
{"beat_id": "C06_B023", "speaker_id": "torren", "text": "Complained.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — ORGANIZED", "source_speaker_label": "TORREN"}},
{"beat_id": "C06_B024", "speaker_id": "cyanis", "text": "I didn’t say anything.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — ORGANIZED", "source_speaker_label": "CYANIS"}},
{"beat_id": "C06_B025", "speaker_id": "torren", "text": "Didn’t need to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — ORGANIZED", "source_speaker_label": "TORREN", "staging_after": "Ilyra drinks again."}},
{"beat_id": "C06_B026", "speaker_id": "torren", "text": "West perimeter needs moving before dark.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WEST PERIMETER", "source_speaker_label": "TORREN", "staging": "Torren reaches for another piece of cord."}},
{"beat_id": "C06_B027", "speaker_id": "cyanis", "text": "Already did.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WEST PERIMETER", "source_speaker_label": "CYANIS"}},
{"beat_id": "C06_B028", "speaker_id": "torren", "text": "You finally learned something.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WEST PERIMETER", "source_speaker_label": "TORREN", "staging": "Torren stops. Looks at him."}},
{"beat_id": "C06_B029", "speaker_id": "cyanis", "text": "You showed me once.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WEST PERIMETER", "source_speaker_label": "CYANIS"}},
{"beat_id": "C06_B030", "speaker_id": "torren", "text": "Twice.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WEST PERIMETER", "source_speaker_label": "TORREN"}},
{"beat_id": "C06_B031", "speaker_id": "cyanis", "text": "Once sober.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WEST PERIMETER", "source_speaker_label": "CYANIS"}},
{"beat_id": "C06_B032", "speaker_id": "torren", "text": "That is not how that happened.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WEST PERIMETER", "source_speaker_label": "TORREN", "staging": "Ilyra looks at Torren. Torren points at Cyanis."}},
{"beat_id": "C06_B033", "speaker_id": "cyanis", "text": "That’s how I remember it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WEST PERIMETER", "source_speaker_label": "CYANIS"}},
{"beat_id": "C06_B034", "speaker_id": "torren", "text": "Your memory’s shit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WEST PERIMETER", "source_speaker_label": "TORREN"}},
{"beat_id": "C06_B035", "speaker_id": "cyanis", "text": "Convenient, though.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WEST PERIMETER", "source_speaker_label": "CYANIS"}},
{"beat_id": "C06_B036", "speaker_id": "ilyra", "text": "Do I want the other version?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WEST PERIMETER", "source_speaker_label": "ILYRA", "staging": "Ilyra looks between them."}},
{"beat_id": "C06_B037", "speaker_id": "cyanis", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WEST PERIMETER", "source_speaker_label": "CYANIS"}},
{"beat_id": "C06_B038", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WEST PERIMETER", "source_speaker_label": "TORREN"}},
{"beat_id": "C06_B039", "speaker_id": "ilyra", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WEST PERIMETER", "source_speaker_label": "ILYRA", "staging": "Ilyra nods."}},
{"beat_id": "C06_B040", "speaker_id": "torren", "text": "Knife.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — KNIFE", "source_speaker_label": "TORREN", "staging": "Torren reaches across the table without looking."}},
{"beat_id": "C06_B041", "speaker_id": "cyanis", "text": "Which knife?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — KNIFE", "source_speaker_label": "CYANIS", "staging": "Cyanis looks over the scattered gear."}},
{"beat_id": "C06_B042", "speaker_id": "torren", "text": "My knife.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — KNIFE", "source_speaker_label": "TORREN", "staging": "Torren finally looks at him."}},
{"beat_id": "C06_B043", "speaker_id": "ilyra", "text": "There.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — KNIFE", "source_speaker_label": "ILYRA", "staging": "Ilyra points beside Torren’s elbow."}},
{"beat_id": "C06_B044", "speaker_id": "torren", "text": "Don’t.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — KNIFE", "source_speaker_label": "TORREN", "staging": "Torren looks down. His knife is directly beside his hand. Cyanis smiles. Torren picks it up."}},
{"beat_id": "C06_B045", "speaker_id": "cyanis", "text": "I haven’t said anything.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — KNIFE", "source_speaker_label": "CYANIS"}},
{"beat_id": "C06_B046", "speaker_id": "torren", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — KNIFE", "source_speaker_label": "TORREN"}},
{"beat_id": "C06_B047", "speaker_id": "cyanis", "text": "We could probably—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — KNIFE", "source_speaker_label": "CYANIS", "staging": "Cyanis watches him trim the frayed cord. Then:"}},
{"beat_id": "C06_B048", "speaker_id": "ilyra_torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — KNIFE", "source_speaker_label": "ILYRA / TORREN", "simultaneous_speakers": ["ilyra", "torren"]}},
{"beat_id": "C06_B049", "speaker_id": "cyanis", "text": "You don’t even know what I was going to say.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — KNIFE", "source_speaker_label": "CYANIS", "staging": "Cyanis looks between them."}},
{"beat_id": "C06_B050", "speaker_id": "torren", "text": "Yes, I do.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — KNIFE", "source_speaker_label": "TORREN", "staging": "Torren keeps cutting."}},
{"beat_id": "C06_B051", "speaker_id": "ilyra", "text": "So do I.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — KNIFE", "source_speaker_label": "ILYRA", "staging": "Ilyra nods."}},
{"beat_id": "C06_B052", "speaker_id": "cyanis", "text": "That’s fucking insulting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — KNIFE", "source_speaker_label": "CYANIS", "staging_after": "Neither answers."}},
{"beat_id": "C06_B053", "speaker_id": "torren", "text": "Seriously?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STOP", "source_speaker_label": "TORREN", "staging": "Torren ties off the repair. Then immediately reaches for the next damaged piece. Ilyra puts her hand on it first. Torren looks at her. She moves it to the far side of the table. No speech.\n\nTorren reaches for another. Cyanis takes that one and puts it beside the first. Torren looks at him."}},
{"beat_id": "C06_B054", "speaker_id": "cyanis", "text": "Apparently.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STOP", "source_speaker_label": "CYANIS", "staging": "Cyanis leans back."}},
{"beat_id": "C06_B055", "speaker_id": "ilyra", "text": "You’re done.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STOP", "source_speaker_label": "ILYRA", "staging": "Torren looks at Ilyra. She takes another drink."}},
{"beat_id": "C06_B056", "speaker_id": "torren", "text": "I’m sitting down.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STOP", "source_speaker_label": "TORREN"}},
{"beat_id": "C06_B057", "speaker_id": "ilyra", "text": "You can work sitting down.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STOP", "source_speaker_label": "ILYRA"}},
{"beat_id": "C06_B058", "speaker_id": "torren", "text": "Exactly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STOP", "source_speaker_label": "TORREN", "staging_after": "Ilyra takes the knife from him. Sets it down out of reach. Torren stares at her. She stares back. Beat. Torren gives up. Not dramatically. He just leans back. Cyanis does the same."}},
{"beat_id": "C06_B059", "speaker_id": "torren", "text": "Still rope.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — STILL ROPE", "source_speaker_label": "TORREN", "staging": "A few seconds pass. Torren looks at the repaired cord on the table."}},
{"beat_id": "C06_B060", "speaker_id": "cyanis", "text": "Get out.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — STILL ROPE", "source_speaker_label": "CYANIS", "staging": "Cyanis turns toward him."}},
{"beat_id": "C06_B061", "speaker_id": "ilyra", "text": "He’s sitting down.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — STILL ROPE", "source_speaker_label": "ILYRA", "staging": "Ilyra looks at Cyanis."}},
{"beat_id": "C06_B062", "speaker_id": "cyanis", "text": "Then he can get out sitting down.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — STILL ROPE", "source_speaker_label": "CYANIS"}},
{"beat_id": "C06_B063", "speaker_id": "torren", "text": "Finally, a workable plan.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — STILL ROPE", "source_speaker_label": "TORREN", "staging": "Torren settles farther into the chair.", "staging_after": "Silence. Nobody leaves. The lantern burns. Offscreen, somebody drops something and swears. Cyanis glances toward the sound. Doesn’t get up. Ilyra takes another drink. Torren closes his eyes for a moment.\n\nNobody asks if anyone is all right. Nobody needs to fill the silence. Hold several seconds. Fade.\n\n> **END C06.**\n\nC07 remains available regardless of whether C06 was viewed first."}},
