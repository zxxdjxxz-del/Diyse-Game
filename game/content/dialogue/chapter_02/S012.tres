authoring_notes = "Chapter 2 exact Resource conversion from docs/chapters/dialogue/chapter_02/S012.md under Complete Master Canon v1.64 / Audit79, Chapter transcript checkpoint Audit78. Spoken text is line-complete and must not be rewritten. Source staging/prose is preserved in cue metadata; source subsection and source speaker labels are carried in cues. Portrait slots remain empty until approved assets are wired. Spoken-sequence SHA-256: 596c3e5514388f575dbb18414afbcfeeae7e023037393ae0bc6ef684a8c3a35b."
beats = [
{"beat_id": "S012_B001", "speaker_id": "watermaster", "text": "Commander Solmar.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — Arrival", "source_speaker_label": "WATERMASTER", "staging": "2.5D staging: One reusable Dunmere street/water-channel space. Red cloth tied around several pump handles. Workers carry sealed barrels. A healer works from a folding table. Background NPC loops continue while dialogue plays.\n\nThe party enters with Maevra. Watermaster Marr approaches from the channel."}},
{"beat_id": "S012_B002", "speaker_id": "maevra", "text": "What happened?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — Arrival", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S012_B003", "speaker_id": "watermaster", "text": "First sickness yesterday afternoon. Three districts by morning.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — Arrival", "source_speaker_label": "WATERMASTER"}},
{"beat_id": "S012_B004", "speaker_id": "ilyra", "text": "Symptoms?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — Arrival", "source_speaker_label": "ILYRA"}},
{"beat_id": "S012_B005", "speaker_id": "watermaster", "text": "Vomiting. Fever. Tremors. A few couldn’t stand.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — Arrival", "source_speaker_label": "WATERMASTER"}},
{"beat_id": "S012_B006", "speaker_id": "ilyra", "text": "Deaths?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — Arrival", "source_speaker_label": "ILYRA"}},
{"beat_id": "S012_B007", "speaker_id": "watermaster", "text": "Two.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — Arrival", "source_speaker_label": "WATERMASTER"}},
{"beat_id": "S012_B008", "speaker_id": "ilyra", "text": "Show me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — Arrival", "source_speaker_label": "ILYRA", "staging": "Ilyra looks toward the nearest closed pump."}},
{"beat_id": "S012_B009", "speaker_id": "watermaster", "text": "This way.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — Arrival", "source_speaker_label": "WATERMASTER", "staging": "The Watermaster turns.", "staging_after": "Playable movement resumes."}},
{"beat_id": "S012_B010", "speaker_id": "torren", "text": "Those share the lower feed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "TORREN", "staging": "They stop beside an opened maintenance junction. Torren looks from the pipework to the three affected districts visible beyond the channel."}},
{"beat_id": "S012_B011", "speaker_id": "watermaster", "text": "All three.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "WATERMASTER"}},
{"beat_id": "S012_B012", "speaker_id": "cyanis", "text": "Anything outside it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "CYANIS"}},
{"beat_id": "S012_B013", "speaker_id": "watermaster", "text": "Not yet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "WATERMASTER"}},
{"beat_id": "S012_B014", "speaker_id": "ilyra", "text": "When did you shut the wells?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "ILYRA", "staging": "Ilyra checks a stained filter removed from the line."}},
{"beat_id": "S012_B015", "speaker_id": "watermaster", "text": "As soon as we made the connection.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "WATERMASTER"}},
{"beat_id": "S012_B016", "speaker_id": "torren", "text": "The wells or the feed?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "TORREN"}},
{"beat_id": "S012_B017", "speaker_id": "watermaster", "text": "The wells.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "WATERMASTER", "staging": "The Watermaster looks at him."}},
{"beat_id": "S012_B018", "speaker_id": "torren", "text": "Feed’s still running.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "TORREN"}},
{"beat_id": "S012_B019", "speaker_id": "watermaster", "text": "It supplies Eastbank.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "WATERMASTER"}},
{"beat_id": "S012_B020", "speaker_id": "ilyra", "text": "Then Eastbank is still exposed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "ILYRA"}},
{"beat_id": "S012_B021", "speaker_id": "watermaster", "text": "We don’t know that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "WATERMASTER"}},
{"beat_id": "S012_B022", "speaker_id": "ilyra", "text": "No. We don’t.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "ILYRA"}},
{"beat_id": "S012_B023", "speaker_id": "ilyra", "text": "That’s the problem.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "ILYRA", "staging": "She rises."}},
{"beat_id": "S012_B024", "speaker_id": "maevra", "text": "How much reserve water does Eastbank have?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "MAEVRA", "staging": "Maevra looks to the Watermaster."}},
{"beat_id": "S012_B025", "speaker_id": "watermaster", "text": "Half a day. Less if people panic.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "WATERMASTER"}},
{"beat_id": "S012_B026", "speaker_id": "cyanis", "text": "They already know something’s wrong.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "CYANIS"}},
{"beat_id": "S012_B027", "speaker_id": "watermaster", "text": "Knowing something’s wrong and knowing the taps are dry aren’t the same thing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "WATERMASTER"}},
{"beat_id": "S012_B028", "speaker_id": "torren", "text": "He’s right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "TORREN", "staging": "Torren keeps examining the junction."}},
{"beat_id": "S012_B029", "speaker_id": "torren", "text": "Doesn’t mean we leave it open.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "TORREN", "staging": "Ilyra looks at him."}},
{"beat_id": "S012_B030", "speaker_id": "ilyra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — Three Wells", "source_speaker_label": "ILYRA", "staging": "Beat."}},
{"beat_id": "S012_B031", "speaker_id": "torren", "text": "This line’s older than the street above it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "TORREN", "staging": "Playable investigation through the same waterworks space and one adjoining maintenance lane. Only three required interactions.\n\nAt the first junction, Torren checks the flow markers."}},
{"beat_id": "S012_B032", "speaker_id": "watermaster", "text": "Most of Dunmere is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "WATERMASTER"}},
{"beat_id": "S012_B033", "speaker_id": "torren", "text": "Who maintains it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "TORREN"}},
{"beat_id": "S012_B034", "speaker_id": "watermaster", "text": "My crews.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "WATERMASTER"}},
{"beat_id": "S012_B035", "speaker_id": "torren", "text": "All of it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "TORREN"}},
{"beat_id": "S012_B036", "speaker_id": "watermaster", "text": "Everything on our maps.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "WATERMASTER", "staging": "The Watermaster hesitates."}},
{"beat_id": "S012_B037", "speaker_id": "torren", "text": "That’s not all of it, is it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "TORREN", "staging": "Torren looks at him."}},
{"beat_id": "S012_B038", "speaker_id": "watermaster", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "WATERMASTER"}},
{"beat_id": "S012_B039", "speaker_id": "cyanis", "text": "This was opened.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "CYANIS", "staging": "At the second point, Cyanis examines a regulator housing."}},
{"beat_id": "S012_B040", "speaker_id": "maevra", "text": "Recently?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S012_B041", "speaker_id": "cyanis", "text": "Recently enough.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "CYANIS"}},
{"beat_id": "S012_B042", "speaker_id": "watermaster", "text": "My people would’ve logged it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "WATERMASTER"}},
{"beat_id": "S012_B043", "speaker_id": "cyanis", "text": "Did they?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "CYANIS"}},
{"beat_id": "S012_B044", "speaker_id": "watermaster", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "WATERMASTER", "staging": "The Watermaster already knows the answer."}},
{"beat_id": "S012_B045", "speaker_id": "ilyra", "text": "This didn’t come in with the river.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "ILYRA", "staging": "At the third point, Ilyra examines residue on the inside face of a filter. She turns it toward the others."}},
{"beat_id": "S012_B046", "speaker_id": "maevra", "text": "How do you know?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S012_B047", "speaker_id": "ilyra", "text": "Outside face is clean.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "ILYRA"}},
{"beat_id": "S012_B048", "speaker_id": "torren", "text": "So it entered after filtration.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "TORREN", "staging": "Torren crouches beside her."}},
{"beat_id": "S012_B049", "speaker_id": "ilyra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "ILYRA"}},
{"beat_id": "S012_B050", "speaker_id": "cyanis", "text": "Somebody put it there.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "CYANIS"}},
{"beat_id": "S012_B051", "speaker_id": "watermaster", "text": "Fuck.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — Trace the Line", "source_speaker_label": "WATERMASTER", "staging": "No one answers immediately. The Watermaster looks toward the town."}},
{"beat_id": "S012_B052", "speaker_id": "watermaster", "text": "If I close this, Eastbank loses pressure.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — Lower Feed", "source_speaker_label": "WATERMASTER", "staging": "They enter the lower-feed control chamber. Cheap 2.5D: one valve wheel, one pressure gauge, one gate-state change, water sound decreasing after closure. No bespoke machinery cinematic.\n\nThe Watermaster stands at the main valve."}},
{"beat_id": "S012_B053", "speaker_id": "ilyra", "text": "If you don’t, you may keep poisoning them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — Lower Feed", "source_speaker_label": "ILYRA"}},
{"beat_id": "S012_B054", "speaker_id": "watermaster", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — Lower Feed", "source_speaker_label": "WATERMASTER"}},
{"beat_id": "S012_B055", "speaker_id": "watermaster", "text": "Help me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — Lower Feed", "source_speaker_label": "WATERMASTER", "staging": "Silence. He puts both hands on the wheel."}},
{"beat_id": "S012_B056", "speaker_id": "watermaster", "text": "The lower feed is shut.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — Lower Feed", "source_speaker_label": "WATERMASTER", "staging": "Torren steps in first. Cyanis takes the opposite side. They turn the valve. The gate closes. The water noise drops. The Watermaster checks the gauge."}},
{"beat_id": "S012_B057", "speaker_id": "maevra", "text": "No water from the lower feed. Every public station.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — Lower Feed", "source_speaker_label": "MAEVRA", "staging": "Maevra turns to one of the workers at the door."}},
{"beat_id": "S012_B058", "speaker_id": "worker", "text": "Yes, Commander.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — Lower Feed", "source_speaker_label": "WORKER"}},
{"beat_id": "S012_B059", "speaker_id": "ilyra", "text": "And don’t tell them the rest is safe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — Lower Feed", "source_speaker_label": "ILYRA", "staging": "The worker leaves."}},
{"beat_id": "S012_B060", "speaker_id": "ilyra", "text": "Tell them the lower feed is shut. Nothing more.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — Lower Feed", "source_speaker_label": "ILYRA", "staging": "The Watermaster looks at her."}},
{"beat_id": "S012_B061", "speaker_id": "watermaster", "text": "Understood.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — Lower Feed", "source_speaker_label": "WATERMASTER"}},
{"beat_id": "S012_B062", "speaker_id": "torren", "text": "That supposed to be there?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — The Wrong Door", "source_speaker_label": "TORREN", "staging": "With the flow stopped, Torren notices water dripping beneath a maintenance door on the lower level."}},
{"beat_id": "S012_B063", "speaker_id": "watermaster", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — The Wrong Door", "source_speaker_label": "WATERMASTER", "staging": "The Watermaster looks down."}},
{"beat_id": "S012_B064", "speaker_id": "cyanis", "text": "New lock.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — The Wrong Door", "source_speaker_label": "CYANIS", "staging": "They approach. The door is old stone and timber. The lock is not. Cyanis crouches beside it."}},
{"beat_id": "S012_B065", "speaker_id": "watermaster", "text": "Not ours.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — The Wrong Door", "source_speaker_label": "WATERMASTER"}},
{"beat_id": "S012_B066", "speaker_id": "maevra", "text": "What’s behind it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — The Wrong Door", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S012_B067", "speaker_id": "watermaster", "text": "Nothing we’re using.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — The Wrong Door", "source_speaker_label": "WATERMASTER"}},
{"beat_id": "S012_B068", "speaker_id": "watermaster", "text": "Old service works. Sealed before I took the post.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — The Wrong Door", "source_speaker_label": "WATERMASTER", "staging": "Torren looks at him."}},
{"beat_id": "S012_B069", "speaker_id": "torren", "text": "Apparently not.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — The Wrong Door", "source_speaker_label": "TORREN"}},
{"beat_id": "S012_B070", "speaker_id": "ilyra", "text": "Same material.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — The Wrong Door", "source_speaker_label": "ILYRA", "staging": "Ilyra looks at the dark residue collected beneath the threshold."}},
{"beat_id": "S012_B071", "speaker_id": "watermaster", "text": "You’re sure?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — The Wrong Door", "source_speaker_label": "WATERMASTER", "staging": "The Watermaster’s face changes."}},
{"beat_id": "S012_B072", "speaker_id": "ilyra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — The Wrong Door", "source_speaker_label": "ILYRA"}},
{"beat_id": "S012_B073", "speaker_id": "cyanis", "text": "Then we need it open.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — The Wrong Door", "source_speaker_label": "CYANIS", "staging": "Cyanis stands."}},
{"beat_id": "S012_B074", "speaker_id": "watermaster", "text": "None of those will fit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — The Wrong Door", "source_speaker_label": "WATERMASTER", "staging": "The Watermaster hands him the key ring."}},
{"beat_id": "S012_B075", "speaker_id": "watermaster", "text": "I’ve never seen that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — The Wrong Door", "source_speaker_label": "WATERMASTER", "staging": "Cyanis tries the lock once. They don’t. He looks at Maevra. Maevra nods. Cyanis breaks the lock. Simple strike. Metal drops. The door opens onto a narrow descending stair. Old pale lights remain active below. Nobody speaks for a moment."}},
{"beat_id": "S012_B076", "speaker_id": "torren", "text": "Believe you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — The Wrong Door", "source_speaker_label": "TORREN", "staging": "Torren takes the lantern from the wall."}},
{"beat_id": "S012_B077", "speaker_id": "worker", "text": "Lower feed’s closed!", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — Before Going Below", "source_speaker_label": "WORKER", "staging": "They step back onto the upper landing long enough to see workers changing the markers on the pumps. A call carries across the channel."}},
{"beat_id": "S012_B078", "speaker_id": "cyanis", "text": "They’re not going to trust the water for a while.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — Before Going Below", "source_speaker_label": "CYANIS", "staging": "A second voice farther away repeats it. Ilyra watches a mother take a cup from a healer, hesitate, then hand it to her sick child. Cyanis sees it too."}},
{"beat_id": "S012_B079", "speaker_id": "ilyra", "text": "They shouldn’t.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — Before Going Below", "source_speaker_label": "ILYRA"}},
{"beat_id": "S012_B080", "speaker_id": "cyanis", "text": "Even after it’s clean.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — Before Going Below", "source_speaker_label": "CYANIS"}},
{"beat_id": "S012_B081", "speaker_id": "ilyra", "text": "Trust doesn’t work that fast.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — Before Going Below", "source_speaker_label": "ILYRA"}},
{"beat_id": "S012_B082", "speaker_id": "torren", "text": "Route’s passable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — Before Going Below", "source_speaker_label": "TORREN", "staging": "Torren returns from checking the stair."}},
{"beat_id": "S012_B083", "speaker_id": "maevra", "text": "How far?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — Before Going Below", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S012_B084", "speaker_id": "torren", "text": "Can’t tell yet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — Before Going Below", "source_speaker_label": "TORREN"}},
{"beat_id": "S012_B085", "speaker_id": "watermaster", "text": "You find whoever did this—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — Before Going Below", "source_speaker_label": "WATERMASTER", "staging": "The Watermaster looks at Maevra."}},
{"beat_id": "S012_B086", "speaker_id": "watermaster", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — Before Going Below", "source_speaker_label": "WATERMASTER", "staging": "He stops."}},
{"beat_id": "S012_B087", "speaker_id": "watermaster", "text": "Find out how they did it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — Before Going Below", "source_speaker_label": "WATERMASTER", "staging": "Beat."}},
{"beat_id": "S012_B088", "speaker_id": "maevra", "text": "We will.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — Before Going Below", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S012_B089", "speaker_id": "maevra", "text": "Keep the lower feed closed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — Before Going Below", "source_speaker_label": "MAEVRA", "staging": "She looks back toward the workers."}},
{"beat_id": "S012_B090", "speaker_id": "watermaster", "text": "Wasn’t planning to open the fucking thing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — Before Going Below", "source_speaker_label": "WATERMASTER"}},
{"beat_id": "S012_B091", "speaker_id": "maevra", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — Before Going Below", "source_speaker_label": "MAEVRA", "staging": "Maevra gives him the smallest nod."}},
{"beat_id": "S012_B092", "speaker_id": "cyanis", "text": "Recognize it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — Old Infrastructure", "source_speaker_label": "CYANIS", "staging": "The party descends. Playable transition. Cheap 2.5D environmental shift: modern brick and timber gradually give way to much older stone. The same corridor kit can be reused deeper in S013 with altered lighting, water level, and archive dressing.\n\nTorren runs the lantern across a wall seam."}},
{"beat_id": "S012_B093", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — Old Infrastructure", "source_speaker_label": "TORREN"}},
{"beat_id": "S012_B094", "speaker_id": "cyanis", "text": "That’s reassuring.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — Old Infrastructure", "source_speaker_label": "CYANIS"}},
{"beat_id": "S012_B095", "speaker_id": "torren", "text": "Didn’t say it was dangerous.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — Old Infrastructure", "source_speaker_label": "TORREN"}},
{"beat_id": "S012_B096", "speaker_id": "cyanis", "text": "You didn’t say it wasn’t.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — Old Infrastructure", "source_speaker_label": "CYANIS"}},
{"beat_id": "S012_B097", "speaker_id": "torren", "text": "There you go.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — Old Infrastructure", "source_speaker_label": "TORREN"}},
{"beat_id": "S012_B098", "speaker_id": "ilyra", "text": "Here too.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — Old Infrastructure", "source_speaker_label": "ILYRA", "staging": "Ilyra stops at another patch of dark residue."}},
{"beat_id": "S012_B099", "speaker_id": "maevra", "text": "Then we’re on the right route.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — Old Infrastructure", "source_speaker_label": "MAEVRA", "staging": "Maevra looks down the corridor.", "staging_after": "Far ahead, water echoes through a much larger space. The party continues."}},
{"beat_id": "S012_B100", "speaker_id": "cyanis", "text": "That’s not part of the waterworks.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — Sunken Archive", "source_speaker_label": "CYANIS", "staging": "The corridor opens onto a flooded chamber. No dialogue immediately. Let the environment have the reveal: old archive structures, partly submerged shelving, preservation channels still emitting pale light, black water covering the lower floor. Five-second clean world shot. No portrait UI."}},
{"beat_id": "S012_B101", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — Sunken Archive", "source_speaker_label": "TORREN"}},
{"beat_id": "S012_B102", "speaker_id": "ilyra", "text": "Residue continues down.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — Sunken Archive", "source_speaker_label": "ILYRA", "staging": "Ilyra crouches near the edge."}},
{"beat_id": "S012_B103", "speaker_id": "maevra", "text": "Can we cross?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — Sunken Archive", "source_speaker_label": "MAEVRA", "staging": "Maevra looks over the flooded route."}},
{"beat_id": "S012_B104", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — Sunken Archive", "source_speaker_label": "TORREN", "staging": "Torren studies it."}},
{"beat_id": "S012_B105", "speaker_id": "cyanis", "text": "That confident?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — Sunken Archive", "source_speaker_label": "CYANIS"}},
{"beat_id": "S012_B106", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — Sunken Archive", "source_speaker_label": "TORREN"}},
{"beat_id": "S012_B107", "speaker_id": "torren", "text": "Come on.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — Sunken Archive", "source_speaker_label": "TORREN", "staging": "Cyanis looks at him. Torren starts down."}},
{"beat_id": "S012_B108", "speaker_id": "maevra", "text": "Stay on Harth’s route.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — Sunken Archive", "source_speaker_label": "MAEVRA", "staging": "Maevra follows.", "staging_after": "Ilyra steps after them. Cyanis takes one last look back toward Dunmere above, then follows.\n\n**END S012. Transition directly into S013 — Sunken Archive / Archive Leviathan.**"}}
]
