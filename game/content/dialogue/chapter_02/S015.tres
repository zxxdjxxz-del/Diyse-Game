authoring_notes = "Chapter 2 exact Resource conversion from docs/chapters/dialogue/chapter_02/S015.md under Complete Master Canon v1.64 / Audit79, Chapter transcript checkpoint Audit78. Spoken text is line-complete and must not be rewritten. Source staging/prose is preserved in cue metadata; source subsection and source speaker labels are carried in cues. Portrait slots remain empty until approved assets are wired. Spoken-sequence SHA-256: 6ef78e47c3b0d4526c151489eeeb09e4b9a5ebd19bf31c35ac5bb523f5ff5dbc."
beats = [
{"beat_id": "S015_B001", "speaker_id": "torren", "text": "Three entrances.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "RETURN_PLAYER_CONTROL"], "source_section": "B001 — THE BASTION WORKS", "source_speaker_label": "TORREN", "staging": "The view from S014 holds for a moment before control returns.\n\nThe Red Transfer Bastion is not a ruined fortress. It is operating.\n\nTransfers move through separate controlled lanes. Black Host soldiers change posts. Wounded personnel are carried toward a marked medical route. Supply carts move behind reinforced barriers.\n\nNobody is standing around waiting for the protagonists.\n\nCheap 2.5D: one large Bastion exterior/interior kit, background soldier/porter loops, opening/closing gate states, transfer carts, lighting, banners and mechanical movement. Scale comes from the environment rather than expensive character animation.\n\nTorren studies the routes below."}},
{"beat_id": "S015_B002", "speaker_id": "maevra", "text": "Which one gets us to the gate control?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — THE BASTION WORKS", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S015_B003", "speaker_id": "torren", "text": "That one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — THE BASTION WORKS", "source_speaker_label": "TORREN", "staging": "Torren points toward the center structure."}},
{"beat_id": "S015_B004", "speaker_id": "cyanis", "text": "Naturally.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — THE BASTION WORKS", "source_speaker_label": "CYANIS"}},
{"beat_id": "S015_B005", "speaker_id": "ilyra", "text": "What's wrong with the other two?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — THE BASTION WORKS", "source_speaker_label": "ILYRA"}},
{"beat_id": "S015_B006", "speaker_id": "torren", "text": "One goes to barracks.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — THE BASTION WORKS", "source_speaker_label": "TORREN"}},
{"beat_id": "S015_B007", "speaker_id": "torren", "text": "One goes somewhere with enough guards that I don't give a shit what's inside.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — THE BASTION WORKS", "source_speaker_label": "TORREN", "staging": "He points again."}},
{"beat_id": "S015_B008", "speaker_id": "cyanis", "text": "Reasonable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — THE BASTION WORKS", "source_speaker_label": "CYANIS", "staging": "Cyanis looks."}},
{"beat_id": "S015_B009", "speaker_id": "maevra", "text": "Center, then.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "RETURN_PLAYER_CONTROL"], "source_section": "B001 — THE BASTION WORKS", "source_speaker_label": "MAEVRA", "staging": "Maevra checks the transfer route.", "staging_after": "Control returns."}},
{"beat_id": "S015_B010", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "A moderate Black Host combat area. Not huge. Expected first-pass pressure: roughly 2–3 random encounters before the next authored pocket.\n\nThe player moves through one exterior transfer platform, a reinforced connecting hall, a logistics junction, and a short upper walkway. Same Bastion kit reused throughout.\n\nEnemy formations are disciplined rather than monstrous chaos. Soldiers use cover positions, support units and established Black Host combat roles. The place feels dangerous because people know what they are doing.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "EXPLORATION 1 — OUTER BASTION"}},
{"beat_id": "S015_B011", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "A supply station can be looted after combat. Useful reward, no mandatory story information.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "OPTIONAL SIDE ROOM"}},
{"beat_id": "S015_B012", "speaker_id": "cyanis", "text": "What?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE WOUNDED", "source_speaker_label": "CYANIS", "staging": "The party reaches a junction overlooking a Black Host medical station. Two wounded soldiers are being carried inside. Ilyra slows. Cyanis notices."}},
{"beat_id": "S015_B013", "speaker_id": "ilyra", "text": "Nothing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE WOUNDED", "source_speaker_label": "ILYRA"}},
{"beat_id": "S015_B014", "speaker_id": "ilyra", "text": "They're treating them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE WOUNDED", "source_speaker_label": "ILYRA", "staging": "She watches another wounded soldier being moved."}},
{"beat_id": "S015_B015", "speaker_id": "maevra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE WOUNDED", "source_speaker_label": "MAEVRA", "staging": "Maevra looks."}},
{"beat_id": "S015_B016", "speaker_id": "ilyra", "text": "Properly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE WOUNDED", "source_speaker_label": "ILYRA"}},
{"beat_id": "S015_B017", "speaker_id": "torren", "text": "Still a prison.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE WOUNDED", "source_speaker_label": "TORREN", "staging": "Torren watches the route rather than the patients."}},
{"beat_id": "S015_B018", "speaker_id": "ilyra", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE WOUNDED", "source_speaker_label": "ILYRA", "staging": "Ilyra looks at him.", "staging_after": "They move. No speech about moral complexity. The image is allowed to exist."}},
{"beat_id": "S015_B019", "speaker_id": "cyanis", "text": "How long has this been here?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 2 — TRANSFER CENTER", "source_speaker_label": "CYANIS", "staging": "The next moderate stretch moves closer to the actual transfer machinery. Expected first-pass pressure: roughly 2–3 random encounters.\n\nThe party sees evidence of a system designed for repeated use: numbered holding lanes, medical screening points, transfer manifests, restraint storage, guard rotation stations, maintained mechanical controls.\n\nNo torture-room spectacle. The horror is administrative.\n\nA transfer lane crosses beneath the player on a lower level. Empty at the moment. Cyanis looks down."}},
{"beat_id": "S015_B020", "speaker_id": "maevra", "text": "Don't know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 2 — TRANSFER CENTER", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S015_B021", "speaker_id": "torren", "text": "Long enough to have procedures.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 2 — TRANSFER CENTER", "source_speaker_label": "TORREN", "staging_after": "That is all."}},
{"beat_id": "S015_B022", "speaker_id": "officer", "text": "Western bridge collapsed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "OFFICER", "staging": "The party reaches an upper corridor outside the Bastion command center. Voices carry through the open chamber before anyone sees the party.\n\nA BLACK HOST OFFICER is giving a report. Commander Rhazek stands at a central operations table. Not on a throne. Not posing."}},
{"beat_id": "S015_B023", "speaker_id": "rhazek", "text": "Personnel?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B024", "speaker_id": "officer", "text": "Seven confirmed dead. Eleven missing. Six wounded recovered.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "OFFICER"}},
{"beat_id": "S015_B025", "speaker_id": "rhazek", "text": "Destination for the wounded?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B026", "speaker_id": "officer", "text": "Second medical station.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "OFFICER"}},
{"beat_id": "S015_B027", "speaker_id": "rhazek", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B028", "speaker_id": "rhazek", "text": "Move the reserve off the lower spine. Route Three.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "RHAZEK", "staging": "He points to the map."}},
{"beat_id": "S015_B029", "speaker_id": "officer", "text": "That yields the transfer center.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "OFFICER", "staging": "The officer hesitates."}},
{"beat_id": "S015_B030", "speaker_id": "rhazek", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B031", "speaker_id": "rhazek", "text": "You have the order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "RHAZEK", "staging": "Beat."}},
{"beat_id": "S015_B032", "speaker_id": "officer", "text": "Yes, Commander.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "OFFICER"}},
{"beat_id": "S015_B033", "speaker_id": "second_officer", "text": "South line lost.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "SECOND OFFICER", "staging": "Another soldier steps forward with a slate."}},
{"beat_id": "S015_B034", "speaker_id": "rhazek", "text": "Define lost.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "RHAZEK", "staging": "Rhazek does not look up."}},
{"beat_id": "S015_B035", "speaker_id": "second_officer", "text": "No signal. No response from the post.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "SECOND OFFICER"}},
{"beat_id": "S015_B036", "speaker_id": "rhazek", "text": "Then the line is abandoned. Nine are missing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "RHAZEK", "staging": "Rhazek looks at him now."}},
{"beat_id": "S015_B037", "speaker_id": "rhazek", "text": "Do not promote them to dead because your report is shorter that way.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "RHAZEK", "staging": "He hands the slate back."}},
{"beat_id": "S015_B038", "speaker_id": "second_officer", "text": "Understood.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "SECOND OFFICER"}},
{"beat_id": "S015_B039", "speaker_id": "rhazek", "text": "Commander Solmar.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "RHAZEK", "staging": "The officer leaves. Only then does Rhazek look toward the entrance. At the party. He knew they were there. No dramatic turn."}},
{"beat_id": "S015_B040", "speaker_id": "rhazek", "text": "Dovaren.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "RHAZEK", "staging": "His eyes move."}},
{"beat_id": "S015_B041", "speaker_id": "rhazek", "text": "Amarin.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B042", "speaker_id": "rhazek", "text": "Harth.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "RHAZEK", "staging": "Then Torren."}},
{"beat_id": "S015_B043", "speaker_id": "maevra", "text": "Commander Rhazek.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "MAEVRA", "staging": "Maevra studies him."}},
{"beat_id": "S015_B044", "speaker_id": "rhazek", "text": "You read the reports.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B045", "speaker_id": "maevra", "text": "I require them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S015_B046", "speaker_id": "rhazek", "text": "So do I.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B047", "speaker_id": "rhazek", "text": "You destroyed three exterior positions.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "RHAZEK", "staging": "His attention shifts briefly to the tactical display. Then back."}},
{"beat_id": "S015_B048", "speaker_id": "cyanis", "text": "You got one wrong.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "CYANIS"}},
{"beat_id": "S015_B049", "speaker_id": "rhazek", "text": "Four.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "RHAZEK", "staging": "Rhazek looks at him."}},
{"beat_id": "S015_B050", "speaker_id": "rhazek", "text": "Your western bypass is gone too.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "RHAZEK", "staging": "Beat."}},
{"beat_id": "S015_B051", "speaker_id": "maevra", "text": "Confirm.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "MAEVRA", "staging": "Torren glances at Maevra. Maevra looks toward the map."}},
{"beat_id": "S015_B052", "speaker_id": "officer", "text": "Confirmed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "OFFICER", "staging": "Rhazek gestures to one of the remaining officers. The officer checks."}},
{"beat_id": "S015_B053", "speaker_id": "maevra", "text": "Thank you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "MAEVRA", "staging": "Maevra looks back at Rhazek."}},
{"beat_id": "S015_B054", "speaker_id": "rhazek", "text": "Both of you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B055", "speaker_id": "cyanis", "text": "Did we just help each other?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "CYANIS", "staging": "Cyanis looks at Maevra."}},
{"beat_id": "S015_B056", "speaker_id": "maevra", "text": "Don't get excited.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — COMMAND TRAFFIC", "source_speaker_label": "MAEVRA", "staging_after": "Rhazek waits. Not amused. Not offended. Simply finished with the interruption."}},
{"beat_id": "S015_B057", "speaker_id": "maevra", "text": "Open the prisoner extraction gate.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — THE GATE", "source_speaker_label": "MAEVRA", "staging": "Maevra steps toward the operations table."}},
{"beat_id": "S015_B058", "speaker_id": "rhazek", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — THE GATE", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B059", "speaker_id": "maevra", "text": "There are injured civilians in those galleries.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — THE GATE", "source_speaker_label": "MAEVRA", "staging": "No speech. Maevra’s jaw tightens."}},
{"beat_id": "S015_B060", "speaker_id": "rhazek", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — THE GATE", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B061", "speaker_id": "ilyra", "text": "Then you know they need to leave.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — THE GATE", "source_speaker_label": "ILYRA", "staging": "Ilyra looks at him."}},
{"beat_id": "S015_B062", "speaker_id": "rhazek", "text": "They are not scheduled for release.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — THE GATE", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B063", "speaker_id": "ilyra", "text": "Scheduled.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — THE GATE", "source_speaker_label": "ILYRA"}},
{"beat_id": "S015_B064", "speaker_id": "ilyra", "text": "Do they get a say?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — THE GATE", "source_speaker_label": "ILYRA", "staging": "Rhazek looks at her."}},
{"beat_id": "S015_B065", "speaker_id": "rhazek", "text": "They were given one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — THE GATE", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B066", "speaker_id": "ilyra", "text": "And when they said no?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — THE GATE", "source_speaker_label": "ILYRA"}},
{"beat_id": "S015_B067", "speaker_id": "rhazek", "text": "The transfer proceeded.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — THE GATE", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B068", "speaker_id": "ilyra", "text": "Then they weren't given a choice.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — THE GATE", "source_speaker_label": "ILYRA", "staging": "Ilyra’s expression hardens."}},
{"beat_id": "S015_B069", "speaker_id": "rhazek", "text": "They were given information and an opportunity to comply.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — THE GATE", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B070", "speaker_id": "ilyra", "text": "That's not consent.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — THE GATE", "source_speaker_label": "ILYRA"}},
{"beat_id": "S015_B071", "speaker_id": "rhazek", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — THE GATE", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B072", "speaker_id": "cyanis", "text": "And you're fine with that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — THE GATE", "source_speaker_label": "CYANIS", "staging": "No excuse follows. That answer lands harder because he knows exactly what the word means.\n\nCyanis studies him."}},
{"beat_id": "S015_B073", "speaker_id": "rhazek", "text": "I authorized it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — THE GATE", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B074", "speaker_id": "cyanis", "text": "Wasn't what I asked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — THE GATE", "source_speaker_label": "CYANIS"}},
{"beat_id": "S015_B075", "speaker_id": "rhazek", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — THE GATE", "source_speaker_label": "RHAZEK", "staging_after": "Silence."}},
{"beat_id": "S015_B076", "speaker_id": "ilyra", "text": "Your wounded are getting treatment.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "ILYRA", "staging": "Ilyra looks toward the medical route visible through the command-room opening."}},
{"beat_id": "S015_B077", "speaker_id": "rhazek", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B078", "speaker_id": "ilyra", "text": "What about the people you've detained?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "ILYRA"}},
{"beat_id": "S015_B079", "speaker_id": "rhazek", "text": "No detainee under my authority is denied necessary medical treatment.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B080", "speaker_id": "ilyra", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "ILYRA"}},
{"beat_id": "S015_B081", "speaker_id": "ilyra", "text": "You should do that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "ILYRA", "staging": "Beat."}},
{"beat_id": "S015_B082", "speaker_id": "ilyra", "text": "It doesn't buy the rest.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "ILYRA", "staging": "Another beat."}},
{"beat_id": "S015_B083", "speaker_id": "rhazek", "text": "I didn't offer it as payment.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B084", "speaker_id": "ilyra", "text": "Then we're clear.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "ILYRA", "staging": "Ilyra watches him. She expected resistance. Not agreement."}},
{"beat_id": "S015_B085", "speaker_id": "rhazek", "text": "We were already clear.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B086", "speaker_id": "maevra", "text": "Open the gate.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "MAEVRA", "staging": "Maevra steps closer to the table."}},
{"beat_id": "S015_B087", "speaker_id": "rhazek", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B088", "speaker_id": "maevra", "text": "Then we're taking the control.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S015_B089", "speaker_id": "rhazek", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B090", "speaker_id": "cyanis", "text": "Yes?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "CYANIS", "staging": "Cyanis looks at him."}},
{"beat_id": "S015_B091", "speaker_id": "rhazek", "text": "That is what you came here to do.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B092", "speaker_id": "rhazek", "text": "You did not enter my Bastion to persuade me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "RHAZEK", "staging": "A Black Host officer shifts uneasily. Rhazek does not."}},
{"beat_id": "S015_B093", "speaker_id": "maevra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "MAEVRA", "staging": "Maevra answers immediately."}},
{"beat_id": "S015_B094", "speaker_id": "rhazek", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B095", "speaker_id": "rhazek", "text": "Then we have finished talking.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHAT HE OWNS", "source_speaker_label": "RHAZEK", "staging": "He removes his command cloak and hands it to the nearest officer. Simple pose swap. No transformation movie."}},
{"beat_id": "S015_B096", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "The command chamber reconfigures into a readable battle space using the existing room. No teleport to an anonymous arena. Officers withdraw behind defensive barriers. Rhazek uses Bastion Master, his Chapter 2 combat state. No Reforged Commander. No Bastion Devourer. No later catastrophic/unarmored form.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "Presentation"}},
{"beat_id": "S015_B097", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "One continuous health bar. The encounter has two authored behavior states on that same bar.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "ONE HP BAR"}},
{"beat_id": "S015_B098", "speaker_id": "rhazek", "text": "Left line.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "STATE A — BASTION MASTER", "source_speaker_label": "RHAZEK", "staging": "Rhazek fights as a commander using the functioning Bastion around him. Finite support only. Support does not respawn indefinitely.\n\nOne shield/support detachment.\n\nOne ranged support position.\n\nLimited command-linked environmental pressure.\n\nThe battle should make the player feel that Rhazek is using prepared infrastructure, not magically summoning endless soldiers. When support is exhausted, it stays exhausted. Rhazek remains personally dangerous. No constant battle quips. Functional barks only."}},
{"beat_id": "S015_B099", "speaker_id": "rhazek", "text": "Hold.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "STATE A — BASTION MASTER", "source_speaker_label": "RHAZEK", "staging": "or:"}},
{"beat_id": "S015_B100", "speaker_id": "rhazek", "text": "Move.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "STATE A — BASTION MASTER", "source_speaker_label": "RHAZEK", "staging": "or:", "staging_after": "Short. Command-shaped."}},
{"beat_id": "S015_B101", "speaker_id": "torren", "text": "That's new.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SAME_BAR_THRESHOLD"], "source_section": "SAME-BAR THRESHOLD — RUIN / ARMOR ESCALATION", "source_speaker_label": "TORREN", "staging": "At the authored threshold, Rhazek takes a hard hit. He remains standing. Brief battle pause. The Bastion’s Ruin channels respond through his armor. Dark-purple energy threads more visibly through the black/crimson biomechanical plates. Armor closes/reinforces around vulnerable sections.\n\nCheap 2.5D: illustrated cut-in + armor-state swap + chamber lighting response. No long transformation. No new health bar. No free attack during the threshold.\n\nTorren sees the change."}},
{"beat_id": "S015_B102", "speaker_id": "maevra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SAME_BAR_THRESHOLD"], "source_section": "SAME-BAR THRESHOLD — RUIN / ARMOR ESCALATION", "source_speaker_label": "MAEVRA", "staging": "Maevra does not take her eyes off Rhazek."}},
{"beat_id": "S015_B103", "speaker_id": "maevra", "text": "That's deliberate.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SAME_BAR_THRESHOLD"], "source_section": "SAME-BAR THRESHOLD — RUIN / ARMOR ESCALATION", "source_speaker_label": "MAEVRA", "staging": "Beat."}},
{"beat_id": "S015_B104", "speaker_id": "rhazek", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SAME_BAR_THRESHOLD"], "source_section": "SAME-BAR THRESHOLD — RUIN / ARMOR ESCALATION", "source_speaker_label": "RHAZEK", "staging": "Rhazek looks at her.", "staging_after": "Battle resumes."}},
{"beat_id": "S015_B105", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "More direct personal pressure. Less reliance on remaining support. Armor becomes harder to break through. Ruin-enhanced attacks become more prominent. Still recognizably the same combat state, not a new form. When the HP bar reaches zero, Rhazek is defeated.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "STATE B — BASTION MASTER: RUIN ESCALATION"}},
{"beat_id": "S015_B106", "speaker_id": "torren", "text": "Found it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "TORREN", "staging": "Rhazek drops to one knee. Not unconscious. His armor is damaged but nowhere near the later catastrophic state. Cyanis starts toward him. Maevra raises one hand. Not now. Torren is already looking at the command controls."}},
{"beat_id": "S015_B107", "speaker_id": "ilyra", "text": "Can you stand?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "ILYRA", "staging": "Ilyra remains watching Rhazek."}},
{"beat_id": "S015_B108", "speaker_id": "rhazek", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "RHAZEK", "staging": "Rhazek looks at her."}},
{"beat_id": "S015_B109", "speaker_id": "ilyra", "text": "Fine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "ILYRA", "staging": "He tries. Gets up. Barely. Ilyra does not offer a hand."}},
{"beat_id": "S015_B110", "speaker_id": "rhazek", "text": "The extraction control is there.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "RHAZEK", "staging": "Rhazek looks toward the operations table."}},
{"beat_id": "S015_B111", "speaker_id": "cyanis", "text": "You're helping now?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "CYANIS", "staging": "Cyanis looks at him."}},
{"beat_id": "S015_B112", "speaker_id": "rhazek", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B113", "speaker_id": "rhazek", "text": "You won access to it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "RHAZEK", "staging": "Rhazek straightens as much as the damaged armor allows."}},
{"beat_id": "S015_B114", "speaker_id": "cyanis", "text": "You're a strange fucking man.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "CYANIS", "staging": "Cyanis gives him a long look."}},
{"beat_id": "S015_B115", "speaker_id": "rhazek", "text": "I've been called worse.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B116", "speaker_id": "cyanis", "text": "I'm sure.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "CYANIS"}},
{"beat_id": "S015_B117", "speaker_id": "torren", "text": "Solmar.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "TORREN", "staging": "Torren reaches the controls."}},
{"beat_id": "S015_B118", "speaker_id": "torren", "text": "Gate control. Transfer spine. Causeway.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "TORREN", "staging": "Maevra joins him."}},
{"beat_id": "S015_B119", "speaker_id": "maevra", "text": "Can we open all of it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "MAEVRA", "staging": "Maevra checks the indicators."}},
{"beat_id": "S015_B120", "speaker_id": "torren", "text": "Not all at once.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "TORREN", "staging": "Torren studies the system."}},
{"beat_id": "S015_B121", "speaker_id": "rhazek", "text": "You don't want to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "RHAZEK", "staging": "Rhazek answers from behind them."}},
{"beat_id": "S015_B122", "speaker_id": "torren", "text": "Why?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "TORREN", "staging": "Torren turns."}},
{"beat_id": "S015_B123", "speaker_id": "rhazek", "text": "You'll expose the gallery route before you have a column moving.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B124", "speaker_id": "maevra", "text": "We open the return route first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "MAEVRA", "staging": "Maevra studies the display. Then realizes he is right."}},
{"beat_id": "S015_B125", "speaker_id": "torren", "text": "Then the Causeway when they're moving.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "TORREN", "staging": "Torren nods."}},
{"beat_id": "S015_B126", "speaker_id": "cyanis", "text": "Still not helping?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "CYANIS", "staging": "Cyanis looks back at Rhazek."}},
{"beat_id": "S015_B127", "speaker_id": "rhazek", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B128", "speaker_id": "cyanis", "text": "Right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTER RHAZEK", "source_speaker_label": "CYANIS"}},
{"beat_id": "S015_B129", "speaker_id": "maevra", "text": "Reserve movement.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — WITHDRAWAL", "source_speaker_label": "MAEVRA", "staging": "A distant alarm changes tone. Rhazek recognizes it. So does Maevra."}},
{"beat_id": "S015_B130", "speaker_id": "rhazek", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — WITHDRAWAL", "source_speaker_label": "RHAZEK"}},
{"beat_id": "S015_B131", "speaker_id": "maevra", "text": "Open it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — WITHDRAWAL", "source_speaker_label": "MAEVRA", "staging": "Cyanis shifts toward him again. Rhazek’s remaining officers appear at the far exit. Not charging. Covering a withdrawal.\n\nMaevra looks at the controls. Then at Rhazek. She has a choice between chasing him and opening the route. It is not treated as a player dialogue choice. She turns to Torren."}},
{"beat_id": "S015_B132", "speaker_id": "torren", "text": "Gallery route opening.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — WITHDRAWAL", "source_speaker_label": "TORREN", "staging": "Rhazek watches her make the decision. Then withdraws with his remaining personnel.\n\nNo final villain threat. No “next time.” No mysterious promise. He leaves because remaining here no longer serves his objective.\n\nThe Bastion remains active around them, but its local command structure is broken. Torren works the control. A heavy gate mechanism engages somewhere far below."}},
{"beat_id": "S015_B133", "speaker_id": "maevra", "text": "Move.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — WITHDRAWAL", "source_speaker_label": "MAEVRA", "staging": "Maevra looks toward the return corridor."}},
{"beat_id": "S015_B134", "speaker_id": "prisoner_woman", "text": "That bad?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "RETURN_PLAYER_CONTROL"], "source_section": "SHORT RETURN STRETCH — BACK TO THE PRISONERS", "source_speaker_label": "PRISONER WOMAN", "staging": "Control returns. This is not another full dungeon. The player moves back through the now-disrupted Bastion/transfer route. The return is shorter because portions of the path are already cleared.\n\nAt most 1–2 likely random encounters from remaining Black Host forces before the party crosses back into the cleared Prisoner Galleries. No new boss. No fake Rhazek rematch.\n\nThe party reaches the safe pocket. Cyanis knocks. Three times. The bar lifts. The Prisoner Woman opens the door. Looks at their condition."}},
{"beat_id": "S015_B135", "speaker_id": "torren", "text": "I've had better.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "SHORT RETURN STRETCH — BACK TO THE PRISONERS", "source_speaker_label": "TORREN", "staging": "Torren looks down at himself."}},
{"beat_id": "S015_B136", "speaker_id": "prisoner_woman", "text": "Gate?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "SHORT RETURN STRETCH — BACK TO THE PRISONERS", "source_speaker_label": "PRISONER WOMAN", "staging": "She looks past them."}},
{"beat_id": "S015_B137", "speaker_id": "maevra", "text": "We have it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "SHORT RETURN STRETCH — BACK TO THE PRISONERS", "source_speaker_label": "MAEVRA", "staging": "Maevra nods."}},
{"beat_id": "S015_B138", "speaker_id": "prisoner_woman", "text": "All right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "SHORT RETURN STRETCH — BACK TO THE PRISONERS", "source_speaker_label": "PRISONER WOMAN", "staging": "The woman does not cheer. She turns back inside."}},
{"beat_id": "S015_B139", "speaker_id": "prisoner_woman", "text": "Get your shit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "SHORT RETURN STRETCH — BACK TO THE PRISONERS", "source_speaker_label": "PRISONER WOMAN", "staging": "Louder:", "staging_after": "People begin moving. Ilyra immediately steps toward those who cannot. Torren checks the route. Cyanis looks back toward the transfer spine. Maevra watches everyone preparing to leave. No victory pose.\n\n**END S015. Transition to S016 — Extraction Causeway.**"}},
{"beat_id": "S015_B140", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "The Bastion is frightening because it is functional, not because it is a torture theme park.\n\nRhazek is introduced commanding casualties, missing personnel, medical routing and reserves before he deals with the protagonists.\n\nRhazek is competent, accountable, non-possessed, ideologically intact, and owns the transfer operation and his decisions.\n\nProper medical treatment is real but does not morally purchase coercive custody.\n\nCombat uses Bastion Master only, with finite support and exactly one HP bar.\n\nThe Ruin/armor change is a deliberate same-bar escalation, not another form.\n\nNo Reforged Commander, Bastion Devourer, or later catastrophically damaged/unarmored Rhazek is used in Chapter 2.\n\nRhazek survives and withdraws. The party prioritizes opening the evacuation route over chasing him.\n\nExploration remains moderate: roughly 2–3 encounters + 2–3 encounters + boss + short return.\n\nCheap 2.5D throughout: existing Bastion space, background loops, control/gate states, portrait acting, armor-state swap, lighting and an illustrated threshold cut-in.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING", "STATE_RHAZEK_CH02_WITHDRAWN", "STATE_BASTION_EXTRACTION_CONTROL_ACQUIRED"], "source_section": "S015 — LOCKED CONTINUITY NOTES"}}
]
