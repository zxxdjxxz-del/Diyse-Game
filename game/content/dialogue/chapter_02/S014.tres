[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "S014"
chapter_id = "chapter_02"
scene_kind = "mandatory"
location_id = "LOC_PRISONER_GALLERIES"
trigger_id = "trigger.chapter_02.s014"
completion_flag = "scene.s014.complete"
participants = Array[String](["torren", "cyanis", "maevra", "prisoner_woman", "ilyra", "injured_man", "prisoner", "second_prisoner", "older_prisoner"])
authoring_notes = "Chapter 2 exact Resource conversion from docs/chapters/dialogue/chapter_02/S014.md under Complete Master Canon v1.64 / Audit79, Chapter transcript checkpoint Audit78. Spoken text is line-complete and must not be rewritten. Source staging/prose is preserved in cue metadata; source subsection and source speaker labels are carried in cues. Portrait slots remain empty until approved assets are wired. Spoken-sequence SHA-256: 7e90036baefa068251009c19739cb1309c3440392cc27ee242028f2e75cfa7bf."
beats = [
{"beat_id": "S014_B001", "speaker_id": "torren", "text": "Someone's in there.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BEYOND THE BARS", "source_speaker_label": "TORREN", "staging": "The service corridor from S013 reaches a barred gallery. The cough comes again."}},
{"beat_id": "S014_B002", "speaker_id": "cyanis", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BEYOND THE BARS", "source_speaker_label": "CYANIS"}},
{"beat_id": "S014_B003", "speaker_id": "maevra", "text": "Open it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BEYOND THE BARS", "source_speaker_label": "MAEVRA", "staging": "Maevra checks the corridor behind them."}},
{"beat_id": "S014_B004", "speaker_id": "prisoner_woman", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BEYOND THE BARS", "source_speaker_label": "PRISONER WOMAN", "staging": "The release on this side still works. Simple gate-state change. No cinematic. The bars retract far enough to pass. They enter.\n\nThe gallery is not one giant prison room. It is a series of small holding bays connected by a central corridor. Some doors stand open. Some do not. A woman sits against one wall with a bloodied sleeve wrapped around her forearm. A man farther back is trying to help another prisoner stand. Someone else watches the party without moving.\n\nThe woman sees Maevra's armor."}},
{"beat_id": "S014_B005", "speaker_id": "prisoner_woman", "text": "Stay there.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BEYOND THE BARS", "source_speaker_label": "PRISONER WOMAN"}},
{"beat_id": "S014_B006", "speaker_id": "prisoner_woman", "text": "Who the fuck are you?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BEYOND THE BARS", "source_speaker_label": "PRISONER WOMAN", "staging": "She looks at Cyanis. Then Torren. Then Ilyra."}},
{"beat_id": "S014_B007", "speaker_id": "maevra", "text": "Commander Maevra Solmar. Yahtrean Army.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BEYOND THE BARS", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S014_B008", "speaker_id": "prisoner_woman", "text": "That's still a commander.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BEYOND THE BARS", "source_speaker_label": "PRISONER WOMAN", "staging": "The woman's expression does not improve."}},
{"beat_id": "S014_B009", "speaker_id": "maevra", "text": "It is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BEYOND THE BARS", "source_speaker_label": "MAEVRA", "staging": "Beat. Maevra nods."}},
{"beat_id": "S014_B010", "speaker_id": "ilyra", "text": "I'm a healer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BEYOND THE BARS", "source_speaker_label": "ILYRA", "staging": "Ilyra steps forward only far enough to be seen clearly."}},
{"beat_id": "S014_B011", "speaker_id": "prisoner_woman", "text": "You're armed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BEYOND THE BARS", "source_speaker_label": "PRISONER WOMAN"}},
{"beat_id": "S014_B012", "speaker_id": "ilyra", "text": "Also true.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BEYOND THE BARS", "source_speaker_label": "ILYRA"}},
{"beat_id": "S014_B013", "speaker_id": "ilyra", "text": "I'm not touching anyone who doesn't want me to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BEYOND THE BARS", "source_speaker_label": "ILYRA", "staging": "A few prisoners look at one another."}},
{"beat_id": "S014_B014", "speaker_id": "prisoner_woman", "text": "His knee.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BEYOND THE BARS", "source_speaker_label": "PRISONER WOMAN", "staging": "The woman studies her. Then points toward the man struggling to stand."}},
{"beat_id": "S014_B015", "speaker_id": "ilyra", "text": "Can I look?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BEYOND THE BARS", "source_speaker_label": "ILYRA", "staging": "Ilyra looks at him."}},
{"beat_id": "S014_B016", "speaker_id": "injured_man", "text": "Look.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BEYOND THE BARS", "source_speaker_label": "INJURED MAN"}},
{"beat_id": "S014_B017", "speaker_id": "injured_man", "text": "Don't fucking twist it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BEYOND THE BARS", "source_speaker_label": "INJURED MAN", "staging": "He points at her."}},
{"beat_id": "S014_B018", "speaker_id": "ilyra", "text": "Wasn't planning to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BEYOND THE BARS", "source_speaker_label": "ILYRA", "staging_after": "She kneels."}},
{"beat_id": "S014_B019", "speaker_id": "cyanis", "text": "These locks are newer than the walls.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "CYANIS", "staging": "Cheap 2.5D staging: one gallery room, several foreground prisoners, a few reusable seated/standing NPC poses, additional silhouettes through open bays. No crowd animation.\n\nWhile Ilyra works, Cyanis checks the nearest holding doors. Torren looks farther down the corridor."}},
{"beat_id": "S014_B020", "speaker_id": "torren", "text": "Same as upstairs.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "TORREN"}},
{"beat_id": "S014_B021", "speaker_id": "maevra", "text": "How long have you been here?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "MAEVRA", "staging": "Maevra looks around."}},
{"beat_id": "S014_B022", "speaker_id": "prisoner_woman", "text": "Which time?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "PRISONER WOMAN", "staging": "The Prisoner Woman shrugs."}},
{"beat_id": "S014_B023", "speaker_id": "prisoner_woman", "text": "They move us.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "PRISONER WOMAN", "staging": "Maevra looks at her."}},
{"beat_id": "S014_B024", "speaker_id": "prisoner_woman", "text": "Room to room. Sometimes farther.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "PRISONER WOMAN", "staging": "She points down the gallery."}},
{"beat_id": "S014_B025", "speaker_id": "maevra", "text": "Where?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S014_B026", "speaker_id": "prisoner_woman", "text": "If I knew, I'd have left through it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "PRISONER WOMAN"}},
{"beat_id": "S014_B027", "speaker_id": "ilyra", "text": "Can you straighten it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "ILYRA", "staging": "Fair. Maevra lets it go.\n\nIlyra examines the man's knee."}},
{"beat_id": "S014_B028", "speaker_id": "injured_man", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "INJURED MAN", "staging": "He tries. Stops."}},
{"beat_id": "S014_B029", "speaker_id": "ilyra", "text": "All right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "ILYRA"}},
{"beat_id": "S014_B030", "speaker_id": "injured_man", "text": "That's bad?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "INJURED MAN"}},
{"beat_id": "S014_B031", "speaker_id": "ilyra", "text": "It's not good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "ILYRA"}},
{"beat_id": "S014_B032", "speaker_id": "injured_man", "text": "Fantastic.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "INJURED MAN", "staging": "He laughs once despite himself."}},
{"beat_id": "S014_B033", "speaker_id": "ilyra", "text": "I can stabilize it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "ILYRA"}},
{"beat_id": "S014_B034", "speaker_id": "injured_man", "text": "Then do that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "INJURED MAN"}},
{"beat_id": "S014_B035", "speaker_id": "cyanis", "text": "How many doors?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "CYANIS", "staging": "Ilyra does. No elaborate medical animation: crouch pose, bandage prop, portrait exchange.\n\nCyanis returns."}},
{"beat_id": "S014_B036", "speaker_id": "cyanis", "text": "Doors, Harth.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "CYANIS", "staging": "Torren gives him a look."}},
{"beat_id": "S014_B037", "speaker_id": "torren", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "TORREN"}},
{"beat_id": "S014_B038", "speaker_id": "torren", "text": "Six on this section. More around the turn.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "TORREN", "staging": "Torren points."}},
{"beat_id": "S014_B039", "speaker_id": "maevra", "text": "We're opening them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "MAEVRA", "staging": "Maevra looks toward the prisoners."}},
{"beat_id": "S014_B040", "speaker_id": "prisoner_woman", "text": "Then open them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — NOT A HEADCOUNT", "source_speaker_label": "PRISONER WOMAN", "staging": "The Prisoner Woman stands."}},
{"beat_id": "S014_B041", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "The party moves through a moderate section of the Prisoner Galleries. Not huge. Expected first-pass pressure: roughly 2–3 random encounters.\n\nThe player clears connected gallery corridors while opening accessible holding areas. This is not “collect all prisoners” gameplay. Individual people become visible as sections are made safe.\n\nEnvironmental variation stays cheap:\n\nsame gallery kit,\n\ndifferent door states,\n\nbroken lamps,\n\nnewer Black Host braces,\n\nabandoned carts,\n\nbenches and restraint fixtures,\n\none flooded lower passage.\n\nA few freed prisoners remain where they are rather than automatically following the party. One refuses to move at all.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "EXPLORATION 1 — GALLERY CLEARANCE"}},
{"beat_id": "S014_B042", "speaker_id": "ilyra", "text": "May I?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "SHORT AUTHORED POCKET", "source_speaker_label": "ILYRA", "staging": "A middle-aged prisoner has a cut across his scalp. Ilyra approaches."}},
{"beat_id": "S014_B043", "speaker_id": "prisoner", "text": "Is my head still attached?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "SHORT AUTHORED POCKET", "source_speaker_label": "PRISONER"}},
{"beat_id": "S014_B044", "speaker_id": "ilyra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "SHORT AUTHORED POCKET", "source_speaker_label": "ILYRA"}},
{"beat_id": "S014_B045", "speaker_id": "prisoner", "text": "Then later.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "SHORT AUTHORED POCKET", "source_speaker_label": "PRISONER"}},
{"beat_id": "S014_B046", "speaker_id": "ilyra", "text": "All right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "SHORT AUTHORED POCKET", "source_speaker_label": "ILYRA"}},
{"beat_id": "S014_B047", "speaker_id": "second_prisoner", "text": "I need help.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "SHORT AUTHORED POCKET", "source_speaker_label": "SECOND PRISONER", "staging": "She moves on. No argument.\n\nFarther ahead, another prisoner catches her sleeve."}},
{"beat_id": "S014_B048", "speaker_id": "ilyra", "text": "Okay.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "SHORT AUTHORED POCKET", "source_speaker_label": "ILYRA", "staging": "Ilyra stops immediately.", "staging_after": "Different people. Different choices."}},
{"beat_id": "S014_B049", "speaker_id": "torren", "text": "This could hold.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHERE DO THEY GO?", "source_speaker_label": "TORREN", "staging": "The party reaches a wider junction. A service room sits off the main gallery. Stone walls. One heavy door. A manual bar on the inside.\n\nTorren checks it."}},
{"beat_id": "S014_B050", "speaker_id": "prisoner_woman", "text": "One door.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHERE DO THEY GO?", "source_speaker_label": "PRISONER WOMAN", "staging": "The Prisoner Woman arrives behind them with two others. She looks inside."}},
{"beat_id": "S014_B051", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHERE DO THEY GO?", "source_speaker_label": "TORREN"}},
{"beat_id": "S014_B052", "speaker_id": "prisoner_woman", "text": "Vent?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHERE DO THEY GO?", "source_speaker_label": "PRISONER WOMAN"}},
{"beat_id": "S014_B053", "speaker_id": "torren", "text": "There.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHERE DO THEY GO?", "source_speaker_label": "TORREN", "staging": "Torren points high on the wall."}},
{"beat_id": "S014_B054", "speaker_id": "prisoner_woman", "text": "Other entrance?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHERE DO THEY GO?", "source_speaker_label": "PRISONER WOMAN"}},
{"beat_id": "S014_B055", "speaker_id": "torren", "text": "Not unless somebody starts digging.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHERE DO THEY GO?", "source_speaker_label": "TORREN"}},
{"beat_id": "S014_B056", "speaker_id": "prisoner_woman", "text": "Better than the cells.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHERE DO THEY GO?", "source_speaker_label": "PRISONER WOMAN", "staging": "She nods."}},
{"beat_id": "S014_B057", "speaker_id": "maevra", "text": "We can put everyone who wants to wait here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHERE DO THEY GO?", "source_speaker_label": "MAEVRA", "staging": "Maevra looks at her."}},
{"beat_id": "S014_B058", "speaker_id": "prisoner_woman", "text": "Who wants to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHERE DO THEY GO?", "source_speaker_label": "PRISONER WOMAN", "staging": "The woman catches the wording."}},
{"beat_id": "S014_B059", "speaker_id": "maevra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHERE DO THEY GO?", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S014_B060", "speaker_id": "prisoner_woman", "text": "We keep the door.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHERE DO THEY GO?", "source_speaker_label": "PRISONER WOMAN", "staging": "A beat. The woman looks at the interior bar."}},
{"beat_id": "S014_B061", "speaker_id": "maevra", "text": "You keep the door.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHERE DO THEY GO?", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S014_B062", "speaker_id": "torren", "text": "Once it's down, nobody gets in without you lifting it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHERE DO THEY GO?", "source_speaker_label": "TORREN", "staging": "Torren checks the locking bar."}},
{"beat_id": "S014_B063", "speaker_id": "prisoner_woman", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHERE DO THEY GO?", "source_speaker_label": "PRISONER WOMAN"}},
{"beat_id": "S014_B064", "speaker_id": "cyanis", "text": "And if we come back running?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHERE DO THEY GO?", "source_speaker_label": "CYANIS", "staging": "Cyanis looks down the corridor they came from."}},
{"beat_id": "S014_B065", "speaker_id": "prisoner_woman", "text": "Knock.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHERE DO THEY GO?", "source_speaker_label": "PRISONER WOMAN", "staging": "She looks at him."}},
{"beat_id": "S014_B066", "speaker_id": "cyanis", "text": "Fair.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — WHERE DO THEY GO?", "source_speaker_label": "CYANIS"}},
{"beat_id": "S014_B067", "speaker_id": "ilyra", "text": "Can you walk?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WHO CAN MOVE", "source_speaker_label": "ILYRA", "staging": "The service room becomes the defensible safe pocket. No random encounters can trigger inside it or immediately outside once secured. Ilyra triages people who choose to enter. No montage. A few short exchanges carry it.\n\nShe addresses an older man."}},
{"beat_id": "S014_B068", "speaker_id": "older_prisoner", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WHO CAN MOVE", "source_speaker_label": "OLDER PRISONER"}},
{"beat_id": "S014_B069", "speaker_id": "ilyra", "text": "Still yes?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WHO CAN MOVE", "source_speaker_label": "ILYRA", "staging": "He tries to rise. Nearly falls. Ilyra catches his elbow only after he reaches for her."}},
{"beat_id": "S014_B070", "speaker_id": "older_prisoner", "text": "Fuck you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WHO CAN MOVE", "source_speaker_label": "OLDER PRISONER"}},
{"beat_id": "S014_B071", "speaker_id": "ilyra", "text": "I'll put that down as maybe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WHO CAN MOVE", "source_speaker_label": "ILYRA"}},
{"beat_id": "S014_B072", "speaker_id": "injured_man", "text": "I can walk.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WHO CAN MOVE", "source_speaker_label": "INJURED MAN", "staging": "He laughs despite himself.\n\nNearby, the injured man from earlier looks at his braced knee."}},
{"beat_id": "S014_B073", "speaker_id": "ilyra", "text": "Not on that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WHO CAN MOVE", "source_speaker_label": "ILYRA"}},
{"beat_id": "S014_B074", "speaker_id": "injured_man", "text": "I didn't ask.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WHO CAN MOVE", "source_speaker_label": "INJURED MAN"}},
{"beat_id": "S014_B075", "speaker_id": "ilyra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WHO CAN MOVE", "source_speaker_label": "ILYRA", "staging": "Ilyra looks at him."}},
{"beat_id": "S014_B076", "speaker_id": "injured_man", "text": "Fine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WHO CAN MOVE", "source_speaker_label": "INJURED MAN", "staging": "He looks back. A beat."}},
{"beat_id": "S014_B077", "speaker_id": "injured_man", "text": "What the hell am I supposed to do with that?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WHO CAN MOVE", "source_speaker_label": "INJURED MAN", "staging": "No lecture. Torren brings over an old maintenance stool."}},
{"beat_id": "S014_B078", "speaker_id": "torren", "text": "Sit on it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WHO CAN MOVE", "source_speaker_label": "TORREN"}},
{"beat_id": "S014_B079", "speaker_id": "injured_man", "text": "I gathered that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WHO CAN MOVE", "source_speaker_label": "INJURED MAN"}},
{"beat_id": "S014_B080", "speaker_id": "torren", "text": "Then we're making excellent progress.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — WHO CAN MOVE", "source_speaker_label": "TORREN", "staging_after": "The man sits."}},
{"beat_id": "S014_B081", "speaker_id": "maevra", "text": "This returns to the Archive.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "MAEVRA", "staging": "Maevra examines the old service map beside the door. Torren joins her."}},
{"beat_id": "S014_B082", "speaker_id": "torren", "text": "Not anymore.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "TORREN"}},
{"beat_id": "S014_B083", "speaker_id": "torren", "text": "Collapsed here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "TORREN", "staging": "He traces a damaged section."}},
{"beat_id": "S014_B084", "speaker_id": "torren", "text": "This one goes up.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "TORREN", "staging": "Another route."}},
{"beat_id": "S014_B085", "speaker_id": "prisoner_woman", "text": "Locked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "PRISONER WOMAN", "staging": "The Prisoner Woman looks over."}},
{"beat_id": "S014_B086", "speaker_id": "prisoner_woman", "text": "Tried it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "PRISONER WOMAN", "staging": "Torren turns."}},
{"beat_id": "S014_B087", "speaker_id": "cyanis", "text": "What's on the other side?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "CYANIS"}},
{"beat_id": "S014_B088", "speaker_id": "prisoner_woman", "text": "More guards.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "PRISONER WOMAN"}},
{"beat_id": "S014_B089", "speaker_id": "maevra", "text": "Anything else?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "MAEVRA", "staging": "Helpful."}},
{"beat_id": "S014_B090", "speaker_id": "prisoner_woman", "text": "They call it the transfer line.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "PRISONER WOMAN", "staging": "The woman thinks."}},
{"beat_id": "S014_B091", "speaker_id": "torren", "text": "Runs west.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "TORREN", "staging": "Maevra looks at Torren. He is already following the map."}},
{"beat_id": "S014_B092", "speaker_id": "cyanis", "text": "Toward what?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "CYANIS", "staging": "Cyanis looks over his shoulder."}},
{"beat_id": "S014_B093", "speaker_id": "torren", "text": "Something bigger.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "TORREN", "staging": "Torren follows the markings. Stops."}},
{"beat_id": "S014_B094", "speaker_id": "prisoner_woman", "text": "Bastion.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "PRISONER WOMAN", "staging": "The Prisoner Woman answers from behind him."}},
{"beat_id": "S014_B095", "speaker_id": "prisoner_woman", "text": "That's what they call it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "PRISONER WOMAN", "staging": "Maevra turns."}},
{"beat_id": "S014_B096", "speaker_id": "cyanis", "text": "Can we get these people out without going through it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "CYANIS", "staging": "Silence."}},
{"beat_id": "S014_B097", "speaker_id": "torren", "text": "Not from here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "TORREN", "staging": "Torren studies the damaged map longer. Then:"}},
{"beat_id": "S014_B098", "speaker_id": "maevra", "text": "Certain?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "MAEVRA", "staging": "Maevra looks at him."}},
{"beat_id": "S014_B099", "speaker_id": "torren", "text": "Unless you want to take injured people back through the flooded Archive, across a broken floor, and up Dunmere's waterworks.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "TORREN"}},
{"beat_id": "S014_B100", "speaker_id": "injured_man", "text": "I'd rather not.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "INJURED MAN", "staging": "The injured man raises a hand from across the room."}},
{"beat_id": "S014_B101", "speaker_id": "torren", "text": "There you go.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE ROUTE OUT", "source_speaker_label": "TORREN", "staging": "Torren looks over."}},
{"beat_id": "S014_B102", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "The party leaves the prisoners in the defensible pocket. The prisoners themselves lower the inside bar. The door closes behind the party.\n\nImportant: the party does not “lock the prisoners in.” The prisoners control the safe room state.\n\nThe transfer spine is another moderate random-battle area, around 2–3 likely encounters.\n\nThis section is more actively used than the Archive:\n\nnewer lamps,\n\nmaintained doors,\n\nBlack Host storage,\n\nempty transport restraints,\n\nrepaired stonework,\n\nclearer foot traffic.\n\nSame basic gallery/service assets, changed dressing and lighting. No expensive new dungeon kit. Black Host formations become more common.\n\nThe objective is practical: Find and open a viable extraction route.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "EXPLORATION 2 — TRANSFER SPINE"}},
{"beat_id": "S014_B103", "speaker_id": "cyanis", "text": "This isn't opening from here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE TRANSFER GATE", "source_speaker_label": "CYANIS", "staging": "The party reaches a broad mechanical gate. Torren checks the controls. Cyanis examines the newer reinforcement around the frame."}},
{"beat_id": "S014_B104", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE TRANSFER GATE", "source_speaker_label": "TORREN"}},
{"beat_id": "S014_B105", "speaker_id": "maevra", "text": "Can we break it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE TRANSFER GATE", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S014_B106", "speaker_id": "cyanis", "text": "Eventually.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE TRANSFER GATE", "source_speaker_label": "CYANIS", "staging": "Cyanis looks at the size of the gate. Then at her."}},
{"beat_id": "S014_B107", "speaker_id": "torren", "text": "And bring half the fucking ceiling down.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE TRANSFER GATE", "source_speaker_label": "TORREN"}},
{"beat_id": "S014_B108", "speaker_id": "cyanis", "text": "I said eventually.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE TRANSFER GATE", "source_speaker_label": "CYANIS"}},
{"beat_id": "S014_B109", "speaker_id": "ilyra", "text": "They're using the other side.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE TRANSFER GATE", "source_speaker_label": "ILYRA", "staging": "Ilyra looks through a narrow opening in the gate. Beyond it: a maintained route, more recent structures, movement in the distance."}},
{"beat_id": "S014_B110", "speaker_id": "maevra", "text": "Where is this controlled?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE TRANSFER GATE", "source_speaker_label": "MAEVRA", "staging": "Maevra looks at the control housing."}},
{"beat_id": "S014_B111", "speaker_id": "torren", "text": "West.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE TRANSFER GATE", "source_speaker_label": "TORREN", "staging": "Torren follows a bundle of mechanical linkages through the wall."}},
{"beat_id": "S014_B112", "speaker_id": "maevra", "text": "The Bastion.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE TRANSFER GATE", "source_speaker_label": "MAEVRA", "staging": "Maevra already knows."}},
{"beat_id": "S014_B113", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE TRANSFER GATE", "source_speaker_label": "TORREN", "staging_after": "A sound from behind. Metal. Fast. Torren turns. A Black Host patrol enters the junction from the side passage."}},
{"beat_id": "S014_B114", "speaker_id": "maevra", "text": "Torren!", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF"], "source_section": "AUTHORED COMBAT", "source_speaker_label": "MAEVRA", "staging": "Not a boss. A short mandatory battle caused by the party being caught at the gate. During the opening exchange, one attacker moves past Cyanis toward the return corridor. Torren breaks away to intercept. Another comes in from his blind side. Maevra sees it."}},
{"beat_id": "S014_B115", "speaker_id": "maevra", "text": "Harth.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF"], "source_section": "AUTHORED COMBAT", "source_speaker_label": "MAEVRA", "staging": "Immediate beat.", "staging_after": "Torren ducks the strike. No one reacts to the name. No portrait hold. No music sting. The fight continues."}},
{"beat_id": "S014_B116", "speaker_id": "cyanis", "text": "Still closed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — AFTER THE FIGHT", "source_speaker_label": "CYANIS", "staging": "Battle ends. Torren retrieves an arrow. Maevra checks the corridor. Nothing is said about the slip. Cyanis examines the gate again."}},
{"beat_id": "S014_B117", "speaker_id": "torren", "text": "Amazing what violence fails to accomplish.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — AFTER THE FIGHT", "source_speaker_label": "TORREN"}},
{"beat_id": "S014_B118", "speaker_id": "ilyra", "text": "You sound disappointed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — AFTER THE FIGHT", "source_speaker_label": "ILYRA"}},
{"beat_id": "S014_B119", "speaker_id": "torren", "text": "A little.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — AFTER THE FIGHT", "source_speaker_label": "TORREN"}},
{"beat_id": "S014_B120", "speaker_id": "maevra", "text": "If the Bastion controls this, we take the control.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — AFTER THE FIGHT", "source_speaker_label": "MAEVRA", "staging": "Maevra looks toward the west passage."}},
{"beat_id": "S014_B121", "speaker_id": "cyanis", "text": "Then come back for them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — AFTER THE FIGHT", "source_speaker_label": "CYANIS", "staging": "Cyanis looks at her."}},
{"beat_id": "S014_B122", "speaker_id": "maevra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — AFTER THE FIGHT", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S014_B123", "speaker_id": "ilyra", "text": "They're going to be waiting without knowing if we made it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — AFTER THE FIGHT", "source_speaker_label": "ILYRA", "staging": "Ilyra looks toward the safe-room route."}},
{"beat_id": "S014_B124", "speaker_id": "torren", "text": "Better than moving them through this.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — AFTER THE FIGHT", "source_speaker_label": "TORREN"}},
{"beat_id": "S014_B125", "speaker_id": "ilyra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — AFTER THE FIGHT", "source_speaker_label": "ILYRA", "staging": "She nods."}},
{"beat_id": "S014_B126", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "They return briefly to the defensible pocket before committing west. No random encounters on the cleared return.\n\nCyanis knocks. Three deliberate knocks. Nothing. Then:", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "B008 — TELL THEM FIRST"}},
{"beat_id": "S014_B127", "speaker_id": "prisoner_woman", "text": "Who?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — TELL THEM FIRST", "source_speaker_label": "PRISONER WOMAN — THROUGH DOOR", "delivery": "through_door"}},
{"beat_id": "S014_B128", "speaker_id": "cyanis", "text": "Dovaren.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — TELL THEM FIRST", "source_speaker_label": "CYANIS"}},
{"beat_id": "S014_B129", "speaker_id": "prisoner_woman", "text": "Just Dovaren?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — TELL THEM FIRST", "source_speaker_label": "PRISONER WOMAN", "staging": "A beat."}},
{"beat_id": "S014_B130", "speaker_id": "cyanis", "text": "Currently.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — TELL THEM FIRST", "source_speaker_label": "CYANIS", "staging": "Cyanis looks at the others."}},
{"beat_id": "S014_B131", "speaker_id": "maevra", "text": "The extraction gate is controlled from the Bastion.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — TELL THEM FIRST", "source_speaker_label": "MAEVRA", "staging": "The bar lifts. The door opens. Cheap state swap. Maevra gives them the truth."}},
{"beat_id": "S014_B132", "speaker_id": "prisoner_woman", "text": "Of course it fucking is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — TELL THEM FIRST", "source_speaker_label": "PRISONER WOMAN", "staging": "The Prisoner Woman exhales."}},
{"beat_id": "S014_B133", "speaker_id": "maevra", "text": "We're going to open it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — TELL THEM FIRST", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S014_B134", "speaker_id": "prisoner_woman", "text": "How long?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — TELL THEM FIRST", "source_speaker_label": "PRISONER WOMAN"}},
{"beat_id": "S014_B135", "speaker_id": "maevra", "text": "I don't know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — TELL THEM FIRST", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S014_B136", "speaker_id": "prisoner_woman", "text": "All right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — TELL THEM FIRST", "source_speaker_label": "PRISONER WOMAN", "staging": "The woman studies her. Maevra does not make up a reassuring number."}},
{"beat_id": "S014_B137", "speaker_id": "prisoner_woman", "text": "Commander.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — TELL THEM FIRST", "source_speaker_label": "PRISONER WOMAN", "staging": "She starts closing the door. Then stops."}},
{"beat_id": "S014_B138", "speaker_id": "prisoner_woman", "text": "Don't open that gate and assume we're ready.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — TELL THEM FIRST", "source_speaker_label": "PRISONER WOMAN", "staging": "Maevra looks at her."}},
{"beat_id": "S014_B139", "speaker_id": "maevra", "text": "We come back first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — TELL THEM FIRST", "source_speaker_label": "MAEVRA", "staging": "Maevra nods."}},
{"beat_id": "S014_B140", "speaker_id": "prisoner_woman", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — TELL THEM FIRST", "source_speaker_label": "PRISONER WOMAN", "staging_after": "She closes the door. The bar drops from inside."}},
{"beat_id": "S014_B141", "speaker_id": "maevra", "text": "Let's go.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — WEST", "source_speaker_label": "MAEVRA", "staging": "The party turns toward the western transfer route. No speech about heroism. No prisoner count. No assumption that the people they found correspond exactly to the thirty-one transfer records.\n\nTorren checks his bow. Ilyra adjusts her medical bag. Cyanis looks toward the maintained corridor. Maevra starts walking."}},
{"beat_id": "S014_B142", "speaker_id": "torren", "text": "Well.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "RETURN_PLAYER_CONTROL"], "source_section": "B009 — WEST", "source_speaker_label": "TORREN", "staging": "Control returns. A short final combat/exploration stretch leads toward the Red Transfer Bastion. Likely 1–2 random encounters, depending on rolls.\n\nThe environment transitions gradually from prison/service architecture into increasingly deliberate Black Host military construction. No new giant level.\n\nAt the end, the corridor opens onto the first view of the Red Transfer Bastion. Let the environment land without dialogue first. The place is active. Lit. Guarded. Working.\n\nThen:"}},
{"beat_id": "S014_B143", "speaker_id": "cyanis", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — WEST", "source_speaker_label": "CYANIS"}},
{"beat_id": "S014_B144", "speaker_id": "ilyra", "text": "That's where it goes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — WEST", "source_speaker_label": "ILYRA", "staging": "Ilyra looks at the transfer lines entering the structure."}},
{"beat_id": "S014_B145", "speaker_id": "maevra", "text": "Then that's where we're going.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — WEST", "source_speaker_label": "MAEVRA", "staging": "Maevra watches the Bastion.", "staging_after": "**END S014. Transition to S015 — Red Transfer Bastion / Commander Rhazek.**"}},
{"beat_id": "S014_B146", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "Prisoners are individual adults, not an objective counter.\n\n“Thirty-one transfers” is never converted into the number of people present.\n\nPrisoners can accept or refuse care; Ilyra asks before touching/treating.\n\nDifferent injuries and mobility states matter.\n\nThe party establishes a real defensible safe pocket.\n\nPrisoners retain control of the inside door/bar.\n\nThe party does not order everyone into immediate unsafe evacuation.\n\nDamaged routes make attacking the Bastion necessary to create a viable way out.\n\nTwo moderate random-battle stretches plus a short final approach; no oversized dungeon.\n\nThe single protected relationship breach is “Torren!” followed immediately by “Harth.” Nobody comments on it.\n\nMaevra and Torren otherwise remain appropriately formal.\n\nCheap 2.5D throughout: reusable gallery/service kits, door states, portraits, simple prisoner poses, existing enemy formations, lighting/dressing changes.\n\nThe ending establishes why S015 must happen without turning the Bastion into an abstract quest marker.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "S014 — LOCKED CONTINUITY NOTES"}}
]
