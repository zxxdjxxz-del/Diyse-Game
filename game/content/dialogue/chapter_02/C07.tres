authoring_notes = "Chapter 2 exact Resource conversion from docs/chapters/dialogue/chapter_02/C07.md under Complete Master Canon v1.64 / Audit79, Chapter transcript checkpoint Audit78. Spoken text is line-complete and must not be rewritten. Source staging/prose is preserved in cue metadata; source subsection and source speaker labels are carried in cues. Portrait slots remain empty until approved assets are wired. Spoken-sequence SHA-256: db7fc956622604a6b2bdfb7e77cc988550791906d8191102de219b8f60ecc031."
beats = [
{"beat_id": "C07_B001", "speaker_id": "torren", "text": "Fuck.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — TORREN", "source_speaker_label": "TORREN", "staging": "Late night. The room is dark except for low coals near the doorway. Cyanis and Ilyra are asleep.\n\nTorren wakes. Nothing dramatic. Eyes open. He lies there for a while. Eventually:", "staging_after": "Quietly. He sits up. Checks the others. Still asleep.\n\nTorren gets up, moves to the doorway and sits against the wall. He takes out a blunt and uses one of the remaining coals to light it. Small ember. A little smoke disappears through the open doorway.\n\nHe takes a slow pull. Sits there. The tension gradually leaves his shoulders. No speech. A minute passes."}},
{"beat_id": "C07_B002", "speaker_id": "ilyra", "text": "You’re going to burn your fingers doing that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — ILYRA", "source_speaker_label": "ILYRA", "staging": "From behind him:"}},
{"beat_id": "C07_B003", "speaker_id": "torren", "text": "Haven’t yet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — ILYRA", "source_speaker_label": "TORREN", "staging": "Torren doesn’t turn around."}},
{"beat_id": "C07_B004", "speaker_id": "ilyra", "text": "That’s an incredibly stupid defense.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — ILYRA", "source_speaker_label": "ILYRA", "staging": "Ilyra sits up."}},
{"beat_id": "C07_B005", "speaker_id": "torren", "text": "Still a defense.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — ILYRA", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B006", "speaker_id": "ilyra", "text": "How long have you been up?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — ILYRA", "source_speaker_label": "ILYRA", "staging": "She looks toward Cyanis. Still asleep. Then back at Torren."}},
{"beat_id": "C07_B007", "speaker_id": "torren", "text": "Don’t know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — ILYRA", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B008", "speaker_id": "ilyra", "text": "Useful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — ILYRA", "source_speaker_label": "ILYRA"}},
{"beat_id": "C07_B009", "speaker_id": "torren", "text": "Wasn’t keeping records.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — ILYRA", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B010", "speaker_id": "ilyra", "text": "That the same shit you had three nights ago?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — ILYRA", "source_speaker_label": "ILYRA", "staging": "Ilyra gets up and sits near the doorway. Not right beside him. Close enough. Torren takes another pull. Ilyra looks at the blunt."}},
{"beat_id": "C07_B011", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — ILYRA", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B012", "speaker_id": "ilyra", "text": "Smells different.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — ILYRA", "source_speaker_label": "ILYRA"}},
{"beat_id": "C07_B013", "speaker_id": "torren", "text": "Got wet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — ILYRA", "source_speaker_label": "TORREN", "staging": "Torren looks at it."}},
{"beat_id": "C07_B014", "speaker_id": "ilyra", "text": "Of course it did.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — ILYRA", "source_speaker_label": "ILYRA", "staging": "Ilyra stares at him."}},
{"beat_id": "C07_B015", "speaker_id": "torren", "text": "Everything got fucking wet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — ILYRA", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B016", "speaker_id": "ilyra", "text": "You had pockets.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — ILYRA", "source_speaker_label": "ILYRA"}},
{"beat_id": "C07_B017", "speaker_id": "torren", "text": "Wet pockets.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — ILYRA", "source_speaker_label": "TORREN", "staging_after": "Fair. Ilyra reaches for the water. Drinks. Torren looks outside. Neither says anything for a while."}},
{"beat_id": "C07_B018", "speaker_id": "ilyra", "text": "You going back to sleep?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — NOT TALKING ABOUT IT", "source_speaker_label": "ILYRA", "staging": "Ilyra glances sideways. Torren looks calmer now. Focused. Normal."}},
{"beat_id": "C07_B019", "speaker_id": "torren", "text": "Eventually.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — NOT TALKING ABOUT IT", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B020", "speaker_id": "ilyra", "text": "Good plan.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — NOT TALKING ABOUT IT", "source_speaker_label": "ILYRA"}},
{"beat_id": "C07_B021", "speaker_id": "torren", "text": "You?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — NOT TALKING ABOUT IT", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B022", "speaker_id": "ilyra", "text": "Apparently not.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — NOT TALKING ABOUT IT", "source_speaker_label": "ILYRA", "staging": "Ilyra looks back toward her bedroll."}},
{"beat_id": "C07_B023", "speaker_id": "ilyra", "text": "You know what I hate?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — NOT TALKING ABOUT IT", "source_speaker_label": "ILYRA", "staging": "Torren nods. That’s the entire discussion. He doesn’t ask why. She doesn’t ask why. A few seconds."}},
{"beat_id": "C07_B024", "speaker_id": "torren", "text": "That’s a dangerous opening.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — NOT TALKING ABOUT IT", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B025", "speaker_id": "ilyra", "text": "Wet sleeves.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — NOT TALKING ABOUT IT", "source_speaker_label": "ILYRA"}},
{"beat_id": "C07_B026", "speaker_id": "torren", "text": "That’s it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — NOT TALKING ABOUT IT", "source_speaker_label": "TORREN", "staging": "Torren looks at her."}},
{"beat_id": "C07_B027", "speaker_id": "ilyra", "text": "Right now.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — NOT TALKING ABOUT IT", "source_speaker_label": "ILYRA"}},
{"beat_id": "C07_B028", "speaker_id": "torren", "text": "Fair.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — NOT TALKING ABOUT IT", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B029", "speaker_id": "ilyra", "text": "You?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — NOT TALKING ABOUT IT", "source_speaker_label": "ILYRA"}},
{"beat_id": "C07_B030", "speaker_id": "torren", "text": "People who say “could be worse.”", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — NOT TALKING ABOUT IT", "source_speaker_label": "TORREN", "staging": "Torren thinks. Takes another pull."}},
{"beat_id": "C07_B031", "speaker_id": "ilyra", "text": "That’s a good one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — NOT TALKING ABOUT IT", "source_speaker_label": "ILYRA"}},
{"beat_id": "C07_B032", "speaker_id": "torren", "text": "Every time somebody says it, the world hears them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — NOT TALKING ABOUT IT", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B033", "speaker_id": "ilyra", "text": "That’s not how anything works.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — NOT TALKING ABOUT IT", "source_speaker_label": "ILYRA"}},
{"beat_id": "C07_B034", "speaker_id": "torren", "text": "Prove it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — NOT TALKING ABOUT IT", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B035", "speaker_id": "ilyra", "text": "Fuck you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — NOT TALKING ABOUT IT", "source_speaker_label": "ILYRA", "staging": "Ilyra thinks about answering. Doesn’t.", "staging_after": "Torren smiles. Barely."}},
{"beat_id": "C07_B036", "speaker_id": "cyanis", "text": "If you two are going to whisper, whisper louder.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — CYANIS", "source_speaker_label": "CYANIS", "staging": "From the bedroll:"}},
{"beat_id": "C07_B037", "speaker_id": "ilyra", "text": "Go back to sleep.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — CYANIS", "source_speaker_label": "ILYRA", "staging": "Neither turns around."}},
{"beat_id": "C07_B038", "speaker_id": "cyanis", "text": "Can’t.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — CYANIS", "source_speaker_label": "CYANIS"}},
{"beat_id": "C07_B039", "speaker_id": "torren", "text": "Tragic.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — CYANIS", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B040", "speaker_id": "cyanis", "text": "How long has this been happening?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — CYANIS", "source_speaker_label": "CYANIS", "staging": "Cyanis sits up. Looks at both of them by the doorway."}},
{"beat_id": "C07_B041", "speaker_id": "torren", "text": "What?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — CYANIS", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B042", "speaker_id": "cyanis", "text": "Whatever this is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — CYANIS", "source_speaker_label": "CYANIS"}},
{"beat_id": "C07_B043", "speaker_id": "ilyra", "text": "We’re discussing sleeves.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — CYANIS", "source_speaker_label": "ILYRA"}},
{"beat_id": "C07_B044", "speaker_id": "cyanis", "text": "Of course you are.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — CYANIS", "source_speaker_label": "CYANIS", "staging": "Cyanis stares at her."}},
{"beat_id": "C07_B045", "speaker_id": "cyanis", "text": "Comfortable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — CYANIS", "source_speaker_label": "CYANIS", "staging": "He gets up and joins them. There are only two convenient places to sit. Cyanis looks around. Torren shifts his boot a few inches. That’s apparently enough. Cyanis sits on the floor."}},
{"beat_id": "C07_B046", "speaker_id": "torren", "text": "Didn’t say it was.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — CYANIS", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B047", "speaker_id": "cyanis", "text": "That’s what woke me up.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THREE AWAKE PEOPLE", "source_speaker_label": "CYANIS", "staging": "The blunt remains in Torren’s hand. Nobody treats it as an event. Cyanis smells the smoke."}},
{"beat_id": "C07_B048", "speaker_id": "ilyra", "text": "No, it isn’t.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THREE AWAKE PEOPLE", "source_speaker_label": "ILYRA"}},
{"beat_id": "C07_B049", "speaker_id": "cyanis", "text": "You don’t know that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THREE AWAKE PEOPLE", "source_speaker_label": "CYANIS"}},
{"beat_id": "C07_B050", "speaker_id": "ilyra", "text": "You were awake before he lit it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THREE AWAKE PEOPLE", "source_speaker_label": "ILYRA"}},
{"beat_id": "C07_B051", "speaker_id": "cyanis", "text": "How do you know?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THREE AWAKE PEOPLE", "source_speaker_label": "CYANIS", "staging": "Cyanis looks at her."}},
{"beat_id": "C07_B052", "speaker_id": "ilyra", "text": "You sigh when you’re pretending to sleep.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THREE AWAKE PEOPLE", "source_speaker_label": "ILYRA"}},
{"beat_id": "C07_B053", "speaker_id": "cyanis", "text": "Do I?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THREE AWAKE PEOPLE", "source_speaker_label": "CYANIS", "staging": "Beat. Cyanis turns to Torren."}},
{"beat_id": "C07_B054", "speaker_id": "torren", "text": "Constantly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THREE AWAKE PEOPLE", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B055", "speaker_id": "cyanis", "text": "Both of you can go fuck yourselves.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THREE AWAKE PEOPLE", "source_speaker_label": "CYANIS"}},
{"beat_id": "C07_B056", "speaker_id": "torren", "text": "Good. You’re awake.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THREE AWAKE PEOPLE", "source_speaker_label": "TORREN", "staging": "Torren takes another pull."}},
{"beat_id": "C07_B057", "speaker_id": "cyanis", "text": "I was awake.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THREE AWAKE PEOPLE", "source_speaker_label": "CYANIS"}},
{"beat_id": "C07_B058", "speaker_id": "torren", "text": "Now you’re awake and angry.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THREE AWAKE PEOPLE", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B059", "speaker_id": "cyanis", "text": "Improvement?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THREE AWAKE PEOPLE", "source_speaker_label": "CYANIS"}},
{"beat_id": "C07_B060", "speaker_id": "torren", "text": "For you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THREE AWAKE PEOPLE", "source_speaker_label": "TORREN", "staging_after": "Ilyra drinks more water."}},
{"beat_id": "C07_B061", "speaker_id": "cyanis", "text": "Think Marr’s actually getting that timber tonight?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "CYANIS", "staging": "Nobody tries to sleep. Not yet. Cyanis looks outside."}},
{"beat_id": "C07_B062", "speaker_id": "torren", "text": "Probably.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B063", "speaker_id": "ilyra", "text": "You told Solmar he needed all of it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "ILYRA"}},
{"beat_id": "C07_B064", "speaker_id": "torren", "text": "He asked how much.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B065", "speaker_id": "cyanis", "text": "You said “yes.”", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "CYANIS"}},
{"beat_id": "C07_B066", "speaker_id": "torren", "text": "Accurate answer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B067", "speaker_id": "ilyra", "text": "Not remotely.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "ILYRA"}},
{"beat_id": "C07_B068", "speaker_id": "torren", "text": "They’ll bring too much.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B069", "speaker_id": "cyanis", "text": "And?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "CYANIS"}},
{"beat_id": "C07_B070", "speaker_id": "torren", "text": "Then we’ll have enough.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B071", "speaker_id": "cyanis", "text": "I hate that that’s defensible.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "CYANIS", "staging": "Cyanis considers this."}},
{"beat_id": "C07_B072", "speaker_id": "ilyra", "text": "Don’t encourage him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "ILYRA"}},
{"beat_id": "C07_B073", "speaker_id": "torren", "text": "Too late.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B074", "speaker_id": "cyanis", "text": "Those still wet?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "CYANIS", "staging": "A pause. Cyanis notices Torren’s boots."}},
{"beat_id": "C07_B075", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B076", "speaker_id": "cyanis", "text": "Mine too.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "CYANIS"}},
{"beat_id": "C07_B077", "speaker_id": "ilyra", "text": "Mine aren’t.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "ILYRA", "staging": "Ilyra looks down at hers."}},
{"beat_id": "C07_B078", "speaker_id": "ilyra", "text": "What?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "ILYRA", "staging": "Both men look at her."}},
{"beat_id": "C07_B079", "speaker_id": "cyanis", "text": "Nothing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "CYANIS"}},
{"beat_id": "C07_B080", "speaker_id": "torren", "text": "Nothing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B081", "speaker_id": "ilyra", "text": "You’re both idiots.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "ILYRA"}},
{"beat_id": "C07_B082", "speaker_id": "torren", "text": "Dry-footed privilege.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B083", "speaker_id": "ilyra", "text": "Shut up.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "ILYRA", "staging": "Ilyra laughs before she can stop herself. Immediately covers her mouth so she doesn’t wake anyone else nearby. Cyanis grins."}},
{"beat_id": "C07_B084", "speaker_id": "cyanis", "text": "Didn’t say anything.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "CYANIS"}},
{"beat_id": "C07_B085", "speaker_id": "ilyra", "text": "Your face did.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "ILYRA"}},
{"beat_id": "C07_B086", "speaker_id": "torren", "text": "It does that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STUPID SHIT", "source_speaker_label": "TORREN", "staging": "Beat. Torren looks at Cyanis."}},
{"beat_id": "C07_B087", "speaker_id": "cyanis", "text": "What time is it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — QUIETER", "source_speaker_label": "CYANIS", "staging": "The conversation dies naturally. Not sadly. They just run out of things worth saying. Torren rests his forearms on his knees. The blunt burns lower. Cyanis leans back against the wall. Ilyra pulls part of the blanket from her bedroll around her shoulders. Nobody goes back to bed.\n\nAfter a while:"}},
{"beat_id": "C07_B088", "speaker_id": "torren", "text": "Late.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — QUIETER", "source_speaker_label": "TORREN", "staging": "Torren looks outside."}},
{"beat_id": "C07_B089", "speaker_id": "cyanis", "text": "Helpful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — QUIETER", "source_speaker_label": "CYANIS"}},
{"beat_id": "C07_B090", "speaker_id": "torren", "text": "Getting lighter.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — QUIETER", "source_speaker_label": "TORREN"}},
{"beat_id": "C07_B091", "speaker_id": "ilyra", "text": "We should sleep.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — QUIETER", "source_speaker_label": "ILYRA", "staging": "Ilyra looks toward the doorway. He’s right. Very faint dawn."}},
{"beat_id": "C07_B092", "speaker_id": "cyanis", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — QUIETER", "source_speaker_label": "CYANIS", "staging": "Nobody moves. Beat.", "staging_after": "Nobody moves. Torren takes one final pull. Puts the end out against the ash beside the coals and saves what remains rather than throwing it away. Cheap prop-state change. Silence again."}},
{"beat_id": "C07_B093", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "Gradual light change. No montage. No one discusses the dreams. No one asks if the others are okay.\n\nCyanis eventually lets his head rest back against the wall. Ilyra’s eyes close while she’s still sitting up. Torren looks out through the doorway. Calm. Focused. A little tired. But fine.\n\nHe glances at the other two. Then back outside. Hold. Fade.\n\n> **END C07.**", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "B008 — MORNING"}},
{"beat_id": "C07_B094", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "The earlier recovered/protected C07 line set is retired and does not control this version.\n\nNo dream flashback, confession, forced disclosure, or therapy conversation. Nobody asks what another person dreamed about.\n\nTorren sometimes smokes weed late at night to relax and focus. In Diyse this does not impair motor skills, judgment, thinking, or combat capability, and the scene does not frame it as a vice or problem.\n\nNo modern lighter is used. Torren lights the blunt from the existing low coals in the rest area.\n\nProduction remains minimal: one reused rest area, three bedrolls, an open doorway, water, low coals, a blunt, portraits, existing seated/lying poses, a small ember/smoke loop, and a gradual dawn-light change.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "C07 — LOCKED CONTINUITY NOTES"}}
]
