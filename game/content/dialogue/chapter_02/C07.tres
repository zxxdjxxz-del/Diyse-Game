authoring_notes = "Audit75 closed-authority conversion of C07 Bad Dreams, No Questions. Exact full archival transcript is not serialized; only recovered protected wording and controlling scene structure are promoted. No dream flashback, forced disclosure, trauma monologue, interrogation, Card/Prime material, reward, or romance milestone. Cheap 2.5D uses night lighting, water, pouch/work distraction, blanket, bootlace, reusable sit/stand states, portraits, and silence."
beats = [{"beat_id":"C07_B001","cues":{"staging":"Quiet post-S016 night. The three have each slept badly. Do not show any dream, flashback, symbolic nightmare image, or narrated trauma content."}},
{"beat_id":"C07_B002","cues":{"staging":"Torren wakes first. Cyanis offers water. Nobody asks what he dreamed about."}},
{"beat_id":"C07_B003","cues":{"staging":"Cyanis notices Torren's loose bootlace and points it out with the recovered exact line. Keep it mundane rather than metaphorical."}},
{"beat_id":"C07_B004","speaker_id":"cyanis","text":"Your lace is fucked up."},
{"beat_id":"C07_B005","cues":{"staging":"Use water, retying the boot, checking a pouch, and a blanket as ordinary activity while the characters decide how much silence they want. 'Leave it' belongs to the boundary-respecting rhythm; do not force explanation afterward."}},
{"beat_id":"C07_B006","cues":{"staging":"Ilyra may keep her hands busy with pouch/work rather than interrogating either man. Care is presence plus ordinary practical attention, not therapeutic extraction."}},
{"beat_id":"C07_B007","cues":{"staging":"Cyanis eventually tries to convert restlessness into work."}},
{"beat_id":"C07_B008","speaker_id":"cyanis","text":"I just need to check the perimeter."},
{"beat_id":"C07_B009","speaker_id":"torren","text":"Sit."},
{"beat_id":"C07_B010","cues":{"staging":"Cyanis sits. Nobody congratulates him or turns it into emotional progress. Keep the blanket/water/boots/pouch in frame and let silence do the remaining work."}},
{"beat_id":"C07_B011","cues":{"staging":"End without disclosure. Intimacy does not entitle anyone to another person's pain; the scene's success is that nobody demands a story."}}]
