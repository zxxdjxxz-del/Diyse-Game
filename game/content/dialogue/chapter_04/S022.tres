[gd_resource type="Resource" script_class="DiyseDialogueSceneDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://game/dialogue/dialogue_scene_definition.gd" id="1_scene"]

[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "S022"
chapter_id = "chapter_04"
scene_kind = "mandatory"
location_id = "LOC_CRESTHAVEN"
trigger_id = "trigger.chapter_04.s022"
completion_flag = "scene.s022.complete"
participants = Array[String](["nimera","torren","cyanis","ilyra","worker","technician","vaelira","junior_researcher"])
authoring_notes = "Exact Chapter 4 Resource conversion from docs/chapters/dialogue/chapter_04/S022.md; accepted through CH4-A029. Spoken sequence is exact; staging is carried in cues where present. Maevra is not an active Chapter 4 party member unless explicitly authored. SHA-256: 46b7cf24bcc3d94751bd08ec1917a29b4638a5da60e91b57c06b2fc62f000bc4."
beats = [
{"beat_id":"S022_B001","speaker_id":"nimera","text":"Why?","cues":{"staging":"**CRESTHAVEN — ARCHIVE / WORKROOM — MORNING** Cresthaven is noisy with workers. Inside the temporary Archive, Cyanis, Ilyra, Torren, and Nimera have taken over a large table. On the table: - Hollow Watch rubbing; - surviving Wayfinder copies; - Torren's post-Warden routing sketch; - current Crown map of Southhold. Torren moves his sketch slightly left. Nimera moves it back. Torren moves it left again."}},
{"beat_id":"S022_B002","speaker_id":"torren","text":"River."},
{"beat_id":"S022_B003","speaker_id":"nimera","text":"That's not an answer."},
{"beat_id":"S022_B004","speaker_id":"torren","text":"River used to be here.","cues":{"staging":"Torren points at the Wayfinder copy."}},
{"beat_id":"S022_B005","speaker_id":"torren","text":"Now it's here.","cues":{"staging":"Then the modern map."}},
{"beat_id":"S022_B006","speaker_id":"nimera","text":"I know rivers move."},
{"beat_id":"S022_B007","speaker_id":"torren","text":"Then quit putting it back."},
{"beat_id":"S022_B008","speaker_id":"nimera","text":"I was aligning the notation.","cues":{"staging":"Nimera's portrait goes flat."}},
{"beat_id":"S022_B009","speaker_id":"torren","text":"And I'm aligning the ground."},
{"beat_id":"S022_B010","speaker_id":"cyanis","text":"I think this is going well.","cues":{"staging":"Cyanis watches."}},
{"beat_id":"S022_B011","speaker_id":"ilyra","text":"Don't encourage them."},
{"beat_id":"S022_B012","speaker_id":"torren","text":"Nobody's arguing."},
{"beat_id":"S022_B013","speaker_id":"nimera","text":"You moved my fucking map three times.","cues":{"staging":"Nimera slowly turns toward him."}},
{"beat_id":"S022_B014","speaker_id":"torren","text":"Because it was wrong three times."},
{"beat_id":"S022_B015","speaker_id":"nimera","text":"...All right.","cues":{"staging":"Nimera opens her mouth, stops, looks down at the modern river, then back at Torren."}},
{"beat_id":"S022_B016","speaker_id":"nimera","text":"Don't enjoy that.","cues":{"staging":"Torren gives the smallest nod imaginable."}},
{"beat_id":"S022_B017","speaker_id":"torren","text":"Wasn't going to."},
{"beat_id":"S022_B018","speaker_id":"","text":"","cues":{"staging":"He absolutely was."}},
{"beat_id":"S022_B019","speaker_id":"nimera","text":"We already know this fits here.","cues":{"staging":"Nimera pulls the Hollow Watch rubbing closer."}},
{"beat_id":"S022_B020","speaker_id":"nimera","text":"First map gives us this section.","cues":{"staging":"She lays it against the Wayfinder copy. The Ch1 relationship remains obvious; Hollow Watch geometry continues into the larger Wayfinder system."}},
{"beat_id":"S022_B021","speaker_id":"nimera","text":"Second gives us the wider structure.","cues":{"staging":"She taps the Wayfinder material."}},
{"beat_id":"S022_B022","speaker_id":"nimera","text":"And this asshole shows up later.","cues":{"staging":"Then Torren's."}},
{"beat_id":"S022_B023","speaker_id":"torren","text":"Good morning to you too."},
{"beat_id":"S022_B024","speaker_id":"torren","text":"Ridge is wrong.","cues":{"staging":"She shifts his sketch. A repeated geometric relationship appears but does not quite land."}},
{"beat_id":"S022_B025","speaker_id":"nimera","text":"Again?"},
{"beat_id":"S022_B026","speaker_id":"torren","text":"Ground moved."},
{"beat_id":"S022_B027","speaker_id":"nimera","text":"Ridges don't move like rivers."},
{"beat_id":"S022_B028","speaker_id":"torren","text":"Roads do."},
{"beat_id":"S022_B029","speaker_id":"torren","text":"Old road would've gone around the north side.","cues":{"staging":"Beat. Torren traces an old route."}},
{"beat_id":"S022_B030","speaker_id":"ilyra","text":"Why change it?"},
{"beat_id":"S022_B031","speaker_id":"torren","text":"Could've washed out. Bridge could've gone. Someone could've built a better one."},
{"beat_id":"S022_B032","speaker_id":"cyanis","text":"Better road?"},
{"beat_id":"S022_B033","speaker_id":"torren","text":"Different road.","cues":{"staging":"Torren looks at the modern Crown map."}},
{"beat_id":"S022_B034","speaker_id":"cyanis","text":"Coward."},
{"beat_id":"S022_B035","speaker_id":"torren","text":"Bitch."},
{"beat_id":"S022_B036","speaker_id":"ilyra","text":"Maps.","cues":{"staging":"Ilyra doesn't look up."}},
{"beat_id":"S022_B037","speaker_id":"nimera","text":"Wait.","cues":{"staging":"Nimera rotates Torren's sketch to match notation rather than north."}},
{"beat_id":"S022_B038","speaker_id":"nimera","text":"They're not giving us the same kind of information.","cues":{"staging":"She moves the Wayfinder copy, Hollow Watch rubbing, and Torren's sketch."}},
{"beat_id":"S022_B039","speaker_id":"cyanis","text":"Meaning?"},
{"beat_id":"S022_B040","speaker_id":"nimera","text":"Hollow Watch tells us where one route continued."},
{"beat_id":"S022_B041","speaker_id":"nimera","text":"This tells us how a larger set of routes relate.","cues":{"staging":"She taps Wayfinder."}},
{"beat_id":"S022_B042","speaker_id":"nimera","text":"And this—","cues":{"staging":"Then Torren's."}},
{"beat_id":"S022_B043","speaker_id":"torren","text":"What?","cues":{"staging":"She stops."}},
{"beat_id":"S022_B044","speaker_id":"nimera","text":"This repeats the relationship."},
{"beat_id":"S022_B045","speaker_id":"ilyra","text":"The route?"},
{"beat_id":"S022_B046","speaker_id":"nimera","text":"No."},
{"beat_id":"S022_B047","speaker_id":"nimera","text":"The way they describe one place relative to another.","cues":{"staging":"She points."}},
{"beat_id":"S022_B048","speaker_id":"torren","text":"Same landmarks.","cues":{"staging":"Torren studies it."}},
{"beat_id":"S022_B049","speaker_id":"nimera","text":"Not exactly."},
{"beat_id":"S022_B050","speaker_id":"nimera","text":"No, wait. Yes. Your version.","cues":{"staging":"She catches herself."}},
{"beat_id":"S022_B051","speaker_id":"nimera","text":"Same kind of relationship.","cues":{"staging":"She points at the geometry."}},
{"beat_id":"S022_B052","speaker_id":"torren","text":"Better sentence."},
{"beat_id":"S022_B053","speaker_id":"nimera","text":"Fuck you."},
{"beat_id":"S022_B054","speaker_id":"torren","text":"There she is."},
{"beat_id":"S022_B055","speaker_id":"nimera","text":"You too.","cues":{"staging":"Cyanis turns away to hide a smile."}},
{"beat_id":"S022_B056","speaker_id":"cyanis","text":"Didn't say anything."},
{"beat_id":"S022_B057","speaker_id":"nimera","text":"Your face did."},
{"beat_id":"S022_B058","speaker_id":"ilyra","text":"Ivorybridge?","cues":{"staging":"Torren adjusts for old road. Nimera adjusts for notation. This time neither undoes the other's work. The three relationships settle over the Crown map. Ilyra steps closer."}},
{"beat_id":"S022_B059","speaker_id":"torren","text":"Yeah."},
{"beat_id":"S022_B060","speaker_id":"nimera","text":"Yeah.","cues":{"staging":"Nimera checks again."}},
{"beat_id":"S022_B061","speaker_id":"cyanis","text":"How sure?"},
{"beat_id":"S022_B062","speaker_id":"torren","text":"Ground works."},
{"beat_id":"S022_B063","speaker_id":"nimera","text":"Pattern works."},
{"beat_id":"S022_B064","speaker_id":"cyanis","text":"So that's our next stop."},
{"beat_id":"S022_B065","speaker_id":"nimera","text":"Unless anybody has a better idea.","cues":{"staging":"Nimera folds her arms."}},
{"beat_id":"S022_B066","speaker_id":"torren","text":"Breakfast.","cues":{"staging":"Torren looks around."}},
{"beat_id":"S022_B067","speaker_id":"ilyra","text":"Already had it."},
{"beat_id":"S022_B068","speaker_id":"torren","text":"Nobody said.","cues":{"staging":"Torren looks betrayed."}},
{"beat_id":"S022_B069","speaker_id":"cyanis","text":"You were here."},
{"beat_id":"S022_B070","speaker_id":"torren","text":"Doing this."},
{"beat_id":"S022_B071","speaker_id":"nimera","text":"I was also doing this."},
{"beat_id":"S022_B072","speaker_id":"torren","text":"You knew?"},
{"beat_id":"S022_B073","speaker_id":"nimera","text":"I ate."},
{"beat_id":"S022_B074","speaker_id":"nimera","text":"Oh, don't be dramatic.","cues":{"staging":"Torren reevaluates the entire relationship."}},
{"beat_id":"S022_B075","speaker_id":"","text":"","cues":{"staging":"Safe control interval: save/heal/formation/records/prepare to leave. No random encounters. A heavy crash comes from the lower grounds, then shouting."}},
{"beat_id":"S022_B076","speaker_id":"worker","text":"Lower yard!","cues":{"staging":"A Crown worker runs into the court."}},
{"beat_id":"S022_B077","speaker_id":"torren","text":"Anybody hurt?"},
{"beat_id":"S022_B078","speaker_id":"worker","text":"One. Ankle, I think. Everyone else got clear."},
{"beat_id":"S022_B079","speaker_id":"ilyra","text":"Get them inside. Nobody goes back down there."},
{"beat_id":"S022_B080","speaker_id":"torren","text":"Shit.","cues":{"staging":"Another impact below. Torren reaches the overlook and stops."}},
{"beat_id":"S022_B081","speaker_id":"cyanis","text":"What?"},
{"beat_id":"S022_B082","speaker_id":"torren","text":"Briarhide.","cues":{"staging":"Torren looks at gouges and tracks."}},
{"beat_id":"S022_B083","speaker_id":"nimera","text":"We've fought a Briarhide."},
{"beat_id":"S022_B084","speaker_id":"torren","text":"Not like that one.","cues":{"staging":"Torren points at one enormous print."}},
{"beat_id":"S022_B085","speaker_id":"nimera","text":"Ah.","cues":{"staging":"A roar."}},
{"beat_id":"S022_B086","speaker_id":"torren","text":"There.","cues":{"staging":"Short authored exploration pocket. No random encounters. The player discovers an old stable/storage area cleared by Crown workers. Stacked supplies have displaced a large nesting/den area. Torren stops."}},
{"beat_id":"S022_B087","speaker_id":"ilyra","text":"It was living here."},
{"beat_id":"S022_B088","speaker_id":"torren","text":"Yeah."},
{"beat_id":"S022_B089","speaker_id":"cyanis","text":"So we moved into its house.","cues":{"staging":"Cyanis looks at the supplies and torn nesting material."}},
{"beat_id":"S022_B090","speaker_id":"torren","text":"Pretty much."},
{"beat_id":"S022_B091","speaker_id":"nimera","text":"And it came home."},
{"beat_id":"S022_B092","speaker_id":"nimera","text":"Pissed.","cues":{"staging":"Another roar."}},
{"beat_id":"S022_B093","speaker_id":"torren","text":"Very."},
{"beat_id":"S022_B094","speaker_id":"torren","text":"Back.","cues":{"staging":"The Elder Briarhide enters: established species, older, much larger, scarred, heavy hide, no corruption or Black Host/Ancient explanation."}},
{"beat_id":"S022_B095","speaker_id":"","text":"","cues":{"staging":"- One enemy, one HP bar, no transformation. - Rounds 1–3: fully normal Diyse combat; party deals very little damage because it is extremely durable. - Round 4: the only selectable action is **LAST SENTINEL**. - Player confirms it. - Exact locked Last Sentinel visual manifests. - Recovered Last Sentinel performs its one strong Prime action and dismisses the same round. - After the round resolves, Elder Briarhide retreats alive. - No midbattle dialogue interruption during Rounds 1–3."}},
{"beat_id":"S022_B096","speaker_id":"torren","text":"Gone.","cues":{"staging":"Battle UI clears. Nobody speaks for several seconds. Torren checks the perimeter."}},
{"beat_id":"S022_B097","speaker_id":"nimera","text":"I'm aware.","cues":{"staging":"Nimera still stares at the battlefield."}},
{"beat_id":"S022_B098","speaker_id":"nimera","text":"That—","cues":{"staging":"She points vaguely at where Last Sentinel stood."}},
{"beat_id":"S022_B099","speaker_id":"nimera","text":"Fuck.","cues":{"staging":"Nothing."}},
{"beat_id":"S022_B100","speaker_id":"cyanis","text":"That's your analysis?"},
{"beat_id":"S022_B101","speaker_id":"nimera","text":"Give me a fucking second."},
{"beat_id":"S022_B102","speaker_id":"ilyra","text":"Anything hurt?","cues":{"staging":"Ilyra checks Cyanis."}},
{"beat_id":"S022_B103","speaker_id":"cyanis","text":"No."},
{"beat_id":"S022_B104","speaker_id":"ilyra","text":"Dizzy?"},
{"beat_id":"S022_B105","speaker_id":"cyanis","text":"No."},
{"beat_id":"S022_B106","speaker_id":"ilyra","text":"Nauseous?"},
{"beat_id":"S022_B107","speaker_id":"cyanis","text":"No."},
{"beat_id":"S022_B108","speaker_id":"ilyra","text":"You sure?","cues":{"staging":"She studies him."}},
{"beat_id":"S022_B109","speaker_id":"cyanis","text":"Yeah."},
{"beat_id":"S022_B110","speaker_id":"ilyra","text":"All right.","cues":{"staging":"Only then:"}},
{"beat_id":"S022_B111","speaker_id":"ilyra","text":"What the hell was that?","cues":{"staging":"Beat."}},
{"beat_id":"S022_B112","speaker_id":"nimera","text":"Last Sentinel."},
{"beat_id":"S022_B113","speaker_id":"cyanis","text":"We knew that."},
{"beat_id":"S022_B114","speaker_id":"nimera","text":"We knew the name."},
{"beat_id":"S022_B115","speaker_id":"nimera","text":"That's considerably fucking different.","cues":{"staging":"She looks at him."}},
{"beat_id":"S022_B116","speaker_id":"torren","text":"Animal's still moving.","cues":{"staging":"Torren returns."}},
{"beat_id":"S022_B117","speaker_id":"nimera","text":"You checked?"},
{"beat_id":"S022_B118","speaker_id":"torren","text":"Yeah."},
{"beat_id":"S022_B119","speaker_id":"nimera","text":"Of course you did."},
{"beat_id":"S022_B120","speaker_id":"nimera","text":"Show me.","cues":{"staging":"Nimera approaches Cyanis but does not take the Card."}},
{"beat_id":"S022_B121","speaker_id":"nimera","text":"Same Card.","cues":{"staging":"Cyanis holds it up. Ruby, stable, still."}},
{"beat_id":"S022_B122","speaker_id":"cyanis","text":"Looks like."},
{"beat_id":"S022_B123","speaker_id":"ilyra","text":"Did you know what it was going to do?"},
{"beat_id":"S022_B124","speaker_id":"cyanis","text":"No.","cues":{"staging":"Cyanis thinks."}},
{"beat_id":"S022_B125","speaker_id":"cyanis","text":"I knew I wanted that thing away from us.","cues":{"staging":"Beat."}},
{"beat_id":"S022_B126","speaker_id":"torren","text":"Worked."},
{"beat_id":"S022_B127","speaker_id":"nimera","text":"That is not sufficient scientific documentation."},
{"beat_id":"S022_B128","speaker_id":"torren","text":"Still worked."},
{"beat_id":"S022_B129","speaker_id":"nimera","text":"I know it fucking worked."},
{"beat_id":"S022_B130","speaker_id":"nimera","text":"Don't.","cues":{"staging":"Cyanis almost smiles."}},
{"beat_id":"S022_B131","speaker_id":"cyanis","text":"Didn't say anything."},
{"beat_id":"S022_B132","speaker_id":"nimera","text":"Your face did."},
{"beat_id":"S022_B133","speaker_id":"ilyra","text":"So what can we actually say?"},
{"beat_id":"S022_B134","speaker_id":"nimera","text":"The Card manifests something."},
{"beat_id":"S022_B135","speaker_id":"nimera","text":"That something is Last Sentinel.","cues":{"staging":"She looks toward the empty battlefield."}},
{"beat_id":"S022_B136","speaker_id":"cyanis","text":"Probably."},
{"beat_id":"S022_B137","speaker_id":"nimera","text":"No. We have enough for that one."},
{"beat_id":"S022_B138","speaker_id":"nimera","text":"You activated it.","cues":{"staging":"Cyanis nods."}},
{"beat_id":"S022_B139","speaker_id":"ilyra","text":"It acted."},
{"beat_id":"S022_B140","speaker_id":"torren","text":"Then disappeared."},
{"beat_id":"S022_B141","speaker_id":"nimera","text":"Yes."},
{"beat_id":"S022_B142","speaker_id":"cyanis","text":"That's four."},
{"beat_id":"S022_B143","speaker_id":"nimera","text":"You little asshole.","cues":{"staging":"Nimera realizes what he's doing."}},
{"beat_id":"S022_B144","speaker_id":"cyanis","text":"There she is."},
{"beat_id":"S022_B145","speaker_id":"torren","text":"Need to tell the crews not to use this part.","cues":{"staging":"Torren surveys the den."}},
{"beat_id":"S022_B146","speaker_id":"ilyra","text":"You think it'll come back?"},
{"beat_id":"S022_B147","speaker_id":"torren","text":"Maybe."},
{"beat_id":"S022_B148","speaker_id":"nimera","text":"After that?"},
{"beat_id":"S022_B149","speaker_id":"torren","text":"It's an animal."},
{"beat_id":"S022_B150","speaker_id":"nimera","text":"An animal that just saw whatever the fuck that was."},
{"beat_id":"S022_B151","speaker_id":"torren","text":"Still an animal."},
{"beat_id":"S022_B152","speaker_id":"cyanis","text":"Move these somewhere else."},
{"beat_id":"S022_B153","speaker_id":"torren","text":"Yeah."},
{"beat_id":"S022_B154","speaker_id":"ilyra","text":"Give it another place to settle farther out."},
{"beat_id":"S022_B155","speaker_id":"torren","text":"Might help."},
{"beat_id":"S022_B156","speaker_id":"nimera","text":"We did kind of steal its house."},
{"beat_id":"S022_B157","speaker_id":"torren","text":"Yep."},
{"beat_id":"S022_B158","speaker_id":"nimera","text":"I don't like being the asshole in the animal story."},
{"beat_id":"S022_B159","speaker_id":"cyanis","text":"Builds character."},
{"beat_id":"S022_B160","speaker_id":"nimera","text":"Fuck off."},
{"beat_id":"S022_B161","speaker_id":"","text":"","cues":{"staging":"Real recovery interval. No random encounters. Depart for Ivorybridge when ready."}},
{"beat_id":"S022_B162","speaker_id":"","text":"","cues":{"staging":"Safe settlement, no random encounters. Short exploration window before mandatory dialogue."}},
{"beat_id":"S022_B163","speaker_id":"nimera","text":"Don't.","cues":{"staging":"Torren looks down at the bridge approach."}},
{"beat_id":"S022_B164","speaker_id":"torren","text":"What?"},
{"beat_id":"S022_B165","speaker_id":"nimera","text":"You're judging the road."},
{"beat_id":"S022_B166","speaker_id":"torren","text":"I'm walking on it."},
{"beat_id":"S022_B167","speaker_id":"nimera","text":"While judging it."},
{"beat_id":"S022_B168","speaker_id":"torren","text":"It's all right.","cues":{"staging":"Torren looks again."}},
{"beat_id":"S022_B169","speaker_id":"nimera","text":"What?","cues":{"staging":"Nimera stops."}},
{"beat_id":"S022_B170","speaker_id":"torren","text":"Road's all right."},
{"beat_id":"S022_B171","speaker_id":"nimera","text":"Should we be worried?","cues":{"staging":"Nimera looks at Ilyra."}},
{"beat_id":"S022_B172","speaker_id":"ilyra","text":"Ask if he's dizzy."},
{"beat_id":"S022_B173","speaker_id":"torren","text":"Fuck all three of you.","cues":{"staging":"Cyanis laughs."}},
{"beat_id":"S022_B174","speaker_id":"nimera","text":"Historical routing records?","cues":{"staging":"A municipal technician is checking a channel gauge."}},
{"beat_id":"S022_B175","speaker_id":"technician","text":"How historical?"},
{"beat_id":"S022_B176","speaker_id":"technician","text":"Oh.","cues":{"staging":"Nimera shows the Wayfinder notation."}},
{"beat_id":"S022_B177","speaker_id":"nimera","text":"Helpful oh or bad oh?"},
{"beat_id":"S022_B178","speaker_id":"technician","text":"Serren."},
{"beat_id":"S022_B179","speaker_id":"nimera","text":"Is that an answer?"},
{"beat_id":"S022_B180","speaker_id":"technician","text":"Vaelira Serren."},
{"beat_id":"S022_B181","speaker_id":"torren","text":"Helpful oh."},
{"beat_id":"S022_B182","speaker_id":"nimera","text":"Nobody asked you."},
{"beat_id":"S022_B183","speaker_id":"torren","text":"Still helpful."},
{"beat_id":"S022_B184","speaker_id":"vaelira","text":"Again.","cues":{"staging":"Vaelira is working with a junior researcher on a small elemental regulation frame."}},
{"beat_id":"S022_B185","speaker_id":"junior_researcher","text":"Same load?"},
{"beat_id":"S022_B186","speaker_id":"vaelira","text":"Same load. Delay the third input half a count."},
{"beat_id":"S022_B187","speaker_id":"vaelira","text":"Point-seven-eight.","cues":{"staging":"The frame runs."}},
{"beat_id":"S022_B188","speaker_id":"vaelira","text":"Tap it.","cues":{"staging":"It stops at point-seven-seven. Vaelira looks at the housing."}},
{"beat_id":"S022_B189","speaker_id":"vaelira","text":"Please tell me you haven't folded that.","cues":{"staging":"The junior taps it. The needle jumps to point-seven-eight. Vaelira notices the party and especially Nimera's map packet."}},
{"beat_id":"S022_B190","speaker_id":"nimera","text":"We may have a problem.","cues":{"staging":"Nimera looks at the visibly folded packet."}},
{"beat_id":"S022_B191","speaker_id":"vaelira","text":"Apparently we do.","cues":{"staging":"Vaelira closes her eyes briefly."}},
{"beat_id":"S022_B192","speaker_id":"vaelira","text":"You've already aligned these.","cues":{"staging":"At a worktable, the three maps come out."}},
{"beat_id":"S022_B193","speaker_id":"nimera","text":"Enough to get here."},
{"beat_id":"S022_B194","speaker_id":"vaelira","text":"Good."},
{"beat_id":"S022_B195","speaker_id":"vaelira","text":"What?","cues":{"staging":"Nimera pauses."}},
{"beat_id":"S022_B196","speaker_id":"nimera","text":"Nothing."},
{"beat_id":"S022_B197","speaker_id":"vaelira","text":"That wasn't nothing."},
{"beat_id":"S022_B198","speaker_id":"nimera","text":"I expected you to tell me I did it wrong."},
{"beat_id":"S022_B199","speaker_id":"vaelira","text":"Did you?"},
{"beat_id":"S022_B200","speaker_id":"nimera","text":"No."},
{"beat_id":"S022_B201","speaker_id":"vaelira","text":"Then why would I?"},
{"beat_id":"S022_B202","speaker_id":"torren","text":"I like her."},
{"beat_id":"S022_B203","speaker_id":"nimera","text":"Nobody asked you either."},
{"beat_id":"S022_B204","speaker_id":"vaelira","text":"These aren't sections of one map.","cues":{"staging":"Vaelira points at notation."}},
{"beat_id":"S022_B205","speaker_id":"nimera","text":"No."},
{"beat_id":"S022_B206","speaker_id":"vaelira","text":"Same positional grammar."},
{"beat_id":"S022_B207","speaker_id":"nimera","text":"That's better than what I was calling it."},
{"beat_id":"S022_B208","speaker_id":"vaelira","text":"What were you calling it?"},
{"beat_id":"S022_B209","speaker_id":"nimera","text":"Relationship marks."},
{"beat_id":"S022_B210","speaker_id":"vaelira","text":"That's not terrible."},
{"beat_id":"S022_B211","speaker_id":"nimera","text":"High praise."},
{"beat_id":"S022_B212","speaker_id":"vaelira","text":"Who copied this?","cues":{"staging":"Vaelira examines Torren's post-Warden sketch."}},
{"beat_id":"S022_B213","speaker_id":"vaelira","text":"From the original?","cues":{"staging":"Torren raises a hand."}},
{"beat_id":"S022_B214","speaker_id":"torren","text":"Memory."},
{"beat_id":"S022_B215","speaker_id":"vaelira","text":"You kept scale surprisingly well."},
{"beat_id":"S022_B216","speaker_id":"torren","text":"Surprisingly?"},
{"beat_id":"S022_B217","speaker_id":"vaelira","text":"I don't know you."},
{"beat_id":"S022_B218","speaker_id":"torren","text":"Fair.","cues":{"staging":"Beat."}},
{"beat_id":"S022_B219","speaker_id":"vaelira","text":"I've seen this structure before.","cues":{"staging":"Vaelira produces an Annex transcription using the same technical family."}},
{"beat_id":"S022_B220","speaker_id":"nimera","text":"Where?"},
{"beat_id":"S022_B221","speaker_id":"vaelira","text":"Sixfold Annex."},
{"beat_id":"S022_B222","speaker_id":"ilyra","text":"Which is?","cues":{"staging":"She demonstrates a reduced regulation behavior."}},
{"beat_id":"S022_B223","speaker_id":"torren","text":"Moved the load.","cues":{"staging":"Vaelira increases one channel. Others compensate."}},
{"beat_id":"S022_B224","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S022_B225","speaker_id":"nimera","text":"Didn't reduce it."},
{"beat_id":"S022_B226","speaker_id":"vaelira","text":"No."},
{"beat_id":"S022_B227","speaker_id":"nimera","text":"Just moved where the problem lands."},
{"beat_id":"S022_B228","speaker_id":"vaelira","text":"Exactly."},
{"beat_id":"S022_B229","speaker_id":"vaelira","text":"Second rises first. Fourth takes the excess. Sixth drops below baseline for three counts.","cues":{"staging":"She predicts a sequence."}},
{"beat_id":"S022_B230","speaker_id":"nimera","text":"Again.","cues":{"staging":"The test runs exactly so."}},
{"beat_id":"S022_B231","speaker_id":"nimera","text":"That's fucking beautiful.","cues":{"staging":"Again. Same result."}},
{"beat_id":"S022_B232","speaker_id":"vaelira","text":"Yes.","cues":{"staging":"Vaelira smiles."}},
{"beat_id":"S022_B233","speaker_id":"cyanis","text":"Who checks your model?","cues":{"staging":"Cyanis watches."}},
{"beat_id":"S022_B234","speaker_id":"vaelira","text":"I do."},
{"beat_id":"S022_B235","speaker_id":"vaelira","text":"Independently?","cues":{"staging":"Cyanis waits."}},
{"beat_id":"S022_B236","speaker_id":"cyanis","text":"Yeah."},
{"beat_id":"S022_B237","speaker_id":"vaelira","text":"Three Annex researchers cross-run revisions."},
{"beat_id":"S022_B238","speaker_id":"cyanis","text":"Same equipment?"},
{"beat_id":"S022_B239","speaker_id":"vaelira","text":"Mostly."},
{"beat_id":"S022_B240","speaker_id":"cyanis","text":"Same assumptions?"},
{"beat_id":"S022_B241","speaker_id":"vaelira","text":"Mostly.","cues":{"staging":"Pause."}},
{"beat_id":"S022_B242","speaker_id":"cyanis","text":"Same idea of what counts as success?"},
{"beat_id":"S022_B243","speaker_id":"vaelira","text":"Yes.","cues":{"staging":"Longer pause."}},
{"beat_id":"S022_B244","speaker_id":"cyanis","text":"Then they're checking the answer."},
{"beat_id":"S022_B245","speaker_id":"cyanis","text":"Who checks the question?","cues":{"staging":"Vaelira watches him."}},
{"beat_id":"S022_B246","speaker_id":"vaelira","text":"That's irritating.","cues":{"staging":"Silence."}},
{"beat_id":"S022_B247","speaker_id":"cyanis","text":"I've been told."},
{"beat_id":"S022_B248","speaker_id":"torren","text":"Frequently."},
{"beat_id":"S022_B249","speaker_id":"vaelira","text":"I need the primary regulator.","cues":{"staging":"Vaelira looks at the maps."}},
{"beat_id":"S022_B250","speaker_id":"nimera","text":"At the Annex."},
{"beat_id":"S022_B251","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S022_B252","speaker_id":"nimera","text":"Why?"},
{"beat_id":"S022_B253","speaker_id":"vaelira","text":"Because I've been treating this as a boundary.","cues":{"staging":"Vaelira points to one repeated mark."}},
{"beat_id":"S022_B254","speaker_id":"nimera","text":"And?"},
{"beat_id":"S022_B255","speaker_id":"vaelira","text":"Now I want to know if it is one.","cues":{"staging":"Vaelira gathers notes."}},
{"beat_id":"S022_B256","speaker_id":"vaelira","text":"I need to see the primary regulator.","cues":{"staging":"Vaelira closes her notebook."}},
{"beat_id":"S022_B257","speaker_id":"cyanis","text":"Can you take us?"},
{"beat_id":"S022_B258","speaker_id":"vaelira","text":"I'm going."},
{"beat_id":"S022_B259","speaker_id":"vaelira","text":"You can come.","cues":{"staging":"Beat."}},
{"beat_id":"S022_B260","speaker_id":"nimera","text":"That's more like it."},
{"beat_id":"S022_B261","speaker_id":"vaelira","text":"More like what?"},
{"beat_id":"S022_B262","speaker_id":"nimera","text":"Someone who doesn't hand strangers a set of directions and hope for the best."},
{"beat_id":"S022_B263","speaker_id":"vaelira","text":"That would be irresponsible."},
{"beat_id":"S022_B264","speaker_id":"torren","text":"Happens all the time."},
{"beat_id":"S022_B265","speaker_id":"vaelira","text":"To you?"},
{"beat_id":"S022_B266","speaker_id":"torren","text":"Everybody."},
{"beat_id":"S022_B267","speaker_id":"ilyra","text":"Mostly him."},
{"beat_id":"S022_B268","speaker_id":"torren","text":"That's bullshit."},
{"beat_id":"S022_B269","speaker_id":"torren","text":"...Not completely bullshit.","cues":{"staging":"Beat."}},
{"beat_id":"S022_B270","speaker_id":"nimera","text":"That's all you're taking?","cues":{"staging":"Vaelira takes staff and compact field bag."}},
{"beat_id":"S022_B271","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S022_B272","speaker_id":"nimera","text":"You own an alarming amount of equipment."},
{"beat_id":"S022_B273","speaker_id":"vaelira","text":"Most of it weighs more than I do."},
{"beat_id":"S022_B274","speaker_id":"nimera","text":"Fair.","cues":{"staging":"Nimera looks at a large instrument frame."}},
{"beat_id":"S022_B275","speaker_id":"","text":"","cues":{"staging":"Vaelira Serren joins permanently as Green Arcanist. Five permanents now exist; choose-four formation active."}},
{"beat_id":"S022_B276","speaker_id":"","text":"","cues":{"staging":"Safe preparation. Then depart for Sixfold Annex Approach."}},
{"beat_id":"S022_B277","speaker_id":"","text":"","cues":{"staging":"Connected field route; no preset encounter count."}},
{"beat_id":"S022_B278","speaker_id":"","text":"","cues":{"staging":"Maintained water channel, broad enough to explore; offsets around old maintenance structures, vegetation, broken equipment, elevation changes. Random encounters enabled."}},
{"beat_id":"S022_B279","speaker_id":"","text":"","cues":{"staging":"Older stone service path under modern road, narrower watercourse, optional reward pocket, technical markings, extra traversable distance, reconnects farther ahead."}},
{"beat_id":"S022_B280","speaker_id":"","text":"","cues":{"staging":"Encounter triggering suppressed locally."}},
{"beat_id":"S022_B281","speaker_id":"vaelira","text":"Hold."},
{"beat_id":"S022_B282","speaker_id":"torren","text":"What?"},
{"beat_id":"S022_B283","speaker_id":"vaelira","text":"Five counts."},
{"beat_id":"S022_B284","speaker_id":"nimera","text":"Until what?"},
{"beat_id":"S022_B285","speaker_id":"vaelira","text":"Discharge."},
{"beat_id":"S022_B286","speaker_id":"nimera","text":"Important second half of that sentence."},
{"beat_id":"S022_B287","speaker_id":"nimera","text":"How often?","cues":{"staging":"Vaelira counts down. Elemental arc crosses channel; cheap prepared VFX."}},
{"beat_id":"S022_B288","speaker_id":"vaelira","text":"Under this load? Every seventy-two counts."},
{"beat_id":"S022_B289","speaker_id":"torren","text":"Rain?","cues":{"staging":"Torren looks up."}},
{"beat_id":"S022_B290","speaker_id":"vaelira","text":"Changes it.","cues":{"staging":"Vaelira is slightly surprised he asked correctly."}},
{"beat_id":"S022_B291","speaker_id":"vaelira","text":"Not today.","cues":{"staging":"Torren studies the clouds."}},
{"beat_id":"S022_B292","speaker_id":"torren","text":"Good."},
{"beat_id":"S022_B293","speaker_id":"nimera","text":"Oh, wonderful.","cues":{"staging":"Nimera looks between them."}},
{"beat_id":"S022_B294","speaker_id":"nimera","text":"You're going to understand each other about extremely boring things.","cues":{"staging":"Neither reacts."}},
{"beat_id":"S022_B295","speaker_id":"torren","text":"Roads aren't boring."},
{"beat_id":"S022_B296","speaker_id":"vaelira","text":"Neither are load states."},
{"beat_id":"S022_B297","speaker_id":"","text":"","cues":{"staging":"Nimera looks at Ilyra. Ilyra is trying not to smile."}},
{"beat_id":"S022_B298","speaker_id":"","text":"","cues":{"staging":"Random encounters resume. Route opens. A damaged retaining wall produces two traversable options: - upper maintenance path: more direct; - lower spillway route: longer, more exploratory, optional pickup/environmental detail. They reconnect at inspection bridge."}},
{"beat_id":"S022_B299","speaker_id":"nimera","text":"I expected more ruin.","cues":{"staging":"The Sixfold Annex becomes visible: functioning research station grown around old regulation architecture, not a giant untouched ruin."}},
{"beat_id":"S022_B300","speaker_id":"vaelira","text":"Why?"},
{"beat_id":"S022_B301","speaker_id":"nimera","text":"Everything old we've found lately has tried to kill us."},
{"beat_id":"S022_B302","speaker_id":"cyanis","text":"She's had a difficult month."},
{"beat_id":"S022_B303","speaker_id":"nimera","text":"I've had a ridiculous month."},
{"beat_id":"S022_B304","speaker_id":"torren","text":"Still got time.","cues":{"staging":"Torren looks toward Annex."}},
{"beat_id":"S022_B305","speaker_id":"nimera","text":"I fucking hate when you do that.","cues":{"staging":"Nimera turns slowly."}},
{"beat_id":"S022_B306","speaker_id":"torren","text":"What?"},
{"beat_id":"S022_B307","speaker_id":"nimera","text":"Say something completely reasonable that sounds like a threat."},
{"beat_id":"S022_B308","speaker_id":"torren","text":"Wasn't a threat."},
{"beat_id":"S022_B309","speaker_id":"nimera","text":"See?"},
{"beat_id":"S022_B310","speaker_id":"","text":"","cues":{"staging":"Broader terraced approach around primary channels. Main terrace, old side platform, maintenance bridge reward pocket, environmental markers, free backtracking. Random encounters remain enabled until the secured research perimeter."}},
{"beat_id":"S022_B311","speaker_id":"vaelira","text":"Twelve counts.","cues":{"staging":"At the last old marker before the safe perimeter:"}},
{"beat_id":"S022_B312","speaker_id":"nimera","text":"Primary cycle?"},
{"beat_id":"S022_B313","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S022_B314","speaker_id":"torren","text":"Bigger one?","cues":{"staging":"Nimera is pleased."}},
{"beat_id":"S022_B315","speaker_id":"vaelira","text":"Much."},
{"beat_id":"S022_B316","speaker_id":"torren","text":"How many times have you watched that?","cues":{"staging":"Vaelira predicts the cycle: Third, then One, Five and Six together, Two falls, Four takes excess. It occurs exactly."}},
{"beat_id":"S022_B317","speaker_id":"vaelira","text":"This configuration?"},
{"beat_id":"S022_B318","speaker_id":"torren","text":"Yeah."},
{"beat_id":"S022_B319","speaker_id":"vaelira","text":"One hundred eighty-seven."},
{"beat_id":"S022_B320","speaker_id":"nimera","text":"You knew that immediately."},
{"beat_id":"S022_B321","speaker_id":"vaelira","text":"You asked a question with a numerical answer."},
{"beat_id":"S022_B322","speaker_id":"nimera","text":"That's fair."},
{"beat_id":"S022_B323","speaker_id":"ilyra","text":"Always the same?"},
{"beat_id":"S022_B324","speaker_id":"vaelira","text":"No."},
{"beat_id":"S022_B325","speaker_id":"vaelira","text":"Temperature changes timing. Water load changes distribution. Instrument drift changes what we record.","cues":{"staging":"Ilyra waits."}},
{"beat_id":"S022_B326","speaker_id":"nimera","text":"But under the same conditions?"},
{"beat_id":"S022_B327","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S022_B328","speaker_id":"nimera","text":"You're very fucking good at this.","cues":{"staging":"The marker settles exactly as predicted."}},
{"beat_id":"S022_B329","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S022_B330","speaker_id":"nimera","text":"You're supposed to pretend to be modest.","cues":{"staging":"Silence. Nimera freezes. Cyanis turns away. Ilyra laughs."}},
{"beat_id":"S022_B331","speaker_id":"vaelira","text":"Why?"},
{"beat_id":"S022_B332","speaker_id":"torren","text":"This'll be fun.","cues":{"staging":"Torren starts walking."}},
{"beat_id":"S022_B333","speaker_id":"nimera","text":"What?","cues":{"staging":"The primary cycle ends. Vaelira starts putting the instrument away. A faint pulse comes from farther down the old stonework, not one of the six marked channels. Vaelira stops. Another pulse."}},
{"beat_id":"S022_B334","speaker_id":"torren","text":"That part of it?","cues":{"staging":"Vaelira checks the instrument. All six measured channels are stable. Another pulse answers from beyond them."}},
{"beat_id":"S022_B335","speaker_id":"vaelira","text":"No.","cues":{"staging":"Vaelira watches the distant channel."}},
{"beat_id":"S022_B336","speaker_id":"nimera","text":"No, you're not sure?"},
{"beat_id":"S022_B337","speaker_id":"vaelira","text":"No."},
{"beat_id":"S022_B338","speaker_id":"vaelira","text":"It isn't in the loop.","cues":{"staging":"Beat."}},
{"beat_id":"S022_B339","speaker_id":"cyanis","text":"But those did exactly what you said.","cues":{"staging":"Cyanis looks at the six channels."}},
{"beat_id":"S022_B340","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S022_B341","speaker_id":"nimera","text":"Then what answered?","cues":{"staging":"Another distant pulse."}},
{"beat_id":"S022_B342","speaker_id":"vaelira","text":"I don't know.","cues":{"staging":"Vaelira does not fake certainty."}},
{"beat_id":"S022_B343","speaker_id":"vaelira","text":"Primary regulator.","cues":{"staging":"Nobody gives her shit for it. Vaelira closes the instrument."}},
{"beat_id":"S022_B344","speaker_id":"nimera","text":"Now?"},
{"beat_id":"S022_B345","speaker_id":"vaelira","text":"Now.","cues":{"staging":"Vaelira is already moving."}},
{"beat_id":"S022_B346","speaker_id":"","text":"","cues":{"staging":"**END S022 — BRILLIANT ANSWER**"}}
]
