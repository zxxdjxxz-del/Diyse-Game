[gd_resource type="Resource" script_class="DiyseDialogueSceneDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://game/dialogue/dialogue_scene_definition.gd" id="1_scene"]

[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "S023"
chapter_id = "chapter_04"
scene_kind = "mandatory"
location_id = "LOC_SIXFOLD_ANNEX"
trigger_id = "trigger.chapter_04.s023"
completion_flag = "scene.s023.complete"
participants = Array[String](["annex_researcher","vaelira","nimera","cyanis","torren","ilyra"])
authoring_notes = "Exact Chapter 4 Resource conversion from docs/chapters/dialogue/chapter_04/S023.md; accepted through CH4-A029. Spoken sequence is exact; staging is carried in cues where present. Maevra is not an active Chapter 4 party member unless explicitly authored. SHA-256: a3663f05c61459ce84c7b8f84cf7e9a13fb3b973700fbec416e8f468978d7361."
beats = [
{"beat_id":"S023_B001","speaker_id":"annex_researcher","text":"Vaelira—","cues":{"staging":"**SIXFOLD ANNEX — PRIMARY RESEARCH FLOOR** Researchers are moving equipment, shutting resistant shutters, and arguing with instruments. Vaelira heads to the main regulator."}},
{"beat_id":"S023_B002","speaker_id":"vaelira","text":"What changed?"},
{"beat_id":"S023_B003","speaker_id":"annex_researcher","text":"Nothing changed."},
{"beat_id":"S023_B004","speaker_id":"vaelira","text":"Something outside just answered the primary cycle.","cues":{"staging":"Vaelira stops."}},
{"beat_id":"S023_B005","speaker_id":"annex_researcher","text":"The six channels are stable."},
{"beat_id":"S023_B006","speaker_id":"vaelira","text":"I know."},
{"beat_id":"S023_B007","speaker_id":"nimera","text":"That's what we just saw outside.","cues":{"staging":"Six readings: Fire, Ice, Lightning, Wind, Earth, Water — all normal."}},
{"beat_id":"S023_B008","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S023_B009","speaker_id":"cyanis","text":"So those are fine."},
{"beat_id":"S023_B010","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S023_B011","speaker_id":"torren","text":"Something isn't.","cues":{"staging":"Torren looks toward sealed outer galleries."}},
{"beat_id":"S023_B012","speaker_id":"vaelira","text":"Correct."},
{"beat_id":"S023_B013","speaker_id":"annex_researcher","text":"Those aren't part of the primary set.","cues":{"staging":"Vaelira asks for raw return readings."}},
{"beat_id":"S023_B014","speaker_id":"vaelira","text":"I know."},
{"beat_id":"S023_B015","speaker_id":"vaelira","text":"That's why I want them.","cues":{"staging":"Beat."}},
{"beat_id":"S023_B016","speaker_id":"vaelira","text":"Input.","cues":{"staging":"A second instrument display appears."}},
{"beat_id":"S023_B017","speaker_id":"vaelira","text":"Distribution.","cues":{"staging":"Then distribution."}},
{"beat_id":"S023_B018","speaker_id":"vaelira","text":"Return.","cues":{"staging":"Then return."}},
{"beat_id":"S023_B019","speaker_id":"cyanis","text":"And?"},
{"beat_id":"S023_B020","speaker_id":"nimera","text":"Those don't add up.","cues":{"staging":"Nimera leans closer."}},
{"beat_id":"S023_B021","speaker_id":"vaelira","text":"No."},
{"beat_id":"S023_B022","speaker_id":"annex_researcher","text":"Instrument loss."},
{"beat_id":"S023_B023","speaker_id":"annex_researcher","text":"That's how we've been logging it.","cues":{"staging":"Vaelira looks at them."}},
{"beat_id":"S023_B024","speaker_id":"vaelira","text":"How long?"},
{"beat_id":"S023_B025","speaker_id":"annex_researcher","text":"It's always had some variance."},
{"beat_id":"S023_B026","speaker_id":"vaelira","text":"How long has it been this large?"},
{"beat_id":"S023_B027","speaker_id":"annex_researcher","text":"Twelve days.","cues":{"staging":"They check."}},
{"beat_id":"S023_B028","speaker_id":"vaelira","text":"And nobody told me?","cues":{"staging":"Vaelira goes still."}},
{"beat_id":"S023_B029","speaker_id":"annex_researcher","text":"Your model was still predicting the main cycle."},
{"beat_id":"S023_B030","speaker_id":"nimera","text":"Which it was."},
{"beat_id":"S023_B031","speaker_id":"vaelira","text":"Yes.","cues":{"staging":"No accusation, just fact."}},
{"beat_id":"S023_B032","speaker_id":"cyanis","text":"If it isn't coming back here—"},
{"beat_id":"S023_B033","speaker_id":"torren","text":"It's going somewhere."},
{"beat_id":"S023_B034","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S023_B035","speaker_id":"cyanis","text":"What's here?","cues":{"staging":"Vaelira traces her model: entry, regulation, return. Cyanis points beyond the edge."}},
{"beat_id":"S023_B036","speaker_id":"vaelira","text":"Outside the model."},
{"beat_id":"S023_B037","speaker_id":"cyanis","text":"Not outside the building."},
{"beat_id":"S023_B038","speaker_id":"vaelira","text":"No.","cues":{"staging":"Vaelira looks at him."}},
{"beat_id":"S023_B039","speaker_id":"nimera","text":"Oh, fuck."},
{"beat_id":"S023_B040","speaker_id":"ilyra","text":"What?"},
{"beat_id":"S023_B041","speaker_id":"nimera","text":"The equation stops.","cues":{"staging":"Nimera points to the edge of the paper."}},
{"beat_id":"S023_B042","speaker_id":"nimera","text":"Reality doesn't.","cues":{"staging":"Then the Annex around them."}},
{"beat_id":"S023_B043","speaker_id":"vaelira","text":"Staff?","cues":{"staging":"Torren asks what is beyond the return. Old galleries, spill channels, earlier test rooms."}},
{"beat_id":"S023_B044","speaker_id":"ilyra","text":"How many?","cues":{"staging":"Hesitation."}},
{"beat_id":"S023_B045","speaker_id":"annex_researcher","text":"Usually four or five."},
{"beat_id":"S023_B046","speaker_id":"ilyra","text":"Usually?"},
{"beat_id":"S023_B047","speaker_id":"annex_researcher","text":"There's only one down there now."},
{"beat_id":"S023_B048","speaker_id":"vaelira","text":"Who?"},
{"beat_id":"S023_B049","speaker_id":"annex_researcher","text":"Senior exposure study."},
{"beat_id":"S023_B050","speaker_id":"annex_researcher","text":"They stopped answering the relay.","cues":{"staging":"Beat."}},
{"beat_id":"S023_B051","speaker_id":"vaelira","text":"Open the lower access.","cues":{"staging":"Vaelira closes her notebook."}},
{"beat_id":"S023_B052","speaker_id":"","text":"","cues":{"staging":"Safe. Save/recover/formation/inspect regulator. Lower experimental galleries evacuated and encounter-enabled after seal; academy staff are not random enemies."}},
{"beat_id":"S023_B053","speaker_id":"","text":"","cues":{"staging":"Connected interior around central regulator shaft: calibration gallery, side observation rooms, maintenance passage, optional mirror-testing room, spillway walkway, reconnection before exposure gallery. Encounter quantity area-driven. Enemy ecology: Sixfold Nodes, Composite Elementals, Reaction Hounds, Element Mirrors, Annex Crucible Guards."}},
{"beat_id":"S023_B054","speaker_id":"ilyra","text":"Fire?","cues":{"staging":"Safe observation alcove. Torren stops beside dark wall marks."}},
{"beat_id":"S023_B055","speaker_id":"torren","text":"No soot.","cues":{"staging":"Torren touches one."}},
{"beat_id":"S023_B056","speaker_id":"vaelira","text":"Heat stress.","cues":{"staging":"Vaelira crouches."}},
{"beat_id":"S023_B057","speaker_id":"nimera","text":"From what?"},
{"beat_id":"S023_B058","speaker_id":"vaelira","text":"That's what I'm trying to find out.","cues":{"staging":"Vaelira looks toward spill channel."}},
{"beat_id":"S023_B059","speaker_id":"torren","text":"Been happening awhile.","cues":{"staging":"Torren points farther down."}},
{"beat_id":"S023_B060","speaker_id":"torren","text":"Stone doesn't do that in a morning.","cues":{"staging":"Vaelira looks at him."}},
{"beat_id":"S023_B061","speaker_id":"","text":"","cues":{"staging":"She nods."}},
{"beat_id":"S023_B062","speaker_id":"","text":"","cues":{"staging":"Environmental storytelling: instrument frozen high, Earth Node holding field, water condensed across Lightning gallery, cracked observation lens, repeated maintenance tags. Optional side room. Direct and exploratory routes reconnect at spillway control room."}},
{"beat_id":"S023_B063","speaker_id":"nimera","text":"Found it.","cues":{"staging":"Vaelira and Nimera inspect local records."}},
{"beat_id":"S023_B064","speaker_id":"nimera","text":"Every successful correction.","cues":{"staging":"Every successful correction correlates with spill gallery rising."}},
{"beat_id":"S023_B065","speaker_id":"vaelira","text":"Not every one."},
{"beat_id":"S023_B066","speaker_id":"nimera","text":"Most of them.","cues":{"staging":"Nimera traces another column."}},
{"beat_id":"S023_B067","speaker_id":"vaelira","text":"Yes.","cues":{"staging":"Vaelira checks."}},
{"beat_id":"S023_B068","speaker_id":"cyanis","text":"Your model predicted the correction."},
{"beat_id":"S023_B069","speaker_id":"vaelira","text":"Correctly."},
{"beat_id":"S023_B070","speaker_id":"cyanis","text":"And this happened anyway."},
{"beat_id":"S023_B071","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S023_B072","speaker_id":"nimera","text":"So the model is wrong."},
{"beat_id":"S023_B073","speaker_id":"vaelira","text":"No."},
{"beat_id":"S023_B074","speaker_id":"vaelira","text":"That's worse.","cues":{"staging":"Nimera looks at her."}},
{"beat_id":"S023_B075","speaker_id":"nimera","text":"Explain."},
{"beat_id":"S023_B076","speaker_id":"vaelira","text":"It is doing exactly what I told it to measure.","cues":{"staging":"Vaelira taps the six-channel diagram."}},
{"beat_id":"S023_B077","speaker_id":"vaelira","text":"This isn't inside that boundary.","cues":{"staging":"Then spillway records."}},
{"beat_id":"S023_B078","speaker_id":"cyanis","text":"So the answer was right."},
{"beat_id":"S023_B079","speaker_id":"cyanis","text":"Question was too small.","cues":{"staging":"Vaelira looks at him."}},
{"beat_id":"S023_B080","speaker_id":"vaelira","text":"Yes.","cues":{"staging":"Vaelira exhales."}},
{"beat_id":"S023_B081","speaker_id":"torren","text":"And all that extra shit went down there.","cues":{"staging":"Torren points toward exposure gallery."}},
{"beat_id":"S023_B082","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S023_B083","speaker_id":"ilyra","text":"Then we're done standing here.","cues":{"staging":"Ilyra is already at the door."}},
{"beat_id":"S023_B084","speaker_id":"","text":"","cues":{"staging":"Random encounters resume. Direct lower walkway + elevated maintenance detour optional reward. Cheap authored elemental states: steam, frost, static, dust, water."}},
{"beat_id":"S023_B085","speaker_id":"ilyra","text":"No blood.","cues":{"staging":"Safe pocket. Exposure station empty. Chair overturned. Notes everywhere."}},
{"beat_id":"S023_B086","speaker_id":"torren","text":"Tracks."},
{"beat_id":"S023_B087","speaker_id":"nimera","text":"Human?"},
{"beat_id":"S023_B088","speaker_id":"torren","text":"Started that way."},
{"beat_id":"S023_B089","speaker_id":"vaelira","text":"No.","cues":{"staging":"No jokes. Vaelira finds notes."}},
{"beat_id":"S023_B090","speaker_id":"nimera","text":"What?"},
{"beat_id":"S023_B091","speaker_id":"nimera","text":"Each reading is safe.","cues":{"staging":"Vaelira hands over the page: alternating elemental exposures, each individually below danger threshold."}},
{"beat_id":"S023_B092","speaker_id":"vaelira","text":"Individually."},
{"beat_id":"S023_B093","speaker_id":"ilyra","text":"Together?"},
{"beat_id":"S023_B094","speaker_id":"vaelira","text":"We never modeled together.","cues":{"staging":"Vaelira looks at empty chair."}},
{"beat_id":"S023_B095","speaker_id":"vaelira","text":"Move.","cues":{"staging":"A sound beyond. Vaelira goes pale."}},
{"beat_id":"S023_B096","speaker_id":"","text":"","cues":{"staging":"- Missing researcher is alive but trapped in unstable transformed state from prolonged alternating exposure. - One HP bar. - Nonlethal mandatory stabilization. - Not a monster-villain framing; this is a harmed person. - Current elemental alignment readable. - Player uses normal battle system to destabilize/control/cleanse/subdue. - No execution, no human loot, no mandatory party composition."}},
{"beat_id":"S023_B097","speaker_id":"","text":"","cues":{"staging":"Researcher collapses alive."}},
{"beat_id":"S023_B098","speaker_id":"ilyra","text":"Help me turn them.","cues":{"staging":"Ilyra moves immediately."}},
{"beat_id":"S023_B099","speaker_id":"ilyra","text":"Give me room.","cues":{"staging":"Cyanis does. Vaelira starts forward."}},
{"beat_id":"S023_B100","speaker_id":"ilyra","text":"Breathing.","cues":{"staging":"Vaelira stops instantly. Researcher coughs."}},
{"beat_id":"S023_B101","speaker_id":"vaelira","text":"Conscious?"},
{"beat_id":"S023_B102","speaker_id":"ilyra","text":"Not yet."},
{"beat_id":"S023_B103","speaker_id":"","text":"","cues":{"staging":"Medical team arrives. Ilyra gives concise handoff; protagonists do not monopolize care."}},
{"beat_id":"S023_B104","speaker_id":"vaelira","text":"I called this noise.","cues":{"staging":"Vaelira returns to the exposure record."}},
{"beat_id":"S023_B105","speaker_id":"nimera","text":"You didn't have this page."},
{"beat_id":"S023_B106","speaker_id":"vaelira","text":"I had the return variance."},
{"beat_id":"S023_B107","speaker_id":"nimera","text":"That's not the same thing."},
{"beat_id":"S023_B108","speaker_id":"vaelira","text":"No."},
{"beat_id":"S023_B109","speaker_id":"vaelira","text":"It isn't.","cues":{"staging":"Beat."}},
{"beat_id":"S023_B110","speaker_id":"cyanis","text":"What would you have done differently?"},
{"beat_id":"S023_B111","speaker_id":"vaelira","text":"Extended the boundary."},
{"beat_id":"S023_B112","speaker_id":"vaelira","text":"No.","cues":{"staging":"She stops and corrects herself."}},
{"beat_id":"S023_B113","speaker_id":"vaelira","text":"Asked why the boundary was there.","cues":{"staging":"Cyanis waits."}},
{"beat_id":"S023_B114","speaker_id":"nimera","text":"Better."},
{"beat_id":"S023_B115","speaker_id":"vaelira","text":"You grade conversations?","cues":{"staging":"Vaelira looks at her."}},
{"beat_id":"S023_B116","speaker_id":"nimera","text":"Constantly."},
{"beat_id":"S023_B117","speaker_id":"torren","text":"She does."},
{"beat_id":"S023_B118","speaker_id":"nimera","text":"Shut up."},
{"beat_id":"S023_B119","speaker_id":"vaelira","text":"This still isn't the source.","cues":{"staging":"Brief humor, then gone."}},
{"beat_id":"S023_B120","speaker_id":"ilyra","text":"Meaning?"},
{"beat_id":"S023_B121","speaker_id":"vaelira","text":"We're looking at where the cost went.","cues":{"staging":"Vaelira points downward."}},
{"beat_id":"S023_B122","speaker_id":"vaelira","text":"Not why it exists.","cues":{"staging":"Beat."}},
{"beat_id":"S023_B123","speaker_id":"nimera","text":"There.","cues":{"staging":"They watch next cycle. Six primary channels stabilize exactly as predicted, spillway climbs."}},
{"beat_id":"S023_B124","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S023_B125","speaker_id":"torren","text":"Goes lower?"},
{"beat_id":"S023_B126","speaker_id":"vaelira","text":"Regulation Core.","cues":{"staging":"Vaelira checks old plan."}},
{"beat_id":"S023_B127","speaker_id":"cyanis","text":"Can we shut it down here?"},
{"beat_id":"S023_B128","speaker_id":"vaelira","text":"We can interrupt this branch."},
{"beat_id":"S023_B129","speaker_id":"cyanis","text":"Should we?"},
{"beat_id":"S023_B130","speaker_id":"vaelira","text":"No.","cues":{"staging":"Vaelira thinks."}},
{"beat_id":"S023_B131","speaker_id":"nimera","text":"Why not?"},
{"beat_id":"S023_B132","speaker_id":"vaelira","text":"Because I don't know what takes the load if we do."},
{"beat_id":"S023_B133","speaker_id":"cyanis","text":"Then we don't guess.","cues":{"staging":"Cyanis nods."}},
{"beat_id":"S023_B134","speaker_id":"vaelira","text":"We go down."},
{"beat_id":"S023_B135","speaker_id":"torren","text":"Finally, a plan I understand.","cues":{"staging":"Torren checks bow."}},
{"beat_id":"S023_B136","speaker_id":"nimera","text":"Walk toward the dangerous thing?"},
{"beat_id":"S023_B137","speaker_id":"torren","text":"Usually works."},
{"beat_id":"S023_B138","speaker_id":"ilyra","text":"Your standards for “works” are terrible."},
{"beat_id":"S023_B139","speaker_id":"torren","text":"Still here."},
{"beat_id":"S023_B140","speaker_id":"ilyra","text":"Somehow."},
{"beat_id":"S023_B141","speaker_id":"","text":"","cues":{"staging":"Real recovery opportunity; formation/equipment/items. Backtracking allowed. Random encounters only in still-unsecured hostile sections."}},
{"beat_id":"S023_B142","speaker_id":"nimera","text":"You all right?","cues":{"staging":"At Regulation Core entrance:"}},
{"beat_id":"S023_B143","speaker_id":"vaelira","text":"No."},
{"beat_id":"S023_B144","speaker_id":"vaelira","text":"But I know what I don't know now.","cues":{"staging":"Nimera waits."}},
{"beat_id":"S023_B145","speaker_id":"nimera","text":"That's usually where it starts."},
{"beat_id":"S023_B146","speaker_id":"vaelira","text":"Usually?"},
{"beat_id":"S023_B147","speaker_id":"nimera","text":"I'm twenty-three. Don't make me sound wise."},
{"beat_id":"S023_B148","speaker_id":"cyanis","text":"Ready?","cues":{"staging":"Vaelira almost laughs."}},
{"beat_id":"S023_B149","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S023_B150","speaker_id":"cyanis","text":"Sure?"},
{"beat_id":"S023_B151","speaker_id":"vaelira","text":"Don't ruin it.","cues":{"staging":"Vaelira gives him a flat look."}},
{"beat_id":"S023_B152","speaker_id":"","text":"","cues":{"staging":"Cyanis smiles. **END S023 — COST OUTSIDE EQUATION**"}}
]
