beats = [
{"beat_id":"C08_B001","speaker_id":"vaelira","text":"What are you looking for?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B001 — STOPPING HERE","staging":"**FIELD CAMP — EVENING** A small fire burns beside the road. Nothing about the place suggests people normally camp here. The party has simply found a reasonably flat patch of ground before dark and stopped. Packs are open. Bedrolls are still bundled. Dinner is nearly finished. Torren stands at the edge of the firelight looking over the surrounding ground. Vaelira watches him for a moment."}},
{"beat_id":"C08_B002","speaker_id":"torren","text":"Problems.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B001 — STOPPING HERE"}},
{"beat_id":"C08_B003","speaker_id":"vaelira","text":"Specifically?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B001 — STOPPING HERE"}},
{"beat_id":"C08_B004","speaker_id":"torren","text":"Ground dips there.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B001 — STOPPING HERE","staging":"Torren points toward one side of the clearing."}},
{"beat_id":"C08_B005","speaker_id":"torren","text":"Too close.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B001 — STOPPING HERE","staging":"Then toward the road."}},
{"beat_id":"C08_B006","speaker_id":"torren","text":"Can't see through that.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B001 — STOPPING HERE","staging":"He looks toward a cluster of brush."}},
{"beat_id":"C08_B007","speaker_id":"vaelira","text":"So this is a bad campsite.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B001 — STOPPING HERE","staging":"Vaelira looks around again."}},
{"beat_id":"C08_B008","speaker_id":"torren","text":"No.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B001 — STOPPING HERE"}},
{"beat_id":"C08_B009","speaker_id":"torren","text":"It's a campsite.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B001 — STOPPING HERE","staging":"Beat."}},
{"beat_id":"C08_B010","speaker_id":"torren","text":"They all have something wrong with them.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B001 — STOPPING HERE","staging":"Vaelira waits."}},
{"beat_id":"C08_B011","speaker_id":"nimera","text":"That's reassuring.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B001 — STOPPING HERE","staging":"Nimera, eating:"}},
{"beat_id":"C08_B012","speaker_id":"torren","text":"You want reassuring, sleep indoors.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B001 — STOPPING HERE"}},
{"beat_id":"C08_B013","speaker_id":"nimera","text":"I frequently do.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B001 — STOPPING HERE"}},
{"beat_id":"C08_B014","speaker_id":"vaelira","text":"Who decided who was doing that?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B002 — NO ONE ASSIGNED ANYTHING","staging":"Vaelira finishes eating. Cyanis reaches for the cooking pot. Ilyra is already gathering bowls. Nimera starts clearing a place for her bedroll. Torren comes back toward the fire. Vaelira looks between them."}},
{"beat_id":"C08_B015","speaker_id":"cyanis","text":"Doing what?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B002 — NO ONE ASSIGNED ANYTHING","staging":"Cyanis looks down at the pot in his hands."}},
{"beat_id":"C08_B016","speaker_id":"vaelira","text":"Any of it.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B002 — NO ONE ASSIGNED ANYTHING"}},
{"beat_id":"C08_B017","speaker_id":"vaelira","text":"You took the bowls.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B002 — NO ONE ASSIGNED ANYTHING","staging":"Ilyra looks at her."}},
{"beat_id":"C08_B018","speaker_id":"vaelira","text":"He took the pot.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B002 — NO ONE ASSIGNED ANYTHING","staging":"She points at Cyanis."}},
{"beat_id":"C08_B019","speaker_id":"vaelira","text":"She's—","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B002 — NO ONE ASSIGNED ANYTHING","staging":"Then Nimera."}},
{"beat_id":"C08_B020","speaker_id":"nimera","text":"Improving property values.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B002 — NO ONE ASSIGNED ANYTHING","staging":"Nimera is kicking a stone away from where she intends to sleep."}},
{"beat_id":"C08_B021","speaker_id":"vaelira","text":"Nobody assigned anything.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B002 — NO ONE ASSIGNED ANYTHING","staging":"Vaelira ignores that."}},
{"beat_id":"C08_B022","speaker_id":"ilyra","text":"No.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B002 — NO ONE ASSIGNED ANYTHING"}},
{"beat_id":"C08_B023","speaker_id":"vaelira","text":"Then how do you know who's doing what?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B002 — NO ONE ASSIGNED ANYTHING"}},
{"beat_id":"C08_B024","speaker_id":"ilyra","text":"Something needs doing.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B002 — NO ONE ASSIGNED ANYTHING","staging":"Ilyra shrugs."}},
{"beat_id":"C08_B025","speaker_id":"cyanis","text":"Someone does it.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B002 — NO ONE ASSIGNED ANYTHING","staging":"Cyanis:"}},
{"beat_id":"C08_B026","speaker_id":"vaelira","text":"That's your system?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B002 — NO ONE ASSIGNED ANYTHING","staging":"Vaelira looks at Torren."}},
{"beat_id":"C08_B027","speaker_id":"torren","text":"More or less.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B002 — NO ONE ASSIGNED ANYTHING"}},
{"beat_id":"C08_B028","speaker_id":"vaelira","text":"That's barely a system.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B002 — NO ONE ASSIGNED ANYTHING"}},
{"beat_id":"C08_B029","speaker_id":"nimera","text":"You've been here one dinner and already understand us.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B002 — NO ONE ASSIGNED ANYTHING"}},
{"beat_id":"C08_B030","speaker_id":"vaelira","text":"Is there somewhere I shouldn't put this?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B003 — WHERE DO I SLEEP?","staging":"Vaelira picks up her bedroll. She looks at the unfamiliar ground."}},
{"beat_id":"C08_B031","speaker_id":"torren","text":"Here should be fine.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B003 — WHERE DO I SLEEP?","staging":"Torren turns and actually looks. He walks a few steps. Presses one boot into the ground. Looks toward the fire. Then toward the road."}},
{"beat_id":"C08_B032","speaker_id":"vaelira","text":"Why?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B003 — WHERE DO I SLEEP?","staging":"Vaelira looks at the spot."}},
{"beat_id":"C08_B033","speaker_id":"torren","text":"Level enough.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B003 — WHERE DO I SLEEP?"}},
{"beat_id":"C08_B034","speaker_id":"torren","text":"You're not downhill from the fire.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B003 — WHERE DO I SLEEP?","staging":"He points."}},
{"beat_id":"C08_B035","speaker_id":"torren","text":"Not blocking anybody getting out.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B003 — WHERE DO I SLEEP?","staging":"Another point."}},
{"beat_id":"C08_B036","speaker_id":"vaelira","text":"That's it?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B003 — WHERE DO I SLEEP?","staging":"Vaelira studies the ground."}},
{"beat_id":"C08_B037","speaker_id":"torren","text":"For now.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B003 — WHERE DO I SLEEP?"}},
{"beat_id":"C08_B038","speaker_id":"vaelira","text":"For now?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B003 — WHERE DO I SLEEP?"}},
{"beat_id":"C08_B039","speaker_id":"torren","text":"Might find out something sucks about it later.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B003 — WHERE DO I SLEEP?"}},
{"beat_id":"C08_B040","speaker_id":"torren","text":"Then you move.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B003 — WHERE DO I SLEEP?","staging":"Vaelira stares."}},
{"beat_id":"C08_B041","speaker_id":"nimera","text":"Science.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B003 — WHERE DO I SLEEP?","staging":"Nimera:"}},
{"beat_id":"C08_B042","speaker_id":"nimera","text":"Field testing.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B003 — WHERE DO I SLEEP?","staging":"Vaelira looks at her."}},
{"beat_id":"C08_B043","speaker_id":"vaelira","text":"I hate you a little.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B003 — WHERE DO I SLEEP?"}},
{"beat_id":"C08_B044","speaker_id":"nimera","text":"That's fast.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B003 — WHERE DO I SLEEP?"}},
{"beat_id":"C08_B045","speaker_id":"vaelira","text":"What's the watch rotation?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH","staging":"Vaelira lays out her bedroll."}},
{"beat_id":"C08_B046","speaker_id":"torren","text":"Haven't decided yet.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH","staging":"Torren sits near his pack."}},
{"beat_id":"C08_B047","speaker_id":"vaelira","text":"We stopped here without deciding who's keeping watch?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH"}},
{"beat_id":"C08_B048","speaker_id":"torren","text":"We stopped here about forty minutes ago.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH"}},
{"beat_id":"C08_B049","speaker_id":"vaelira","text":"Exactly.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH"}},
{"beat_id":"C08_B050","speaker_id":"torren","text":"Had other things to do.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH"}},
{"beat_id":"C08_B051","speaker_id":"vaelira","text":"Like dinner.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH","staging":"Vaelira looks toward the darkness."}},
{"beat_id":"C08_B052","speaker_id":"torren","text":"Yeah.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH"}},
{"beat_id":"C08_B053","speaker_id":"vaelira","text":"Dinner outranked perimeter security.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH"}},
{"beat_id":"C08_B054","speaker_id":"torren","text":"Hungry people make stupid mistakes.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH"}},
{"beat_id":"C08_B055","speaker_id":"nimera","text":"Finally, doctrine I support.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH","staging":"Nimera points her spoon at him."}},
{"beat_id":"C08_B056","speaker_id":"torren","text":"I'll take first.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH","staging":"Torren looks around the camp."}},
{"beat_id":"C08_B057","speaker_id":"ilyra","text":"I can take second.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH"}},
{"beat_id":"C08_B058","speaker_id":"cyanis","text":"Wake me after.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH","staging":"Torren nods. Cyanis:"}},
{"beat_id":"C08_B059","speaker_id":"nimera","text":"And I'll take the comfortable one where everyone's already proven we aren't being murdered.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH"}},
{"beat_id":"C08_B060","speaker_id":"cyanis","text":"Brave.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH"}},
{"beat_id":"C08_B061","speaker_id":"nimera","text":"Strategic.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH"}},
{"beat_id":"C08_B062","speaker_id":"vaelira","text":"You just made that up.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH","staging":"Vaelira looks between them."}},
{"beat_id":"C08_B063","speaker_id":"torren","text":"Yeah.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH"}},
{"beat_id":"C08_B064","speaker_id":"vaelira","text":"Right now.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH"}},
{"beat_id":"C08_B065","speaker_id":"torren","text":"That's usually when we need it.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B004 — WATCH"}},
{"beat_id":"C08_B066","speaker_id":"","text":"","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["SOURCE_STAGING"],"source_section":"C08_B005 — AFTER DINNER","staging":"The meal is finished. Conversation loses whatever shape it had. Nobody announces that dinner is over. It simply is. Ilyra finishes putting the cookware aside. Cyanis settles against his pack. Nimera is fighting with one boot. Torren crouches beside the fire. He takes a short charred twig from the edge of the coals. One end glows orange. He uses the ember to light a blunt, draws until it catches, then drops the twig back into the fire. No one comments. Torren moves a little farther from the others, settles where he can see the road and surrounding dark, and smokes quietly. Vaelira notices. Not because it is important. Because nearly everything is new to her right now. She looks away."}},
{"beat_id":"C08_B067","speaker_id":"vaelira","text":"What happens now?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B006 — NOTHING","staging":"Vaelira takes out her notebook. Nimera finally gets her boot off. Silence settles for a while. Fire. Night insects. Occasional movement of gear. Vaelira looks around."}},
{"beat_id":"C08_B068","speaker_id":"nimera","text":"What do you mean?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B006 — NOTHING","staging":"Nimera looks at her."}},
{"beat_id":"C08_B069","speaker_id":"vaelira","text":"After dinner.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B006 — NOTHING"}},
{"beat_id":"C08_B070","speaker_id":"nimera","text":"This.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B006 — NOTHING"}},
{"beat_id":"C08_B071","speaker_id":"vaelira","text":"What is “this”?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B006 — NOTHING"}},
{"beat_id":"C08_B072","speaker_id":"nimera","text":"Nothing.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B006 — NOTHING","staging":"Nimera looks around."}},
{"beat_id":"C08_B073","speaker_id":"vaelira","text":"Nothing?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B006 — NOTHING"}},
{"beat_id":"C08_B074","speaker_id":"nimera","text":"Yeah.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B006 — NOTHING"}},
{"beat_id":"C08_B075","speaker_id":"vaelira","text":"You deliberately schedule nothing?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B006 — NOTHING"}},
{"beat_id":"C08_B076","speaker_id":"nimera","text":"We don't schedule it.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B006 — NOTHING"}},
{"beat_id":"C08_B077","speaker_id":"vaelira","text":"Then how do you know when you're doing it?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B006 — NOTHING"}},
{"beat_id":"C08_B078","speaker_id":"nimera","text":"Vaelira.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B006 — NOTHING","staging":"Nimera stares at her."}},
{"beat_id":"C08_B079","speaker_id":"nimera","text":"We're doing it right now.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B006 — NOTHING","staging":"Beat."}},
{"beat_id":"C08_B080","speaker_id":"vaelira","text":"This feels inefficient.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B006 — NOTHING","staging":"Vaelira looks down at her open notebook. Then around the camp. Cyanis has his eyes closed. Ilyra is quietly fixing a loose strap. Torren is watching the unfamiliar road. Nobody is waiting for instructions. Nobody is discussing tomorrow yet. Vaelira slowly closes the notebook."}},
{"beat_id":"C08_B081","speaker_id":"cyanis","text":"Give it a chance.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B006 — NOTHING","staging":"Cyanis, without opening his eyes:"}},
{"beat_id":"C08_B082","speaker_id":"nimera","text":"Problem?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"C08_B007 — LEARNING THE IMPORTANT RULES","staging":"Vaelira lies down. A root presses immediately into her back. She sits back up. Nimera looks over."}},
