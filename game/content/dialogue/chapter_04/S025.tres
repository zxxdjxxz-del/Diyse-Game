[gd_resource type="Resource" script_class="DiyseDialogueSceneDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://game/dialogue/dialogue_scene_definition.gd" id="1_scene"]

[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "S025"
chapter_id = "chapter_04"
scene_kind = "mandatory"
location_id = "LOC_SIXFOLD_ANNEX"
trigger_id = "trigger.chapter_04.s025"
completion_flag = "scene.s025.complete"
participants = Array[String](["ilyra","medic","vaelira","senior_researcher","researcher","annex_director","nimera","cyanis","researcher_2","torren"])
authoring_notes = "Exact Chapter 4 Resource conversion from docs/chapters/dialogue/chapter_04/S025.md; accepted through CH4-A029. Spoken sequence is exact; staging is carried in cues where present. Maevra is not an active Chapter 4 party member unless explicitly authored. SHA-256: bc0db9f0b542e25107f7d988126ba7fff70ee7d9754c0872a8dbba7d527efd76."
beats = [
{"beat_id":"S025_B001","speaker_id":"ilyra","text":"Exposure researcher?","cues":{"staging":"**REGULATION CORE — AFTERMATH** Player can finish exploring/recover before heading back. Annex medical/technical crews appear farther up. Ilyra stops a medic."}},
{"beat_id":"S025_B002","speaker_id":"medic","text":"Stable."},
{"beat_id":"S025_B003","speaker_id":"ilyra","text":"Awake?"},
{"beat_id":"S025_B004","speaker_id":"medic","text":"Briefly."},
{"beat_id":"S025_B005","speaker_id":"vaelira","text":"Did they—","cues":{"staging":"Vaelira turns."}},
{"beat_id":"S025_B006","speaker_id":"vaelira","text":"Any lasting damage?","cues":{"staging":"Stops."}},
{"beat_id":"S025_B007","speaker_id":"medic","text":"Too early."},
{"beat_id":"S025_B008","speaker_id":"vaelira","text":"Thank you.","cues":{"staging":"Vaelira nods."}},
{"beat_id":"S025_B009","speaker_id":"","text":"","cues":{"staging":"Nimera looks at Vaelira and says nothing."}},
{"beat_id":"S025_B010","speaker_id":"","text":"","cues":{"staging":"Safe main floor. Warning placards, closed lower access, workers moving instruments, old readings being argued over. Trigger meeting at main regulator room."}},
{"beat_id":"S025_B011","speaker_id":"senior_researcher","text":"We heard what happened.","cues":{"staging":"Senior Annex staff around main table. Vaelira enters; conversation stops."}},
{"beat_id":"S025_B012","speaker_id":"vaelira","text":"Which part?"},
{"beat_id":"S025_B013","speaker_id":"senior_researcher","text":"The Crucible."},
{"beat_id":"S025_B014","speaker_id":"vaelira","text":"Then you haven't heard enough.","cues":{"staging":"Vaelira puts return records on table."}},
{"beat_id":"S025_B015","speaker_id":"vaelira","text":"The six-channel predictions were correct."},
{"beat_id":"S025_B016","speaker_id":"researcher","text":"We know."},
{"beat_id":"S025_B017","speaker_id":"vaelira","text":"That's the problem."},
{"beat_id":"S025_B018","speaker_id":"vaelira","text":"We defined success as stability inside these six channels.","cues":{"staging":"She points to outer-return figures."}},
{"beat_id":"S025_B019","speaker_id":"vaelira","text":"We treated everything outside them as secondary variance.","cues":{"staging":"Then spill readings."}},
{"beat_id":"S025_B020","speaker_id":"senior_researcher","text":"Your model defined the boundary."},
{"beat_id":"S025_B021","speaker_id":"vaelira","text":"Yes.","cues":{"staging":"Vaelira looks at them."}},
{"beat_id":"S025_B022","speaker_id":"vaelira","text":"I chose that boundary."},
{"beat_id":"S025_B023","speaker_id":"vaelira","text":"That part is mine.","cues":{"staging":"Beat."}},
{"beat_id":"S025_B024","speaker_id":"vaelira","text":"This isn't.","cues":{"staging":"Then another log."}},
{"beat_id":"S025_B025","speaker_id":"vaelira","text":"Return variance exceeded normal drift twelve days ago."},
{"beat_id":"S025_B026","speaker_id":"researcher","text":"It was logged."},
{"beat_id":"S025_B027","speaker_id":"vaelira","text":"As noise."},
{"beat_id":"S025_B028","speaker_id":"researcher","text":"Because the primary cycle stayed predictive."},
{"beat_id":"S025_B029","speaker_id":"vaelira","text":"I know why you did it."},
{"beat_id":"S025_B030","speaker_id":"vaelira","text":"You still did it.","cues":{"staging":"Beat."}},
{"beat_id":"S025_B031","speaker_id":"researcher","text":"Then what are you saying?"},
{"beat_id":"S025_B032","speaker_id":"vaelira","text":"That the model boundary was wrong."},
{"beat_id":"S025_B033","speaker_id":"vaelira","text":"Mine.","cues":{"staging":"She points at herself."}},
{"beat_id":"S025_B034","speaker_id":"vaelira","text":"That abnormal returns were repeatedly accepted because the six primary readings looked good.","cues":{"staging":"Then records."}},
{"beat_id":"S025_B035","speaker_id":"vaelira","text":"Ours.","cues":{"staging":"Points toward staff."}},
{"beat_id":"S025_B036","speaker_id":"vaelira","text":"That exposure thresholds were evaluated one element at a time when the researcher was receiving alternating exposure.","cues":{"staging":"Then sealed lower level."}},
{"beat_id":"S025_B037","speaker_id":"vaelira","text":"Also ours.","cues":{"staging":"Ilyra hardens."}},
{"beat_id":"S025_B038","speaker_id":"senior_researcher","text":"You're spreading responsibility."},
{"beat_id":"S025_B039","speaker_id":"vaelira","text":"No.","cues":{"staging":"Vaelira narrows her eyes."}},
{"beat_id":"S025_B040","speaker_id":"vaelira","text":"I'm locating it.","cues":{"staging":"Beat."}},
{"beat_id":"S025_B041","speaker_id":"vaelira","text":"If you call this my failure and remove me, you'll feel decisive.","cues":{"staging":"Nimera likes that sentence."}},
{"beat_id":"S025_B042","speaker_id":"vaelira","text":"And every procedure that let it happen will still be sitting here tomorrow.","cues":{"staging":"She taps records."}},
{"beat_id":"S025_B043","speaker_id":"","text":"","cues":{"staging":"Cyanis says nothing."}},
{"beat_id":"S025_B044","speaker_id":"annex_director","text":"I approved the exposure protocol."},
{"beat_id":"S025_B045","speaker_id":"annex_director","text":"And your boundary definition.","cues":{"staging":"Vaelira looks at them."}},
{"beat_id":"S025_B046","speaker_id":"researcher","text":"Director—"},
{"beat_id":"S025_B047","speaker_id":"annex_director","text":"No."},
{"beat_id":"S025_B048","speaker_id":"annex_director","text":"You designed it."},
{"beat_id":"S025_B049","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S025_B050","speaker_id":"annex_director","text":"I authorized it."},
{"beat_id":"S025_B051","speaker_id":"annex_director","text":"We all kept using it because it kept giving us correct answers.","cues":{"staging":"Vaelira nods."}},
{"beat_id":"S025_B052","speaker_id":"nimera","text":"Correct answers to one question."},
{"beat_id":"S025_B053","speaker_id":"nimera","text":"Sorry.","cues":{"staging":"Everyone looks at her."}},
{"beat_id":"S025_B054","speaker_id":"nimera","text":"Actually, no. That's the whole fucking problem.","cues":{"staging":"Beat."}},
{"beat_id":"S025_B055","speaker_id":"vaelira","text":"It is."},
{"beat_id":"S025_B056","speaker_id":"annex_director","text":"Then we change the question.","cues":{"staging":"Director looks at model."}},
{"beat_id":"S025_B057","speaker_id":"vaelira","text":"Exposure work stops.","cues":{"staging":"Concrete decisions, not vague “do better.”"}},
{"beat_id":"S025_B058","speaker_id":"annex_director","text":"Agreed."},
{"beat_id":"S025_B059","speaker_id":"vaelira","text":"All six-element alternating exposure."},
{"beat_id":"S025_B060","speaker_id":"ilyra","text":"All exposure involving more than one channel until you've checked interaction."},
{"beat_id":"S025_B061","speaker_id":"vaelira","text":"Better.","cues":{"staging":"Vaelira considers."}},
{"beat_id":"S025_B062","speaker_id":"vaelira","text":"Lower spill galleries stay closed except medical and stabilization crews.","cues":{"staging":"She writes it."}},
{"beat_id":"S025_B063","speaker_id":"annex_director","text":"Yes."},
{"beat_id":"S025_B064","speaker_id":"vaelira","text":"Return variance gets promoted to a primary measurement."},
{"beat_id":"S025_B065","speaker_id":"researcher","text":"That changes every baseline."},
{"beat_id":"S025_B066","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S025_B067","speaker_id":"researcher","text":"Weeks of work."},
{"beat_id":"S025_B068","speaker_id":"vaelira","text":"Yes.","cues":{"staging":"Vaelira looks at them."}},
{"beat_id":"S025_B069","speaker_id":"researcher","text":"Fine.","cues":{"staging":"Researcher exhales."}},
{"beat_id":"S025_B070","speaker_id":"vaelira","text":"No model gets independently checked only by people using the same boundary assumptions.","cues":{"staging":"Vaelira writes again."}},
{"beat_id":"S025_B071","speaker_id":"vaelira","text":"Don't.","cues":{"staging":"Cyanis looks at her."}},
{"beat_id":"S025_B072","speaker_id":"cyanis","text":"Didn't say anything."},
{"beat_id":"S025_B073","speaker_id":"vaelira","text":"Your face did."},
{"beat_id":"S025_B074","speaker_id":"","text":"","cues":{"staging":"Torren turns away to hide grin. Nimera sees him."}},
{"beat_id":"S025_B075","speaker_id":"annex_director","text":"I'll file the provisional report tonight."},
{"beat_id":"S025_B076","speaker_id":"vaelira","text":"Put my name on the model failure."},
{"beat_id":"S025_B077","speaker_id":"vaelira","text":"Boundary failure.","cues":{"staging":"Director looks."}},
{"beat_id":"S025_B078","speaker_id":"vaelira","text":"Not model failure.","cues":{"staging":"She corrects herself."}},
{"beat_id":"S025_B079","speaker_id":"nimera","text":"Better.","cues":{"staging":"Nimera quietly:"}},
{"beat_id":"S025_B080","speaker_id":"vaelira","text":"Put my name on it.","cues":{"staging":"Vaelira ignores her."}},
{"beat_id":"S025_B081","speaker_id":"annex_director","text":"I will."},
{"beat_id":"S025_B082","speaker_id":"annex_director","text":"Mine goes on protocol approval.","cues":{"staging":"Beat."}},
{"beat_id":"S025_B083","speaker_id":"vaelira","text":"Good."},
{"beat_id":"S025_B084","speaker_id":"researcher","text":"I classified the return drift."},
{"beat_id":"S025_B085","speaker_id":"researcher","text":"Put mine there.","cues":{"staging":"They continue."}},
{"beat_id":"S025_B086","speaker_id":"researcher_2","text":"I signed the last exposure schedule."},
{"beat_id":"S025_B087","speaker_id":"torren","text":"Better than yelling.","cues":{"staging":"People identify decisions rather than perform ritual confession. Torren, low to Cyanis:"}},
{"beat_id":"S025_B088","speaker_id":"cyanis","text":"Usually."},
{"beat_id":"S025_B089","speaker_id":"torren","text":"Less satisfying."},
{"beat_id":"S025_B090","speaker_id":"torren","text":"Didn't say worse.","cues":{"staging":"Cyanis glances."}},
{"beat_id":"S025_B091","speaker_id":"ilyra","text":"One more thing."},
{"beat_id":"S025_B092","speaker_id":"ilyra","text":"The person downstairs does not become evidence.","cues":{"staging":"Table turns."}},
{"beat_id":"S025_B093","speaker_id":"annex_director","text":"Meaning?"},
{"beat_id":"S025_B094","speaker_id":"ilyra","text":"Meaning they're injured."},
{"beat_id":"S025_B095","speaker_id":"ilyra","text":"Their recovery comes before your report, your interviews, and everybody's need to understand exactly what happened.","cues":{"staging":"Beat."}},
{"beat_id":"S025_B096","speaker_id":"vaelira","text":"Yes.","cues":{"staging":"Vaelira nods immediately."}},
{"beat_id":"S025_B097","speaker_id":"ilyra","text":"When they're ready to talk, they decide how much."},
{"beat_id":"S025_B098","speaker_id":"annex_director","text":"Agreed."},
{"beat_id":"S025_B099","speaker_id":"","text":"","cues":{"staging":"Vaelira closes exposure schedule."}},
{"beat_id":"S025_B100","speaker_id":"","text":"","cues":{"staging":"Safe. Exposure wing closed, return measurements added to primary board, staff collecting records, medical wing active. Optional NPCs, no mandatory “everyone tells Vaelira the lesson.”"}},
{"beat_id":"S025_B101","speaker_id":"nimera","text":"Keeping it?","cues":{"staging":"Vaelira takes six-channel diagram down. Nimera joins."}},
{"beat_id":"S025_B102","speaker_id":"vaelira","text":"Obviously."},
{"beat_id":"S025_B103","speaker_id":"nimera","text":"Good."},
{"beat_id":"S025_B104","speaker_id":"nimera","text":"What's that?","cues":{"staging":"Vaelira draws a larger boundary around six-channel system but leaves one side open."}},
{"beat_id":"S025_B105","speaker_id":"vaelira","text":"I don't know yet."},
{"beat_id":"S025_B106","speaker_id":"nimera","text":"That's becoming a habit."},
{"beat_id":"S025_B107","speaker_id":"vaelira","text":"You say that like it's bad."},
{"beat_id":"S025_B108","speaker_id":"nimera","text":"I'm starting to think it isn't."},
{"beat_id":"S025_B109","speaker_id":"vaelira","text":"Don't get sentimental.","cues":{"staging":"Vaelira looks back at drawing."}},
{"beat_id":"S025_B110","speaker_id":"nimera","text":"Oh, fuck off."},
{"beat_id":"S025_B111","speaker_id":"","text":"","cues":{"staging":"Vaelira smiles."}},
{"beat_id":"S025_B112","speaker_id":"vaelira","text":"You were quiet.","cues":{"staging":"Cyanis waits near door."}},
{"beat_id":"S025_B113","speaker_id":"cyanis","text":"Wasn't my meeting."},
{"beat_id":"S025_B114","speaker_id":"vaelira","text":"You had opinions."},
{"beat_id":"S025_B115","speaker_id":"cyanis","text":"Still do."},
{"beat_id":"S025_B116","speaker_id":"vaelira","text":"And?"},
{"beat_id":"S025_B117","speaker_id":"cyanis","text":"You said what was yours."},
{"beat_id":"S025_B118","speaker_id":"cyanis","text":"You didn't take what wasn't.","cues":{"staging":"Vaelira waits."}},
{"beat_id":"S025_B119","speaker_id":"cyanis","text":"Seems right.","cues":{"staging":"Beat."}},
{"beat_id":"S025_B120","speaker_id":"vaelira","text":"That's it?"},
{"beat_id":"S025_B121","speaker_id":"cyanis","text":"Want a speech?"},
{"beat_id":"S025_B122","speaker_id":"vaelira","text":"Absolutely not."},
{"beat_id":"S025_B123","speaker_id":"cyanis","text":"Good."},
{"beat_id":"S025_B124","speaker_id":"vaelira","text":"I was wrong.","cues":{"staging":"They start toward exit."}},
{"beat_id":"S025_B125","speaker_id":"cyanis","text":"About the boundary."},
{"beat_id":"S025_B126","speaker_id":"cyanis","text":"Be specific.","cues":{"staging":"Vaelira looks at him."}},
{"beat_id":"S025_B127","speaker_id":"vaelira","text":"You're irritating.","cues":{"staging":"Vaelira almost smiles."}},
{"beat_id":"S025_B128","speaker_id":"cyanis","text":"I've been told."},
{"beat_id":"S025_B129","speaker_id":"ilyra","text":"Coming?","cues":{"staging":"Party exits Annex. Approach remains ordinary exploration with area-driven encounters. Ivorybridge is safe on arrival. Vaelira stops on bridge and looks back toward Annex."}},
{"beat_id":"S025_B130","speaker_id":"vaelira","text":"Yeah."},
{"beat_id":"S025_B131","speaker_id":"","text":"","cues":{"staging":"She turns away and goes with them. **END S025 — RESPONSIBILITY WITHOUT HUMILIATION**"}}
]
