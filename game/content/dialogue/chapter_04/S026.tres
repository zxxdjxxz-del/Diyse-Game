[gd_resource type="Resource" script_class="DiyseDialogueSceneDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://game/dialogue/dialogue_scene_definition.gd" id="1_scene"]

[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "S026"
chapter_id = "chapter_04"
scene_kind = "mandatory"
location_id = "LOC_IVORYBRIDGE"
trigger_id = "trigger.chapter_04.s026"
completion_flag = "scene.s026.complete"
participants = Array[String](["junior_researcher","vaelira","nimera","torren","cyanis","ilyra"])
authoring_notes = "Exact Chapter 4 Resource conversion from docs/chapters/dialogue/chapter_04/S026.md; accepted through CH4-A029. Spoken sequence is exact; staging is carried in cues where present. Maevra is not an active Chapter 4 party member unless explicitly authored. SHA-256: 65180d98b2980f3d4862b04e347adf7bd2fa4b8a65ba16850f64d57dbd0d11ca."
beats = [
{"beat_id":"S026_B001","speaker_id":"","text":"","cues":{"staging":"**IVORYBRIDGE — MORNING** Party stayed overnight because it was late and they had fought through the Annex; no forced emotional-processing framing."}},
{"beat_id":"S026_B002","speaker_id":"","text":"","cues":{"staging":"Safe settlement. No random encounters. Shops/recovery/save/equipment/formation available. Vaelira near municipal research board. Objective: Speak with Vaelira when ready."}},
{"beat_id":"S026_B003","speaker_id":"junior_researcher","text":"I changed the third return table.","cues":{"staging":"Vaelira stands before a public technical board. Yesterday's six-channel model is still posted, with new sheets around it: - RETURN VARIANCE - MULTI-CHANNEL EXPOSURE - BOUNDARY ASSUMPTIONS - SEVENTH REACTION — PROVISIONAL A junior researcher pins up a correction."}},
{"beat_id":"S026_B004","speaker_id":"vaelira","text":"Why?"},
{"beat_id":"S026_B005","speaker_id":"junior_researcher","text":"The baseline was wrong."},
{"beat_id":"S026_B006","speaker_id":"vaelira","text":"Yes.","cues":{"staging":"Vaelira reads it."}},
{"beat_id":"S026_B007","speaker_id":"vaelira","text":"This is better.","cues":{"staging":"Beat."}},
{"beat_id":"S026_B008","speaker_id":"junior_researcher","text":"That's it?"},
{"beat_id":"S026_B009","speaker_id":"vaelira","text":"Did you want punishment?"},
{"beat_id":"S026_B010","speaker_id":"junior_researcher","text":"No."},
{"beat_id":"S026_B011","speaker_id":"vaelira","text":"Good."},
{"beat_id":"S026_B012","speaker_id":"vaelira","text":"Next time, write why you changed the baseline.","cues":{"staging":"She points at board."}},
{"beat_id":"S026_B013","speaker_id":"junior_researcher","text":"I thought that part was obvious."},
{"beat_id":"S026_B014","speaker_id":"vaelira","text":"It is to you."},
{"beat_id":"S026_B015","speaker_id":"vaelira","text":"That's why you need to write it.","cues":{"staging":"Beat."}},
{"beat_id":"S026_B016","speaker_id":"vaelira","text":"And don't take the old table down.","cues":{"staging":"Junior nods, starts to leave."}},
{"beat_id":"S026_B017","speaker_id":"junior_researcher","text":"It's wrong.","cues":{"staging":"Junior stops."}},
{"beat_id":"S026_B018","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S026_B019","speaker_id":"vaelira","text":"Leave it.","cues":{"staging":"Vaelira looks at both versions."}},
{"beat_id":"S026_B020","speaker_id":"nimera","text":"You kept the bad one.","cues":{"staging":"Junior understands enough. Nimera has been nearby."}},
{"beat_id":"S026_B021","speaker_id":"vaelira","text":"Incorrect isn't useless."},
{"beat_id":"S026_B022","speaker_id":"nimera","text":"Sometimes it is."},
{"beat_id":"S026_B023","speaker_id":"vaelira","text":"Frequently.","cues":{"staging":"Vaelira looks at her."}},
{"beat_id":"S026_B024","speaker_id":"nimera","text":"Good. I was worried you'd become inspirational.","cues":{"staging":"Nimera smiles."}},
{"beat_id":"S026_B025","speaker_id":"vaelira","text":"Horrifying.","cues":{"staging":"Vaelira goes flat."}},
{"beat_id":"S026_B026","speaker_id":"nimera","text":"Think they'll actually challenge you now?","cues":{"staging":"Nimera looks at revised board."}},
{"beat_id":"S026_B027","speaker_id":"vaelira","text":"Some of them."},
{"beat_id":"S026_B028","speaker_id":"nimera","text":"That's optimistic."},
{"beat_id":"S026_B029","speaker_id":"vaelira","text":"It wasn't meant to be."},
{"beat_id":"S026_B030","speaker_id":"nimera","text":"Still haven't closed it.","cues":{"staging":"Nimera laughs. Vaelira opens notebook. Larger six-channel diagram, boundary still unfinished."}},
{"beat_id":"S026_B031","speaker_id":"vaelira","text":"I don't know where it belongs."},
{"beat_id":"S026_B032","speaker_id":"nimera","text":"Yesterday that would've bothered you more."},
{"beat_id":"S026_B033","speaker_id":"vaelira","text":"Yesterday I would have drawn one.","cues":{"staging":"Vaelira thinks."}},
{"beat_id":"S026_B034","speaker_id":"vaelira","text":"That would have been worse.","cues":{"staging":"Beat."}},
{"beat_id":"S026_B035","speaker_id":"nimera","text":"Probably.","cues":{"staging":"Nimera nods."}},
{"beat_id":"S026_B036","speaker_id":"vaelira","text":"Probably?"},
{"beat_id":"S026_B037","speaker_id":"nimera","text":"I'm learning from you."},
{"beat_id":"S026_B038","speaker_id":"nimera","text":"Terrible feeling, isn't it?","cues":{"staging":"Vaelira narrows eyes. Nimera starts walking."}},
{"beat_id":"S026_B039","speaker_id":"nimera","text":"She's coming.","cues":{"staging":"Cyanis, Ilyra, Torren near eastern bridge. Torren has route map, Cyanis food, Ilyra coffee/local equivalent."}},
{"beat_id":"S026_B040","speaker_id":"torren","text":"Didn't ask."},
{"beat_id":"S026_B041","speaker_id":"nimera","text":"You looked."},
{"beat_id":"S026_B042","speaker_id":"torren","text":"At the road."},
{"beat_id":"S026_B043","speaker_id":"nimera","text":"Of course you did."},
{"beat_id":"S026_B044","speaker_id":"cyanis","text":"Eat.","cues":{"staging":"Vaelira joins. Cyanis holds out wrapped breakfast."}},
{"beat_id":"S026_B045","speaker_id":"vaelira","text":"Is this a group rule?","cues":{"staging":"Vaelira looks at it and him."}},
{"beat_id":"S026_B046","speaker_id":"ilyra","text":"Increasingly."},
{"beat_id":"S026_B047","speaker_id":"torren","text":"He's usually the problem."},
{"beat_id":"S026_B048","speaker_id":"cyanis","text":"Betrayal before breakfast."},
{"beat_id":"S026_B049","speaker_id":"ilyra","text":"You've already eaten."},
{"beat_id":"S026_B050","speaker_id":"cyanis","text":"Strong evidence.","cues":{"staging":"Cyanis looks at his own food."}},
{"beat_id":"S026_B051","speaker_id":"","text":"","cues":{"staging":"Vaelira takes breakfast."}},
{"beat_id":"S026_B052","speaker_id":"vaelira","text":"Cresthaven is west from here.","cues":{"staging":"Torren folds route map."}},
{"beat_id":"S026_B053","speaker_id":"torren","text":"Mostly."},
{"beat_id":"S026_B054","speaker_id":"vaelira","text":"Mostly?"},
{"beat_id":"S026_B055","speaker_id":"torren","text":"Main road goes west.","cues":{"staging":"Torren points."}},
{"beat_id":"S026_B056","speaker_id":"torren","text":"We don't.","cues":{"staging":"Then another line."}},
{"beat_id":"S026_B057","speaker_id":"vaelira","text":"Why?"},
{"beat_id":"S026_B058","speaker_id":"torren","text":"Washout."},
{"beat_id":"S026_B059","speaker_id":"vaelira","text":"The Crown route sheet says it's clear."},
{"beat_id":"S026_B060","speaker_id":"torren","text":"Crown route sheet's three weeks old."},
{"beat_id":"S026_B061","speaker_id":"vaelira","text":"So I was wrong.","cues":{"staging":"Vaelira looks west, then at Torren."}},
{"beat_id":"S026_B062","speaker_id":"torren","text":"Yeah.","cues":{"staging":"Torren shrugs."}},
{"beat_id":"S026_B063","speaker_id":"torren","text":"Happens.","cues":{"staging":"Beat."}},
{"beat_id":"S026_B064","speaker_id":"torren","text":"South road's better.","cues":{"staging":"Vaelira looks at him."}},
{"beat_id":"S026_B065","speaker_id":"nimera","text":"You all right?","cues":{"staging":"He starts walking. Nimera sees Vaelira pause."}},
{"beat_id":"S026_B066","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S026_B067","speaker_id":"vaelira","text":"That was strangely painless.","cues":{"staging":"Beat."}},
{"beat_id":"S026_B068","speaker_id":"nimera","text":"Give him time.","cues":{"staging":"Nimera grins."}},
{"beat_id":"S026_B069","speaker_id":"torren","text":"I can hear you.","cues":{"staging":"From ahead:"}},
{"beat_id":"S026_B070","speaker_id":"nimera","text":"Good."},
{"beat_id":"S026_B071","speaker_id":"cyanis","text":"You don't have to come with us today.","cues":{"staging":"Cyanis falls into step beside Vaelira."}},
{"beat_id":"S026_B072","speaker_id":"vaelira","text":"I know."},
{"beat_id":"S026_B073","speaker_id":"cyanis","text":"Annex probably has six months of work now."},
{"beat_id":"S026_B074","speaker_id":"vaelira","text":"More."},
{"beat_id":"S026_B075","speaker_id":"cyanis","text":"That's what I figured."},
{"beat_id":"S026_B076","speaker_id":"vaelira","text":"They'll do it.","cues":{"staging":"Vaelira eats."}},
{"beat_id":"S026_B077","speaker_id":"cyanis","text":"Sure?"},
{"beat_id":"S026_B078","speaker_id":"vaelira","text":"No."},
{"beat_id":"S026_B079","speaker_id":"cyanis","text":"Good enough.","cues":{"staging":"Cyanis nods."}},
{"beat_id":"S026_B080","speaker_id":"vaelira","text":"That's an appalling standard."},
{"beat_id":"S026_B081","speaker_id":"cyanis","text":"Works surprisingly often."},
{"beat_id":"S026_B082","speaker_id":"vaelira","text":"I want to see the other sites.","cues":{"staging":"A few steps."}},
{"beat_id":"S026_B083","speaker_id":"cyanis","text":"The maps?"},
{"beat_id":"S026_B084","speaker_id":"vaelira","text":"The maps. The systems. Whatever else you've been finding."},
{"beat_id":"S026_B085","speaker_id":"vaelira","text":"I spent years studying one structure until I knew exactly what questions to ask it.","cues":{"staging":"Beat."}},
{"beat_id":"S026_B086","speaker_id":"vaelira","text":"Apparently I'd like some new structures.","cues":{"staging":"She glances back."}},
{"beat_id":"S026_B087","speaker_id":"cyanis","text":"We've been very good at finding inconvenient ones."},
{"beat_id":"S026_B088","speaker_id":"vaelira","text":"I noticed."},
{"beat_id":"S026_B089","speaker_id":"cyanis","text":"Then you're hired.","cues":{"staging":"Cyanis smiles."}},
{"beat_id":"S026_B090","speaker_id":"vaelira","text":"I already joined you."},
{"beat_id":"S026_B091","speaker_id":"cyanis","text":"Then the paperwork's excellent."},
{"beat_id":"S026_B092","speaker_id":"vaelira","text":"There is no paperwork.","cues":{"staging":"Vaelira stares."}},
{"beat_id":"S026_B093","speaker_id":"cyanis","text":"Even better."},
{"beat_id":"S026_B094","speaker_id":"vaelira","text":"Cyanis.","cues":{"staging":"Vaelira slows."}},
{"beat_id":"S026_B095","speaker_id":"vaelira","text":"If I do that again—","cues":{"staging":"He looks back."}},
{"beat_id":"S026_B096","speaker_id":"vaelira","text":"If I'm certain about something—","cues":{"staging":"She tries another sentence."}},
{"beat_id":"S026_B097","speaker_id":"vaelira","text":"And you think the question is wrong—","cues":{"staging":"Beat."}},
{"beat_id":"S026_B098","speaker_id":"cyanis","text":"I'll ask."},
{"beat_id":"S026_B099","speaker_id":"vaelira","text":"Even if I'm sure."},
{"beat_id":"S026_B100","speaker_id":"cyanis","text":"Especially if you're sure."},
{"beat_id":"S026_B101","speaker_id":"nimera","text":"I volunteer too.","cues":{"staging":"Nimera ahead:"}},
{"beat_id":"S026_B102","speaker_id":"vaelira","text":"I assumed you would.","cues":{"staging":"Vaelira looks at her back."}},
{"beat_id":"S026_B103","speaker_id":"nimera","text":"Excellent."},
{"beat_id":"S026_B104","speaker_id":"torren","text":"Sounds exhausting."},
{"beat_id":"S026_B105","speaker_id":"ilyra","text":"You'll survive."},
{"beat_id":"S026_B106","speaker_id":"torren","text":"Probably."},
{"beat_id":"S026_B107","speaker_id":"","text":"","cues":{"staging":"Vaelira catches the word and looks at him. Torren doesn't notice, or pretends not to."}},
{"beat_id":"S026_B108","speaker_id":"ilyra","text":"Goes both ways.","cues":{"staging":"Ilyra falls into step on Vaelira's other side."}},
{"beat_id":"S026_B109","speaker_id":"vaelira","text":"What does?"},
{"beat_id":"S026_B110","speaker_id":"ilyra","text":"If they're wrong."},
{"beat_id":"S026_B111","speaker_id":"ilyra","text":"Tell them.","cues":{"staging":"She points at Cyanis and Torren."}},
{"beat_id":"S026_B112","speaker_id":"cyanis","text":"Seems hostile.","cues":{"staging":"Cyanis without turning:"}},
{"beat_id":"S026_B113","speaker_id":"ilyra","text":"You'll survive."},
{"beat_id":"S026_B114","speaker_id":"torren","text":"Probably."},
{"beat_id":"S026_B115","speaker_id":"nimera","text":"I'm starting a list."},
{"beat_id":"S026_B116","speaker_id":"cyanis","text":"Of what?"},
{"beat_id":"S026_B117","speaker_id":"nimera","text":"Things you're wrong about."},
{"beat_id":"S026_B118","speaker_id":"cyanis","text":"Small notebook?"},
{"beat_id":"S026_B119","speaker_id":"nimera","text":"Fuck you."},
{"beat_id":"S026_B120","speaker_id":"vaelira","text":"What?","cues":{"staging":"Vaelira laughs — genuinely. Everyone looks at her."}},
{"beat_id":"S026_B121","speaker_id":"cyanis","text":"Nothing."},
{"beat_id":"S026_B122","speaker_id":"vaelira","text":"That wasn't nothing.","cues":{"staging":"Vaelira narrows eyes."}},
{"beat_id":"S026_B123","speaker_id":"nimera","text":"See? She's learning."},
{"beat_id":"S026_B124","speaker_id":"","text":"","cues":{"staging":"Party reaches edge of safe settlement. Camera holds back; Ivorybridge keeps functioning. Old model and corrected model remain together on board."}},
{"beat_id":"S026_B125","speaker_id":"","text":"","cues":{"staging":"Destination: Cresthaven. No extra hostile field leg is attached to S026. Use normal departure/world-map transition."}},
{"beat_id":"S026_B126","speaker_id":"","text":"","cues":{"staging":"Vaelira has a practical place in existing hub: table, storage, field equipment, but not later Workshop Expansion."}},
{"beat_id":"S026_B127","speaker_id":"","text":"","cues":{"staging":"After S026, **H05 — THE APOLOGY VAELIRA DOES NOT NEED** becomes LIVE at Cresthaven. C08/C09 remain governed by their normal availability and are not auto-fired."}},
{"beat_id":"S026_B128","speaker_id":"vaelira","text":"Is this yours?","cues":{"staging":"Vaelira stops beside temporary worktable. On it: Torren's route notes, Nimera's copied symbols, spare paper, and Cyanis's breakfast wrapper. Vaelira picks up wrapper."}},
{"beat_id":"S026_B129","speaker_id":"cyanis","text":"Can't prove that."},
{"beat_id":"S026_B130","speaker_id":"torren","text":"Missed.","cues":{"staging":"Vaelira throws it at him. Cheap 2.5D prop arc. Cyanis ducks. Nimera laughs."}},
{"beat_id":"S026_B131","speaker_id":"vaelira","text":"I know.","cues":{"staging":"Vaelira looks at him."}},
{"beat_id":"S026_B132","speaker_id":"ilyra","text":"Smart.","cues":{"staging":"Torren immediately takes one step farther away."}},
{"beat_id":"S026_B133","speaker_id":"","text":"","cues":{"staging":"Vaelira sets field bag on table, looks at maps, then unfinished boundary in notebook. She leaves it unfinished. For now. **END S026 — A PLACE WHERE BEING WRONG IS SURVIVABLE** **CHAPTER 4 — THE SEVENTH REACTION — MANDATORY STORY COMPLETE**"}}
]
