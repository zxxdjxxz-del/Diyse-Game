[ext_resource type="Script" path="res://game/dialogue/dialogue_scene_definition.gd" id="1_scene"]

[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "S024"
chapter_id = "chapter_04"
scene_kind = "mandatory"
location_id = "LOC_SIXFOLD_REGULATION_CORE"
trigger_id = "trigger.chapter_04.s024"
completion_flag = "scene.s024.complete"
participants = Array[String](["nimera","vaelira","torren","cyanis","ilyra"])
authoring_notes = "Runtime synchronized 2026-08-27 to the approved four-element S024 / Audit121. Spoken sequence and staging follow docs/chapters/dialogue/chapter_04/S024.md; legacy internal location_id retained pending environment-ID migration."
beats = [
{"beat_id":"S024_B001","speaker_id":"nimera","text":"Bad?","cues":{"staging":"Old infrastructure the modern Annex has built around. Four large elemental chambers — Fire, Ice, Lightning, Earth — surround the central regulator shaft, with modern instruments, bridges, and railings built onto old stone and metal. Vaelira stops at the first landing."}},
{"beat_id":"S024_B002","speaker_id":"vaelira","text":"Familiar."},
{"beat_id":"S024_B003","speaker_id":"torren","text":"That's bad?"},
{"beat_id":"S024_B004","speaker_id":"vaelira","text":"Right now? Yes."},
{"beat_id":"S024_B005","speaker_id":"cyanis","text":"Because?"},
{"beat_id":"S024_B006","speaker_id":"vaelira","text":"Those four chambers are the inputs.","cues":{"staging":"Vaelira points down."}},
{"beat_id":"S024_B006A","speaker_id":"vaelira","text":"The six relationships between them are the model.","cues":{"staging":"She indicates the instrument lattice connecting them."}},
{"beat_id":"S024_B007","speaker_id":"vaelira","text":"Not a representation of it.","cues":{"staging":"She looks at the machinery."}},
{"beat_id":"S024_B008","speaker_id":"vaelira","text":"The actual thing we've been measuring.","cues":{"staging":"Beat."}},
{"beat_id":"S024_B009","speaker_id":"nimera","text":"And the spillway?"},
{"beat_id":"S024_B010","speaker_id":"vaelira","text":"Under it.","cues":{"staging":"Vaelira points farther down beneath the chambers."}},
{"beat_id":"S024_B011","speaker_id":"torren","text":"Of course it is."},
{"beat_id":"S024_B012","speaker_id":"ilyra","text":"You sound personally offended."},
{"beat_id":"S024_B013","speaker_id":"torren","text":"Stairs."},
{"beat_id":"S024_B014","speaker_id":"","text":"","cues":{"staging":"Connected vertical dungeon. Main route around shaft, chamber galleries, service stairs, side alcoves, broken maintenance loop, optional cache/observation platform. Random encounters enabled in unsecured areas. No preset count."}},
{"beat_id":"S024_B015","speaker_id":"vaelira","text":"Fire and Ice.","cues":{"staging":"Local inspection safe pocket. Six pairwise readings stabilize."}},
{"beat_id":"S024_B016","speaker_id":"vaelira","text":"Fire and Lightning. Fire and Earth."},
{"beat_id":"S024_B017","speaker_id":"vaelira","text":"Ice and Lightning. Ice and Earth. Lightning and Earth."},
{"beat_id":"S024_B018","speaker_id":"nimera","text":"Same problem?","cues":{"staging":"All six settle."}},
{"beat_id":"S024_B019","speaker_id":"vaelira","text":"Worse."},
{"beat_id":"S024_B020","speaker_id":"cyanis","text":"Why?"},
{"beat_id":"S024_B021","speaker_id":"vaelira","text":"Because they're right."},
{"beat_id":"S024_B022","speaker_id":"torren","text":"Again."},
{"beat_id":"S024_B023","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S024_B024","speaker_id":"nimera","text":"There.","cues":{"staging":"A seventh return-pressure number rises after the six settle."}},
{"beat_id":"S024_B025","speaker_id":"vaelira","text":"Part of it."},
{"beat_id":"S024_B026","speaker_id":"nimera","text":"Part?"},
{"beat_id":"S024_B027","speaker_id":"vaelira","text":"It's not staying here.","cues":{"staging":"Vaelira checks more instruments."}},
{"beat_id":"S024_B028","speaker_id":"ilyra","text":"Where is it going?"},
{"beat_id":"S024_B029","speaker_id":"vaelira","text":"Central balance.","cues":{"staging":"Vaelira looks down the shaft."}},
{"beat_id":"S024_B030","speaker_id":"","text":"","cues":{"staging":"Four chambers; the authored two-at-a-time activation changes environmental state with cheap lighting/VFX/audio. Random encounters remain enabled outside safe refuges."}},
{"beat_id":"S024_B031","speaker_id":"nimera","text":"There it is again.","cues":{"staging":"Vaelira lays the original diagram beside the live reading."}},
{"beat_id":"S024_B032","speaker_id":"cyanis","text":"Vaelira?"},
{"beat_id":"S024_B033","speaker_id":"vaelira","text":"I kept asking what each element did to the others.","cues":{"staging":"Vaelira points at the six pair relationships."}},
{"beat_id":"S024_B034","speaker_id":"nimera","text":"That's the model."},
{"beat_id":"S024_B035","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S024_B036","speaker_id":"vaelira","text":"I never asked what the system does when all six pairings succeed.","cues":{"staging":"Vaelira points at the central regulator."}},
{"beat_id":"S024_B037","speaker_id":"torren","text":"It dumps something.","cues":{"staging":"Silence."}},
{"beat_id":"S024_B038","speaker_id":"vaelira","text":"More than that."},
{"beat_id":"S024_B039","speaker_id":"vaelira","text":"Fire isn't doing this.","cues":{"staging":"She studies the pattern."}},
{"beat_id":"S024_B040","speaker_id":"vaelira","text":"Neither is Ice. Lightning. Earth.","cues":{"staging":"Points."}},
{"beat_id":"S024_B041","speaker_id":"nimera","text":"It's what happens between them."},
{"beat_id":"S024_B042","speaker_id":"vaelira","text":"After them."},
{"beat_id":"S024_B043","speaker_id":"vaelira","text":"Both.","cues":{"staging":"Nimera looks at her. Vaelira corrects herself."}},
{"beat_id":"S024_B044","speaker_id":"cyanis","text":"So not a seventh element."},
{"beat_id":"S024_B045","speaker_id":"vaelira","text":"No."},
{"beat_id":"S024_B046","speaker_id":"vaelira","text":"A seventh reaction."},
{"beat_id":"S024_B047","speaker_id":"nimera","text":"The system reacting to being balanced.","cues":{"staging":"Beat."}},
{"beat_id":"S024_B048","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S024_B049","speaker_id":"ilyra","text":"Why is it dangerous now?"},
{"beat_id":"S024_B050","speaker_id":"vaelira","text":"Because it accumulates."},
{"beat_id":"S024_B051","speaker_id":"nimera","text":"Slowly."},
{"beat_id":"S024_B052","speaker_id":"vaelira","text":"Until it doesn't."},
{"beat_id":"S024_B053","speaker_id":"torren","text":"That's usually how breaking works."},
{"beat_id":"S024_B054","speaker_id":"torren","text":"Roads. Bridges. Bow limbs.","cues":{"staging":"Vaelira looks at him."}},
{"beat_id":"S024_B055","speaker_id":"torren","text":"People.","cues":{"staging":"Beat."}},
{"beat_id":"S024_B056","speaker_id":"vaelira","text":"Every correction pushes a small amount somewhere the model wasn't watching.","cues":{"staging":"Ilyra glances at him. He doesn't elaborate."}},
{"beat_id":"S024_B057","speaker_id":"cyanis","text":"And we kept congratulating ourselves because all six pair readings got better."},
{"beat_id":"S024_B058","speaker_id":"vaelira","text":"I did."},
{"beat_id":"S024_B059","speaker_id":"cyanis","text":"We."},
{"beat_id":"S024_B060","speaker_id":"cyanis","text":"There are a lot of people working upstairs.","cues":{"staging":"Vaelira looks at him."}},
{"beat_id":"S024_B061","speaker_id":"nimera","text":"Doesn't make the model useless."},
{"beat_id":"S024_B062","speaker_id":"vaelira","text":"No."},
{"beat_id":"S024_B063","speaker_id":"nimera","text":"Makes the boundary useless."},
{"beat_id":"S024_B064","speaker_id":"vaelira","text":"Incomplete."},
{"beat_id":"S024_B065","speaker_id":"nimera","text":"That's a nicer word."},
{"beat_id":"S024_B066","speaker_id":"vaelira","text":"It's also more accurate."},
{"beat_id":"S024_B067","speaker_id":"nimera","text":"Fine."},
{"beat_id":"S024_B068","speaker_id":"","text":"","cues":{"staging":"Larger/interconnected. Direct stair, maintenance loops, overflow passages, optional markings/parts/notes/equipment chest, views into dormant core. No Underground Crest Network reveal."}},
{"beat_id":"S024_B069","speaker_id":"vaelira","text":"It's compensating.","cues":{"staging":"Safe landing overlooking central chamber. Mechanism moves/reconfigures."}},
{"beat_id":"S024_B070","speaker_id":"nimera","text":"For what?"},
{"beat_id":"S024_B071","speaker_id":"vaelira","text":"Us."},
{"beat_id":"S024_B072","speaker_id":"cyanis","text":"We haven't touched anything."},
{"beat_id":"S024_B073","speaker_id":"vaelira","text":"We interrupted the exposure wing."},
{"beat_id":"S024_B074","speaker_id":"ilyra","text":"Stabilized the researcher."},
{"beat_id":"S024_B075","speaker_id":"vaelira","text":"And staff shut down the compromised branch."},
{"beat_id":"S024_B076","speaker_id":"nimera","text":"So the load moved again."},
{"beat_id":"S024_B077","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S024_B078","speaker_id":"torren","text":"That looks intentional.","cues":{"staging":"Two chamber feeds light. Two go dark."}},
{"beat_id":"S024_B079","speaker_id":"vaelira","text":"It is."},
{"beat_id":"S024_B080","speaker_id":"cyanis","text":"Can you stop it?"},
{"beat_id":"S024_B081","speaker_id":"vaelira","text":"Not from here.","cues":{"staging":"Vaelira works controls. Nothing."}},
{"beat_id":"S024_B082","speaker_id":"vaelira","text":"We're going to have to break it.","cues":{"staging":"Mechanism locks into combat configuration."}},
{"beat_id":"S024_B083","speaker_id":"torren","text":"Finally."},
{"beat_id":"S024_B084","speaker_id":"nimera","text":"You've been waiting all day to hear that."},
{"beat_id":"S024_B085","speaker_id":"torren","text":"Little bit."},
{"beat_id":"S024_B086","speaker_id":"","text":"","cues":{"staging":"Encounter-enabled until final secured threshold. Optional exploration before boss. Recovery point + formation. No mandatory Vaelira slot; any legal four must work."}},
{"beat_id":"S024_B087","speaker_id":"","text":"","cues":{"staging":"MANDATORY BOSS — REGULATION CRUCIBLE. FORM I — DIVIDED REGULATION CRUCIBLE. Four chambers: Fire, Ice, Lightning, Earth. Exactly two active/targetable at once; central core always targetable; dormant chambers untargetable. Intact rotation: Fire/Ice → Lightning/Earth → Fire/Lightning → Ice/Earth. Destroyed chambers stay destroyed; destroyed scheduled slots remain empty; if both scheduled chambers are gone, that rotation is core-only. Player may rush core or dismantle chambers. Former Wind speed/cadence and Water Barrier/restoration/stabilization inheritance are removed and not reassigned."}},
{"beat_id":"S024_B088","speaker_id":"vaelira","text":"Back.","cues":{"staging":"Core reaches zero. No damage spills forward. Battle UI withdraws for transformation staging. Vaelira sees it."}},
{"beat_id":"S024_B089","speaker_id":"nimera","text":"It's combining them.","cues":{"staging":"Party withdraws within the existing stage. Surviving chamber lights feed inward; the central silhouette changes with the prepared state swap."}},
{"beat_id":"S024_B090","speaker_id":"vaelira","text":"Yes."},
{"beat_id":"S024_B091","speaker_id":"torren","text":"We just killed it."},
{"beat_id":"S024_B092","speaker_id":"vaelira","text":"We killed the divided system."},
{"beat_id":"S024_B093","speaker_id":"cyanis","text":"Different thing?","cues":{"staging":"New body forms."}},
{"beat_id":"S024_B094","speaker_id":"vaelira","text":"Different problem."},
{"beat_id":"S024_B095","speaker_id":"","text":"","cues":{"staging":"FORM II — THE SEVENTH REACTION / UNIFIED ELEMENTAL BODY. Fresh full HP / fresh authored MP. Inherit only surviving Form-I chamber traits: Fire/Burn, Ice/Freeze, Lightning/Stun/disruption, Earth/Staggered/defensive pressure. Destroyed traits stay gone; no chamber respawn; no third form. Genuine fresh-HP transformation refreshes Prime availability. No exact historical Form-II named command list is supplied by this conversion."}},
{"beat_id":"S024_B096","speaker_id":"nimera","text":"Say it.","cues":{"staging":"Form II reaches zero. The machine collapses to a dormant regulator instead of exploding. Four chamber indicators return very low and stable; central return approaches zero."}},
{"beat_id":"S024_B097","speaker_id":"vaelira","text":"What?"},
{"beat_id":"S024_B098","speaker_id":"nimera","text":"You already have the sentence."},
{"beat_id":"S024_B099","speaker_id":"vaelira","text":"The seventh reaction wasn't a failure of any one element.","cues":{"staging":"Vaelira looks at the dormant core."}},
{"beat_id":"S024_B100","speaker_id":"vaelira","text":"It was the consequence of treating all six pair relationships as though they described the whole system.","cues":{"staging":"Cyanis waits."}},
{"beat_id":"S024_B101","speaker_id":"torren","text":"So every time you fixed it—"},
{"beat_id":"S024_B102","speaker_id":"vaelira","text":"We moved the cost."},
{"beat_id":"S024_B103","speaker_id":"ilyra","text":"Onto people who weren't in the equation."},
{"beat_id":"S024_B104","speaker_id":"vaelira","text":"Yes.","cues":{"staging":"Vaelira's expression changes."}},
{"beat_id":"S024_B105","speaker_id":"vaelira","text":"I should have seen it."},
{"beat_id":"S024_B106","speaker_id":"nimera","text":"Maybe."},
{"beat_id":"S024_B107","speaker_id":"nimera","text":"That's not the same as saying you could have known it from what you measured.","cues":{"staging":"Vaelira looks at her."}},
{"beat_id":"S024_B108","speaker_id":"vaelira","text":"I chose what to measure."},
{"beat_id":"S024_B109","speaker_id":"nimera","text":"Yes."},
{"beat_id":"S024_B110","speaker_id":"nimera","text":"That's the part you own.","cues":{"staging":"Beat."}},
{"beat_id":"S024_B111","speaker_id":"cyanis","text":"And the people who approved it?"},
{"beat_id":"S024_B112","speaker_id":"vaelira","text":"Own theirs.","cues":{"staging":"Vaelira looks upward."}},
{"beat_id":"S024_B113","speaker_id":"ilyra","text":"Good."},
{"beat_id":"S024_B114","speaker_id":"torren","text":"So what now?"},
{"beat_id":"S024_B115","speaker_id":"vaelira","text":"We stop calling transferred cost acceptable variance.","cues":{"staging":"Vaelira looks at the damaged core and route upstairs."}},
{"beat_id":"S024_B116","speaker_id":"nimera","text":"That's a start."},
{"beat_id":"S024_B117","speaker_id":"vaelira","text":"No."},
{"beat_id":"S024_B118","speaker_id":"vaelira","text":"That's the minimum.","cues":{"staging":"She looks at her."}},
{"beat_id":"S024_B119","speaker_id":"nimera","text":"Better."},
{"beat_id":"S024_B120","speaker_id":"","text":"","cues":{"staging":"Core becomes safe, recovery point, exploration/rewards available. C09 eligible after S024. Cinder Judgment mandatory Chapter 4 source is the Reaction Annex / regulation-system protected cache, not the Regulation Crucible first-clear reward."}},
{"beat_id":"S024_B121","speaker_id":"cyanis","text":"How many?","cues":{"staging":"Cyanis looks at stairs, then Torren."}},
{"beat_id":"S024_B122","speaker_id":"torren","text":"Don't.","cues":{"staging":"Torren stares."}},
{"beat_id":"S024_B123","speaker_id":"cyanis","text":"Didn't say anything."},
{"beat_id":"S024_B124","speaker_id":"torren","text":"Your face did."},
{"beat_id":"S024_B125","speaker_id":"nimera","text":"Oh, fuck you both.","cues":{"staging":"Nimera looks at them."}},
{"beat_id":"S024_B126","speaker_id":"vaelira","text":"What?","cues":{"staging":"Ilyra laughs. Vaelira does not yet understand why."}},
{"beat_id":"S024_B127","speaker_id":"nimera","text":"Don't worry about it."},
{"beat_id":"S024_B128","speaker_id":"torren","text":"Best advice you've given her all day."},
{"beat_id":"S024_B129","speaker_id":"nimera","text":"Eat shit, Torren."},
{"beat_id":"S024_B130","speaker_id":"","text":"","cues":{"staging":"**END S024 — SEVENTH REACTION**"}}
]