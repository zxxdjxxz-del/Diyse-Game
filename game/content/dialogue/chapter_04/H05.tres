[gd_resource type="Resource" script_class="DiyseDialogueSceneDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://game/dialogue/dialogue_scene_definition.gd" id="1_scene"]

[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "H05"
chapter_id = "chapter_04"
scene_kind = "character_life"
location_id = "LOC_CRESTHAVEN_WORKROOM"
trigger_id = "trigger.chapter_04.h05.after_s026"
completion_flag = "scene.h05.complete"
participants = Array[String](["vaelira","cyanis"])
authoring_notes = "Exact Chapter 4 Resource conversion from docs/chapters/dialogue/chapter_04/H05.md; accepted through CH4-A029. Spoken sequence is exact; staging is carried in cues where present. Maevra is not an active Chapter 4 party member unless explicitly authored. SHA-256: e2dc6b2d1ce6d5a1ec3442dc0dbeafe767c10b6ccc3e0ee43dfa4c366a0776bd."
beats = [
{"beat_id":"H05_B001","speaker_id":"vaelira","text":"Those don't belong here.","cues":{"staging":"**CRESTHAVEN — WORKROOM — LATE AFTERNOON** Vaelira is standing at the table she acquired approximately one hour ago. Torren's route notes have been pushed to one side. Nimera's copied symbols occupy another. Vaelira has somehow created a clean working area in the middle. She is labeling a storage box. Cyanis walks through carrying a stack of supplies. Vaelira looks at him. Then the supplies. Then him again.","source_section":"H05_B001 — HER TABLE, APPARENTLY"}},
{"beat_id":"H05_B002","speaker_id":"cyanis","text":"Strong opening.","cues":{"staging":"Cyanis stops. Looks down.","source_section":"H05_B001 — HER TABLE, APPARENTLY"}},
{"beat_id":"H05_B003","speaker_id":"vaelira","text":"Medical storage is across the hall.","cues":{}},
{"beat_id":"H05_B004","speaker_id":"cyanis","text":"These aren't medical.","cues":{}},
{"beat_id":"H05_B005","speaker_id":"vaelira","text":"Bandages.","cues":{"staging":"Vaelira reads the top label.","source_section":"H05_B001 — HER TABLE, APPARENTLY"}},
{"beat_id":"H05_B006","speaker_id":"cyanis","text":"Also rope.","cues":{}},
{"beat_id":"H05_B007","speaker_id":"cyanis","text":"Mixed box.","cues":{"staging":"Vaelira looks at him.","source_section":"H05_B001 — HER TABLE, APPARENTLY"}},
{"beat_id":"H05_B008","speaker_id":"vaelira","text":"Why?","cues":{}},
{"beat_id":"H05_B009","speaker_id":"cyanis","text":"Because someone put rope in the bandage box.","cues":{}},
{"beat_id":"H05_B010","speaker_id":"vaelira","text":"Who?","cues":{}},
{"beat_id":"H05_B011","speaker_id":"cyanis","text":"That's a dangerous question around here.","cues":{"staging":"Cyanis thinks.","source_section":"H05_B001 — HER TABLE, APPARENTLY"}},
{"beat_id":"H05_B012","speaker_id":"vaelira","text":"Take it away.","cues":{"staging":"Vaelira points across the hall.","source_section":"H05_B001 — HER TABLE, APPARENTLY"}},
{"beat_id":"H05_B013","speaker_id":"cyanis","text":"Yes, ma'am.","cues":{}},
{"beat_id":"H05_B014","speaker_id":"vaelira","text":"Cyanis.","cues":{"staging":"He turns.","source_section":"H05_B001 — HER TABLE, APPARENTLY"}},
{"beat_id":"H05_B015","speaker_id":"","text":"","cues":{"staging":"He stops. Different tone.","source_section":"H05_B001 — HER TABLE, APPARENTLY"}},
{"beat_id":"H05_B016","speaker_id":"cyanis","text":"What?","cues":{"staging":"Cyanis sets the box down.","source_section":"H05_B002 — I SHOULD APOLOGIZE"}},
{"beat_id":"H05_B017","speaker_id":"vaelira","text":"I owe all of you an apology.","cues":{"staging":"Vaelira takes a moment longer than usual.","source_section":"H05_B002 — I SHOULD APOLOGIZE"}},
{"beat_id":"H05_B018","speaker_id":"cyanis","text":"For the box?","cues":{"staging":"Cyanis looks genuinely confused.","source_section":"H05_B002 — I SHOULD APOLOGIZE"}},
{"beat_id":"H05_B019","speaker_id":"cyanis","text":"Worth checking.","cues":{"staging":"Vaelira gives him a look.","source_section":"H05_B002 — I SHOULD APOLOGIZE"}},
{"beat_id":"H05_B020","speaker_id":"vaelira","text":"The Annex.","cues":{}},
{"beat_id":"H05_B021","speaker_id":"cyanis","text":"What about it?","cues":{"staging":"Beat. Cyanis leans one hand on the box.","source_section":"H05_B002 — I SHOULD APOLOGIZE"}},
{"beat_id":"H05_B022","speaker_id":"vaelira","text":"We went there because of me.","cues":{}},
{"beat_id":"H05_B023","speaker_id":"cyanis","text":"Yes.","cues":{}},
{"beat_id":"H05_B024","speaker_id":"vaelira","text":"I brought you into a system I thought I understood.","cues":{}},
{"beat_id":"H05_B025","speaker_id":"cyanis","text":"Yes.","cues":{}},
{"beat_id":"H05_B026","speaker_id":"vaelira","text":"We ended up fighting through half the lower facility.","cues":{}},
{"beat_id":"H05_B027","speaker_id":"cyanis","text":"Felt like more.","cues":{}},
{"beat_id":"H05_B028","speaker_id":"vaelira","text":"Cyanis.","cues":{}},
{"beat_id":"H05_B029","speaker_id":"cyanis","text":"Sorry.","cues":{}},
{"beat_id":"H05_B030","speaker_id":"vaelira","text":"Someone was nearly killed.","cues":{"staging":"Vaelira folds her arms.","source_section":"H05_B002 — I SHOULD APOLOGIZE"}},
{"beat_id":"H05_B031","speaker_id":"cyanis","text":"I know.","cues":{}},
{"beat_id":"H05_B032","speaker_id":"vaelira","text":"You could have been.","cues":{}},
{"beat_id":"H05_B033","speaker_id":"vaelira","text":"All of you.","cues":{"staging":"Cyanis waits.","source_section":"H05_B002 — I SHOULD APOLOGIZE"}},
{"beat_id":"H05_B034","speaker_id":"vaelira","text":"So. I'm sorry.","cues":{"staging":"Another beat.","source_section":"H05_B002 — I SHOULD APOLOGIZE"}},
{"beat_id":"H05_B035","speaker_id":"cyanis","text":"For what?","cues":{"staging":"Cyanis looks at her.","source_section":"H05_B003 — FOR WHAT?"}},
{"beat_id":"H05_B036","speaker_id":"vaelira","text":"I just told you.","cues":{"staging":"Vaelira's expression tightens.","source_section":"H05_B003 — FOR WHAT?"}},
{"beat_id":"H05_B037","speaker_id":"cyanis","text":"You listed things that happened.","cues":{}},
{"beat_id":"H05_B038","speaker_id":"vaelira","text":"Because I was wrong.","cues":{}},
{"beat_id":"H05_B039","speaker_id":"cyanis","text":"About the boundary.","cues":{}},
{"beat_id":"H05_B040","speaker_id":"vaelira","text":"Yes.","cues":{}},
{"beat_id":"H05_B041","speaker_id":"cyanis","text":"You already said that.","cues":{}},
{"beat_id":"H05_B042","speaker_id":"vaelira","text":"That doesn't make it disappear.","cues":{}},
{"beat_id":"H05_B043","speaker_id":"cyanis","text":"Didn't say it did.","cues":{}},
{"beat_id":"H05_B044","speaker_id":"vaelira","text":"I am attempting to apologize to you.","cues":{"staging":"Vaelira exhales through her nose.","source_section":"H05_B003 — FOR WHAT?"}},
{"beat_id":"H05_B045","speaker_id":"cyanis","text":"Badly.","cues":{}},
{"beat_id":"H05_B046","speaker_id":"vaelira","text":"Excuse me?","cues":{"staging":"Her head snaps toward him.","source_section":"H05_B003 — FOR WHAT?"}},
{"beat_id":"H05_B047","speaker_id":"cyanis","text":"Too broad.","cues":{}},
{"beat_id":"H05_B048","speaker_id":"vaelira","text":"My apology is insufficiently specific.","cues":{"staging":"Vaelira stares.","source_section":"H05_B003 — FOR WHAT?"}},
{"beat_id":"H05_B049","speaker_id":"cyanis","text":"Yeah.","cues":{}},
{"beat_id":"H05_B050","speaker_id":"vaelira","text":"You're grading my apology.","cues":{}},
{"beat_id":"H05_B051","speaker_id":"cyanis","text":"Apparently.","cues":{}},
{"beat_id":"H05_B052","speaker_id":"vaelira","text":"I may kill you.","cues":{}},
{"beat_id":"H05_B053","speaker_id":"cyanis","text":"That one you'd probably need to apologize for.","cues":{}},
{"beat_id":"H05_B054","speaker_id":"","text":"","cues":{"staging":"Vaelira looks away before he can see the smile. He sees it anyway.","source_section":"H05_B003 — FOR WHAT?"}},
{"beat_id":"H05_B055","speaker_id":"vaelira","text":"Fine.","cues":{}},
{"beat_id":"H05_B056","speaker_id":"vaelira","text":"I chose a boundary that excluded relevant effects.","cues":{"staging":"She turns back.","source_section":"H05_B004 — THE PART THAT WAS HERS"}},
{"beat_id":"H05_B057","speaker_id":"cyanis","text":"Yeah.","cues":{}},
{"beat_id":"H05_B058","speaker_id":"vaelira","text":"I trusted the model longer than I should have because it continued producing accurate predictions.","cues":{}},
{"beat_id":"H05_B059","speaker_id":"cyanis","text":"Maybe.","cues":{}},
{"beat_id":"H05_B060","speaker_id":"vaelira","text":"Maybe?","cues":{"staging":"Vaelira frowns.","source_section":"H05_B004 — THE PART THAT WAS HERS"}},
{"beat_id":"H05_B061","speaker_id":"cyanis","text":"You had bad information that still looked good.","cues":{}},
{"beat_id":"H05_B062","speaker_id":"vaelira","text":"I chose what information counted.","cues":{}},
{"beat_id":"H05_B063","speaker_id":"cyanis","text":"There.","cues":{}},
{"beat_id":"H05_B064","speaker_id":"cyanis","text":"That's yours.","cues":{"staging":"Beat.","source_section":"H05_B004 — THE PART THAT WAS HERS"}},
{"beat_id":"H05_B065","speaker_id":"vaelira","text":"Yes.","cues":{"staging":"Vaelira nods once.","source_section":"H05_B004 — THE PART THAT WAS HERS"}},
{"beat_id":"H05_B066","speaker_id":"cyanis","text":"You didn't classify twelve days of return variance by yourself.","cues":{}},
{"beat_id":"H05_B067","speaker_id":"vaelira","text":"No.","cues":{}},
{"beat_id":"H05_B068","speaker_id":"cyanis","text":"You didn't approve every exposure procedure.","cues":{}},
{"beat_id":"H05_B069","speaker_id":"vaelira","text":"No.","cues":{}},
{"beat_id":"H05_B070","speaker_id":"cyanis","text":"You didn't make us follow you downstairs.","cues":{}},
{"beat_id":"H05_B071","speaker_id":"vaelira","text":"I asked you to come.","cues":{"staging":"Vaelira looks at him.","source_section":"H05_B004 — THE PART THAT WAS HERS"}},
{"beat_id":"H05_B072","speaker_id":"cyanis","text":"And we came.","cues":{}},
{"beat_id":"H05_B073","speaker_id":"vaelira","text":"Because you trusted me.","cues":{}},
{"beat_id":"H05_B074","speaker_id":"cyanis","text":"Yeah.","cues":{}},
{"beat_id":"H05_B075","speaker_id":"cyanis","text":"That wasn't a mistake.","cues":{"staging":"No hesitation. Vaelira goes quiet.","source_section":"H05_B004 — THE PART THAT WAS HERS"}},
{"beat_id":"H05_B076","speaker_id":"vaelira","text":"The Annex suggests otherwise.","cues":{}},
{"beat_id":"H05_B077","speaker_id":"cyanis","text":"No.","cues":{}},
{"beat_id":"H05_B078","speaker_id":"cyanis","text":"Trusting you doesn't mean you have to be right every time.","cues":{"staging":"Beat.","source_section":"H05_B004 — THE PART THAT WAS HERS"}},
{"beat_id":"H05_B079","speaker_id":"vaelira","text":"That sounds terrible.","cues":{"staging":"Vaelira stares at him.","source_section":"H05_B005 — THAT SOUNDS TERRIBLE"}},
{"beat_id":"H05_B080","speaker_id":"cyanis","text":"What does?","cues":{}},
{"beat_id":"H05_B081","speaker_id":"vaelira","text":"“You don't have to be right.”","cues":{}},
{"beat_id":"H05_B082","speaker_id":"cyanis","text":"Why?","cues":{}},
{"beat_id":"H05_B083","speaker_id":"vaelira","text":"Because being wrong can kill people.","cues":{}},
{"beat_id":"H05_B084","speaker_id":"cyanis","text":"So can waiting until you're certain.","cues":{}},
{"beat_id":"H05_B085","speaker_id":"cyanis","text":"So can doing nothing.","cues":{"staging":"Vaelira says nothing.","source_section":"H05_B005 — THAT SOUNDS TERRIBLE"}},
{"beat_id":"H05_B086","speaker_id":"cyanis","text":"So can me being wrong.","cues":{"staging":"Still nothing.","source_section":"H05_B005 — THAT SOUNDS TERRIBLE"}},
{"beat_id":"H05_B087","speaker_id":"vaelira","text":"Yes.","cues":{}},
{"beat_id":"H05_B088","speaker_id":"cyanis","text":"I know.","cues":{}},
{"beat_id":"H05_B089","speaker_id":"cyanis","text":"That's why there are five of us.","cues":{"staging":"He shrugs.","source_section":"H05_B005 — THAT SOUNDS TERRIBLE"}},
{"beat_id":"H05_B090","speaker_id":"vaelira","text":"Four before me.","cues":{"staging":"Vaelira looks toward the rest of Cresthaven.","source_section":"H05_B005 — THAT SOUNDS TERRIBLE"}},
{"beat_id":"H05_B091","speaker_id":"cyanis","text":"Five now.","cues":{}},
{"beat_id":"H05_B092","speaker_id":"","text":"","cues":{"staging":"She catches that. Cyanis does not make anything of it.","source_section":"H05_B005 — THAT SOUNDS TERRIBLE"}},
{"beat_id":"H05_B093","speaker_id":"vaelira","text":"I still feel like I should say I'm sorry.","cues":{"staging":"Vaelira turns a pencil between her fingers.","source_section":"H05_B006 — DON'T DO THAT"}},
{"beat_id":"H05_B094","speaker_id":"cyanis","text":"Then say something you're sorry for.","cues":{}},
{"beat_id":"H05_B095","speaker_id":"vaelira","text":"I—","cues":{}},
{"beat_id":"H05_B096","speaker_id":"vaelira","text":"I am sorry I dismissed the return variance as instrument loss without forcing a broader review.","cues":{"staging":"Stops. Thinks.","source_section":"H05_B006 — DON'T DO THAT"}},
{"beat_id":"H05_B097","speaker_id":"cyanis","text":"All right.","cues":{"staging":"Cyanis nods.","source_section":"H05_B006 — DON'T DO THAT"}},
{"beat_id":"H05_B098","speaker_id":"vaelira","text":"That's it?","cues":{"staging":"Vaelira waits.","source_section":"H05_B006 — DON'T DO THAT"}},
{"beat_id":"H05_B099","speaker_id":"cyanis","text":"What do you want me to do?","cues":{}},
{"beat_id":"H05_B100","speaker_id":"vaelira","text":"I don't know.","cues":{}},
{"beat_id":"H05_B101","speaker_id":"cyanis","text":"Forgive you?","cues":{}},
{"beat_id":"H05_B102","speaker_id":"vaelira","text":"No.","cues":{"staging":"Vaelira immediately grimaces.","source_section":"H05_B006 — DON'T DO THAT"}},
{"beat_id":"H05_B103","speaker_id":"cyanis","text":"Good.","cues":{}},
{"beat_id":"H05_B104","speaker_id":"vaelira","text":"That would be strange.","cues":{"staging":"Beat.","source_section":"H05_B006 — DON'T DO THAT"}},
{"beat_id":"H05_B105","speaker_id":"cyanis","text":"Very.","cues":{}},
{"beat_id":"H05_B106","speaker_id":"vaelira","text":"You weren't the person harmed by that decision.","cues":{}},
{"beat_id":"H05_B107","speaker_id":"cyanis","text":"Exactly.","cues":{}},
{"beat_id":"H05_B108","speaker_id":"cyanis","text":"Don't apologize to me for somebody else's injury so I can tell you it's okay.","cues":{"staging":"Vaelira looks at him. That lands harder than reassurance would have.","source_section":"H05_B006 — DON'T DO THAT"}},
{"beat_id":"H05_B109","speaker_id":"cyanis","text":"That's not mine to give you.","cues":{"staging":"Beat.","source_section":"H05_B006 — DON'T DO THAT"}},
{"beat_id":"H05_B110","speaker_id":"vaelira","text":"No.","cues":{"staging":"Vaelira nods slowly.","source_section":"H05_B006 — DON'T DO THAT"}},
{"beat_id":"H05_B111","speaker_id":"vaelira","text":"The Annex is changing the exposure protocol.","cues":{"staging":"Silence. Workers cross the background carrying lumber and supplies. Cresthaven keeps being built around them. Vaelira looks down at her notes.","source_section":"H05_B007 — WHAT SHE CAN DO"}},
{"beat_id":"H05_B112","speaker_id":"cyanis","text":"I know.","cues":{}},
{"beat_id":"H05_B113","speaker_id":"vaelira","text":"Return variance is primary now.","cues":{}},
{"beat_id":"H05_B114","speaker_id":"cyanis","text":"You told us.","cues":{}},
{"beat_id":"H05_B115","speaker_id":"vaelira","text":"Independent review can't use the same boundary assumptions.","cues":{}},
{"beat_id":"H05_B116","speaker_id":"cyanis","text":"Also told us.","cues":{}},
{"beat_id":"H05_B117","speaker_id":"vaelira","text":"Then why did you let me continue?","cues":{"staging":"Vaelira looks annoyed.","source_section":"H05_B007 — WHAT SHE CAN DO"}},
{"beat_id":"H05_B118","speaker_id":"cyanis","text":"You seemed committed.","cues":{}},
{"beat_id":"H05_B119","speaker_id":"vaelira","text":"Asshole.","cues":{"staging":"She almost laughs.","source_section":"H05_B007 — WHAT SHE CAN DO"}},
{"beat_id":"H05_B120","speaker_id":"cyanis","text":"There she is.","cues":{}},
{"beat_id":"H05_B121","speaker_id":"vaelira","text":"So that's it.","cues":{"staging":"Vaelira sets the pencil down.","source_section":"H05_B007 — WHAT SHE CAN DO"}},
{"beat_id":"H05_B122","speaker_id":"cyanis","text":"What?","cues":{}},
{"beat_id":"H05_B123","speaker_id":"vaelira","text":"Find what was mine.","cues":{}},
{"beat_id":"H05_B124","speaker_id":"cyanis","text":"Sounds about right.","cues":{"staging":"Fix what I can. Don't claim the rest.","source_section":"H05_B007 — WHAT SHE CAN DO"}},
{"beat_id":"H05_B125","speaker_id":"vaelira","text":"That's irritatingly simple.","cues":{}},
{"beat_id":"H05_B126","speaker_id":"cyanis","text":"Most useful things are.","cues":{}},
{"beat_id":"H05_B127","speaker_id":"vaelira","text":"That is obviously false.","cues":{"staging":"Vaelira looks at him.","source_section":"H05_B007 — WHAT SHE CAN DO"}},
{"beat_id":"H05_B128","speaker_id":"cyanis","text":"Yeah, probably.","cues":{}},
{"beat_id":"H05_B129","speaker_id":"vaelira","text":"Wait.","cues":{"staging":"Cyanis picks the mixed supply box back up.","source_section":"H05_B008 — THE ACTUAL APOLOGY"}},
{"beat_id":"H05_B130","speaker_id":"vaelira","text":"Your breakfast wrapper.","cues":{"staging":"He stops. Vaelira points at the table.","source_section":"H05_B008 — THE ACTUAL APOLOGY"}},
{"beat_id":"H05_B131","speaker_id":"cyanis","text":"Could be anyone's.","cues":{"staging":"Cyanis looks. The wrapper from earlier is still sitting among the papers.","source_section":"H05_B008 — THE ACTUAL APOLOGY"}},
{"beat_id":"H05_B132","speaker_id":"vaelira","text":"Cyanis.","cues":{}},
{"beat_id":"H05_B133","speaker_id":"cyanis","text":"No witnesses.","cues":{}},
{"beat_id":"H05_B134","speaker_id":"vaelira","text":"I watched you eat it.","cues":{}},
{"beat_id":"H05_B135","speaker_id":"cyanis","text":"Circumstantial.","cues":{}},
{"beat_id":"H05_B136","speaker_id":"vaelira","text":"Take it.","cues":{"staging":"Vaelira picks up the wrapper.","source_section":"H05_B008 — THE ACTUAL APOLOGY"}},
{"beat_id":"H05_B137","speaker_id":"vaelira","text":"Improved accuracy.","cues":{"staging":"Cyanis makes no move. Vaelira throws it. This time it hits him in the chest. He looks down. Then at her. Vaelira smiles.","source_section":"H05_B008 — THE ACTUAL APOLOGY"}},
{"beat_id":"H05_B138","speaker_id":"cyanis","text":"I'm sorry.","cues":{"staging":"Cyanis picks up the wrapper.","source_section":"H05_B008 — THE ACTUAL APOLOGY"}},
{"beat_id":"H05_B139","speaker_id":"vaelira","text":"That apology I accept.","cues":{"staging":"Vaelira points at him.","source_section":"H05_B008 — THE ACTUAL APOLOGY"}},
{"beat_id":"H05_B140","speaker_id":"","text":"","cues":{"staging":"Cyanis laughs and finally carries the box out. Vaelira returns to the table. She looks at the unfinished boundary in her notebook. Doesn't close it. Doesn't erase it. She goes back to work. **END H05 — THE APOLOGY VAELIRA DOES NOT NEED**","source_section":"H05_B008 — THE ACTUAL APOLOGY"}}
]
