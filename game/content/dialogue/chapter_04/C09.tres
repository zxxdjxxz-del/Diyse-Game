[ext_resource type="Script" path="res://game/dialogue/dialogue_scene_definition.gd" id="1_scene"]

[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "C09"
chapter_id = "chapter_04"
scene_kind = "character_life"
location_id = "LOC_IVORYBRIDGE_LODGING"
trigger_id = "trigger.chapter_04.c09.after_s025"
completion_flag = "scene.c09.complete"
participants = Array[String](["nimera","vaelira"])
authoring_notes = "Exact Chapter 4 Resource conversion from docs/chapters/dialogue/chapter_04/C09.md; accepted through CH4-A029. Spoken sequence is exact; staging is carried in cues where present. Maevra is not an active Chapter 4 party member unless explicitly authored. SHA-256: 095d44d85153b7d241d509b3bffc4e7cd50e7adcd675088e0954d73fbb7c1ed3."
beats = [
{"beat_id":"C09_B001","speaker_id":"nimera","text":"No.","cues":{"staging":"**IVORYBRIDGE — LODGING COMMON ROOM — VERY LATE** The building is quiet. One low lamp remains lit. Nimera is sitting at a table in her night clothes with several sheets of copied notation spread around her. She is eating something cold directly from the plate. Vaelira comes downstairs carrying her notebook. She stops when she sees Nimera. Nimera looks up. They stare at each other.","source_section":"C09_B001 — TWO IN THE MORNING"}},
{"beat_id":"C09_B002","speaker_id":"vaelira","text":"I didn't say anything.","cues":{}},
{"beat_id":"C09_B003","speaker_id":"nimera","text":"You're about to.","cues":{}},
{"beat_id":"C09_B004","speaker_id":"vaelira","text":"You're eating in the dark.","cues":{}},
{"beat_id":"C09_B005","speaker_id":"nimera","text":"Lamp.","cues":{}},
{"beat_id":"C09_B006","speaker_id":"vaelira","text":"Nearly dark.","cues":{}},
{"beat_id":"C09_B007","speaker_id":"nimera","text":"Two in the morning.","cues":{}},
{"beat_id":"C09_B008","speaker_id":"vaelira","text":"Fair.","cues":{"staging":"Vaelira considers that.","source_section":"C09_B001 — TWO IN THE MORNING"}},
{"beat_id":"C09_B009","speaker_id":"nimera","text":"Plenty of room to be awake somewhere else.","cues":{"staging":"She walks to the table. Nimera points at the empty chairs.","source_section":"C09_B001 — TWO IN THE MORNING"}},
{"beat_id":"C09_B010","speaker_id":"nimera","text":"Of course.","cues":{"staging":"Vaelira sits opposite her.","source_section":"C09_B001 — TWO IN THE MORNING"}},
{"beat_id":"C09_B011","speaker_id":"vaelira","text":"I hate “relationship marks.”","cues":{"staging":"Vaelira opens her notebook. Nimera continues eating. Several seconds pass. Vaelira:","source_section":"C09_B002 — RELATIONSHIP MARKS"}},
{"beat_id":"C09_B012","speaker_id":"nimera","text":"What?","cues":{"staging":"Nimera slowly lowers her fork.","source_section":"C09_B002 — RELATIONSHIP MARKS"}},
{"beat_id":"C09_B013","speaker_id":"vaelira","text":"Your name for the Wayfinder notation.","cues":{}},
{"beat_id":"C09_B014","speaker_id":"nimera","text":"You've been thinking about that?","cues":{}},
{"beat_id":"C09_B015","speaker_id":"vaelira","text":"Yes.","cues":{}},
{"beat_id":"C09_B016","speaker_id":"nimera","text":"Since when?","cues":{}},
{"beat_id":"C09_B017","speaker_id":"vaelira","text":"Ivorybridge.","cues":{"staging":"Vaelira thinks.","source_section":"C09_B002 — RELATIONSHIP MARKS"}},
{"beat_id":"C09_B018","speaker_id":"nimera","text":"That was hours ago.","cues":{}},
{"beat_id":"C09_B019","speaker_id":"vaelira","text":"I know.","cues":{}},
{"beat_id":"C09_B020","speaker_id":"nimera","text":"That's fucking incredible.","cues":{"staging":"Nimera stares at her.","source_section":"C09_B002 — RELATIONSHIP MARKS"}},
{"beat_id":"C09_B021","speaker_id":"vaelira","text":"It's imprecise.","cues":{}},
{"beat_id":"C09_B022","speaker_id":"nimera","text":"It's provisional.","cues":{}},
{"beat_id":"C09_B023","speaker_id":"vaelira","text":"Provisional language can still be precise.","cues":{}},
{"beat_id":"C09_B024","speaker_id":"nimera","text":"Then what do you call it?","cues":{}},
{"beat_id":"C09_B025","speaker_id":"vaelira","text":"Relative positional syntax.","cues":{"staging":"Vaelira opens to a page.","source_section":"C09_B002 — RELATIONSHIP MARKS"}},
{"beat_id":"C09_B026","speaker_id":"nimera","text":"Absolutely fucking not.","cues":{"staging":"Silence. Nimera's face goes completely blank.","source_section":"C09_B002 — RELATIONSHIP MARKS"}},
{"beat_id":"C09_B027","speaker_id":"vaelira","text":"Why?","cues":{}},
{"beat_id":"C09_B028","speaker_id":"nimera","text":"Because people have to say it.","cues":{}},
{"beat_id":"C09_B029","speaker_id":"vaelira","text":"That isn't a technical objection.","cues":{}},
{"beat_id":"C09_B030","speaker_id":"nimera","text":"It's the most important technical objection.","cues":{}},
{"beat_id":"C09_B031","speaker_id":"vaelira","text":"“Relationship” implies a connection between the sites themselves.","cues":{"staging":"Vaelira turns the notebook toward her.","source_section":"C09_B003 — WORDS DO THINGS"}},
{"beat_id":"C09_B032","speaker_id":"nimera","text":"There is a connection.","cues":{}},
{"beat_id":"C09_B033","speaker_id":"vaelira","text":"In the notation.","cues":{}},
{"beat_id":"C09_B034","speaker_id":"nimera","text":"Which describes the sites.","cues":{}},
{"beat_id":"C09_B035","speaker_id":"vaelira","text":"Relative to one another.","cues":{}},
{"beat_id":"C09_B036","speaker_id":"nimera","text":"That's what a relationship is.","cues":{}},
{"beat_id":"C09_B037","speaker_id":"vaelira","text":"Not necessarily.","cues":{}},
{"beat_id":"C09_B038","speaker_id":"nimera","text":"Oh, fuck off.","cues":{}},
{"beat_id":"C09_B039","speaker_id":"vaelira","text":"If you give something the wrong name early enough, people start asking questions that assume the name is correct.","cues":{"staging":"Vaelira almost smiles.","source_section":"C09_B003 — WORDS DO THINGS"}},
{"beat_id":"C09_B040","speaker_id":"nimera","text":"That's true.","cues":{"staging":"Nimera points her fork at her.","source_section":"C09_B003 — WORDS DO THINGS"}},
{"beat_id":"C09_B041","speaker_id":"nimera","text":"Your name still sucks.","cues":{"staging":"Vaelira looks pleased for half a second.","source_section":"C09_B003 — WORDS DO THINGS"}},
{"beat_id":"C09_B042","speaker_id":"vaelira","text":"It's accurate.","cues":{"staging":"The pleasure disappears.","source_section":"C09_B003 — WORDS DO THINGS"}},
{"beat_id":"C09_B043","speaker_id":"nimera","text":"It's six syllables too accurate.","cues":{}},
{"beat_id":"C09_B044","speaker_id":"vaelira","text":"That's not how syllables work.","cues":{}},
{"beat_id":"C09_B045","speaker_id":"nimera","text":"I know.","cues":{}},
{"beat_id":"C09_B046","speaker_id":"nimera","text":"That's how bad it is.","cues":{"staging":"Beat.","source_section":"C09_B003 — WORDS DO THINGS"}},
{"beat_id":"C09_B047","speaker_id":"vaelira","text":"What is that?","cues":{"staging":"Vaelira looks down at the papers in front of Nimera. Arrows. Crossed-out words. Tiny diagrams. A sentence with three different replacements above it.","source_section":"C09_B004 — NIMERA'S NOTES"}},
{"beat_id":"C09_B048","speaker_id":"nimera","text":"Notes.","cues":{"staging":"Nimera looks down.","source_section":"C09_B004 — NIMERA'S NOTES"}},
{"beat_id":"C09_B049","speaker_id":"vaelira","text":"I can see that.","cues":{}},
{"beat_id":"C09_B050","speaker_id":"nimera","text":"Then excellent work.","cues":{}},
{"beat_id":"C09_B051","speaker_id":"vaelira","text":"You crossed this out.","cues":{"staging":"Vaelira picks up one sheet.","source_section":"C09_B004 — NIMERA'S NOTES"}},
{"beat_id":"C09_B052","speaker_id":"nimera","text":"Yes.","cues":{}},
{"beat_id":"C09_B053","speaker_id":"vaelira","text":"Then wrote it again.","cues":{}},
{"beat_id":"C09_B054","speaker_id":"nimera","text":"Slightly differently.","cues":{}},
{"beat_id":"C09_B055","speaker_id":"vaelira","text":"Then crossed that out.","cues":{}},
{"beat_id":"C09_B056","speaker_id":"nimera","text":"It was still wrong.","cues":{}},
{"beat_id":"C09_B057","speaker_id":"vaelira","text":"And then you wrote the first version again.","cues":{}},
{"beat_id":"C09_B058","speaker_id":"nimera","text":"Turns out I was too hard on her.","cues":{"staging":"Nimera takes the page back.","source_section":"C09_B004 — NIMERA'S NOTES"}},
{"beat_id":"C09_B059","speaker_id":"vaelira","text":"Her?","cues":{}},
{"beat_id":"C09_B060","speaker_id":"nimera","text":"First sentence.","cues":{}},
{"beat_id":"C09_B061","speaker_id":"nimera","text":"She was doing her best.","cues":{"staging":"Vaelira looks at Nimera.","source_section":"C09_B004 — NIMERA'S NOTES"}},
{"beat_id":"C09_B062","speaker_id":"vaelira","text":"Your notes are terrible.","cues":{"staging":"Vaelira laughs once despite herself.","source_section":"C09_B004 — NIMERA'S NOTES"}},
{"beat_id":"C09_B063","speaker_id":"nimera","text":"My notes work.","cues":{}},
{"beat_id":"C09_B064","speaker_id":"vaelira","text":"Nobody else could read these.","cues":{}},
{"beat_id":"C09_B065","speaker_id":"nimera","text":"Nobody else is invited.","cues":{}},
{"beat_id":"C09_B066","speaker_id":"nimera","text":"Oh, yours are disgusting.","cues":{"staging":"Vaelira looks at her own notebook. Every line is straight. Every heading is clear. Every correction is cleanly marked. Nimera notices.","source_section":"C09_B004 — NIMERA'S NOTES"}},
{"beat_id":"C09_B067","speaker_id":"vaelira","text":"They're legible.","cues":{}},
{"beat_id":"C09_B068","speaker_id":"nimera","text":"Exactly.","cues":{}},
{"beat_id":"C09_B069","speaker_id":"nimera","text":"Wait.","cues":{"staging":"Nimera reaches across before Vaelira can close the notebook.","source_section":"C09_B005 — DON'T CLEAN THAT UP"}},
{"beat_id":"C09_B070","speaker_id":"nimera","text":"Why'd you cross that out?","cues":{"staging":"Vaelira lets her look. There is a calculation from the Annex. A clean corrected version beneath it. Nimera points at an earlier crossed-out assumption.","source_section":"C09_B005 — DON'T CLEAN THAT UP"}},
{"beat_id":"C09_B071","speaker_id":"vaelira","text":"Because it was wrong.","cues":{}},
{"beat_id":"C09_B072","speaker_id":"nimera","text":"I can see that.","cues":{}},
{"beat_id":"C09_B073","speaker_id":"vaelira","text":"Then why are you asking?","cues":{}},
{"beat_id":"C09_B074","speaker_id":"nimera","text":"Because that was the thing you thought before you knew it was wrong.","cues":{}},
{"beat_id":"C09_B075","speaker_id":"nimera","text":"That's useful.","cues":{"staging":"Vaelira looks at the page.","source_section":"C09_B005 — DON'T CLEAN THAT UP"}},
{"beat_id":"C09_B076","speaker_id":"vaelira","text":"I kept it.","cues":{}},
{"beat_id":"C09_B077","speaker_id":"nimera","text":"Barely.","cues":{}},
{"beat_id":"C09_B078","speaker_id":"vaelira","text":"How visible does a mistake need to be?","cues":{"staging":"The line is still visible.","source_section":"C09_B005 — DON'T CLEAN THAT UP"}},
{"beat_id":"C09_B079","speaker_id":"nimera","text":"Depends how much damage it can do twice.","cues":{}},
{"beat_id":"C09_B080","speaker_id":"vaelira","text":"Better?","cues":{"staging":"Vaelira glances at her. Nimera is looking at the page, not at Vaelira. No dramatic pause. No consolation. Vaelira uncrosses nothing. Instead, she writes a short note beside the old assumption.","source_section":"C09_B005 — DON'T CLEAN THAT UP"}},
{"beat_id":"C09_B081","speaker_id":"nimera","text":"“Initial boundary assumption.”","cues":{"staging":"Nimera leans over.","source_section":"C09_B005 — DON'T CLEAN THAT UP"}},
{"beat_id":"C09_B082","speaker_id":"nimera","text":"Boring.","cues":{"staging":"Beat.","source_section":"C09_B005 — DON'T CLEAN THAT UP"}},
{"beat_id":"C09_B083","speaker_id":"nimera","text":"But yes.","cues":{"staging":"Vaelira looks at her.","source_section":"C09_B005 — DON'T CLEAN THAT UP"}},
{"beat_id":"C09_B084","speaker_id":"vaelira","text":"Fine.","cues":{"staging":"Vaelira points at Nimera's papers.","source_section":"C09_B006 — YOUR TURN"}},
{"beat_id":"C09_B085","speaker_id":"nimera","text":"What?","cues":{}},
{"beat_id":"C09_B086","speaker_id":"vaelira","text":"My turn.","cues":{}},
{"beat_id":"C09_B087","speaker_id":"vaelira","text":"What's this?","cues":{"staging":"She pulls one of Nimera's pages closer.","source_section":"C09_B006 — YOUR TURN"}},
{"beat_id":"C09_B088","speaker_id":"nimera","text":"I don't know.","cues":{}},
{"beat_id":"C09_B089","speaker_id":"vaelira","text":"You wrote it.","cues":{}},
{"beat_id":"C09_B090","speaker_id":"nimera","text":"I know.","cues":{}},
{"beat_id":"C09_B091","speaker_id":"vaelira","text":"You don't know what your own notation means?","cues":{}},
{"beat_id":"C09_B092","speaker_id":"nimera","text":"I know what I was trying to mean.","cues":{}},
{"beat_id":"C09_B093","speaker_id":"vaelira","text":"That's worse.","cues":{}},
{"beat_id":"C09_B094","speaker_id":"nimera","text":"No, it isn't.","cues":{}},
{"beat_id":"C09_B095","speaker_id":"vaelira","text":"Nimera.","cues":{}},
{"beat_id":"C09_B096","speaker_id":"nimera","text":"Vaelira.","cues":{}},
{"beat_id":"C09_B097","speaker_id":"vaelira","text":"This one.","cues":{"staging":"Vaelira points at a small mark beside one diagram.","source_section":"C09_B006 — YOUR TURN"}},
{"beat_id":"C09_B098","speaker_id":"nimera","text":"That's “probably important.”","cues":{}},
{"beat_id":"C09_B099","speaker_id":"vaelira","text":"That's not notation.","cues":{"staging":"Vaelira stares.","source_section":"C09_B006 — YOUR TURN"}},
{"beat_id":"C09_B100","speaker_id":"nimera","text":"It is now.","cues":{}},
{"beat_id":"C09_B101","speaker_id":"vaelira","text":"What distinguishes it from “definitely important”?","cues":{}},
{"beat_id":"C09_B102","speaker_id":"vaelira","text":"That's just two of them.","cues":{"staging":"Nimera points to another symbol. Vaelira looks.","source_section":"C09_B006 — YOUR TURN"}},
{"beat_id":"C09_B103","speaker_id":"nimera","text":"Exactly.","cues":{}},
{"beat_id":"C09_B104","speaker_id":"vaelira","text":"I hate this.","cues":{"staging":"Vaelira puts the page down.","source_section":"C09_B006 — YOUR TURN"}},
{"beat_id":"C09_B105","speaker_id":"nimera","text":"You're learning.","cues":{}},
{"beat_id":"C09_B106","speaker_id":"vaelira","text":"Relative markers.","cues":{"staging":"They work quietly for a while. Not together exactly. At the same table. Every so often one reaches across to point at something on the other's page. Eventually Vaelira speaks.","source_section":"C09_B007 — A BETTER BAD NAME"}},
{"beat_id":"C09_B107","speaker_id":"nimera","text":"What?","cues":{"staging":"Nimera looks up.","source_section":"C09_B007 — A BETTER BAD NAME"}},
{"beat_id":"C09_B108","speaker_id":"vaelira","text":"Instead of relative positional syntax.","cues":{}},
{"beat_id":"C09_B109","speaker_id":"nimera","text":"Better.","cues":{"staging":"Nimera thinks.","source_section":"C09_B007 — A BETTER BAD NAME"}},
{"beat_id":"C09_B110","speaker_id":"nimera","text":"Still worse than relationship marks.","cues":{"staging":"Vaelira waits.","source_section":"C09_B007 — A BETTER BAD NAME"}},
{"beat_id":"C09_B111","speaker_id":"vaelira","text":"Why?","cues":{}},
{"beat_id":"C09_B112","speaker_id":"nimera","text":"Because we don't actually know what kind of relation they're marking.","cues":{}},
{"beat_id":"C09_B113","speaker_id":"vaelira","text":"Yes.","cues":{"staging":"Vaelira pauses. That lands.","source_section":"C09_B007 — A BETTER BAD NAME"}},
{"beat_id":"C09_B114","speaker_id":"nimera","text":"So until we do—","cues":{}},
{"beat_id":"C09_B115","speaker_id":"vaelira","text":"We shouldn't pretend we do.","cues":{}},
{"beat_id":"C09_B116","speaker_id":"nimera","text":"Look at you.","cues":{"staging":"Nimera smiles.","source_section":"C09_B007 — A BETTER BAD NAME"}},
{"beat_id":"C09_B117","speaker_id":"vaelira","text":"Don't.","cues":{"staging":"Vaelira points at her.","source_section":"C09_B007 — A BETTER BAD NAME"}},
{"beat_id":"C09_B118","speaker_id":"nimera","text":"Didn't say anything.","cues":{}},
{"beat_id":"C09_B119","speaker_id":"vaelira","text":"Your face did.","cues":{}},
{"beat_id":"C09_B120","speaker_id":"nimera","text":"Oh, that's staying.","cues":{"staging":"Nimera looks delighted.","source_section":"C09_B007 — A BETTER BAD NAME"}},
{"beat_id":"C09_B121","speaker_id":"vaelira","text":"What time is it?","cues":{"staging":"Another long stretch. Nimera yawns hard enough to stop pretending she isn't tired. Vaelira notices.","source_section":"C09_B008 — TWO FIFTY-SEVEN"}},
{"beat_id":"C09_B122","speaker_id":"nimera","text":"Two fifty-seven.","cues":{"staging":"Nimera looks toward the wall clock / local timepiece.","source_section":"C09_B008 — TWO FIFTY-SEVEN"}},
{"beat_id":"C09_B123","speaker_id":"vaelira","text":"We've been sitting here for nearly an hour?","cues":{"staging":"Vaelira freezes.","source_section":"C09_B008 — TWO FIFTY-SEVEN"}},
{"beat_id":"C09_B124","speaker_id":"nimera","text":"Longer.","cues":{}},
{"beat_id":"C09_B125","speaker_id":"vaelira","text":"Why didn't you say anything?","cues":{}},
{"beat_id":"C09_B126","speaker_id":"nimera","text":"About time passing?","cues":{}},
{"beat_id":"C09_B127","speaker_id":"vaelira","text":"Yes.","cues":{}},
{"beat_id":"C09_B128","speaker_id":"nimera","text":"I assumed you'd modeled it.","cues":{}},
{"beat_id":"C09_B129","speaker_id":"vaelira","text":"That wasn't even good.","cues":{"staging":"Vaelira looks at her. Nimera starts laughing before Vaelira can answer.","source_section":"C09_B008 — TWO FIFTY-SEVEN"}},
{"beat_id":"C09_B130","speaker_id":"nimera","text":"It's three in the fucking morning. Standards are down.","cues":{}},
{"beat_id":"C09_B131","speaker_id":"vaelira","text":"I'm going to bed.","cues":{"staging":"Vaelira closes her notebook.","source_section":"C09_B008 — TWO FIFTY-SEVEN"}},
{"beat_id":"C09_B132","speaker_id":"nimera","text":"Good.","cues":{}},
{"beat_id":"C09_B133","speaker_id":"vaelira","text":"Relationship marks is still bad.","cues":{"staging":"Vaelira stands. Takes two steps. Stops. Turns back.","source_section":"C09_B008 — TWO FIFTY-SEVEN"}},
{"beat_id":"C09_B134","speaker_id":"nimera","text":"Go to sleep.","cues":{}},
{"beat_id":"C09_B135","speaker_id":"vaelira","text":"It is.","cues":{}},
{"beat_id":"C09_B136","speaker_id":"nimera","text":"Good night, Vaelira.","cues":{}},
{"beat_id":"C09_B137","speaker_id":"vaelira","text":"Relative markers.","cues":{"staging":"Vaelira starts upstairs.","source_section":"C09_B008 — TWO FIFTY-SEVEN"}},
{"beat_id":"C09_B138","speaker_id":"nimera","text":"Fuck off.","cues":{}},
{"beat_id":"C09_B139","speaker_id":"vaelira","text":"More precise.","cues":{"staging":"From the stairs:","source_section":"C09_B008 — TWO FIFTY-SEVEN"}},
{"beat_id":"C09_B140","speaker_id":"vaelira","text":"Terrible accuracy.","cues":{"staging":"Nimera throws a crumpled scrap of paper toward her. It misses by several feet. Vaelira looks at where it lands. Then back at Nimera.","source_section":"C09_B008 — TWO FIFTY-SEVEN"}},
{"beat_id":"C09_B141","speaker_id":"nimera","text":"GO TO BED.","cues":{}},
{"beat_id":"C09_B142","speaker_id":"","text":"","cues":{"staging":"Vaelira disappears upstairs laughing. Nimera shakes her head, smiling despite herself. She looks at Vaelira's proposed term written in the margin of her notes. Nimera crosses it out. Underneath, she writes: **RELATIONSHIP MARKS** Then, after a second: **(PROVISIONAL)** She closes the papers. **END C09 — NIMERA AND VAELIRA AT 2 A.M.**","source_section":"C09_B008 — TWO FIFTY-SEVEN"}}
]
