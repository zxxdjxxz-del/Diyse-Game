[gd_resource type="Resource" script_class="DiyseDialogueSceneDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://game/dialogue/dialogue_scene_definition.gd" id="1_scene"]

[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "S011"
chapter_id = "chapter_01"
scene_kind = "mandatory"
location_id = "LOC_BRD_WAYFINDER_JUNCTION"
trigger_id = "trigger.chapter_01.s011"
completion_flag = "scene.s011.complete"
participants = Array[String](["torren", "maevra", "cyanis", "ilyra"])
authoring_notes = "Audit75 Resource conversion of the closed Chapter 1 Wayfinder Junction production dialogue. Spoken/staging wording is translated from the approved August 9, 2026 S007-S011 production source; only explicit later-canon terminology supersessions are applied. No story/dialogue rewrite, no player choices, and no proof portraits."
beats = [{"beat_id":"S011_B001","cues":{"staging":"Six broad route channels converge on Wayfinder Junction. The building looks utilitarian, not sacred. The entrance stands open. Torren stops."}},
{"beat_id":"S011_B002","speaker_id":"torren","text":"That was closed six months ago."},
{"beat_id":"S011_B003","cues":{"staging":"Maevra checks the door. Fresh pry marks. Black-red residue."}},
{"beat_id":"S011_B004","speaker_id":"maevra","text":"Host."},
{"beat_id":"S011_B005","cues":{"staging":"Cyanis looks inside."}},
{"beat_id":"S011_B006","speaker_id":"cyanis","text":"Then we're late again."},
{"beat_id":"S011_B007","cues":{"staging":"PLAYER CONTROL - OUTER JUNCTION. SAFE. Show wagon grooves, waiting alcoves, drainage, old road controls, later Yahtrean repairs built onto ancient infrastructure, six physical route approaches, and modern Black Host work. No encyclopedia text.","implementation_flags":["PLAYER_CONTROL"]}},
{"beat_id":"S011_B008","cues":{"staging":"Low, broad, practical architecture: benches, storage spaces, traffic channels, and six inactive panels around a central floor."}},
{"beat_id":"S011_B009","speaker_id":"cyanis","text":"Not what I expected."},
{"beat_id":"S011_B010","speaker_id":"torren","text":"What did you expect?"},
{"beat_id":"S011_B011","cues":{"staging":"Cyanis looks around."}},
{"beat_id":"S011_B012","speaker_id":"cyanis","text":"More teeth."},
{"beat_id":"S011_B013","cues":{"staging":"Ilyra looks at a low bench and an adjacent empty bay."}},
{"beat_id":"S011_B014","speaker_id":"ilyra","text":"Litters."},
{"beat_id":"S011_B015","cues":{"staging":"Maevra follows her gaze."}},
{"beat_id":"S011_B016","speaker_id":"maevra","text":"Waiting area."},
{"beat_id":"S011_B017","cues":{"staging":"Torren points to paired wagon grooves."}},
{"beat_id":"S011_B018","speaker_id":"torren","text":"Two-way traffic."},
{"beat_id":"S011_B019","cues":{"staging":"Cyanis looks at the room again."}},
{"beat_id":"S011_B020","speaker_id":"cyanis","text":"So people actually used this."},
{"beat_id":"S011_B021","cues":{"staging":"Nobody answers because the answer is visible."}},
{"beat_id":"S011_B022","cues":{"staging":"The central mechanism has been cut open. A crude Black Host interface is bolted into an ancient socket. Several removable components are gone."}},
{"beat_id":"S011_B023","speaker_id":"maevra","text":"They took whatever they could reuse."},
{"beat_id":"S011_B024","speaker_id":"cyanis","text":"Meaning they got something working."},
{"beat_id":"S011_B025","speaker_id":"maevra","text":"Probably."},
{"beat_id":"S011_B026","cues":{"staging":"Torren finds dried mud in a floor channel."}},
{"beat_id":"S011_B027","speaker_id":"torren","text":"Moved a load through here."},
{"beat_id":"S011_B028","cues":{"staging":"The missing Briar Passage braces were likely part of it. Nobody knows what the load was. The uncertainty stays unresolved."}},
{"beat_id":"S011_B029","cues":{"staging":"The party reconstructs enough of the already-disturbed interface to activate only the passive directory."}},
{"beat_id":"S011_B030","speaker_id":"maevra","text":"No route activation."},
{"beat_id":"S011_B031","speaker_id":"cyanis","text":"Agreed."},
{"beat_id":"S011_B032","speaker_id":"maevra","text":"If we can't turn it off, we don't turn it on."},
{"beat_id":"S011_B033","cues":{"staging":"Torren nods. Ilyra looks at Cyanis."}},
{"beat_id":"S011_B034","speaker_id":"ilyra","text":"And if the floor starts drawing lines toward you-"},
{"beat_id":"S011_B035","speaker_id":"cyanis","text":"We stop."},
{"beat_id":"S011_B036","cues":{"staging":"That is enough. The directory activates."}},
{"beat_id":"S011_B037","cues":{"staging":"Six classifications appear around the central ring. The Card interface responds automatically. IRON TESTAMENT files under MIGHT. RESTORATION files under GRACE. BASTION RESERVE files under RESOURCE. Three empty categories illuminate: ELEMENTS, CHANGE, RUIN. Silence for several seconds."}},
{"beat_id":"S011_B038","speaker_id":"cyanis","text":"Six."},
{"beat_id":"S011_B039","speaker_id":"ilyra","text":"Three we already had."},
{"beat_id":"S011_B040","cues":{"staging":"Maevra reads the categories."}},
{"beat_id":"S011_B041","speaker_id":"maevra","text":"Might. Elements. Grace. Resource. Change. Ruin."},
{"beat_id":"S011_B042","cues":{"staging":"Torren walks around the ring."}},
{"beat_id":"S011_B043","speaker_id":"torren","text":"No center."},
{"beat_id":"S011_B044","cues":{"staging":"Cyanis follows his meaning."}},
{"beat_id":"S011_B045","speaker_id":"cyanis","text":"No first one."},
{"beat_id":"S011_B046","speaker_id":"torren","text":"Doesn't look like it."},
{"beat_id":"S011_B047","cues":{"staging":"No speech about equality follows. The visual does the work."}},
{"beat_id":"S011_B048","cues":{"staging":"Resource receives the only expanded clarification because its meaning is least obvious. The display shows reserves, transfer lines, maintained structures, spare capacity, and protected stores."}},
{"beat_id":"S011_B049","speaker_id":"torren","text":"Not money."},
{"beat_id":"S011_B050","speaker_id":"maevra","text":"No."},
{"beat_id":"S011_B051","speaker_id":"torren","text":"Capacity."},
{"beat_id":"S011_B052","cues":{"staging":"He points."}},
{"beat_id":"S011_B053","speaker_id":"torren","text":"Stores. Transfer. Things kept working."},
{"beat_id":"S011_B054","speaker_id":"ilyra","text":"Resources."},
{"beat_id":"S011_B055","cues":{"staging":"Torren nods. That is enough."}},
{"beat_id":"S011_B056","cues":{"staging":"The Ruin display shows a damaged structure being deliberately destroyed before failure reaches neighboring systems."}},
{"beat_id":"S011_B057","speaker_id":"cyanis","text":"Ruin."},
{"beat_id":"S011_B058","speaker_id":"maevra","text":"Destruction isn't always indiscriminate."},
{"beat_id":"S011_B059","speaker_id":"ilyra","text":"No."},
{"beat_id":"S011_B060","cues":{"staging":"The display changes before anyone explains further. No severance terminology is introduced here."}},
{"beat_id":"S011_B061","cues":{"staging":"Cyanis compares a copied record from the sealed Card's earlier response to the Face ring. Part of the geometry resembles Might, but not exactly."}},
{"beat_id":"S011_B062","speaker_id":"ilyra","text":"Might?"},
{"beat_id":"S011_B063","speaker_id":"torren","text":"Similar."},
{"beat_id":"S011_B064","speaker_id":"maevra","text":"Not enough."},
{"beat_id":"S011_B065","cues":{"staging":"Cyanis studies it."}},
{"beat_id":"S011_B066","speaker_id":"cyanis","text":"No."},
{"beat_id":"S011_B067","cues":{"staging":"He puts the copy away."}},
{"beat_id":"S011_B068","speaker_id":"cyanis","text":"Still sealed."},
{"beat_id":"S011_B069","speaker_id":"maevra","text":"Yes."},
{"beat_id":"S011_B070","cues":{"staging":"No debate. The recovered Card's exact identity remains unidentified."}},
{"beat_id":"S011_B071","speaker_id":"torren","text":"What exactly is sealed?"},
{"beat_id":"S011_B072","cues":{"staging":"Cyanis looks at Maevra. She allows the answer."}},
{"beat_id":"S011_B073","speaker_id":"cyanis","text":"A Card recovered from the convoy."},
{"beat_id":"S011_B074","cues":{"staging":"Torren thinks."}},
{"beat_id":"S011_B075","speaker_id":"torren","text":"The one everybody's talking about."},
{"beat_id":"S011_B076","speaker_id":"cyanis","text":"Everybody?"},
{"beat_id":"S011_B077","speaker_id":"torren","text":"Greenhollow."},
{"beat_id":"S011_B078","cues":{"staging":"That is explanation enough."}},
{"beat_id":"S011_B079","cues":{"staging":"The Face ring fades. A physical network map appears. Most links are broken. Torren identifies only geography he genuinely knows."}},
{"beat_id":"S011_B080","speaker_id":"torren","text":"Hollow Watch."},
{"beat_id":"S011_B081","cues":{"staging":"Another branch."}},
{"beat_id":"S011_B082","speaker_id":"torren","text":"Greenhollow."},
{"beat_id":"S011_B083","cues":{"staging":"Farther southeast:"}},
{"beat_id":"S011_B084","speaker_id":"torren","text":"River country."},
{"beat_id":"S011_B085","speaker_id":"maevra","text":"Dunmere?"},
{"beat_id":"S011_B086","cues":{"staging":"Torren compares it to his map."}},
{"beat_id":"S011_B087","speaker_id":"torren","text":"Could be."},
{"beat_id":"S011_B088","cues":{"staging":"Maevra accepts could. No callback joke."}},
{"beat_id":"S011_B089","cues":{"staging":"A modern Black Host overlay marks Hollow Watch, Briar Passage, and the southeastern water route. Maevra recognizes the notation."}},
{"beat_id":"S011_B090","speaker_id":"maevra","text":"Transfer code."},
{"beat_id":"S011_B091","speaker_id":"cyanis","text":"Personnel?"},
{"beat_id":"S011_B092","speaker_id":"maevra","text":"Personnel. Equipment. Anything moving through multiple stations."},
{"beat_id":"S011_B093","cues":{"staging":"Torren looks at the southeastern line."}},
{"beat_id":"S011_B094","speaker_id":"torren","text":"Dunmere's the first major settlement that way."},
{"beat_id":"S011_B095","cues":{"staging":"Ilyra's attention sharpens."}},
{"beat_id":"S011_B096","speaker_id":"ilyra","text":"How many people use those water routes?"},
{"beat_id":"S011_B097","speaker_id":"torren","text":"A lot."},
{"beat_id":"S011_B098","cues":{"staging":"Cyanis looks at the route."}},
{"beat_id":"S011_B099","speaker_id":"cyanis","text":"Then we go there."},
{"beat_id":"S011_B100","speaker_id":"maevra","text":"After Brackenwall."},
{"beat_id":"S011_B101","cues":{"staging":"Cyanis nods. This time, no joke."}},
{"beat_id":"S011_B102","cues":{"staging":"PLAYER CONTROL - SAFE DOCUMENTATION POCKET. Optional inspection points: Face ring, evacuation relief, broken route, Black Host bypass, Dunmere branch, and surface geography comparison. Contextual lines remain sparse.","implementation_flags":["PLAYER_CONTROL"]}},
{"beat_id":"S011_B103","speaker_id":"torren","text":"Used to go somewhere."},
{"beat_id":"S011_B104","cues":{"staging":"At a destroyed route, Ilyra looks at worn civilian traffic marks."}},
{"beat_id":"S011_B105","speaker_id":"ilyra","text":"People too."},
{"beat_id":"S011_B106","cues":{"staging":"UI HANDOFF: CARD FACE CLASSIFICATION UNLOCKED. Cards are organized into Might, Elements, Grace, Resource, Change, and Ruin. Owned Cards file automatically. Empty Faces remain visible. No additional Card-identity explanation and no new Card award.","implementation_flags":["UI_HANDOFF"]}},
{"beat_id":"S011_B107","cues":{"staging":"Late-afternoon light. No random encounter. No immediate alarm. The four stand above the roads. Maevra secures the copied records."}},
{"beat_id":"S011_B108","speaker_id":"maevra","text":"Brackenwall. Report. Rest."},
{"beat_id":"S011_B109","cues":{"staging":"Then:"}},
{"beat_id":"S011_B110","speaker_id":"maevra","text":"Dunmere."},
{"beat_id":"S011_B111","cues":{"staging":"Ilyra nods. Torren looks east. Cyanis looks at the three of them."}},
{"beat_id":"S011_B112","speaker_id":"cyanis","text":"Yesterday was simpler."},
{"beat_id":"S011_B113","cues":{"staging":"Torren shrugs."}},
{"beat_id":"S011_B114","speaker_id":"torren","text":"Yesterday's over."},
{"beat_id":"S011_B115","cues":{"staging":"A beat. Cyanis nods. No joke. They start walking. After several steps:"}},
{"beat_id":"S011_B116","speaker_id":"cyanis","text":"Harth."},
{"beat_id":"S011_B117","cues":{"staging":"Torren looks over."}},
{"beat_id":"S011_B118","speaker_id":"cyanis","text":"Still heading east?"},
{"beat_id":"S011_B119","cues":{"staging":"Torren looks toward Dunmere."}},
{"beat_id":"S011_B120","speaker_id":"torren","text":"Looks that way."},
{"beat_id":"S011_B121","cues":{"staging":"Cyanis smiles slightly. They keep walking."}},
{"beat_id":"S011_B122","cues":{"staging":"CHAPTER HANDOFF: Chapter 1 complete. C03, C04, and C05 Character-Life scenes become available after S011. Dunmere becomes the next main-story destination. Maevra remains temporary only. The recovered Card's exact identity remains unidentified.","implementation_flags":["CHAPTER_HANDOFF"]}}]
