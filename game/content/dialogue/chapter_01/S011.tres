{"beat_id": "S011_B100", "speaker_id": "maevra", "text": "And the Host followed it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — WHAT THEY ACTUALLY KNOW", "staging": "Maevra adds:"}},
{"beat_id": "S011_B101", "speaker_id": "cyanis", "text": "That's enough.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — WHAT THEY ACTUALLY KNOW", "staging": "Cyanis:"}},
{"beat_id": "S011_B102", "speaker_id": "torren", "text": "For what?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — WHAT THEY ACTUALLY KNOW", "staging": "Torren:"}},
