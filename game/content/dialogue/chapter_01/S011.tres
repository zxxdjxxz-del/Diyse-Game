{"beat_id": "S011_B104", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — WHAT THEY ACTUALLY KNOW", "staging": "Torren considers it."}},
