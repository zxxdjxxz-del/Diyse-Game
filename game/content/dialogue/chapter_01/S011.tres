[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "S011"
chapter_id = "chapter_01"
scene_kind = "mandatory"
location_id = "LOC_WAYFINDER_JUNCTION"
trigger_id = "trigger.chapter_01.s011"
completion_flag = "scene.s011.complete"
participants = Array[String](["torren", "cyanis", "maevra", "ilyra"])
authoring_notes = "Chapter 1 exact Resource conversion from docs/chapters/dialogue/chapter_01/S011.md under Complete Master Canon v1.64 / Audit79. Spoken text is line-complete and must not be rewritten. Source production/staging prose is preserved in beat cue metadata; source subsection names are carried in cues.source_section. Portrait slots remain empty until approved registry expressions/assets are wired. Spoken-sequence SHA-256: 5c65981298da493e494ffed874f5cb96aaf1447ff36382fd31bff46a00b61d04."
beats = [
{"beat_id": "S011_B001", "speaker_id": "torren", "text": "There.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — THE CROSSROADS", "staging": "The party comes out of Briar Passage.\n\nThe forest opens.\n\nAhead is a huge weathered crossroads partly swallowed by the landscape.\n\nThere is no building.\n\nSeveral Ancient Diysean roads once converged here.\n\nSome survive as recognizable stretches of stone.\n\nOthers disappear beneath trees, later roads, collapsed slopes, or ground that has shifted enough that following them visually becomes impossible.\n\nModern Yahtrean paths cut across the old routes without respecting them.\n\nAt the center sits the Wayfinder.\n\nA broad stone-and-metal cartographic monument built low into the crossroads itself.\n\nLarge enough that the party has to walk around it.\n\nRoots cover sections.\n\nEarth fills others.\n\nOne side has been recently uncovered.\n\nBlack Host tools and scraps remain nearby.\n\nTorren stops."}},
{"beat_id": "S011_B002", "speaker_id": "cyanis", "text": "That's the Wayfinder?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — THE CROSSROADS", "staging": "Cyanis looks at the structure."}},
{"beat_id": "S011_B003", "speaker_id": "torren", "text": "I'd assume so.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — THE CROSSROADS", "staging": "Torren studies it."}},
{"beat_id": "S011_B004", "speaker_id": "maevra", "text": "They did too.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — THE CROSSROADS", "staging": "Maevra looks at the disturbed earth."}},
{"beat_id": "S011_B005", "speaker_id": "maevra", "text": "Spread out.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — THE CROSSROADS", "staging": "Fresh pry marks.\n\nCharcoal.\n\nWax scraps.\n\nBlack-red residue.\n\nBut no Black Host troops remain."}},
{"beat_id": "S011_B006", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "**SAFE AREA.**\n\nNo random encounters.\n\nNo boss.\n\nNo hidden final fight.\n\nOne primary exterior environment serves the entire scene.\n\nThe player can inspect:\n\n**• the Wayfinder;**\n\n**• surviving Ancient road sections;**\n\n**• a collapsed route;**\n\n**• a modern road crossing an Ancient one;**\n\n**• Black Host excavation;**\n\n**• high ground overlooking the surrounding terrain.**\n\nMost inspections are environmental.\n\nThe party does not comment on everything.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING", "RETURN_PLAYER_CONTROL"], "source_section": "PLAYER CONTROL — WAYFINDER JUNCTION"}},
{"beat_id": "S011_B007", "speaker_id": "cyanis", "text": "Where'd it go?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — A ROAD TO NOWHERE", "staging": "Torren follows one of the Ancient roads away from the Wayfinder.\n\nAfter a short distance it vanishes beneath forest and earth.\n\nCyanis follows."}},
{"beat_id": "S011_B008", "speaker_id": "torren", "text": "Under there.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — A ROAD TO NOWHERE"}},
{"beat_id": "S011_B009", "speaker_id": "cyanis", "text": "I mean where was it going?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — A ROAD TO NOWHERE"}},
{"beat_id": "S011_B010", "speaker_id": "torren", "text": "Don't know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — A ROAD TO NOWHERE", "staging": "Torren looks across the modern terrain."}},
{"beat_id": "S011_B011", "speaker_id": "cyanis", "text": "That's a lot of road to nowhere.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — A ROAD TO NOWHERE", "staging": "Cyanis looks at the substantial road beneath their feet."}},
{"beat_id": "S011_B012", "speaker_id": "torren", "text": "It didn't go nowhere when they built it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — A ROAD TO NOWHERE"}},
{"beat_id": "S011_B013", "speaker_id": "ilyra", "text": "The ground changed this much?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — A ROAD TO NOWHERE", "staging": "Ilyra is examining another stretch where a modern embankment covers most of the Ancient stone."}},
{"beat_id": "S011_B014", "speaker_id": "torren", "text": "Ground. Rivers. Roads. People.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — A ROAD TO NOWHERE"}},
{"beat_id": "S011_B015", "speaker_id": "torren", "text": "Long enough, everything moves.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — A ROAD TO NOWHERE", "staging": "He looks back toward the Wayfinder."}},
{"beat_id": "S011_B016", "speaker_id": "maevra", "text": "Except apparently that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — A ROAD TO NOWHERE", "staging": "Maevra:", "staging_after": "They return to the map."}},
{"beat_id": "S011_B017", "speaker_id": "torren", "text": "That's the river.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — READING THE LAND", "staging": "They clear only enough growth to expose useful sections.\n\nNo excavation montage.\n\nA few simple before/after environment states.\n\nThe Wayfinder is not a modern overhead map.\n\nIts representation is strange but deliberate:\n\nridge shapes,\n\nwatercourses,\n\nroute lines,\n\njunction marks,\n\nsmaller service branches,\n\nterrain notation,\n\nand repeated familiar symbols.\n\nTorren studies it.\n\nLong enough that nobody interrupts him.\n\nThen:"}},
{"beat_id": "S011_B018", "speaker_id": "cyanis", "text": "Which one?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — READING THE LAND", "staging": "Cyanis leans over."}},
{"beat_id": "S011_B019", "speaker_id": "torren", "text": "Ours.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — READING THE LAND", "staging": "Torren points toward the actual landscape."}},
{"beat_id": "S011_B020", "speaker_id": "cyanis", "text": "Oh.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — READING THE LAND", "staging": "Cyanis looks from the river in the distance back to the Wayfinder."}},
{"beat_id": "S011_B021", "speaker_id": "ilyra", "text": "Then this is the ridge.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — READING THE LAND", "staging": "Ilyra crouches on the opposite side."}},
{"beat_id": "S011_B022", "speaker_id": "torren", "text": "Probably.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — READING THE LAND", "staging": "Torren walks around.\n\nLooks."}},
{"beat_id": "S011_B023", "speaker_id": "ilyra", "text": "Probably?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — READING THE LAND"}},
{"beat_id": "S011_B024", "speaker_id": "torren", "text": "It's old.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — READING THE LAND"}},
{"beat_id": "S011_B025", "speaker_id": "maevra", "text": "How old?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — READING THE LAND", "staging": "Maevra:"}},
{"beat_id": "S011_B026", "speaker_id": "torren", "text": "Old enough that the river's in the wrong fucking place.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — READING THE LAND", "staging": "Torren gives her a look.", "staging_after": "Maevra looks toward the real river.\n\nFair enough."}},
{"beat_id": "S011_B027", "speaker_id": "maevra", "text": "I had it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH", "staging": "Maevra removes the rubbing recovered from Hollow Watch.\n\nPlaces it beside one exposed section of the Wayfinder.\n\nShe shifts it once.\n\nTwice.\n\nTorren reaches over.\n\nTurns it."}},
{"beat_id": "S011_B028", "speaker_id": "torren", "text": "You had it upside down.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH"}},
{"beat_id": "S011_B029", "speaker_id": "maevra", "text": "I did not.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH"}},
{"beat_id": "S011_B030", "speaker_id": "torren", "text": "River.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH", "staging": "Torren points."}},
{"beat_id": "S011_B031", "speaker_id": "maevra", "text": "Fine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH", "staging": "Maevra looks.\n\nBeat."}},
{"beat_id": "S011_B032", "speaker_id": "torren", "text": "That's Greenhollow.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH", "staging": "Cyanis wisely says nothing.\n\nPart of the Hollow Watch route geometry now continues cleanly into the Wayfinder.\n\nTorren traces it."}},
{"beat_id": "S011_B033", "speaker_id": "torren", "text": "Then this should be river country.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH", "staging": "He continues southeast.\n\nStops.\n\nLooks toward the real landscape."}},
{"beat_id": "S011_B034", "speaker_id": "ilyra", "text": "Dunmere?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH", "staging": "Ilyra:"}},
{"beat_id": "S011_B035", "speaker_id": "torren", "text": "Could be.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH", "staging": "Torren takes his time."}},
{"beat_id": "S011_B036", "speaker_id": "maevra", "text": "They believed it was worth following.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH", "staging": "Maevra follows Black Host charcoal laid over the same ancient route."}},
{"beat_id": "S011_B037", "speaker_id": "cyanis", "text": "Good enough for me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH"}},
{"beat_id": "S011_B038", "speaker_id": "cyanis", "text": "I said for me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH", "staging": "Torren looks at him."}},
{"beat_id": "S011_B039", "speaker_id": "torren", "text": "Better.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH"}},
{"beat_id": "S011_B040", "speaker_id": "ilyra", "text": "Grace.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE FACES", "staging": "Ilyra notices a familiar mark near one of the route clusters."}},
{"beat_id": "S011_B041", "speaker_id": "cyanis", "text": "Might.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE FACES", "staging": "Nobody reacts to the name.\n\nThey all know it.\n\nCyanis finds another."}},
{"beat_id": "S011_B042", "speaker_id": "torren", "text": "Resource here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE FACES", "staging": "Torren circles around."}},
{"beat_id": "S011_B043", "speaker_id": "maevra", "text": "Ruin.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE FACES", "staging": "Maevra:"}},
{"beat_id": "S011_B044", "speaker_id": "cyanis", "text": "Why are Faces on a route map?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE FACES", "staging": "The other familiar Face symbols appear elsewhere across the surviving map:\n\nElements. Change.\n\nNothing about the six Faces themselves is a discovery.\n\nWhat is strange is their placement.\n\nGrace appears beside several entirely different geographical features.\n\nResource appears around route branches that do not obviously have anything in common.\n\nRuin appears more than once.\n\nMight is not simply “the Might road.”\n\nCyanis looks around the map."}},
{"beat_id": "S011_B045", "speaker_id": "torren", "text": "Don't know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE FACES", "staging": "Torren looks at the surrounding notation."}},
{"beat_id": "S011_B046", "speaker_id": "ilyra", "text": "They're labeling something.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE FACES", "staging": "Ilyra points between two Grace markings."}},
{"beat_id": "S011_B047", "speaker_id": "maevra", "text": "Or instructions.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE FACES", "staging": "Maevra:"}},
{"beat_id": "S011_B048", "speaker_id": "torren", "text": "Could be either.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE FACES", "staging": "Torren studies one cluster.", "staging_after": "They leave it unresolved.\n\nThe new information is not what the Faces are.\n\nIt is that Ancient Diyseans apparently used the familiar six-Face system in a technical cartographic language the modern party does not understand."}},
{"beat_id": "S011_B049", "speaker_id": "cyanis", "text": "Same Face.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — CYANIS'S CARD", "staging": "Cyanis takes out the sealed Card.\n\nIts Might association is already recognizable.\n\nThat is not news.\n\nHe compares its geometry with the Might notation on the Wayfinder."}},
{"beat_id": "S011_B050", "speaker_id": "ilyra", "text": "Not the same pattern.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — CYANIS'S CARD", "staging": "Ilyra looks closer."}},
{"beat_id": "S011_B051", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — CYANIS'S CARD", "staging": "Torren studies both."}},
{"beat_id": "S011_B052", "speaker_id": "maevra", "text": "But related.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — CYANIS'S CARD", "staging": "Maevra:"}},
{"beat_id": "S011_B053", "speaker_id": "cyanis", "text": "Helpful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — CYANIS'S CARD", "staging": "Cyanis looks at the Card."}},
{"beat_id": "S011_B054", "speaker_id": "torren", "text": "You wanted answers?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — CYANIS'S CARD"}},
{"beat_id": "S011_B055", "speaker_id": "cyanis", "text": "Would've been nice.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — CYANIS'S CARD", "staging_after": "He puts it away.\n\nNo magical reaction.\n\nNo Prime identification.\n\nNo Last Sentinel.\n\nNo implication that they have just learned Cyanis belongs to Might.\n\nThey already understand what Might is.\n\nThey do not understand what this particular Ancient relationship means."}},
{"beat_id": "S011_B056", "speaker_id": "ilyra", "text": "This keeps showing up near water.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — WATER", "staging": "Ilyra finds another repeated piece of notation near several waterways.\n\nUnlike the Face marks, this one is unfamiliar."}},
{"beat_id": "S011_B057", "speaker_id": "torren", "text": "Could be storage.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — WATER", "staging": "Torren comes over.\n\nLooks.\n\nAnother occurrence.\n\nThen another."}},
{"beat_id": "S011_B058", "speaker_id": "ilyra", "text": "Or control.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — WATER"}},
{"beat_id": "S011_B059", "speaker_id": "torren", "text": "Could be.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — WATER", "staging": "Torren:"}},
{"beat_id": "S011_B060", "speaker_id": "maevra", "text": "Their movement continues through the same country.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — WATER", "staging": "Maevra studies the Black Host marks on the southeast route."}},
{"beat_id": "S011_B061", "speaker_id": "ilyra", "text": "Toward Dunmere.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — WATER", "staging": "Ilyra looks at the water notation again."}},
{"beat_id": "S011_B062", "speaker_id": "cyanis", "text": "That's enough coincidence for me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — WATER"}},
{"beat_id": "S011_B063", "speaker_id": "torren", "text": "Coincidence doesn't have a quota.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — WATER"}},
{"beat_id": "S011_B064", "speaker_id": "cyanis", "text": "You know what I mean.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — WATER", "staging": "Cyanis looks at him."}},
{"beat_id": "S011_B065", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — WATER"}},
{"beat_id": "S011_B066", "speaker_id": "torren", "text": "Wait.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — THE OLD CUT", "staging": "Torren follows one smaller branch away from the primary southeast line.\n\nStops.\n\nBacktracks.\n\nLooks from the Wayfinder toward the modern landscape."}},
{"beat_id": "S011_B067", "speaker_id": "maevra", "text": "What?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — THE OLD CUT", "staging": "Maevra comes over."}},
{"beat_id": "S011_B068", "speaker_id": "torren", "text": "This road isn't there anymore.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — THE OLD CUT", "staging": "Torren points to the old branch."}},
{"beat_id": "S011_B069", "speaker_id": "cyanis", "text": "We established that happens.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — THE OLD CUT"}},
{"beat_id": "S011_B070", "speaker_id": "torren", "text": "No. I know this ground.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — THE OLD CUT"}},
{"beat_id": "S011_B071", "speaker_id": "torren", "text": "Modern road moved west.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — THE OLD CUT", "staging": "He traces the branch."}},
{"beat_id": "S011_B072", "speaker_id": "ilyra", "text": "And that?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — THE OLD CUT", "staging": "Ilyra points at the water notation beside the old cut."}},
{"beat_id": "S011_B073", "speaker_id": "torren", "text": "Cistern, maybe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — THE OLD CUT", "staging": "Torren looks."}},
{"beat_id": "S011_B074", "speaker_id": "maevra", "text": "Can you find the old entrance?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — THE OLD CUT", "staging": "Maevra:"}},
{"beat_id": "S011_B075", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — THE OLD CUT", "staging": "Torren looks toward the present-day road.\n\nThinks."}},
{"beat_id": "S011_B076", "speaker_id": "torren", "text": "Now.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — THE OLD CUT", "staging": "Beat.", "staging_after": "That is the entire Hunt setup.\n\nNo monster.\n\nNo roar.\n\nNo Hunt name spoken by the party."}},
{"beat_id": "S011_B077", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "Hunt #1 — Cistern Devourer becomes accessible.\n\nWhat changed is knowledge.\n\nThe old route has always physically existed.\n\nThe party now knows where to find it from the modern Dunmere road.\n\nImplementation remains cheap:\n\nmodern Dunmere road\n\n→ overgrown old cut\n\n→ short cistern approach\n\n→ Hunt arena.\n\nOptional.\n\nReturnable.\n\nNo replay of Chapter 1 required.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "WORLD-STATE CHANGE"}},
{"beat_id": "S011_B078", "speaker_id": "cyanis", "text": "What?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — THE BROKEN EDGE", "staging": "Torren continues around the Wayfinder.\n\nOne edge is badly damaged.\n\nSeveral mapped features simply terminate at the break.\n\nNot because the depicted routes ended there.\n\nBecause the physical map itself is incomplete.\n\nTorren crouches.\n\nRuns a finger along one broken route line.\n\nCyanis:"}},
{"beat_id": "S011_B079", "speaker_id": "torren", "text": "Nothing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — THE BROKEN EDGE"}},
{"beat_id": "S011_B080", "speaker_id": "torren", "text": "No. Something.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — THE BROKEN EDGE", "staging": "Cyanis waits.\n\nTorren looks again."}},
{"beat_id": "S011_B081", "speaker_id": "torren", "text": "Line keeps going.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — THE BROKEN EDGE", "staging": "He points."}},
{"beat_id": "S011_B082", "speaker_id": "cyanis", "text": "Into what?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — THE BROKEN EDGE"}},
{"beat_id": "S011_B083", "speaker_id": "torren", "text": "That'd be the problem.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — THE BROKEN EDGE", "staging": "Torren taps the missing section."}},
{"beat_id": "S011_B084", "speaker_id": "ilyra", "text": "Part of the Wayfinder is missing?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — THE BROKEN EDGE", "staging": "Ilyra comes over."}},
{"beat_id": "S011_B085", "speaker_id": "torren", "text": "Or this was only part of it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — THE BROKEN EDGE"}},
{"beat_id": "S011_B086", "speaker_id": "maevra", "text": "Can you tell which?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — THE BROKEN EDGE", "staging": "Maevra looks at the broken edge."}},
{"beat_id": "S011_B087", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — THE BROKEN EDGE", "staging_after": "That's where the mystery stays.\n\nNobody suggests another map exists.\n\nNobody predicts Chapter 3.\n\nNobody says they need to find the other pieces."}},
{"beat_id": "S011_B088", "speaker_id": "maevra", "text": "We document this before we leave.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — COPY IT", "staging": "Maevra looks at the exposed map."}},
{"beat_id": "S011_B089", "speaker_id": "maevra", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — COPY IT", "staging": "Torren is already getting paper out.\n\nMaevra notices."}},
{"beat_id": "S011_B090", "speaker_id": "torren", "text": "Don't sound surprised.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — COPY IT", "staging": "Torren looks at her."}},
{"beat_id": "S011_B091", "speaker_id": "maevra", "text": "I wasn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — COPY IT"}},
{"beat_id": "S011_B092", "speaker_id": "torren", "text": "Sounded surprised.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — COPY IT"}},
{"beat_id": "S011_B093", "speaker_id": "maevra", "text": "Harth.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — COPY IT"}},
{"beat_id": "S011_B094", "speaker_id": "torren", "text": "Solmar.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — COPY IT", "staging_after": "Cyanis looks at Ilyra.\n\nIlyra very slightly shakes her head.\n\nDo not engage.\n\nCyanis doesn't.\n\n**CHEAP 2.5D**\n\nNo rubbing/drawing montage.\n\nShort fade forward.\n\nThey produce several practical copies:\n\n**• the recognizable geography;**\n\n**• the southeast route;**\n\n**• sections containing the Face notation;**\n\n**• the broken outer edge;**\n\n**• the old water/cistern branch.**\n\nThese physical copies persist.\n\nThat matters later."}},
{"beat_id": "S011_B095", "speaker_id": "maevra", "text": "What do we have?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — WHAT THEY ACTUALLY KNOW", "staging": "The four regroup around the copied material.\n\nMaevra keeps it practical."}},
{"beat_id": "S011_B096", "speaker_id": "torren", "text": "Hollow Watch connects here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — WHAT THEY ACTUALLY KNOW", "staging": "Torren points."}},
{"beat_id": "S011_B097", "speaker_id": "torren", "text": "Greenhollow fits here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — WHAT THEY ACTUALLY KNOW", "staging": "Another."}},
{"beat_id": "S011_B098", "speaker_id": "torren", "text": "This heads into the right country for Dunmere.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — WHAT THEY ACTUALLY KNOW", "staging": "Then southeast."}},
