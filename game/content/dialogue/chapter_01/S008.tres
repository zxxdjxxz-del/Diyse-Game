participants = Array[String](["maevra", "cyanis", "ilyra"])
authoring_notes = "Chapter 1 exact Resource conversion from docs/chapters/dialogue/chapter_01/S008.md under Complete Master Canon v1.64 / Audit79. Spoken text is line-complete and must not be rewritten. Source production/staging prose is preserved in beat cue metadata; source subsection names are carried in cues.source_section. Portrait slots remain empty until approved registry expressions/assets are wired. Spoken-sequence SHA-256: 78b0d305eaef92d8a2e33b750cc84d140d4e8c7f447847721aa7f60e94a318f2."
beats = [
{"beat_id": "S008_B001", "speaker_id": "maevra", "text": "Recent.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — HOLLOW WATCH", "staging": "The party reaches the service entrance.\n\nHollow Watch is larger up close.\n\nA later Yahtrean watchtower has been built over much older stonework. Roots run through collapsed retaining walls.\n\nThe service gate hangs open.\n\nA chain has been cut.\n\nMaevra crouches beside it."}},
{"beat_id": "S008_B002", "speaker_id": "cyanis", "text": "Tracks coming out?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — HOLLOW WATCH", "staging": "Cyanis looks at the mud."}},
{"beat_id": "S008_B003", "speaker_id": "maevra", "text": "Some.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — HOLLOW WATCH", "staging": "Maevra follows them with her eyes."}},
{"beat_id": "S008_B004", "speaker_id": "cyanis", "text": "Walking?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — HOLLOW WATCH"}},
{"beat_id": "S008_B005", "speaker_id": "maevra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — HOLLOW WATCH", "staging": "She points to a dropped tool and a long drag through the mud."}},
{"beat_id": "S008_B006", "speaker_id": "ilyra", "text": "Not much blood.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — HOLLOW WATCH", "staging": "Ilyra checks a blood mark beside the entrance."}},
{"beat_id": "S008_B007", "speaker_id": "cyanis", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — HOLLOW WATCH"}},
{"beat_id": "S008_B008", "speaker_id": "ilyra", "text": "Not the same as safe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — HOLLOW WATCH", "staging": "Ilyra stands."}},
{"beat_id": "S008_B009", "speaker_id": "cyanis", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — HOLLOW WATCH", "staging": "Cyanis draws his sword."}},
{"beat_id": "S008_B010", "speaker_id": "maevra", "text": "Let's go.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — HOLLOW WATCH", "staging": "Maevra looks through the open gate.", "staging_after": "Control returns."}},
{"beat_id": "S008_B011", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "A moderate random-battle area, not a hallway and not a huge dungeon floor.\n\nExpected first-pass pressure: roughly 2–3 random encounters, depending on encounter rolls and side exploration.\n\nCheap 2.5D:\n\n**• one outer-watch environment kit;**\n\n**• broken tower rooms;**\n\n**• short exterior wall section;**\n\n**• one lower stair;**\n\n**• one small optional dead end;**\n\n**• changed doors, rubble and lighting rather than bespoke rooms.**\n\nThe player gets enough uninterrupted space to actually use the Cyanis / Ilyra / Maevra party.\n\nHollow Watch Sentries establish the construct ecology.\n\nNo long tutorial.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "EXPLORATION 1 — OUTER WATCH"}},
{"beat_id": "S008_B012", "speaker_id": "ilyra", "text": "It signaled.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "SHORT POST-BATTLE BEAT", "staging": "After an early encounter, one disabled Sentry remains partially active.\n\nIt reaches toward a recess in the wall.\n\nA small light flashes.\n\nThen the construct goes still.\n\nIlyra notices."}},
{"beat_id": "S008_B013", "speaker_id": "maevra", "text": "Assume it worked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "SHORT POST-BATTLE BEAT", "staging": "Maevra looks at the recess."}},
{"beat_id": "S008_B014", "speaker_id": "cyanis", "text": "Great.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "SHORT POST-BATTLE BEAT", "staging": "Cyanis looks farther into the Watch."}},
{"beat_id": "S008_B015", "speaker_id": "maevra", "text": "Move.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "SHORT POST-BATTLE BEAT", "staging_after": "Control returns immediately."}},
{"beat_id": "S008_B016", "speaker_id": "cyanis", "text": "Think it still works?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — LOWER ACCESS", "staging": "The main route reaches a broken interior span.\n\nA later Yahtrean control lever has been bolted onto much older green-gold machinery beneath it.\n\nNo one gives a history lesson.\n\nCyanis looks at the lever.\n\nThen at the gap."}},
{"beat_id": "S008_B017", "speaker_id": "maevra", "text": "Try it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — LOWER ACCESS", "staging": "Maevra looks at the machinery."}},
{"beat_id": "S008_B018", "speaker_id": "ilyra", "text": "That looks familiar.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — LOWER ACCESS", "staging": "Cyanis pulls it.\n\nThe bridge shifts into place.\n\nSimple environment-state swap.\n\nSomething much older beneath the floor lights briefly.\n\nIlyra watches it."}},
{"beat_id": "S008_B019", "speaker_id": "cyanis", "text": "Close.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — LOWER ACCESS", "staging": "Cyanis looks down."}},
{"beat_id": "S008_B020", "speaker_id": "maevra", "text": "Keep moving.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — LOWER ACCESS", "staging": "Maevra is already crossing.", "staging_after": "No lore conversation."}},
{"beat_id": "S008_B021", "speaker_id": "maevra", "text": "They weren't defending the tower.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — BLACK HOST WORKSITE", "staging": "A small safe investigation pocket.\n\nNo random encounter inside.\n\nCheap props:\n\nbroken digging tools,\n\ncharcoal,\n\nwax sheets,\n\none cracked pry bar,\n\nsections of wall that have been deliberately scrubbed clean.\n\nMaevra picks up the pry bar."}},
{"beat_id": "S008_B022", "speaker_id": "cyanis", "text": "Searching.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — BLACK HOST WORKSITE", "staging": "Cyanis looks at the exposed wall."}},
{"beat_id": "S008_B023", "speaker_id": "ilyra", "text": "And something interrupted them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — BLACK HOST WORKSITE", "staging": "Ilyra finds blood on a discarded cloth."}},
{"beat_id": "S008_B024", "speaker_id": "cyanis", "text": "Writing?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — BLACK HOST WORKSITE", "staging": "Cyanis looks at branching grooves in the stone."}},
{"beat_id": "S008_B025", "speaker_id": "maevra", "text": "Maybe not.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — BLACK HOST WORKSITE", "staging": "Maevra compares one of the wax rubbings to the wall."}},
{"beat_id": "S008_B026", "speaker_id": "cyanis", "text": "Routes?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — BLACK HOST WORKSITE", "staging": "The lines connect across the rubbing.\n\nCyanis looks at the pattern."}},
{"beat_id": "S008_B027", "speaker_id": "ilyra", "text": "Could be.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — BLACK HOST WORKSITE", "staging": "Ilyra studies it."}},
{"beat_id": "S008_B028", "speaker_id": "maevra", "text": "Whatever they thought it was, they wanted the rest.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — BLACK HOST WORKSITE", "staging": "Cyanis nods.\n\nNo argument over certainty.\n\nMaevra puts the rubbing away."}},
{"beat_id": "S008_B029", "speaker_id": "maevra", "text": "Small one marked the shot.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 2 — INNER WATCH", "staging": "Another moderate combat/exploration stretch.\n\nAgain, not huge.\n\nExpected first-pass pressure: roughly 2–3 random encounters.\n\nThe same core Hollow Watch assets are recomposed into:\n\n**• lower corridors;**\n\n**• one circular defense room;**\n\n**• short raised gallery;**\n\n**• damaged gate-control section.**\n\nCombat formations become slightly more complex.\n\nThe player begins seeing Sentries interacting with Ballista support fixtures, so the boss mechanic is learned through ordinary play rather than explained before the fight.\n\nAfter the first formation using that relationship:"}},
{"beat_id": "S008_B030", "speaker_id": "cyanis", "text": "Then kill the small one first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 2 — INNER WATCH", "staging": "Cyanis looks at the Ballista fixture."}},
{"beat_id": "S008_B031", "speaker_id": "ilyra", "text": "Or interrupt it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 2 — INNER WATCH"}},
{"beat_id": "S008_B032", "speaker_id": "cyanis", "text": "Also acceptable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 2 — INNER WATCH", "staging": "Cyanis looks at her.", "staging_after": "Control resumes."}},
{"beat_id": "S008_B033", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "A short side room contains the Watch Captain Frame.\n\nOptional.\n\nNo mandatory story information.\n\nUseful reward only.\n\nSame environment kit.\n\nNo unique elite cutscene.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "OPTIONAL ELITE BRANCH"}},
{"beat_id": "S008_B034", "speaker_id": "ilyra", "text": "Civilians.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — LOWER JUNCTION", "staging": "The party reaches a circular chamber.\n\nSix damaged channels meet in the stone floor.\n\nNobody knows what the six channels represent.\n\nA worn relief shows:\n\nadults,\n\nchildren,\n\nhandcarts,\n\nanimals,\n\nand injured people on litters\n\nmoving through an open gate.\n\nIlyra looks at the relief."}},
{"beat_id": "S008_B035", "speaker_id": "cyanis", "text": "Evacuation route?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — LOWER JUNCTION", "staging": "Cyanis looks at the floor channels."}},
{"beat_id": "S008_B036", "speaker_id": "maevra", "text": "Maybe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — LOWER JUNCTION", "staging": "Maevra studies both directions depicted in the relief."}},
{"beat_id": "S008_B037", "speaker_id": "maevra", "text": "Looks like people moved both ways.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — LOWER JUNCTION", "staging": "She points."}},
{"beat_id": "S008_B038", "speaker_id": "ilyra", "text": "Whatever this was, they expected injured people.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — LOWER JUNCTION", "staging": "Ilyra looks at the carved litters."}},
{"beat_id": "S008_B039", "speaker_id": "cyanis", "text": "And they dug through half the fucking tower looking for it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — LOWER JUNCTION", "staging": "Silence for a moment.\n\nCyanis looks back toward the Black Host worksite."}},
{"beat_id": "S008_B040", "speaker_id": "maevra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — LOWER JUNCTION"}},
{"beat_id": "S008_B041", "speaker_id": "maevra", "text": "Which means we're not done.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — LOWER JUNCTION", "staging": "She looks toward the deeper gate."}},
{"beat_id": "S008_B042", "speaker_id": "cyanis", "text": "That's big.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — INNER GATE", "staging": "The gate ahead has already been forced.\n\nRecent Black Host damage exposes older machinery inside it.\n\nThe route beyond leads directly to a much larger chamber.\n\nRandom encounters shut off here.\n\nA recovery/save point is available before the boss.\n\nNo camp scene.\n\nNo pre-boss speech.\n\nCyanis looks through the opening."}},
{"beat_id": "S008_B043", "speaker_id": "maevra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — INNER GATE", "staging": "Maevra looks past him."}},
{"beat_id": "S008_B044", "speaker_id": "cyanis", "text": "Just checking.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — INNER GATE", "staging_after": "They enter."}},
{"beat_id": "S008_B045", "speaker_id": "maevra", "text": "Positions.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "BOSS_HANDOFF"], "source_section": "BOSS — HOLLOW WATCH CASTELLAN", "staging": "The Castellan is integrated directly into the fortress wall.\n\nIt initially looks more like part of the architecture than a walking creature.\n\nCheap 2.5D boss production:\n\n**• one boss chamber;**\n\n**• fortress-state model/pose;**\n\n**• Ballista and Watch Seal support already built into the arena;**\n\n**• short threshold cut-in;**\n\n**• Walking-state swap;**\n\n**• lighting/dust change;**\n\n**• no transformation movie.**\n\nMaevra takes position."}},
{"beat_id": "S008_B046", "speaker_id": "cyanis", "text": "Same setup as the others.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "BOSS_HANDOFF"], "source_section": "BOSS — HOLLOW WATCH CASTELLAN", "staging": "Cyanis sees the smaller support hardware."}},
{"beat_id": "S008_B047", "speaker_id": "maevra", "text": "Then use it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "BOSS_HANDOFF"], "source_section": "BOSS — HOLLOW WATCH CASTELLAN", "staging_after": "Battle begins."}},
{"beat_id": "S008_B048", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "One HP bar.\n\nThe Castellan uses:\n\n**• Ballista support;**\n\n**• Watch Seal support;**\n\n**• direct fortress attacks.**\n\nSupport pieces are finite.\n\nIf destroyed, they stay destroyed.\n\nNo infinite respawning support.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "STATE A — FORTRESS"}},
{"beat_id": "S008_B049", "speaker_id": "cyanis", "text": "Of course it walks.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "SAME-BAR THRESHOLD", "staging": "At the authored threshold, the Castellan tears itself free from the wall.\n\nShort battle pause.\n\nDust.\n\nEnvironment-state change.\n\nNo HP refill.\n\nNo free threshold attack.\n\nPermanent damage to destroyed support remains permanent.\n\nThe Castellan lands in its Walking state.\n\nCyanis looks up."}},
{"beat_id": "S008_B050", "speaker_id": "maevra", "text": "Move.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "SAME-BAR THRESHOLD", "staging_after": "Battle resumes immediately."}},
{"beat_id": "S008_B051", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "The same health bar continues.\n\nThe Castellan becomes more directly aggressive because it is no longer anchored to the fortress.\n\nPreviously destroyed support remains gone.\n\nThe boss falls on the same HP bar.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "STATE B — WALKING"}},
{"beat_id": "S008_B052", "speaker_id": "ilyra", "text": "Arm.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTERMATH", "staging": "The Castellan collapses.\n\nDust settles.\n\nNobody immediately talks over it.\n\nIlyra checks Cyanis quickly.\n\nThen notices Maevra favoring one arm."}},
{"beat_id": "S008_B053", "speaker_id": "maevra", "text": "Fine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTERMATH", "staging": "Maevra moves it once."}},
{"beat_id": "S008_B054", "speaker_id": "ilyra", "text": "Then later.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — AFTERMATH", "staging": "Ilyra looks at her.", "staging_after": "Maevra nods.\n\nThat's it.\n\nNo medical argument.\n\nIlyra moves on."}},
{"beat_id": "S008_B055", "speaker_id": "maevra", "text": "Same branch.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE ROUTE PLATE", "staging": "The Castellan's collapse has exposed a protected stone plate behind it.\n\nSame boss chamber.\n\nOne wall-state swap.\n\nNo new room.\n\nBranching route lines cover the plate.\n\nOne surviving line runs southeast.\n\nRecent Black Host charcoal traces the same branch.\n\nMaevra compares it with the rubbing from upstairs."}},
{"beat_id": "S008_B056", "speaker_id": "cyanis", "text": "Greenhollow?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE ROUTE PLATE", "staging": "Cyanis looks at the route."}},
{"beat_id": "S008_B057", "speaker_id": "maevra", "text": "That region.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE ROUTE PLATE"}},
{"beat_id": "S008_B058", "speaker_id": "ilyra", "text": "What's there?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE ROUTE PLATE"}},
{"beat_id": "S008_B059", "speaker_id": "maevra", "text": "Villages. Forestry routes. Old crossings.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE ROUTE PLATE"}},
{"beat_id": "S008_B060", "speaker_id": "cyanis", "text": "Nothing they should care this much about.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE ROUTE PLATE", "staging": "Cyanis looks at the Black Host charcoal."}},
{"beat_id": "S008_B061", "speaker_id": "maevra", "text": "Apparently they disagree.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE ROUTE PLATE"}},
{"beat_id": "S008_B062", "speaker_id": "ilyra", "text": "Then Greenhollow.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE ROUTE PLATE", "staging": "Ilyra looks at the route plate.", "staging_after": "Maevra nods.\n\nNo one identifies:\n\na Face,\n\na Prime,\n\na giant underground Crest,\n\na hidden Network,\n\nor what the six channels ultimately represent.\n\nThey only know someone was studying routes and followed one toward Greenhollow."}},
{"beat_id": "S008_B063", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "BASTION RESERVE acquired.\n\nNo Face-system lecture.\n\nNo character suddenly explains Resource.\n\nNo Prime connection.\n\nThe Card enters the existing collection/reward state normally; no new Face-system tutorial or Prime explanation is attached to the reward.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "FIRST-CLEAR REWARD"}},
{"beat_id": "S008_B064", "speaker_id": "maevra", "text": "Brackenwall. Report. Resupply.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — SHORTCUT", "staging": "Defeating the Castellan releases a secured surface route.\n\nSimple door/bridge state change.\n\nNo mandatory dungeon backtracking.\n\nThe player can use the shortcut directly toward Hollow Watch's entrance.\n\nRandom encounters stay off during the secured return.\n\nAt the surface:"}},
{"beat_id": "S008_B065", "speaker_id": "ilyra", "text": "Then Greenhollow. After food.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — SHORTCUT", "staging": "Ilyra starts walking."}},
{"beat_id": "S008_B066", "speaker_id": "maevra", "text": "Food.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — SHORTCUT", "staging": "Cyanis opens his mouth.\n\nMaevra looks at him."}},
{"beat_id": "S008_B067", "speaker_id": "cyanis", "text": "Fine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — SHORTCUT", "staging": "Cyanis closes his mouth.\n\nBeat.", "staging_after": "Ilyra keeps walking.\n\nMaevra follows."}},
{"beat_id": "S008_B068", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "Short transition back toward Brackenwall.\n\nNo second field dungeon.\n\nThe report/resupply itself does not need another major mandatory scene; Brackenwall can return to its established safe-hub state before the story advances to Greenhollow.\n\nFade.\n\n**END S008.**\n\nNext: S009 — Greenhollow / present-day Torren–Maevra reunion.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "B009 — EXIT"}}
