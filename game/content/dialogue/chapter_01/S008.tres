[gd_resource type="Resource" script_class="DiyseDialogueSceneDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://game/dialogue/dialogue_scene_definition.gd" id="1_scene"]

[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "S008"
chapter_id = "chapter_01"
scene_kind = "mandatory"
location_id = "LOC_BRD_HOLLOW_WATCH"
trigger_id = "trigger.chapter_01.s008"
completion_flag = "scene.s008.complete"
participants = Array[String](["maevra", "cyanis", "ilyra"])
authoring_notes = "Audit75 Resource conversion of the closed Chapter 1 Hollow Watch production dialogue. Spoken/staging wording is translated from the approved August 9, 2026 S007-S011 production source; only explicit later-canon terminology supersessions are applied. No story/dialogue rewrite, no player choices, and no proof portraits."
beats = [{"beat_id":"S008_B001","cues":{"staging":"Hollow Watch is larger up close. The surviving tower sits over older buried stonework. Roots disappear into collapsed retaining walls. A later Yahtrean fortification has been built over something much older. The service gate hangs open. Fresh boot tracks go inside. A cut chain lies in the mud."}},
{"beat_id":"S008_B002","cues":{"staging":"Maevra crouches beside it."}},
{"beat_id":"S008_B003","speaker_id":"maevra","text":"Recent."},
{"beat_id":"S008_B004","speaker_id":"cyanis","text":"Tracks coming out?"},
{"beat_id":"S008_B005","cues":{"staging":"Maevra follows them."}},
{"beat_id":"S008_B006","speaker_id":"maevra","text":"Some."},
{"beat_id":"S008_B007","speaker_id":"cyanis","text":"Walking?"},
{"beat_id":"S008_B008","cues":{"staging":"She points to a dropped tool and torn mud."}},
{"beat_id":"S008_B009","speaker_id":"maevra","text":"No."},
{"beat_id":"S008_B010","cues":{"staging":"Ilyra checks a blood mark on the stone."}},
{"beat_id":"S008_B011","speaker_id":"ilyra","text":"Not much blood."},
{"beat_id":"S008_B012","speaker_id":"cyanis","text":"Good."},
{"beat_id":"S008_B013","speaker_id":"ilyra","text":"Not the same as safe."},
{"beat_id":"S008_B014","cues":{"staging":"Cyanis draws his sword."}},
{"beat_id":"S008_B015","speaker_id":"cyanis","text":"Let's find out."},
{"beat_id":"S008_B016","cues":{"staging":"PLAYER CONTROL. First encounter: Hollow Watch Sentry + Hollow Watch Sentry. After the fight, one disabled Sentry still attempts to reach a wall socket.","implementation_flags":["PLAYER_CONTROL"]}},
{"beat_id":"S008_B017","speaker_id":"ilyra","text":"It's trying to signal."},
{"beat_id":"S008_B018","cues":{"staging":"Maevra studies the recess."}},
{"beat_id":"S008_B019","speaker_id":"maevra","text":"Assume it already did."},
{"beat_id":"S008_B020","cues":{"staging":"CONTROL RETURNS."}},
{"beat_id":"S008_B021","cues":{"staging":"The player operates a later Yahtrean mechanism bolted over older green-gold infrastructure. The bridge seen earlier shifts into place and a lower chamber becomes visible. No character explains the architecture."}},
{"beat_id":"S008_B022","cues":{"staging":"A safe investigation pocket: broken digging tools, charcoal, wax sheets, a cracked pry bar, and several wall sections scrubbed clean."}},
{"beat_id":"S008_B023","cues":{"staging":"Maevra lifts the pry bar."}},
{"beat_id":"S008_B024","speaker_id":"maevra","text":"They weren't holding the tower."},
{"beat_id":"S008_B025","cues":{"staging":"Cyanis looks at the cleaned wall."}},
{"beat_id":"S008_B026","speaker_id":"cyanis","text":"Searching."},
{"beat_id":"S008_B027","cues":{"staging":"Ilyra finds blood on discarded cloth."}},
{"beat_id":"S008_B028","speaker_id":"ilyra","text":"And something interrupted them."},
{"beat_id":"S008_B029","cues":{"staging":"Cyanis studies branching grooves."}},
{"beat_id":"S008_B030","speaker_id":"cyanis","text":"Writing?"},
{"beat_id":"S008_B031","speaker_id":"maevra","text":"Maybe not."},
{"beat_id":"S008_B032","cues":{"staging":"She lays a recovered wax rubbing over part of the wall. The lines connect."}},
{"beat_id":"S008_B033","speaker_id":"cyanis","text":"Routes."},
{"beat_id":"S008_B034","speaker_id":"ilyra","text":"Could be."},
{"beat_id":"S008_B035","cues":{"staging":"Cyanis nods. No argument."}},
{"beat_id":"S008_B036","speaker_id":"maevra","text":"Whatever they thought it was, they wanted the rest."},
{"beat_id":"S008_B037","cues":{"staging":"SECOND ENCOUNTER: Hollow Watch Sentry + Hollow Watch Ballista. The player reads the Sentry/Ballista relationship through combat.","implementation_flags":["AUTHORED_ENCOUNTER_HANDOFF"]}},
{"beat_id":"S008_B038","speaker_id":"maevra","text":"The small frame marked the shot."},
{"beat_id":"S008_B039","speaker_id":"cyanis","text":"Then we don't let it finish next time."},
{"beat_id":"S008_B040","cues":{"staging":"CONTROL RETURNS. Watch Captain Frame remains optional and receives no mandatory exposition."}},
{"beat_id":"S008_B041","cues":{"staging":"A safe circular chamber. Six damaged route channels meet in the floor, though their larger meaning is still unreadable. A relief shows adults, children, handcarts, animals, and litters moving through an open gate."}},
{"beat_id":"S008_B042","speaker_id":"ilyra","text":"Civilians."},
{"beat_id":"S008_B043","cues":{"staging":"Cyanis looks at the route channels."}},
{"beat_id":"S008_B044","speaker_id":"cyanis","text":"Evacuation?"},
{"beat_id":"S008_B045","speaker_id":"maevra","text":"Possibly movement in both directions."},
{"beat_id":"S008_B046","cues":{"staging":"Ilyra points at the carved litters."}},
{"beat_id":"S008_B047","speaker_id":"ilyra","text":"Whatever else it did, somebody expected injured people here."},
{"beat_id":"S008_B048","cues":{"staging":"A moment. Maevra looks toward the deeper passage."}},
{"beat_id":"S008_B049","speaker_id":"maevra","text":"And the Black Host dug through half a tower to reach it."},
{"beat_id":"S008_B050","cues":{"staging":"The gate mechanism has already been forced. Recent damage exposes the ancient control assembly. The gate opens onto the Castellan chamber. No random encounters from here to the boss. A recovery point is available before crossing the threshold."}},
{"beat_id":"S008_B051","cues":{"staging":"The enormous Castellan is integrated into the fortress wall."}},
{"beat_id":"S008_B052","speaker_id":"maevra","text":"Positions."},
{"beat_id":"S008_B053","cues":{"staging":"Cyanis notices the support hardware."}},
{"beat_id":"S008_B054","speaker_id":"cyanis","text":"Same pattern as the smaller frames."},
{"beat_id":"S008_B055","speaker_id":"maevra","text":"Then use what we learned."},
{"beat_id":"S008_B056","cues":{"staging":"BOSS: HOLLOW WATCH CASTELLAN. One HP bar. Fortress State uses Ballista and Watch Seal support. At the approved threshold the Castellan tears itself free into Walking State with NO HP refill, NO extra ordinary action, and permanent consequences from destroyed support components.","implementation_flags":["BOSS_HANDOFF"]}},
{"beat_id":"S008_B057","speaker_id":"cyanis","text":"Of course it walks."},
{"beat_id":"S008_B058","speaker_id":"maevra","text":"Move."},
{"beat_id":"S008_B059","cues":{"staging":"The Castellan collapses. Dust rolls across the chamber. Nobody speaks until it settles. Ilyra checks both soldiers quickly; Maevra has a bruised arm."}},
{"beat_id":"S008_B060","speaker_id":"ilyra","text":"Functional?"},
{"beat_id":"S008_B061","cues":{"staging":"Maevra tests it."}},
{"beat_id":"S008_B062","speaker_id":"maevra","text":"Yes."},
{"beat_id":"S008_B063","speaker_id":"ilyra","text":"Then later."},
{"beat_id":"S008_B064","cues":{"staging":"She moves on. No extended medical routine."}},
{"beat_id":"S008_B065","cues":{"staging":"The collapse exposes a protected route plate behind the Castellan. A surviving branch runs toward the Greenhollow region. Recent Black Host charcoal marks that same line. Maevra compares it with the earlier rubbing."}},
{"beat_id":"S008_B066","speaker_id":"maevra","text":"Same branch."},
{"beat_id":"S008_B067","speaker_id":"cyanis","text":"Greenhollow?"},
{"beat_id":"S008_B068","speaker_id":"maevra","text":"That region."},
{"beat_id":"S008_B069","speaker_id":"ilyra","text":"What's there?"},
{"beat_id":"S008_B070","speaker_id":"maevra","text":"Villages. Forestry routes. Old crossings."},
{"beat_id":"S008_B071","cues":{"staging":"Cyanis looks at the charcoal."}},
{"beat_id":"S008_B072","speaker_id":"cyanis","text":"Nothing they should care this much about."},
{"beat_id":"S008_B073","speaker_id":"maevra","text":"Then we find out why they do."},
{"beat_id":"S008_B074","cues":{"staging":"MANDATORY FIRST-CLEAR REWARD: BASTION RESERVE. No Face-system lecture here.","implementation_flags":["MANDATORY_FIRST_CLEAR_REWARD"]}},
{"beat_id":"S008_B075","cues":{"staging":"A secured shortcut opens back toward the surface. No mandatory full-dungeon backtracking. Random encounters are suppressed on the secured return."}},
{"beat_id":"S008_B076","speaker_id":"maevra","text":"Brackenwall. Report. Resupply."},
{"beat_id":"S008_B077","speaker_id":"cyanis","text":"Then Greenhollow."},
{"beat_id":"S008_B078","speaker_id":"ilyra","text":"After food."},
{"beat_id":"S008_B079","cues":{"staging":"Cyanis starts to answer. Stops. Maevra sees that."}},
{"beat_id":"S008_B080","speaker_id":"maevra","text":"Food."},
{"beat_id":"S008_B081","cues":{"staging":"Cyanis sighs. They leave."}}]
