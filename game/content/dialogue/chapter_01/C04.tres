[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "C04"
chapter_id = "chapter_01"
scene_kind = "character_life"
location_id = "LOC_BRD_BRACKENWALL"
trigger_id = "trigger.chapter_01.c04.after_s011"
completion_flag = "scene.c04.complete"
participants = Array[String](["cyanis", "torren"])
authoring_notes = "Audit75 conversion of the closed C04 What the Map Says Character-Life authority. Only protected/closed spoken wording is promoted where the archived exact full line payload is not independently available. The Whore/Bitch/laughter trio and protected escalation are exact and ordered. Cheap 2.5D: one route room/table, Torren's personal map, official map, charcoal, weights, cup, bow, reusable sit/stand/point/write states."
beats = [{"beat_id":"C04_B001","cues":{"staging":"Late evening after S011. Torren is at a small Brackenwall route table correcting an official map against terrain, weather, water, traffic, and direct observation. Cyanis joins him. Keep the scene on one table with reusable pointing/writing states."}},
{"beat_id":"C04_B002","cues":{"staging":"Cyanis challenges one of the official assumptions; Torren shows the physical evidence that changed it."}},
{"beat_id":"C04_B003","speaker_id":"cyanis","text":"Evidence ruins everything."},
{"beat_id":"C04_B004","cues":{"staging":"They continue through route notes. When Torren does not know because he has not checked a route, Cyanis accepts the uncertainty rather than demanding certainty."}},
{"beat_id":"C04_B005","cues":{"staging":"Cyanis asks about a wagon route."}},
{"beat_id":"C04_B006","speaker_id":"torren","text":"Fuck no."},
{"beat_id":"C04_B007","speaker_id":"cyanis","text":"Excellent. First definitive answer of evening."},
{"beat_id":"C04_B008","cues":{"staging":"Torren keeps writing. Cyanis leans over the map and reads a cramped handwritten label aloud."}},
{"beat_id":"C04_B009","speaker_id":"cyanis","text":"Whore."},
{"beat_id":"C04_B010","speaker_id":"torren","text":"Bitch."},
{"beat_id":"C04_B011","cues":{"staging":"Do not clarify the handwriting yet. Cyanis realizes Torren thought he had just been called a whore and bursts into laughter."}},
{"beat_id":"C04_B012","speaker_id":"torren","text":"Oh, fuck you."},
{"beat_id":"C04_B013","speaker_id":"cyanis","text":"You called me a bitch."},
{"beat_id":"C04_B014","speaker_id":"torren","text":"You called me a whore."},
{"beat_id":"C04_B015","speaker_id":"cyanis","text":"I was reading the map!"},
{"beat_id":"C04_B016","speaker_id":"torren","text":"Then learn to fucking read."},
{"beat_id":"C04_B017","cues":{"staging":"Only after the exchange lands is the handwriting clarified: the word is Shore. Later, Torren deliberately repeats the misreading to make Cyanis laugh again."}},
{"beat_id":"C04_B018","speaker_id":"torren","text":"Whore."},
{"beat_id":"C04_B019","cues":{"staging":"Cyanis laughs again. The scene shifts naturally from accidental insult into actual route work; Cyanis asks Torren to show what he is looking at rather than turning the moment into a friendship speech."}},
{"beat_id":"C04_B020","speaker_id":"torren","text":"People move. Road's just where enough of them keep doing it."},
{"beat_id":"C04_B021","cues":{"staging":"Torren records the Greenhollow bridge by civilian function rather than praising anyone."}},
{"beat_id":"C04_B022","speaker_id":"torren","text":"Standing. Damaged. Civilian flood route."},
{"beat_id":"C04_B023","cues":{"staging":"Cyanis reaches toward Torren's charcoal without thinking."}},
{"beat_id":"C04_B024","speaker_id":"torren","text":"Touch the map and I'll break your fucking fingers."},
{"beat_id":"C04_B025","speaker_id":"cyanis","text":"See, now we're friends."},
{"beat_id":"C04_B026","cues":{"staging":"They keep working for a while. Cyanis starts to leave, then baits Torren with one last question."}},
{"beat_id":"C04_B027","speaker_id":"cyanis","text":"What's that one say?"},
{"beat_id":"C04_B028","speaker_id":"torren","text":"Shore."},
{"beat_id":"C04_B029","speaker_id":"cyanis","text":"I didn't point at anything."},
{"beat_id":"C04_B030","speaker_id":"cyanis","text":"Good night, Torren."},
{"beat_id":"C04_B031","speaker_id":"torren","text":"Fuck off, Cyanis."},
{"beat_id":"C04_B032","speaker_id":"cyanis","text":"Bitch."},
{"beat_id":"C04_B033","cues":{"staging":"Torren laughs. End immediately. This is the beginning of their later increasingly vulgar but safe friendship shorthand; genuine danger still shuts the humor off."}}]
