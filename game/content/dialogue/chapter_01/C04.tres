{"beat_id": "C04_B066", "speaker_id": "cyanis", "text": "Good start.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — THE ACTUAL MAP"}},
{"beat_id": "C04_B067", "speaker_id": "torren", "text": "People move. Road’s just where enough of them keep doing it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — WHAT A ROAD IS", "staging": "Torren traces several smaller marks."}},
{"beat_id": "C04_B068", "speaker_id": "cyanis", "text": "That’s annoyingly sensible.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — WHAT A ROAD IS"}},
{"beat_id": "C04_B069", "speaker_id": "torren", "text": "I get that a lot.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — WHAT A ROAD IS"}},
{"beat_id": "C04_B070", "speaker_id": "cyanis", "text": "Do you?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — WHAT A ROAD IS", "staging": "Cyanis looks at him."}},
{"beat_id": "C04_B071", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — WHAT A ROAD IS"}},
{"beat_id": "C04_B072", "speaker_id": "cyanis", "text": "Yours is uglier.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — UGLY MAP", "staging": "Cyanis compares Torren’s map with the Crown-issued one."}},
{"beat_id": "C04_B073", "speaker_id": "torren", "text": "Mine’s useful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — UGLY MAP"}},
{"beat_id": "C04_B074", "speaker_id": "cyanis", "text": "The Crown cartographers would be wounded.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — UGLY MAP"}},
{"beat_id": "C04_B075", "speaker_id": "torren", "text": "They can come walk the fucking road.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — UGLY MAP"}},
{"beat_id": "C04_B076", "speaker_id": "cyanis", "text": "There he is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — UGLY MAP", "staging": "Cyanis points at him."}},
{"beat_id": "C04_B077", "speaker_id": "torren", "text": "Who?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — UGLY MAP"}},
{"beat_id": "C04_B078", "speaker_id": "cyanis", "text": "The man who called me a bitch ten minutes after dinner.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — UGLY MAP"}},
{"beat_id": "C04_B079", "speaker_id": "torren", "text": "You called me—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — UGLY MAP"}},
{"beat_id": "C04_B080", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — UGLY MAP", "staging": "Torren stops himself."}},
{"beat_id": "C04_B081", "speaker_id": "cyanis", "text": "Coward.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — UGLY MAP", "staging": "Cyanis grins."}},
{"beat_id": "C04_B082", "speaker_id": "torren", "text": "This one’s old.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B012 — I DON’T KNOW", "staging": "Torren indicates an uncertain mark."}},
{"beat_id": "C04_B083", "speaker_id": "cyanis", "text": "How old?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B012 — I DON’T KNOW"}},
{"beat_id": "C04_B084", "speaker_id": "torren", "text": "Eight months since I checked it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B012 — I DON’T KNOW"}},
{"beat_id": "C04_B085", "speaker_id": "cyanis", "text": "So?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B012 — I DON’T KNOW"}},
{"beat_id": "C04_B086", "speaker_id": "torren", "text": "So I don’t know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B012 — I DON’T KNOW"}},
{"beat_id": "C04_B087", "speaker_id": "cyanis", "text": "Okay.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B012 — I DON’T KNOW"}},
{"beat_id": "C04_B088", "speaker_id": "torren", "text": "You expected me to argue.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B012 — I DON’T KNOW", "staging": "Torren pauses.\n\nLooks at Cyanis."}},
{"beat_id": "C04_B089", "speaker_id": "cyanis", "text": "Most people hear “I don’t know” and ask again louder.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B012 — I DON’T KNOW"}},
{"beat_id": "C04_B090", "speaker_id": "torren", "text": "Would that help?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B012 — I DON’T KNOW"}},
{"beat_id": "C04_B091", "speaker_id": "cyanis", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B012 — I DON’T KNOW"}},
{"beat_id": "C04_B092", "speaker_id": "torren", "text": "Then that sounds exhausting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B012 — I DON’T KNOW", "staging_after": "Cyanis nods.\n\nNo speech about trust.\n\nThey just keep going."}},
{"beat_id": "C04_B093", "speaker_id": "cyanis", "text": "That’s our bridge.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B013 — GREENHOLLOW’S BRIDGE", "staging": "Cyanis recognizes a mark."}},
{"beat_id": "C04_B094", "speaker_id": "torren", "text": "Greenhollow’s bridge.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B013 — GREENHOLLOW’S BRIDGE"}},
{"beat_id": "C04_B095", "speaker_id": "cyanis", "text": "Right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B013 — GREENHOLLOW’S BRIDGE"}},
{"beat_id": "C04_B096", "speaker_id": "cyanis", "text": "Standing. Damaged. Civilian flood route.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B013 — GREENHOLLOW’S BRIDGE", "staging": "Cyanis reads Torren’s annotation."}},
{"beat_id": "C04_B097", "speaker_id": "torren", "text": "That’s what it is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B013 — GREENHOLLOW’S BRIDGE"}},
{"beat_id": "C04_B098", "speaker_id": "cyanis", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B013 — GREENHOLLOW’S BRIDGE"}},
{"beat_id": "C04_B099", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B013 — GREENHOLLOW’S BRIDGE", "staging_after": "Nothing about Torren saving it.\n\nNothing self-congratulatory.\n\nThe map records what the bridge is for."}},
{"beat_id": "C04_B100", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B014 — HELPING", "staging": "Cyanis reaches toward the charcoal.\n\nTorren catches the movement immediately."}},
{"beat_id": "C04_B101", "speaker_id": "cyanis", "text": "I was helping.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B014 — HELPING"}},
{"beat_id": "C04_B102", "speaker_id": "torren", "text": "You were reaching.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B014 — HELPING"}},
{"beat_id": "C04_B103", "speaker_id": "cyanis", "text": "First stage of helping.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B014 — HELPING"}},
{"beat_id": "C04_B104", "speaker_id": "torren", "text": "Not with my map.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B014 — HELPING"}},
{"beat_id": "C04_B105", "speaker_id": "cyanis", "text": "Afraid I’ll improve the handwriting?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B014 — HELPING"}},
{"beat_id": "C04_B106", "speaker_id": "torren", "text": "Touch the map and I’ll break your fucking fingers.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B014 — HELPING", "staging": "Torren looks at him."}},
{"beat_id": "C04_B107", "speaker_id": "cyanis", "text": "See, now we’re friends.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B014 — HELPING", "staging": "Cyanis smiles."}},
{"beat_id": "C04_B108", "speaker_id": "torren", "text": "That’s your standard?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B014 — HELPING"}},
{"beat_id": "C04_B109", "speaker_id": "cyanis", "text": "Apparently.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B014 — HELPING", "staging": "Cyanis considers it.", "staging_after": "Torren shakes his head.\n\nStarts folding the map."}},
{"beat_id": "C04_B110", "speaker_id": "cyanis", "text": "What’s that one say?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B015 — ONE MORE TIME", "staging": "Cyanis watches him carefully."}},
{"beat_id": "C04_B111", "speaker_id": "torren", "text": "Don’t start.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B015 — ONE MORE TIME", "staging": "Torren does not look up."}},
{"beat_id": "C04_B112", "speaker_id": "cyanis", "text": "Old—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B015 — ONE MORE TIME", "staging": "Beat."}},
{"beat_id": "C04_B113", "speaker_id": "torren", "text": "You little—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B015 — ONE MORE TIME", "staging": "Torren looks up.\n\nCyanis is already grinning."}},
{"beat_id": "C04_B114", "speaker_id": "cyanis", "text": "Good night, Torren.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B015 — ONE MORE TIME", "staging": "Cyanis laughs and starts toward the door."}},
{"beat_id": "C04_B115", "speaker_id": "torren", "text": "Fuck off, Cyanis.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B015 — ONE MORE TIME"}},
{"beat_id": "C04_B116", "speaker_id": "cyanis", "text": "Bitch.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B015 — ONE MORE TIME", "staging": "Cyanis does not turn around.", "staging_after": "Torren stares after him.\n\nBeat.\n\nThen he laughs despite himself.\n\nCut.\n\n**END C04.**\n\nC03 and C05 remain independently available."}}
]
