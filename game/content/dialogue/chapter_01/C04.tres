beats = [
{"beat_id": "C04_B001", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "Brackenwall, late evening.\n\nOne small sheltered route room/table.\n\nCheap 2.5D:\n\n**• Torren’s battered personal map;**\n\n**• Crown-issued route map;**\n\n**• charcoal;**\n\n**• map weights;**\n\n**• cup;**\n\n**• Torren’s bow nearby;**\n\n**• existing sit/stand/point/write poses.**\n\nNo special handwriting animation.\n\nNo lore reveal.\n\nNo Hunt progression.\n\nNo mandatory story information.\n\nJust Cyanis bothering Torren while Torren works.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "PRODUCTION"}},
{"beat_id": "C04_B002", "speaker_id": "torren", "text": "You need something?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — CURIOUS", "staging": "Torren is correcting the official route map against his own battered one.\n\nCyanis stands behind him.\n\nTorren keeps writing."}},
{"beat_id": "C04_B003", "speaker_id": "cyanis", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — CURIOUS"}},
{"beat_id": "C04_B004", "speaker_id": "torren", "text": "Then why are you standing over me?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — CURIOUS"}},
