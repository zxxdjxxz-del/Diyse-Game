{"beat_id": "C04_B006", "speaker_id": "torren", "text": "Dangerous habit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — CURIOUS"}},
{"beat_id": "C04_B007", "speaker_id": "cyanis", "text": "I’ve heard.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — CURIOUS", "staging_after": "Cyanis pulls over a chair."}},
{"beat_id": "C04_B008", "speaker_id": "cyanis", "text": "What are you doing?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — FIXING IT", "staging": "Cyanis studies the map."}},
