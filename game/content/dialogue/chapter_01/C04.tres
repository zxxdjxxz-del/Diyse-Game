{"beat_id": "C04_B028", "speaker_id": "cyanis", "text": "Would you take this one?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WAGON", "staging": "Cyanis points to another route."}},
