[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "C04"
chapter_id = "chapter_01"
scene_kind = "character_life"
location_id = "LOC_BRD_BRACKENWALL"
trigger_id = "trigger.chapter_01.c04.after_s011"
completion_flag = "scene.c04.complete"
participants = Array[String](["cyanis", "torren"])
authoring_notes = "Audit75 conversion of the closed C04 What the Map Says Character-Life scene. This is the first unmistakable Cyanis/Torren personal-profane friendship beat. The protected Whore/Bitch/laughter trio and later escalation remain exact and in order. Cheap 2.5D: one route room/table, Torren's personal map, official map, charcoal, weights, cup, bow, reusable sit/stand/point/write states."
beats = [{"beat_id":"C04_B001","cues":{"staging":"Late evening after S011. Torren is at a small Brackenwall route table correcting an official map against his personal notes. Cyanis stops at the table."}},
{"beat_id":"C04_B002","speaker_id":"cyanis","text":"Still fixing the Crown?"},
{"beat_id":"C04_B003","speaker_id":"torren","text":"Map."},
{"beat_id":"C04_B004","speaker_id":"cyanis","text":"Less ambitious."},
{"beat_id":"C04_B005","cues":{"staging":"Torren crosses out an official river line and redraws the bank."}},
{"beat_id":"C04_B006","speaker_id":"cyanis","text":"It moved again?"},
{"beat_id":"C04_B007","speaker_id":"torren","text":"River did."},
{"beat_id":"C04_B008","speaker_id":"cyanis","text":"Evidence ruins everything."},
{"beat_id":"C04_B009","cues":{"staging":"Cyanis asks about several route notes. Torren answers precisely where he knows and says he does not know where he has not checked. Cyanis accepts the uncertainty instead of pressing for false certainty."}},
{"beat_id":"C04_B010","speaker_id":"cyanis","text":"Wagon route?"},
{"beat_id":"C04_B011","speaker_id":"torren","text":"Fuck no."},
{"beat_id":"C04_B012","speaker_id":"cyanis","text":"Excellent. First definitive answer of evening."},
{"beat_id":"C04_B013","cues":{"staging":"Torren keeps writing. Cyanis leans closer and tries to read a cramped handwritten label on the map."}},
{"beat_id":"C04_B014","speaker_id":"cyanis","text":"Whore."},
{"beat_id":"C04_B015","speaker_id":"torren","text":"Bitch."},
{"beat_id":"C04_B016","cues":{"staging":"Do not clarify yet. Cyanis stares at him for a beat, realizes Torren thought he had just been called a whore, and bursts into laughter."}},
{"beat_id":"C04_B017","speaker_id":"cyanis","text":"Oh, fuck you."},
{"beat_id":"C04_B018","speaker_id":"torren","text":"You called me a bitch."},
{"beat_id":"C04_B019","speaker_id":"cyanis","text":"You called me a whore."},
{"beat_id":"C04_B020","speaker_id":"torren","text":"I was reading the map!"},
{"beat_id":"C04_B021","speaker_id":"cyanis","text":"Then learn to fucking read."},
{"beat_id":"C04_B022","cues":{"staging":"Cyanis laughs harder. Only now is the handwriting clarified: the word is Shore."}},
{"beat_id":"C04_B023","speaker_id":"torren","text":"Shore."},
{"beat_id":"C04_B024","speaker_id":"cyanis","text":"That is not what that says."},
{"beat_id":"C04_B025","cues":{"staging":"Torren deliberately points at the same word again after Cyanis settles."}},
{"beat_id":"C04_B026","speaker_id":"torren","text":"Whore."},
{"beat_id":"C04_B027","cues":{"staging":"Cyanis starts laughing again. Torren allows himself a small smile. This is the turn: Torren is now deliberately playing back rather than merely defending himself."}},
{"beat_id":"C04_B028","speaker_id":"cyanis","text":"All right. Show me what you're actually looking at."},
{"beat_id":"C04_B029","cues":{"staging":"Torren shifts the personal map so Cyanis can see. Reusable pointing/portrait acting only."}},
{"beat_id":"C04_B030","speaker_id":"torren","text":"People move. Road's just where enough of them keep doing it."},
{"beat_id":"C04_B031","cues":{"staging":"He marks Greenhollow's bridge with three factual notes."}},
{"beat_id":"C04_B032","speaker_id":"torren","text":"Standing. Damaged. Civilian flood route."},
{"beat_id":"C04_B033","cues":{"staging":"Cyanis asks about a route Torren has not checked. Torren says he does not know. Cyanis simply moves to the next question. Do not turn this into a speech about trust."}},
{"beat_id":"C04_B034","cues":{"staging":"Cyanis reaches toward the charcoal without thinking."}},
{"beat_id":"C04_B035","speaker_id":"torren","text":"Touch the map and I'll break your fucking fingers."},
{"beat_id":"C04_B036","speaker_id":"cyanis","text":"See, now we're friends."},
{"beat_id":"C04_B037","cues":{"staging":"They continue working for a short while. No emotional summary. Cyanis finally starts to leave, then turns back."}},
{"beat_id":"C04_B038","speaker_id":"cyanis","text":"What's that one say?"},
{"beat_id":"C04_B039","speaker_id":"torren","text":"Shore."},
{"beat_id":"C04_B040","speaker_id":"cyanis","text":"I didn't point at anything."},
{"beat_id":"C04_B041","cues":{"staging":"Torren looks up."}},
{"beat_id":"C04_B042","speaker_id":"cyanis","text":"Good night, Torren."},
{"beat_id":"C04_B043","speaker_id":"torren","text":"Fuck off, Cyanis."},
{"beat_id":"C04_B044","speaker_id":"cyanis","text":"Bitch."},
{"beat_id":"C04_B045","cues":{"staging":"Torren laughs. End immediately. This is the beginning of their later increasingly vulgar affectionate shorthand, not the finished late-game version of it."}}]
