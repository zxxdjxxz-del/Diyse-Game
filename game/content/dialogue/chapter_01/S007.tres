[ext_resource type="Script" path="res://game/dialogue/dialogue_scene_definition.gd" id="1_scene"]

[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "S007"
chapter_id = "chapter_01"
scene_kind = "mandatory"
location_id = "LOC_BRD_BRACKENWALL"
trigger_id = "trigger.chapter_01.s007"
completion_flag = "scene.s007.complete"
participants = Array[String](["cyanis", "ilyra", "brackenwall_sergeant", "custody_officer", "maevra", "scout"])
authoring_notes = "Audit75 Resource conversion of the closed Chapter 1 Brackenwall / Protocol production dialogue. Spoken/staging wording is translated from the approved August 9, 2026 S007-S011 production source; only explicit later-canon terminology supersessions are applied. No story/dialogue rewrite, no player choices, and no proof portraits."
beats = [{"beat_id":"S007_B001","cues":{"staging":"Morning. Brackenwall is already working: a crew replaces burned timber along the wall, a wagon axle is straightened beside the gate, flour sacks move under military count, and a courier receives a fresh shoulder dressing. Through the eastern rooftops, a broken watchtower is visible on a wooded ridge. Cyanis and Ilyra enter beside the sealed artifact wagon."}},
{"beat_id":"S007_B002","speaker_id":"cyanis","text":"You said the road would improve."},
{"beat_id":"S007_B003","speaker_id":"ilyra","text":"I said it would flatten."},
{"beat_id":"S007_B004","cues":{"staging":"A cart rattles past hard enough to make Cyanis look at her."}},
{"beat_id":"S007_B005","speaker_id":"cyanis","text":"Very careful promise."},
{"beat_id":"S007_B006","speaker_id":"ilyra","text":"Accurate promise."},
{"beat_id":"S007_B007","cues":{"staging":"A Brackenwall sergeant approaches."}},
{"beat_id":"S007_B008","speaker_id":"brackenwall_sergeant","text":"Convoy recovery?"},
{"beat_id":"S007_B009","speaker_id":"cyanis","text":"What's left of it."},
{"beat_id":"S007_B010","cues":{"staging":"The sergeant glances at the sealed wagon."}},
{"beat_id":"S007_B011","speaker_id":"brackenwall_sergeant","text":"Artifact yard's expecting you. Straight through. Second court."},
{"beat_id":"S007_B012","speaker_id":"cyanis","text":"They sound eager."},
{"beat_id":"S007_B013","speaker_id":"brackenwall_sergeant","text":"They've been waiting since sunrise."},
{"beat_id":"S007_B014","speaker_id":"cyanis","text":"That's worse."},
{"beat_id":"S007_B015","cues":{"staging":"PLAYER CONTROL. Encounter state: SAFE. Allow roughly 45-90 seconds of compact town traversal. Environmental communication: repairs, mixed civilian/military infrastructure, route-closure notices, medical resupply, workshops, and repeated sightline to the distant Hollow Watch. No mandatory lore lecture during this walk.","implementation_flags":["PLAYER_CONTROL"]}},
{"beat_id":"S007_B016","cues":{"staging":"A custody officer checks the convoy seals."}},
{"beat_id":"S007_B017","speaker_id":"custody_officer","text":"Seal untouched?"},
{"beat_id":"S007_B018","speaker_id":"cyanis","text":"Since it was closed."},
{"beat_id":"S007_B019","speaker_id":"ilyra","text":"It reacted afterward."},
{"beat_id":"S007_B020","cues":{"staging":"The officer looks at her."}},
{"beat_id":"S007_B021","speaker_id":"ilyra","text":"So did he."},
{"beat_id":"S007_B022","cues":{"staging":"Cyanis gives her a look. She ignores it. The officer writes."}},
{"beat_id":"S007_B023","speaker_id":"custody_officer","text":"Standard procedure is inspection behind the inner ward. You remain outside until containment clears."},
{"beat_id":"S007_B024","speaker_id":"cyanis","text":"Fine."},
{"beat_id":"S007_B025","speaker_id":"ilyra","text":"I'm staying with him."},
{"beat_id":"S007_B026","speaker_id":"custody_officer","text":"Fine."},
{"beat_id":"S007_B027","cues":{"staging":"No argument. The transfer crew moves the sealed casing. One pace. Two. Three. A thin green-gold geometric line forms beneath it and moves across the floor toward Cyanis. Cyanis catches the edge of the inspection table."}},
{"beat_id":"S007_B028","speaker_id":"cyanis","text":"Stop."},
{"beat_id":"S007_B029","speaker_id":"ilyra","text":"Stop."},
{"beat_id":"S007_B030","cues":{"staging":"The crew freezes. Ilyra is beside him immediately."}},
{"beat_id":"S007_B031","speaker_id":"ilyra","text":"Look at me."},
{"beat_id":"S007_B032","cues":{"staging":"He does."}},
{"beat_id":"S007_B033","speaker_id":"ilyra","text":"Pressure?"},
{"beat_id":"S007_B034","speaker_id":"cyanis","text":"Behind the eyes."},
{"beat_id":"S007_B035","cues":{"staging":"She checks his pulse. The custody officer watches the line continue."}},
{"beat_id":"S007_B036","speaker_id":"custody_officer","text":"Back it up."},
{"beat_id":"S007_B037","cues":{"staging":"The casing moves backward. The geometry retracts. Cyanis exhales."}},
{"beat_id":"S007_B038","speaker_id":"ilyra","text":"Better?"},
{"beat_id":"S007_B039","speaker_id":"cyanis","text":"Yes."},
{"beat_id":"S007_B040","cues":{"staging":"The officer looks at the transfer frame."}},
{"beat_id":"S007_B041","speaker_id":"custody_officer","text":"That's new."},
{"beat_id":"S007_B042","speaker_id":"cyanis","text":"Been a productive two days."},
{"beat_id":"S007_B043","cues":{"staging":"Boots cross the upper gallery. The yard guards straighten automatically. Maevra Solmar enters with two Vanguard soldiers and a transfer writ. She takes in the stopped transfer, the fading line, Cyanis, Ilyra, and the officer."}},
{"beat_id":"S007_B044","speaker_id":"maevra","text":"Who authorized the transfer?"},
{"beat_id":"S007_B045","speaker_id":"custody_officer","text":"I did. Standard sealed-artifact custody."},
{"beat_id":"S007_B046","cues":{"staging":"Maevra studies the floor."}},
{"beat_id":"S007_B047","speaker_id":"maevra","text":"Reasonable."},
{"beat_id":"S007_B048","cues":{"staging":"She folds the writ."}},
{"beat_id":"S007_B049","speaker_id":"maevra","text":"Now obsolete."},
{"beat_id":"S007_B050","cues":{"staging":"The officer nods."}},
{"beat_id":"S007_B051","speaker_id":"custody_officer","text":"Agreed."},
{"beat_id":"S007_B052","speaker_id":"maevra","text":"Medical effect?"},
{"beat_id":"S007_B053","speaker_id":"ilyra","text":"Same pattern as the convoy. Faster."},
{"beat_id":"S007_B054","speaker_id":"maevra","text":"Pain?"},
{"beat_id":"S007_B055","speaker_id":"cyanis","text":"Enough."},
{"beat_id":"S007_B056","cues":{"staging":"Ilyra glances at him. He does not revise upward. Maevra notices but leaves it alone."}},
{"beat_id":"S007_B057","speaker_id":"custody_officer","text":"The writ requires secure custody."},
{"beat_id":"S007_B058","speaker_id":"maevra","text":"It has secure custody."},
{"beat_id":"S007_B059","cues":{"staging":"A glance toward the inner room."}},
{"beat_id":"S007_B060","speaker_id":"maevra","text":"The writ doesn't require us to repeat a procedure we now know is unsafe."},
{"beat_id":"S007_B061","cues":{"staging":"The officer considers that."}},
{"beat_id":"S007_B062","speaker_id":"custody_officer","text":"Outer yard. Double watch."},
{"beat_id":"S007_B063","speaker_id":"maevra","text":"Good."},
{"beat_id":"S007_B064","speaker_id":"maevra","text":"Nobody tests the distance again."},
{"beat_id":"S007_B065","cues":{"staging":"A mud-streaked scout enters carrying a message tube."}},
{"beat_id":"S007_B066","speaker_id":"scout","text":"Commander. East patrol."},
{"beat_id":"S007_B067","cues":{"staging":"Maevra opens the report."}},
{"beat_id":"S007_B068","speaker_id":"scout","text":"Fresh tracks around Hollow Watch. Heavy boots. Red fittings in the brush."},
{"beat_id":"S007_B069","speaker_id":"cyanis","text":"Host?"},
{"beat_id":"S007_B070","speaker_id":"scout","text":"Probably."},
{"beat_id":"S007_B071","speaker_id":"ilyra","text":"Casualties?"},
{"beat_id":"S007_B072","speaker_id":"scout","text":"One shoulder. Stone impact."},
{"beat_id":"S007_B073","speaker_id":"cyanis","text":"Stone?"},
{"beat_id":"S007_B074","cues":{"staging":"The scout hands Maevra a rubbing."}},
{"beat_id":"S007_B075","speaker_id":"scout","text":"Something moved inside the ruin. This was exposed under the stair."},
{"beat_id":"S007_B076","cues":{"staging":"The rubbing contains geometric branching lines. Ilyra compares them to the last fading trace on the yard floor."}},
{"beat_id":"S007_B077","speaker_id":"ilyra","text":"Not the same."},
{"beat_id":"S007_B078","speaker_id":"cyanis","text":"Close."},
{"beat_id":"S007_B079","speaker_id":"maevra","text":"Close is enough to inspect."},
{"beat_id":"S007_B080","cues":{"staging":"She folds the rubbing. Through the east gate, the same distant tower is visible. Now it has a name."}},
{"beat_id":"S007_B081","speaker_id":"maevra","text":"The casing stays here. Sealed."},
{"beat_id":"S007_B082","speaker_id":"maevra","text":"Get your patrol fed. Send someone who knows the lower approach to the east gate."},
{"beat_id":"S007_B083","cues":{"staging":"Then she turns to Cyanis and Ilyra."}},
{"beat_id":"S007_B084","speaker_id":"maevra","text":"You're coming with me."},
{"beat_id":"S007_B085","speaker_id":"cyanis","text":"I assumed that wasn't optional."},
{"beat_id":"S007_B086","speaker_id":"maevra","text":"Correct."},
{"beat_id":"S007_B087","speaker_id":"ilyra","text":"Why us?"},
{"beat_id":"S007_B088","speaker_id":"maevra","text":"You know what the artifact did to him."},
{"beat_id":"S007_B089","cues":{"staging":"To Cyanis:"}},
{"beat_id":"S007_B090","speaker_id":"maevra","text":"You know what happened around it before it reached Brackenwall."},
{"beat_id":"S007_B091","cues":{"staging":"She taps the folded writ."}},
{"beat_id":"S007_B092","speaker_id":"maevra","text":"And this remains my responsibility until I can finish the transfer safely."},
{"beat_id":"S007_B093","speaker_id":"ilyra","text":"If it happens again, we stop."},
{"beat_id":"S007_B094","speaker_id":"maevra","text":"Yes."},
{"beat_id":"S007_B095","speaker_id":"cyanis","text":"Works for me."},
{"beat_id":"S007_B096","speaker_id":"maevra","text":"East gate in ten."},
{"beat_id":"S007_B097","cues":{"staging":"PARTY UPDATE: MAEVRA SOLMAR - TEMPORARY PARTY MEMBER. No large tutorial wall. Brackenwall remains safe for restocking, saving, and voluntary menu inspection. On leaving the east gate: encounter pressure protected briefly, then standard; approximately 1-2 readable three-character encounters before Hollow Watch.","implementation_flags":["PARTY_UPDATE"]}},
{"beat_id":"S007_B098","speaker_id":"maevra","text":"Dovaren."},
{"beat_id":"S007_B099","speaker_id":"cyanis","text":"Commander."},
{"beat_id":"S007_B100","speaker_id":"maevra","text":"Do you always walk this fast?"},
{"beat_id":"S007_B101","speaker_id":"cyanis","text":"You told me ten minutes."},
{"beat_id":"S007_B102","cues":{"staging":"Maevra looks ahead."}},
{"beat_id":"S007_B103","speaker_id":"maevra","text":"Fair."},
{"beat_id":"S007_B104","cues":{"staging":"The conversation ends rather than searching for another joke."}}]
