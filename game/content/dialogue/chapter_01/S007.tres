[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "S007"
chapter_id = "chapter_01"
scene_kind = "mandatory"
location_id = "LOC_BRACKENWALL"
trigger_id = "trigger.chapter_01.s007"
completion_flag = "scene.s007.complete"
participants = Array[String](["cyanis", "ilyra", "sergeant", "custody_officer", "maevra", "scout"])
authoring_notes = "Chapter 1 exact Resource conversion from docs/chapters/dialogue/chapter_01/S007.md under Complete Master Canon v1.64 / Audit79. Spoken text is line-complete and must not be rewritten. Source production/staging prose is preserved in beat cue metadata; source subsection names are carried in cues.source_section. Portrait slots remain empty until approved registry expressions/assets are wired. Spoken-sequence SHA-256: d83e96a467bfd4abc406b93649fd5177ad75613413f699852cef857fee165f4d."
beats = [
{"beat_id": "S007_B001", "speaker_id": "cyanis", "text": "You said the road would improve.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRACKENWALL", "staging": "Morning.\n\nCheap 2.5D: one main Brackenwall hub kit with a gate street, repair/supply court and artifact yard. Medical/quartermaster activity is mostly background dressing and reused NPC loops.\n\nBrackenwall is busy, not devastated.\n\nWorkers replace damaged wall timber.\n\nA wagon is being repaired near the gate.\n\nSoldiers and civilians move through the same streets.\n\nThe broken shape of Hollow Watch is visible on the wooded ridge east of town.\n\nCyanis and Ilyra enter beside the sealed artifact wagon."}},
{"beat_id": "S007_B002", "speaker_id": "ilyra", "text": "I said it would flatten.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRACKENWALL"}},
{"beat_id": "S007_B003", "speaker_id": "cyanis", "text": "That's a shitty distinction.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRACKENWALL", "staging": "A supply cart hits a rut hard enough to rattle everything on it.\n\nCyanis looks at her."}},
{"beat_id": "S007_B004", "speaker_id": "ilyra", "text": "It's an accurate one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRACKENWALL"}},
{"beat_id": "S007_B005", "speaker_id": "sergeant", "text": "Convoy recovery?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRACKENWALL", "staging": "A SERGEANT approaches."}},
{"beat_id": "S007_B006", "speaker_id": "cyanis", "text": "What's left of it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRACKENWALL", "staging": "Cyanis looks at what remains of the wagon."}},
{"beat_id": "S007_B007", "speaker_id": "sergeant", "text": "Artifact yard. Second court.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRACKENWALL", "staging": "The Sergeant checks the seal.\n\nDoesn't touch it."}},
{"beat_id": "S007_B008", "speaker_id": "ilyra", "text": "Who's receiving it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRACKENWALL"}},
{"beat_id": "S007_B009", "speaker_id": "sergeant", "text": "Custody detail.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRACKENWALL"}},
{"beat_id": "S007_B010", "speaker_id": "cyanis", "text": "That sounds comforting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRACKENWALL"}},
{"beat_id": "S007_B011", "speaker_id": "sergeant", "text": "Wasn't meant to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRACKENWALL", "staging_after": "The Sergeant moves on."}},
{"beat_id": "S007_B012", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "Encounter state: SAFE.\n\nThe critical route to the artifact yard is short.\n\nThe player is free to spend longer looking around.\n\nAvailable first-visit functions can include:\n\n**• save/rest;**\n\n**• resupply;**\n\n**• quartermaster;**\n\n**• workshop access;**\n\n**• medical/service court;**\n\n**• small side courts and dead ends;**\n\n**• civilian and military NPCs;**\n\n**• repeated sightlines toward Hollow Watch.**\n\nNo mandatory lore tour.\n\nNobody stops Cyanis every twenty feet to explain the town.\n\nThe player reaches the artifact yard when ready.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING", "RETURN_PLAYER_CONTROL", "SAFE_DIALOGUE_POCKET"], "source_section": "PLAYER CONTROL — BRACKENWALL"}},
{"beat_id": "S007_B013", "speaker_id": "custody_officer", "text": "Broken since recovery?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY", "staging": "The sealed casing is brought into the outer artifact yard.\n\nA CUSTODY OFFICER checks the seal."}},
{"beat_id": "S007_B014", "speaker_id": "cyanis", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY"}},
{"beat_id": "S007_B015", "speaker_id": "ilyra", "text": "It reacted after we sealed it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY"}},
{"beat_id": "S007_B016", "speaker_id": "ilyra", "text": "So did he.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY", "staging": "The Officer looks at her.\n\nIlyra indicates Cyanis."}},
{"beat_id": "S007_B017", "speaker_id": "cyanis", "text": "You could make that sound less fucking ominous.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY", "staging": "Cyanis looks at her."}},
{"beat_id": "S007_B018", "speaker_id": "ilyra", "text": "Could.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY"}},
{"beat_id": "S007_B019", "speaker_id": "custody_officer", "text": "Standard procedure is inner-ward inspection.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY", "staging": "The Officer records it."}},
{"beat_id": "S007_B020", "speaker_id": "custody_officer", "text": "You stay outside until containment clears.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY", "staging": "He points toward a marked line on the floor."}},
{"beat_id": "S007_B021", "speaker_id": "cyanis", "text": "Fine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY", "staging": "Cyanis shrugs."}},
{"beat_id": "S007_B022", "speaker_id": "ilyra", "text": "I'm staying with him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY"}},
{"beat_id": "S007_B023", "speaker_id": "custody_officer", "text": "Fine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY", "staging": "The Officer looks between them."}},
{"beat_id": "S007_B024", "speaker_id": "cyanis", "text": "Stop.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY", "staging": "No argument.\n\nNo authority performance.\n\nThe transfer crew takes the casing.\n\nThey move it toward the inner ward.\n\nOne step.\n\nTwo.\n\nThen—\n\nA thin green-and-gold geometric pattern appears beneath the casing.\n\nNot a creature.\n\nNot a voice.\n\nNot a manifestation.\n\nSimple animated linework across the existing floor texture.\n\nIt extends toward Cyanis.\n\nCyanis catches the edge of the table."}},
{"beat_id": "S007_B025", "speaker_id": "ilyra", "text": "Stop.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY"}},
{"beat_id": "S007_B026", "speaker_id": "ilyra", "text": "Eyes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY", "staging": "The crew immediately freezes.\n\nIlyra moves beside him."}},
{"beat_id": "S007_B027", "speaker_id": "ilyra", "text": "Pressure?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY", "staging": "He looks at her."}},
{"beat_id": "S007_B028", "speaker_id": "cyanis", "text": "Behind them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY"}},
{"beat_id": "S007_B029", "speaker_id": "ilyra", "text": "Pain?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY"}},
{"beat_id": "S007_B030", "speaker_id": "cyanis", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY"}},
{"beat_id": "S007_B031", "speaker_id": "custody_officer", "text": "Back it up.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY", "staging": "The Custody Officer looks from Cyanis to the geometry."}},
{"beat_id": "S007_B032", "speaker_id": "ilyra", "text": "Better?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY", "staging": "The crew moves the casing back.\n\nThe geometric line retracts.\n\nNo explosion.\n\nNo giant magical cinematic.\n\nIt simply disappears as the distance increases.\n\nCyanis exhales.\n\nIlyra watches him."}},
{"beat_id": "S007_B033", "speaker_id": "cyanis", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY"}},
{"beat_id": "S007_B034", "speaker_id": "custody_officer", "text": "That's new.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY", "staging": "The Officer stares at the floor."}},
{"beat_id": "S007_B035", "speaker_id": "cyanis", "text": "Been a productive couple of days.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — CUSTODY"}},
{"beat_id": "S007_B036", "speaker_id": "maevra", "text": "Who authorized the transfer?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA", "staging": "Maevra enters the yard with two soldiers.\n\nNo hero entrance.\n\nNo dramatic camera orbit.\n\nThe guards straighten because they know who she is.\n\nShe has a transfer writ in hand.\n\nShe sees:\n\nthe stopped casing,\n\nthe crew,\n\nCyanis,\n\nIlyra,\n\nthe fading last trace on the floor."}},
{"beat_id": "S007_B037", "speaker_id": "custody_officer", "text": "I did. Standard sealed-artifact custody.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA", "staging": "The Custody Officer answers immediately."}},
{"beat_id": "S007_B038", "speaker_id": "maevra", "text": "Reasonable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA", "staging": "Maevra looks at the original marked transfer path.\n\nThen at Cyanis.\n\nThen back to the Officer."}},
{"beat_id": "S007_B039", "speaker_id": "maevra", "text": "Now obsolete.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA", "staging": "She folds the writ."}},
{"beat_id": "S007_B040", "speaker_id": "custody_officer", "text": "Agreed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA", "staging": "The Officer nods once."}},
{"beat_id": "S007_B041", "speaker_id": "maevra", "text": "What happened?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA", "staging": "That is the whole authority conflict.\n\nNobody gets humiliated for following a procedure that was reasonable before the facts changed.\n\nMaevra turns to Ilyra."}},
{"beat_id": "S007_B042", "speaker_id": "ilyra", "text": "Same pressure response as before.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA"}},
{"beat_id": "S007_B043", "speaker_id": "maevra", "text": "Worse?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA"}},
{"beat_id": "S007_B044", "speaker_id": "ilyra", "text": "Faster.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA"}},
{"beat_id": "S007_B045", "speaker_id": "maevra", "text": "How bad?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA", "staging": "Maevra looks at Cyanis."}},
{"beat_id": "S007_B046", "speaker_id": "cyanis", "text": "Manageable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA"}},
{"beat_id": "S007_B047", "speaker_id": "cyanis", "text": "Don't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA", "staging": "Ilyra looks at him.\n\nCyanis sees it."}},
{"beat_id": "S007_B048", "speaker_id": "ilyra", "text": "Didn't say anything.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA"}},
{"beat_id": "S007_B049", "speaker_id": "cyanis", "text": "Your face did.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA"}},
{"beat_id": "S007_B050", "speaker_id": "maevra", "text": "Keep it in the outer yard.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA", "staging": "Maevra catches the exchange.\n\nDoes not interfere.\n\nShe turns back to the Custody Officer."}},
{"beat_id": "S007_B051", "speaker_id": "custody_officer", "text": "The writ requires secure custody.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA"}},
{"beat_id": "S007_B052", "speaker_id": "maevra", "text": "It has secure custody.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA"}},
{"beat_id": "S007_B053", "speaker_id": "maevra", "text": "It doesn't require us to repeat something we now know hurts him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA", "staging": "Beat."}},
{"beat_id": "S007_B054", "speaker_id": "custody_officer", "text": "Outer yard. Double watch.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA", "staging": "The Officer considers that."}},
{"beat_id": "S007_B055", "speaker_id": "maevra", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA"}},
{"beat_id": "S007_B056", "speaker_id": "maevra", "text": "Nobody tests the distance again.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — MAEVRA", "staging": "She looks at the crew."}},
{"beat_id": "S007_B057", "speaker_id": "scout", "text": "Commander.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH", "staging": "A SCOUT enters with a message tube.\n\nMud up the legs.\n\nOut of breath, but not collapsing theatrically."}},
{"beat_id": "S007_B058", "speaker_id": "maevra", "text": "East patrol?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH", "staging": "Maevra takes the report."}},
{"beat_id": "S007_B059", "speaker_id": "scout", "text": "Hollow Watch.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH"}},
{"beat_id": "S007_B060", "speaker_id": "scout", "text": "Fresh tracks around the ruin. Heavy boots. Red fittings.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH", "staging": "That gets everyone's attention."}},
{"beat_id": "S007_B061", "speaker_id": "cyanis", "text": "Black Host?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH"}},
{"beat_id": "S007_B062", "speaker_id": "scout", "text": "Looks like it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH"}},
{"beat_id": "S007_B063", "speaker_id": "ilyra", "text": "Who got hit?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH", "staging": "Ilyra looks at the mud and blood on the Scout's shoulder."}},
{"beat_id": "S007_B064", "speaker_id": "scout", "text": "Me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH", "staging": "The Scout touches the dressing."}},
{"beat_id": "S007_B065", "speaker_id": "ilyra", "text": "By what?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH"}},
{"beat_id": "S007_B066", "speaker_id": "scout", "text": "Stone.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH"}},
{"beat_id": "S007_B067", "speaker_id": "cyanis", "text": "Somebody threw a rock at you?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH", "staging": "Cyanis looks toward Hollow Watch."}},
{"beat_id": "S007_B068", "speaker_id": "scout", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH"}},
{"beat_id": "S007_B069", "speaker_id": "scout", "text": "Something inside moved.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH", "staging": "Beat."}},
{"beat_id": "S007_B070", "speaker_id": "ilyra", "text": "Not the same.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH", "staging": "He hands Maevra a rubbing.\n\nBranching geometric lines.\n\nNot identical to what just appeared in the yard.\n\nClose enough to be uncomfortable.\n\nIlyra looks at it.\n\nThen at the floor."}},
{"beat_id": "S007_B071", "speaker_id": "cyanis", "text": "Close.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH"}},
{"beat_id": "S007_B072", "speaker_id": "maevra", "text": "Close is enough to inspect.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — HOLLOW WATCH", "staging": "Maevra studies the rubbing.", "staging_after": "No one identifies the pattern as a Face.\n\nNo First Champion.\n\nNo Prime terminology.\n\nNo sudden lore revelation."}},
{"beat_id": "S007_B073", "speaker_id": "maevra", "text": "The casing stays here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE HANDOFF", "staging": "Maevra returns the rubbing to its tube."}},
{"beat_id": "S007_B074", "speaker_id": "maevra", "text": "Get fed. Have somebody who knows the lower approach report to the east gate.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE HANDOFF", "staging": "To the Scout:"}},
{"beat_id": "S007_B075", "speaker_id": "scout", "text": "Yes, Commander.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE HANDOFF"}},
{"beat_id": "S007_B076", "speaker_id": "maevra", "text": "You're coming with me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE HANDOFF", "staging": "He leaves.\n\nMaevra turns to Cyanis and Ilyra."}},
{"beat_id": "S007_B077", "speaker_id": "cyanis", "text": "I assumed that wasn't optional.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE HANDOFF"}},
{"beat_id": "S007_B078", "speaker_id": "maevra", "text": "Correct.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE HANDOFF"}},
{"beat_id": "S007_B079", "speaker_id": "ilyra", "text": "Why us?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE HANDOFF", "staging": "Ilyra folds her arms."}},
{"beat_id": "S007_B080", "speaker_id": "maevra", "text": "Because you know what happened when that thing moved.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE HANDOFF", "staging": "Maevra points toward Cyanis."}},
{"beat_id": "S007_B081", "speaker_id": "maevra", "text": "And you know what it did to him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE HANDOFF", "staging": "Then to Ilyra:"}},
{"beat_id": "S007_B082", "speaker_id": "ilyra", "text": "If it happens again, we stop.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE HANDOFF"}},
{"beat_id": "S007_B083", "speaker_id": "maevra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE HANDOFF"}},
{"beat_id": "S007_B084", "speaker_id": "cyanis", "text": "When?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE HANDOFF", "staging": "No argument.\n\nCyanis looks toward Hollow Watch."}},
{"beat_id": "S007_B085", "speaker_id": "maevra", "text": "East gate. Ten minutes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE HANDOFF"}},
{"beat_id": "S007_B086", "speaker_id": "cyanis", "text": "I like how everybody keeps giving me ten minutes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE HANDOFF", "staging": "She walks away.\n\nCyanis watches her go."}},
{"beat_id": "S007_B087", "speaker_id": "ilyra", "text": "You keep surviving them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE HANDOFF"}},
{"beat_id": "S007_B088", "speaker_id": "cyanis", "text": "So far.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — THE HANDOFF"}},
{"beat_id": "S007_B089", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "**MAEVRA SOLMAR — TEMPORARY PARTY MEMBER**\n\nNo giant tutorial wall.\n\nBrackenwall remains fully available before departure.\n\nThe player can:\n\nsave,\n\nrest,\n\nshop/resupply,\n\nexplore unfinished side spaces,\n\nor head directly for the east gate.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "PARTY UPDATE"}},
{"beat_id": "S007_B090", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "When the player leaves Brackenwall, the safe-state ends.\n\nThis is the campaign's transition into normal hostile random-encounter territory.\n\nThe Hollow Watch Approach is a moderate road/wilderness stretch, not a ten-step connector and not a huge field.\n\nCheap 2.5D environment reuse:\n\n**• main wooded road;**\n\n**• one small side loop;**\n\n**• one elevated/cleared sightline toward Hollow Watch;**\n\n**• a minor supply/reward pocket;**\n\n**• alternate dressing rather than bespoke environment sets.**\n\nA normal first pass should produce roughly 2–3 likely random encounters, depending on encounter rolls and exploration.\n\nNo rigid required battle count.\n\nNo battle every thirty seconds.\n\nThe player gets enough space to use the new three-character configuration before S008.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "B006 — EAST GATE"}},
{"beat_id": "S007_B091", "speaker_id": "maevra", "text": "Dovaren.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — FIELD EXCHANGE", "staging": "After the party has been walking for a little while, during a safe dialogue window:"}},
{"beat_id": "S007_B092", "speaker_id": "cyanis", "text": "Commander.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — FIELD EXCHANGE"}},
{"beat_id": "S007_B093", "speaker_id": "maevra", "text": "Do you always walk this fast?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — FIELD EXCHANGE"}},
{"beat_id": "S007_B094", "speaker_id": "cyanis", "text": "You told me ten minutes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — FIELD EXCHANGE", "staging": "Cyanis looks at her."}},
{"beat_id": "S007_B095", "speaker_id": "maevra", "text": "Fair.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — FIELD EXCHANGE", "staging": "Maevra looks ahead.", "staging_after": "That's it.\n\nNo extra punch line.\n\nWalking continues.\n\nNormal encounter pressure resumes after the dialogue buffer."}},
{"beat_id": "S007_B096", "speaker_id": "maevra", "text": "Same as the patrol report.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — HOLLOW WATCH APPROACH", "staging": "As the party gets closer, the tower becomes larger in the background.\n\nThe road grows less maintained.\n\nFresh boot prints begin appearing in the mud.\n\nA broken piece of red-black fitting lies near the path.\n\nMaevra crouches briefly.\n\nExisting crouch pose."}},
{"beat_id": "S007_B097", "speaker_id": "ilyra", "text": "Anyone supposed to be in there?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — HOLLOW WATCH APPROACH", "staging": "Ilyra looks toward the tower."}},
{"beat_id": "S007_B098", "speaker_id": "maevra", "text": "Not anymore.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — HOLLOW WATCH APPROACH"}},
{"beat_id": "S007_B099", "speaker_id": "cyanis", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — HOLLOW WATCH APPROACH", "staging": "Cyanis looks at the open lower approach."}},
{"beat_id": "S007_B100", "speaker_id": "cyanis", "text": "That would've been inconvenient.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — HOLLOW WATCH APPROACH", "staging": "Beat."}},
{"beat_id": "S007_B101", "speaker_id": "maevra", "text": "We're close.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "PARTY_ADD_MAEVRA_GUEST"], "source_section": "B008 — HOLLOW WATCH APPROACH", "staging": "Maevra stands.", "staging_after": "From this point, random encounter pressure shuts off for the short authored approach into S008.\n\nThe party advances.\n\nHollow Watch fills the background.\n\nFade/transition.\n\n**END S007.**\n\nTransition to S008 — Hollow Watch / What Woke Up."}}
]
