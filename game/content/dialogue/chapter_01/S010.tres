[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "S010"
chapter_id = "chapter_01"
scene_kind = "mandatory"
location_id = "LOC_BRIAR_PASSAGE"
trigger_id = "trigger.chapter_01.s010"
completion_flag = "scene.s010.complete"
participants = Array[String](["cyanis", "torren", "maevra", "ilyra"])
authoring_notes = "Chapter 1 exact Resource conversion from docs/chapters/dialogue/chapter_01/S010.md under Complete Master Canon v1.64 / Audit79. Spoken text is line-complete and must not be rewritten. Source production/staging prose is preserved in beat cue metadata; source subsection names are carried in cues.source_section. Portrait slots remain empty until approved registry expressions/assets are wired. Spoken-sequence SHA-256: 180cb8dfdbeb0ef37858d24b213d5506ce9699a8e5f39841d2f17cec9b4aff5e."
beats = [
{"beat_id": "S010_B001", "speaker_id": "cyanis", "text": "Another new one?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRIAR PASSAGE", "staging": "The maintained Greenhollow road gives way to older route stone.\n\nAcross the ridge, Wayfinder Junction appears between the trees occasionally.\n\nThe player can see where they are ultimately going long before they can reach it.\n\nTorren stops beside a marker."}},
{"beat_id": "S010_B002", "speaker_id": "torren", "text": "Old one moved.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRIAR PASSAGE"}},
{"beat_id": "S010_B003", "speaker_id": "maevra", "text": "Third?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRIAR PASSAGE", "staging": "Maevra looks at it."}},
{"beat_id": "S010_B004", "speaker_id": "torren", "text": "Third.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRIAR PASSAGE"}},
{"beat_id": "S010_B005", "speaker_id": "ilyra", "text": "How recent?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRIAR PASSAGE", "staging": "Ilyra looks at the disturbed ground."}},
{"beat_id": "S010_B006", "speaker_id": "torren", "text": "Day or two.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRIAR PASSAGE", "staging": "Torren crouches."}},
{"beat_id": "S010_B007", "speaker_id": "maevra", "text": "Host?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRIAR PASSAGE"}},
{"beat_id": "S010_B008", "speaker_id": "torren", "text": "Maybe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRIAR PASSAGE", "staging": "Torren looks at the fastening.\n\nThe mud.\n\nThe surrounding brush."}},
{"beat_id": "S010_B009", "speaker_id": "maevra", "text": "Keep going.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — BRIAR PASSAGE", "staging": "Maevra nods.\n\nThat's enough.\n\nNobody makes him defend the word.", "staging_after": "Control returns."}},
{"beat_id": "S010_B010", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "A moderate hostile field stretch.\n\nNot a corridor, but not a giant open zone either.\n\nCheap 2.5D uses one Briar Passage forest/stone-road kit with:\n\n**• old route stones;**\n\n**• overgrown sections;**\n\n**• one higher shelf;**\n\n**• shallow drainage;**\n\n**• one short side loop;**\n\n**• one optional reward pocket;**\n\n**• Wayfinder Junction periodically visible across the ridge.**\n\nNormal wilderness random encounters begin after the short entry buffer.\n\nThere is no forced 'first four-person tutorial fight.'\n\nThe player simply gets to use Torren normally as the fourth party member.\n\nA direct route should still give enough room for several ordinary fights to happen naturally; exploration may produce more.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "EXPLORATION 1 — UPPER PASSAGE"}},
{"beat_id": "S010_B011", "speaker_id": "cyanis", "text": "Does everything here grab you?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — AFTER A FIGHT", "staging": "During an eligible postbattle walking window:\n\nCyanis cleans sticky vine residue from his sword."}},
{"beat_id": "S010_B012", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — AFTER A FIGHT"}},
{"beat_id": "S010_B013", "speaker_id": "ilyra", "text": "Some things bite.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — AFTER A FIGHT", "staging": "Cyanis waits.\n\nTorren keeps checking his bowstring.\n\nNothing else comes.\n\nIlyra walks past.", "staging_after": "Cyanis looks at her.\n\nShe keeps walking.\n\nThat's it.\n\nControl remains with the player."}},
{"beat_id": "S010_B014", "speaker_id": "cyanis", "text": "Natural?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — FALSE TRAIL", "staging": "A safe environmental pocket interrupts encounter pressure.\n\nA route marker points toward what looks like a usable trail.\n\nTorren stops.\n\nHe picks up a small stone and throws it onto the path.\n\nThe leaf cover drops into a concealed hole.\n\nNo QTE.\n\nNo damage.\n\nNo surprise combat turn.\n\nCyanis looks down."}},
{"beat_id": "S010_B015", "speaker_id": "torren", "text": "Hole is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — FALSE TRAIL"}},
{"beat_id": "S010_B016", "speaker_id": "torren", "text": "Cover isn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — FALSE TRAIL", "staging": "Torren points at the arranged brush."}},
{"beat_id": "S010_B017", "speaker_id": "maevra", "text": "Not meant to kill.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — FALSE TRAIL", "staging": "Maevra studies it."}},
{"beat_id": "S010_B018", "speaker_id": "ilyra", "text": "Enough to injure somebody.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — FALSE TRAIL", "staging": "Ilyra looks at the depth."}},
{"beat_id": "S010_B019", "speaker_id": "torren", "text": "Or make people stop trusting the markers.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — FALSE TRAIL", "staging": "Torren looks at the rotated route marker."}},
{"beat_id": "S010_B020", "speaker_id": "maevra", "text": "Same method as Greenhollow?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — FALSE TRAIL", "staging": "Nobody jokes about that.\n\nMaevra looks back the way they came."}},
{"beat_id": "S010_B021", "speaker_id": "torren", "text": "Looks like.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — FALSE TRAIL"}},
{"beat_id": "S010_B022", "speaker_id": "maevra", "text": "Looks like?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — FALSE TRAIL"}},
{"beat_id": "S010_B023", "speaker_id": "torren", "text": "I wasn't here when they did it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — FALSE TRAIL"}},
{"beat_id": "S010_B024", "speaker_id": "maevra", "text": "Fair.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — FALSE TRAIL", "staging": "Maevra nods.", "staging_after": "They continue."}},
{"beat_id": "S010_B025", "speaker_id": "torren", "text": "Dovaren. Left.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — LEFT", "staging": "Later, during another safe walking window:\n\nTorren looks above Cyanis.\n\nHis expression changes."}},
{"beat_id": "S010_B026", "speaker_id": "cyanis", "text": "You could have said why.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — LEFT", "staging": "Cyanis immediately steps left.\n\nA heavy dead branch drops where he was walking.\n\nSimple foreground/environment animation.\n\nNo damage.\n\nCyanis looks at Torren."}},
{"beat_id": "S010_B027", "speaker_id": "torren", "text": "Would have taken longer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — LEFT", "staging_after": "From behind them, Maevra snorts once.\n\nNot quite a laugh.\n\nCyanis turns.\n\nMaevra is suddenly extremely interested in the road ahead.\n\nCyanis looks at Ilyra.\n\nIlyra saw it.\n\nShe gives him nothing.\n\nCyanis turns back around.\n\nConversation over."}},
{"beat_id": "S010_B028", "speaker_id": "maevra", "text": "Which?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — ROUTE SPLIT", "staging": "The party reaches a broad overlook.\n\nEncounter pressure shuts off.\n\nTwo routes are physically readable.\n\nUpper shelf\n\nShorter.\n\nHigher.\n\nRecently damaged.\n\nNarrow enough that extracting an injured person would be difficult.\n\nLower causeway\n\nLonger.\n\nWider.\n\nFresh boot traffic.\n\nMore cover.\n\nMore possible exits.\n\nRain is approaching.\n\nTorren studies both.\n\nMaevra waits."}},
{"beat_id": "S010_B029", "speaker_id": "torren", "text": "Don't know yet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — ROUTE SPLIT"}},
{"beat_id": "S010_B030", "speaker_id": "cyanis", "text": "What do we know?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — ROUTE SPLIT", "staging": "Cyanis looks at both routes."}},
{"beat_id": "S010_B031", "speaker_id": "torren", "text": "Upper's faster.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — ROUTE SPLIT", "staging": "Torren points up."}},
{"beat_id": "S010_B032", "speaker_id": "torren", "text": "Rock under it is probably sound.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — ROUTE SPLIT", "staging": "He studies the remaining shelf."}},
{"beat_id": "S010_B033", "speaker_id": "maevra", "text": "Probably.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — ROUTE SPLIT"}},
{"beat_id": "S010_B034", "speaker_id": "torren", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — ROUTE SPLIT", "staging": "Torren looks at her."}},
{"beat_id": "S010_B035", "speaker_id": "ilyra", "text": "If somebody gets hurt on the far side, can we bring them back through that?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — ROUTE SPLIT", "staging": "No apology.\n\nIlyra studies the narrow section."}},
{"beat_id": "S010_B036", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — ROUTE SPLIT", "staging": "Torren looks again.\n\nLonger this time."}},
{"beat_id": "S010_B037", "speaker_id": "maevra", "text": "Rain?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — ROUTE SPLIT", "staging": "Ilyra nods.\n\nThat's information, not victory.\n\nMaevra looks at the sky."}},
{"beat_id": "S010_B038", "speaker_id": "torren", "text": "Makes the shelf worse.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — ROUTE SPLIT"}},
{"beat_id": "S010_B039", "speaker_id": "cyanis", "text": "Tracks?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — ROUTE SPLIT", "staging": "Cyanis looks toward the lower causeway."}},
{"beat_id": "S010_B040", "speaker_id": "torren", "text": "Boots.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — ROUTE SPLIT"}},
{"beat_id": "S010_B041", "speaker_id": "torren", "text": "Can't identify them from here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — ROUTE SPLIT", "staging": "Beat."}},
{"beat_id": "S010_B042", "speaker_id": "cyanis", "text": "Can you scout both?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — ROUTE SPLIT"}},
{"beat_id": "S010_B043", "speaker_id": "torren", "text": "Not properly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — ROUTE SPLIT", "staging": "Torren looks at the sky.\n\nThen the routes."}},
{"beat_id": "S010_B044", "speaker_id": "maevra", "text": "How much time would you want?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — ROUTE SPLIT", "staging": "Maevra doesn't tell him to try harder."}},
{"beat_id": "S010_B045", "speaker_id": "torren", "text": "Hour.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — ROUTE SPLIT"}},
{"beat_id": "S010_B046", "speaker_id": "maevra", "text": "We don't have it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — ROUTE SPLIT", "staging": "Maevra looks east.", "staging_after": "Torren knows.\n\nHe doesn't like it.\n\nNobody fills the silence for him."}},
{"beat_id": "S010_B047", "speaker_id": "torren", "text": "Upper's faster.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE ROUTE HE WOULD TAKE", "staging": "Torren looks at the upper shelf again."}},
{"beat_id": "S010_B048", "speaker_id": "torren", "text": "She's right about getting somebody back out.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE ROUTE HE WOULD TAKE", "staging": "He looks toward Ilyra."}},
{"beat_id": "S010_B049", "speaker_id": "torren", "text": "Lower gives us more room.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE ROUTE HE WOULD TAKE", "staging": "Then the lower route."}},
{"beat_id": "S010_B050", "speaker_id": "torren", "text": "More ways out if the tracks are hostile.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE ROUTE HE WOULD TAKE", "staging": "Beat."}},
{"beat_id": "S010_B051", "speaker_id": "cyanis", "text": "Which would you take?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE ROUTE HE WOULD TAKE", "staging": "Cyanis looks at him."}},
{"beat_id": "S010_B052", "speaker_id": "torren", "text": "I don't know enough.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE ROUTE HE WOULD TAKE"}},
{"beat_id": "S010_B053", "speaker_id": "cyanis", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE ROUTE HE WOULD TAKE"}},
{"beat_id": "S010_B054", "speaker_id": "cyanis", "text": "Which would you take?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE ROUTE HE WOULD TAKE", "staging": "Torren looks at him.\n\nCyanis doesn't change the question."}},
{"beat_id": "S010_B055", "speaker_id": "torren", "text": "Lower.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE ROUTE HE WOULD TAKE", "staging": "A beat."}},
{"beat_id": "S010_B056", "speaker_id": "cyanis", "text": "Why?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE ROUTE HE WOULD TAKE"}},
{"beat_id": "S010_B057", "speaker_id": "torren", "text": "Because armed people are a problem I understand.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE ROUTE HE WOULD TAKE"}},
{"beat_id": "S010_B058", "speaker_id": "torren", "text": "I don't negotiate with a hillside.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE ROUTE HE WOULD TAKE", "staging": "He looks toward the broken upper shelf."}},
{"beat_id": "S010_B059", "speaker_id": "torren", "text": "I can't promise the route.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE ROUTE HE WOULD TAKE", "staging": "Maevra nearly says something.\n\nDoesn't.\n\nTorren continues."}},
{"beat_id": "S010_B060", "speaker_id": "torren", "text": "This is the one I would take.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE ROUTE HE WOULD TAKE", "staging": "Beat."}},
{"beat_id": "S010_B061", "speaker_id": "cyanis", "text": "Good enough.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE ROUTE HE WOULD TAKE", "staging": "Cyanis nods."}},
{"beat_id": "S010_B062", "speaker_id": "maevra", "text": "Lower route.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — THE ROUTE HE WOULD TAKE", "staging": "That matters.\n\nMaevra looks at the lower path.", "staging_after": "Control returns.\n\nThe party does not get a fake player choice after the authored decision."}},
{"beat_id": "S010_B063", "speaker_id": "cyanis", "text": "Host?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 2 — LOWER CAUSEWAY", "staging": "This is the larger of S010's two playable stretches, but still moderate rather than huge.\n\nThe same environment family is recomposed into:\n\n**• lower stone road;**\n\n**• wooded embankment;**\n\n**• an old drainage crossing;**\n\n**• one short branch/loop;**\n\n**• a wider ruined route section;**\n\n**• the final old timber-and-stone crossing.**\n\nRandom encounters resume naturally.\n\nNo quota.\n\nThe direct path should usually expose the player to a few ordinary fights, while side exploration can add more.\n\nOne branch can contain a tougher optional formation or useful reward.\n\nNo bespoke mini-dungeon.\n\nAs the player progresses, evidence becomes clearer without stopping for dialogue every time:\n\ncut brush,\n\nboot marks,\n\nbroken load strap,\n\nblack-red residue,\n\nheavy drag marks.\n\nEventually Cyanis looks down at a clear print."}},
{"beat_id": "S010_B064", "speaker_id": "torren", "text": "Probably.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "EXPLORATION 2 — LOWER CAUSEWAY", "staging": "Torren crouches.\n\nThis time there is enough evidence.", "staging_after": "Maevra nods.\n\nNobody says, See, you were right.\n\nThe evidence changed.\n\nSo did the answer."}},
{"beat_id": "S010_B065", "speaker_id": "maevra", "text": "Confirmed Host logistics route.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING", "staging": "The lower causeway reaches an old timber-and-stone span.\n\nSeveral reinforcement braces have been removed.\n\nThe deck itself is still standing.\n\nThe Black Host tracks crossed it eastward.\n\nTorren checks the remaining structure.\n\nMaevra examines the tracks."}},
{"beat_id": "S010_B066", "speaker_id": "maevra", "text": "Standing field order is to deny a route we can't hold.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING", "staging": "She looks across the span.\n\nThen west, toward Greenhollow."}},
{"beat_id": "S010_B067", "speaker_id": "cyanis", "text": "Meaning?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING", "staging": "Cyanis looks at the bridge."}},
{"beat_id": "S010_B068", "speaker_id": "maevra", "text": "Drop the span.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING"}},
{"beat_id": "S010_B069", "speaker_id": "torren", "text": "Greenhollow uses this crossing when the river road floods.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING", "staging": "Torren looks up immediately."}},
{"beat_id": "S010_B070", "speaker_id": "ilyra", "text": "For carts too?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING", "staging": "Ilyra looks at him."}},
{"beat_id": "S010_B071", "speaker_id": "torren", "text": "Carts. Litters.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING"}},
{"beat_id": "S010_B072", "speaker_id": "torren", "text": "Anyone who can't take the shelf.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING", "staging": "Beat."}},
{"beat_id": "S010_B073", "speaker_id": "maevra", "text": "Dovaren.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING", "staging": "Maevra looks at the crossing again.\n\nThat information matters.\n\nIt does not automatically erase the military problem."}},
{"beat_id": "S010_B074", "speaker_id": "maevra", "text": "Cut the remaining braces.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING", "staging": "Cyanis looks at her."}},
{"beat_id": "S010_B075", "speaker_id": "cyanis", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING", "staging": "Cyanis doesn't move.\n\nHe looks toward Greenhollow.\n\nThen the span."}},
{"beat_id": "S010_B076", "speaker_id": "maevra", "text": "That's an order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING", "staging": "Silence.\n\nMaevra looks at him."}},
{"beat_id": "S010_B077", "speaker_id": "cyanis", "text": "Then I'm refusing it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING"}},
{"beat_id": "S010_B078", "speaker_id": "maevra", "text": "Reason.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING", "staging": "Maevra does not raise her voice."}},
{"beat_id": "S010_B079", "speaker_id": "cyanis", "text": "I'm not trading their way out for our cleaner fight.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING", "staging": "Cyanis answers immediately."}},
{"beat_id": "S010_B080", "speaker_id": "maevra", "text": "That leaves the Host a usable route behind us.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING", "staging": "Beat."}},
{"beat_id": "S010_B081", "speaker_id": "cyanis", "text": "Then we take the harder problem.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING"}},
{"beat_id": "S010_B082", "speaker_id": "maevra", "text": "Ours?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING"}},
{"beat_id": "S010_B083", "speaker_id": "cyanis", "text": "Ours.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING"}},
{"beat_id": "S010_B084", "speaker_id": "maevra", "text": "I have your refusal.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING", "staging": "Torren says nothing.\n\nIlyra says nothing.\n\nNeither piles onto Maevra.\n\nMaevra looks at Cyanis for a moment.\n\nThen back at the span."}},
{"beat_id": "S010_B085", "speaker_id": "cyanis", "text": "You do.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING"}},
{"beat_id": "S010_B086", "speaker_id": "maevra", "text": "We leave it standing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING", "staging": "Another beat."}},
{"beat_id": "S010_B087", "speaker_id": "maevra", "text": "If they come back through it, we hold what we chose to preserve.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING", "staging": "She looks toward the eastern end."}},
{"beat_id": "S010_B088", "speaker_id": "cyanis", "text": "Understood.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — THE CROSSING", "staging_after": "That's the end of the disagreement.\n\nNobody congratulates Cyanis.\n\nNobody tells Maevra she learned a lesson.\n\nThey now own the additional tactical risk together."}},
{"beat_id": "S010_B089", "speaker_id": "ilyra", "text": "Will it hold us?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — ONE AT A TIME", "staging": "Torren inspects multiple supports.\n\nIlyra watches him."}},
{"beat_id": "S010_B090", "speaker_id": "torren", "text": "One at a time.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — ONE AT A TIME"}},
{"beat_id": "S010_B091", "speaker_id": "torren", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — ONE AT A TIME", "staging": "Torren crosses first.\n\nCheap 2.5D: simple authored walk across the existing span. No balance mechanic, no precision platforming, no special traversal system.\n\nMaevra waits.\n\nShe does not tell him to hurry.\n\nShe does not step onto the span until Torren reaches the far side.\n\nHe looks back.", "staging_after": "Maevra crosses next.\n\nCyanis notices the automatic sequence between them.\n\nHe says nothing.\n\nIlyra crosses.\n\nCyanis comes last."}},
{"beat_id": "S010_B092", "speaker_id": "maevra", "text": "Same system.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — OLD WAYSTONE", "staging": "Beyond the crossing is a small protected recess.\n\nNo encounters.\n\nAn old route marker is built directly into the rock.\n\nThe same geometric route language seen at Hollow Watch appears here.\n\nMaevra takes out the rubbing.\n\nHolds it beside the marker."}},
{"beat_id": "S010_B093", "speaker_id": "torren", "text": "Same routes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — OLD WAYSTONE", "staging": "Torren studies the route channels."}},
{"beat_id": "S010_B094", "speaker_id": "cyanis", "text": "Where do they meet?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — OLD WAYSTONE", "staging": "Cyanis looks toward the ridge."}},
{"beat_id": "S010_B095", "speaker_id": "torren", "text": "There.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — OLD WAYSTONE", "staging": "Torren points.\n\nWayfinder Junction is now clearly visible.", "staging_after": "No lore dump.\n\nNo hidden Network explanation.\n\nJust geography."}},
{"beat_id": "S010_B096", "speaker_id": "cyanis", "text": "You've been there?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — FINAL APPROACH", "staging": "The party moves toward Wayfinder Junction.\n\nThis final approach is encounter-protected.\n\nIt is decompression after the crossing conflict and the longer lower route, not another battle stretch.\n\nCyanis looks at the Junction."}},
{"beat_id": "S010_B097", "speaker_id": "torren", "text": "Outside.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — FINAL APPROACH"}},
{"beat_id": "S010_B098", "speaker_id": "maevra", "text": "Inside?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — FINAL APPROACH", "staging": "Maevra looks at him."}},
{"beat_id": "S010_B099", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — FINAL APPROACH"}},
{"beat_id": "S010_B100", "speaker_id": "cyanis", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — FINAL APPROACH", "staging": "Cyanis nods."}},
{"beat_id": "S010_B101", "speaker_id": "cyanis", "text": "Means one of us is allowed not to know something.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — FINAL APPROACH", "staging": "Torren looks at him."}},
{"beat_id": "S010_B102", "speaker_id": "torren", "text": "Don't get comfortable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — FINAL APPROACH", "staging": "Torren almost smiles."}},
{"beat_id": "S010_B103", "speaker_id": "torren", "text": "For the record.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — FINAL APPROACH", "staging": "They continue.\n\nA little later:"}},
{"beat_id": "S010_B104", "speaker_id": "torren", "text": "Lower route worked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — FINAL APPROACH", "staging": "Cyanis looks over."}},
{"beat_id": "S010_B105", "speaker_id": "cyanis", "text": "That's not the same as being right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — FINAL APPROACH"}},
{"beat_id": "S010_B106", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — FINAL APPROACH", "staging": "Torren considers that."}},
{"beat_id": "S010_B107", "speaker_id": "cyanis", "text": "I'm learning.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — FINAL APPROACH", "staging": "Cyanis nods toward Wayfinder Junction.", "staging_after": "Torren says nothing.\n\nThey keep walking.\n\nNo final punch line.\n\n**END S010.**\n\nTransition directly into S011 — Wayfinder Junction / Six Ways Through."}}
]
