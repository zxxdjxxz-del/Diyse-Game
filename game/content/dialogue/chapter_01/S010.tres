[gd_resource type="Resource" script_class="DiyseDialogueSceneDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://game/dialogue/dialogue_scene_definition.gd" id="1_scene"]

[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "S010"
chapter_id = "chapter_01"
scene_kind = "mandatory"
location_id = "LOC_BRD_BRIAR_PASSAGE"
trigger_id = "trigger.chapter_01.s010"
completion_flag = "scene.s010.complete"
participants = Array[String](["cyanis", "torren", "maevra", "ilyra"])
authoring_notes = "Audit75 Resource conversion of the closed Chapter 1 Briar Passage / The Route I Would Take production dialogue. Spoken/staging wording is translated from the approved August 9, 2026 S007-S011 production source; only explicit later-canon terminology supersessions are applied. No story/dialogue rewrite, no player choices, and no proof portraits."
beats = [{"beat_id":"S010_B001","cues":{"staging":"The maintained Greenhollow road fades into older route stones. Wayfinder Junction appears intermittently through the trees across the ridge. The destination is visible before the player can reach it. Torren stops at a marker."}},
{"beat_id":"S010_B002","speaker_id":"cyanis","text":"Another new one?"},
{"beat_id":"S010_B003","speaker_id":"torren","text":"Old one moved."},
{"beat_id":"S010_B004","speaker_id":"maevra","text":"Third?"},
{"beat_id":"S010_B005","speaker_id":"torren","text":"Third."},
{"beat_id":"S010_B006","cues":{"staging":"He examines the ground."}},
{"beat_id":"S010_B007","speaker_id":"ilyra","text":"How recent?"},
{"beat_id":"S010_B008","speaker_id":"torren","text":"Day or two."},
{"beat_id":"S010_B009","speaker_id":"maevra","text":"Host?"},
{"beat_id":"S010_B010","cues":{"staging":"Torren considers."}},
{"beat_id":"S010_B011","speaker_id":"torren","text":"Maybe."},
{"beat_id":"S010_B012","cues":{"staging":"Maevra accepts the answer. No one comments on the word. They move."}},
{"beat_id":"S010_B013","cues":{"staging":"PLAYER CONTROL. Standard random encounter pressure begins after a short protected window. First sustained four-character ordinary battle occurs here. No mandatory four-character combat tutorial.","implementation_flags":["PLAYER_CONTROL"]}},
{"beat_id":"S010_B014","cues":{"staging":"Cyanis is cleaning vine residue from his sword."}},
{"beat_id":"S010_B015","speaker_id":"cyanis","text":"Does everything here grab you?"},
{"beat_id":"S010_B016","speaker_id":"torren","text":"No."},
{"beat_id":"S010_B017","cues":{"staging":"Cyanis waits. Torren continues checking his bowstring. Nothing else comes."}},
{"beat_id":"S010_B018","cues":{"staging":"Ilyra notices Cyanis waiting."}},
{"beat_id":"S010_B019","speaker_id":"ilyra","text":"Some things bite."},
{"beat_id":"S010_B020","cues":{"staging":"Cyanis looks at her. She keeps walking. The joke receives no further payoff."}},
{"beat_id":"S010_B021","cues":{"staging":"Torren stops the party. A marker points toward an apparent trail. He throws a stone onto it. Leaf litter collapses over a concealed drop."}},
{"beat_id":"S010_B022","speaker_id":"cyanis","text":"Natural?"},
{"beat_id":"S010_B023","speaker_id":"torren","text":"Hole is."},
{"beat_id":"S010_B024","cues":{"staging":"He points to brush arranged over it."}},
{"beat_id":"S010_B025","speaker_id":"torren","text":"Cover isn't."},
{"beat_id":"S010_B026","cues":{"staging":"Maevra studies the setup."}},
{"beat_id":"S010_B027","speaker_id":"maevra","text":"Not meant to kill."},
{"beat_id":"S010_B028","speaker_id":"ilyra","text":"Enough to injure somebody."},
{"beat_id":"S010_B029","cues":{"staging":"Torren looks at the rotated marker."}},
{"beat_id":"S010_B030","speaker_id":"torren","text":"Or make people stop trusting the markers."},
{"beat_id":"S010_B031","cues":{"staging":"Nobody jokes. The idea matters. Control returns."}},
{"beat_id":"S010_B032","cues":{"staging":"After the next encounter:"}},
{"beat_id":"S010_B033","speaker_id":"torren","text":"Dovaren. Left."},
{"beat_id":"S010_B034","cues":{"staging":"Cyanis immediately moves. A heavy branch falls across where he was walking."}},
{"beat_id":"S010_B035","speaker_id":"cyanis","text":"You could have said why."},
{"beat_id":"S010_B036","speaker_id":"torren","text":"Would have taken longer."},
{"beat_id":"S010_B037","cues":{"staging":"Maevra snorts once, not quite a laugh. Cyanis hears it and looks at her. She pretends she did nothing. The conversation ends there."}},
{"beat_id":"S010_B038","cues":{"staging":"The party reaches an overlook. Two imperfect paths: an upper shelf that is short, exposed, and recently damaged; and a lower causeway that is longer, wider, and carries fresh unidentified boot traffic. Rain approaches. Torren stops."}},
{"beat_id":"S010_B039","speaker_id":"maevra","text":"Which?"},
{"beat_id":"S010_B040","speaker_id":"torren","text":"Don't know yet."},
{"beat_id":"S010_B041","speaker_id":"cyanis","text":"What do we know?"},
{"beat_id":"S010_B042","cues":{"staging":"Torren points upward."}},
{"beat_id":"S010_B043","speaker_id":"torren","text":"Upper is faster. Rock under the remaining shelf is probably sound."},
{"beat_id":"S010_B044","speaker_id":"maevra","text":"Probably."},
{"beat_id":"S010_B045","speaker_id":"torren","text":"Yes."},
{"beat_id":"S010_B046","cues":{"staging":"Ilyra studies the narrow shelf."}},
{"beat_id":"S010_B047","speaker_id":"ilyra","text":"If someone gets hurt on the far side, can we bring them back through it safely?"},
{"beat_id":"S010_B048","cues":{"staging":"Torren looks again, longer this time."}},
{"beat_id":"S010_B049","speaker_id":"torren","text":"No."},
{"beat_id":"S010_B050","cues":{"staging":"Ilyra nods. No victory in the answer. Maevra checks the incoming weather."}},
{"beat_id":"S010_B051","speaker_id":"maevra","text":"Rain?"},
{"beat_id":"S010_B052","speaker_id":"torren","text":"Makes the shelf worse."},
{"beat_id":"S010_B053","cues":{"staging":"Cyanis looks toward the lower route."}},
{"beat_id":"S010_B054","speaker_id":"cyanis","text":"Tracks?"},
{"beat_id":"S010_B055","speaker_id":"torren","text":"Boots. Cannot identify them from here."},
{"beat_id":"S010_B056","speaker_id":"cyanis","text":"Can you scout both?"},
{"beat_id":"S010_B057","cues":{"staging":"Torren looks at the sky."}},
{"beat_id":"S010_B058","speaker_id":"torren","text":"Not properly."},
{"beat_id":"S010_B059","speaker_id":"maevra","text":"How much time would you want?"},
{"beat_id":"S010_B060","speaker_id":"torren","text":"Hour."},
{"beat_id":"S010_B061","speaker_id":"maevra","text":"We don't have it."},
{"beat_id":"S010_B062","cues":{"staging":"Torren knows. He dislikes that."}},
{"beat_id":"S010_B063","cues":{"staging":"No one fills the silence for him. Torren studies both paths again."}},
{"beat_id":"S010_B064","speaker_id":"torren","text":"Upper is faster."},
{"beat_id":"S010_B065","cues":{"staging":"He glances at Ilyra."}},
{"beat_id":"S010_B066","speaker_id":"torren","text":"She's right about getting someone back out."},
{"beat_id":"S010_B067","cues":{"staging":"Then the lower path."}},
{"beat_id":"S010_B068","speaker_id":"torren","text":"Lower gives us more room. More ways to leave if the tracks are hostile."},
{"beat_id":"S010_B069","speaker_id":"cyanis","text":"Which would you take?"},
{"beat_id":"S010_B070","speaker_id":"torren","text":"I don't know enough."},
{"beat_id":"S010_B071","speaker_id":"cyanis","text":"I know."},
{"beat_id":"S010_B072","cues":{"staging":"A beat."}},
{"beat_id":"S010_B073","speaker_id":"cyanis","text":"Which would you take?"},
{"beat_id":"S010_B074","cues":{"staging":"Torren looks at him. No demand for certainty."}},
{"beat_id":"S010_B075","speaker_id":"torren","text":"Lower."},
{"beat_id":"S010_B076","speaker_id":"cyanis","text":"Why?"},
{"beat_id":"S010_B077","speaker_id":"torren","text":"Because armed people are a problem I understand."},
{"beat_id":"S010_B078","cues":{"staging":"He glances at the broken shelf."}},
{"beat_id":"S010_B079","speaker_id":"torren","text":"I don't negotiate with a hillside."},
{"beat_id":"S010_B080","cues":{"staging":"Maevra almost says something. Does not."}},
{"beat_id":"S010_B081","speaker_id":"torren","text":"I cannot promise the route."},
{"beat_id":"S010_B082","cues":{"staging":"A beat."}},
{"beat_id":"S010_B083","speaker_id":"torren","text":"This is the one I would take."},
{"beat_id":"S010_B084","speaker_id":"cyanis","text":"Good enough."},
{"beat_id":"S010_B085","cues":{"staging":"That matters."}},
{"beat_id":"S010_B086","speaker_id":"maevra","text":"Lower route."},
{"beat_id":"S010_B087","cues":{"staging":"They move."}},
{"beat_id":"S010_B088","cues":{"staging":"The tracks resolve into cut brush, boot marks, a broken load strap, black-red residue, and heavy drag marks."}},
{"beat_id":"S010_B089","speaker_id":"cyanis","text":"Host?"},
{"beat_id":"S010_B090","cues":{"staging":"Torren crouches."}},
{"beat_id":"S010_B091","speaker_id":"torren","text":"Probably."},
{"beat_id":"S010_B092","cues":{"staging":"Maevra nods once. More evidence has changed the answer. No one comments."}},
{"beat_id":"S010_B093","cues":{"staging":"If local pressure has not yet satisfied the intended 2-3 ordinary-battle leg, use an established mixed wilderness formation here. No new enemy identity is introduced."}},
{"beat_id":"S010_B094","cues":{"staging":"The lower route reaches an old timber-and-stone crossing. Several reinforcement braces have been removed, but the deck remains. The missing members were dragged east. Torren inspects the remaining structure."}},
{"beat_id":"S010_B095","speaker_id":"maevra","text":"Confirmed Host logistics route."},
{"beat_id":"S010_B096","cues":{"staging":"She looks across the span, then back toward Greenhollow."}},
{"beat_id":"S010_B097","speaker_id":"maevra","text":"Standing field order is to deny a route we cannot hold."},
{"beat_id":"S010_B098","speaker_id":"cyanis","text":"Meaning?"},
{"beat_id":"S010_B099","speaker_id":"maevra","text":"Drop the span."},
{"beat_id":"S010_B100","cues":{"staging":"Torren looks up immediately."}},
{"beat_id":"S010_B101","speaker_id":"torren","text":"Greenhollow uses this crossing when the river road floods."},
{"beat_id":"S010_B102","speaker_id":"ilyra","text":"For carts too?"},
{"beat_id":"S010_B103","speaker_id":"torren","text":"Carts. Litters. Anyone who cannot take the shelf."},
{"beat_id":"S010_B104","cues":{"staging":"Maevra absorbs that, but the standing order remains legitimate."}},
{"beat_id":"S010_B105","speaker_id":"maevra","text":"Dovaren. Cut the remaining braces."},
{"beat_id":"S010_B106","cues":{"staging":"Cyanis looks at the crossing, then toward the route behind them."}},
{"beat_id":"S010_B107","speaker_id":"cyanis","text":"No."},
{"beat_id":"S010_B108","cues":{"staging":"Nobody moves."}},
{"beat_id":"S010_B109","speaker_id":"maevra","text":"That's an order."},
{"beat_id":"S010_B110","speaker_id":"cyanis","text":"Then I'm refusing it."},
{"beat_id":"S010_B111","cues":{"staging":"Maevra does not raise her voice."}},
{"beat_id":"S010_B112","speaker_id":"maevra","text":"Reason."},
{"beat_id":"S010_B113","speaker_id":"cyanis","text":"I'm not trading their way out for our cleaner fight."},
{"beat_id":"S010_B114","cues":{"staging":"A beat."}},
{"beat_id":"S010_B115","speaker_id":"maevra","text":"That leaves the Host a usable route behind us."},
{"beat_id":"S010_B116","speaker_id":"cyanis","text":"Then we take the harder problem."},
{"beat_id":"S010_B117","speaker_id":"maevra","text":"Ours?"},
{"beat_id":"S010_B118","speaker_id":"cyanis","text":"Ours."},
{"beat_id":"S010_B119","cues":{"staging":"Torren and Ilyra stay out of the command exchange. Maevra looks at Cyanis for a long moment, then at the crossing."}},
{"beat_id":"S010_B120","speaker_id":"maevra","text":"I have your refusal."},
{"beat_id":"S010_B121","speaker_id":"cyanis","text":"You do."},
{"beat_id":"S010_B122","speaker_id":"maevra","text":"We leave it standing. If they come back through it, we hold what we chose to preserve."},
{"beat_id":"S010_B123","speaker_id":"cyanis","text":"Understood."},
{"beat_id":"S010_B124","cues":{"staging":"The disagreement is finished. Nobody congratulates him. The extra risk now belongs to the party."}},
{"beat_id":"S010_B125","cues":{"staging":"Torren tests multiple supports before answering the practical question."}},
{"beat_id":"S010_B126","speaker_id":"ilyra","text":"Will it hold us?"},
{"beat_id":"S010_B127","speaker_id":"torren","text":"One at a time."},
{"beat_id":"S010_B128","cues":{"staging":"CONTEXTUAL TRAVERSAL. Forgiving authored crossing, not precision platforming. Torren crosses first. Maevra automatically waits until he clears. Cyanis notices and says nothing."}},
{"beat_id":"S010_B129","cues":{"staging":"A safe recess beyond the crossing contains an ancient route marker integrated into the rock. The Hollow Watch geometry appears again. Maevra lays the rubbing beside it."}},
{"beat_id":"S010_B130","speaker_id":"maevra","text":"Same system."},
{"beat_id":"S010_B131","speaker_id":"torren","text":"Same routes."},
{"beat_id":"S010_B132","speaker_id":"cyanis","text":"Where do they meet?"},
{"beat_id":"S010_B133","cues":{"staging":"Torren looks toward the structure on the far ridge."}},
{"beat_id":"S010_B134","speaker_id":"torren","text":"There."},
{"beat_id":"S010_B135","cues":{"staging":"The full exterior of Wayfinder Junction becomes visible. Ancient routes converge into the mountainside structure."}},
{"beat_id":"S010_B136","speaker_id":"cyanis","text":"You've been there?"},
{"beat_id":"S010_B137","speaker_id":"torren","text":"Outside."},
{"beat_id":"S010_B138","speaker_id":"maevra","text":"Inside?"},
{"beat_id":"S010_B139","speaker_id":"torren","text":"No."},
{"beat_id":"S010_B140","speaker_id":"cyanis","text":"Good."},
{"beat_id":"S010_B141","cues":{"staging":"Torren looks at him."}},
{"beat_id":"S010_B142","speaker_id":"cyanis","text":"Means one of us is allowed not to know something."},
{"beat_id":"S010_B143","cues":{"staging":"Torren almost smiles."}},
{"beat_id":"S010_B144","speaker_id":"torren","text":"Don't get comfortable."},
{"beat_id":"S010_B145","cues":{"staging":"FINAL APPROACH: ENCOUNTER-PROTECTED.","implementation_flags":["FINAL_APPROACH"]}},
{"beat_id":"S010_B146","speaker_id":"torren","text":"For the record."},
{"beat_id":"S010_B147","cues":{"staging":"Cyanis looks over."}},
{"beat_id":"S010_B148","speaker_id":"torren","text":"Lower route worked."},
{"beat_id":"S010_B149","speaker_id":"cyanis","text":"That's not the same as being right."},
{"beat_id":"S010_B150","cues":{"staging":"Torren thinks about that."}},
{"beat_id":"S010_B151","speaker_id":"torren","text":"No."},
{"beat_id":"S010_B152","cues":{"staging":"Cyanis nods toward the Junction."}},
{"beat_id":"S010_B153","speaker_id":"cyanis","text":"I'm learning."},
{"beat_id":"S010_B154","cues":{"staging":"Torren says nothing. The scene ends on movement rather than a punchline."}}]
