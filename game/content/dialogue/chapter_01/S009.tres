[gd_resource type="Resource" script_class="DiyseDialogueSceneDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://game/dialogue/dialogue_scene_definition.gd" id="1_scene"]

[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "S009"
chapter_id = "chapter_01"
scene_kind = "mandatory"
location_id = "LOC_BRD_GREENHOLLOW"
trigger_id = "trigger.chapter_01.s009"
completion_flag = "scene.s009.complete"
participants = Array[String](["maevra", "torren", "cyanis", "route_warden", "ilyra", "injured_civilian"])
authoring_notes = "Audit75 Resource conversion of the closed Chapter 1 Greenhollow / What the Map Has Wrong production dialogue. Spoken/staging wording is translated from the approved August 9, 2026 S007-S011 production source; only explicit later-canon terminology supersessions are applied. No story/dialogue rewrite, no player choices, and no proof portraits."
beats = [{"beat_id":"S009_B001","cues":{"staging":"Greenhollow is built around maintaining routes. A courier compares mud-stained maps. A carpenter cuts rot from a bridge plank. Residents revise route notices rather than treating maps as permanent truth. At the public route board, a dark-haired ranger in a natural ghillie cape crosses out part of a Royal road and writes: BANK GONE."}},
{"beat_id":"S009_B002","cues":{"staging":"Maevra stops."}},
{"beat_id":"S009_B003","speaker_id":"maevra","text":"Harth."},
{"beat_id":"S009_B004","cues":{"staging":"He keeps writing."}},
{"beat_id":"S009_B005","speaker_id":"torren","text":"Solmar."},
{"beat_id":"S009_B006","cues":{"staging":"Cyanis glances at Ilyra. Ilyra notices but says nothing."}},
{"beat_id":"S009_B007","speaker_id":"maevra","text":"You crossed out a Crown route."},
{"beat_id":"S009_B008","speaker_id":"torren","text":"River crossed it out first."},
{"beat_id":"S009_B009","speaker_id":"maevra","text":"The report says passable."},
{"beat_id":"S009_B010","speaker_id":"torren","text":"Report's four days old."},
{"beat_id":"S009_B011","cues":{"staging":"He notices the bruise on her arm."}},
{"beat_id":"S009_B012","speaker_id":"torren","text":"Left arm."},
{"beat_id":"S009_B013","speaker_id":"maevra","text":"Fine."},
{"beat_id":"S009_B014","cues":{"staging":"Torren accepts that immediately. That tells the player more than exposition would."}},
{"beat_id":"S009_B015","cues":{"staging":"He finally looks at Cyanis."}},
{"beat_id":"S009_B016","speaker_id":"torren","text":"Crest Knight?"},
{"beat_id":"S009_B017","speaker_id":"cyanis","text":"Cyanis."},
{"beat_id":"S009_B018","speaker_id":"torren","text":"Torren."},
{"beat_id":"S009_B019","cues":{"staging":"Ilyra introduces herself with a nod and her name. Maevra taps the map."}},
{"beat_id":"S009_B020","speaker_id":"maevra","text":"We need Briar Passage."},
{"beat_id":"S009_B021","cues":{"staging":"Torren looks at the official route."}},
{"beat_id":"S009_B022","speaker_id":"torren","text":"Not like that."},
{"beat_id":"S009_B023","speaker_id":"cyanis","text":"What does the map have wrong?"},
{"beat_id":"S009_B024","cues":{"staging":"Torren looks at him properly, then points."}},
{"beat_id":"S009_B025","speaker_id":"torren","text":"Bridge here is gone. North shelf is soft after rain. This marker moved last winter."},
{"beat_id":"S009_B026","speaker_id":"cyanis","text":"Briar Passage?"},
{"beat_id":"S009_B027","speaker_id":"torren","text":"Still there."},
{"beat_id":"S009_B028","speaker_id":"cyanis","text":"Usable?"},
{"beat_id":"S009_B029","speaker_id":"torren","text":"Different question."},
{"beat_id":"S009_B030","cues":{"staging":"Maevra notices several small charcoal cuts beside side routes on the board. They are consistent, but they are not Greenhollow route-office marks."}},
{"beat_id":"S009_B031","speaker_id":"maevra","text":"These marks are yours."},
{"beat_id":"S009_B032","speaker_id":"torren","text":"Yes."},
{"beat_id":"S009_B033","speaker_id":"maevra","text":"How many routes have you checked?"},
{"beat_id":"S009_B034","speaker_id":"torren","text":"This week? Seven."},
{"beat_id":"S009_B035","cues":{"staging":"The local route warden, close enough to hear, keeps fastening a notice."}},
{"beat_id":"S009_B036","speaker_id":"route_warden","text":"He does them before dawn. Doesn't sign them."},
{"beat_id":"S009_B037","cues":{"staging":"Torren gives the warden a look."}},
{"beat_id":"S009_B038","speaker_id":"torren","text":"People need the road, not my name."},
{"beat_id":"S009_B039","cues":{"staging":"Cyanis looks back at the marked alternatives: each quietly routes civilians around a damaged or exposed stretch rather than toward it. He does not praise Torren aloud. The evidence is enough."}},
{"beat_id":"S009_B040","cues":{"staging":"The route warden reports two civilians stranded at a lower shelter after a cart accident. One has a deep lower-leg wound."}},
{"beat_id":"S009_B041","cues":{"staging":"Ilyra examines the route map. Torren indicates the upper path."}},
{"beat_id":"S009_B042","speaker_id":"torren","text":"I can reach them from here."},
{"beat_id":"S009_B043","speaker_id":"maevra","text":"How long?"},
{"beat_id":"S009_B044","speaker_id":"torren","text":"Hour."},
{"beat_id":"S009_B045","speaker_id":"ilyra","text":"And bring someone back with an injured leg?"},
{"beat_id":"S009_B046","cues":{"staging":"Torren looks again."}},
{"beat_id":"S009_B047","speaker_id":"torren","text":"No."},
{"beat_id":"S009_B048","cues":{"staging":"No defensiveness. He revises."}},
{"beat_id":"S009_B049","speaker_id":"cyanis","text":"Other route?"},
{"beat_id":"S009_B050","speaker_id":"torren","text":"Birch trail."},
{"beat_id":"S009_B051","cues":{"staging":"The warden hesitates."}},
{"beat_id":"S009_B052","speaker_id":"route_warden","text":"Briarhide's been charging people."},
{"beat_id":"S009_B053","cues":{"staging":"Cyanis looks at Torren."}},
{"beat_id":"S009_B054","speaker_id":"torren","text":"Doesn't hunt people."},
{"beat_id":"S009_B055","speaker_id":"cyanis","text":"It charged people."},
{"beat_id":"S009_B056","cues":{"staging":"Torren's voice becomes more exact."}},
{"beat_id":"S009_B057","speaker_id":"torren","text":"Frightened things can still kill you."},
{"beat_id":"S009_B058","cues":{"staging":"A beat."}},
{"beat_id":"S009_B059","speaker_id":"torren","text":"Doesn't make them hunters."},
{"beat_id":"S009_B060","speaker_id":"cyanis","text":"Then something frightened it."},
{"beat_id":"S009_B061","cues":{"staging":"Torren unwraps a bent black-metal hook with red residue."}},
{"beat_id":"S009_B062","speaker_id":"maevra","text":"Host field fitting."},
{"beat_id":"S009_B063","speaker_id":"torren","text":"Found two near the lower trail."},
{"beat_id":"S009_B064","speaker_id":"ilyra","text":"Poison?"},
{"beat_id":"S009_B065","speaker_id":"torren","text":"Don't know."},
{"beat_id":"S009_B066","cues":{"staging":"Maevra looks east."}},
{"beat_id":"S009_B067","speaker_id":"maevra","text":"Toward Briar Passage?"},
{"beat_id":"S009_B068","speaker_id":"torren","text":"Looks that way."},
{"beat_id":"S009_B069","cues":{"staging":"Cyanis studies the route."}},
{"beat_id":"S009_B070","speaker_id":"cyanis","text":"We clear the lower path, get the civilians out, then follow the Host trail."},
{"beat_id":"S009_B071","speaker_id":"cyanis","text":"Can we move the Briarhide without killing it?"},
{"beat_id":"S009_B072","cues":{"staging":"Torren considers."}},
{"beat_id":"S009_B073","speaker_id":"torren","text":"Need to see it first."},
{"beat_id":"S009_B074","cues":{"staging":"PLAYER CONTROL. Commandable party remains Cyanis + Ilyra + Maevra. Torren accompanies as a route specialist and receives no free attacks or hidden combat actions. Expect 1-2 ordinary wilderness encounters.","implementation_flags":["PLAYER_CONTROL"]}},
{"beat_id":"S009_B075","cues":{"staging":"At a safe trail pocket, Torren finds a rotated marker."}},
{"beat_id":"S009_B076","speaker_id":"torren","text":"Moved."},
{"beat_id":"S009_B077","speaker_id":"maevra","text":"Broken?"},
{"beat_id":"S009_B078","speaker_id":"torren","text":"No."},
{"beat_id":"S009_B079","cues":{"staging":"She studies the tool marks."}},
{"beat_id":"S009_B080","speaker_id":"maevra","text":"Someone redirected it."},
{"beat_id":"S009_B081","cues":{"staging":"Torren nods. Cyanis starts to ask something. Torren is already moving. The conversation ends."}},
{"beat_id":"S009_B082","cues":{"staging":"The two civilians are visible ahead. One is arguing loudly enough for Ilyra to hear."}},
{"beat_id":"S009_B083","speaker_id":"ilyra","text":"Stable enough to be difficult."},
{"beat_id":"S009_B084","cues":{"staging":"Cyanis smiles. Then Torren raises one hand. All humor disappears."}},
{"beat_id":"S009_B085","speaker_id":"torren","text":"Quiet."},
{"beat_id":"S009_B086","cues":{"staging":"Birdsong has stopped on one side of the trail. The Briarhide appears between the trees. Blood mats one flank. Black-red metal protrudes beneath the hide."}},
{"beat_id":"S009_B087","speaker_id":"ilyra","text":"Right side."},
{"beat_id":"S009_B088","speaker_id":"torren","text":"Saw it."},
{"beat_id":"S009_B089","speaker_id":"maevra","text":"Part of the snare."},
{"beat_id":"S009_B090","cues":{"staging":"Torren nods. Cyanis draws his sword."}},
{"beat_id":"S009_B091","speaker_id":"cyanis","text":"Torren, civilians."},
{"beat_id":"S009_B092","cues":{"staging":"Torren immediately takes the shelter-side approach."}},
{"beat_id":"S009_B093","speaker_id":"torren","text":"Keep it uphill."},
{"beat_id":"S009_B094","speaker_id":"ilyra","text":"And don't drive it onto the wound."},
{"beat_id":"S009_B095","speaker_id":"cyanis","text":"Got it."},
{"beat_id":"S009_B096","cues":{"staging":"FIXED ENCOUNTER: BRIARHIDE STALKER. Nonlethal. The embedded Black Host irritant becomes a targetable component. Torren identifies the ecological problem; the player performs the solution. Torren receives no hidden combat actions.","implementation_flags":["AUTHORED_FIXED_ENCOUNTER"]}},
{"beat_id":"S009_B097","cues":{"staging":"At resolution, the barb comes free and the Briarhide retreats. Cyanis does not pursue. Torren notices and says nothing."}},
{"beat_id":"S009_B098","cues":{"staging":"Ilyra takes over the injured civilian."}},
{"beat_id":"S009_B099","speaker_id":"injured_civilian","text":"I can walk."},
{"beat_id":"S009_B100","speaker_id":"ilyra","text":"You did. That is part of the problem."},
{"beat_id":"S009_B101","cues":{"staging":"Torren is helping recover the damaged cart nearby."}},
{"beat_id":"S009_B102","speaker_id":"torren","text":"Told you."},
{"beat_id":"S009_B103","speaker_id":"injured_civilian","text":"Nobody asked you."},
{"beat_id":"S009_B104","speaker_id":"torren","text":"True."},
{"beat_id":"S009_B105","cues":{"staging":"Ilyra almost smiles and keeps working."}},
{"beat_id":"S009_B106","cues":{"staging":"Maevra examines the removed hook."}},
{"beat_id":"S009_B107","speaker_id":"maevra","text":"Anchor fitting."},
{"beat_id":"S009_B108","cues":{"staging":"Torren points to repeated bark scars. Something heavy was dragged east. Cyanis shows him the Hollow Watch rubbing. Torren rotates it."}},
{"beat_id":"S009_B109","speaker_id":"torren","text":"You're reading this as north."},
{"beat_id":"S009_B110","speaker_id":"maevra","text":"We were."},
{"beat_id":"S009_B111","speaker_id":"torren","text":"Don't."},
{"beat_id":"S009_B112","cues":{"staging":"He traces the angles."}},
{"beat_id":"S009_B113","speaker_id":"torren","text":"If these are routes, they're following the ridge."},
{"beat_id":"S009_B114","speaker_id":"cyanis","text":"You recognize it?"},
{"beat_id":"S009_B115","speaker_id":"torren","text":"I recognize the ground."},
{"beat_id":"S009_B116","cues":{"staging":"A better answer."}},
{"beat_id":"S009_B117","speaker_id":"torren","text":"Whoever copied this knew where Briar Passage was."},
{"beat_id":"S009_B118","cues":{"staging":"The return to Greenhollow is encounter-suppressed. The civilians are handed to local care. Ilyra gives concise instructions and lets the local healer take over."}},
{"beat_id":"S009_B119","cues":{"staging":"At the route board:"}},
{"beat_id":"S009_B120","speaker_id":"maevra","text":"We're continuing east."},
{"beat_id":"S009_B121","cues":{"staging":"Torren studies the board."}},
{"beat_id":"S009_B122","speaker_id":"torren","text":"Not by the marked road."},
{"beat_id":"S009_B123","speaker_id":"maevra","text":"Yes, Harth. We established that."},
{"beat_id":"S009_B124","cues":{"staging":"Cyanis looks at him."}},
{"beat_id":"S009_B125","speaker_id":"cyanis","text":"You know Briar Passage."},
{"beat_id":"S009_B126","speaker_id":"torren","text":"Parts."},
{"beat_id":"S009_B127","speaker_id":"cyanis","text":"Enough to keep us off the wrong part?"},
{"beat_id":"S009_B128","cues":{"staging":"Torren considers Cyanis, then Ilyra, then Maevra."}},
{"beat_id":"S009_B129","speaker_id":"torren","text":"Probably."},
{"beat_id":"S009_B130","speaker_id":"cyanis","text":"Useful."},
{"beat_id":"S009_B131","cues":{"staging":"Torren adjusts his bow strap."}},
{"beat_id":"S009_B132","speaker_id":"torren","text":"You're headed east."},
{"beat_id":"S009_B133","cues":{"staging":"A beat."}},
{"beat_id":"S009_B134","speaker_id":"torren","text":"So am I."},
{"beat_id":"S009_B135","cues":{"staging":"Maevra looks at him."}},
{"beat_id":"S009_B136","speaker_id":"maevra","text":"Of course you are."},
{"beat_id":"S009_B137","cues":{"staging":"Torren almost smiles."}},
{"beat_id":"S009_B138","cues":{"staging":"PARTY UPDATE: TORREN HARTH - PERMANENT PARTY MEMBER. WAR ARCHER. Current story availability: Cyanis permanent; Ilyra permanent; Torren permanent; Maevra temporary. No First Sovereign reveal, no Subclass unlock, no forced menu tutorial.","implementation_flags":["PARTY_UPDATE"]}},
{"beat_id":"S009_B139","cues":{"staging":"Before leaving, Torren replaces one route notice. Cyanis watches."}},
{"beat_id":"S009_B140","speaker_id":"cyanis","text":"Anything else we're planning to use that's wrong?"},
{"beat_id":"S009_B141","speaker_id":"torren","text":"Probably."},
{"beat_id":"S009_B142","cues":{"staging":"Cyanis waits. Torren finally adds:"}},
{"beat_id":"S009_B143","speaker_id":"torren","text":"Briar Passage isn't right."},
{"beat_id":"S009_B144","cues":{"staging":"Maevra looks up."}},
{"beat_id":"S009_B145","speaker_id":"maevra","text":"Define that."},
{"beat_id":"S009_B146","speaker_id":"torren","text":"Some old markers moved."},
{"beat_id":"S009_B147","speaker_id":"ilyra","text":"And the others?"},
{"beat_id":"S009_B148","cues":{"staging":"Torren shoulders his bow."}},
{"beat_id":"S009_B149","speaker_id":"torren","text":"New."},
{"beat_id":"S009_B150","cues":{"staging":"He walks east. The others follow."}}]
