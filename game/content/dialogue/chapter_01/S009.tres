[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "S009"
chapter_id = "chapter_01"
scene_kind = "mandatory"
location_id = "LOC_GREENHOLLOW"
trigger_id = "trigger.chapter_01.s009"
completion_flag = "scene.s009.complete"
participants = Array[String](["maevra", "torren", "cyanis", "ilyra", "edda", "runner", "injured_civilian"])
authoring_notes = "Chapter 1 exact Resource conversion from docs/chapters/dialogue/chapter_01/S009.md under Complete Master Canon v1.64 / Audit79. Spoken text is line-complete and must not be rewritten. Source production/staging prose is preserved in beat cue metadata; source subsection names are carried in cues.source_section. Portrait slots remain empty until approved registry expressions/assets are wired. Spoken-sequence SHA-256: bb9e349f0a2d34e434f1d21f7f2bfc8c23a5552ef464e7324e0ea947b46d94ad."
beats = [
{"beat_id": "S009_B001", "speaker_id": "maevra", "text": "Harth.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — GREENHOLLOW", "staging": "Greenhollow is a small working route community.\n\nCheap 2.5D: one compact village kit centered around the route board, bridge approach, a few workshops/houses, and trail exits. Most village life is reusable background loops.\n\nA carpenter replaces rotten bridge boards.\n\nWet route notices hang beside older ones.\n\nA courier argues with somebody over which road is still usable.\n\nAt the public route board, a ranger in a ghillie cape has crossed a line through one Crown road.\n\nBeside it:\n\n**BANK GONE**\n\nMaevra stops."}},
{"beat_id": "S009_B002", "speaker_id": "torren", "text": "Solmar.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — GREENHOLLOW", "staging": "The ranger keeps writing."}},
{"beat_id": "S009_B003", "speaker_id": "maevra", "text": "You crossed out a Crown route.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — GREENHOLLOW", "staging": "Cyanis glances at Ilyra.\n\nIlyra notices.\n\nSays nothing.\n\nTorren finishes the mark.\n\nMaevra steps closer."}},
{"beat_id": "S009_B004", "speaker_id": "torren", "text": "River crossed it out first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — GREENHOLLOW"}},
{"beat_id": "S009_B005", "speaker_id": "maevra", "text": "The report says passable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — GREENHOLLOW"}},
{"beat_id": "S009_B006", "speaker_id": "torren", "text": "Report's four days old.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — GREENHOLLOW"}},
{"beat_id": "S009_B007", "speaker_id": "torren", "text": "Left arm.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — GREENHOLLOW", "staging": "Maevra looks at the map.\n\nThen back at him.\n\nNo smile.\n\nNo hostility either.\n\nTorren notices the bruising on her arm."}},
{"beat_id": "S009_B008", "speaker_id": "maevra", "text": "Fine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — GREENHOLLOW", "staging_after": "Torren nods.\n\nAccepts it immediately.\n\nCyanis notices that too.\n\nStill says nothing."}},
{"beat_id": "S009_B009", "speaker_id": "torren", "text": "Crest Knight?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE MAP", "staging": "Torren finally looks at Cyanis and Ilyra."}},
{"beat_id": "S009_B010", "speaker_id": "cyanis", "text": "Cyanis.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE MAP"}},
{"beat_id": "S009_B011", "speaker_id": "torren", "text": "Torren.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE MAP"}},
{"beat_id": "S009_B012", "speaker_id": "ilyra", "text": "Ilyra.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE MAP", "staging": "Ilyra gives her name."}},
{"beat_id": "S009_B013", "speaker_id": "maevra", "text": "We need Briar Passage.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE MAP", "staging": "Maevra taps the map."}},
{"beat_id": "S009_B014", "speaker_id": "torren", "text": "Not like that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE MAP", "staging": "Torren looks at the marked Crown route."}},
{"beat_id": "S009_B015", "speaker_id": "cyanis", "text": "What's wrong with it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE MAP"}},
{"beat_id": "S009_B016", "speaker_id": "torren", "text": "Bridge here is gone.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE MAP", "staging": "Torren points."}},
{"beat_id": "S009_B017", "speaker_id": "torren", "text": "North shelf turns to shit after rain.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE MAP", "staging": "Another mark."}},
{"beat_id": "S009_B018", "speaker_id": "torren", "text": "And this marker moved last winter.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE MAP", "staging": "Another."}},
{"beat_id": "S009_B019", "speaker_id": "cyanis", "text": "Briar Passage is still there?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE MAP", "staging": "Cyanis looks at the map again."}},
{"beat_id": "S009_B020", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE MAP"}},
{"beat_id": "S009_B021", "speaker_id": "cyanis", "text": "Usable?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE MAP"}},
{"beat_id": "S009_B022", "speaker_id": "torren", "text": "Different question.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE MAP", "staging": "Torren looks at him."}},
{"beat_id": "S009_B023", "speaker_id": "cyanis", "text": "All right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — THE MAP", "staging": "Cyanis nods.", "staging_after": "That gets the slightest look from Torren.\n\nNo one demands false certainty from him."}},
{"beat_id": "S009_B024", "speaker_id": "maevra", "text": "These yours?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — HIS MARKS", "staging": "Maevra notices several charcoal marks on smaller side routes.\n\nThey do not match the official route-office notation."}},
{"beat_id": "S009_B025", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — HIS MARKS"}},
{"beat_id": "S009_B026", "speaker_id": "maevra", "text": "How many have you checked?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — HIS MARKS"}},
{"beat_id": "S009_B027", "speaker_id": "torren", "text": "This week?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — HIS MARKS"}},
{"beat_id": "S009_B028", "speaker_id": "maevra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — HIS MARKS"}},
{"beat_id": "S009_B029", "speaker_id": "torren", "text": "Seven.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — HIS MARKS"}},
{"beat_id": "S009_B030", "speaker_id": "edda", "text": "Eight.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — HIS MARKS", "staging": "A woman working at the route board speaks without looking up.\n\nThis is EDDA HARTH, Greenhollow's route warden."}},
{"beat_id": "S009_B031", "speaker_id": "torren", "text": "Seven.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — HIS MARKS", "staging": "Torren looks at her."}},
{"beat_id": "S009_B032", "speaker_id": "edda", "text": "You did Mill Cut yesterday.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — HIS MARKS"}},
{"beat_id": "S009_B033", "speaker_id": "torren", "text": "Wasn't checking it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — HIS MARKS"}},
{"beat_id": "S009_B034", "speaker_id": "edda", "text": "You replaced two markers.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — HIS MARKS"}},
{"beat_id": "S009_B035", "speaker_id": "torren", "text": "They were wrong.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — HIS MARKS"}},
{"beat_id": "S009_B036", "speaker_id": "edda", "text": "Mae, it was eight.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — HIS MARKS", "staging": "Edda looks at Maevra."}},
{"beat_id": "S009_B037", "speaker_id": "torren", "text": "Don't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — HIS MARKS", "staging": "Torren gives her a look."}},
{"beat_id": "S009_B038", "speaker_id": "edda", "text": "What?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — HIS MARKS"}},
{"beat_id": "S009_B039", "speaker_id": "torren", "text": "You know what.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — HIS MARKS"}},
{"beat_id": "S009_B040", "speaker_id": "edda", "text": "He does half of them before anybody wakes up.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — HIS MARKS", "staging": "Edda absolutely does.\n\nShe goes back to the board.\n\nMaevra almost smiles.\n\nDoesn't give him the satisfaction.\n\nEdda pins another notice."}},
{"beat_id": "S009_B041", "speaker_id": "edda", "text": "And doesn't sign shit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — HIS MARKS", "staging": "Torren gives her a look."}},
{"beat_id": "S009_B042", "speaker_id": "torren", "text": "People need the road, not my name.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — HIS MARKS", "staging_after": "Cyanis looks over the quiet corrections.\n\nEvery one directs traffic around a damaged or unsafe section.\n\nHe doesn't compliment Torren.\n\nHe doesn't need to."}},
{"beat_id": "S009_B043", "speaker_id": "edda", "text": "Where?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED", "staging": "A local runner reaches Edda.\n\nShort exchange off to the side.\n\nEdda's expression changes."}},
{"beat_id": "S009_B044", "speaker_id": "runner", "text": "Lower shelter.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED"}},
{"beat_id": "S009_B045", "speaker_id": "maevra", "text": "Edda.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED", "staging": "Torren turns immediately."}},
{"beat_id": "S009_B046", "speaker_id": "edda", "text": "Cart went over near Birch Trail.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED", "staging": "Edda looks at her."}},
{"beat_id": "S009_B047", "speaker_id": "ilyra", "text": "How many?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED", "staging": "Ilyra is already checking her kit."}},
{"beat_id": "S009_B048", "speaker_id": "edda", "text": "Two.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED"}},
{"beat_id": "S009_B049", "speaker_id": "edda", "text": "One's leg is bad.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED", "staging": "Beat."}},
{"beat_id": "S009_B050", "speaker_id": "torren", "text": "I can reach them from here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED", "staging": "Torren points at the map."}},
{"beat_id": "S009_B051", "speaker_id": "maevra", "text": "How long?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED"}},
{"beat_id": "S009_B052", "speaker_id": "torren", "text": "Hour.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED"}},
{"beat_id": "S009_B053", "speaker_id": "ilyra", "text": "And bring someone back with a serious leg injury?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED", "staging": "Ilyra looks at the terrain."}},
{"beat_id": "S009_B054", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED", "staging": "Torren checks it again."}},
{"beat_id": "S009_B055", "speaker_id": "torren", "text": "Birch Trail.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED", "staging": "No defensiveness.\n\nHe points somewhere else."}},
{"beat_id": "S009_B056", "speaker_id": "edda", "text": "Briarhide's been charging people down there.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED", "staging": "Edda grimaces."}},
{"beat_id": "S009_B057", "speaker_id": "cyanis", "text": "Hunter?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED", "staging": "Cyanis looks at Torren."}},
{"beat_id": "S009_B058", "speaker_id": "torren", "text": "Don't know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED"}},
{"beat_id": "S009_B059", "speaker_id": "cyanis", "text": "Useful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED"}},
{"beat_id": "S009_B060", "speaker_id": "torren", "text": "Need to see it first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED"}},
{"beat_id": "S009_B061", "speaker_id": "maevra", "text": "Anything else?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED", "staging": "Maevra looks at Edda."}},
{"beat_id": "S009_B062", "speaker_id": "edda", "text": "Mud. Bad footing. Probably two places Harth will tell you aren't roads anymore.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED"}},
{"beat_id": "S009_B063", "speaker_id": "torren", "text": "Three.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED"}},
{"beat_id": "S009_B064", "speaker_id": "edda", "text": "Three.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — STRANDED", "staging": "Edda doesn't even look at him.", "staging_after": "The urgency begins here.\n\nOptional Greenhollow wandering is temporarily suspended until the civilians are recovered. The town remains available afterward."}},
{"beat_id": "S009_B065", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "Torren accompanies the group as the route specialist, but he is not yet a commandable party member.\n\nActive battle party remains:\n\nCyanis / Ilyra / Maevra\n\nTorren receives no hidden attacks, assists, arrows, reactions, free turns, or offscreen damage during encounters.\n\nThe Lower Woods is a moderate wilderness area, not a huge forest.\n\nExpected first pass: roughly 2–3 random encounters before the Briarhide situation, depending on rolls and exploration.\n\nCheap environment reuse:\n\n**• maintained lower trail;**\n\n**• wetter drainage path;**\n\n**• damaged cart route;**\n\n**• one short wooded/high-ground side spur;**\n\n**• one optional reward pocket;**\n\n**• reconnecting paths using the same forest kit.**\n\nTorren leads physically in exploration only.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "LOWER WOODS — RESCUE ROUTE"}},
{"beat_id": "S009_B066", "speaker_id": "cyanis", "text": "Problem?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WRONG MARKER", "staging": "In a safe pocket between encounter areas, Torren stops.\n\nA route marker points downhill.\n\nHe stares at it."}},
{"beat_id": "S009_B067", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WRONG MARKER"}},
{"beat_id": "S009_B068", "speaker_id": "maevra", "text": "Moved?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WRONG MARKER", "staging": "He turns the marker around.\n\nSimple prop-state swap.\n\nNow it points toward a completely different path.\n\nMaevra looks at it."}},
{"beat_id": "S009_B069", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WRONG MARKER", "staging": "Torren checks the post."}},
{"beat_id": "S009_B070", "speaker_id": "maevra", "text": "Flood?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WRONG MARKER"}},
{"beat_id": "S009_B071", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WRONG MARKER", "staging": "Torren crouches.\n\nLooks at the fastening."}},
{"beat_id": "S009_B072", "speaker_id": "ilyra", "text": "Someone moved it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WRONG MARKER", "staging": "Ilyra looks farther down the false route."}},
{"beat_id": "S009_B073", "speaker_id": "torren", "text": "Looks like.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WRONG MARKER"}},
{"beat_id": "S009_B074", "speaker_id": "cyanis", "text": "Recently?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WRONG MARKER", "staging": "Cyanis looks toward the correct trail."}},
{"beat_id": "S009_B075", "speaker_id": "torren", "text": "Maybe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WRONG MARKER", "staging": "Torren studies it."}},
{"beat_id": "S009_B076", "speaker_id": "torren", "text": "Don't know enough.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WRONG MARKER", "staging": "Maevra waits.\n\nNo demand for certainty."}},
{"beat_id": "S009_B077", "speaker_id": "maevra", "text": "Then that's the answer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WRONG MARKER"}},
{"beat_id": "S009_B078", "speaker_id": "torren", "text": "Birch is this way.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WRONG MARKER", "staging": "Torren looks at her.\n\nA tiny beat.\n\nThen:", "staging_after": "They continue."}},
{"beat_id": "S009_B079", "speaker_id": "cyanis", "text": "Big.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — BRIARHIDE SIGN", "staging": "Farther down the trail, bark has been torn from several trees.\n\nA larger animal track cuts across the path.\n\nCyanis crouches."}},
{"beat_id": "S009_B080", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — BRIARHIDE SIGN"}},
{"beat_id": "S009_B081", "speaker_id": "cyanis", "text": "Still don't know?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — BRIARHIDE SIGN"}},
{"beat_id": "S009_B082", "speaker_id": "torren", "text": "Know it's scared.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — BRIARHIDE SIGN", "staging": "Torren looks at the tracks."}},
{"beat_id": "S009_B083", "speaker_id": "maevra", "text": "Scared animals don't usually improve my day.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — BRIARHIDE SIGN", "staging": "Maevra looks at the gouged bark."}},
{"beat_id": "S009_B084", "speaker_id": "torren", "text": "Frightened things can still kill you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — BRIARHIDE SIGN"}},
{"beat_id": "S009_B085", "speaker_id": "torren", "text": "Doesn't make them hunters.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — BRIARHIDE SIGN", "staging": "He follows another track."}},
{"beat_id": "S009_B086", "speaker_id": "ilyra", "text": "Can we get around it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — BRIARHIDE SIGN", "staging": "Ilyra looks toward the civilian shelter."}},
{"beat_id": "S009_B087", "speaker_id": "torren", "text": "Maybe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — BRIARHIDE SIGN", "staging": "Torren looks over the terrain."}},
{"beat_id": "S009_B088", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — BRIARHIDE SIGN", "staging": "Beat.\n\nA heavy sound from the trees.\n\nCloser than expected.\n\nTorren's expression changes."}},
{"beat_id": "S009_B089", "speaker_id": "torren", "text": "There.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF"], "source_section": "AUTHORED ENCOUNTER — BRIARHIDE STALKER", "staging": "The Briarhide enters the route.\n\nIt is frightened, wounded, and unnaturally aggressive.\n\nNo villain-monster entrance.\n\nNo roar cinematic.\n\nCheap 2.5D encounter introduction: forest battle state, animal model enters, visible embedded Black Host component/barb.\n\nTorren spots it."}},
{"beat_id": "S009_B090", "speaker_id": "cyanis", "text": "That supposed to be there?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF"], "source_section": "AUTHORED ENCOUNTER — BRIARHIDE STALKER", "staging": "Cyanis follows his line of sight.\n\nA Black Host fitting is buried into the Briarhide's flank."}},
{"beat_id": "S009_B091", "speaker_id": "torren", "text": "Fuck no.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF"], "source_section": "AUTHORED ENCOUNTER — BRIARHIDE STALKER", "staging_after": "The embedded irritant/component becomes a valid encounter objective.\n\n**ENCOUNTER RULE**\n\nThis is nonlethal.\n\nThe player's goal is to disable/remove the embedded Black Host component while surviving the Briarhide's attacks.\n\nTorren identifies the ecological problem.\n\nThe player party performs the solution.\n\nTorren does not secretly shoot the barb out or receive an NPC combat turn.\n\nNo QTE.\n\nNo bespoke capture system.\n\nNormal battle rules handle targeting the component.\n\nWhen the component is removed:\n\nThe Briarhide recoils.\n\nStops.\n\nCyanis has an opening to attack.\n\nHe doesn't.\n\nThe animal backs away.\n\nThen disappears into the trees.\n\nBattle ends.\n\nNo victory pose.\n\nTorren looks at Cyanis.\n\nCyanis sheathes his weapon.\n\nTorren says nothing."}},
{"beat_id": "S009_B092", "speaker_id": "injured_civilian", "text": "I can walk.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — LOWER SHELTER", "staging": "The civilians are found nearby.\n\nOne is bruised but mobile.\n\nThe second has a badly injured lower leg.\n\nIlyra goes to work.\n\nSimple kneel/medical pose."}},
{"beat_id": "S009_B093", "speaker_id": "ilyra", "text": "You did.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — LOWER SHELTER"}},
{"beat_id": "S009_B094", "speaker_id": "ilyra", "text": "That is part of the problem.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — LOWER SHELTER", "staging": "She looks at the leg."}},
{"beat_id": "S009_B095", "speaker_id": "injured_civilian", "text": "Shit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — LOWER SHELTER", "staging": "The civilian exhales."}},
{"beat_id": "S009_B096", "speaker_id": "torren", "text": "Told you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — LOWER SHELTER", "staging": "Torren is checking the damaged cart nearby."}},
{"beat_id": "S009_B097", "speaker_id": "injured_civilian", "text": "Nobody asked you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — LOWER SHELTER", "staging": "The civilian looks at him."}},
{"beat_id": "S009_B098", "speaker_id": "torren", "text": "True.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — LOWER SHELTER", "staging_after": "Ilyra almost smiles.\n\nKeeps working.\n\nNo medical montage."}},
{"beat_id": "S009_B099", "speaker_id": "maevra", "text": "Anchor fitting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — WHAT THEY WERE MOVING", "staging": "Maevra examines the removed Black Host component."}},
{"beat_id": "S009_B100", "speaker_id": "cyanis", "text": "This mean anything to you?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — WHAT THEY WERE MOVING", "staging": "Cyanis looks at the surrounding trees.\n\nRepeated scars run along several trunks.\n\nSomething heavy has been dragged through the woods.\n\nEast.\n\nTorren follows the marks.\n\nCyanis takes out the Hollow Watch rubbing."}},
{"beat_id": "S009_B101", "speaker_id": "torren", "text": "You're reading this as north.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — WHAT THEY WERE MOVING", "staging": "Torren takes it.\n\nLooks.\n\nTurns it sideways."}},
{"beat_id": "S009_B102", "speaker_id": "maevra", "text": "We were.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — WHAT THEY WERE MOVING", "staging": "Maevra looks over."}},
{"beat_id": "S009_B103", "speaker_id": "torren", "text": "Don't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — WHAT THEY WERE MOVING", "staging": "Torren immediately:"}},
{"beat_id": "S009_B104", "speaker_id": "torren", "text": "If these are routes, they're following the ridge.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — WHAT THEY WERE MOVING", "staging": "Maevra's mouth twitches.\n\nCyanis looks between them.\n\nDoesn't ask.\n\nTorren traces the angles."}},
{"beat_id": "S009_B105", "speaker_id": "cyanis", "text": "You recognize it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — WHAT THEY WERE MOVING"}},
{"beat_id": "S009_B106", "speaker_id": "torren", "text": "I recognize the ground.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — WHAT THEY WERE MOVING", "staging": "Torren hands the rubbing back."}},
{"beat_id": "S009_B107", "speaker_id": "torren", "text": "Whoever copied this knew where Briar Passage was.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — WHAT THEY WERE MOVING", "staging": "Better answer.\n\nHe points east."}},
{"beat_id": "S009_B108", "speaker_id": "maevra", "text": "Then we have our route.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — WHAT THEY WERE MOVING", "staging": "Maevra looks at the drag scars.\n\nThen the fitting.\n\nThen east."}},
{"beat_id": "S009_B109", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "The civilian return is encounter-suppressed.\n\nNo random battles while escorting injured people through terrain the party just secured.\n\nShort fade/repositioning carries part of the return rather than requiring bespoke escort animation.\n\nAt Greenhollow, Edda and a local healer take over.\n\nIlyra gives the necessary information.\n\nThen lets them do their jobs.\n\nNo 'only the protagonist healer can help' framing.\n\nOnce the civilians are safe:\n\nFull Greenhollow exploration/resupply becomes available again.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "RETURN TO GREENHOLLOW"}},
{"beat_id": "S009_B110", "speaker_id": "maevra", "text": "We're continuing east.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — EAST", "staging": "Later, back at the route board.\n\nMaevra studies the eastward roads."}},
{"beat_id": "S009_B111", "speaker_id": "torren", "text": "Not by marked road.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — EAST", "staging": "Torren looks at the marked route."}},
{"beat_id": "S009_B112", "speaker_id": "maevra", "text": "Yes, Harth. We established that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — EAST", "staging": "Maevra looks at him."}},
{"beat_id": "S009_B113", "speaker_id": "cyanis", "text": "You know Briar Passage.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — EAST", "staging": "Cyanis steps closer."}},
{"beat_id": "S009_B114", "speaker_id": "torren", "text": "Parts.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — EAST"}},
{"beat_id": "S009_B115", "speaker_id": "cyanis", "text": "Enough to keep us off the wrong part?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — EAST"}},
{"beat_id": "S009_B116", "speaker_id": "torren", "text": "Probably.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — EAST", "staging": "Torren thinks about it.\n\nActually thinks."}},
{"beat_id": "S009_B117", "speaker_id": "cyanis", "text": "Useful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — EAST", "staging": "Cyanis nods."}},
{"beat_id": "S009_B118", "speaker_id": "torren", "text": "You're headed east.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — EAST", "staging": "Torren adjusts his bow."}},
{"beat_id": "S009_B119", "speaker_id": "torren", "text": "So am I.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — EAST", "staging": "Beat."}},
{"beat_id": "S009_B120", "speaker_id": "maevra", "text": "Of course you are.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — EAST", "staging": "Maevra looks at him.\n\nA very particular kind of tired familiarity.", "staging_after": "Torren almost smiles.\n\nNothing else.\n\nNo relationship explanation."}},
{"beat_id": "S009_B121", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "**TORREN HARTH — PERMANENT PARTY MEMBER**\n\nCurrent Class: WAR ARCHER\n\nNo Routeweaver.\n\nNo Subclass preview.\n\nNo future Sixfold Accord knowledge.\n\nNo giant tutorial wall.\n\nCurrent story roster:\n\n**• Cyanis — permanent**\n\n**• Ilyra — permanent**\n\n**• Torren — permanent**\n\n**• Maevra — temporary guest**\n\nTorren finally becomes commandable here, after the Greenhollow problem is resolved. That keeps his pre-recruitment guide role mechanically honest.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "PARTY UPDATE"}},
{"beat_id": "S009_B122", "speaker_id": "cyanis", "text": "Anything else we're planning to use that's wrong?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — BEFORE BRIAR PASSAGE", "staging": "Torren removes an old notice from the board.\n\nReplaces it.\n\nCyanis watches."}},
{"beat_id": "S009_B123", "speaker_id": "torren", "text": "Probably.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — BEFORE BRIAR PASSAGE"}},
{"beat_id": "S009_B124", "speaker_id": "cyanis", "text": "You're going to make me ask, aren't you?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — BEFORE BRIAR PASSAGE", "staging": "Cyanis waits.\n\nTorren keeps writing."}},
{"beat_id": "S009_B125", "speaker_id": "torren", "text": "Briar Passage isn't right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — BEFORE BRIAR PASSAGE"}},
{"beat_id": "S009_B126", "speaker_id": "maevra", "text": "Define that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — BEFORE BRIAR PASSAGE", "staging": "Maevra looks over."}},
{"beat_id": "S009_B127", "speaker_id": "torren", "text": "Some old markers moved.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — BEFORE BRIAR PASSAGE"}},
{"beat_id": "S009_B128", "speaker_id": "ilyra", "text": "And the others?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — BEFORE BRIAR PASSAGE", "staging": "Ilyra looks at him."}},
{"beat_id": "S009_B129", "speaker_id": "torren", "text": "New.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — BEFORE BRIAR PASSAGE", "staging": "Torren shoulders his bow."}},
{"beat_id": "S009_B130", "speaker_id": "cyanis", "text": "That's encouraging.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — BEFORE BRIAR PASSAGE", "staging": "Silence.\n\nCyanis looks east."}},
{"beat_id": "S009_B131", "speaker_id": "torren", "text": "Wasn't meant to be.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "ROSTER_ADD_TORREN_PERMANENT"], "source_section": "B010 — BEFORE BRIAR PASSAGE", "staging_after": "Torren starts walking.\n\nThe others follow.\n\n**END S009.**\n\nTransition to S010 — Briar Passage / The Route I Would Take."}}
]
