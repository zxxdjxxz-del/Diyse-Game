beats = [
{"beat_id": "C03_B001", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "Very cheap 2.5D.\n\nOne sheltered roadside/rest background.\n\nExisting fire.\n\nOne pot.\n\nThree bowls.\n\nBread.\n\nLadle.\n\nWater.\n\nReusable sitting/eating/stirring poses.\n\nNo cooking montage.\n\nNo elaborate food animation.\n\nNo Maevra required for this scene.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "PRODUCTION"}},
{"beat_id": "C03_B002", "speaker_id": "cyanis", "text": "What is that?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — DINNER", "staging": "Evening.\n\nTorren is stirring something in a pot.\n\nCyanis walks over.\n\nLooks into it.\n\nKeeps looking."}},
{"beat_id": "C03_B003", "speaker_id": "torren", "text": "Dinner.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — DINNER"}},
{"beat_id": "C03_B004", "speaker_id": "cyanis", "text": "I understood the category.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — DINNER"}},
{"beat_id": "C03_B005", "speaker_id": "torren", "text": "Then why'd you ask?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — DINNER", "staging": "Torren stirs once."}},
{"beat_id": "C03_B006", "speaker_id": "cyanis", "text": "Hoping for specifics.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — DINNER", "staging": "Cyanis looks into the pot again."}},
{"beat_id": "C03_B007", "speaker_id": "torren", "text": "Beans.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — DINNER"}},
{"beat_id": "C03_B008", "speaker_id": "torren", "text": "Meat.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — DINNER", "staging": "Beat."}},
{"beat_id": "C03_B009", "speaker_id": "torren", "text": "Other things.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — DINNER", "staging": "Another beat."}},
{"beat_id": "C03_B010", "speaker_id": "cyanis", "text": "Several things have surrendered.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — DINNER", "staging": "Cyanis looks at him."}},
{"beat_id": "C03_B011", "speaker_id": "torren", "text": "You eating?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — DINNER", "staging": "Torren points the ladle at him."}},
{"beat_id": "C03_B012", "speaker_id": "cyanis", "text": "Obviously.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — DINNER"}},
{"beat_id": "C03_B013", "speaker_id": "cyanis", "text": "You made this on purpose.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STANDARDS", "staging": "Ilyra sits down with her bowl.\n\nCyanis tastes his.\n\nStops.\n\nLooks at Torren.\n\nTorren is already eating."}},
{"beat_id": "C03_B014", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STANDARDS"}},
{"beat_id": "C03_B015", "speaker_id": "cyanis", "text": "Interesting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STANDARDS"}},
{"beat_id": "C03_B016", "speaker_id": "torren", "text": "Hot.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STANDARDS"}},
{"beat_id": "C03_B017", "speaker_id": "torren", "text": "Enough.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STANDARDS", "staging": "Cyanis waits."}},
{"beat_id": "C03_B018", "speaker_id": "torren", "text": "Safe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STANDARDS", "staging": "Ilyra looks over."}},
{"beat_id": "C03_B019", "speaker_id": "torren", "text": "Cheap.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STANDARDS", "staging": "Another bite."}},
{"beat_id": "C03_B020", "speaker_id": "cyanis", "text": "Those are your standards?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STANDARDS"}},
{"beat_id": "C03_B021", "speaker_id": "torren", "text": "Those are the jobs.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STANDARDS"}},
{"beat_id": "C03_B022", "speaker_id": "ilyra", "text": "Taste isn't a job?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STANDARDS"}},
{"beat_id": "C03_B023", "speaker_id": "torren", "text": "Bonus.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STANDARDS"}},
{"beat_id": "C03_B024", "speaker_id": "ilyra", "text": "I don't think it's bad.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STANDARDS", "staging": "Ilyra tastes hers again.\n\nThinks."}},
{"beat_id": "C03_B025", "speaker_id": "cyanis", "text": "You don't have to protect him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STANDARDS", "staging": "Cyanis turns toward her."}},
{"beat_id": "C03_B026", "speaker_id": "torren", "text": "Don't help me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STANDARDS", "staging": "Torren looks at Ilyra."}},
{"beat_id": "C03_B027", "speaker_id": "ilyra", "text": "I wasn't—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STANDARDS"}},
{"beat_id": "C03_B028", "speaker_id": "torren", "text": "Makes him worse.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STANDARDS"}},
{"beat_id": "C03_B029", "speaker_id": "cyanis", "text": "I'm sitting right here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STANDARDS"}},
{"beat_id": "C03_B030", "speaker_id": "ilyra", "text": "I noticed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — STANDARDS"}},
{"beat_id": "C03_B031", "speaker_id": "cyanis", "text": "Jesus Christ.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD", "staging": "Cyanis tears off a piece of bread.\n\nTakes a bite.\n\nImmediately looks offended."}},
{"beat_id": "C03_B032", "speaker_id": "torren", "text": "What?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD", "staging": "Torren looks up."}},
{"beat_id": "C03_B033", "speaker_id": "cyanis", "text": "This is terrible.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD", "staging": "Cyanis holds up the bread."}},
{"beat_id": "C03_B034", "speaker_id": "torren", "text": "Didn't make it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD"}},
{"beat_id": "C03_B035", "speaker_id": "cyanis", "text": "You served it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD"}},
{"beat_id": "C03_B036", "speaker_id": "torren", "text": "Was bread when I bought it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD"}},
{"beat_id": "C03_B037", "speaker_id": "ilyra", "text": "It's very hard.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD", "staging": "Ilyra takes a piece.\n\nTests it with her fingers."}},
{"beat_id": "C03_B038", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD"}},
{"beat_id": "C03_B039", "speaker_id": "ilyra", "text": "How old is it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD"}},
{"beat_id": "C03_B040", "speaker_id": "torren", "text": "Don't know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD"}},
{"beat_id": "C03_B041", "speaker_id": "cyanis", "text": "Could kill somebody with this.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD"}},
{"beat_id": "C03_B042", "speaker_id": "torren", "text": "Then don't waste it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD"}},
{"beat_id": "C03_B043", "speaker_id": "cyanis", "text": "That's not a defense.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD", "staging": "Cyanis looks at the bread.\n\nThen at Torren."}},
{"beat_id": "C03_B044", "speaker_id": "torren", "text": "Didn't say it was.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD"}},
{"beat_id": "C03_B045", "speaker_id": "ilyra", "text": "There.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD", "staging": "Ilyra dips hers into the bowl.\n\nWaits.\n\nTakes a bite."}},
{"beat_id": "C03_B046", "speaker_id": "ilyra", "text": "It's fine if you soak it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD", "staging": "Cyanis watches her."}},
{"beat_id": "C03_B047", "speaker_id": "torren", "text": "See?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD", "staging": "Torren points at her with his spoon."}},
{"beat_id": "C03_B048", "speaker_id": "cyanis", "text": "You said not to help you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD"}},
{"beat_id": "C03_B049", "speaker_id": "torren", "text": "Changed my mind.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD"}},
{"beat_id": "C03_B050", "speaker_id": "ilyra", "text": "I'm done participating.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — THE BREAD", "staging": "Ilyra realizes she has somehow made the argument worse."}},
{"beat_id": "C03_B051", "speaker_id": "torren", "text": "Thought it was bad.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — SECOND BOWL", "staging": "A little later.\n\nCyanis holds out his empty bowl.\n\nTorren looks at it.\n\nThen at Cyanis."}},
{"beat_id": "C03_B052", "speaker_id": "cyanis", "text": "It is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — SECOND BOWL"}},
{"beat_id": "C03_B053", "speaker_id": "cyanis", "text": "There's still food.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — SECOND BOWL", "staging": "Torren does not move.\n\nCyanis keeps holding the bowl out."}},
{"beat_id": "C03_B054", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — SECOND BOWL"}},
{"beat_id": "C03_B055", "speaker_id": "cyanis", "text": "And I'm still hungry.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — SECOND BOWL"}},
{"beat_id": "C03_B056", "speaker_id": "torren", "text": "Strong endorsement.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — SECOND BOWL", "staging": "Torren ladles him another serving."}},
{"beat_id": "C03_B057", "speaker_id": "cyanis", "text": "Don't get excited.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — SECOND BOWL"}},
{"beat_id": "C03_B058", "speaker_id": "ilyra", "text": "You ate all of the first one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — SECOND BOWL", "staging": "Ilyra looks at Cyanis's second bowl."}},
{"beat_id": "C03_B059", "speaker_id": "cyanis", "text": "I contain contradictions.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — SECOND BOWL"}},
{"beat_id": "C03_B060", "speaker_id": "torren", "text": "Mostly food, apparently.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — SECOND BOWL", "staging_after": "Cyanis starts eating."}},
{"beat_id": "C03_B061", "speaker_id": "ilyra", "text": "You always make this much?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHY SO MUCH", "staging": "Ilyra looks at the pot.\n\nThere is still a lot left."}},
{"beat_id": "C03_B062", "speaker_id": "torren", "text": "Usually.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHY SO MUCH"}},
{"beat_id": "C03_B063", "speaker_id": "ilyra", "text": "For yourself?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHY SO MUCH"}},
{"beat_id": "C03_B064", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHY SO MUCH"}},
{"beat_id": "C03_B065", "speaker_id": "cyanis", "text": "Why?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHY SO MUCH", "staging": "Cyanis looks at the pot."}},
{"beat_id": "C03_B066", "speaker_id": "torren", "text": "When you're cooking for six, you make a meal.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHY SO MUCH", "staging": "Torren shrugs."}},
{"beat_id": "C03_B067", "speaker_id": "torren", "text": "Cooking for one, you make enough not to do it again tomorrow.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHY SO MUCH", "staging": "He takes another bite."}},
{"beat_id": "C03_B068", "speaker_id": "ilyra", "text": "That's actually sensible.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHY SO MUCH", "staging": "Ilyra nods slowly."}},
{"beat_id": "C03_B069", "speaker_id": "torren", "text": "Thank you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHY SO MUCH", "staging": "Torren looks at her."}},
{"beat_id": "C03_B070", "speaker_id": "cyanis", "text": "Don't encourage him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHY SO MUCH"}},
{"beat_id": "C03_B071", "speaker_id": "ilyra", "text": "I can't agree with either of you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHY SO MUCH", "staging": "Ilyra looks between them."}},
{"beat_id": "C03_B072", "speaker_id": "cyanis", "text": "Why not?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHY SO MUCH"}},
{"beat_id": "C03_B073", "speaker_id": "ilyra", "text": "Because whichever one I agree with becomes unbearable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHY SO MUCH"}},
{"beat_id": "C03_B074", "speaker_id": "torren", "text": "Fair.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHY SO MUCH"}},
{"beat_id": "C03_B075", "speaker_id": "cyanis", "text": "Cowardice.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — WHY SO MUCH", "staging_after": "Ilyra keeps eating."}},
{"beat_id": "C03_B076", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "The argument runs out.\n\nNot because anything meaningful happened.\n\nThey're just eating.\n\nCyanis finishes most of his second bowl.\n\nIlyra soaks another piece of the terrible bread.\n\nTorren finishes his food.\n\nA few seconds pass.\n\nNobody speaks.\n\nThe practical reason for sitting together is basically over.\n\nNobody gets up.\n\nTorren reaches over and moves the pot away from the hottest part of the fire.\n\nThen he takes out a blunt.\n\nHe leans toward the coals and catches the end from an ember.\n\nA small glow.\n\nCheap looping smoke.\n\nHe sits back and takes a pull.\n\nNobody comments on it.\n\nConversation does not turn toward the smoking.\n\nMore quiet.\n\nComfortable enough.\n\nNo one comments on that either.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "B006 — AFTER DINNER"}},
{"beat_id": "C03_B077", "speaker_id": "cyanis", "text": "You know what would've helped?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — TOMORROW", "staging": "Cyanis looks at the little food left in his bowl."}},
{"beat_id": "C03_B078", "speaker_id": "torren", "text": "Salt?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — TOMORROW", "staging": "Torren doesn't look up."}},
{"beat_id": "C03_B079", "speaker_id": "cyanis", "text": "Actually, yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — TOMORROW", "staging": "Cyanis pauses."}},
{"beat_id": "C03_B080", "speaker_id": "torren", "text": "Tomorrow night, you cook.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — TOMORROW", "staging": "Torren nods."}},
{"beat_id": "C03_B081", "speaker_id": "cyanis", "text": "I withdraw my complaint.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — TOMORROW", "staging": "Cyanis immediately:"}},
{"beat_id": "C03_B082", "speaker_id": "torren", "text": "Too late.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — TOMORROW"}},
{"beat_id": "C03_B083", "speaker_id": "cyanis", "text": "You could help me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — TOMORROW", "staging": "Ilyra laughs into her bowl.\n\nCyanis looks at her."}},
{"beat_id": "C03_B084", "speaker_id": "ilyra", "text": "I already established the danger of that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — TOMORROW"}},
{"beat_id": "C03_B085", "speaker_id": "cyanis", "text": "How bad do you think tomorrow is going to be?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — TOMORROW", "staging": "Torren reaches for the pot with his free hand, blunt still between two fingers.\n\nCyanis looks at Ilyra."}},
{"beat_id": "C03_B086", "speaker_id": "ilyra", "text": "Depends.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — TOMORROW"}},
{"beat_id": "C03_B087", "speaker_id": "cyanis", "text": "On?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — TOMORROW"}},
{"beat_id": "C03_B088", "speaker_id": "ilyra", "text": "Whether he makes you use the bread.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — TOMORROW"}},
{"beat_id": "C03_B089", "speaker_id": "cyanis", "text": "Fuck.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — TOMORROW", "staging": "Cyanis looks at the remaining loaf.\n\nBeat.", "staging_after": "Ilyra starts laughing again.\n\nTorren quietly smiles and takes another pull.\n\nFade.\n\n**END C03.**\n\nC04 and C05 remain available regardless of whether C03 was viewed first."}}
