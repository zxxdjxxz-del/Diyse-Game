authoring_notes = "Chapter 1 exact Resource conversion from docs/chapters/dialogue/chapter_01/C05.md under Complete Master Canon v1.64 / Audit79. Spoken text is line-complete and must not be rewritten. Source production/staging prose is preserved in beat cue metadata; source subsection names are carried in cues.source_section. Portrait slots remain empty until approved registry expressions/assets are wired. Spoken-sequence SHA-256: 2b4e19195cae3dcf187d893f7ab87d1ce7c258d95a01cefe5f5ea1ebe28af0c7."
beats = [
{"beat_id": "C05_B001", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "Brackenwall, evening.\n\nSmall supply/medical work area.\n\nCheap 2.5D:\n\n**• one table;**\n\n**• Ilyra's medical pouch and loose supplies;**\n\n**• Maevra's reports;**\n\n**• cups;**\n\n**• existing sit/sort/read/stand poses;**\n\n**• portraits and expression changes.**\n\nMaevra's arm is still sore from Hollow Watch.\n\nNo lore.\n\nNo Hunt material.\n\nNo relationship speech.\n\nNo gameplay reward.\n\nThe scene is not two women managing an irresponsible man. The joke only works because Ilyra and Maevra are doing essentially the same shit themselves.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "PRODUCTION"}},
{"beat_id": "C05_B002", "speaker_id": "ilyra", "text": "You're supposed to be resting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — RESTING", "staging": "Ilyra is checking medical supplies.\n\nMaevra is reading a report."}},
{"beat_id": "C05_B003", "speaker_id": "maevra", "text": "I am sitting down.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — RESTING"}},
{"beat_id": "C05_B004", "speaker_id": "ilyra", "text": "That's not the same thing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — RESTING"}},
{"beat_id": "C05_B005", "speaker_id": "maevra", "text": "Neither is reorganizing that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — RESTING", "staging": "Maevra looks at Ilyra's half-emptied medical pouch."}},
{"beat_id": "C05_B006", "speaker_id": "ilyra", "text": "We're not discussing me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — RESTING"}},
{"beat_id": "C05_B007", "speaker_id": "maevra", "text": "Convenient.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B001 — RESTING"}},
{"beat_id": "C05_B008", "speaker_id": "maevra", "text": "Fine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — FINE", "staging": "Ilyra's attention drops to Maevra's arm.\n\nMaevra catches the look."}},
{"beat_id": "C05_B009", "speaker_id": "maevra", "text": "Sore.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — FINE", "staging": "Ilyra keeps looking.\n\nBeat."}},
{"beat_id": "C05_B010", "speaker_id": "ilyra", "text": "Better.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — FINE"}},
{"beat_id": "C05_B011", "speaker_id": "maevra", "text": "I preferred fine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — FINE"}},
{"beat_id": "C05_B012", "speaker_id": "ilyra", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B002 — FINE", "staging_after": "Ilyra goes back to the pouch.\n\nMaevra goes back to the report.\n\nNeither stops working."}},
{"beat_id": "C05_B013", "speaker_id": "ilyra", "text": "Does Dovaren ever stop moving?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — DOVAREN", "staging": "A little while passes."}},
{"beat_id": "C05_B014", "speaker_id": "maevra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — DOVAREN"}},
{"beat_id": "C05_B015", "speaker_id": "ilyra", "text": "That was fast.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — DOVAREN", "staging": "Ilyra looks up."}},
{"beat_id": "C05_B016", "speaker_id": "maevra", "text": "I've researched the subject.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — DOVAREN"}},
{"beat_id": "C05_B017", "speaker_id": "ilyra", "text": "Results conclusive?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — DOVAREN"}},
{"beat_id": "C05_B018", "speaker_id": "maevra", "text": "Depressingly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B003 — DOVAREN"}},
{"beat_id": "C05_B019", "speaker_id": "maevra", "text": "I told him ten minutes this morning.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — TEN MINUTES", "staging": "Maevra turns a page."}},
{"beat_id": "C05_B020", "speaker_id": "ilyra", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — TEN MINUTES"}},
{"beat_id": "C05_B021", "speaker_id": "maevra", "text": "He took that to mean he needed to walk twice as fast.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — TEN MINUTES"}},
{"beat_id": "C05_B022", "speaker_id": "ilyra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — TEN MINUTES"}},
{"beat_id": "C05_B023", "speaker_id": "maevra", "text": "You didn't warn me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — TEN MINUTES", "staging": "Maevra looks at her."}},
{"beat_id": "C05_B024", "speaker_id": "ilyra", "text": "I thought it would be funny.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — TEN MINUTES", "staging": "Ilyra continues sorting supplies."}},
{"beat_id": "C05_B025", "speaker_id": "maevra", "text": "It was a little funny.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B004 — TEN MINUTES", "staging": "Maevra stares at her.\n\nBeat.", "staging_after": "Ilyra smiles."}},
{"beat_id": "C05_B026", "speaker_id": "ilyra", "text": "He does it with food too.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — FOOD"}},
{"beat_id": "C05_B027", "speaker_id": "maevra", "text": "Refuses?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — FOOD"}},
{"beat_id": "C05_B028", "speaker_id": "ilyra", "text": "Not exactly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — FOOD"}},
{"beat_id": "C05_B029", "speaker_id": "ilyra", "text": "He treats eating as something he'll get around to once every other living person has been accounted for.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — FOOD", "staging": "Ilyra closes one compartment.\n\nOpens another."}},
{"beat_id": "C05_B030", "speaker_id": "maevra", "text": "Ah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — FOOD"}},
{"beat_id": "C05_B031", "speaker_id": "ilyra", "text": "You know the type.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B005 — FOOD", "staging": "Ilyra looks at Maevra's report.", "staging_after": "Maevra very deliberately looks back down at the page."}},
{"beat_id": "C05_B032", "speaker_id": "ilyra", "text": "Oh, don't do that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STAY FOCUSED"}},
{"beat_id": "C05_B033", "speaker_id": "maevra", "text": "Do what?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STAY FOCUSED"}},
{"beat_id": "C05_B034", "speaker_id": "ilyra", "text": "Pretend I wasn't also talking about you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STAY FOCUSED"}},
{"beat_id": "C05_B035", "speaker_id": "maevra", "text": "We're complaining about Dovaren.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STAY FOCUSED"}},
{"beat_id": "C05_B036", "speaker_id": "ilyra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STAY FOCUSED"}},
{"beat_id": "C05_B037", "speaker_id": "maevra", "text": "Stay focused.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STAY FOCUSED"}},
{"beat_id": "C05_B038", "speaker_id": "ilyra", "text": "Commander.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STAY FOCUSED", "staging": "Ilyra gives her a look."}},
{"beat_id": "C05_B039", "speaker_id": "maevra", "text": "I heard that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STAY FOCUSED", "staging": "Maevra catches the mock obedience immediately."}},
{"beat_id": "C05_B040", "speaker_id": "ilyra", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B006 — STAY FOCUSED", "staging_after": "That is where their friendship starts showing without either of them announcing it."}},
{"beat_id": "C05_B041", "speaker_id": "ilyra", "text": "He asks questions at inconvenient times.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — QUESTIONS"}},
{"beat_id": "C05_B042", "speaker_id": "maevra", "text": "Constantly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — QUESTIONS"}},
{"beat_id": "C05_B043", "speaker_id": "ilyra", "text": "Not stupid questions.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — QUESTIONS"}},
{"beat_id": "C05_B044", "speaker_id": "maevra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — QUESTIONS"}},
{"beat_id": "C05_B045", "speaker_id": "ilyra", "text": "That would be easier.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — QUESTIONS"}},
{"beat_id": "C05_B046", "speaker_id": "maevra", "text": "Awful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — QUESTIONS"}},
{"beat_id": "C05_B047", "speaker_id": "ilyra", "text": "It is when you're busy.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — QUESTIONS"}},
{"beat_id": "C05_B048", "speaker_id": "maevra", "text": "Useful, though.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — QUESTIONS", "staging": "Maevra thinks."}},
{"beat_id": "C05_B049", "speaker_id": "ilyra", "text": "We're complaining.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — QUESTIONS", "staging": "Ilyra looks at her."}},
{"beat_id": "C05_B050", "speaker_id": "maevra", "text": "Sorry.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B007 — QUESTIONS"}},
{"beat_id": "C05_B051", "speaker_id": "maevra", "text": "Your turn.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — FINE, AGAIN", "staging": "Maevra sets one report aside."}},
{"beat_id": "C05_B052", "speaker_id": "ilyra", "text": "He says he's fine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — FINE, AGAIN"}},
{"beat_id": "C05_B053", "speaker_id": "maevra", "text": "That's it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — FINE, AGAIN"}},
{"beat_id": "C05_B054", "speaker_id": "ilyra", "text": "No. That's the opening move.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — FINE, AGAIN"}},
{"beat_id": "C05_B055", "speaker_id": "ilyra", "text": "Does your shoulder hurt?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — FINE, AGAIN", "staging": "Ilyra imitates the exchange without doing a Cyanis voice."}},
{"beat_id": "C05_B056", "speaker_id": "ilyra", "text": "Torren took the harder side of that last fight.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B008 — FINE, AGAIN", "staging": "Beat.", "staging_after": "Maevra understands immediately."}},
{"beat_id": "C05_B057", "speaker_id": "maevra", "text": "What if you ask again?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — LOGISTICS"}},
{"beat_id": "C05_B058", "speaker_id": "ilyra", "text": "He becomes very interested in logistics.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — LOGISTICS"}},
{"beat_id": "C05_B059", "speaker_id": "maevra", "text": "Of course he does.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — LOGISTICS"}},
{"beat_id": "C05_B060", "speaker_id": "ilyra", "text": "Water. Supplies. Distance. Watches. Anything with a number.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — LOGISTICS"}},
{"beat_id": "C05_B061", "speaker_id": "maevra", "text": "Have you tried threatening him?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — LOGISTICS", "staging": "Maevra folds her report slightly."}},
{"beat_id": "C05_B062", "speaker_id": "ilyra", "text": "Medically?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — LOGISTICS", "staging": "Ilyra looks over."}},
{"beat_id": "C05_B063", "speaker_id": "maevra", "text": "I wasn't going to specify.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B009 — LOGISTICS", "staging_after": "Ilyra laughs."}},
{"beat_id": "C05_B064", "speaker_id": "maevra", "text": "Dovaren.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — CAUGHT", "staging": "Cyanis enters carrying gear.\n\nMaevra sees him first."}},
{"beat_id": "C05_B065", "speaker_id": "cyanis", "text": "Commander.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — CAUGHT"}},
{"beat_id": "C05_B066", "speaker_id": "ilyra", "text": "Have you eaten?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — CAUGHT", "staging": "Ilyra looks over."}},
{"beat_id": "C05_B067", "speaker_id": "cyanis", "text": "Recently.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — CAUGHT", "staging": "Cyanis keeps walking."}},
{"beat_id": "C05_B068", "speaker_id": "maevra", "text": "That is not an answer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — CAUGHT"}},
{"beat_id": "C05_B069", "speaker_id": "cyanis", "text": "It was intended as one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B010 — CAUGHT"}},
{"beat_id": "C05_B070", "speaker_id": "maevra", "text": "Eat.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — EAT", "staging": "Maevra does not even look up from the report."}},
{"beat_id": "C05_B071", "speaker_id": "ilyra", "text": "Eat.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — EAT", "staging": "At exactly the same time:"}},
{"beat_id": "C05_B072", "speaker_id": "cyanis", "text": "Is this coordinated?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — EAT", "staging": "Cyanis stops.\n\nLooks between them."}},
{"beat_id": "C05_B073", "speaker_id": "maevra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — EAT"}},
{"beat_id": "C05_B074", "speaker_id": "ilyra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — EAT"}},
{"beat_id": "C05_B075", "speaker_id": "ilyra", "text": "Apparently we're still refining the procedure.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B011 — EAT", "staging": "Ilyra looks at Maevra.\n\nMaevra looks at Ilyra."}},
{"beat_id": "C05_B076", "speaker_id": "cyanis", "text": "I see.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B012 — FOOD"}},
{"beat_id": "C05_B077", "speaker_id": "maevra", "text": "Food.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B012 — FOOD"}},
{"beat_id": "C05_B078", "speaker_id": "cyanis", "text": "I was going—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B012 — FOOD"}},
{"beat_id": "C05_B079", "speaker_id": "ilyra", "text": "Cyanis.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B012 — FOOD"}},
{"beat_id": "C05_B080", "speaker_id": "cyanis", "text": "Fine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B012 — FOOD", "staging": "He stops.\n\nBeat.", "staging_after": "He puts the gear down."}},
{"beat_id": "C05_B081", "speaker_id": "cyanis", "text": "Were you talking about me?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B013 — AT LENGTH", "staging": "Cyanis looks at them.\n\nThen the reports.\n\nThen the medical supplies."}},
{"beat_id": "C05_B082", "speaker_id": "maevra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B013 — AT LENGTH"}},
{"beat_id": "C05_B083", "speaker_id": "ilyra", "text": "At length.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B013 — AT LENGTH"}},
{"beat_id": "C05_B084", "speaker_id": "cyanis", "text": "Anything flattering?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B013 — AT LENGTH"}},
{"beat_id": "C05_B085", "speaker_id": "cyanis", "text": "That's hurtful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B013 — AT LENGTH", "staging": "Silence.\n\nCyanis waits.\n\nNeither woman helps him."}},
{"beat_id": "C05_B086", "speaker_id": "maevra", "text": "You ask useful questions.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B014 — USEFUL", "staging": "Maevra finally puts the report down."}},
{"beat_id": "C05_B087", "speaker_id": "ilyra", "text": "At terrible times.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B014 — USEFUL"}},
{"beat_id": "C05_B088", "speaker_id": "cyanis", "text": "There it is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B014 — USEFUL", "staging": "Cyanis points at Maevra."}},
{"beat_id": "C05_B089", "speaker_id": "ilyra", "text": "You notice when other people need something.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B014 — USEFUL"}},
{"beat_id": "C05_B090", "speaker_id": "maevra", "text": "And become mysteriously stupid when the other person is you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B014 — USEFUL"}},
{"beat_id": "C05_B091", "speaker_id": "cyanis", "text": "That feels less like complaining and more like an ambush.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B014 — USEFUL", "staging": "Cyanis looks between them."}},
{"beat_id": "C05_B092", "speaker_id": "maevra", "text": "Eat.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B014 — USEFUL"}},
{"beat_id": "C05_B093", "speaker_id": "ilyra", "text": "Don't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B015 — HYPOCRITES", "staging": "Cyanis starts toward the food.\n\nThen stops.\n\nSlowly looks back.\n\nAt Maevra's reports.\n\nAt Ilyra's half-repacked medical kit.\n\nA smile starts.\n\nBoth women see it.\n\nImmediately:"}},
{"beat_id": "C05_B094", "speaker_id": "cyanis", "text": "You're both working.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B015 — HYPOCRITES"}},
{"beat_id": "C05_B095", "speaker_id": "maevra", "text": "Dovaren.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B015 — HYPOCRITES"}},
{"beat_id": "C05_B096", "speaker_id": "cyanis", "text": "While telling me to stop working.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B015 — HYPOCRITES"}},
{"beat_id": "C05_B097", "speaker_id": "ilyra", "text": "Not the same thing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B015 — HYPOCRITES"}},
{"beat_id": "C05_B098", "speaker_id": "cyanis", "text": "Of course not.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B015 — HYPOCRITES", "staging": "Cyanis nods solemnly."}},
{"beat_id": "C05_B099", "speaker_id": "cyanis", "text": "Wonderful conversation. Very educational.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B015 — HYPOCRITES", "staging": "He picks his gear back up."}},
{"beat_id": "C05_B100", "speaker_id": "maevra", "text": "Put that down.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B016 — EVERYBODY STOPS"}},
{"beat_id": "C05_B101", "speaker_id": "cyanis", "text": "Why?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B016 — EVERYBODY STOPS"}},
{"beat_id": "C05_B102", "speaker_id": "maevra", "text": "Because now you're being difficult on purpose.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B016 — EVERYBODY STOPS"}},
{"beat_id": "C05_B103", "speaker_id": "cyanis", "text": "Fair.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B016 — EVERYBODY STOPS", "staging": "Cyanis considers that."}},
{"beat_id": "C05_B104", "speaker_id": "ilyra", "text": "Food.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B016 — EVERYBODY STOPS", "staging": "He puts the gear back down.\n\nIlyra closes one section of the medical pouch."}},
{"beat_id": "C05_B105", "speaker_id": "cyanis", "text": "Both of you coming?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B016 — EVERYBODY STOPS", "staging": "Cyanis looks at both women.\n\nNeither one has moved."}},
{"beat_id": "C05_B106", "speaker_id": "cyanis", "text": "Thought so.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B016 — EVERYBODY STOPS", "staging": "Silence.\n\nCyanis waits.", "staging_after": "Ilyra looks at Maevra.\n\nMaevra looks at the report.\n\nThen deliberately leaves it on the table.\n\nIlyra closes the medical pouch completely.\n\nNo speech.\n\nThey just stop."}},
{"beat_id": "C05_B107", "speaker_id": "maevra", "text": "I hate him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B017 — I HATE HIM", "staging": "Cyanis heads toward the doorway.\n\nMaevra watches him."}},
{"beat_id": "C05_B108", "speaker_id": "ilyra", "text": "No, you don't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B017 — I HATE HIM", "staging": "Ilyra stands."}},
{"beat_id": "C05_B109", "speaker_id": "maevra", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B017 — I HATE HIM", "staging": "Maevra exhales."}},
{"beat_id": "C05_B110", "speaker_id": "cyanis", "text": "I can still hear you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B017 — I HATE HIM", "staging": "From the doorway:"}},
{"beat_id": "C05_B111", "speaker_id": "maevra", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B017 — I HATE HIM", "staging": "Maevra does not miss a beat."}},
{"beat_id": "C05_B112", "speaker_id": "maevra", "text": "If the food's gone—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B018 — DINNER", "staging": "They stand.\n\nIlyra takes the closed medical pouch but does not reopen it.\n\nMaevra leaves the report behind.\n\nCyanis waits instead of walking off without them."}},
{"beat_id": "C05_B113", "speaker_id": "cyanis", "text": "Torren cooked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B018 — DINNER"}},
{"beat_id": "C05_B114", "speaker_id": "maevra", "text": "There's some left.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B018 — DINNER", "staging": "Maevra relaxes."}},
{"beat_id": "C05_B115", "speaker_id": "cyanis", "text": "Probably.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B018 — DINNER"}},
{"beat_id": "C05_B116", "speaker_id": "ilyra", "text": "You've been spending too much time with Torren.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B018 — DINNER", "staging": "Ilyra looks at him."}},
{"beat_id": "C05_B117", "speaker_id": "cyanis", "text": "Probably.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "B018 — DINNER", "staging": "Cyanis considers it.", "staging_after": "They leave together.\n\nCut.\n\n**END C05.**"}}
]
