[ext_resource type="Script" path="res://game/dialogue/dialogue_scene_definition.gd" id="1_scene"]

[resource]
script = ExtResource("1_scene")
schema_version = 1
scene_id = "C05"
chapter_id = "chapter_01"
scene_kind = "character_life"
location_id = "LOC_BRD_BRACKENWALL"
trigger_id = "trigger.chapter_01.c05.after_s011"
completion_flag = "scene.c05.complete"
participants = Array[String](["ilyra", "maevra", "cyanis"])
authoring_notes = "Audit75 conversion of the closed C05 Two Professionals Complaining About Cyanis Character-Life scene. Function: Ilyra/Maevra adult friendship plus reciprocal recognition of shared self-neglect; it is not two women managing an irresponsible man. Cheap 2.5D uses evening supply/medical staging, medical pouch, report, sore-arm acting, and reusable sit/sort/report/stand states."
beats = [{"beat_id":"C05_B001","cues":{"staging":"Evening after S011 in Brackenwall's supply/medical staging area. Maevra is seated with a report. Ilyra is reorganizing her medical pouch instead of resting."}},
{"beat_id":"C05_B002","speaker_id":"ilyra","text":"You're supposed to be resting."},
{"beat_id":"C05_B003","speaker_id":"maevra","text":"I am sitting down."},
{"beat_id":"C05_B004","speaker_id":"ilyra","text":"That's not the same thing."},
{"beat_id":"C05_B005","cues":{"staging":"Maevra looks pointedly at the medical pouch in Ilyra's hands."}},
{"beat_id":"C05_B006","speaker_id":"ilyra","text":"We're not discussing me."},
{"beat_id":"C05_B007","speaker_id":"maevra","text":"Convenient."},
{"beat_id":"C05_B008","cues":{"staging":"Ilyra checks Maevra's bruised arm with the same practical look used earlier."}},
{"beat_id":"C05_B009","speaker_id":"maevra","text":"Fine."},
{"beat_id":"C05_B010","cues":{"staging":"Ilyra just looks at her."}},
{"beat_id":"C05_B011","speaker_id":"maevra","text":"Sore."},
{"beat_id":"C05_B012","speaker_id":"ilyra","text":"Better."},
{"beat_id":"C05_B013","speaker_id":"maevra","text":"I preferred fine."},
{"beat_id":"C05_B014","speaker_id":"ilyra","text":"I know."},
{"beat_id":"C05_B015","speaker_id":"maevra","text":"Does Dovaren ever stop moving?"},
{"beat_id":"C05_B016","speaker_id":"ilyra","text":"No."},
{"beat_id":"C05_B017","speaker_id":"maevra","text":"That was fast."},
{"beat_id":"C05_B018","speaker_id":"ilyra","text":"I've researched the subject."},
{"beat_id":"C05_B019","speaker_id":"maevra","text":"Results conclusive?"},
{"beat_id":"C05_B020","speaker_id":"ilyra","text":"Depressingly."},
{"beat_id":"C05_B021","cues":{"staging":"They drift into the earlier ten-minute-walk example. Ilyra admits she did not warn Maevra because she expected the outcome."}},
{"beat_id":"C05_B022","speaker_id":"ilyra","text":"I thought it would be funny."},
{"beat_id":"C05_B023","speaker_id":"maevra","text":"It was a little funny."},
{"beat_id":"C05_B024","cues":{"staging":"The subject shifts to food. Cyanis habitually treats eating as something to do after everyone else is accounted for. Ilyra points out that Maevra recognizes the type because she shares the habit."}},
{"beat_id":"C05_B025","speaker_id":"maevra","text":"We're complaining about Dovaren."},
{"beat_id":"C05_B026","speaker_id":"ilyra","text":"Stay focused."},
{"beat_id":"C05_B027","cues":{"staging":"Maevra explains that Cyanis asks questions at inconvenient times—not stupid questions, but the exact question that makes an order need checking again."}},
{"beat_id":"C05_B028","speaker_id":"ilyra","text":"Awful."},
{"beat_id":"C05_B029","cues":{"staging":"Maevra acknowledges that the questions are useful. They are still complaining."}},
{"beat_id":"C05_B030","cues":{"staging":"Ilyra gives her complaint: when she asks whether something hurts, Cyanis answers by telling her how somebody else is doing. She badly imitates his practical deflection by bringing up Torren's harder side of the last fight."}},
{"beat_id":"C05_B031","speaker_id":"maevra","text":"That's irritating."},
{"beat_id":"C05_B032","speaker_id":"ilyra","text":"Thank you."},
{"beat_id":"C05_B033","cues":{"staging":"If pressed again, Cyanis becomes suddenly interested in water, supplies, distance, watches, or numbers."}},
{"beat_id":"C05_B034","speaker_id":"maevra","text":"Have you tried threatening him?"},
{"beat_id":"C05_B035","speaker_id":"ilyra","text":"Medically?"},
{"beat_id":"C05_B036","speaker_id":"maevra","text":"I wasn't going to specify."},
{"beat_id":"C05_B037","cues":{"staging":"They consider a coordinated food order. Cyanis passes the doorway carrying cleaned gear."}},
{"beat_id":"C05_B038","speaker_id":"maevra","text":"Dovaren."},
{"beat_id":"C05_B039","speaker_id":"cyanis","text":"Commander."},
{"beat_id":"C05_B040","speaker_id":"ilyra","text":"Have you eaten?"},
{"beat_id":"C05_B041","speaker_id":"cyanis","text":"Recently."},
{"beat_id":"C05_B042","speaker_id":"ilyra","text":"That is not an answer."},
{"beat_id":"C05_B043","speaker_id":"cyanis","text":"It was intended as one."},
{"beat_id":"C05_B044","speaker_id":"maevra","text":"Eat."},
{"beat_id":"C05_B045","speaker_id":"ilyra","text":"Eat."},
{"beat_id":"C05_B046","speaker_id":"cyanis","text":"Did you coordinate that?"},
{"beat_id":"C05_B047","speaker_id":"maevra","text":"No."},
{"beat_id":"C05_B048","speaker_id":"ilyra","text":"Yes."},
{"beat_id":"C05_B049","speaker_id":"ilyra","text":"Apparently we're still refining the procedure."},
{"beat_id":"C05_B050","speaker_id":"cyanis","text":"Were you talking about me?"},
{"beat_id":"C05_B051","speaker_id":"maevra","text":"Yes."},
{"beat_id":"C05_B052","speaker_id":"ilyra","text":"At length."},
{"beat_id":"C05_B053","speaker_id":"cyanis","text":"Flattering?"},
{"beat_id":"C05_B054","cues":{"staging":"The two women look at him for slightly too long."}},
{"beat_id":"C05_B055","speaker_id":"cyanis","text":"That's hurtful."},
{"beat_id":"C05_B056","speaker_id":"maevra","text":"You ask useful questions."},
{"beat_id":"C05_B057","speaker_id":"ilyra","text":"At terrible times."},
{"beat_id":"C05_B058","speaker_id":"ilyra","text":"You notice when other people need something."},
{"beat_id":"C05_B059","speaker_id":"maevra","text":"And become mysteriously stupid when the other person is you."},
{"beat_id":"C05_B060","speaker_id":"cyanis","text":"This feels like an ambush."},
{"beat_id":"C05_B061","cues":{"staging":"Cyanis notices the report still in Maevra's hand and the medical pouch still open in Ilyra's lap."}},
{"beat_id":"C05_B062","speaker_id":"cyanis","text":"Wonderful conversation. Very educational."},
{"beat_id":"C05_B063","cues":{"staging":"Maevra orders him to put the gear down because he is being difficult on purpose."}},
{"beat_id":"C05_B064","speaker_id":"cyanis","text":"Fair."},
{"beat_id":"C05_B065","cues":{"staging":"Cyanis puts the gear down, starts toward food, then looks back at both women still holding their work."}},
{"beat_id":"C05_B066","speaker_id":"cyanis","text":"Both of you coming?"},
{"beat_id":"C05_B067","cues":{"staging":"The hypocrisy lands. Ilyra closes the pouch. Maevra leaves the report on the table. All three finally stop working."}},
{"beat_id":"C05_B068","speaker_id":"maevra","text":"I hate him."},
{"beat_id":"C05_B069","speaker_id":"ilyra","text":"No, you don't."},
{"beat_id":"C05_B070","speaker_id":"maevra","text":"I know."},
{"beat_id":"C05_B071","speaker_id":"cyanis","text":"I can still hear you."},
{"beat_id":"C05_B072","speaker_id":"maevra","text":"Good."},
{"beat_id":"C05_B073","cues":{"staging":"They leave the work area together. The scene does not turn self-neglect into a gendered management joke; all three were caught doing versions of the same thing."}},
{"beat_id":"C05_B074","speaker_id":"maevra","text":"If food's gone—"},
{"beat_id":"C05_B075","speaker_id":"cyanis","text":"Torren cooked."},
{"beat_id":"C05_B076","speaker_id":"ilyra","text":"There's some left."},
{"beat_id":"C05_B077","speaker_id":"cyanis","text":"Probably."},
{"beat_id":"C05_B078","speaker_id":"ilyra","text":"You've been spending too much time with Torren."},
{"beat_id":"C05_B079","speaker_id":"cyanis","text":"Probably."},
{"beat_id":"C05_B080","speaker_id":"maevra","text":"Oh, hell."}]
