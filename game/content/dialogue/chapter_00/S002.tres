"cues": {"pause_ms": 25, "staging": "The escort sees the movement too; Cyanis is not uniquely perceptive in a magical sense.", "camera": "Hold the shared threat direction.", "movement": "Escort turns toward the survivors.", "interrupt": true, "implementation_flags": ["IN_WORLD_DIALOGUE", "ENEMY_PRESSURE_READ"]}
}, {
"beat_id": "S002_B030",
"speaker_id": "cyanis",
"text": "Back.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 25, "staging": "One-word command; Cyanis steps into the route between the ditch and the survivors.", "camera": "Medium on Cyanis with ditch beyond.", "movement": "Escort moves survivors back behind the wagon line.", "interrupt": true, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
