"advance_mode": "manual",
"cues": {"pause_ms": 260, "staging": "Resume the authored scene only after the controlling Convoy Rift Hound encounter resolves. The field is quieter, not safe; survivors continue moving and hostile pressure remains visible beyond the ridge.", "camera": "Return from combat to a readable Wreck Field wide.", "movement": "Cyanis checks the survivor lane before looking toward the north cut.", "interrupt": false, "implementation_flags": ["RESUME_AFTER_WRECK_FIELD_COMBAT", "CINEMATIC_WORLD_BEAT"]}
}, {
"beat_id": "S002_B035",
"speaker_id": "convoy_superior_officer",
"text": "Dovaren!",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 25, "staging": "The officer calls from a newly visible breach across the wreck line; they remain with the wider convoy command problem.", "camera": "Establish officer and Cyanis across the damaged field.", "movement": "Cyanis turns toward the call.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S002_B036",
"speaker_id": "cyanis",
"text": "Here.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 25, "staging": "Functional answer over distance.", "camera": "Hold geography.", "movement": "Cyanis moves to a position where the north cut and officer are both visible.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S002_B037",
"speaker_id": "convoy_superior_officer",
"text": "North side's pulling back.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 40, "staging": "The officer reports the observable withdrawal without yet issuing S003's decision-driving order.", "camera": "Brief north-cut insert showing retreat movement at distance.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "ENEMY_PRESSURE_READ"]}
}, {
"beat_id": "S002_B038",
"speaker_id": "cyanis",
"text": "I see it.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 35, "staging": "Cyanis watches the route rather than the retreating figures alone.", "camera": "Cyanis sight line to north cut.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S002_B039",
"speaker_id": "convoy_superior_officer",
"text": "Looks like they're breaking.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 45, "staging": "Reasonable field interpretation, not foolishness.", "camera": "Hold officer/Cyanis spatial relationship.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S002_B040",
"speaker_id": "cyanis",
"text": "Look at the cut.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 35, "staging": "He asks the officer to inspect the same evidence rather than declaring himself correct.", "camera": "Shift to the north cut.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "BAIT_PATTERN_EVIDENCE"]}
}, {
"beat_id": "S002_B041",
"speaker_id": "convoy_superior_officer",
"text": "What about it?",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 30, "staging": "The officer asks for the specific read.", "camera": "Hold on route geometry.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S002_B042",
"speaker_id": "cyanis",
"text": "Every other route is blocked. That one isn't.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 50, "staging": "Observable geometry only: collapsed wagons and debris choke alternate lines while the north cut remains unnaturally clean.", "camera": "Compare blocked lanes to the clean north cut in quick readable inserts.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "BAIT_PATTERN_EVIDENCE"]}
}, {
"beat_id": "S002_B043",
"speaker_id": "convoy_superior_officer",
"text": "They cleared it.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 45, "staging": "The officer offers one plausible explanation.", "camera": "Hold.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S002_B044",
"speaker_id": "cyanis",
"text": "Or left it.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 80, "staging": "Cyanis keeps the conclusion provisional.", "camera": "Return to Cyanis, then north cut.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "BAIT_PATTERN_EVIDENCE"]}
}, {
"beat_id": "S002_B045",
"speaker_id": "convoy_superior_officer",
"text": "You think it's bait.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 35, "staging": "The officer names the tactical possibility; no order or refusal occurs here.", "camera": "Two-point field composition.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S002_B046",
"speaker_id": "cyanis",
"text": "I think they want us looking north.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 70, "staging": "He states a hypothesis, not certainty. The camera may briefly include wounded/civilians/cargo behind him to make the divided-attention problem visually legible without resolving it yet.", "camera": "Cyanis foreground with north cut one direction and damaged convoy field another.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "BAIT_PATTERN_EVIDENCE"]}
}, {
"beat_id": "S002_B047",
"speaker_id": "convoy_superior_officer",
"text": "Relay. Bring me that and a field count.",
"left": {},
"right": {},
