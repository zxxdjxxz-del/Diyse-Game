"text": "Hound.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 20, "staging": "Identification, not explanation.", "camera": "Hold defensive line.", "movement": "Cyanis draws the creature away from the survivor route.", "interrupt": true, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
