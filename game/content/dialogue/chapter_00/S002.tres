"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 180, "staging": "The Convoy Rift Hound bursts from the ditch line with its restraint chain trailing. Do not add a new creature form or alter the controlling encounter sheet.", "camera": "Readable threat reveal; avoid horror flourish that obscures its route to Cyanis.", "movement": "Cyanis raises shield; survivors clear the immediate lane.", "interrupt": true, "implementation_flags": ["CINEMATIC_WORLD_BEAT", "CONVOY_RIFT_HOUND_REVEAL"]}
}, {
"beat_id": "S002_B032",
