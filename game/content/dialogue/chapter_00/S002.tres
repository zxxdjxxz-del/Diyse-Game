"speaker_id": "",
"text": "",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 260, "staging": "A dragged chain mark and disturbed ditch grass cut across the survivor route. Cyanis reads the sign as an immediate animal threat, not supernatural information.", "camera": "Ground-level evidence insert, then the ditch line.", "movement": "Nearby survivors continue until Cyanis signals them back.", "interrupt": false, "implementation_flags": ["ENEMY_PRESSURE_READ", "CONVOY_RIFT_HOUND_EVIDENCE"]}
}, {
