"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 110, "staging": "Without breaking eye contact, Ilyra plants both heels and drags the stone forward almost exactly to its original position.", "camera": "Keep action and Cyanis's reaction in frame.", "movement": "Seat returns forward.", "interrupt": false, "implementation_flags": ["PLAYFUL_PHYSICAL_BEAT"]}
}, {
"beat_id": "C01_B014",
"speaker_id": "cyanis",
"text": "You're doing that on purpose.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 30, "staging": "He is aware of the hypocrisy of objecting.", "camera": "Two-shot.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "C01_B015",
"speaker_id": "ilyra",
"text": "Yes.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 90, "staging": "No embellishment.", "camera": "Hold the beat.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "ILYRA_PLAYFUL"]}
}, {
