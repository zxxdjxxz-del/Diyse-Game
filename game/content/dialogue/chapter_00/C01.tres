"speaker_id": "",
"text": "",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 160, "staging": "Cyanis gives up on the stone for the moment. He notices faint steam lifting from Ilyra's damp gloves.", "camera": "Brief glove insert.", "movement": "He crouches near the firewood rather than looming over her.", "interrupt": false, "implementation_flags": ["ORDINARY_CARE_OBSERVATION"]}
}, {
"beat_id": "C01_B017",
"speaker_id": "cyanis",
"text": "How long have those been wet?",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 30, "staging": "Practical question about the gloves, not a health interrogation.", "camera": "Hold.", "movement": "Cyanis indicates the gloves.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "ORDINARY_CARE"]}
}, {
"beat_id": "C01_B018",
"speaker_id": "ilyra",
"text": "Long enough to become unpleasant.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 35, "staging": "She flexes cold fingers once.", "camera": "Keep casual scale.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "C01_B019",
"speaker_id": "cyanis",
"text": "Put them on the drying rack.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 25, "staging": "He points to a simple branch rack set safely beside the fire.", "camera": "Include rack.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "C01_B020",
"speaker_id": "ilyra",
"text": "They won't be dry by morning.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 30, "staging": "Matter-of-fact objection.", "camera": "Hold.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "C01_B021",
"speaker_id": "cyanis",
"text": "They'll be drier than if they're on fire.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 50, "staging": "Practical absurdity stated seriously.", "camera": "Hold.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CYANIS_DRY_HUMOR"]}
}, {
"beat_id": "C01_B022",
"speaker_id": "ilyra",
"text": "You have very strong opinions about fire.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 35, "staging": "Ilyra finally moves the gloves to the rack while making the complaint.", "camera": "Two-shot.", "movement": "Gloves placed on rack.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "ILYRA_PLAYFUL"]}
}, {
"beat_id": "C01_B023",
"speaker_id": "cyanis",
"text": "I've met it.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 70, "staging": "Dry answer. No war-story follow-up; the topic remains mundane.", "camera": "Hold.", "movement": "Cyanis reaches toward the edge of the fire with a stick to reposition one log.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "NO_LORE_EXPANSION"]}
}, {
