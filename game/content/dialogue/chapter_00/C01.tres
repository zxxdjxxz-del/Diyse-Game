"speaker_id": "",
"text": "",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 180, "staging": "A quiet beat. Then Ilyra's attention shifts past Cyanis to one of his gloves, which he left much too close to the fire while arranging wood.", "camera": "Reveal the glove edge beginning to smoke.", "movement": "Ilyra straightens slightly.", "interrupt": false, "implementation_flags": ["COMEDIC_REVERSAL_SETUP"]}
}, {
"beat_id": "C01_B032",
"speaker_id": "ilyra",
"text": "Your glove is smoking.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 15, "staging": "Perfectly calm medical-style observation.", "camera": "Quick readable insert on glove.", "movement": "Ilyra points with one finger.", "interrupt": true, "implementation_flags": ["IN_WORLD_DIALOGUE", "ORDINARY_RECIPROCAL_CARE"]}
}, {
"beat_id": "C01_B033",
"speaker_id": "cyanis",
"text": "What?",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 10, "staging": "Cyanis turns, sees it, and immediately snatches the glove away from the heat.", "camera": "Keep action readable rather than exaggerated.", "movement": "He smothers the tiny ember against the dirt.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "COMEDIC_REVERSAL"]}
}, {
"beat_id": "C01_B034",
"speaker_id": "ilyra",
"text": "You were saying?",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 40, "staging": "No smile is required; a tiny one is permitted.", "camera": "Two-shot with damaged glove visible.", "movement": "Ilyra settles back with the warming stone.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "ILYRA_PLAYFUL"]}
}, {
"beat_id": "C01_B035",
"speaker_id": "cyanis",
"text": "This proves nothing.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 35, "staging": "Cyanis examines the singed glove with wounded dignity.", "camera": "Hold.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CYANIS_PLAYFUL"]}
}, {
"beat_id": "C01_B036",
"speaker_id": "ilyra",
"text": "It proves something.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 55, "staging": "She does not explain further.", "camera": "Hold.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "C01_B037",
"speaker_id": "cyanis",
"text": "I preferred you when you were busy.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 40, "staging": "Obviously false complaint; he is relaxed enough to tease.", "camera": "Shared fire composition.", "movement": "He puts the glove on the drying rack beside hers.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CYANIS_RELAXED_PLAYFULNESS"]}
}, {
"beat_id": "C01_B038",
"speaker_id": "ilyra",
"text": "No, you didn't.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 55, "staging": "Confident, lightly amused answer based only on the evening they have just shared.", "camera": "Hold.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "EARLY_QUIET_FAMILIARITY"]}
}, {
