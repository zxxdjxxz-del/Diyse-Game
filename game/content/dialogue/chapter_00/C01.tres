"text": "No.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 130, "staging": "Simple admission. Do not romanticize it; it is early ease after a terrible day.", "camera": "Medium-wide campfire composition.", "movement": "Cyanis settles back on his own stone.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "EARLY_QUIET_FAMILIARITY"]}
}, {
