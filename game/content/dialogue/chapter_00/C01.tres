"cues": {"pause_ms": 220, "staging": "Late evening after S006. A small practical campfire burns inside the safe edge of the Field Triage Camp. Most work has quieted. Ilyra sits on a low stone close to the fire with her damp gloves laid across her knees.", "camera": "Medium-wide two-person camp composition; no cinematic romance framing.", "movement": "Cyanis enters carrying a small bundle of split wood and notices Ilyra's distance from the flames.", "interrupt": false, "implementation_flags": ["C01_CHARACTER_LIFE_BEGIN", "OPTIONAL_SKIPPABLE_SCENE", "NO_ESSENTIAL_PLOT_DELIVERY"]}
}, {
"beat_id": "C01_B002",
"speaker_id": "cyanis",
"text": "You're too close to the fire.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 35, "staging": "Cyanis states this like a practical observation rather than an opening gambit.", "camera": "Keep both and fire visible.", "movement": "He sets the wood down.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "EARLY_PLAYFUL_IRRITATION"]}
}, {
"beat_id": "C01_B003",
"speaker_id": "ilyra",
"text": "I'm cold.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 30, "staging": "Plain answer. She does not move.", "camera": "Hold.", "movement": "Ilyra turns one glove over on her knee.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "C01_B004",
"speaker_id": "cyanis",
"text": "Those can both be true.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 55, "staging": "Dry correction without escalating.", "camera": "Hold.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CYANIS_DRY_HUMOR"]}
}, {
"beat_id": "C01_B005",
"speaker_id": "",
"text": "",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 150, "staging": "Ilyra deliberately ignores him and extends her hands toward the heat.", "camera": "Small hand/fire insert, then back to two-shot.", "movement": "Cyanis looks from her hands to the low stone she is sitting on.", "interrupt": false, "implementation_flags": ["SILENT_REACTION_BEAT"]}
}, {
"beat_id": "C01_B006",
"speaker_id": "",
"text": "",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 100, "staging": "With the side of his boot, Cyanis nudges the low sitting stone a few inches farther from the fire while Ilyra is still seated on it.", "camera": "Keep the movement readable and small, not slapstick.", "movement": "Stone shifts back several inches.", "interrupt": false, "implementation_flags": ["ORDINARY_CARE_ACTION", "PLAYFUL_PHYSICAL_BEAT"]}
}, {
"beat_id": "C01_B007",
"speaker_id": "ilyra",
"text": "Did you just move my seat?",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 35, "staging": "Ilyra looks down at the stone, then up at him.", "camera": "Two-shot.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "EARLY_PLAYFUL_IRRITATION"]}
}, {
"beat_id": "C01_B008",
"speaker_id": "cyanis",
"text": "No.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 30, "staging": "Completely unconvincing.", "camera": "Do not cut dramatically.", "movement": "Cyanis begins arranging the new wood beside the fire.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CYANIS_PLAYFUL"]}
}, {
"beat_id": "C01_B009",
"speaker_id": "ilyra",
"text": "Cyanis.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 30, "staging": "First-name correction; mildly irritated, not intimate emphasis.", "camera": "Hold.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "C01_B010",
"speaker_id": "cyanis",
"text": "The ground shifted.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 45, "staging": "Cyanis continues the obviously false explanation while checking the firewood.", "camera": "Hold.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CYANIS_PLAYFUL"]}
}, {
"beat_id": "C01_B011",
"speaker_id": "ilyra",
"text": "Under your boot.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 35, "staging": "Immediate factual correction.", "camera": "Hold.", "movement": "Ilyra glances pointedly at his boot.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "ILYRA_DRY_HUMOR"]}
}, {
"beat_id": "C01_B012",
"speaker_id": "cyanis",
"text": "Very localized ground.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 65, "staging": "He commits to the joke exactly one beat too long.", "camera": "Hold.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CYANIS_PLAYFUL"]}
}, {
