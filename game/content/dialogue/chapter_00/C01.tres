"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 130, "staging": "Cyanis takes a small cloth-wrapped warming stone from the outer edge of the fire and tests it against his palm before offering it to Ilyra.", "camera": "Hands and object visible, still practical.", "movement": "He holds the wrapped stone out.", "interrupt": false, "implementation_flags": ["ORDINARY_CARE_ACTION"]}
}, {
"beat_id": "C01_B025",
"speaker_id": "cyanis",
"text": "Here.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 25, "staging": "No speech about caring; the action carries it.", "camera": "Hold.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "ORDINARY_CARE"]}
}, {
"beat_id": "C01_B026",
"speaker_id": "ilyra",
"text": "If this burns me, I will be difficult about it.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 35, "staging": "She accepts the stone despite the warning.", "camera": "Hold.", "movement": "Ilyra takes the wrapped stone in both hands.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "ILYRA_DRY_HUMOR"]}
}, {
"beat_id": "C01_B027",
"speaker_id": "cyanis",
"text": "You've been difficult without the burn.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 45, "staging": "The teasing is light and earned by the seat argument, not romantic escalation.", "camera": "Two-shot.", "movement": "Cyanis sits on another stone at a safer distance.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CYANIS_PLAYFUL"]}
}, {
"beat_id": "C01_B028",
"speaker_id": "ilyra",
"text": "You moved my chair while I was sitting in it.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 35, "staging": "She refuses his framing on factual grounds.", "camera": "Hold.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "C01_B029",
"speaker_id": "cyanis",
"text": "Stone.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 25, "staging": "Unhelpful correction.", "camera": "Hold.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "C01_B030",
"speaker_id": "ilyra",
"text": "That is the part you object to?",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 70, "staging": "Ilyra looks at him over the warming stone.", "camera": "Hold long enough for the exchange to land.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "EARLY_PLAYFUL_IRRITATION"]}
}, {
