"cues": {"pause_ms": 260, "staging": "They sit quietly for a short time. Ilyra keeps the warming stone. Both gloves now dry at the safe rack distance. Nothing important is discussed and no new story fact is revealed.", "camera": "Wide optional-scene closing shot; camp continues quietly in background.", "movement": "No dramatic gesture. End on ordinary shared stillness.", "interrupt": false, "implementation_flags": ["C01_CHARACTER_LIFE_END", "ORDINARY_CARE", "NO_ESSENTIAL_PLOT_DELIVERY", "NO_ROMANCE_PROGRESSION", "NO_CARD_OR_PRIME_INFORMATION", "HANDOFF_C02_REMAINS_AVAILABLE"]}
