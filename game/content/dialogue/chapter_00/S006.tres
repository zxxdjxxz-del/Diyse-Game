"advance_mode": "manual",
"cues": {"pause_ms": 25, "staging": "Cyanis accepts the legitimate boundary immediately.", "camera": "Hold.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
