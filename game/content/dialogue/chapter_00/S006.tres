"cues": {"pause_ms": 90, "staging": "The officer looks toward the sealed recovery wagon. The damaged Card is inert again.", "camera": "Insert on closed casing only; no glow, title, Face icon, or Prime terminology.", "movement": "None.", "interrupt": false, "implementation_flags": ["DAMAGED_CARD_INERT", "CARD_REMAINS_UNIDENTIFIED"]}
}, {
