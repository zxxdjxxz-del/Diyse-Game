"cues": {"pause_ms": 280, "staging": "Continue after S005. The east pressure is gone. The camp remains crowded, damaged, and active. The unexplained green-and-gold geometry has faded. No victory pose or celebration.", "camera": "Wide aftermath geography: treatment lane, recovery wagon, defenders, south wreck route.", "movement": "Cyanis is seated where Ilyra put him; Ilyra is still working between patients.", "interrupt": false, "implementation_flags": ["S006_AFTERMATH_BEGIN", "NO_VICTORY_CELEBRATION", "INCOMPLETE_RESPONSE_ENDED"]}
}, {
"beat_id": "S006_B002",
"speaker_id": "convoy_superior_officer",
"text": "Dovaren. Amarin. Field count.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 30, "staging": "The officer returns to ordinary command work immediately after the confrontation.", "camera": "Three-shot with camp activity behind them.", "movement": "Officer checks a damaged field ledger.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AFTERMATH_FIELD_COUNT"]}
}, {
"beat_id": "S006_B003",
"speaker_id": "cyanis",
"text": "East cut is clear. No one followed the retreat.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 30, "staging": "Cyanis reports security state and preserves the no-pursuit decision.", "camera": "Brief look toward the quiet east cut.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "NO_PURSUIT_FINALIZED"]}
}, {
"beat_id": "S006_B004",
"speaker_id": "ilyra",
"text": "Triage is stable. Walking wounded can move. Two patients can't.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 35, "staging": "Ilyra gives a medical status, not reassurance.", "camera": "Keep the two immobile patients visible in background.", "movement": "She finishes securing a bandage while speaking.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "ILYRA_MEDICAL_JURISDICTION", "TRIAGE_POST_BATTLE_STABLE"]}
}, {
"beat_id": "S006_B005",
"speaker_id": "convoy_superior_officer",
"text": "Missing?",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 25, "staging": "The unresolved consequence becomes the next operational problem.", "camera": "Hold.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S006_B006",
"speaker_id": "wounded_convoy_escort",
"text": "Rear wagon roll is short. Some ran south when the first blast hit.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 40, "staging": "A wounded escort reports incomplete survivor accounting without inventing a false exact number.", "camera": "Show south wreck route beyond camp.", "movement": "Escort indicates the rear-wagon direction.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SURVIVORS_STILL_MISSING"]}
}, {
"beat_id": "S006_B007",
"speaker_id": "cyanis",
"text": "How many?",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 25, "staging": "Cyanis asks for precision rather than assuming.", "camera": "Hold.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S006_B008",
"speaker_id": "wounded_convoy_escort",
"text": "Don't know. We lost the roster sheet with the wagon.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 45, "staging": "Uncertainty remains legitimate; the scene does not manufacture a clean count.", "camera": "Damaged rear-wagon remains visible beyond camp.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SURVIVOR_COUNT_UNCERTAIN"]}
}, {
"beat_id": "S006_B009",
"speaker_id": "ilyra",
"text": "Then we search by people, not numbers.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 55, "staging": "Ilyra rejects bookkeeping uncertainty as a reason to stop recovery; practical, not sentimental.", "camera": "Return to Ilyra and officer.", "movement": "Ilyra closes her medical bag enough to move.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "ILYRA_SURVIVOR_RECOVERY_COMMITMENT"]}
}, {
"beat_id": "S006_B010",
"speaker_id": "cyanis",
"text": "South ditch and wagon line first.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 30, "staging": "Cyanis turns the missing-person problem into a bounded search plan.", "camera": "Indicate the two search zones.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SURVIVOR_SEARCH_ROUTE_SET"]}
}, {
"beat_id": "S006_B011",
"speaker_id": "convoy_superior_officer",
"text": "Brackenwall can send a fresh detail at first light.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 35, "staging": "The officer proposes a reasonable lower-risk alternative rather than caricatured indifference.", "camera": "Hold on tired defenders and remaining wounded.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "OFFICER_CREDIBLE_RESOURCE_CONSTRAINT"]}
}, {
"beat_id": "S006_B012",
"speaker_id": "cyanis",
"text": "If someone's pinned, first light is late.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 35, "staging": "Concrete survival timing, not a moral speech.", "camera": "Hold.", "movement": "Cyanis starts to rise, then waits for Ilyra's reaction.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CYANIS_SURVIVOR_RECOVERY_COMMITMENT"]}
}, {
"beat_id": "S006_B013",
"speaker_id": "ilyra",
"text": "If someone's bleeding, it's later.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 60, "staging": "Ilyra supports the same conclusion from her own jurisdiction.", "camera": "Three-shot; agreement comes from different expertise.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "MUTUAL_JURISDICTION_CONTINUES"]}
}, {
