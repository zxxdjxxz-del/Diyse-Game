"speaker_id": "",
"text": "",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 120, "staging": "The officer weighs the remaining manpower, darkening light, and the two specialists' argument.", "camera": "Brief field geography rather than reaction close-up.", "movement": "None.", "interrupt": false, "implementation_flags": ["CINEMATIC_WORLD_BEAT"]}
}, {
"beat_id": "S006_B015",
"speaker_id": "convoy_superior_officer",
"text": "One sweep. No chase beyond the wreck markers.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 35, "staging": "Formal bounded authority authorizes recovery while preserving the no-pursuit rule.", "camera": "Show wreck markers as hard search boundary.", "movement": "Officer closes the field ledger.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "SURVIVOR_SWEEP_AUTHORIZED", "NO_PURSUIT_FINALIZED"]}
}, {
"beat_id": "S006_B016",
"speaker_id": "cyanis",
"text": "Understood.",
"left": {},
"right": {},
