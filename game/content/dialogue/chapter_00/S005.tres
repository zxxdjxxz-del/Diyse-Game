"cues": {"pause_ms": 120, "staging": "Hard handoff into the controlling final Broken Convoy encounter. Dialogue must not alter statistics, action sheets, target legality, victory conditions, rewards, or the temporary protective-response mechanics.", "camera": "Transition to combat presentation.", "movement": "Lock narrative staging and initialize encounter state.", "interrupt": false, "implementation_flags": ["COMBAT_HANDOFF", "ENCOUNTER_CH00_CONVOY_WAR_SORCERER", "PARTY_CYANIS_ILYRA", "WAR_SORCERER_START_HP_70_PERCENT", "INJURED_SOLDIER_START_HP_50_PERCENT", "RIFT_LANCE_PREPARATION_NOT_BEFORE_ROUND_2", "PROTECTIVE_RESPONSE_THREE_ROUNDS", "PROTECTIVE_RESPONSE_PLUS_20_TOTAL_DEFENSE", "PROTECTIVE_RESPONSE_FIRST_ELIGIBLE_DIRECT_HIT_MINUS_20_PERCENT_PER_PARTY_MEMBER", "PROTECTIVE_RESPONSE_NOT_CARD_USE"]}
