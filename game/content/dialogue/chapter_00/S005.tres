"cues": {"pause_ms": 160, "staging": "The fractured green-and-gold geometry loses coherence after the confrontation. It fades rather than becoming a complete manifestation. No identity is revealed.", "camera": "Brief environmental insert on cracked protection lines fading from stone and wagon supports.", "movement": "Camp remains intact but damaged.", "interrupt": false, "implementation_flags": ["INCOMPLETE_RESPONSE_FADES", "NO_COMPLETE_MANIFESTATION", "NO_IDENTITY_REVEAL"]}
}, {
