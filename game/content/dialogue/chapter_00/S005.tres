"cues": {"pause_ms": 220, "staging": "Continue directly from S004. The fractured green-and-gold protection remains visible along the defended camp edge. The Convoy War-Sorcerer advances through the east cut with an injured Iron Cohort Soldier supporting him.", "camera": "Wide geography showing camp behind Cyanis/Ilyra and both incoming hostiles ahead.", "movement": "Cyanis and Ilyra take the forward edge without leaving the defended treatment perimeter.", "interrupt": false, "implementation_flags": ["S005_CONFRONTATION_BEGIN", "INCOMPLETE_PROTECTIVE_RESPONSE_ACTIVE", "ENCOUNTER_CH00_FINAL_VISIBLE"]}
}, {
"beat_id": "S005_B002",
"speaker_id": "convoy_superior_officer",
"text": "They're through the east cut.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 25, "staging": "The officer reports the immediate breach without taking over Cyanis and Ilyra's local coordination.", "camera": "Keep enemies visible beyond him.", "movement": "Officer moves back toward the inner defensive line after reporting.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S005_B003",
"speaker_id": "cyanis",
"text": "Keep everyone behind stone. Nobody follows us out.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 35, "staging": "Cyanis protects the camp from turning the confrontation into another pursuit.", "camera": "Show wounded/civilians remaining behind cover.", "movement": "Escorts tighten the inner line instead of advancing.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "NO_PURSUIT_REAFFIRMED"]}
}, {
"beat_id": "S005_B004",
"speaker_id": "ilyra",
"text": "I need the lane behind me clear.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 25, "staging": "Ilyra states the medical requirement created by joining the defense.", "camera": "Show treatment lane behind her.", "movement": "She shifts her stance so she can still see the nearest critical patient.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "ILYRA_MEDICAL_JURISDICTION"]}
}, {
"beat_id": "S005_B005",
"speaker_id": "cyanis",
"text": "You'll have it.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 40, "staging": "Immediate acknowledgment of her requirement.", "camera": "Two-shot, functional rather than intimate.", "movement": "Cyanis shifts half a pace left to preserve the lane.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "MUTUAL_JURISDICTION_CONTINUES"]}
}, {
"beat_id": "S005_B006",
"speaker_id": "ilyra",
"text": "You said you could hold the front.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 25, "staging": "Ilyra checks the division of labor, not his courage.", "camera": "Hold both facing forward.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S005_B007",
"speaker_id": "cyanis",
"text": "I did.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 20, "staging": "Plain answer.", "camera": "Hold.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S005_B008",
"speaker_id": "ilyra",
"text": "Good. Hold the left half.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 35, "staging": "She claims the other half of the defensive problem for herself rather than becoming support behind him.", "camera": "Split composition along the approach.", "movement": "Ilyra takes the right half with staff ready.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "ILYRA_INDEPENDENT_COMBAT_AUTHORITY"]}
}, {
"beat_id": "S005_B009",
"speaker_id": "cyanis",
"text": "Generous.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 25, "staging": "Brief dry humor under pressure; no romantic beat.", "camera": "Do not cut to reaction close-up; keep threat visible.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CYANIS_DRY_HUMOR"]}
}, {
"beat_id": "S005_B010",
"speaker_id": "ilyra",
"text": "I need the other half.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 45, "staging": "Dry practical answer; this is coordination, not flirtation.", "camera": "Hold the shared line.", "movement": "Ilyra settles into position.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "ILYRA_DRY_HUMOR"]}
}, {
"beat_id": "S005_B011",
"speaker_id": "convoy_superior_officer",
"text": "Sorcerer's taking position.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 15, "staging": "Threat report only. Do not depict Rift Lance Preparation before Round 2.", "camera": "War-Sorcerer reaches encounter start position; no preparation VFX yet.", "movement": "Injured Soldier takes the supporting approach at reduced readiness.", "interrupt": true, "implementation_flags": ["IN_WORLD_DIALOGUE", "RIFT_LANCE_PREPARATION_NOT_BEFORE_ROUND_2"]}
}, {
"beat_id": "S005_B012",
"speaker_id": "cyanis",
"text": "Sorcerer's the threat. Don't let the soldier pull us off the line.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 30, "staging": "Cyanis identifies the encounter's central threat without hard-locking player target selection.", "camera": "Show both enemies and defended line in the same geography.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "NO_TARGET_LOCK_FROM_DIALOGUE"]}
}, {
"beat_id": "S005_B013",
"speaker_id": "ilyra",
"text": "If that light changes around you, say it.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 25, "staging": "Ilyra monitors the unexplained condition without naming or understanding it.", "camera": "Subtle fractured geometry remains visible around the line.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "INCOMPLETE_RESPONSE_REMAINS_UNIDENTIFIED"]}
}, {
"beat_id": "S005_B014",
"speaker_id": "cyanis",
"text": "You'll know.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 25, "staging": "Cyanis still defaults toward functional reporting rather than self-monitoring.", "camera": "Hold.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CYANIS_SELF_NEGLECT_EARLY"]}
}, {
"beat_id": "S005_B015",
"speaker_id": "ilyra",
"text": "I would prefer to know before you fall over.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 35, "staging": "Clinical correction with dry edge; she does not stop the imminent battle to therapize him.", "camera": "Keep both facing threat.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "ILYRA_CHALLENGES_MINIMIZATION"]}
}, {
"beat_id": "S005_B016",
"speaker_id": "cyanis",
"text": "I'll say it.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 65, "staging": "He accepts the correction and gives the concrete acknowledgment she asked for.", "camera": "Threat closes; dialogue ends.", "movement": "Cyanis raises shield; Ilyra brings staff into combat stance.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
