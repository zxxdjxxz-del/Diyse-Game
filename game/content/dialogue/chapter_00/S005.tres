"cues": {"pause_ms": 30, "staging": "Cyanis asks within Ilyra's medical jurisdiction rather than assuming what help means.", "camera": "Return to the work space they established in S004.", "movement": "None.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "MUTUAL_JURISDICTION_CONTINUES"]}
}, {
