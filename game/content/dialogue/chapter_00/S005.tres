"cues": {"pause_ms": 25, "staging": "Ilyra returns immediately to the unresolved medical consequence rather than celebrating.", "camera": "Functional two-shot; camp activity continues behind them.", "movement": "She visually checks Cyanis without touching him yet.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "ILYRA_MEDICAL_FOLLOWUP"]}
}, {
