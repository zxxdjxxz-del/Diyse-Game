"cues": {"pause_ms": 45, "staging": "Dry medical practicality; she has not decided he is fine.", "camera": "She turns her attention toward the treatment lane while keeping him in peripheral view.", "movement": "Ilyra starts back toward patients.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "ILYRA_DRY_HUMOR"]}
