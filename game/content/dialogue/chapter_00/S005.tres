"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 20, "staging": "His first post-battle question is the camp condition.", "camera": "Shift focus back to triage activity.", "movement": "Cyanis follows at a slower pace.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S005_B026",
