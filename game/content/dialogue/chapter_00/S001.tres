"cues": {"pause_ms": 700, "staging": "Cyanis slows. His attention fixes on the road ahead; the ordinary return traffic expected on the route is absent.", "camera": "Shift from Cyanis to the empty bend ahead, then back.", "movement": "Cyanis stops; nearby escorts notice and slow.", "interrupt": false, "implementation_flags": ["CINEMATIC_WORLD_BEAT"]}
}, {
