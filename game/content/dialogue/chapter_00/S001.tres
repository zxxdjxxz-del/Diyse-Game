"cues": {"pause_ms": 900, "staging": "Convoy advances along the Westways road. The sealed recovery wagon remains protected near the center while civilian travelers share the route under escort.", "camera": "Wide establishing view; settle toward Cyanis working the east side of the column.", "movement": "Convoy and travelers continue at walking pace.", "interrupt": false, "implementation_flags": ["CINEMATIC_WORLD_BEAT"]}
}, {
"beat_id": "S001_B002",
"speaker_id": "convoy_superior_officer",
"text": "Dovaren. East side. Keep the travelers clear of the recovery wagon.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 80, "staging": "The officer approaches without stopping the column.", "camera": "Medium two-shot in world.", "movement": "Cyanis continues checking spacing along the road shoulder.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S001_B003",
"speaker_id": "cyanis",
"text": "Already moved them to the low shoulder. More room for the wagon, less chance somebody loses a foot.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 80, "staging": "Cyanis indicates the safer walking line without making a ceremony of it.", "camera": "Hold medium.", "movement": "Travelers continue along the adjusted line.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S001_B004",
"speaker_id": "convoy_superior_officer",
"text": "I hadn't finished.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 120, "staging": "The officer gives Cyanis a brief look.", "camera": "Officer reaction insert if available.", "movement": "Continue walking.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S001_B005",
"speaker_id": "cyanis",
"text": "Then I apologize for the efficiency.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 80, "staging": "Cyanis keeps his attention on the road rather than playing the line outward.", "camera": "Return to two-shot.", "movement": "Continue walking.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S001_B006",
"speaker_id": "convoy_superior_officer",
"text": "You don't.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 100, "staging": "Dry, familiar professional irritation rather than real anger.", "camera": "Hold.", "movement": "Continue walking.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S001_B007",
"speaker_id": "cyanis",
"text": "No.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 220, "staging": "A small acknowledgment; the exchange ends without another joke.", "camera": "Ease back toward convoy movement.", "movement": "Cyanis checks the recovery wagon as he passes.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S001_B008",
"speaker_id": "convoy_superior_officer",
"text": "Recovery team says the casing shifted again.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 80, "staging": "The officer lowers their voice slightly as the sealed case passes in view.", "camera": "Brief composition including the sealed recovery wagon; do not glamorize the case as chosen-one imagery.", "movement": "Convoy continues.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S001_B009",
"speaker_id": "cyanis",
"text": "Seal?",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 40, "staging": "Immediate practical question.", "camera": "Cyanis glance toward the case.", "movement": "Continue walking.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S001_B010",
"speaker_id": "convoy_superior_officer",
"text": "Holding.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 60, "staging": "No exposition beyond the answer Cyanis needs.", "camera": "Hold.", "movement": "Continue walking.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S001_B011",
"speaker_id": "cyanis",
"text": "Then it can keep being mysterious until Caelora.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 100, "staging": "Cyanis treats the object as protected cargo, not as a personal calling.", "camera": "Case falls out of frame as Cyanis looks back to the road.", "movement": "Continue walking.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S001_B012",
"speaker_id": "convoy_superior_officer",
"text": "That's the idea.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 260, "staging": "Conversation appears finished.", "camera": "Begin widening with the column.", "movement": "Officer starts to move back toward the center of the convoy.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
