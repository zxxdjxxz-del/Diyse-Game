"text": "",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 420, "staging": "Black Host war-sorcery strikes the road between Cyanis and the convoy center. Debris and a damaged wagon break the direct path, separating his side from the main formation without involving any Card response.", "camera": "Show the separation in one readable wide shot before cutting back to Cyanis.", "movement": "Cyanis is forced toward the east shoulder with nearby civilians; the main convoy is cut off beyond the obstruction.", "interrupt": true, "implementation_flags": ["CINEMATIC_WORLD_BEAT", "SEPARATE_CYANIS_FROM_MAIN_CONVOY"]}
}, {
"beat_id": "S001_B023",
"speaker_id": "convoy_superior_officer",
"text": "Dovaren! East side! Get them behind cover!",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 30, "staging": "The officer shouts across the obstruction; this remains a protection order, not the later pursuit order.", "camera": "Longer lens across the broken road, then cut to Cyanis.", "movement": "Officer remains with the main convoy.", "interrupt": true, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S001_B024",
