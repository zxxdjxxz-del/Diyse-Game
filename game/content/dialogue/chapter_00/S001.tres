"advance_mode": "manual",
"cues": {"pause_ms": 300, "staging": "The halt has barely settled when the ambush begins. A projectile slams into a wagon rail from the ridge line; hidden Black Host positions open fire.", "camera": "Snap from the impact toward the concealed attack line; keep geography readable.", "movement": "Travelers duck and escorts move to shields/cover.", "interrupt": true, "implementation_flags": ["CINEMATIC_WORLD_BEAT", "AMBUSH_BEGINS"]}
}, {
"beat_id": "S001_B021",
"speaker_id": "convoy_superior_officer",
"text": "Black Host! Shields! Protect the recovery wagon!",
"left": {},
"right": {},
"active_side": "none",
