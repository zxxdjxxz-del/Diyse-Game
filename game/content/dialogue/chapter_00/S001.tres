"advance_mode": "manual",
"cues": {"pause_ms": 40, "staging": "His tone changes cleanly from conversational to command-ready.", "camera": "Medium on Cyanis, attention still forward.", "movement": "Nearby movement begins to stop.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S001_B015",
"speaker_id": "convoy_superior_officer",
"text": "What do you see?",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 50, "staging": "The officer takes the warning seriously and asks for the observation, not a speech.", "camera": "Two-shot with road beyond them.", "movement": "Convoy continues slowing.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S001_B016",
"speaker_id": "cyanis",
"text": "No carts. No riders. Nobody coming back around that bend.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 80, "staging": "Cyanis lists only observable field facts.", "camera": "Cut briefly to the empty road as each absence registers.", "movement": "Column nearly stopped.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S001_B017",
"speaker_id": "convoy_superior_officer",
"text": "Could be nothing.",
