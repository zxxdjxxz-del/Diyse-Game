"cues": {"pause_ms": 70, "staging": "Not dismissive; a professional possibility check.", "camera": "Officer checks the same ground.", "movement": "Column held at near-stop.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S001_B018",
"speaker_id": "cyanis",
"text": "Could be. Hold anyway.",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 80, "staging": "Cyanis does not pretend certainty he does not have.", "camera": "Close enough to read the shift in his focus, not a heroic pose.", "movement": "Cyanis moves one step toward the roadward side of the civilians.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
"beat_id": "S001_B019",
"speaker_id": "convoy_superior_officer",
"text": "Column, halt!",
"left": {},
"right": {},
"active_side": "none",
"advance_mode": "manual",
"cues": {"pause_ms": 180, "staging": "The ranking officer gives the formal order; Cyanis does not usurp command.", "camera": "Widen as the order travels down the convoy.", "movement": "Convoy stops.", "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"]}
}, {
