{"beat_id":"HUNT_04_CROWN_PROTOTYPE_B007","speaker_id":"vaelira","text":"Yes.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"5. BEFORE THE ARENA","staging":"Vaelira checks another reading."}},
{"beat_id":"HUNT_04_CROWN_PROTOTYPE_B008","speaker_id":"nimera","text":"Is it supposed to?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"5. BEFORE THE ARENA"}},
{"beat_id":"HUNT_04_CROWN_PROTOTYPE_B009","speaker_id":"vaelira","text":"No.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"5. BEFORE THE ARENA"}},
{"beat_id":"HUNT_04_CROWN_PROTOTYPE_B010","speaker_id":"vaelira","text":"Which I would like everyone to appreciate is a different answer from “I don't know.”","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"5. BEFORE THE ARENA","staging":"Beat."}},
{"beat_id":"HUNT_04_CROWN_PROTOTYPE_B011","speaker_id":"nimera","text":"Growth.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"5. BEFORE THE ARENA","staging":"Nimera nods."}},
{"beat_id":"HUNT_04_CROWN_PROTOTYPE_B012","speaker_id":"vaelira","text":"Don't.","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"5. BEFORE THE ARENA","staging":"Vaelira looks at her."}},
{"beat_id":"HUNT_04_CROWN_PROTOTYPE_B013","speaker_id":"cyanis","text":"Can we shut it off from here?","left":{},"right":{},"active_side":"none","advance_mode":"manual","cues":{"implementation_flags":["IN_WORLD_DIALOGUE"],"source_section":"5. BEFORE THE ARENA","staging":"Cyanis looks through the glass."}},
