{"beat_id": "S018_B127", "speaker_id": "maevra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B020 — Neither side is stupid", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B128", "speaker_id": "cyanis", "text": "We found two pages issued separately and combined afterward.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B021 — Prove it", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B129", "speaker_id": "ivory_adjudicator", "text": "Prove it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B021 — Prove it", "source_speaker_label": "IVORY ADJUDICATOR"}},
{"beat_id": "S018_B130", "speaker_id": "ivory_adjudicator", "text": "This proves sequence discrepancy.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B021 — Prove it", "source_speaker_label": "IVORY ADJUDICATOR", "staging": "Cyanis gives him the copies. The Adjudicator reads."}},
{"beat_id": "S018_B131", "speaker_id": "maevra", "text": "I know it is contradictory.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B021 — Prove it", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B132", "speaker_id": "ivory_adjudicator", "text": "Belief is not the standard.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B021 — Prove it", "source_speaker_label": "IVORY ADJUDICATOR"}},
{"beat_id": "S018_B133", "speaker_id": "ilyra", "text": "Neither is pretending.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B021 — Prove it", "source_speaker_label": "ILYRA", "staging_after": "The room stills."}},
{"beat_id": "S018_B134", "speaker_id": "ivory_adjudicator", "text": "I believe you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B022 — Why he cannot simply stand down", "source_speaker_label": "IVORY ADJUDICATOR"}},
{"beat_id": "S018_B135", "speaker_id": "ilyra", "text": "Then stop the seizure.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B022 — Why he cannot simply stand down", "source_speaker_label": "ILYRA"}},
{"beat_id": "S018_B136", "speaker_id": "ivory_adjudicator", "text": "I can't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B022 — Why he cannot simply stand down", "source_speaker_label": "IVORY ADJUDICATOR"}},
{"beat_id": "S018_B137", "speaker_id": "ilyra", "text": "Why?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B022 — Why he cannot simply stand down", "source_speaker_label": "ILYRA"}},
{"beat_id": "S018_B138", "speaker_id": "ivory_adjudicator", "text": "Because belief is not a legal finding.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B022 — Why he cannot simply stand down", "source_speaker_label": "IVORY ADJUDICATOR"}},
{"beat_id": "S018_B139", "speaker_id": "ivory_adjudicator", "text": "If I ignore an authenticated seizure order because the subject tells me it is false, I destroy the same process you're asking me to protect.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B023 — Procedure protects procedure", "source_speaker_label": "IVORY ADJUDICATOR"}},
{"beat_id": "S018_B140", "speaker_id": "maevra", "text": "Agreed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B023 — Procedure protects procedure", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B141", "speaker_id": "cyanis", "text": "That's not helping us.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B023 — Procedure protects procedure", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B142", "speaker_id": "maevra", "text": "It isn't supposed to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B023 — Procedure protects procedure", "source_speaker_label": "MAEVRA"}},
