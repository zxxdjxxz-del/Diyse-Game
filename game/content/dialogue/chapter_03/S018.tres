{"beat_id": "S018_B161", "speaker_id": "torren", "text": "Week's young.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF"], "source_section": "S018_B026 — Second confrontation", "source_speaker_label": "TORREN", "staging_after": "**AUTHORED ENCOUNTER #2 — IVORY ADJUDICATOR. Expose the Order Ledger / Declaration Seal contradiction; do not delete player command categories.**"}},
{"beat_id": "S018_B162", "speaker_id": "ivory_adjudicator", "text": "Hold.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B027 — Evidence exposed", "source_speaker_label": "IVORY ADJUDICATOR", "staging": "At the authored contradiction threshold, the Ledger's sealed declaration section opens and pages separate. The Adjudicator stops immediately.", "staging_after": "Combat ends. Everyone lowers weapons."}},
