{"beat_id": "S018_B184", "speaker_id": "torren", "text": "Suppressed means closed?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B032 — Suppressed does not mean dead", "source_speaker_label": "TORREN"}},
{"beat_id": "S018_B185", "speaker_id": "ivory_adjudicator", "text": "Removed from ordinary record circulation.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B032 — Suppressed does not mean dead", "source_speaker_label": "IVORY ADJUDICATOR"}},
{"beat_id": "S018_B186", "speaker_id": "cyanis", "text": "But apparently still good enough to issue orders.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B032 — Suppressed does not mean dead", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B187", "speaker_id": "ivory_adjudicator", "text": "Apparently.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B032 — Suppressed does not mean dead", "source_speaker_label": "IVORY ADJUDICATOR"}},
{"beat_id": "S018_B188", "speaker_id": "maevra", "text": "I need the complete ledger, copies of every affected order, issuance sequence, witness chain, seal registry, transfer history—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B033 — Maevra begins retreating into command", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B189", "speaker_id": "torren", "text": "Solmar.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B033 — Maevra begins retreating into command", "source_speaker_label": "TORREN"}},
{"beat_id": "S018_B190", "speaker_id": "torren", "text": "One thing at a time.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B033 — Maevra begins retreating into command", "source_speaker_label": "TORREN", "staging": "She looks at him."}},
{"beat_id": "S018_B191", "speaker_id": "maevra", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B033 — Maevra begins retreating into command", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B192", "speaker_id": "torren", "text": "All right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B033 — Maevra begins retreating into command", "source_speaker_label": "TORREN", "staging_after": "He leaves it there. The first deliberate “Maevra” remains protected for H02."}},
{"beat_id": "S018_B193", "speaker_id": "cyanis", "text": "First thing?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B034 — Practical next step", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B194", "speaker_id": "maevra", "text": "We find out what record they used.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B034 — Practical next step", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B195", "speaker_id": "ilyra", "text": "Then?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B034 — Practical next step", "source_speaker_label": "ILYRA"}},
