beats = [
{"beat_id": "S018_B001", "speaker_id": "torren", "text": "Lot of buildings for telling people what they can do.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B001 — Judicial Causeway", "source_speaker_label": "TORREN", "staging": "The group crosses into a more administrative part of Caelora: tall civic buildings, record offices, couriers, lawyers, clerks, covered bridges."}},
{"beat_id": "S018_B002", "speaker_id": "maevra", "text": "Mostly they're for recording what people already did.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B001 — Judicial Causeway", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B003", "speaker_id": "torren", "text": "That's better?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B001 — Judicial Causeway", "source_speaker_label": "TORREN"}},
{"beat_id": "S018_B004", "speaker_id": "maevra", "text": "Some days.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B001 — Judicial Causeway", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B005", "speaker_id": "cyanis", "text": "Today?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B001 — Judicial Causeway", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B006", "speaker_id": "maevra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B001 — Judicial Causeway", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B007", "speaker_id": "order_clerk", "text": "Valid.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B002 — Mirena's writ works", "source_speaker_label": "ORDER CLERK", "staging": "At the first Causeway checkpoint, an Order Clerk checks Mirena's movement writ, Maevra's identity, and the party."}},
{"beat_id": "S018_B008", "speaker_id": "cyanis", "text": "Good start.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B002 — Mirena's writ works", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B009", "speaker_id": "order_clerk", "text": "Wait.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B002 — Mirena's writ works", "source_speaker_label": "ORDER CLERK", "staging": "The clerk stamps the ledger, then pauses over another entry."}},
{"beat_id": "S018_B010", "speaker_id": "maevra", "text": "What?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B002 — Mirena's writ works", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B011", "speaker_id": "order_clerk", "text": "This was registered seventeen minutes ago.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B003 — A second order", "source_speaker_label": "ORDER CLERK"}},
{"beat_id": "S018_B012", "speaker_id": "ilyra", "text": "What does it say?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B003 — A second order", "source_speaker_label": "ILYRA", "staging": "He pulls a newly filed seizure writ. Maevra reads."}},
{"beat_id": "S018_B013", "speaker_id": "maevra", "text": "The Card is to be removed from my custody.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B003 — A second order", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B014", "speaker_id": "cyanis", "text": "To whom?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B003 — A second order", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B015", "speaker_id": "maevra", "text": "Judicial Evidence.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B003 — A second order", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B016", "speaker_id": "torren", "text": "That bad?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B003 — A second order", "source_speaker_label": "TORREN"}},
{"beat_id": "S018_B017", "speaker_id": "maevra", "text": "Not by itself.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B003 — A second order", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B018", "speaker_id": "maevra", "text": "This is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B003 — A second order", "source_speaker_label": "MAEVRA", "staging": "She keeps reading."}},
{"beat_id": "S018_B019", "speaker_id": "maevra", "text": "It says I authorized the transfer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B004 — Her authorization", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B020", "speaker_id": "cyanis", "text": "Did you?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B004 — Her authorization", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B021", "speaker_id": "cyanis", "text": "Required question.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B004 — Her authorization", "source_speaker_label": "CYANIS", "staging": "Maevra looks at him."}},
{"beat_id": "S018_B022", "speaker_id": "maevra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B004 — Her authorization", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B023", "speaker_id": "ilyra", "text": "Forgery?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B004 — Her authorization", "source_speaker_label": "ILYRA"}},
{"beat_id": "S018_B024", "speaker_id": "maevra", "text": "Seal's real.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B004 — Her authorization", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B025", "speaker_id": "order_clerk", "text": "Registry agrees.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B004 — Her authorization", "source_speaker_label": "ORDER CLERK"}},
{"beat_id": "S018_B026", "speaker_id": "torren", "text": "Somebody stole your seal?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B004 — Her authorization", "source_speaker_label": "TORREN"}},
{"beat_id": "S018_B027", "speaker_id": "maevra", "text": "Not this one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B004 — Her authorization", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B028", "speaker_id": "maevra", "text": "Look at the time.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B005 — Impossible timing", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B029", "speaker_id": "cyanis", "text": "That was before we reached Caelora.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B005 — Impossible timing", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B030", "speaker_id": "maevra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B005 — Impossible timing", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B031", "speaker_id": "ilyra", "text": "Could you have authorized it remotely?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B005 — Impossible timing", "source_speaker_label": "ILYRA"}},
{"beat_id": "S018_B032", "speaker_id": "maevra", "text": "Not through this process.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B005 — Impossible timing", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B033", "speaker_id": "order_clerk", "text": "This authorization requires physical witness.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B005 — Impossible timing", "source_speaker_label": "ORDER CLERK"}},
{"beat_id": "S018_B034", "speaker_id": "torren", "text": "Where?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B005 — Impossible timing", "source_speaker_label": "TORREN"}},
{"beat_id": "S018_B035", "speaker_id": "order_clerk", "text": "Here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B005 — Impossible timing", "source_speaker_label": "ORDER CLERK"}},
{"beat_id": "S018_B036", "speaker_id": "torren", "text": "You have a busy morning I don't know about, Solmar?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B005 — Impossible timing", "source_speaker_label": "TORREN"}},
{"beat_id": "S018_B037", "speaker_id": "maevra", "text": "Apparently.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B005 — Impossible timing", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B038", "speaker_id": "cyanis", "text": "So the seal's real.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B006 — The title problem", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B039", "speaker_id": "maevra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B006 — The title problem", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B040", "speaker_id": "cyanis", "text": "Witness record's real.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B006 — The title problem", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B041", "speaker_id": "order_clerk", "text": "Authenticated.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B006 — The title problem", "source_speaker_label": "ORDER CLERK"}},
{"beat_id": "S018_B042", "speaker_id": "cyanis", "text": "And she wasn't here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B006 — The title problem", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B043", "speaker_id": "maevra", "text": "Correct.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B006 — The title problem", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B044", "speaker_id": "cyanis", "text": "That's a problem.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B006 — The title problem", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B045", "speaker_id": "maevra", "text": "That's an order that should not exist.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B006 — The title problem", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B046", "speaker_id": "order_clerk", "text": "I'm freezing the transfer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B007 — The clerk tries to freeze it", "source_speaker_label": "ORDER CLERK"}},
{"beat_id": "S018_B047", "speaker_id": "ivory_officer", "text": "Commander Solmar.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B007 — The clerk tries to freeze it", "source_speaker_label": "IVORY OFFICER", "staging": "Before he can mark it, an Ivory Watch detail approaches with the same seizure order."}},
{"beat_id": "S018_B048", "speaker_id": "maevra", "text": "Officer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B007 — The clerk tries to freeze it", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B049", "speaker_id": "ivory_officer", "text": "We're here for the recovered Card.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B007 — The clerk tries to freeze it", "source_speaker_label": "IVORY OFFICER"}},
{"beat_id": "S018_B050", "speaker_id": "maevra", "text": "You're not taking it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B007 — The clerk tries to freeze it", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B051", "speaker_id": "ivory_officer", "text": "Mine postdates yours.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B008 — Two legitimate orders", "source_speaker_label": "IVORY OFFICER", "staging": "The officer presents the seizure writ. Maevra presents Mirena's investigative writ."}},
{"beat_id": "S018_B052", "speaker_id": "maevra", "text": "Mine was issued by the Crown Princess.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B008 — Two legitimate orders", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B053", "speaker_id": "ivory_officer", "text": "And this transfer carries your authorization.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B008 — Two legitimate orders", "source_speaker_label": "IVORY OFFICER"}},
{"beat_id": "S018_B054", "speaker_id": "maevra", "text": "Which I did not give.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B008 — Two legitimate orders", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B055", "speaker_id": "ivory_officer", "text": "Commander, I have an authenticated order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B008 — Two legitimate orders", "source_speaker_label": "IVORY OFFICER"}},
{"beat_id": "S018_B056", "speaker_id": "maevra", "text": "So do I.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B008 — Two legitimate orders", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B057", "speaker_id": "ilyra", "text": "Your order contains a physically impossible witness entry.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B009 — The problem cannot be argued away", "source_speaker_label": "ILYRA"}},
{"beat_id": "S018_B058", "speaker_id": "ivory_officer", "text": "I don't have authority to void it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B009 — The problem cannot be argued away", "source_speaker_label": "IVORY OFFICER"}},
{"beat_id": "S018_B059", "speaker_id": "cyanis", "text": "Do you have authority to pause it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B009 — The problem cannot be argued away", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B060", "speaker_id": "ivory_officer", "text": "Not after physical transfer has been ordered.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B009 — The problem cannot be argued away", "source_speaker_label": "IVORY OFFICER"}},
{"beat_id": "S018_B061", "speaker_id": "maevra", "text": "Then we're not solving this at the gate.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B009 — The problem cannot be argued away", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B062", "speaker_id": "ivory_officer", "text": "Commander. Release the case.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B010 — First confrontation", "source_speaker_label": "IVORY OFFICER"}},
{"beat_id": "S018_B063", "speaker_id": "maevra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B010 — First confrontation", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B064", "speaker_id": "ivory_officer", "text": "Then I am required to secure it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B010 — First confrontation", "source_speaker_label": "IVORY OFFICER"}},
{"beat_id": "S018_B065", "speaker_id": "maevra", "text": "I understand.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B010 — First confrontation", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B066", "speaker_id": "torren", "text": "We're really doing this?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B010 — First confrontation", "source_speaker_label": "TORREN"}},
{"beat_id": "S018_B067", "speaker_id": "maevra", "text": "Nonlethal.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B010 — First confrontation", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B068", "speaker_id": "cyanis", "text": "Obviously.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF"], "source_section": "S018_B010 — First confrontation", "source_speaker_label": "CYANIS", "staging_after": "**AUTHORED ENCOUNTER #1 — IVORY WATCH DETAIL. Restraint-oriented; no lethal victory requirement; lawful personnel drop no personal loot.**"}},
{"beat_id": "S018_B069", "speaker_id": "cyanis", "text": "Done.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B011 — After first battle", "source_speaker_label": "CYANIS", "staging": "The final officer is disarmed and held. Cyanis backs away immediately when resistance ends."}},
{"beat_id": "S018_B070", "speaker_id": "ilyra", "text": "Anyone hurt?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B011 — After first battle", "source_speaker_label": "ILYRA"}},
{"beat_id": "S018_B071", "speaker_id": "ivory_officer", "text": "You just fought us.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B011 — After first battle", "source_speaker_label": "IVORY OFFICER", "staging": "One officer has a bad wrist. Ilyra kneels beside him."}},
{"beat_id": "S018_B072", "speaker_id": "ilyra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B011 — After first battle", "source_speaker_label": "ILYRA"}},
{"beat_id": "S018_B073", "speaker_id": "ilyra", "text": "Don't move that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B011 — After first battle", "source_speaker_label": "ILYRA", "staging": "She checks the wrist."}},
{"beat_id": "S018_B074", "speaker_id": "ivory_officer", "text": "Those facts aren't related?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B011 — After first battle", "source_speaker_label": "IVORY OFFICER"}},
{"beat_id": "S018_B075", "speaker_id": "ilyra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B011 — After first battle", "source_speaker_label": "ILYRA"}},
{"beat_id": "S018_B076", "speaker_id": "maevra", "text": "You had a sealed order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B012 — Maevra does not humiliate them", "source_speaker_label": "MAEVRA", "staging": "Maevra returns the officer's dropped sidearm hilt-first."}},
{"beat_id": "S018_B077", "speaker_id": "ivory_officer", "text": "Still do.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B012 — Maevra does not humiliate them", "source_speaker_label": "IVORY OFFICER"}},
{"beat_id": "S018_B078", "speaker_id": "maevra", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B012 — Maevra does not humiliate them", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B079", "speaker_id": "cyanis", "text": "Commander.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B013 — The copies differ", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B080", "speaker_id": "maevra", "text": "What?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B013 — The copies differ", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B081", "speaker_id": "cyanis", "text": "These aren't the same.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B013 — The copies differ", "source_speaker_label": "CYANIS", "staging": "Cyanis shows her two paper copies.", "staging_after": "The clerk compares them."}},
{"beat_id": "S018_B082", "speaker_id": "maevra", "text": "Witness block.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B014 — Altered sequence", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B083", "speaker_id": "order_clerk", "text": "Different sequence number.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B014 — Altered sequence", "source_speaker_label": "ORDER CLERK"}},
{"beat_id": "S018_B084", "speaker_id": "ilyra", "text": "Which one is valid?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B014 — Altered sequence", "source_speaker_label": "ILYRA"}},
{"beat_id": "S018_B085", "speaker_id": "order_clerk", "text": "Both.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B014 — Altered sequence", "source_speaker_label": "ORDER CLERK"}},
{"beat_id": "S018_B086", "speaker_id": "cyanis", "text": "I don't think I'm going to like that answer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B014 — Altered sequence", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B087", "speaker_id": "order_clerk", "text": "The first page was registered through Judicial Evidence.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B015 — Real pieces, wrong assembly", "source_speaker_label": "ORDER CLERK"}},
{"beat_id": "S018_B088", "speaker_id": "order_clerk", "text": "The authorization page came through military custody.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B015 — Real pieces, wrong assembly", "source_speaker_label": "ORDER CLERK"}},
{"beat_id": "S018_B089", "speaker_id": "maevra", "text": "Both authentic systems.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B015 — Real pieces, wrong assembly", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B090", "speaker_id": "order_clerk", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B015 — Real pieces, wrong assembly", "source_speaker_label": "ORDER CLERK"}},
{"beat_id": "S018_B091", "speaker_id": "maevra", "text": "But they weren't issued together.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B015 — Real pieces, wrong assembly", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B092", "speaker_id": "order_clerk", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B015 — Real pieces, wrong assembly", "source_speaker_label": "ORDER CLERK"}},
{"beat_id": "S018_B093", "speaker_id": "torren", "text": "Somebody stitched them together.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B015 — Real pieces, wrong assembly", "source_speaker_label": "TORREN"}},
{"beat_id": "S018_B094", "speaker_id": "maevra", "text": "Looks that way.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B015 — Real pieces, wrong assembly", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B095", "speaker_id": "cyanis", "text": "So somebody forged an order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B016 — Not a simple forgery", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B096", "speaker_id": "maevra", "text": "Not exactly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B016 — Not a simple forgery", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B097", "speaker_id": "maevra", "text": "They didn't forge the pieces.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B016 — Not a simple forgery", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B098", "speaker_id": "maevra", "text": "They used real pieces to make something false.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B016 — Not a simple forgery", "source_speaker_label": "MAEVRA", "staging": "She holds up the pages."}},
{"beat_id": "S018_B099", "speaker_id": "order_clerk", "text": "The merged copy passed through Central Adjudication.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B017 — Provenance", "source_speaker_label": "ORDER CLERK"}},
{"beat_id": "S018_B100", "speaker_id": "maevra", "text": "Who signed release?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B017 — Provenance", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B101", "speaker_id": "cyanis", "text": "That's encouraging.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B017 — Provenance", "source_speaker_label": "CYANIS", "staging": "The clerk goes quiet."}},
{"beat_id": "S018_B102", "speaker_id": "order_clerk", "text": "Ivory Adjudicator Sereth.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B017 — Provenance", "source_speaker_label": "ORDER CLERK"}},
{"beat_id": "S018_B103", "speaker_id": "maevra", "text": "Where?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B017 — Provenance", "source_speaker_label": "MAEVRA", "staging_after": "The clerk points farther down the Causeway."}},
{"beat_id": "S018_B104", "speaker_id": "torren", "text": "You know him?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "RETURN_PLAYER_CONTROL", "SAFE_DIALOGUE_POCKET"], "source_section": "S018_B018 — Walking dialogue", "source_speaker_label": "TORREN", "staging": "Player control resumes briefly. No random encounters."}},
{"beat_id": "S018_B105", "speaker_id": "maevra", "text": "By reputation.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B018 — Walking dialogue", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B106", "speaker_id": "torren", "text": "Good?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B018 — Walking dialogue", "source_speaker_label": "TORREN"}},
{"beat_id": "S018_B107", "speaker_id": "maevra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B018 — Walking dialogue", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B108", "speaker_id": "torren", "text": "That's inconvenient.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B018 — Walking dialogue", "source_speaker_label": "TORREN"}},
{"beat_id": "S018_B109", "speaker_id": "maevra", "text": "Very.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B018 — Walking dialogue", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B110", "speaker_id": "cyanis", "text": "You two sound disappointed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B018 — Walking dialogue", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B111", "speaker_id": "torren", "text": "Bad people are easier.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B018 — Walking dialogue", "source_speaker_label": "TORREN"}},
{"beat_id": "S018_B112", "speaker_id": "cyanis", "text": "Usually.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B018 — Walking dialogue", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B113", "speaker_id": "ilyra", "text": "And usually less dangerous than competent people acting on bad information.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B018 — Walking dialogue", "source_speaker_label": "ILYRA", "staging_after": "Nobody jokes after that."}},
{"beat_id": "S018_B114", "speaker_id": "ivory_adjudicator", "text": "Commander Solmar.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B019 — Central Adjudication", "source_speaker_label": "IVORY ADJUDICATOR", "staging": "The Ivory Adjudicator is already waiting, formal royal armor and poleblade grounded beside him. Two restraint officers stand back."}},
{"beat_id": "S018_B115", "speaker_id": "maevra", "text": "Adjudicator.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B019 — Central Adjudication", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B116", "speaker_id": "ivory_adjudicator", "text": "You've resisted lawful seizure.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B019 — Central Adjudication", "source_speaker_label": "IVORY ADJUDICATOR"}},
{"beat_id": "S018_B117", "speaker_id": "maevra", "text": "I've resisted a false order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B019 — Central Adjudication", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B118", "speaker_id": "ivory_adjudicator", "text": "Authenticated order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B019 — Central Adjudication", "source_speaker_label": "IVORY ADJUDICATOR"}},
{"beat_id": "S018_B119", "speaker_id": "maevra", "text": "False order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B019 — Central Adjudication", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B120", "speaker_id": "ivory_adjudicator", "text": "Find me the false seal.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B020 — Neither side is stupid", "source_speaker_label": "IVORY ADJUDICATOR", "staging": "He hands her the ledger."}},
{"beat_id": "S018_B121", "speaker_id": "maevra", "text": "There isn't one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B020 — Neither side is stupid", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B122", "speaker_id": "ivory_adjudicator", "text": "False witness.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B020 — Neither side is stupid", "source_speaker_label": "IVORY ADJUDICATOR"}},
{"beat_id": "S018_B123", "speaker_id": "maevra", "text": "Witness exists.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B020 — Neither side is stupid", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S018_B124", "speaker_id": "ivory_adjudicator", "text": "Invalid authority.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B020 — Neither side is stupid", "source_speaker_label": "IVORY ADJUDICATOR"}},
{"beat_id": "S018_B125", "speaker_id": "maevra", "text": "Both authorities are valid.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B020 — Neither side is stupid", "source_speaker_label": "MAEVRA"}},
