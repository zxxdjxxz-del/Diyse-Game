authoring_notes = "Audit75 CLOSED-AUTHORITY IMPLEMENTATION SHELL. S018 is closed canon; exact former full transcript was not serialized to a recoverable artifact. Preserve the lawful/procedural contradiction, exactly two authored nonlethal authority confrontations, competent lawful personnel, the protected Adjudicator wording, and Torren's formal 'Solmar' address. Do not reconstruct missing dialogue or spend the later deliberate 'Maevra' beat."
beats = [{"beat_id":"S018_B001","cues":{"staging":"Judicial Causeway. Authenticated emergency authority has been assembled into an impossible legal configuration: valid pieces exist, but no valid initiating declaration makes the resulting order lawful. No random farming of Crown/Ivory personnel."}},
{"beat_id":"S018_B002","cues":{"staging":"FIRST AUTHORED NONLETHAL AUTHORITY CONFRONTATION. Enforcement initiates physical contact after procedural refusal. Cyanis does not attack lawful personnel merely for disagreement. Resolve through restraint/nonlethal battle vocabulary.","implementation_flags":["AUTHORED_NONLETHAL_CONFRONTATION_1"]}},
{"beat_id":"S018_B003","cues":{"staging":"Between confrontations, evidence shows the order's valid pieces are defending/reinforcing one another procedurally instead of proving a valid beginning."}},
{"beat_id":"S018_B004","cues":{"staging":"Preserve the exact protected line 'Prove it.' at the established Adjudicator exchange point. The surviving closure record does not uniquely preserve which of its repeated/echoed uses should be serialized as the sole spoken beat, so do not invent a new speaker assignment here."}},
{"beat_id":"S018_B005","speaker_id":"ivory_adjudicator","text":"I know it is contradictory."},
{"beat_id":"S018_B006","cues":{"staging":"SECOND AUTHORED NONLETHAL AUTHORITY CONFRONTATION / Ivory Adjudicator. Lawful personnel remain competent and act from authenticated records; the player proves contradiction rather than treating them as villains.","implementation_flags":["AUTHORED_NONLETHAL_CONFRONTATION_2","IVORY_ADJUDICATOR_SEQUENCE"]}},
{"beat_id":"S018_B007","speaker_id":"ivory_adjudicator","text":"Belief is not the standard."},
{"beat_id":"S018_B008","speaker_id":"ilyra","text":"Neither is pretending."},
{"beat_id":"S018_B009","cues":{"staging":"Once the ledger/record contradiction is exposed, the Adjudicator halts enforcement rather than fighting to the death."}},
{"beat_id":"S018_B010","speaker_id":"ivory_adjudicator","text":"The order was protecting itself."},
{"beat_id":"S018_B011","cues":{"staging":"Recovery aftermath keeps Torren/Maevra formal. Preserve the brief address pair without commentary; do not use first names."}},
{"beat_id":"S018_B012","speaker_id":"maevra","text":"Harth."},
{"beat_id":"S018_B013","speaker_id":"torren","text":"Solmar."},
{"beat_id":"S018_B014","cues":{"staging":"The proven provenance points into the Old City / Suppressed Archives. Next mandatory objective text: 'Enter the Suppressed Archives.' This is an objective, not a character line.","implementation_flags":["OBJECTIVE_ENTER_SUPPRESSED_ARCHIVES","HANDOFF_TO_S019"]}}]
