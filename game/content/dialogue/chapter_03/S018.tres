{"beat_id": "S018_B197", "speaker_id": "cyanis", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B034 — Practical next step", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B198", "speaker_id": "ivory_adjudicator", "text": "This grants entry to the Suppressed Archive under investigative authority.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B035 — Access warrant", "source_speaker_label": "IVORY ADJUDICATOR", "staging": "The Ivory Adjudicator signs a physical access warrant."}},
{"beat_id": "S018_B199", "speaker_id": "ivory_adjudicator", "text": "If someone challenges it—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B035 — Access warrant", "source_speaker_label": "IVORY ADJUDICATOR"}},
{"beat_id": "S018_B200", "speaker_id": "cyanis", "text": "Please don't say we have another authenticated order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B035 — Access warrant", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B201", "speaker_id": "ivory_adjudicator", "text": "This one has a beginning.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B035 — Access warrant", "source_speaker_label": "IVORY ADJUDICATOR", "staging": "The Adjudicator almost smiles."}},
{"beat_id": "S018_B202", "speaker_id": "cyanis", "text": "We're improving.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B035 — Access warrant", "source_speaker_label": "CYANIS"}},
{"beat_id": "S018_B203", "speaker_id": "ilyra", "text": "You all right?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B036 — Exit", "source_speaker_label": "ILYRA", "staging": "The party turns toward the Old City. The Ivory personnel stay behind to audit the false order rather than becoming continuing enemies."}},
{"beat_id": "S018_B204", "speaker_id": "maevra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S018_B036 — Exit", "source_speaker_label": "MAEVRA"}},
