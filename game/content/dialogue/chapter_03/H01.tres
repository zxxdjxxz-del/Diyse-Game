authoring_notes = "Chapter 3 exact Resource conversion from docs/chapters/dialogue/chapter_03/H01.md under Complete Master Canon v1.64 / Audit79, Chapter transcript checkpoint Audit77 plus the bounded S020→S021 Cresthaven correction. Spoken text is line-complete and must not be rewritten. Source staging/prose is preserved in cue metadata. H01/H02/H03 preserve their earlier eligibility flags but require Cresthaven location access before playback. Spoken-sequence SHA-256: 93e6399c3985513863dc122fd473a091ab9c64a93e28431871a91abcd5f55eae."
beats = [
{"beat_id": "H01_B001", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B001", "source_speaker_label": "TORREN", "staging": "Cresthaven, temporary Archive/Common work area. One long table. Cyanis has a cup at one end; Torren is checking a strap at the other. Nimera arrives with the Living Index Tablet, three paper bundles, two slate fragments, a cup, a loose pencil, and an object neither man recognizes."}},
{"beat_id": "H01_B002", "speaker_id": "nimera", "text": "I haven't done anything.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B001", "source_speaker_label": "NIMERA"}},
{"beat_id": "H01_B003", "speaker_id": "torren", "text": "You were about to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B001", "source_speaker_label": "TORREN"}},
{"beat_id": "H01_B004", "speaker_id": "cyanis", "text": "That's not empty.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B002", "source_speaker_label": "CYANIS", "staging": "Nimera puts one paper bundle down anyway."}},
{"beat_id": "H01_B005", "speaker_id": "nimera", "text": "Temporarily.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B002", "source_speaker_label": "NIMERA"}},
{"beat_id": "H01_B006", "speaker_id": "torren", "text": "That's not what that word means.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B002", "source_speaker_label": "TORREN"}},
{"beat_id": "H01_B007", "speaker_id": "nimera", "text": "It can be aspirational.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B002", "source_speaker_label": "NIMERA"}},
{"beat_id": "H01_B008", "speaker_id": "torren", "text": "You have your own table.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B003", "source_speaker_label": "TORREN", "staging": "Another bundle appears. Torren moves his strap two inches toward himself."}},
{"beat_id": "H01_B009", "speaker_id": "nimera", "text": "I have half a table.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B003", "source_speaker_label": "NIMERA"}},
{"beat_id": "H01_B010", "speaker_id": "cyanis", "text": "This is also half a table.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B003", "source_speaker_label": "CYANIS"}},
{"beat_id": "H01_B011", "speaker_id": "nimera", "text": "Correct.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B003", "source_speaker_label": "NIMERA"}},
{"beat_id": "H01_B012", "speaker_id": "cyanis", "text": "I see the problem.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B003", "source_speaker_label": "CYANIS"}},
{"beat_id": "H01_B013", "speaker_id": "torren", "text": "Do you?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B003", "source_speaker_label": "TORREN"}},
{"beat_id": "H01_B014", "speaker_id": "cyanis", "text": "Not mine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B003", "source_speaker_label": "CYANIS"}},
{"beat_id": "H01_B015", "speaker_id": "nimera", "text": "You've known me for an hour.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B004", "source_speaker_label": "NIMERA"}},
{"beat_id": "H01_B016", "speaker_id": "torren", "text": "Didn't take that long.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B004", "source_speaker_label": "TORREN"}},
{"beat_id": "H01_B017", "speaker_id": "nimera", "text": "That's insulting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B004", "source_speaker_label": "NIMERA"}},
{"beat_id": "H01_B018", "speaker_id": "torren", "text": "Accurate.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B004", "source_speaker_label": "TORREN"}},
{"beat_id": "H01_B019", "speaker_id": "nimera", "text": "Worse.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B004", "source_speaker_label": "NIMERA"}},
{"beat_id": "H01_B020", "speaker_id": "maevra", "text": "There was more table a minute ago.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B005", "source_speaker_label": "MAEVRA", "staging": "Maevra passes the doorway, sees the table, and stops."}},
{"beat_id": "H01_B021", "speaker_id": "nimera", "text": "Temporarily.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B005", "source_speaker_label": "NIMERA"}},
{"beat_id": "H01_B022", "speaker_id": "maevra", "text": "I've adapted.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B005", "source_speaker_label": "MAEVRA", "staging_after": "She keeps walking before Nimera can answer."}},
{"beat_id": "H01_B023", "speaker_id": "cyanis", "text": "That's mine now?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B006", "source_speaker_label": "CYANIS", "staging": "Nimera shifts a cup onto Cyanis's side."}},
{"beat_id": "H01_B024", "speaker_id": "nimera", "text": "It's neutral territory.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B006", "source_speaker_label": "NIMERA"}},
{"beat_id": "H01_B025", "speaker_id": "cyanis", "text": "On my hand?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B006", "source_speaker_label": "CYANIS"}},
{"beat_id": "H01_B026", "speaker_id": "nimera", "text": "Border dispute.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B006", "source_speaker_label": "NIMERA"}},
{"beat_id": "H01_B027", "speaker_id": "torren", "text": "Lose the border.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B006", "source_speaker_label": "TORREN"}},
{"beat_id": "H01_B028", "speaker_id": "torren", "text": "There's room for people. There's no room for more things.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B007", "source_speaker_label": "TORREN"}},
{"beat_id": "H01_B029", "speaker_id": "nimera", "text": "People are things.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B007", "source_speaker_label": "NIMERA"}},
{"beat_id": "H01_B030", "speaker_id": "cyanis", "text": "Dangerous opening.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B007", "source_speaker_label": "CYANIS"}},
{"beat_id": "H01_B031", "speaker_id": "nimera", "text": "Fine. People are spatially expensive objects with opinions.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B007", "source_speaker_label": "NIMERA"}},
{"beat_id": "H01_B032", "speaker_id": "torren", "text": "Better.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B007", "source_speaker_label": "TORREN"}},
{"beat_id": "H01_B033", "speaker_id": "cyanis", "text": "Is it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B007", "source_speaker_label": "CYANIS"}},
{"beat_id": "H01_B034", "speaker_id": "torren", "text": "Sit down or take the other table.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B008", "source_speaker_label": "TORREN", "staging": "Nimera finally sits, then immediately stands to reach across Torren for a record slip."}},
{"beat_id": "H01_B035", "speaker_id": "nimera", "text": "Those are not equivalent options.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B008", "source_speaker_label": "NIMERA"}},
{"beat_id": "H01_B036", "speaker_id": "torren", "text": "They are to me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B008", "source_speaker_label": "TORREN"}},
{"beat_id": "H01_B037", "speaker_id": "nimera", "text": "I dislike how simple your world is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B008", "source_speaker_label": "NIMERA"}},
{"beat_id": "H01_B038", "speaker_id": "torren", "text": "Works.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B008", "source_speaker_label": "TORREN"}},
{"beat_id": "H01_B039", "speaker_id": "cyanis", "text": "How much of this are you actively using?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B009", "source_speaker_label": "CYANIS", "staging": "Cyanis looks at the slowly vanishing table surface."}},
{"beat_id": "H01_B040", "speaker_id": "nimera", "text": "Define actively.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B009", "source_speaker_label": "NIMERA"}},
{"beat_id": "H01_B041", "speaker_id": "cyanis", "text": "Touching before tomorrow.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B009", "source_speaker_label": "CYANIS"}},
{"beat_id": "H01_B042", "speaker_id": "nimera", "text": "Hostile definition.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B009", "source_speaker_label": "NIMERA"}},
{"beat_id": "H01_B043", "speaker_id": "clerk", "text": "Pellan?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B010", "source_speaker_label": "CLERK", "staging": "A clerk enters with another folder, stops, and looks at Nimera's occupation of the table."}},
{"beat_id": "H01_B044", "speaker_id": "nimera", "text": "Yes?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B010", "source_speaker_label": "NIMERA"}},
{"beat_id": "H01_B045", "speaker_id": "clerk", "text": "You're only assigned half that table.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B010", "source_speaker_label": "CLERK"}},
{"beat_id": "H01_B046", "speaker_id": "nimera", "text": "Technically—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B010", "source_speaker_label": "NIMERA", "staging": "Nimera opens her mouth."}},
{"beat_id": "H01_B047", "speaker_id": "cyanis", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B010", "source_speaker_label": "CYANIS"}},
{"beat_id": "H01_B048", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B010", "source_speaker_label": "TORREN"}},
{"beat_id": "H01_B049", "speaker_id": "nimera", "text": "Fuck both of you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H01_B010", "source_speaker_label": "NIMERA", "staging": "Nimera looks between them, offended and delighted.", "staging_after": "End."}}
]
