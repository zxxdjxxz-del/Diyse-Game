beats = [{"beat_id":"H01_B001","cues":{"staging":"Cresthaven work table after S019. Nimera gradually occupies more of the table with notes, records, Card references, cups, and practical clutter. Use table clutter state swaps/tweens rather than bespoke hand animation."}},
{"beat_id":"H01_B002","cues":{"staging":"Cyanis and Torren are present for ordinary work/social friction. Nimera should engage statements, challenge wording, revise herself aloud, and swear naturally; do not turn her into a formal exposition machine or profanity quota."}},
{"beat_id":"H01_B003","cues":{"staging":"Keep the surface subject mundane: who has space, where something was put, whether a stack is actually organized, or whether the table still belongs to everyone. No required lore reveal is allowed to hide inside the scene."}},
{"beat_id":"H01_B004","cues":{"staging":"End when the table has visibly become Nimera's working territory and the others have adapted around her without anybody announcing that she belongs. Reusable sit/stand/point/prop states only."}}]
