authoring_notes = "Chapter 3 exact Resource conversion from docs/chapters/dialogue/chapter_03/H03.md under Complete Master Canon v1.64 / Audit79, Chapter transcript checkpoint Audit77 plus the bounded S020→S021 Cresthaven correction. Spoken text is line-complete and must not be rewritten. Source staging/prose is preserved in cue metadata. H01/H02/H03 preserve their earlier eligibility flags but require Cresthaven location access before playback. Spoken-sequence SHA-256: 0019fa6b4da61c088c6f2dd862a0cfef46df761f528e0c24a11a3ec613e3e54c."
beats = [
{"beat_id": "H03_B001", "speaker_id": "ilyra", "text": "What happened?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B001", "source_speaker_label": "ILYRA", "staging": "Cresthaven temporary Medical space. Nimera enters with one hand wrapped badly in a strip of cloth."}},
{"beat_id": "H03_B002", "speaker_id": "nimera", "text": "Nothing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B001", "source_speaker_label": "NIMERA"}},
{"beat_id": "H03_B003", "speaker_id": "ilyra", "text": "That's bleeding.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B001", "source_speaker_label": "ILYRA"}},
{"beat_id": "H03_B004", "speaker_id": "nimera", "text": "Well, shit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B001", "source_speaker_label": "NIMERA", "staging": "Nimera looks down."}},
{"beat_id": "H03_B005", "speaker_id": "ilyra", "text": "Sit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B001", "source_speaker_label": "ILYRA"}},
{"beat_id": "H03_B006", "speaker_id": "nimera", "text": "It's fine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B001", "source_speaker_label": "NIMERA"}},
{"beat_id": "H03_B007", "speaker_id": "ilyra", "text": "Then sitting shouldn't hurt it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B001", "source_speaker_label": "ILYRA"}},
{"beat_id": "H03_B008", "speaker_id": "ilyra", "text": "Can I?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B002", "source_speaker_label": "ILYRA", "staging": "Nimera sits. Ilyra reaches for the wrap, then pauses."}},
{"beat_id": "H03_B009", "speaker_id": "nimera", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B002", "source_speaker_label": "NIMERA"}},
{"beat_id": "H03_B010", "speaker_id": "ilyra", "text": "All right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B002", "source_speaker_label": "ILYRA", "staging": "Ilyra stops immediately."}},
{"beat_id": "H03_B011", "speaker_id": "nimera", "text": "That's it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B002", "source_speaker_label": "NIMERA", "staging": "Nimera looks at her, surprised by the lack of argument."}},
{"beat_id": "H03_B012", "speaker_id": "ilyra", "text": "You said no.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B002", "source_speaker_label": "ILYRA"}},
{"beat_id": "H03_B013", "speaker_id": "nimera", "text": "Fine. Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B003", "source_speaker_label": "NIMERA", "staging": "Beat. Nimera flexes the injured hand and winces."}},
{"beat_id": "H03_B014", "speaker_id": "ilyra", "text": "Different answer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B003", "source_speaker_label": "ILYRA"}},
{"beat_id": "H03_B015", "speaker_id": "nimera", "text": "Don't enjoy that too much.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B003", "source_speaker_label": "NIMERA"}},
{"beat_id": "H03_B016", "speaker_id": "ilyra", "text": "I wasn't planning to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B003", "source_speaker_label": "ILYRA"}},
{"beat_id": "H03_B017", "speaker_id": "ilyra", "text": "This is awful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B004", "source_speaker_label": "ILYRA", "staging": "Ilyra unwraps the terrible improvised bandage."}},
{"beat_id": "H03_B018", "speaker_id": "nimera", "text": "It was temporary.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B004", "source_speaker_label": "NIMERA"}},
{"beat_id": "H03_B019", "speaker_id": "ilyra", "text": "It was six seconds old.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B004", "source_speaker_label": "ILYRA"}},
{"beat_id": "H03_B020", "speaker_id": "nimera", "text": "Exactly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B004", "source_speaker_label": "NIMERA"}},
{"beat_id": "H03_B021", "speaker_id": "ilyra", "text": "What did you cut it on?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B005", "source_speaker_label": "ILYRA"}},
{"beat_id": "H03_B022", "speaker_id": "nimera", "text": "A shelf.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B005", "source_speaker_label": "NIMERA"}},
{"beat_id": "H03_B023", "speaker_id": "ilyra", "text": "A shelf.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B005", "source_speaker_label": "ILYRA"}},
{"beat_id": "H03_B024", "speaker_id": "nimera", "text": "Ancient shelf.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B005", "source_speaker_label": "NIMERA"}},
{"beat_id": "H03_B025", "speaker_id": "ilyra", "text": "Ah. Historic injury.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B005", "source_speaker_label": "ILYRA"}},
{"beat_id": "H03_B026", "speaker_id": "nimera", "text": "Fuck you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B005", "source_speaker_label": "NIMERA", "staging_after": "Ilyra smiles slightly and keeps cleaning it."}},
{"beat_id": "H03_B027", "speaker_id": "ilyra", "text": "You're bleeding on the archive.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B006", "source_speaker_label": "ILYRA", "staging": "A small drop lands near the edge of a record cloth Nimera brought with her."}},
{"beat_id": "H03_B028", "speaker_id": "nimera", "text": "I'm not.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B006", "source_speaker_label": "NIMERA"}},
{"beat_id": "H03_B029", "speaker_id": "nimera", "text": "I am bleeding near the archive.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B006", "source_speaker_label": "NIMERA", "staging": "Another drop lands."}},
{"beat_id": "H03_B030", "speaker_id": "ilyra", "text": "Much better.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B006", "source_speaker_label": "ILYRA"}},
{"beat_id": "H03_B031", "speaker_id": "nimera", "text": "Precision matters.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B006", "source_speaker_label": "NIMERA"}},
{"beat_id": "H03_B032", "speaker_id": "ilyra", "text": "Good fuck or bad fuck?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B007", "source_speaker_label": "ILYRA"}},
{"beat_id": "H03_B033", "speaker_id": "nimera", "text": "Don't steal my language.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B007", "source_speaker_label": "NIMERA", "staging": "Nimera looks up sharply."}},
{"beat_id": "H03_B034", "speaker_id": "ilyra", "text": "You left it unattended.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B007", "source_speaker_label": "ILYRA"}},
{"beat_id": "H03_B035", "speaker_id": "nimera", "text": "That's not how language works.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B007", "source_speaker_label": "NIMERA"}},
{"beat_id": "H03_B036", "speaker_id": "ilyra", "text": "Apparently it is now.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B007", "source_speaker_label": "ILYRA"}},
{"beat_id": "H03_B037", "speaker_id": "ilyra", "text": "Bread?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B008", "source_speaker_label": "ILYRA", "staging": "Ilyra finishes the clean wrap."}},
{"beat_id": "H03_B038", "speaker_id": "nimera", "text": "What?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B008", "source_speaker_label": "NIMERA"}},
{"beat_id": "H03_B039", "speaker_id": "ilyra", "text": "You haven't eaten.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B008", "source_speaker_label": "ILYRA"}},
{"beat_id": "H03_B040", "speaker_id": "nimera", "text": "How do you know that?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B008", "source_speaker_label": "NIMERA"}},
{"beat_id": "H03_B041", "speaker_id": "ilyra", "text": "You have the terrible bread in your pocket.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B008", "source_speaker_label": "ILYRA"}},
{"beat_id": "H03_B042", "speaker_id": "nimera", "text": "I was saving it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B008", "source_speaker_label": "NIMERA", "staging": "Nimera checks, offended that this is true."}},
{"beat_id": "H03_B043", "speaker_id": "ilyra", "text": "From whom?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B008", "source_speaker_label": "ILYRA"}},
{"beat_id": "H03_B044", "speaker_id": "nimera", "text": "Hunger.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B008", "source_speaker_label": "NIMERA"}},
{"beat_id": "H03_B045", "speaker_id": "ilyra", "text": "Poorly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B008", "source_speaker_label": "ILYRA"}},
{"beat_id": "H03_B046", "speaker_id": "nimera", "text": "Amarin.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B009", "source_speaker_label": "NIMERA"}},
{"beat_id": "H03_B047", "speaker_id": "ilyra", "text": "Yes?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B009", "source_speaker_label": "ILYRA"}},
{"beat_id": "H03_B048", "speaker_id": "nimera", "text": "Thanks.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B009", "source_speaker_label": "NIMERA", "staging": "Nimera glances at the new wrap."}},
{"beat_id": "H03_B049", "speaker_id": "ilyra", "text": "You're welcome.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H03_B009", "source_speaker_label": "ILYRA", "staging_after": "No follow-up question about fear, history, family, or why she said no. End."}}
]
