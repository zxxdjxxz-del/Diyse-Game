beats = [{"beat_id":"H03_B001","cues":{"staging":"Cresthaven medical/work table after S019. Nimera has a shallow hand/forearm cut and a bad improvised wrap. Ilyra treats the small injury while both remain capable adults. One table, wrap/poultice, bread, reusable seated/standing poses, portraits, pauses."}},
