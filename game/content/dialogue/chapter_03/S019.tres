beats = [
{"beat_id": "S019_B001", "speaker_id": "torren", "text": "They built the city over this?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B001 — The Old City", "source_speaker_label": "TORREN", "staging": "The Old City begins beneath later Caeloran construction. Excavated streets descend through modern access works into exposed Diysean architecture: fitted stone-metal walls, recessed mechanisms, intact door frames, enormous structural joints."}},
{"beat_id": "S019_B002", "speaker_id": "maevra", "text": "Parts of it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B001 — The Old City", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S019_B003", "speaker_id": "cyanis", "text": "Brackenwall's ruins were smaller.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B001 — The Old City", "source_speaker_label": "CYANIS"}},
{"beat_id": "S019_B004", "speaker_id": "ilyra", "text": "By a lot.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B001 — The Old City", "source_speaker_label": "ILYRA"}},
{"beat_id": "S019_B005", "speaker_id": "maevra", "text": "Old City gets the name for a reason.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B001 — The Old City", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S019_B006", "speaker_id": "cyanis", "text": "That's comforting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B002 — Modern records inside Ancient infrastructure", "source_speaker_label": "CYANIS", "staging": "The outer repository workspace is distinctly modern: Crown shelving, paper bundles, sealed boxes, catalog tags, lamps, later partitions. Behind it is unmistakably Diysean machinery."}},
{"beat_id": "S019_B007", "speaker_id": "ilyra", "text": "Which part?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B002 — Modern records inside Ancient infrastructure", "source_speaker_label": "ILYRA"}},
{"beat_id": "S019_B008", "speaker_id": "cyanis", "text": "The paperwork.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B002 — Modern records inside Ancient infrastructure", "source_speaker_label": "CYANIS"}},
{"beat_id": "S019_B009", "speaker_id": "torren", "text": "You just fought two groups of people over paperwork.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B002 — Modern records inside Ancient infrastructure", "source_speaker_label": "TORREN"}},
{"beat_id": "S019_B010", "speaker_id": "cyanis", "text": "I didn't say very comforting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B002 — Modern records inside Ancient infrastructure", "source_speaker_label": "CYANIS"}},
{"beat_id": "S019_B011", "speaker_id": "torren", "text": "That one ours?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B003 — The warrant and the ancient door", "source_speaker_label": "TORREN", "staging": "Maevra presents the access writ to a modern lockbox. The modern lock releases. The ancient door behind it does not. Internal rings rotate, then stop."}},
{"beat_id": "S019_B012", "speaker_id": "maevra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B003 — The warrant and the ancient door", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S019_B013", "speaker_id": "cyanis", "text": "Crest pattern.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B003 — The warrant and the ancient door", "source_speaker_label": "CYANIS"}},
{"beat_id": "S019_B014", "speaker_id": "maevra", "text": "Certain?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B003 — The warrant and the ancient door", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S019_B015", "speaker_id": "cyanis", "text": "No. But close enough that I don't want to touch it blindly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B003 — The warrant and the ancient door", "source_speaker_label": "CYANIS"}},
{"beat_id": "S019_B016", "speaker_id": "womans_voice", "text": "Oh, you miserable ancient piece of shit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B004 — Someone is already swearing inside", "source_speaker_label": "WOMAN'S VOICE", "delivery": "offscreen"}},
{"beat_id": "S019_B017", "speaker_id": "torren", "text": "Alive.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B004 — Someone is already swearing inside", "source_speaker_label": "TORREN", "staging": "Everyone stops."}},
{"beat_id": "S019_B018", "speaker_id": "cyanis", "text": "Promising.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B004 — Someone is already swearing inside", "source_speaker_label": "CYANIS"}},
{"beat_id": "S019_B019", "speaker_id": "womans_voice", "text": "No. No, don't fucking close—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B004 — Someone is already swearing inside", "source_speaker_label": "WOMAN'S VOICE", "delivery": "offscreen"}},
{"beat_id": "S019_B020", "speaker_id": "womans_voice", "text": "You absolute bastard.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B004 — Someone is already swearing inside", "source_speaker_label": "WOMAN'S VOICE", "staging": "A mechanism slams.", "delivery": "offscreen"}},
{"beat_id": "S019_B021", "speaker_id": "ilyra", "text": "Should we help?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B004 — Someone is already swearing inside", "source_speaker_label": "ILYRA"}},
{"beat_id": "S019_B022", "speaker_id": "cyanis", "text": "Feels rude not to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B004 — Someone is already swearing inside", "source_speaker_label": "CYANIS"}},
{"beat_id": "S019_B023", "speaker_id": "nimera", "text": "Oh, good. Authority.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B005 — Nimera Pellan", "source_speaker_label": "NIMERA", "staging": "They find Nimera Pellan in a record alcove behind a waist-high security barrier. She is annoyed, not helpless. A Living Index Tablet is open in one hand; record slips cover the work surface."}},
{"beat_id": "S019_B024", "speaker_id": "maevra", "text": "You don't sound pleased.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B005 — Nimera Pellan", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S019_B025", "speaker_id": "nimera", "text": "I've had a complicated day with authority.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B005 — Nimera Pellan", "source_speaker_label": "NIMERA"}},
{"beat_id": "S019_B026", "speaker_id": "cyanis", "text": "We have something in common.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B005 — Nimera Pellan", "source_speaker_label": "CYANIS"}},
{"beat_id": "S019_B027", "speaker_id": "nimera", "text": "That sentence worries me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B005 — Nimera Pellan", "source_speaker_label": "NIMERA"}},
{"beat_id": "S019_B028", "speaker_id": "maevra", "text": "Nimera Pellan?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B006 — Immediate personality", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S019_B029", "speaker_id": "nimera", "text": "Depends.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B006 — Immediate personality", "source_speaker_label": "NIMERA"}},
{"beat_id": "S019_B030", "speaker_id": "maevra", "text": "Commander Solmar.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B006 — Immediate personality", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S019_B031", "speaker_id": "nimera", "text": "Then yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B006 — Immediate personality", "source_speaker_label": "NIMERA"}},
{"beat_id": "S019_B032", "speaker_id": "maevra", "text": "What are you doing in here?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B006 — Immediate personality", "source_speaker_label": "MAEVRA", "staging": "Torren snorts. Maevra ignores him."}},
{"beat_id": "S019_B033", "speaker_id": "nimera", "text": "Currently? Regretting three choices and a fourth one I'm still defending.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B006 — Immediate personality", "source_speaker_label": "NIMERA"}},
{"beat_id": "S019_B034", "speaker_id": "maevra", "text": "Can you identify where this source notation came from?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B007 — Why she matters", "source_speaker_label": "MAEVRA", "staging": "Maevra shows her the falsified seizure record."}},
{"beat_id": "S019_B035", "speaker_id": "nimera", "text": "May I?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B007 — Why she matters", "source_speaker_label": "NIMERA"}},
{"beat_id": "S019_B036", "speaker_id": "nimera", "text": "Where did you get this?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B007 — Why she matters", "source_speaker_label": "NIMERA", "staging": "She reads it once, then again faster."}},
{"beat_id": "S019_B037", "speaker_id": "maevra", "text": "Central Adjudication.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B007 — Why she matters", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S019_B038", "speaker_id": "nimera", "text": "No, I mean who assembled it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B007 — Why she matters", "source_speaker_label": "NIMERA"}},
{"beat_id": "S019_B039", "speaker_id": "maevra", "text": "That's what we're trying to find out.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B007 — Why she matters", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S019_B040", "speaker_id": "nimera", "text": "Oh. Well, that's fucking interesting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B007 — Why she matters", "source_speaker_label": "NIMERA"}},
{"beat_id": "S019_B041", "speaker_id": "nimera", "text": "These aren't from the same record family.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B008 — Provenance", "source_speaker_label": "NIMERA"}},
{"beat_id": "S019_B042", "speaker_id": "cyanis", "text": "We know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B008 — Provenance", "source_speaker_label": "CYANIS"}},
{"beat_id": "S019_B043", "speaker_id": "nimera", "text": "No, you know they're from different orders. I'm saying this reference was catalogued as judicial authority. This one was stored as custody precedent.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B008 — Provenance", "source_speaker_label": "NIMERA"}},
{"beat_id": "S019_B044", "speaker_id": "ilyra", "text": "Same archive?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B008 — Provenance", "source_speaker_label": "ILYRA"}},
{"beat_id": "S019_B045", "speaker_id": "nimera", "text": "Eventually.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B008 — Provenance", "source_speaker_label": "NIMERA"}},
{"beat_id": "S019_B046", "speaker_id": "nimera", "text": "That's the problem.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B008 — Provenance", "source_speaker_label": "NIMERA", "staging": "She glances toward the stacks."}},
{"beat_id": "S019_B047", "speaker_id": "cyanis", "text": "Explain “eventually.”", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B009 — Eventually", "source_speaker_label": "CYANIS"}},
{"beat_id": "S019_B048", "speaker_id": "nimera", "text": "Records move. Copies get recopied. Catalogues get rebuilt. Somebody closes an office, somebody opens another one, somebody decides the old label was stupid—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B009 — Eventually", "source_speaker_label": "NIMERA"}},
{"beat_id": "S019_B049", "speaker_id": "nimera", "text": "Sometimes the old label was stupid.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B009 — Eventually", "source_speaker_label": "NIMERA"}},
{"beat_id": "S019_B050", "speaker_id": "maevra", "text": "Pellan.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B009 — Eventually", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S019_B051", "speaker_id": "nimera", "text": "Right. These two references shouldn't meet in an active order without somebody deliberately asking for both.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B009 — Eventually", "source_speaker_label": "NIMERA"}},
{"beat_id": "S019_B052", "speaker_id": "torren", "text": "Can you get out?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B010 — The barrier", "source_speaker_label": "TORREN"}},
{"beat_id": "S019_B053", "speaker_id": "nimera", "text": "Technically.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B010 — The barrier", "source_speaker_label": "NIMERA"}},
{"beat_id": "S019_B054", "speaker_id": "nimera", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B010 — The barrier", "source_speaker_label": "NIMERA", "staging": "Torren waits."}},
{"beat_id": "S019_B055", "speaker_id": "torren", "text": "Thought so.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B010 — The barrier", "source_speaker_label": "TORREN"}},
{"beat_id": "S019_B056", "speaker_id": "nimera", "text": "The modern lock opened. That woke this thing up, which decided the alcove was restricted.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B010 — The barrier", "source_speaker_label": "NIMERA"}},
{"beat_id": "S019_B057", "speaker_id": "cyanis", "text": "Woke up?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B010 — The barrier", "source_speaker_label": "CYANIS"}},
{"beat_id": "S019_B058", "speaker_id": "nimera", "text": "Activated. Maybe reactivated. I don't know how long it was actually dormant.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B010 — The barrier", "source_speaker_label": "NIMERA"}},
{"beat_id": "S019_B059", "speaker_id": "nimera", "text": "Do not write “still functioning after thousands of years” in a report because that's how bad archaeology reproduces.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B010 — The barrier", "source_speaker_label": "NIMERA"}},
{"beat_id": "S019_B060", "speaker_id": "cyanis", "text": "Wasn't planning to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S019_B010 — The barrier", "source_speaker_label": "CYANIS"}},
