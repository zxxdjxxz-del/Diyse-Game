scene_kind = "character_life"
location_id = "LOC_CRESTHAVEN_RECORDS_ROOM"
trigger_id = "trigger.chapter_03.h02.after_s018.at_cresthaven"
completion_flag = "scene.h02.complete"
participants = Array[String](["torren", "maevra"])
authoring_notes = "Chapter 3 exact Resource conversion from docs/chapters/dialogue/chapter_03/H02.md under Complete Master Canon v1.64 / Audit79, Chapter transcript checkpoint Audit77 plus the bounded S020→S021 Cresthaven correction. Spoken text is line-complete and must not be rewritten. Source staging/prose is preserved in cue metadata. H01/H02/H03 preserve their earlier eligibility flags but require Cresthaven location access before playback. Spoken-sequence SHA-256: 6d073736a6601ba1f11b5968128fabc0a09be6751253e29c7a71d1db76f705f6."
beats = [
{"beat_id": "H02_B001", "speaker_id": "torren", "text": "You missed it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B001", "source_speaker_label": "TORREN", "staging": "Small Cresthaven records/work room after the authority crisis. Table, two chairs, lamp, water, copied orders and custody records. Maevra is rereading the same packet. Torren appears in the doorway."}},
{"beat_id": "H02_B002", "speaker_id": "maevra", "text": "What?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B001", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B003", "speaker_id": "torren", "text": "Whatever changed since the last time you read that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B001", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B004", "speaker_id": "maevra", "text": "Nothing changed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B001", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B005", "speaker_id": "torren", "text": "Then you didn't miss it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B001", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B006", "speaker_id": "maevra", "text": "I know what it says.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B002", "source_speaker_label": "MAEVRA", "staging": "Maevra turns a page anyway."}},
{"beat_id": "H02_B007", "speaker_id": "torren", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B002", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B008", "speaker_id": "maevra", "text": "Apparently not well enough.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B002", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B009", "speaker_id": "torren", "text": "You've read it four times since I got here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B002", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B010", "speaker_id": "maevra", "text": "You've been here thirty seconds.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B002", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B011", "speaker_id": "torren", "text": "Exactly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B002", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B012", "speaker_id": "maevra", "text": "The order passed seal, witness, custody and emergency authority.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B003", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B013", "speaker_id": "torren", "text": "And still shouldn't have existed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B003", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B014", "speaker_id": "maevra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B003", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B015", "speaker_id": "torren", "text": "Reading it a fifth time won't make that less true.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B003", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B016", "speaker_id": "maevra", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B003", "source_speaker_label": "MAEVRA", "staging_after": "She reads another line."}},
{"beat_id": "H02_B017", "speaker_id": "torren", "text": "Solmar.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B004", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B018", "speaker_id": "maevra", "text": "Don't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B004", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B019", "speaker_id": "torren", "text": "Didn't say anything.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B004", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B020", "speaker_id": "maevra", "text": "You were about to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B004", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B021", "speaker_id": "torren", "text": "Was going to ask if you wanted water.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B004", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B022", "speaker_id": "maevra", "text": "That's irritating.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B004", "source_speaker_label": "MAEVRA", "staging": "Maevra looks at the untouched cup beside her."}},
{"beat_id": "H02_B023", "speaker_id": "torren", "text": "Usually is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B004", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B024", "speaker_id": "torren", "text": "Remember the weather report from Veycross?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B005", "source_speaker_label": "TORREN", "staging": "He sits without taking the papers from her."}},
{"beat_id": "H02_B025", "speaker_id": "maevra", "text": "Which one?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B005", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B026", "speaker_id": "torren", "text": "Old one. Patrol came in after three days of rain. Whole report said “weather: wet.”", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B005", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B027", "speaker_id": "maevra", "text": "That was a terrible report.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B005", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B028", "speaker_id": "torren", "text": "Accurate.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B005", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B029", "speaker_id": "maevra", "text": "Barely.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B005", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B030", "speaker_id": "torren", "text": "Still accurate.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B005", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B031", "speaker_id": "maevra", "text": "This isn't weather.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B006", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B032", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B006", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B033", "speaker_id": "maevra", "text": "If the procedure can assemble an order out of valid pieces—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B006", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B034", "speaker_id": "torren", "text": "Then you find where it broke.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B006", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B035", "speaker_id": "maevra", "text": "Before someone else gets hurt.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B006", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B036", "speaker_id": "torren", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B006", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B037", "speaker_id": "torren", "text": "Left arm.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B007", "source_speaker_label": "TORREN", "staging": "Maevra's left arm shifts; she hides the soreness by moving another document. Torren notices."}},
{"beat_id": "H02_B038", "speaker_id": "maevra", "text": "Fine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B007", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B039", "speaker_id": "torren", "text": "Shoulder too.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B007", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B040", "speaker_id": "maevra", "text": "Harth.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B007", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B041", "speaker_id": "torren", "text": "Attached to you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B007", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B042", "speaker_id": "maevra", "text": "Still is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B007", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B043", "speaker_id": "torren", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B007", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B044", "speaker_id": "maevra", "text": "I don't need you deciding when I'm done.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B008", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B045", "speaker_id": "torren", "text": "I'm not.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B008", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B046", "speaker_id": "maevra", "text": "Sounds like it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B008", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B047", "speaker_id": "torren", "text": "I'm telling you you checked the same seal four times.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B008", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B048", "speaker_id": "torren", "text": "Maevra.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B008", "source_speaker_label": "TORREN", "staging": "Beat.", "staging_after": "She stops."}},
{"beat_id": "H02_B049", "speaker_id": "maevra", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B009", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B050", "speaker_id": "torren", "text": "Good?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B009", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B051", "speaker_id": "maevra", "text": "You said it like a name.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B009", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B052", "speaker_id": "torren", "text": "It is one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B009", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B053", "speaker_id": "maevra", "text": "You know what I mean.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B009", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B054", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B009", "source_speaker_label": "TORREN", "staging_after": "He does not use it again to win the conversation."}},
{"beat_id": "H02_B055", "speaker_id": "torren", "text": "River moved once outside Bellmarsh. Map stayed right for six years because nobody wanted to redraw it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B010", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B056", "speaker_id": "maevra", "text": "The river was not wrong.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B010", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B057", "speaker_id": "torren", "text": "Exactly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B010", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B058", "speaker_id": "maevra", "text": "You're comparing Crown procedure to a moved river.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B010", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B059", "speaker_id": "torren", "text": "I'm comparing the map to the map.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B010", "source_speaker_label": "TORREN", "staging_after": "Maevra exhales, almost a laugh."}},
{"beat_id": "H02_B060", "speaker_id": "maevra", "text": "Five minutes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B011", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H02_B061", "speaker_id": "torren", "text": "Didn't ask for five.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B011", "source_speaker_label": "TORREN"}},
{"beat_id": "H02_B062", "speaker_id": "maevra", "text": "That's what you're getting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B011", "source_speaker_label": "MAEVRA", "staging_after": "She finally puts the papers down. He slides the water toward her and leaves the silence alone."}},
{"beat_id": "H02_B063", "speaker_id": "maevra", "text": "Don't disappear before morning.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B012", "source_speaker_label": "MAEVRA", "staging": "After a while, Maevra picks the packet back up, but not to reread it. She stacks it for morning."}},
{"beat_id": "H02_B064", "speaker_id": "torren", "text": "I'll be here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H02_B012", "source_speaker_label": "TORREN", "staging_after": "End."}}
]
