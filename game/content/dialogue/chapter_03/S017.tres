{"beat_id": "S017_B094", "speaker_id": "maevra", "text": "Not today.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B013 — Mirena arrives for formal review", "source_speaker_label": "MAEVRA", "staging_after": "Mirena holds out her hand."}},
