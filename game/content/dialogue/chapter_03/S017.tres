{"beat_id": "S017_B117", "speaker_id": "mirena", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B016 — Accountability", "source_speaker_label": "MIRENA"}},
