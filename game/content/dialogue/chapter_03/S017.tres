{"beat_id": "S017_B077", "speaker_id": "maevra", "text": "Same defect.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B011 — The registered original", "source_speaker_label": "MAEVRA", "staging": "The clerk returns with the registered original and ledger. Maevra checks both, longer this time."}},
