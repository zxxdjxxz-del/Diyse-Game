{"beat_id": "S017_B070", "speaker_id": "cyanis", "text": "You're not going to tell us to stop asking questions?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B010 — The officer remains competent", "source_speaker_label": "CYANIS"}},
{"beat_id": "S017_B071", "speaker_id": "crown_officer", "text": "If Commander Solmar found a defect in a custody order carrying my name, I'd prefer to know before I enforce it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B010 — The officer remains competent", "source_speaker_label": "CROWN OFFICER"}},
{"beat_id": "S017_B072", "speaker_id": "cyanis", "text": "I like him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B010 — The officer remains competent", "source_speaker_label": "CYANIS"}},
