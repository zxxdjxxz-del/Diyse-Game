beats = [
{"beat_id": "S017_B001", "speaker_id": "torren", "text": "Busy.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B001 — Caelora", "source_speaker_label": "TORREN", "staging": "Caelora is functioning. Not under siege. Not abandoned. Not sinister. The party enters through a busy southern approach: carts, Crown couriers, market traffic, soldiers changing watch, workers repairing stonework."}},
{"beat_id": "S017_B002", "speaker_id": "cyanis", "text": "Capital.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B001 — Caelora", "source_speaker_label": "CYANIS"}},
{"beat_id": "S017_B003", "speaker_id": "torren", "text": "I've seen capitals.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B001 — Caelora", "source_speaker_label": "TORREN"}},
{"beat_id": "S017_B004", "speaker_id": "cyanis", "text": "Then I'm out of explanations.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B001 — Caelora", "source_speaker_label": "CYANIS"}},
{"beat_id": "S017_B005", "speaker_id": "ilyra", "text": "You could try not explaining something.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B001 — Caelora", "source_speaker_label": "ILYRA"}},
{"beat_id": "S017_B006", "speaker_id": "cyanis", "text": "Seems extreme.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B001 — Caelora", "source_speaker_label": "CYANIS", "staging_after": "Maevra almost smiles. Then she notices the waiting officers ahead, and her expression changes."}},
{"beat_id": "S017_B007", "speaker_id": "crown_officer", "text": "Commander Solmar.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B002 — They are expected", "source_speaker_label": "CROWN OFFICER", "staging": "A Crown officer and two guards wait beside an official inspection post. No weapons raised."}},
{"beat_id": "S017_B008", "speaker_id": "maevra", "text": "Officer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B002 — They are expected", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S017_B009", "speaker_id": "crown_officer", "text": "Crest Knight Dovaren. Warden Amarin. Harth.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B002 — They are expected", "source_speaker_label": "CROWN OFFICER", "staging": "The officer looks at Cyanis, Ilyra and Torren."}},
{"beat_id": "S017_B010", "speaker_id": "torren", "text": "They knew which line to put us in.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B002 — They are expected", "source_speaker_label": "TORREN"}},
{"beat_id": "S017_B011", "speaker_id": "cyanis", "text": "Being remembered?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B002 — They are expected", "source_speaker_label": "CYANIS"}},
{"beat_id": "S017_B012", "speaker_id": "torren", "text": "Being expected.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B002 — They are expected", "source_speaker_label": "TORREN"}},
{"beat_id": "S017_B013", "speaker_id": "maevra", "text": "He's right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B002 — They are expected", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S017_B014", "speaker_id": "crown_officer", "text": "By custodial authority, the recovered Card and all persons directly involved in its transport are to remain within Crown supervision pending review.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B003 — The order", "source_speaker_label": "CROWN OFFICER", "staging": "The officer produces a sealed physical writ: wax, stamped authority, witnessed copy. Maevra takes it and reads."}},
{"beat_id": "S017_B015", "speaker_id": "cyanis", "text": "Remain where?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B003 — The order", "source_speaker_label": "CYANIS"}},
{"beat_id": "S017_B016", "speaker_id": "crown_officer", "text": "Caelora.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B003 — The order", "source_speaker_label": "CROWN OFFICER"}},
{"beat_id": "S017_B017", "speaker_id": "cyanis", "text": "That's a large answer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B003 — The order", "source_speaker_label": "CYANIS"}},
{"beat_id": "S017_B018", "speaker_id": "maevra", "text": "Dovaren.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B003 — The order", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S017_B019", "speaker_id": "cyanis", "text": "It is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B003 — The order", "source_speaker_label": "CYANIS"}},
{"beat_id": "S017_B020", "speaker_id": "crown_officer", "text": "Your movements inside the authorized district are not restricted beyond listed secure areas.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B003 — The order", "source_speaker_label": "CROWN OFFICER"}},
{"beat_id": "S017_B021", "speaker_id": "ilyra", "text": "And leaving the city?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B003 — The order", "source_speaker_label": "ILYRA"}},
{"beat_id": "S017_B022", "speaker_id": "crown_officer", "text": "Restricted pending review.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B003 — The order", "source_speaker_label": "CROWN OFFICER"}},
{"beat_id": "S017_B023", "speaker_id": "ilyra", "text": "Are we under arrest?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B004 — Containment, not arrest", "source_speaker_label": "ILYRA"}},
{"beat_id": "S017_B024", "speaker_id": "crown_officer", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B004 — Containment, not arrest", "source_speaker_label": "CROWN OFFICER"}},
{"beat_id": "S017_B025", "speaker_id": "ilyra", "text": "Detained?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B004 — Containment, not arrest", "source_speaker_label": "ILYRA"}},
{"beat_id": "S017_B026", "speaker_id": "crown_officer", "text": "Contained under custodial authority.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B004 — Containment, not arrest", "source_speaker_label": "CROWN OFFICER", "staging": "A slight pause."}},
{"beat_id": "S017_B027", "speaker_id": "torren", "text": "That's a prettier word.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B004 — Containment, not arrest", "source_speaker_label": "TORREN"}},
{"beat_id": "S017_B028", "speaker_id": "torren", "text": "Still asking.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B004 — Containment, not arrest", "source_speaker_label": "TORREN", "staging": "The officer looks at him."}},
{"beat_id": "S017_B029", "speaker_id": "ilyra", "text": "Medical access?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B005 — Ilyra tests the restrictions", "source_speaker_label": "ILYRA"}},
{"beat_id": "S017_B030", "speaker_id": "crown_officer", "text": "Unrestricted.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B005 — Ilyra tests the restrictions", "source_speaker_label": "CROWN OFFICER"}},
{"beat_id": "S017_B031", "speaker_id": "ilyra", "text": "Private treatment?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B005 — Ilyra tests the restrictions", "source_speaker_label": "ILYRA"}},
{"beat_id": "S017_B032", "speaker_id": "crown_officer", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B005 — Ilyra tests the restrictions", "source_speaker_label": "CROWN OFFICER"}},
{"beat_id": "S017_B033", "speaker_id": "ilyra", "text": "Personal correspondence?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B005 — Ilyra tests the restrictions", "source_speaker_label": "ILYRA"}},
{"beat_id": "S017_B034", "speaker_id": "crown_officer", "text": "Not restricted by this order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B005 — Ilyra tests the restrictions", "source_speaker_label": "CROWN OFFICER"}},
{"beat_id": "S017_B035", "speaker_id": "ilyra", "text": "Weapons?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B005 — Ilyra tests the restrictions", "source_speaker_label": "ILYRA"}},
{"beat_id": "S017_B036", "speaker_id": "crown_officer", "text": "Peace-bound only in the palace district. Standard city law.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B005 — Ilyra tests the restrictions", "source_speaker_label": "CROWN OFFICER"}},
{"beat_id": "S017_B037", "speaker_id": "ilyra", "text": "So this isn't punitive custody.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B005 — Ilyra tests the restrictions", "source_speaker_label": "ILYRA", "staging": "Ilyra nods. Those are real answers."}},
{"beat_id": "S017_B038", "speaker_id": "crown_officer", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B005 — Ilyra tests the restrictions", "source_speaker_label": "CROWN OFFICER"}},
{"beat_id": "S017_B039", "speaker_id": "ilyra", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B005 — Ilyra tests the restrictions", "source_speaker_label": "ILYRA"}},
{"beat_id": "S017_B040", "speaker_id": "cyanis", "text": "What happens if we leave anyway?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B006 — Cyanis asks what refusal means", "source_speaker_label": "CYANIS"}},
{"beat_id": "S017_B041", "speaker_id": "crown_officer", "text": "The containment becomes defiance of lawful Crown custody.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B006 — Cyanis asks what refusal means", "source_speaker_label": "CROWN OFFICER"}},
{"beat_id": "S017_B042", "speaker_id": "cyanis", "text": "And then?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B006 — Cyanis asks what refusal means", "source_speaker_label": "CYANIS"}},
{"beat_id": "S017_B043", "speaker_id": "crown_officer", "text": "Then you may be arrested.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B006 — Cyanis asks what refusal means", "source_speaker_label": "CROWN OFFICER"}},
{"beat_id": "S017_B044", "speaker_id": "cyanis", "text": "There it is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B006 — Cyanis asks what refusal means", "source_speaker_label": "CYANIS"}},
{"beat_id": "S017_B045", "speaker_id": "maevra", "text": "You asked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B006 — Cyanis asks what refusal means", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S017_B046", "speaker_id": "cyanis", "text": "I did.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B006 — Cyanis asks what refusal means", "source_speaker_label": "CYANIS", "staging_after": "No attempt to leave. No dramatic refusal."}},
{"beat_id": "S017_B047", "speaker_id": "crown_officer", "text": "The recovered Card remains sealed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B007 — The Card", "source_speaker_label": "CROWN OFFICER", "staging": "The officer indicates the secured transport case."}},
{"beat_id": "S017_B048", "speaker_id": "cyanis", "text": "Has anyone opened the case?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B007 — The Card", "source_speaker_label": "CYANIS"}},
{"beat_id": "S017_B049", "speaker_id": "crown_officer", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B007 — The Card", "source_speaker_label": "CROWN OFFICER"}},
{"beat_id": "S017_B050", "speaker_id": "maevra", "text": "Transferred custody?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B007 — The Card", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S017_B051", "speaker_id": "crown_officer", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B007 — The Card", "source_speaker_label": "CROWN OFFICER"}},
{"beat_id": "S017_B052", "speaker_id": "maevra", "text": "Examined it directly?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B007 — The Card", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S017_B053", "speaker_id": "crown_officer", "text": "Only external seal verification.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B007 — The Card", "source_speaker_label": "CROWN OFFICER"}},
{"beat_id": "S017_B054", "speaker_id": "maevra", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B007 — The Card", "source_speaker_label": "MAEVRA", "staging_after": "Cyanis looks at the case. No response. No Ruby. No Might identification. Nothing supernatural happens."}},
{"beat_id": "S017_B055", "speaker_id": "maevra", "text": "Under whose authority?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B008 — Maevra finds the problem", "source_speaker_label": "MAEVRA", "staging": "Maevra reads the order again, then turns back to the beginning."}},
{"beat_id": "S017_B056", "speaker_id": "crown_officer", "text": "The order came through Judicial Authority.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B008 — Maevra finds the problem", "source_speaker_label": "CROWN OFFICER"}},
{"beat_id": "S017_B057", "speaker_id": "maevra", "text": "I can read. Who initiated it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B008 — Maevra finds the problem", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S017_B058", "speaker_id": "maevra", "text": "Custodial chain is authenticated. Witnesses are valid. Seal is valid. Transfer language is valid.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B008 — Maevra finds the problem", "source_speaker_label": "MAEVRA", "staging": "The officer looks back down at the document."}},
{"beat_id": "S017_B059", "speaker_id": "maevra", "text": "There should be something before this.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B008 — Maevra finds the problem", "source_speaker_label": "MAEVRA", "staging": "She taps the first section."}},
{"beat_id": "S017_B060", "speaker_id": "crown_officer", "text": "No, Commander. It wasn't included in the copy.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B008 — Maevra finds the problem", "source_speaker_label": "CROWN OFFICER"}},
{"beat_id": "S017_B061", "speaker_id": "maevra", "text": "Then get me the original.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B008 — Maevra finds the problem", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S017_B062", "speaker_id": "crown_officer", "text": "Pull the registered original.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B009 — The missing declaration", "source_speaker_label": "CROWN OFFICER", "staging": "The officer signals a clerk."}},
{"beat_id": "S017_B063", "speaker_id": "clerk", "text": "Yes, sir.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B009 — The missing declaration", "source_speaker_label": "CLERK"}},
