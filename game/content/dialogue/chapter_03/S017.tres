{"beat_id": "S017_B108", "speaker_id": "cyanis", "text": "I was thinking about it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B015 — Mirena does not simply void everything", "source_speaker_label": "CYANIS", "staging": "Mirena looks at him."}},
