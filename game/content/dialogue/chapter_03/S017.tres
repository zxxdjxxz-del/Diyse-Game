{"beat_id": "S017_B105", "speaker_id": "maevra", "text": "Authenticated.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B015 — Mirena does not simply void everything", "source_speaker_label": "MAEVRA"}},
