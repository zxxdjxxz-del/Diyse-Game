{"beat_id": "S017_B081", "speaker_id": "maevra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B011 — The registered original", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S017_B082", "speaker_id": "cyanis", "text": "Can an order exist without whoever ordered it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B011 — The registered original", "source_speaker_label": "CYANIS"}},
