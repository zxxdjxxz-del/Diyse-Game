{"beat_id": "S017_B101", "speaker_id": "cyanis", "text": "I suspected.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B014 — Mirena reads it", "source_speaker_label": "CYANIS"}},
