{"beat_id": "S017_B113", "speaker_id": "mirena", "text": "No seizure of the Card.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B016 — Accountability", "source_speaker_label": "MIRENA"}},
{"beat_id": "S017_B114", "speaker_id": "crown_officer", "text": "Understood.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B016 — Accountability", "source_speaker_label": "CROWN OFFICER"}},
{"beat_id": "S017_B115", "speaker_id": "mirena", "text": "And nobody decides these people are fugitives because they asked why they're being contained.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S017_B016 — Accountability", "source_speaker_label": "MIRENA"}},
