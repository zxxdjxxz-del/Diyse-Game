authoring_notes = "Audit75 CLOSED-AUTHORITY IMPLEMENTATION SHELL for H04 Last Sentinel Is Not Invited. Full former line payload is not serialized. Preserve static Ruby Card-in-case dinner problem, chair gag, Cyanis accidentally treating the Card as 'he', Nimera self-correcting possessive/intent language, Ilyra moving the Card because someone needs the chair, and the controlling final Nimera line. No manifestation, autonomous motion, voice, glow behavior, personality, or test activation."
beats = [{"beat_id":"H04_B001","cues":{"staging":"After S021 only. Ordinary Cresthaven dinner setup. Last Sentinel remains physically present inside its protected case as a static Ruby object. It does not move, speak, react, glow autonomously, choose, want, or manifest."}},
{"beat_id":"H04_B002","cues":{"staging":"The practical problem is seating/table placement, not Prime lore. Someone has used a chair/table position for the protected case."}},
{"beat_id":"H04_B003","speaker_id":"torren","text":"Last Sentinel is not invited to dinner."},
{"beat_id":"H04_B004","cues":{"staging":"The group agrees through short ordinary reactions. Keep the joke on the inconvenience of the object occupying social space, not on the Card having a personality."}},
{"beat_id":"H04_B005","cues":{"staging":"Cyanis accidentally uses 'he' while talking about where the Card/case is being put. Do not invent a new exact line for the shell; preserve the grammatical slip as the beat."}},
{"beat_id":"H04_B006","cues":{"staging":"Nimera catches the anthropomorphism, then later catches herself using language that implies the Card can 'want' something. She self-corrects. No autonomous behavior is shown or implied as fact."}},
{"beat_id":"H04_B007","cues":{"staging":"Ilyra physically relocates the protected case for the simplest reason: somebody needs the chair. Use one generic prop handoff/move and portraits; no bespoke Prime animation."}},
{"beat_id":"H04_B008","cues":{"staging":"Maevra may be present only if her post-S021 logistics make sense. She remains a guest/recurring ally, never a permanent party member."}},
{"beat_id":"H04_B009","speaker_id":"nimera","text":"He's sleeping in the fucking Archive."},
{"beat_id":"H04_B010","cues":{"staging":"Cyanis immediately catches that Nimera just did the same anthropomorphizing she was policing. End on the joke. Last Sentinel remains Ruby, inert, and unmanifested."}}]
