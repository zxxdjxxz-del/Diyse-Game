beats = [
{"beat_id": "H04_B001", "speaker_id": "torren", "text": "Move it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B001", "source_speaker_label": "TORREN", "staging": "Cresthaven Common room at dinner. A protected case containing the static Ruby Last Sentinel Card occupies one chair beside the table because no one has decided where the case should go during meal setup. Maevra is present in the hub and joins late enough to be logistically valid."}},
{"beat_id": "H04_B002", "speaker_id": "nimera", "text": "Where?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B001", "source_speaker_label": "NIMERA"}},
{"beat_id": "H04_B003", "speaker_id": "torren", "text": "Not the chair.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B001", "source_speaker_label": "TORREN"}},
{"beat_id": "H04_B004", "speaker_id": "cyanis", "text": "He isn't eating.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B001", "source_speaker_label": "CYANIS"}},
{"beat_id": "H04_B005", "speaker_id": "cyanis", "text": "It. It isn't eating.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B001", "source_speaker_label": "CYANIS", "staging": "Everyone looks at Cyanis."}},
{"beat_id": "H04_B006", "speaker_id": "nimera", "text": "Good recovery.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B001", "source_speaker_label": "NIMERA"}},
{"beat_id": "H04_B007", "speaker_id": "cyanis", "text": "Thank you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B001", "source_speaker_label": "CYANIS"}},
{"beat_id": "H04_B008", "speaker_id": "ilyra", "text": "Someone needs the chair.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B002", "source_speaker_label": "ILYRA"}},
{"beat_id": "H04_B009", "speaker_id": "nimera", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B002", "source_speaker_label": "NIMERA"}},
{"beat_id": "H04_B010", "speaker_id": "ilyra", "text": "Then move the case.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B002", "source_speaker_label": "ILYRA"}},
{"beat_id": "H04_B011", "speaker_id": "nimera", "text": "I'm deciding where it wants—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B002", "source_speaker_label": "NIMERA"}},
{"beat_id": "H04_B012", "speaker_id": "nimera", "text": "Where it should go. If “want” applies at all, which it does not, because I am not doing this.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B002", "source_speaker_label": "NIMERA", "staging": "Nimera stops herself."}},
{"beat_id": "H04_B013", "speaker_id": "cyanis", "text": "Doing what?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B002", "source_speaker_label": "CYANIS"}},
{"beat_id": "H04_B014", "speaker_id": "nimera", "text": "What you just did.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B002", "source_speaker_label": "NIMERA"}},
{"beat_id": "H04_B015", "speaker_id": "cyanis", "text": "I corrected myself.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B002", "source_speaker_label": "CYANIS"}},
{"beat_id": "H04_B016", "speaker_id": "nimera", "text": "So did I.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B002", "source_speaker_label": "NIMERA"}},
{"beat_id": "H04_B017", "speaker_id": "torren", "text": "Archive.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B003", "source_speaker_label": "TORREN"}},
{"beat_id": "H04_B018", "speaker_id": "nimera", "text": "We're eating.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B003", "source_speaker_label": "NIMERA"}},
{"beat_id": "H04_B019", "speaker_id": "torren", "text": "Card isn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B003", "source_speaker_label": "TORREN"}},
{"beat_id": "H04_B020", "speaker_id": "cyanis", "text": "He—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B003", "source_speaker_label": "CYANIS"}},
{"beat_id": "H04_B021", "speaker_id": "ilyra", "text": "Remarkable progress.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B003", "source_speaker_label": "ILYRA", "staging": "Cyanis closes his mouth."}},
{"beat_id": "H04_B022", "speaker_id": "cyanis", "text": "This table is hostile.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B003", "source_speaker_label": "CYANIS"}},
{"beat_id": "H04_B023", "speaker_id": "nimera", "text": "I was going to do that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B004", "source_speaker_label": "NIMERA", "staging": "Ilyra simply stands, lifts the protected case using the approved handling grips, and moves it onto a side cabinet within sight but off the chair."}},
{"beat_id": "H04_B024", "speaker_id": "ilyra", "text": "You were going to explain why you hadn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B004", "source_speaker_label": "ILYRA"}},
{"beat_id": "H04_B025", "speaker_id": "nimera", "text": "Also useful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B004", "source_speaker_label": "NIMERA"}},
{"beat_id": "H04_B026", "speaker_id": "maevra", "text": "Chair's free.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B004", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H04_B027", "speaker_id": "torren", "text": "Excellent operation.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B004", "source_speaker_label": "TORREN"}},
{"beat_id": "H04_B028", "speaker_id": "cyanis", "text": "So Last Sentinel is not invited to dinner.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B005", "source_speaker_label": "CYANIS", "staging": "They eat. The Card does nothing. No glow change, no response, no lore dump."}},
{"beat_id": "H04_B029", "speaker_id": "nimera", "text": "Correct.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B005", "source_speaker_label": "NIMERA"}},
{"beat_id": "H04_B030", "speaker_id": "torren", "text": "Wasn't invited before.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B005", "source_speaker_label": "TORREN"}},
{"beat_id": "H04_B031", "speaker_id": "nimera", "text": "It didn't have a name before.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B005", "source_speaker_label": "NIMERA"}},
{"beat_id": "H04_B032", "speaker_id": "ilyra", "text": "Neither did the chair.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B005", "source_speaker_label": "ILYRA"}},
{"beat_id": "H04_B033", "speaker_id": "nimera", "text": "The chair still doesn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B005", "source_speaker_label": "NIMERA"}},
{"beat_id": "H04_B034", "speaker_id": "cyanis", "text": "Give it time.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B005", "source_speaker_label": "CYANIS"}},
{"beat_id": "H04_B035", "speaker_id": "maevra", "text": "What happens to the case tonight?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B006", "source_speaker_label": "MAEVRA"}},
{"beat_id": "H04_B036", "speaker_id": "nimera", "text": "Archive lock, second cabinet, two seals, documented custody.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B006", "source_speaker_label": "NIMERA"}},
{"beat_id": "H04_B037", "speaker_id": "torren", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B006", "source_speaker_label": "TORREN"}},
{"beat_id": "H04_B038", "speaker_id": "cyanis", "text": "Where's he sleeping?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B006", "source_speaker_label": "CYANIS"}},
{"beat_id": "H04_B039", "speaker_id": "nimera", "text": "Oh, fuck you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B006", "source_speaker_label": "NIMERA", "staging": "Nimera glares at him because he has caught her with the same anthropomorphizing problem."}},
{"beat_id": "H04_B040", "speaker_id": "nimera", "text": "He's sleeping in the fucking Archive.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "H04_B006", "source_speaker_label": "NIMERA", "staging": "Beat.", "staging_after": "Cyanis smiles. Nimera realizes what she just did. Cut before she can repair it. End."}}
]
