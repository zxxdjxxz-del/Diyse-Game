{"beat_id": "S020_B065", "speaker_id": "torren", "text": "Useful?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B013 — Torren's review", "source_speaker_label": "TORREN"}},
