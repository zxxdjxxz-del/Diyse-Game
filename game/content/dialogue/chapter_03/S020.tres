{"beat_id": "S020_B112", "speaker_id": "nimera", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B024 — Command Ring", "source_speaker_label": "NIMERA"}},
