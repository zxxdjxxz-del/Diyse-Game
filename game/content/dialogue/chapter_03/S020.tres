beats = [
{"beat_id": "S020_B001", "speaker_id": "nimera", "text": "Yeah. No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B001 — This is not an archive anymore", "source_speaker_label": "NIMERA", "staging": "The route opens into wide fitted corridors, recessed doors, mechanical tracks, circular wall/floor plates, and machinery integrated directly into structure. Cleaner, more intact, more coordinated."}},
{"beat_id": "S020_B002", "speaker_id": "cyanis", "text": "Useful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B001 — This is not an archive anymore", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B003", "speaker_id": "nimera", "text": "I'm serious. This isn't archival.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B001 — This is not an archive anymore", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B004", "speaker_id": "maevra", "text": "Command?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B001 — This is not an archive anymore", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S020_B005", "speaker_id": "nimera", "text": "Something in that family.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B001 — This is not an archive anymore", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B006", "speaker_id": "torren", "text": "Large family?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B001 — This is not an archive anymore", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B007", "speaker_id": "nimera", "text": "Unfortunately.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B001 — This is not an archive anymore", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B008", "speaker_id": "nimera", "text": "Don't touch anything yet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B002 — First gate", "source_speaker_label": "NIMERA", "staging": "A broad door blocks the route. Its interface has several physical rings with repeating functional symbols."}},
{"beat_id": "S020_B009", "speaker_id": "cyanis", "text": "Wasn't going to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B002 — First gate", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B010", "speaker_id": "nimera", "text": "You say that like I haven't known you for an hour.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B002 — First gate", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B011", "speaker_id": "cyanis", "text": "And already you think the worst of me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B002 — First gate", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B012", "speaker_id": "nimera", "text": "Not the worst. Give me time.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B002 — First gate", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B013", "speaker_id": "ilyra", "text": "What's it doing?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B003 — It is asking a question", "source_speaker_label": "ILYRA", "staging": "One ring rotates and stops beside several symbols."}},
{"beat_id": "S020_B014", "speaker_id": "nimera", "text": "Asking.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B003 — It is asking a question", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B015", "speaker_id": "torren", "text": "In what language?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B003 — It is asking a question", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B016", "speaker_id": "nimera", "text": "Not language exactly. Function. Storage. Transit. Maintenance.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B003 — It is asking a question", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B017", "speaker_id": "nimera", "text": "Authority.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B003 — It is asking a question", "source_speaker_label": "NIMERA", "staging": "Another symbol."}},
{"beat_id": "S020_B018", "speaker_id": "cyanis", "text": "Of course.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B003 — It is asking a question", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B019", "speaker_id": "maevra", "text": "Can it understand why we're here?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B004 — Claim and route", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S020_B020", "speaker_id": "nimera", "text": "Not “we're investigating a falsified Crown order,” no. But I can tell it we're following a record into command authority.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B004 — Claim and route", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B021", "speaker_id": "maevra", "text": "Do it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B004 — Claim and route", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S020_B022", "speaker_id": "torren", "text": "Said no.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B004 — Claim and route", "source_speaker_label": "TORREN", "staging": "Nimera adjusts the outer ring. The door stays shut; a different corridor opens to the right."}},
{"beat_id": "S020_B023", "speaker_id": "nimera", "text": "No. It answered.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B004 — Claim and route", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B024", "speaker_id": "cyanis", "text": "Difference?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B005 — Redirection", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B025", "speaker_id": "nimera", "text": "A refusal stops us. This redirected us.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B005 — Redirection", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B026", "speaker_id": "ilyra", "text": "Based on what we told it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B005 — Redirection", "source_speaker_label": "ILYRA"}},
{"beat_id": "S020_B027", "speaker_id": "nimera", "text": "Based on what it thinks that claim is allowed to access.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B005 — Redirection", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B028", "speaker_id": "cyanis", "text": "That's worse.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B005 — Redirection", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B029", "speaker_id": "nimera", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B005 — Redirection", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B030", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "Exploration resumes. Command-Station Sentries reposition as gates change. Authority Lenses scan the active group. Command Ring Drones support other machines. Route changes use authored prepared states.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "S020_B006 — Command-route gameplay"}},
{"beat_id": "S020_B031", "speaker_id": "torren", "text": "Don't like that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B007 — After first command encounter", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B032", "speaker_id": "nimera", "text": "Which part?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B007 — After first command encounter", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B033", "speaker_id": "torren", "text": "Place deciding where I walk.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B007 — After first command encounter", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B034", "speaker_id": "nimera", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B007 — After first command encounter", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B035", "speaker_id": "nimera", "text": "Not good that it's happening. Good that you're bothered.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B007 — After first command encounter", "source_speaker_label": "NIMERA", "staging": "Torren looks at her."}},
{"beat_id": "S020_B036", "speaker_id": "torren", "text": "Glad I passed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B007 — After first command encounter", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B037", "speaker_id": "ilyra", "text": "Does it know we're here?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B008 — No broad AI claim", "source_speaker_label": "ILYRA"}},
{"beat_id": "S020_B038", "speaker_id": "nimera", "text": "It detects us.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B008 — No broad AI claim", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B039", "speaker_id": "ilyra", "text": "That's not what I asked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B008 — No broad AI claim", "source_speaker_label": "ILYRA"}},
{"beat_id": "S020_B040", "speaker_id": "nimera", "text": "I know. I don't have evidence for anything beyond detection, classification and response.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B008 — No broad AI claim", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B041", "speaker_id": "cyanis", "text": "So we're not calling it alive.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B008 — No broad AI claim", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B042", "speaker_id": "nimera", "text": "We are absolutely not fucking calling it alive.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B008 — No broad AI claim", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B043", "speaker_id": "maevra", "text": "Our record goes left.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B009 — Wrong route, current route", "source_speaker_label": "MAEVRA", "staging": "The record path points left. The active command interface redirects right."}},
{"beat_id": "S020_B044", "speaker_id": "nimera", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B009 — Wrong route, current route", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B045", "speaker_id": "cyanis", "text": "And it wants us right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B009 — Wrong route, current route", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B046", "speaker_id": "nimera", "text": "Also yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B009 — Wrong route, current route", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B047", "speaker_id": "torren", "text": "Which one?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B009 — Wrong route, current route", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B048", "speaker_id": "nimera", "text": "I hate how often you're all asking me that today.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B009 — Wrong route, current route", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B049", "speaker_id": "maevra", "text": "Pellan.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B010 — Bounded answer", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S020_B050", "speaker_id": "nimera", "text": "Right. The archive record says the request entered command review through the left branch. Current system says our claim belongs right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B010 — Bounded answer", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B051", "speaker_id": "cyanis", "text": "Current system wins?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B010 — Bounded answer", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B052", "speaker_id": "nimera", "text": "For the next fifty feet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B010 — Bounded answer", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B053", "speaker_id": "cyanis", "text": "Strong endorsement.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B010 — Bounded answer", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B054", "speaker_id": "nimera", "text": "Wait.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B011 — Protected repository", "source_speaker_label": "NIMERA", "staging": "The right-hand route ends at a compact repository chamber. A secured Ancient storage cabinet has opened because of route state."}},
{"beat_id": "S020_B055", "speaker_id": "maevra", "text": "What?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B011 — Protected repository", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S020_B056", "speaker_id": "nimera", "text": "Card storage.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B011 — Protected repository", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B057", "speaker_id": "nimera", "text": "Different Card.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B011 — Protected repository", "source_speaker_label": "NIMERA", "staging": "Cyanis looks toward the sealed mystery case."}},
{"beat_id": "S020_B058", "speaker_id": "cyanis", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B011 — Protected repository", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B059", "speaker_id": "nimera", "text": "Why did you say that like you're disappointed?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B011 — Protected repository", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B060", "speaker_id": "cyanis", "text": "I'm not.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B011 — Protected repository", "source_speaker_label": "CYANIS"}},
