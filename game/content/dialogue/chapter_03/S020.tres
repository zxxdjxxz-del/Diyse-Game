{"beat_id": "S020_B090", "speaker_id": "torren", "text": "Not you. Usually.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B018 — After preview", "source_speaker_label": "TORREN", "staging": "Maevra looks at him."}},
