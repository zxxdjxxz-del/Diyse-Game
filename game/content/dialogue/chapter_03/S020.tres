{"beat_id": "S020_B072", "speaker_id": "nimera", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B014 — Back to the request", "source_speaker_label": "NIMERA", "staging_after": "Glassform goes into normal Card inventory handling. No boss provenance is implied."}},
{"beat_id": "S020_B073", "speaker_id": "torren", "text": "That's new.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B015 — Individual assessment", "source_speaker_label": "TORREN", "staging": "A larger interface scans the active formation. Four separate indicators appear, one per active combatant."}},
{"beat_id": "S020_B074", "speaker_id": "nimera", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B015 — Individual assessment", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B075", "speaker_id": "cyanis", "text": "Good new?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B015 — Individual assessment", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B076", "speaker_id": "nimera", "text": "Have you noticed how rarely I get to say yes to that?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B015 — Individual assessment", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B077", "speaker_id": "ilyra", "text": "It's separating us.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B016 — Conditions", "source_speaker_label": "ILYRA", "staging": "Indicators change over individuals; two route mechanisms shift."}},
{"beat_id": "S020_B078", "speaker_id": "maevra", "text": "Don't let it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B016 — Conditions", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S020_B079", "speaker_id": "nimera", "text": "Wait.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B016 — Conditions", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B080", "speaker_id": "maevra", "text": "For what?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B016 — Conditions", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S020_B081", "speaker_id": "nimera", "text": "It's not assigning destinations. It's assigning conditions.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B016 — Conditions", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B082", "speaker_id": "cyanis", "text": "Conditions for what?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B017 — Preview Command Seals", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B083", "speaker_id": "nimera", "text": "I think we're about to find out.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "AUTHORED_ENCOUNTER_HANDOFF"], "source_section": "S020_B017 — Preview Command Seals", "source_speaker_label": "NIMERA", "staging": "The gate opens and Sentries activate.", "staging_after": "**AUTHORED COMMAND-PRESSURE ENCOUNTER. Target-specific pressure; no command menu deletion.**"}},
{"beat_id": "S020_B084", "speaker_id": "nimera", "text": "Restrictions.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B018 — After preview", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B085", "speaker_id": "cyanis", "text": "On us?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B018 — After preview", "source_speaker_label": "CYANIS"}},
