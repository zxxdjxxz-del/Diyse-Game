{"beat_id": "S020_B121", "speaker_id": "ilyra", "text": "Not what we're preparing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B026 — What it records", "source_speaker_label": "ILYRA"}},
{"beat_id": "S020_B122", "speaker_id": "nimera", "text": "Right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B026 — What it records", "source_speaker_label": "NIMERA", "staging_after": "The Warden never copies Cards, Primes, Ultimates, or character-unique commands."}},
{"beat_id": "S020_B123", "speaker_id": "cyanis", "text": "Changed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "WARDEN_SAME_BAR_STATE_CHANGE"], "source_section": "S020_B027 — Threshold", "source_speaker_label": "CYANIS", "staging": "At the authored HP threshold there is no refill. Outer command assemblies retract, several Seal projectors shut down, and the suspended Ring rotates into defensive alignment."}},
{"beat_id": "S020_B124", "speaker_id": "nimera", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "WARDEN_SAME_BAR_STATE_CHANGE"], "source_section": "S020_B027 — Threshold", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B125", "speaker_id": "torren", "text": "Better?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "WARDEN_SAME_BAR_STATE_CHANGE"], "source_section": "S020_B027 — Threshold", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B126", "speaker_id": "nimera", "text": "Why do you keep asking me that?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "WARDEN_SAME_BAR_STATE_CHANGE"], "source_section": "S020_B027 — Threshold", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B127", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "Fewer restrictions; heavier direct offense and protection. Earlier handling of Command Seals/Ring pressure affects the opening strength of this state. Same machine, same HP bar.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "S020_B028 — State B: challenged authority"}},
{"beat_id": "S020_B128", "speaker_id": "cyanis", "text": "Finish it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B029 — Final stretch", "source_speaker_label": "CYANIS", "staging_after": "No speeches. The player wins through normal battle rules."}},
{"beat_id": "S020_B129", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "At zero HP, weapon systems shut down. The Warden does not explode. It catches against the command structure, then lowers into dormant support posture. The suspended ring slows and locks.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "S020_B030 — Defeat"}},
{"beat_id": "S020_B130", "speaker_id": "torren", "text": "Dead?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B031 — Immediate aftermath", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B131", "speaker_id": "nimera", "text": "Wrong word.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B031 — Immediate aftermath", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B132", "speaker_id": "torren", "text": "Off?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B031 — Immediate aftermath", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B133", "speaker_id": "nimera", "text": "Better.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B031 — Immediate aftermath", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B134", "speaker_id": "maevra", "text": "Don't touch it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B031 — Immediate aftermath", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S020_B135", "speaker_id": "nimera", "text": "Wasn't—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B031 — Immediate aftermath", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B136", "speaker_id": "nimera", "text": "Fine. Fair.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B031 — Immediate aftermath", "source_speaker_label": "NIMERA", "staging": "Nimera stops and looks at Maevra."}},
{"beat_id": "S020_B137", "speaker_id": "", "text": "", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 120, "staging": "Across the chamber, indicators change state. Doors previously denied unlock; route markers settle; adjudication paths elsewhere silently receive changed authorization state. The player does not revisit them now.", "interrupt": false, "implementation_flags": ["SOURCE_STAGING"], "source_section": "S020_B032 — Command state clears"}},
{"beat_id": "S020_B138", "speaker_id": "cyanis", "text": "That's new.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "LAST_SENTINEL_EXACT_MACHINE_OUTPUT"], "source_section": "S020_B033 — Exact output", "source_speaker_label": "CYANIS", "staging": "One central Ancient display activates.\n\n**/PREVIOUS ERROR/**\n\nA pause.\n\n**/LAST SENTINEL CONFIRMED/**"}},
{"beat_id": "S020_B139", "speaker_id": "nimera", "text": "Very.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B033 — Exact output", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B140", "speaker_id": "maevra", "text": "Meaning?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B033 — Exact output", "source_speaker_label": "MAEVRA", "staging_after": "Nimera does not answer yet."}},
{"beat_id": "S020_B141", "speaker_id": "torren", "text": "Pellan.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B034 — Meaning remains unearned", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B142", "speaker_id": "nimera", "text": "I don't know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B034 — Meaning remains unearned", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B143", "speaker_id": "nimera", "text": "I've seen “sentinel” used as a function. I have not seen Last Sentinel used like that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B034 — Meaning remains unearned", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B144", "speaker_id": "cyanis", "text": "And “previous error”?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B034 — Meaning remains unearned", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B145", "speaker_id": "nimera", "text": "Also don't know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B034 — Meaning remains unearned", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B146", "speaker_id": "cyanis", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B034 — Meaning remains unearned", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B147", "speaker_id": "nimera", "text": "Good?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B034 — Meaning remains unearned", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B148", "speaker_id": "cyanis", "text": "You're not making something up.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B034 — Meaning remains unearned", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B149", "speaker_id": "nimera", "text": "That is an alarmingly low standard for scholarship.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B034 — Meaning remains unearned", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B150", "speaker_id": "maevra", "text": "Nobody touch it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B035 — Then the recovered Card reacts", "source_speaker_label": "MAEVRA", "staging": "Only now does the sealed recovered Card respond. Earlier incomplete green/gold geometry appears briefly, then collapses inward. Color resolves into a stable deep Ruby response."}},
{"beat_id": "S020_B151", "speaker_id": "cyanis", "text": "Same response.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B035 — Then the recovered Card reacts", "source_speaker_label": "CYANIS", "staging_after": "It changes and becomes unmistakably Ruby."}},
{"beat_id": "S020_B152", "speaker_id": "nimera", "text": "That's—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B036 — Do not identify it here", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B153", "speaker_id": "cyanis", "text": "What?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B036 — Do not identify it here", "source_speaker_label": "CYANIS", "staging": "She stops herself."}},
{"beat_id": "S020_B154", "speaker_id": "nimera", "text": "Different. That's all I'm saying until I have something to compare it against.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B036 — Do not identify it here", "source_speaker_label": "NIMERA", "staging_after": "No one says “Might.” No one identifies a Prime. No one calls the Card Last Sentinel here."}},
{"beat_id": "S020_B155", "speaker_id": "ilyra", "text": "Anything?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B037 — No manifestation", "source_speaker_label": "ILYRA"}},
{"beat_id": "S020_B156", "speaker_id": "cyanis", "text": "No voice. No feeling. Nothing. It's just doing that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B037 — No manifestation", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B157", "speaker_id": "ilyra", "text": "All right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B037 — No manifestation", "source_speaker_label": "ILYRA", "staging_after": "No figure, silhouette, autonomous motion, attack, or Prime manifestation."}},
