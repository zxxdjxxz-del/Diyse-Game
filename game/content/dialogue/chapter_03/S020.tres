{"beat_id": "S020_B100", "speaker_id": "nimera", "text": "It's checking authorization.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B021 — It evaluates", "source_speaker_label": "NIMERA", "staging": "The Warden scans the group. It does not speak. Symbols resolve around its command apparatus."}},
{"beat_id": "S020_B101", "speaker_id": "cyanis", "text": "And?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B021 — It evaluates", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B102", "speaker_id": "nimera", "text": "Apparently we remain disappointing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B021 — It evaluates", "source_speaker_label": "NIMERA", "staging": "The ring locks; weapons/emitters deploy."}},
