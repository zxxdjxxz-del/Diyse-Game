{"beat_id": "S020_B172", "speaker_id": "nimera", "text": "That wasn't open before.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "POST_WARDEN_COMMAND_RECORD_ROOM"], "source_section": "S020_B040 — The room behind the Warden", "source_speaker_label": "NIMERA", "staging": "With the Warden dormant and the command state cleared, a sealed door at the rear of the chamber unlocks. It opens into a compact command-record room: fitted storage, preserved routing plates, an old review table, and a large wall panel crossed by worn geometric lines."}},
{"beat_id": "S020_B173", "speaker_id": "torren", "text": "Warden was holding it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "POST_WARDEN_COMMAND_RECORD_ROOM"], "source_section": "S020_B040 — The room behind the Warden", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B174", "speaker_id": "nimera", "text": "Or the authorization state was. Don't make me pick one without evidence.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "POST_WARDEN_COMMAND_RECORD_ROOM"], "source_section": "S020_B040 — The room behind the Warden", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B175", "speaker_id": "cyanis", "text": "Wouldn't dream of it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "POST_WARDEN_COMMAND_RECORD_ROOM"], "source_section": "S020_B040 — The room behind the Warden", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B176", "speaker_id": "maevra", "text": "Check it. Carefully.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "POST_WARDEN_COMMAND_RECORD_ROOM"], "source_section": "S020_B040 — The room behind the Warden", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S020_B177", "speaker_id": "nimera", "text": "Here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "FALSE_ORDER_ASSEMBLY_EVIDENCE"], "source_section": "S020_B041 — Proof of assembly", "source_speaker_label": "NIMERA", "staging": "Nimera finds the request path they followed from the Suppressed Archives preserved as a command record. The judicial declaration and custody authorization remain separate source entries. A third record preserves the order produced from both."}},
{"beat_id": "S020_B178", "speaker_id": "maevra", "text": "What am I looking at?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "FALSE_ORDER_ASSEMBLY_EVIDENCE"], "source_section": "S020_B041 — Proof of assembly", "source_speaker_label": "MAEVRA"}},
