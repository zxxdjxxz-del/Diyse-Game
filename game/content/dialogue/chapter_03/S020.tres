{"beat_id": "S020_B180", "speaker_id": "ilyra", "text": "And that?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "FALSE_ORDER_ASSEMBLY_EVIDENCE"], "source_section": "S020_B041 — Proof of assembly", "source_speaker_label": "ILYRA"}},
{"beat_id": "S020_B181", "speaker_id": "nimera", "text": "Output.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "FALSE_ORDER_ASSEMBLY_EVIDENCE"], "source_section": "S020_B041 — Proof of assembly", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B182", "speaker_id": "cyanis", "text": "Our order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "FALSE_ORDER_ASSEMBLY_EVIDENCE"], "source_section": "S020_B041 — Proof of assembly", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B183", "speaker_id": "nimera", "text": "Same sequence.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "FALSE_ORDER_ASSEMBLY_EVIDENCE"], "source_section": "S020_B041 — Proof of assembly", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B184", "speaker_id": "maevra", "text": "So it wasn't copied together afterward.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "FALSE_ORDER_ASSEMBLY_EVIDENCE"], "source_section": "S020_B041 — Proof of assembly", "source_speaker_label": "MAEVRA", "staging": "Maevra compares the command record against the copied Caeloran seizure order."}},
{"beat_id": "S020_B185", "speaker_id": "nimera", "text": "No. This system assembled it from two valid records.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "FALSE_ORDER_ASSEMBLY_EVIDENCE"], "source_section": "S020_B041 — Proof of assembly", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B186", "speaker_id": "torren", "text": "Made a lie out of two truths.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "FALSE_ORDER_ASSEMBLY_EVIDENCE"], "source_section": "S020_B041 — Proof of assembly", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B187", "speaker_id": "nimera", "text": "That is annoyingly accurate.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "FALSE_ORDER_ASSEMBLY_EVIDENCE"], "source_section": "S020_B041 — Proof of assembly", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B188", "speaker_id": "maevra", "text": "Can we prove that outside this room?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "FALSE_ORDER_ASSEMBLY_EVIDENCE"], "source_section": "S020_B041 — Proof of assembly", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S020_B189", "speaker_id": "nimera", "text": "Yes. The output is preserved with both source identifiers.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "FALSE_ORDER_ASSEMBLY_EVIDENCE"], "source_section": "S020_B041 — Proof of assembly", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B190", "speaker_id": "maevra", "text": "Take copies. Everything we can authenticate.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "FALSE_ORDER_ASSEMBLY_EVIDENCE"], "source_section": "S020_B041 — Proof of assembly", "source_speaker_label": "MAEVRA", "staging_after": "The evidence proves how the false order was assembled. It still does not identify who initiated the requests or why."}},
{"beat_id": "S020_B191", "speaker_id": "torren", "text": "Pellan.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "TORREN_ROUTE_SKETCH"], "source_section": "S020_B042 — Torren notices a map", "source_speaker_label": "TORREN", "staging": "While the others work over the command records, Torren studies the large wall panel."}},
{"beat_id": "S020_B192", "speaker_id": "nimera", "text": "What?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "TORREN_ROUTE_SKETCH"], "source_section": "S020_B042 — Torren notices a map", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B193", "speaker_id": "torren", "text": "What's this?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "TORREN_ROUTE_SKETCH"], "source_section": "S020_B042 — Torren notices a map", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B194", "speaker_id": "nimera", "text": "Routing geometry. Maybe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "TORREN_ROUTE_SKETCH"], "source_section": "S020_B042 — Torren notices a map", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B195", "speaker_id": "torren", "text": "Looks like a map.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "TORREN_ROUTE_SKETCH"], "source_section": "S020_B042 — Torren notices a map", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B196", "speaker_id": "nimera", "text": "That is not the same thing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "TORREN_ROUTE_SKETCH"], "source_section": "S020_B042 — Torren notices a map", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B197", "speaker_id": "torren", "text": "Roads here. High ground here. Water here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "TORREN_ROUTE_SKETCH"], "source_section": "S020_B042 — Torren notices a map", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B198", "speaker_id": "torren", "text": "And this runs southeast to something.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "TORREN_ROUTE_SKETCH"], "source_section": "S020_B042 — Torren notices a map", "source_speaker_label": "TORREN", "staging": "He follows one worn line away from the Old City."}},
{"beat_id": "S020_B199", "speaker_id": "nimera", "text": "You're sure?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "TORREN_ROUTE_SKETCH"], "source_section": "S020_B042 — Torren notices a map", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B200", "speaker_id": "torren", "text": "Sure enough to copy it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "TORREN_ROUTE_SKETCH"], "source_section": "S020_B042 — Torren notices a map", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B201", "speaker_id": "nimera", "text": "You're comfortable copying something you don't fully understand?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "TORREN_ROUTE_SKETCH"], "source_section": "S020_B042 — Torren notices a map", "source_speaker_label": "NIMERA", "staging": "Torren takes out paper and charcoal. Cyanis holds the light while Torren makes a quick practical sketch of the major lines, terrain marks, and destination marker."}},
{"beat_id": "S020_B202", "speaker_id": "torren", "text": "I'm copying where it goes. You can misunderstand it later.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "TORREN_ROUTE_SKETCH"], "source_section": "S020_B042 — Torren notices a map", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B203", "speaker_id": "nimera", "text": "Fair.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "TORREN_ROUTE_SKETCH"], "source_section": "S020_B042 — Torren notices a map", "source_speaker_label": "NIMERA", "staging": "Nimera considers that."}},
{"beat_id": "S020_B204", "speaker_id": "maevra", "text": "We found where the order was assembled.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "RETURN_TO_CAELORA_BEFORE_CRESTHAVEN"], "source_section": "S020_B043 — Return to Caelora", "source_speaker_label": "MAEVRA", "staging": "They do not follow the unknown route that night. The party returns to Caelora with the authenticated command-room evidence, Torren's sketch, the recovered records, Glassform Rupture, and the still-sealed Ruby-responsive Card.\n\nMirena meets them for a follow-up review. Maevra puts the command evidence down first."}},
{"beat_id": "S020_B205", "speaker_id": "mirena", "text": "Show me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "RETURN_TO_CAELORA_BEFORE_CRESTHAVEN"], "source_section": "S020_B043 — Return to Caelora", "source_speaker_label": "MIRENA"}},
{"beat_id": "S020_B206", "speaker_id": "nimera", "text": "Two valid source records entered separately. This is the output the system produced from both.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "RETURN_TO_CAELORA_BEFORE_CRESTHAVEN"], "source_section": "S020_B043 — Return to Caelora", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B207", "speaker_id": "mirena", "text": "Same sequence as the seizure order?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "RETURN_TO_CAELORA_BEFORE_CRESTHAVEN"], "source_section": "S020_B043 — Return to Caelora", "source_speaker_label": "MIRENA"}},
{"beat_id": "S020_B208", "speaker_id": "maevra", "text": "Exact match.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "RETURN_TO_CAELORA_BEFORE_CRESTHAVEN"], "source_section": "S020_B043 — Return to Caelora", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S020_B209", "speaker_id": "mirena", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "RETURN_TO_CAELORA_BEFORE_CRESTHAVEN"], "source_section": "S020_B043 — Return to Caelora", "source_speaker_label": "MIRENA"}},
{"beat_id": "S020_B210", "speaker_id": "mirena", "text": "Not good. Useful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "RETURN_TO_CAELORA_BEFORE_CRESTHAVEN"], "source_section": "S020_B043 — Return to Caelora", "source_speaker_label": "MIRENA", "staging": "A beat."}},
{"beat_id": "S020_B211", "speaker_id": "cyanis", "text": "Important distinction today.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "RETURN_TO_CAELORA_BEFORE_CRESTHAVEN"], "source_section": "S020_B043 — Return to Caelora", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B212", "speaker_id": "mirena", "text": "This proves the assembly. It does not tell us who initiated it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "RETURN_TO_CAELORA_BEFORE_CRESTHAVEN"], "source_section": "S020_B043 — Return to Caelora", "source_speaker_label": "MIRENA"}},
{"beat_id": "S020_B213", "speaker_id": "maevra", "text": "Agreed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "RETURN_TO_CAELORA_BEFORE_CRESTHAVEN"], "source_section": "S020_B043 — Return to Caelora", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S020_B214", "speaker_id": "torren", "text": "Found this in the same room.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B044 — The abandoned outpost", "source_speaker_label": "TORREN", "staging": "Torren puts his rough drawing beside the command records."}},
{"beat_id": "S020_B215", "speaker_id": "mirena", "text": "What am I looking at?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B044 — The abandoned outpost", "source_speaker_label": "MIRENA"}},
{"beat_id": "S020_B216", "speaker_id": "torren", "text": "Map.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B044 — The abandoned outpost", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B217", "speaker_id": "nimera", "text": "He thinks it's a map.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B044 — The abandoned outpost", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B218", "speaker_id": "torren", "text": "It's a map.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B044 — The abandoned outpost", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B219", "speaker_id": "mirena", "text": "This is Cresthaven.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B044 — The abandoned outpost", "source_speaker_label": "MIRENA", "staging": "Mirena turns the sketch, studies the terrain and route marks Torren copied, then stops at the destination marker."}},
{"beat_id": "S020_B220", "speaker_id": "maevra", "text": "Cresthaven?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B044 — The abandoned outpost", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S020_B221", "speaker_id": "mirena", "text": "Old Crown outpost in the Crownhold. Abandoned.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B044 — The abandoned outpost", "source_speaker_label": "MIRENA"}},
{"beat_id": "S020_B222", "speaker_id": "torren", "text": "How long?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B044 — The abandoned outpost", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B223", "speaker_id": "mirena", "text": "Long enough that nothing should be actively routing through it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B044 — The abandoned outpost", "source_speaker_label": "MIRENA"}},
{"beat_id": "S020_B224", "speaker_id": "cyanis", "text": "And an Ancient command station just pointed at it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B044 — The abandoned outpost", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B225", "speaker_id": "mirena", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B044 — The abandoned outpost", "source_speaker_label": "MIRENA"}},
{"beat_id": "S020_B226", "speaker_id": "nimera", "text": "Which makes it tomorrow's problem.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B044 — The abandoned outpost", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B227", "speaker_id": "mirena", "text": "Agreed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B044 — The abandoned outpost", "source_speaker_label": "MIRENA"}},
{"beat_id": "S020_B228", "speaker_id": "maevra", "text": "You're sending a survey team?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B044 — The abandoned outpost", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S020_B229", "speaker_id": "mirena", "text": "Survey, workers, records staff, medical support, supplies, and enough security to make the place usable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B044 — The abandoned outpost", "source_speaker_label": "MIRENA"}},
{"beat_id": "S020_B230", "speaker_id": "maevra", "text": "By tomorrow?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B044 — The abandoned outpost", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S020_B231", "speaker_id": "mirena", "text": "I can start before you wake up.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B044 — The abandoned outpost", "source_speaker_label": "MIRENA"}},
{"beat_id": "S020_B232", "speaker_id": "maevra", "text": "We take the records, the Card, and everyone who needs medical attention. Then we stop.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "NO_CRESTHAVEN_TRAVEL_UNTIL_NEXT_MORNING"], "source_section": "S020_B045 — Stop for the night", "source_speaker_label": "MAEVRA", "staging": "The Ruby Card remains sealed and still. No one travels to Cresthaven that night."}},
{"beat_id": "S020_B233", "speaker_id": "ilyra", "text": "In that order?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "NO_CRESTHAVEN_TRAVEL_UNTIL_NEXT_MORNING"], "source_section": "S020_B045 — Stop for the night", "source_speaker_label": "ILYRA"}},
{"beat_id": "S020_B234", "speaker_id": "maevra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "NO_CRESTHAVEN_TRAVEL_UNTIL_NEXT_MORNING"], "source_section": "S020_B045 — Stop for the night", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S020_B235", "speaker_id": "cyanis", "text": "Worth asking.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "NO_CRESTHAVEN_TRAVEL_UNTIL_NEXT_MORNING"], "source_section": "S020_B045 — Stop for the night", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B236", "speaker_id": "mirena", "text": "Cresthaven tomorrow.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "NO_CRESTHAVEN_TRAVEL_UNTIL_NEXT_MORNING", "STATE_FIRST_COMMAND_WARDEN_DEFEATED", "STATE_FALSE_ORDER_ASSEMBLY_PROVED", "STATE_TORREN_ROUTE_SKETCH_ACQUIRED", "STATE_CRESTHAVEN_IDENTIFIED"], "source_section": "S020_B045 — Stop for the night", "source_speaker_label": "MIRENA", "staging_after": "Fade out. S021 begins the next morning at Cresthaven."}}
]
