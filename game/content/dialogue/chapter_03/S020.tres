{"beat_id": "S020_B087", "speaker_id": "ilyra", "text": "Meaning?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B018 — After preview", "source_speaker_label": "ILYRA"}},
{"beat_id": "S020_B088", "speaker_id": "nimera", "text": "You could still do what it didn't want. It just made disobedience expensive.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B018 — After preview", "source_speaker_label": "NIMERA"}},
