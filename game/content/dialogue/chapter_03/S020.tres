{"beat_id": "S020_B161", "speaker_id": "torren", "text": "Good word.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B038 — Related, probably", "source_speaker_label": "TORREN"}},
{"beat_id": "S020_B162", "speaker_id": "nimera", "text": "Don't start.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B038 — Related, probably", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B163", "speaker_id": "cyanis", "text": "He's been doing this for days.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B038 — Related, probably", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B164", "speaker_id": "nimera", "text": "Then why didn't anyone stop him?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B038 — Related, probably", "source_speaker_label": "NIMERA"}},
{"beat_id": "S020_B165", "speaker_id": "cyanis", "text": "We tried.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B038 — Related, probably", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B166", "speaker_id": "torren", "text": "No you didn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B038 — Related, probably", "source_speaker_label": "TORREN"}},
