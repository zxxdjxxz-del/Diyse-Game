{"beat_id": "S020_B108", "speaker_id": "nimera", "text": "Seal on Cyanis.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B023 — State A: imposed authority", "source_speaker_label": "NIMERA", "staging": "Target-specific Command Seals pressure individuals but never remove Attack / Ability / Card / Item / Defend."}},
{"beat_id": "S020_B109", "speaker_id": "cyanis", "text": "What kind?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B023 — State A: imposed authority", "source_speaker_label": "CYANIS"}},
{"beat_id": "S020_B110", "speaker_id": "nimera", "text": "Bad kind. Move.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B023 — State A: imposed authority", "source_speaker_label": "NIMERA"}},
