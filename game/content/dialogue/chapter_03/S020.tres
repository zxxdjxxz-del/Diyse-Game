{"beat_id": "S020_B094", "speaker_id": "nimera", "text": "Specific.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B019 — Warden chamber reveal", "source_speaker_label": "NIMERA"}},
