{"beat_id": "S020_B119", "speaker_id": "nimera", "text": "Yes, thank you, field review complete.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B025 — Recorded action", "source_speaker_label": "NIMERA"}},
