{"beat_id": "S020_B159", "speaker_id": "nimera", "text": "Probably.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B038 — Related, probably", "source_speaker_label": "NIMERA"}},
