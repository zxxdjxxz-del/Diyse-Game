{"beat_id": "S020_B170", "speaker_id": "nimera", "text": "I was.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S020_B039 — Stop pushing deeper", "source_speaker_label": "NIMERA"}},
