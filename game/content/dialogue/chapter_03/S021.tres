{"beat_id": "S021_B116", "speaker_id": "torren", "text": "You were thinking it loudly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "HUNT_03_RETURN_ROUTE_AVAILABLE"], "source_section": "S021_B019 — The Old City branch can wait", "source_speaker_label": "TORREN"}},
{"beat_id": "S021_B117", "speaker_id": "nimera", "text": "Fuck you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "HUNT_03_RETURN_ROUTE_AVAILABLE"], "source_section": "S021_B019 — The Old City branch can wait", "source_speaker_label": "NIMERA"}},
{"beat_id": "S021_B118", "speaker_id": "ilyra", "text": "Coming?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B020 — Chapter end", "source_speaker_label": "ILYRA", "staging": "Later, Cresthaven is quieter. Modern people occupy the separate ancient site with lamps, records, food, bandages and route chalk. Cyanis pauses near the protected case without touching it. Ilyra appears at the doorway."}},
{"beat_id": "S021_B119", "speaker_id": "cyanis", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "STORY_CHAPTER_03_COMPLETE", "PRIME_LAST_SENTINEL_RECOVERED", "CRESTHAVEN_PHASE_01_OPERATIONAL", "UNLOCK_H04_LAST_SENTINEL_IS_NOT_INVITED", "UNLOCK_HUNT_03_ARCHIVE_JUDGMENT_ENGINE", "DO_NOT_AUTO_SKIP_CHARACTER_LIFE_SCENES"], "source_section": "S021_B020 — Chapter end", "source_speaker_label": "CYANIS", "staging_after": "He leaves with her. The camera stays on Last Sentinel: Ruby and still. No voice. No figure. No activation.\n\n**CHAPTER 3 — THE OLD CITY AND LAST SENTINEL — COMPLETE.**"}}
]
