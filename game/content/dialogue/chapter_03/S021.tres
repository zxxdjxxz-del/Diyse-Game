beats = [
{"beat_id": "S021_B001", "speaker_id": "torren", "text": "Abandoned.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CRESTHAVEN_NEXT_MORNING_ARRIVAL"], "source_section": "S021_B001 — Cresthaven, next morning", "source_speaker_label": "TORREN", "staging": "The following morning, the party reaches Cresthaven using Torren's copied route and Crown directions. The abandoned Southhold outpost is already active: Crown wagons unload supplies, workers clear and inspect rooms, clerks carry record boxes inside, medical staff establish a temporary treatment space, and a small security detail checks the perimeter. Older Diysean structure remains visible beneath and around the Crown construction."}},
{"beat_id": "S021_B002", "speaker_id": "cyanis", "text": "Apparently we're using the flexible definition.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CRESTHAVEN_NEXT_MORNING_ARRIVAL"], "source_section": "S021_B001 — Cresthaven, next morning", "source_speaker_label": "CYANIS"}},
{"beat_id": "S021_B003", "speaker_id": "ilyra", "text": "Someone got here early.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CRESTHAVEN_NEXT_MORNING_ARRIVAL"], "source_section": "S021_B001 — Cresthaven, next morning", "source_speaker_label": "ILYRA"}},
{"beat_id": "S021_B004", "speaker_id": "maevra", "text": "Mirena.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CRESTHAVEN_NEXT_MORNING_ARRIVAL"], "source_section": "S021_B001 — Cresthaven, next morning", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S021_B005", "speaker_id": "mirena", "text": "You're late.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CRESTHAVEN_NEXT_MORNING_ARRIVAL"], "source_section": "S021_B001 — Cresthaven, next morning", "source_speaker_label": "MIRENA", "staging": "They find Mirena directing the setup near the main structure."}},
{"beat_id": "S021_B006", "speaker_id": "maevra", "text": "You told us morning.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CRESTHAVEN_NEXT_MORNING_ARRIVAL"], "source_section": "S021_B001 — Cresthaven, next morning", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S021_B007", "speaker_id": "mirena", "text": "Then I'm early.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CRESTHAVEN_NEXT_MORNING_ARRIVAL"], "source_section": "S021_B001 — Cresthaven, next morning", "source_speaker_label": "MIRENA"}},
{"beat_id": "S021_B008", "speaker_id": "torren", "text": "By a lot.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CRESTHAVEN_NEXT_MORNING_ARRIVAL"], "source_section": "S021_B001 — Cresthaven, next morning", "source_speaker_label": "TORREN"}},
{"beat_id": "S021_B009", "speaker_id": "cyanis", "text": "You reopened it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CRESTHAVEN_NEXT_MORNING_ARRIVAL"], "source_section": "S021_B001 — Cresthaven, next morning", "source_speaker_label": "CYANIS"}},
{"beat_id": "S021_B010", "speaker_id": "mirena", "text": "Enough of it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CRESTHAVEN_NEXT_MORNING_ARRIVAL"], "source_section": "S021_B001 — Cresthaven, next morning", "source_speaker_label": "MIRENA"}},
{"beat_id": "S021_B011", "speaker_id": "mirena", "text": "Until we know why that command system pointed here, you need somewhere to work that isn't a borrowed room in Caelora.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CRESTHAVEN_NEXT_MORNING_ARRIVAL"], "source_section": "S021_B001 — Cresthaven, next morning", "source_speaker_label": "MIRENA"}},
{"beat_id": "S021_B012", "speaker_id": "maevra", "text": "Temporary headquarters.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CRESTHAVEN_NEXT_MORNING_ARRIVAL"], "source_section": "S021_B001 — Cresthaven, next morning", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S021_B013", "speaker_id": "mirena", "text": "Working headquarters. Temporary until we understand what the hell is going on.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CRESTHAVEN_NEXT_MORNING_ARRIVAL"], "source_section": "S021_B001 — Cresthaven, next morning", "source_speaker_label": "MIRENA"}},
{"beat_id": "S021_B014", "speaker_id": "mirena", "text": "Records, medical, supplies, rest, security, and somewhere to plan the next move. Nothing more permanent than the facts justify.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CRESTHAVEN_NEXT_MORNING_ARRIVAL"], "source_section": "S021_B001 — Cresthaven, next morning", "source_speaker_label": "MIRENA", "staging": "Mirena gestures toward the crews already making the outpost usable."}},
{"beat_id": "S021_B015", "speaker_id": "nimera", "text": "I like her.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CRESTHAVEN_NEXT_MORNING_ARRIVAL"], "source_section": "S021_B001 — Cresthaven, next morning", "source_speaker_label": "NIMERA"}},
{"beat_id": "S021_B016", "speaker_id": "cyanis", "text": "Careful. She'll hear you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CRESTHAVEN_NEXT_MORNING_ARRIVAL"], "source_section": "S021_B001 — Cresthaven, next morning", "source_speaker_label": "CYANIS"}},
{"beat_id": "S021_B017", "speaker_id": "mirena", "text": "I did.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "CRESTHAVEN_NEXT_MORNING_ARRIVAL"], "source_section": "S021_B001 — Cresthaven, next morning", "source_speaker_label": "MIRENA"}},
{"beat_id": "S021_B018", "speaker_id": "nimera", "text": "All right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B002 — The Card stays contained", "source_speaker_label": "NIMERA", "staging": "The sealed Card case sits on a cleared table in Cresthaven's temporary Archive/Command work area. Its Ruby response is stable and still. Glassform Rupture is nearby only as Nimera's known Standard-Card comparison sample."}},
{"beat_id": "S021_B019", "speaker_id": "cyanis", "text": "That's usually the point where you say something alarming.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B002 — The Card stays contained", "source_speaker_label": "CYANIS"}},
{"beat_id": "S021_B020", "speaker_id": "nimera", "text": "Give me a minute.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B002 — The Card stays contained", "source_speaker_label": "NIMERA"}},
{"beat_id": "S021_B021", "speaker_id": "cyanis", "text": "Modern Crest Knights use the same relationship when we're marking Might load.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B003 — Compare the geometry", "source_speaker_label": "CYANIS", "staging": "Nimera aligns known Standard notation and the recovered command record. Cyanis contributes only modern Crest Knight recognition."}},
{"beat_id": "S021_B022", "speaker_id": "nimera", "text": "Same relationship or similar?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B003 — Compare the geometry", "source_speaker_label": "NIMERA"}},
{"beat_id": "S021_B023", "speaker_id": "cyanis", "text": "What's the useful difference right now?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B003 — Compare the geometry", "source_speaker_label": "CYANIS"}},
{"beat_id": "S021_B024", "speaker_id": "nimera", "text": "Because those are different fucking sentences.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B003 — Compare the geometry", "source_speaker_label": "NIMERA"}},
{"beat_id": "S021_B025", "speaker_id": "cyanis", "text": "Same relationship.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B003 — Compare the geometry", "source_speaker_label": "CYANIS", "staging": "Cyanis looks again, more carefully."}},
{"beat_id": "S021_B026", "speaker_id": "nimera", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B003 — Compare the geometry", "source_speaker_label": "NIMERA"}},
{"beat_id": "S021_B027", "speaker_id": "nimera", "text": "Prime.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B004 — First answer", "source_speaker_label": "NIMERA", "staging": "Nimera points to the classification mark that the command system exposed."}},
{"beat_id": "S021_B028", "speaker_id": "ilyra", "text": "You're certain?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B004 — First answer", "source_speaker_label": "ILYRA", "staging": "Silence. The term is known academically, not operationally."}},
{"beat_id": "S021_B029", "speaker_id": "nimera", "text": "About the classification? Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B004 — First answer", "source_speaker_label": "NIMERA"}},
{"beat_id": "S021_B030", "speaker_id": "cyanis", "text": "Prime Card.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B004 — First answer", "source_speaker_label": "CYANIS"}},
{"beat_id": "S021_B031", "speaker_id": "nimera", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B004 — First answer", "source_speaker_label": "NIMERA"}},
{"beat_id": "S021_B032", "speaker_id": "torren", "text": "Thought nobody had one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B005 — Modern knowledge stays bounded", "source_speaker_label": "TORREN"}},
{"beat_id": "S021_B033", "speaker_id": "nimera", "text": "Nobody has a verified modern activation. That's not the same as nobody ever found references.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B005 — Modern knowledge stays bounded", "source_speaker_label": "NIMERA"}},
{"beat_id": "S021_B034", "speaker_id": "cyanis", "text": "Has anyone seen one work?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B005 — Modern knowledge stays bounded", "source_speaker_label": "CYANIS"}},
{"beat_id": "S021_B035", "speaker_id": "nimera", "text": "Not anybody alive that I can prove.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B005 — Modern knowledge stays bounded", "source_speaker_label": "NIMERA"}},
{"beat_id": "S021_B036", "speaker_id": "maevra", "text": "So we do not pretend we know what happens next.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B005 — Modern knowledge stays bounded", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S021_B037", "speaker_id": "nimera", "text": "Thank you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B005 — Modern knowledge stays bounded", "source_speaker_label": "NIMERA"}},
{"beat_id": "S021_B038", "speaker_id": "nimera", "text": "Might.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B006 — Second answer", "source_speaker_label": "NIMERA", "staging": "Nimera shifts from classification to Face evidence: Ruby response, known Six-Face notation, and Cyanis's modern geometry recognition."}},
{"beat_id": "S021_B039", "speaker_id": "cyanis", "text": "Not resembles Might.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B006 — Second answer", "source_speaker_label": "CYANIS"}},
{"beat_id": "S021_B040", "speaker_id": "nimera", "text": "No. Might.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B006 — Second answer", "source_speaker_label": "NIMERA"}},
{"beat_id": "S021_B041", "speaker_id": "ilyra", "text": "That's two.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B006 — Second answer", "source_speaker_label": "ILYRA"}},
{"beat_id": "S021_B042", "speaker_id": "nimera", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B006 — Second answer", "source_speaker_label": "NIMERA"}},
{"beat_id": "S021_B043", "speaker_id": "cyanis", "text": "Why me?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B007 — Why Cyanis?", "source_speaker_label": "CYANIS"}},
{"beat_id": "S021_B044", "speaker_id": "nimera", "text": "No fucking idea.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B007 — Why Cyanis?", "source_speaker_label": "NIMERA"}},
{"beat_id": "S021_B045", "speaker_id": "cyanis", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B007 — Why Cyanis?", "source_speaker_label": "CYANIS", "staging": "Cyanis almost laughs, mostly because the answer is so clean."}},
{"beat_id": "S021_B046", "speaker_id": "nimera", "text": "Stop rewarding me for not knowing things.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B007 — Why Cyanis?", "source_speaker_label": "NIMERA"}},
{"beat_id": "S021_B047", "speaker_id": "cyanis", "text": "I'm rewarding you for saying it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B007 — Why Cyanis?", "source_speaker_label": "CYANIS"}},
{"beat_id": "S021_B048", "speaker_id": "torren", "text": "That's the part I don't like.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B008 — The Warden output", "source_speaker_label": "TORREN", "staging": "Maevra places the copied command output beside the notes.\n\n**/PREVIOUS ERROR/**\n\n**/LAST SENTINEL CONFIRMED/**"}},
{"beat_id": "S021_B049", "speaker_id": "cyanis", "text": "Which part?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B008 — The Warden output", "source_speaker_label": "CYANIS"}},
{"beat_id": "S021_B050", "speaker_id": "torren", "text": "Previous.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B008 — The Warden output", "source_speaker_label": "TORREN"}},
{"beat_id": "S021_B051", "speaker_id": "nimera", "text": "Sensible choice.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B008 — The Warden output", "source_speaker_label": "NIMERA"}},
{"beat_id": "S021_B052", "speaker_id": "maevra", "text": "We have Prime. We have Might. What does the command phrase give us?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B009 — Third answer", "source_speaker_label": "MAEVRA"}},
{"beat_id": "S021_B053", "speaker_id": "nimera", "text": "Identity.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B009 — Third answer", "source_speaker_label": "NIMERA"}},
{"beat_id": "S021_B054", "speaker_id": "cyanis", "text": "Last Sentinel.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B009 — Third answer", "source_speaker_label": "CYANIS"}},
{"beat_id": "S021_B055", "speaker_id": "nimera", "text": "Best supported reading, yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B009 — Third answer", "source_speaker_label": "NIMERA"}},
{"beat_id": "S021_B056", "speaker_id": "cyanis", "text": "So am I the Last Sentinel?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B009 — Third answer", "source_speaker_label": "CYANIS"}},
{"beat_id": "S021_B057", "speaker_id": "nimera", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "S021_B009 — Third answer", "source_speaker_label": "NIMERA"}},
