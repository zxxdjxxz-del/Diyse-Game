authoring_notes = "CURRENT runtime dialogue compiled from docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md. docs/03_DIALOGUE/PRODUCTION is exact spoken-wording authority; legacy S001-S021 Resources are not source authority. Source SHA-256: 4de8f0d066573453af130926e7c5e06a93b2b18b6077f22768c34a0e70df696a. Spoken-sequence SHA-256: 4519399c9407369e16bf47e2691f10caa5817ca0584e72cdb62190b0a7cc020a. Spoken lines: 44."
beats = [
{"beat_id": "CH00_P02_L0001", "speaker_id": "wounded_escort", "text": "Dovaren.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WOUNDED ESCORT]", "source_speaker_label": "WOUNDED ESCORT", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 23}},
{"beat_id": "CH00_P02_L0002", "speaker_id": "cyanis", "text": "Where?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WOUNDED ESCORT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 25}},
{"beat_id": "CH00_P02_L0003", "speaker_id": "wounded_escort", "text": "Two by the axle. One under the canvas. I can get to the first two.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WOUNDED ESCORT]", "source_speaker_label": "WOUNDED ESCORT", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 27}},
{"beat_id": "CH00_P02_L0004", "speaker_id": "cyanis", "text": "Can you stand without lying to me?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WOUNDED ESCORT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 31}},
{"beat_id": "CH00_P02_L0005", "speaker_id": "wounded_escort", "text": "Enough.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WOUNDED ESCORT]", "source_speaker_label": "WOUNDED ESCORT", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 35}},
{"beat_id": "CH00_P02_L0006", "speaker_id": "cyanis", "text": "Fine. Get the two by the axle behind the stone line. Don't lift anyone you can't move cleanly; if one of them goes down, shout and leave them where they are until I get back.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WOUNDED ESCORT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 37}},
{"beat_id": "CH00_P02_L0007", "speaker_id": "wounded_escort", "text": "The one under the canvas?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WOUNDED ESCORT]", "source_speaker_label": "WOUNDED ESCORT", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 39}},
{"beat_id": "CH00_P02_L0008", "speaker_id": "cyanis", "text": "Mine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WOUNDED ESCORT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 41}},
{"beat_id": "CH00_P02_L0009", "speaker_id": "wounded_escort", "text": "You're one person.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WOUNDED ESCORT]", "source_speaker_label": "WOUNDED ESCORT", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 43}},
{"beat_id": "CH00_P02_L0010", "speaker_id": "cyanis", "text": "I noticed. Go.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WOUNDED ESCORT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 45}},
{"beat_id": "CH00_P02_L0011", "speaker_id": "civilian", "text": "My brother's under there.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — TRAPPED SURVIVOR]", "source_speaker_label": "CIVILIAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH00_P02_L0012", "speaker_id": "cyanis", "text": "Don't get under the frame.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — TRAPPED SURVIVOR]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 61}},
{"beat_id": "CH00_P02_L0013", "speaker_id": "civilian", "text": "He's right there. I can reach him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — TRAPPED SURVIVOR]", "source_speaker_label": "CIVILIAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 63}},
{"beat_id": "CH00_P02_L0014", "speaker_id": "cyanis", "text": "And if the axle shifts, I get two people under it instead of one. Stay where I can see you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — TRAPPED SURVIVOR]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 65}},
{"beat_id": "CH00_P02_L0015", "speaker_id": "civilian", "text": "We can't leave him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — TRAPPED SURVIVOR]", "source_speaker_label": "CIVILIAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 69}},
{"beat_id": "CH00_P02_L0016", "speaker_id": "cyanis", "text": "We're not leaving him. Help me pull him clear from this side.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — TRAPPED SURVIVOR]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 71}},
{"beat_id": "CH00_P02_L0017", "speaker_id": "civilian", "text": "He's breathing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — TRAPPED SURVIVOR]", "source_speaker_label": "CIVILIAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 77}},
{"beat_id": "CH00_P02_L0018", "speaker_id": "cyanis", "text": "Good. Keep him on his side. If the breathing changes, if he wakes confused, if he starts choking—shout. Don't try to move him again by yourself.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — TRAPPED SURVIVOR]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 79}},
{"beat_id": "CH00_P02_L0019", "speaker_id": "civilian", "text": "You're leaving?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — TRAPPED SURVIVOR]", "source_speaker_label": "CIVILIAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 81}},
{"beat_id": "CH00_P02_L0020", "speaker_id": "cyanis", "text": "Not far enough that I won't hear you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — TRAPPED SURVIVOR]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 85}},
{"beat_id": "CH00_P02_L0021", "speaker_id": "wounded_escort", "text": "Middle road's faster.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STONE-LINE ROUTE]", "source_speaker_label": "WOUNDED ESCORT", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 95}},
{"beat_id": "CH00_P02_L0022", "speaker_id": "cyanis", "text": "Until that wagon comes down across it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STONE-LINE ROUTE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 97}},
{"beat_id": "CH00_P02_L0023", "speaker_id": "wounded_escort", "text": "Think it will?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STONE-LINE ROUTE]", "source_speaker_label": "WOUNDED ESCORT", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 99}},
{"beat_id": "CH00_P02_L0024", "speaker_id": "cyanis", "text": "Don't know. Don't need to find out with wounded underneath it. Stone line.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STONE-LINE ROUTE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 101}},
{"beat_id": "CH00_P02_L0025", "speaker_id": "wounded_escort", "text": "Stone line.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STONE-LINE ROUTE]", "source_speaker_label": "WOUNDED ESCORT", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 103}},
{"beat_id": "CH00_P02_L0026", "speaker_id": "wounded_escort", "text": "Movement!", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED HOUND PRESSURE]", "source_speaker_label": "WOUNDED ESCORT", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 125}},
{"beat_id": "CH00_P02_L0027", "speaker_id": "cyanis", "text": "Back.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED HOUND PRESSURE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 127}},
{"beat_id": "CH00_P02_L0028", "speaker_id": "cyanis", "text": "Behind the wagon. Now.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED HOUND PRESSURE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 131}},
{"beat_id": "CH00_P02_L0029", "speaker_id": "convoy_officer", "text": "North side's pulling back.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — NORTH WITHDRAWAL]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 145}},
{"beat_id": "CH00_P02_L0030", "speaker_id": "cyanis", "text": "I see it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — NORTH WITHDRAWAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 149}},
{"beat_id": "CH00_P02_L0031", "speaker_id": "convoy_officer", "text": "Looks like they're breaking.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — NORTH WITHDRAWAL]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 151}},
{"beat_id": "CH00_P02_L0032", "speaker_id": "cyanis", "text": "Maybe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — NORTH WITHDRAWAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 153}},
{"beat_id": "CH00_P02_L0033", "speaker_id": "convoy_officer", "text": "You're still on the road.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — NORTH WITHDRAWAL]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 157}},
{"beat_id": "CH00_P02_L0034", "speaker_id": "cyanis", "text": "Everything else is choked with wreckage or bodies. That north cut is clean enough to march through. Maybe they cleared it for themselves. Maybe they want us to notice it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — NORTH WITHDRAWAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 159}},
{"beat_id": "CH00_P02_L0035", "speaker_id": "convoy_officer", "text": "You think it's bait.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — NORTH WITHDRAWAL]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 161}},
{"beat_id": "CH00_P02_L0036", "speaker_id": "cyanis", "text": "I think I don't know yet, and chasing people through the one convenient gap they left us is a stupid way to learn.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — NORTH WITHDRAWAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 163}},
{"beat_id": "CH00_P02_L0037", "speaker_id": "convoy_officer", "text": "They're still getting away.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — NORTH WITHDRAWAL]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 167}},
{"beat_id": "CH00_P02_L0038", "speaker_id": "cyanis", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — NORTH WITHDRAWAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 169}},
{"beat_id": "CH00_P02_L0039", "speaker_id": "convoy_officer", "text": "Relay. Bring me the whole field when you get there. Casualties, who can still fight, and whether that cut still bothers you once you've looked at something besides it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — NORTH WITHDRAWAL]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 175}},
{"beat_id": "CH00_P02_L0040", "speaker_id": "cyanis", "text": "Point taken.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — NORTH WITHDRAWAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P02_WRECK_FIELD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 177}},
