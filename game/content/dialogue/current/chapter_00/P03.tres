story_position = "Chapter 0 — P03 — Evacuation Relay Decision"
scene_mode = "full_authored_stop_scene"
movement_lock = true
dialogue_readiness = "GREEN"
production_cost_tier = "economical"
encounter_policy = {"during_scene": "temporarily_suppress_trigger", "after_scene": "restore_prior_pressure"}
return_to_gameplay = {"control_mode": "exploration"}
cutscene_tier = "C0"
vfx_tier = "V1"
authoring_notes = "CURRENT runtime dialogue compiled from docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md. docs/03_DIALOGUE/PRODUCTION is exact spoken-wording authority; legacy S001-S021 Resources are not source authority. Source SHA-256: d92ec3f242bd9b5746d6078abf006cbd0e1c93959566c44f636f948e22ff0da9. Spoken-sequence SHA-256: 6e06dc2d27c587d0f71414292fba9fca964433cd17240b97176dbeebc206d21d. Spoken lines: 27."
beats = [
{"beat_id": "CH00_P03_L0001", "speaker_id": "convoy_officer", "text": "Report.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 17}},
{"beat_id": "CH00_P03_L0002", "speaker_id": "cyanis", "text": "Seventeen moving under their own power. Five need carrying. Two escorts are clean enough to chase if we absolutely need them; three more can hold a fixed line, but I wouldn't ask them to run one. Recovery wagon is still ours. East approach is open. Center road is bad for casualties unless somebody stabilizes the wreck first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 21}},
{"beat_id": "CH00_P03_L0003", "speaker_id": "convoy_officer", "text": "They're still pulling back. If they reach the ridge intact, they can reform and hit us again.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 25}},
{"beat_id": "CH00_P03_L0004", "speaker_id": "cyanis", "text": "They can. I still don't like the north cut.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 27}},
{"beat_id": "CH00_P03_L0005", "speaker_id": "convoy_officer", "text": "You said that. What changes now?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 29}},
{"beat_id": "CH00_P03_L0006", "speaker_id": "cyanis", "text": "Five people still need carrying. I don't want to spend our two best legs proving the clean cut isn't bait.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 31}},
{"beat_id": "CH00_P03_L0007", "speaker_id": "convoy_officer", "text": "So you want to let an armed withdrawal walk away while we're exposed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 35}},
{"beat_id": "CH00_P03_L0008", "speaker_id": "cyanis", "text": "For ten minutes. Pull the casualties in, reform around the wreck and recovery wagon, put eyes north, then decide with an actual line behind us. If they come back during that window, they hit people ready for them instead of half a camp carrying stretchers.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 37}},
{"beat_id": "CH00_P03_L0009", "speaker_id": "convoy_officer", "text": "And if they don't come back? If they use those ten minutes to settle on the ridge and make us pay for giving them time?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 39}},
{"beat_id": "CH00_P03_L0010", "speaker_id": "cyanis", "text": "Then we deal with a harder ridge after we've stopped bleeding people into the road. I don't love it. I just hate the other order more.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 41}},
{"beat_id": "CH00_P03_L0011", "speaker_id": "convoy_officer", "text": "You were going to refuse a chase order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 45}},
{"beat_id": "CH00_P03_L0012", "speaker_id": "cyanis", "text": "If you sent the two clean escorts north right now? Yes. I'd argue first. If you still ordered it, they'd go.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH00_P03_L0013", "speaker_id": "convoy_officer", "text": "You'd go with them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 51}},
{"beat_id": "CH00_P03_L0014", "speaker_id": "cyanis", "text": "Probably.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 53}},
{"beat_id": "CH00_P03_L0015", "speaker_id": "convoy_officer", "text": "That's the part of you I find exhausting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 55}},
{"beat_id": "CH00_P03_L0016", "speaker_id": "cyanis", "text": "Which part?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 57}},
{"beat_id": "CH00_P03_L0017", "speaker_id": "convoy_officer", "text": "The part where your objection somehow ends with you volunteering for the stupid thing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH00_P03_L0018", "speaker_id": "cyanis", "text": "Noted.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 63}},
{"beat_id": "CH00_P03_L0019", "speaker_id": "convoy_officer", "text": "I don't believe you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 65}},
{"beat_id": "CH00_P03_L0020", "speaker_id": "convoy_officer", "text": "Relay first. Reform on the wagon. Eyes north. Nobody chases until I say otherwise. Two clean escorts stay mobile, not committed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 71}},
{"beat_id": "CH00_P03_L0021", "speaker_id": "cyanis", "text": "Yes, sir.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 73}},
{"beat_id": "CH00_P03_L0022", "speaker_id": "convoy_officer", "text": "Dovaren.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 77}},
{"beat_id": "CH00_P03_L0023", "speaker_id": "cyanis", "text": "Sir?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 79}},
{"beat_id": "CH00_P03_L0024", "speaker_id": "convoy_officer", "text": "Next time, field first and refusal second. You had the argument. I shouldn't have to drag it out of you while people are waiting on the decision.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 81}},
{"beat_id": "CH00_P03_L0025", "speaker_id": "cyanis", "text": "You're right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 85}},
{"beat_id": "CH00_P03_L0026", "speaker_id": "convoy_officer", "text": "Go make the line worth the argument.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 89}},
{"beat_id": "CH00_P03_L0027", "speaker_id": "cyanis", "text": "On it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — EVACUATION RELAY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P03_EVACUATION_RELAY_DECISION_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 91}}
]
