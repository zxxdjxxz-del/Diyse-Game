beats = [
{"beat_id": "CH00_C01_L0001", "speaker_id": "ilyra", "text": "That bad?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 35}},
{"beat_id": "CH00_C01_L0002", "speaker_id": "cyanis", "text": "Horse shit would be better. Who's tea is this?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 37}},
{"beat_id": "CH00_C01_L0003", "speaker_id": "ilyra", "text": "Where did you get that?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 41}},
{"beat_id": "CH00_C01_L0004", "speaker_id": "cyanis", "text": "The pot near the fire.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 43}},
{"beat_id": "CH00_C01_L0005", "speaker_id": "ilyra", "text": "That's bitterleaf.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH00_C01_L0006", "speaker_id": "cyanis", "text": "How do you drink this?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 51}},
{"beat_id": "CH00_C01_L0007", "speaker_id": "ilyra", "text": "It's for compresses.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 53}},
{"beat_id": "CH00_C01_L0008", "speaker_id": "cyanis", "text": "Ah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH00_C01_L0009", "speaker_id": "cyanis", "text": "Before you say anything, nobody labeled the medical swamp water.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 63}},
{"beat_id": "CH00_C01_L0010", "speaker_id": "ilyra", "text": "Give me the cup.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 65}},
{"beat_id": "CH00_C01_L0011", "speaker_id": "cyanis", "text": "That's not a rebuttal.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 67}},
{"beat_id": "CH00_C01_L0012", "speaker_id": "ilyra", "text": "Cyanis.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 69}},
{"beat_id": "CH00_C01_L0013", "speaker_id": "cyanis", "text": "Fine. But if I die from this, I want the report to say I survived Riftmaw and was killed by poor beverage management.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 73}},
{"beat_id": "CH00_C01_L0014", "speaker_id": "ilyra", "text": "You're not going to die from drinking some bitterleaf.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 77}},
{"beat_id": "CH00_C01_L0015", "speaker_id": "cyanis", "text": "I'll take it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 79}},
{"beat_id": "CH00_C01_L0016", "speaker_id": "ilyra", "text": "You are, however, going to suffer severely from hearing about it for as long as I find it funny.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 83}},
{"beat_id": "CH00_C01_L0017", "speaker_id": "cyanis", "text": "That's a much worse prognosis.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 87}},
{"beat_id": "CH00_C01_L0018", "speaker_id": "cyanis", "text": "There. First laugh. Cost me my dignity, but we got there.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 91}},
{"beat_id": "CH00_C01_L0019", "speaker_id": "ilyra", "text": "You drank a compress. I don't think I did anything.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 93}},
{"beat_id": "CH00_C01_L0020", "speaker_id": "cyanis", "text": "Some of a compress.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 95}},
{"beat_id": "CH00_C01_L0021", "speaker_id": "ilyra", "text": "Important distinction.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 97}},
{"beat_id": "CH00_C01_L0022", "speaker_id": "ilyra", "text": "I didn't ask for whatever you found this time.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER, APPARENTLY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 109}},
{"beat_id": "CH00_C01_L0023", "speaker_id": "cyanis", "text": "This one's actually edible. I promise.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER, APPARENTLY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 111}},
{"beat_id": "CH00_C01_L0024", "speaker_id": "ilyra", "text": "And?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER, APPARENTLY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 113}},
{"beat_id": "CH00_C01_L0025", "speaker_id": "cyanis", "text": "Beef stew.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER, APPARENTLY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 115}},
{"beat_id": "CH00_C01_L0026", "speaker_id": "ilyra", "text": "Strong start.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER, APPARENTLY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 119}},
{"beat_id": "CH00_C01_L0027", "speaker_id": "ilyra", "text": "If you are certain why are you inspecting every bite?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER, APPARENTLY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 127}},
{"beat_id": "CH00_C01_L0028", "speaker_id": "cyanis", "text": "Trust has been damaged.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER, APPARENTLY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 129}},
{"beat_id": "CH00_C01_L0029", "speaker_id": "ilyra", "text": "By you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER, APPARENTLY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 131}},
{"beat_id": "CH00_C01_L0030", "speaker_id": "cyanis", "text": "Still damaged.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER, APPARENTLY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 133}},
{"beat_id": "CH00_C01_L0031", "speaker_id": "ilyra", "text": "This is why you don't touch things without asking people.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER, APPARENTLY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 137}},
{"beat_id": "CH00_C01_L0032", "speaker_id": "cyanis", "text": "This is why people don't put a cup beside a pot of medicine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER, APPARENTLY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 139}},
{"beat_id": "CH00_C01_L0033", "speaker_id": "ilyra", "text": "You really need there to be shared blame.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER, APPARENTLY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 141}},
{"beat_id": "CH00_C01_L0034", "speaker_id": "cyanis", "text": "I need there to be *some* blame that isn't mine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER, APPARENTLY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 143}},
{"beat_id": "CH00_C01_L0035", "speaker_id": "ilyra", "text": "Then tonight has been difficult for you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER, APPARENTLY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 145}},
{"beat_id": "CH00_C01_L0036", "speaker_id": "ilyra", "text": "I thought you were an officer when I first saw you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 159}},
{"beat_id": "CH00_C01_L0037", "speaker_id": "cyanis", "text": "Why?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 163}},
{"beat_id": "CH00_C01_L0038", "speaker_id": "ilyra", "text": "Everybody kept shouting your name like you were responsible for whatever was happening near them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 165}},
{"beat_id": "CH00_C01_L0039", "speaker_id": "cyanis", "text": "That's not about rank, that's about ability.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 167}},
{"beat_id": "CH00_C01_L0040", "speaker_id": "ilyra", "text": "I soon realized you weren't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 169}},
{"beat_id": "CH00_C01_L0041", "speaker_id": "cyanis", "text": "What changed your mind?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 171}},
{"beat_id": "CH00_C01_L0042", "speaker_id": "ilyra", "text": "Everything else you did, plus the pissed off look on the actual officer telling you what to do.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 175}},
