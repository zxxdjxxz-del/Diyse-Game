beats = [
{"beat_id": "CH00_C01_L0001", "speaker_id": "ilyra", "text": "That bad?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 23}},
{"beat_id": "CH00_C01_L0002", "speaker_id": "cyanis", "text": "Boiled ass would be better. Whose tea is this?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 25}},
{"beat_id": "CH00_C01_L0003", "speaker_id": "ilyra", "text": "Where did you get that?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 29}},
{"beat_id": "CH00_C01_L0004", "speaker_id": "cyanis", "text": "Pot near the fire.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 31}},
{"beat_id": "CH00_C01_L0005", "speaker_id": "ilyra", "text": "That's bitterleaf.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 37}},
{"beat_id": "CH00_C01_L0006", "speaker_id": "cyanis", "text": "How do you drink this?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 39}},
{"beat_id": "CH00_C01_L0007", "speaker_id": "ilyra", "text": "It's for compresses.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 41}},
{"beat_id": "CH00_C01_L0008", "speaker_id": "cyanis", "text": "Ah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 47}},
{"beat_id": "CH00_C01_L0009", "speaker_id": "cyanis", "text": "Before you say anything, nobody labeled the medical swamp water.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 51}},
{"beat_id": "CH00_C01_L0010", "speaker_id": "ilyra", "text": "Give me the cup.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 53}},
{"beat_id": "CH00_C01_L0011", "speaker_id": "cyanis", "text": "If I die from this, I want the report to say I survived Riftmaw and was killed by poor beverage management.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 57}},
{"beat_id": "CH00_C01_L0012", "speaker_id": "ilyra", "text": "You're not going to die from bitterleaf.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 59}},
{"beat_id": "CH00_C01_L0013", "speaker_id": "cyanis", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 61}},
{"beat_id": "CH00_C01_L0014", "speaker_id": "ilyra", "text": "You are however, going to hear about it for as long as I find it funny.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 65}},
{"beat_id": "CH00_C01_L0015", "speaker_id": "cyanis", "text": "Worse prognosis.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 67}},
{"beat_id": "CH00_C01_L0016", "speaker_id": "cyanis", "text": "There. First laugh. Cost me my dignity.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 71}},
{"beat_id": "CH00_C01_L0017", "speaker_id": "ilyra", "text": "You drank a compress. I didn't do anything.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 73}},
{"beat_id": "CH00_C01_L0018", "speaker_id": "cyanis", "text": "Some of a compress.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 75}},
{"beat_id": "CH00_C01_L0019", "speaker_id": "ilyra", "text": "Naturally.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BITTERLEAF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 77}},
{"beat_id": "CH00_C01_L0020", "speaker_id": "ilyra", "text": "You checked this one first?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 85}},
{"beat_id": "CH00_C01_L0021", "speaker_id": "cyanis", "text": "Thoroughly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 87}},
{"beat_id": "CH00_C01_L0022", "speaker_id": "ilyra", "text": "You said you checked it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 95}},
{"beat_id": "CH00_C01_L0023", "speaker_id": "cyanis", "text": "Trust has been damaged.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 97}},
{"beat_id": "CH00_C01_L0024", "speaker_id": "ilyra", "text": "By you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 99}},
{"beat_id": "CH00_C01_L0025", "speaker_id": "cyanis", "text": "Still damaged.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 101}},
{"beat_id": "CH00_C01_L0026", "speaker_id": "ilyra", "text": "Tonight must be difficult for you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DINNER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 105}},
{"beat_id": "CH00_C01_L0027", "speaker_id": "ilyra", "text": "I thought you were an officer when I first saw you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 115}},
{"beat_id": "CH00_C01_L0028", "speaker_id": "cyanis", "text": "Why?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 119}},
{"beat_id": "CH00_C01_L0029", "speaker_id": "ilyra", "text": "Everybody kept shouting your name like you were responsible for whatever was happening near them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 121}},
{"beat_id": "CH00_C01_L0030", "speaker_id": "cyanis", "text": "That's not rank. That's ability.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 123}},
{"beat_id": "CH00_C01_L0031", "speaker_id": "ilyra", "text": "I realized that wasn't it when I saw the actual officer looking pissed at you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 125}},
{"beat_id": "CH00_C01_L0032", "speaker_id": "cyanis", "text": "Fuck.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 131}},
{"beat_id": "CH00_C01_L0033", "speaker_id": "ilyra", "text": "You asked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 133}},
{"beat_id": "CH00_C01_L0034", "speaker_id": "cyanis", "text": "I thought you were angry at me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 137}},
{"beat_id": "CH00_C01_L0035", "speaker_id": "ilyra", "text": "I was.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 139}},
{"beat_id": "CH00_C01_L0036", "speaker_id": "cyanis", "text": "Oh.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 141}},
{"beat_id": "CH00_C01_L0037", "speaker_id": "ilyra", "text": "You walked into a treatment lane and said you needed it clear.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 143}},
{"beat_id": "CH00_C01_L0038", "speaker_id": "cyanis", "text": "In my defense—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 145}},
{"beat_id": "CH00_C01_L0039", "speaker_id": "ilyra", "text": "You listened when I told you why you couldn't have it. Then you moved the crates yourself.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 147}},
{"beat_id": "CH00_C01_L0040", "speaker_id": "cyanis", "text": "That sounded almost nice.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 151}},
{"beat_id": "CH00_C01_L0041", "speaker_id": "ilyra", "text": "Don't get greedy.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 153}},
{"beat_id": "CH00_C01_L0042", "speaker_id": "cyanis", "text": "Right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 155}},
{"beat_id": "CH00_C01_L0043", "speaker_id": "ilyra", "text": "You also apologized to the wagon.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 159}},
{"beat_id": "CH00_C01_L0044", "speaker_id": "cyanis", "text": "No, I didn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 163}},
{"beat_id": "CH00_C01_L0045", "speaker_id": "ilyra", "text": "You hit it and said `sorry.`", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 165}},
{"beat_id": "CH00_C01_L0046", "speaker_id": "cyanis", "text": "There was a lot going on!", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 167}},
{"beat_id": "CH00_C01_L0047", "speaker_id": "ilyra", "text": "You apologized to a wagon.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 169}},
{"beat_id": "CH00_C01_L0048", "speaker_id": "cyanis", "text": "Unreliable witness.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 171}},
{"beat_id": "CH00_C01_L0049", "speaker_id": "ilyra", "text": "I was actually standing right there when it happened", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST IMPRESSIONS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 173}},
{"beat_id": "CH00_C01_L0050", "speaker_id": "cyanis", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEITHER OF THEM STOPS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 183}},
{"beat_id": "CH00_C01_L0051", "speaker_id": "ilyra", "text": "No?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEITHER OF THEM STOPS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 187}},
{"beat_id": "CH00_C01_L0052", "speaker_id": "cyanis", "text": "Whatever you're about to go do can wait a minute.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEITHER OF THEM STOPS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 189}},
{"beat_id": "CH00_C01_L0053", "speaker_id": "ilyra", "text": "You don't even know what it is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEITHER OF THEM STOPS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 191}},
{"beat_id": "CH00_C01_L0054", "speaker_id": "cyanis", "text": "Neither do you. You just had the posture.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEITHER OF THEM STOPS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 193}},
{"beat_id": "CH00_C01_L0055", "speaker_id": "ilyra", "text": "The posture.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEITHER OF THEM STOPS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 197}},
{"beat_id": "CH00_C01_L0056", "speaker_id": "cyanis", "text": "The one where sitting has offended you and now you need a task.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEITHER OF THEM STOPS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 199}},
{"beat_id": "CH00_C01_L0057", "speaker_id": "ilyra", "text": "I was going to find one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEITHER OF THEM STOPS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 203}},
{"beat_id": "CH00_C01_L0058", "speaker_id": "cyanis", "text": "Exactly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEITHER OF THEM STOPS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 205}},
{"beat_id": "CH00_C01_L0059", "speaker_id": "ilyra", "text": "You were about to stand too.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEITHER OF THEM STOPS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 209}},
{"beat_id": "CH00_C01_L0060", "speaker_id": "cyanis", "text": "Maybe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEITHER OF THEM STOPS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 213}},
{"beat_id": "CH00_C01_L0061", "speaker_id": "ilyra", "text": "To do what?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEITHER OF THEM STOPS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 215}},
{"beat_id": "CH00_C01_L0062", "speaker_id": "cyanis", "text": "Didn't have one yet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEITHER OF THEM STOPS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 219}},
{"beat_id": "CH00_C01_L0063", "speaker_id": "ilyra", "text": "So you were going to find a problem.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEITHER OF THEM STOPS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 221}},
{"beat_id": "CH00_C01_L0064", "speaker_id": "cyanis", "text": "Sounds like shit when you say it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEITHER OF THEM STOPS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 223}},
{"beat_id": "CH00_C01_L0065", "speaker_id": "ilyra", "text": "I wasn't being medical.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEITHER OF THEM STOPS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 225}},
{"beat_id": "CH00_C01_L0066", "speaker_id": "cyanis", "text": "Somehow worse again.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEITHER OF THEM STOPS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 227}},
{"beat_id": "CH00_C01_L0067", "speaker_id": "cyanis", "text": "Five minutes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SIX MINUTES]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 235}},
{"beat_id": "CH00_C01_L0068", "speaker_id": "ilyra", "text": "For what?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SIX MINUTES]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 237}},
{"beat_id": "CH00_C01_L0069", "speaker_id": "cyanis", "text": "We sit here and do absolutely nothing useful. No perimeter, no patients unless somebody calls, no inventory, no finding work because the silence made us nervous.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SIX MINUTES]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 239}},
{"beat_id": "CH00_C01_L0070", "speaker_id": "ilyra", "text": "Six.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SIX MINUTES]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 243}},
{"beat_id": "CH00_C01_L0071", "speaker_id": "cyanis", "text": "Why six?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SIX MINUTES]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 245}},
{"beat_id": "CH00_C01_L0072", "speaker_id": "ilyra", "text": "Five sounds planned. Like you picked a respectable unit, turned resting into a task, and intend to congratulate yourself when you finish it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SIX MINUTES]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 247}},
{"beat_id": "CH00_C01_L0073", "speaker_id": "cyanis", "text": "That's uncomfortably plausible.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SIX MINUTES]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 251}},
{"beat_id": "CH00_C01_L0074", "speaker_id": "ilyra", "text": "Six is stupid enough that it can't pretend to be efficient.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SIX MINUTES]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 253}},
{"beat_id": "CH00_C01_L0075", "speaker_id": "cyanis", "text": "Six minutes of aggressively unplanned nothing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SIX MINUTES]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 255}},
{"beat_id": "CH00_C01_L0076", "speaker_id": "ilyra", "text": "You made it sound like work again.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SIX MINUTES]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 257}},
{"beat_id": "CH00_C01_L0077", "speaker_id": "cyanis", "text": "Right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SIX MINUTES]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 259}},
{"beat_id": "CH00_C01_L0078", "speaker_id": "cyanis", "text": "Six minutes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SIX MINUTES]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 263}},
{"beat_id": "CH00_C01_L0079", "speaker_id": "ilyra", "text": "Better.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SIX MINUTES]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/C01_SIX_MINUTES_DIALOGUE.md", "source_line": 265}}
