beats = [
{"beat_id": "CH00_P06_L0001", "speaker_id": "convoy_officer", "text": "East cut!", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FINAL PUSH — STORY TRIGGER]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 19}},
{"beat_id": "CH00_P06_L0002", "speaker_id": "cyanis", "text": "That's not a damn hound.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FINAL PUSH — STORY TRIGGER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 23}},
{"beat_id": "CH00_P06_L0003", "speaker_id": "ilyra", "text": "No. And the bastard behind it didn't bring it here to negotiate.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FINAL PUSH — STORY TRIGGER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 27}},
{"beat_id": "CH00_P06_L0004", "speaker_id": "convoy_officer", "text": "Riftmaw! Sorcerer behind it!", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FINAL PUSH — STORY TRIGGER]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 29}},
{"beat_id": "CH00_P06_L0005", "speaker_id": "cyanis", "text": "Everybody behind stone. Nobody follows us out. If the line breaks, fall back toward the relay, not the road.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FINAL PUSH — STORY TRIGGER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 35}},
{"beat_id": "CH00_P06_L0006", "speaker_id": "ilyra", "text": "Keep the lane behind me clear. If I have to move someone, I need to know the space is there before I turn around with a body in my hands.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FINAL PUSH — STORY TRIGGER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 37}},
{"beat_id": "CH00_P06_L0007", "speaker_id": "cyanis", "text": "You have it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FINAL PUSH — STORY TRIGGER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 39}},
{"beat_id": "CH00_P06_L0008", "speaker_id": "ilyra", "text": "There. Same feeling as before?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FINAL PUSH — STORY TRIGGER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 47}},
{"beat_id": "CH00_P06_L0009", "speaker_id": "cyanis", "text": "Close enough.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FINAL PUSH — STORY TRIGGER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH00_P06_L0010", "speaker_id": "ilyra", "text": "No. Don't give me `close enough` because the thing trying to kill us is large. Same dizziness? Same pulse jump? Same arm response?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FINAL PUSH — STORY TRIGGER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 51}},
{"beat_id": "CH00_P06_L0011", "speaker_id": "cyanis", "text": "Dizziness is the same. Pulse feels fast. Arm isn't different from thirty seconds ago.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FINAL PUSH — STORY TRIGGER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 55}},
{"beat_id": "CH00_P06_L0012", "speaker_id": "ilyra", "text": "Better. If any of that changes, say it even if I'm in the middle of something.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FINAL PUSH — STORY TRIGGER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 57}},
{"beat_id": "CH00_P06_L0013", "speaker_id": "cyanis", "text": "I will.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FINAL PUSH — STORY TRIGGER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH00_P06_L0014", "speaker_id": "cyanis", "text": "Whatever the hell that is, it's helping the line. Use it while it's here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FINAL PUSH — STORY TRIGGER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 65}},
{"beat_id": "CH00_P06_L0015", "speaker_id": "ilyra", "text": "Already planning to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FINAL PUSH — STORY TRIGGER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 67}},
{"beat_id": "CH00_P06_L0016", "speaker_id": "cyanis", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FINAL PUSH — STORY TRIGGER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 69}},
{"beat_id": "CH00_P06_L0017", "speaker_id": "ilyra", "text": "Don't sound surprised.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FINAL PUSH — STORY TRIGGER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 71}},
{"beat_id": "CH00_P06_L0018", "speaker_id": "convoy_officer", "text": "They're pulling back.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 127}},
{"beat_id": "CH00_P06_L0019", "speaker_id": "cyanis", "text": "Let them. Nobody chases.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 131}},
{"beat_id": "CH00_P06_L0020", "speaker_id": "ilyra", "text": "Look at me. Both eyes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 137}},
{"beat_id": "CH00_P06_L0021", "speaker_id": "cyanis", "text": "There are two of you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 143}},
{"beat_id": "CH00_P06_L0022", "speaker_id": "cyanis", "text": "Kidding.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 147}},
{"beat_id": "CH00_P06_L0023", "speaker_id": "ilyra", "text": "Don't do that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 151}},
{"beat_id": "CH00_P06_L0024", "speaker_id": "ilyra", "text": "I have no idea what that light did to you. If you joke about seeing double, I have to stop and work out whether you're being an asshole or whether something in your head just changed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 155}},
{"beat_id": "CH00_P06_L0025", "speaker_id": "cyanis", "text": "You're right. Sorry.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 159}},
{"beat_id": "CH00_P06_L0026", "speaker_id": "ilyra", "text": "Again. What do you see?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 163}},
{"beat_id": "CH00_P06_L0027", "speaker_id": "cyanis", "text": "One of you. Camp behind you. Officer to your left. Everything else where it should be.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 165}},
{"beat_id": "CH00_P06_L0028", "speaker_id": "ilyra", "text": "Any new numbness?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 167}},
{"beat_id": "CH00_P06_L0029", "speaker_id": "cyanis", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 169}},
{"beat_id": "CH00_P06_L0030", "speaker_id": "ilyra", "text": "Dizziness?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 171}},
{"beat_id": "CH00_P06_L0031", "speaker_id": "cyanis", "text": "Still there. Not worse.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 173}},
{"beat_id": "CH00_P06_L0032", "speaker_id": "ilyra", "text": "Good enough to move. Not good enough to forget.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 175}},
{"beat_id": "CH00_P06_L0033", "speaker_id": "cyanis", "text": "Camp?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 179}},
{"beat_id": "CH00_P06_L0034", "speaker_id": "ilyra", "text": "Still ours. Wounded are moving where they're supposed to. Nobody obvious went down while we were occupied.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 183}},
{"beat_id": "CH00_P06_L0035", "speaker_id": "cyanis", "text": "The case is done.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 189}},
{"beat_id": "CH00_P06_L0036", "speaker_id": "ilyra", "text": "Completely.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 191}},
{"beat_id": "CH00_P06_L0037", "speaker_id": "cyanis", "text": "Card looks intact.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 193}},
{"beat_id": "CH00_P06_L0038", "speaker_id": "ilyra", "text": "Looks intact. Leave it that way. I'm not poking unexplained magic in the middle of the damn road.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 195}},
{"beat_id": "CH00_P06_L0039", "speaker_id": "cyanis", "text": "Strongly agree.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 197}},
{"beat_id": "CH00_P06_L0040", "speaker_id": "cyanis", "text": "Nothing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 207}},
{"beat_id": "CH00_P06_L0041", "speaker_id": "ilyra", "text": "Good. Put it somewhere you can keep it without dropping it and leave `nothing` alone.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 209}},
{"beat_id": "CH00_P06_L0042", "speaker_id": "cyanis", "text": "You really don't like experiments.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 211}},
{"beat_id": "CH00_P06_L0043", "speaker_id": "ilyra", "text": "I like experiments when the subject isn't a tired man standing in a wreck field after being hit by unexplained magic twice.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 213}},
{"beat_id": "CH00_P06_L0044", "speaker_id": "cyanis", "text": "Yeah, okay.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BOSS VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 215}},
{"beat_id": "CH00_P06_L0045", "speaker_id": "convoy_officer", "text": "We count people first. Whatever that thing is, it can wait until nobody's bleeding in the road. I don't want anybody deciding surviving the fight made them a scholar.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HANDOFF — AFTERMATH]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 229}},
{"beat_id": "CH00_P06_L0046", "speaker_id": "cyanis", "text": "Happily.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HANDOFF — AFTERMATH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 233}},
{"beat_id": "CH00_P06_L0047", "speaker_id": "ilyra", "text": "I'll check him properly after we've got the wounded moving. Until then, if he tries to disappear into useful work, send him back.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HANDOFF — AFTERMATH]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 235}},
{"beat_id": "CH00_P06_L0048", "speaker_id": "cyanis", "text": "I'm standing right here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HANDOFF — AFTERMATH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 239}},
{"beat_id": "CH00_P06_L0049", "speaker_id": "ilyra", "text": "Good. Saves time.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HANDOFF — AFTERMATH]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 241}},
{"beat_id": "CH00_P06_L0050", "speaker_id": "convoy_officer", "text": "You heard the Warden.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HANDOFF — AFTERMATH]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 245}},
{"beat_id": "CH00_P06_L0051", "speaker_id": "cyanis", "text": "Apparently everyone has.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HANDOFF — AFTERMATH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 247}},
{"beat_id": "CH00_P06_L0052", "speaker_id": "ilyra", "text": "Excellent.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HANDOFF — AFTERMATH]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P06_RIFTMAW_WAR_SORCERER_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 249}}
