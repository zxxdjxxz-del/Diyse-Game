authoring_notes = "CURRENT runtime dialogue compiled from docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md. docs/03_DIALOGUE/PRODUCTION is exact spoken-wording authority; legacy S001-S021 Resources are not source authority. Source SHA-256: 6400086443d8ceda4b330bdfbc2159701c4df3b3a0643e4282b81d395562db94. Spoken-sequence SHA-256: 1dc9ec2189b417fe95be0d8b48e8f66838cc9c8afb44c1d3860ac89928bb3d9d. Spoken lines: 27."
beats = [
{"beat_id": "CH00_P01_L0001", "speaker_id": "convoy_officer", "text": "Dovaren. East side. Keep the travelers off the recovery wagon, and before you tell me you've already done it—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 17}},
{"beat_id": "CH00_P01_L0002", "speaker_id": "cyanis", "text": "Already moved them down the shoulder.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 19}},
{"beat_id": "CH00_P01_L0003", "speaker_id": "convoy_officer", "text": "I had six more words.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 23}},
{"beat_id": "CH00_P01_L0004", "speaker_id": "cyanis", "text": "Sorry.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 25}},
{"beat_id": "CH00_P01_L0005", "speaker_id": "cyanis", "text": "Mostly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 29}},
{"beat_id": "CH00_P01_L0006", "speaker_id": "convoy_officer", "text": "There it is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 31}},
{"beat_id": "CH00_P01_L0007", "speaker_id": "convoy_officer", "text": "Recovery team says the casing shifted again. Nothing dramatic. Enough that they're nervous.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 35}},
{"beat_id": "CH00_P01_L0008", "speaker_id": "cyanis", "text": "Seal still holding?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 37}},
{"beat_id": "CH00_P01_L0009", "speaker_id": "convoy_officer", "text": "Holding.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 39}},
{"beat_id": "CH00_P01_L0010", "speaker_id": "cyanis", "text": "Then they can be nervous all the damn way to Caelora. I'm not opening an unknown recovery case on the road because it rattled.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 41}},
{"beat_id": "CH00_P01_L0011", "speaker_id": "convoy_officer", "text": "Good. I was hoping not to have that argument with you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 43}},
{"beat_id": "CH00_P01_L0012", "speaker_id": "cyanis", "text": "You would've won.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 45}},
{"beat_id": "CH00_P01_L0013", "speaker_id": "convoy_officer", "text": "Eventually.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 47}},
{"beat_id": "CH00_P01_L0014", "speaker_id": "cyanis", "text": "Sir.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 55}},
{"beat_id": "CH00_P01_L0015", "speaker_id": "convoy_officer", "text": "What?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH00_P01_L0016", "speaker_id": "cyanis", "text": "How long since we passed anyone coming back this way?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 61}},
{"beat_id": "CH00_P01_L0017", "speaker_id": "convoy_officer", "text": "A while.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 65}},
{"beat_id": "CH00_P01_L0018", "speaker_id": "cyanis", "text": "Longer than a while. No courier, no wagon, no farm traffic. Nothing since the bend.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 67}},
{"beat_id": "CH00_P01_L0019", "speaker_id": "convoy_officer", "text": "Road could just be empty.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 69}},
{"beat_id": "CH00_P01_L0020", "speaker_id": "cyanis", "text": "Could be. Still feels crooked as shit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 71}},
{"beat_id": "CH00_P01_L0021", "speaker_id": "cyanis", "text": "Hold the column.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 75}},
{"beat_id": "CH00_P01_L0022", "speaker_id": "convoy_officer", "text": "You're asking me to stop every wagon because the road feels wrong.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 79}},
{"beat_id": "CH00_P01_L0023", "speaker_id": "cyanis", "text": "I'm asking you to stop them while we're still together. If it's nothing, we lose a minute and you can remind me about it for the rest of the trip.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 81}},
{"beat_id": "CH00_P01_L0024", "speaker_id": "convoy_officer", "text": "Tempting offer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 85}},
{"beat_id": "CH00_P01_L0025", "speaker_id": "convoy_officer", "text": "Column, halt!", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 89}},
{"beat_id": "CH00_P01_L0026", "speaker_id": "convoy_officer", "text": "Dovaren! East side!", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 95}},
{"beat_id": "CH00_P01_L0027", "speaker_id": "cyanis", "text": "Stone line! Stay low! If you can move, help somebody who can't! Go!", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED OPENING — WESTWAYS CONVOY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P01_CONVOY_OPENING_AMBUSH_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 97}}
]
