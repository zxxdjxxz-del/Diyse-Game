authoring_notes = "CURRENT runtime dialogue compiled from docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md. docs/03_DIALOGUE/PRODUCTION is exact spoken-wording authority; legacy S001-S021 Resources are not source authority. Source SHA-256: 70c62c84cd0bcf7b2c4beaef92b43b475fbcb4c2895172b69133c0da90d7ed64. Spoken-sequence SHA-256: c8e1490e202044107fb67e712f819b523da6c17707ded008404f6ab0808c5927. Spoken lines: 67."
beats = [
{"beat_id": "CH00_B04_L0001", "speaker_id": "ilyra", "text": "Walking wounded by the blue cloth. If you can stand without falling over, help somebody who can't. Nobody moves her yet—not the blanket, not the board, not her because you think you're helping.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIELD TRIAGE CAMP]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 21}},
{"beat_id": "CH00_B04_L0002", "speaker_id": "cyanis", "text": "I need this clear before the east side collapses into it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIELD TRIAGE CAMP]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 25}},
{"beat_id": "CH00_B04_L0003", "speaker_id": "ilyra", "text": "Then move the crates.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIELD TRIAGE CAMP]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 29}},
{"beat_id": "CH00_B04_L0004", "speaker_id": "cyanis", "text": "She can't move?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIELD TRIAGE CAMP]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 31}},
{"beat_id": "CH00_B04_L0005", "speaker_id": "ilyra", "text": "Not safely. Her breathing gets worse every time the torso shifts, and I don't have enough hands or information to gamble on whether the next move makes that permanent. Give me a stable surface and a few minutes. You can have the lane around her.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIELD TRIAGE CAMP]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 35}},
{"beat_id": "CH00_B04_L0006", "speaker_id": "cyanis", "text": "All right. Crates move. Leave her where she is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIELD TRIAGE CAMP]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 39}},
{"beat_id": "CH00_B04_L0007", "speaker_id": "cyanis", "text": "Not by yourself. Get help or leave it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIELD TRIAGE CAMP]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 43}},
{"beat_id": "CH00_B04_L0008", "speaker_id": "ilyra", "text": "Good rule.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIELD TRIAGE CAMP]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 47}},
{"beat_id": "CH00_B04_L0009", "speaker_id": "cyanis", "text": "Been a popular one today.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIELD TRIAGE CAMP]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 49}},
{"beat_id": "CH00_B04_L0010", "speaker_id": "cyanis", "text": "East side's thin. How much room do you need behind the wagon if I pull the line closer?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 61}},
{"beat_id": "CH00_B04_L0011", "speaker_id": "ilyra", "text": "Eight paces if you want me to move two stretchers past each other without turning either patient sideways.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 65}},
{"beat_id": "CH00_B04_L0012", "speaker_id": "cyanis", "text": "Seven keeps the west corner covered. I can give you eight for a few minutes, but if the pressure shifts south I need one back.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 67}},
{"beat_id": "CH00_B04_L0013", "speaker_id": "ilyra", "text": "Seven now. If I call for eight, I mean immediately.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 71}},
{"beat_id": "CH00_B04_L0014", "speaker_id": "cyanis", "text": "Done.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 73}},
{"beat_id": "CH00_B04_L0015", "speaker_id": "ilyra", "text": "Your left arm's shaking.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 77}},
{"beat_id": "CH00_B04_L0016", "speaker_id": "cyanis", "text": "Still works.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 81}},
{"beat_id": "CH00_B04_L0017", "speaker_id": "ilyra", "text": "I didn't ask whether it works. I asked because the tremor is worse than it was when you came in. Pain, weakness, or both?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 83}},
{"beat_id": "CH00_B04_L0018", "speaker_id": "cyanis", "text": "Mostly pain.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 85}},
{"beat_id": "CH00_B04_L0019", "speaker_id": "ilyra", "text": "Mostly is doing some bullshit work there.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 87}},
{"beat_id": "CH00_B04_L0020", "speaker_id": "cyanis", "text": "Pain. Some weakness when I lift it high. No numbness.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 91}},
{"beat_id": "CH00_B04_L0021", "speaker_id": "ilyra", "text": "Better. Don't keep testing it just because I asked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 93}},
{"beat_id": "CH00_B04_L0022", "speaker_id": "cyanis", "text": "Name?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 99}},
{"beat_id": "CH00_B04_L0023", "speaker_id": "ilyra", "text": "Amarin. Ilyra, if nobody's shouting rank at me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 101}},
{"beat_id": "CH00_B04_L0024", "speaker_id": "cyanis", "text": "Cyanis Dovaren.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 103}},
{"beat_id": "CH00_B04_L0025", "speaker_id": "ilyra", "text": "I know. You've been getting yelled at across the entire wreck field.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 105}},
{"beat_id": "CH00_B04_L0026", "speaker_id": "cyanis", "text": "Good to know my reputation arrived first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 107}},
{"beat_id": "CH00_B04_L0027", "speaker_id": "ilyra", "text": "Your reputation is currently \"man people keep shouting at who then runs toward the problem.\"", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 109}},
{"beat_id": "CH00_B04_L0028", "speaker_id": "cyanis", "text": "I've had worse.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 111}},
{"beat_id": "CH00_B04_L0029", "speaker_id": "ilyra", "text": "I'm sure.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SECOND STORY STOP — SHARED SPACE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 113}},
{"beat_id": "CH00_B04_L0030", "speaker_id": "convoy_officer", "text": "East ridge!", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RENEWED BLACK HOST PRESSURE]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 121}},
{"beat_id": "CH00_B04_L0031", "speaker_id": "cyanis", "text": "Everybody behind the relay wall! If you're carrying someone, don't drop them to get there faster!", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RENEWED BLACK HOST PRESSURE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 125}},
{"beat_id": "CH00_B04_L0032", "speaker_id": "ilyra", "text": "Two stay.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RENEWED BLACK HOST PRESSURE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 127}},
{"beat_id": "CH00_B04_L0033", "speaker_id": "ilyra", "text": "Those two. If I move them now, they may stop breathing before they reach the wall. I can stabilize one here and move the other after, but I need the space to stay mine long enough to do it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RENEWED BLACK HOST PRESSURE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 131}},
{"beat_id": "CH00_B04_L0034", "speaker_id": "cyanis", "text": "Tell me exactly what you need.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RENEWED BLACK HOST PRESSURE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 135}},
{"beat_id": "CH00_B04_L0035", "speaker_id": "ilyra", "text": "Half a minute. Something solid between them and that ridge. And nobody deciding halfway through that panic is faster than my instructions.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RENEWED BLACK HOST PRESSURE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 137}},
{"beat_id": "CH00_B04_L0036", "speaker_id": "cyanis", "text": "You get the half minute.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RENEWED BLACK HOST PRESSURE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 139}},
{"beat_id": "CH00_B04_L0037", "speaker_id": "convoy_officer", "text": "What the hell is that?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RENEWED BLACK HOST PRESSURE]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 151}},
{"beat_id": "CH00_B04_L0038", "speaker_id": "cyanis", "text": "No idea.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RENEWED BLACK HOST PRESSURE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 155}},
{"beat_id": "CH00_B04_L0039", "speaker_id": "ilyra", "text": "Dovaren.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RENEWED BLACK HOST PRESSURE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 159}},
{"beat_id": "CH00_B04_L0040", "speaker_id": "cyanis", "text": "I'm fine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RENEWED BLACK HOST PRESSURE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 161}},
{"beat_id": "CH00_B04_L0041", "speaker_id": "ilyra", "text": "No, you're not. Your pulse jumped when that started and your face just went gray. Look at me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RENEWED BLACK HOST PRESSURE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 163}},
{"beat_id": "CH00_B04_L0042", "speaker_id": "cyanis", "text": "Can you keep me standing long enough to hold the cut?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RENEWED BLACK HOST PRESSURE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 167}},
{"beat_id": "CH00_B04_L0043", "speaker_id": "ilyra", "text": "Yes—for now. You're responsive, your pupils look even, and you're not falling over. That's enough to keep moving. If any of that changes, I tell you to stop and you stop. You don't negotiate because the line is busy.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RENEWED BLACK HOST PRESSURE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 171}},
{"beat_id": "CH00_B04_L0044", "speaker_id": "cyanis", "text": "Works for me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RENEWED BLACK HOST PRESSURE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 173}},
{"beat_id": "CH00_B04_L0045", "speaker_id": "cyanis", "text": "Move them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RENEWED BLACK HOST PRESSURE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 177}},
{"beat_id": "CH00_B04_L0046", "speaker_id": "ilyra", "text": "Cyanis.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 197}},
{"beat_id": "CH00_B04_L0047", "speaker_id": "ilyra", "text": "Look at me. Properly this time.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 201}},
{"beat_id": "CH00_B04_L0048", "speaker_id": "ilyra", "text": "Dizzy? Vision doing anything strange? Hands numb? Hearing normal?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 205}},
{"beat_id": "CH00_B04_L0049", "speaker_id": "cyanis", "text": "Little dizzy. Vision's normal. Hands aren't numb. I can hear you being very specific.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 207}},
{"beat_id": "CH00_B04_L0050", "speaker_id": "ilyra", "text": "Good. That's an actual answer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 209}},
{"beat_id": "CH00_B04_L0051", "speaker_id": "cyanis", "text": "You grading me now?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 211}},
{"beat_id": "CH00_B04_L0052", "speaker_id": "ilyra", "text": "Apparently. You're improving.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 213}},
{"beat_id": "CH00_B04_L0053", "speaker_id": "ilyra", "text": "If your vision narrows, either hand goes numb, the dizziness gets worse, you lose time, or you stop hearing me clearly, you tell me immediately. Not after the next fight. Not when somebody else notices. Immediately.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 217}},
{"beat_id": "CH00_B04_L0054", "speaker_id": "cyanis", "text": "I will.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 219}},
{"beat_id": "CH00_B04_L0055", "speaker_id": "ilyra", "text": "All right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 223}},
{"beat_id": "CH00_B04_L0056", "speaker_id": "cyanis", "text": "I need to hold the cut.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 229}},
{"beat_id": "CH00_B04_L0057", "speaker_id": "ilyra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 231}},
{"beat_id": "CH00_B04_L0058", "speaker_id": "cyanis", "text": "You're staying here?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 235}},
{"beat_id": "CH00_B04_L0059", "speaker_id": "ilyra", "text": "No. These two are stable enough for the next few minutes and I've handed them to people who know what not to do. That line isn't stable. If it folds, every patient I just protected is exposed again, so standing here pretending treatment ends at the blanket would be bullshit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 237}},
{"beat_id": "CH00_B04_L0060", "speaker_id": "cyanis", "text": "You fight.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 241}},
{"beat_id": "CH00_B04_L0061", "speaker_id": "ilyra", "text": "I'm a Warden.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 243}},
{"beat_id": "CH00_B04_L0062", "speaker_id": "cyanis", "text": "Right. Sorry. Hell of a day.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 247}},
{"beat_id": "CH00_B04_L0063", "speaker_id": "ilyra", "text": "You drank nothing, you're bleeding through one sleeve, and something in a recovery case just made your pulse jump. I'll allow one stupid question.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 249}},
{"beat_id": "CH00_B04_L0064", "speaker_id": "cyanis", "text": "Generous.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 251}},
{"beat_id": "CH00_B04_L0065", "speaker_id": "ilyra", "text": "Don't spend it twice. Move, Dovaren.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 253}},
{"beat_id": "CH00_B04_L0066", "speaker_id": "cyanis", "text": "Starting strong, Amarin.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 255}},
{"beat_id": "CH00_B04_L0067", "speaker_id": "ilyra", "text": "You're still standing here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AFTER THE FIRST FLARE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B04_FIELD_TRIAGE_ILYRA_FIRST_FLARE_DIALOGUE.md", "source_line": 257}}
