authoring_notes = "CURRENT runtime dialogue compiled from docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md. docs/03_DIALOGUE/PRODUCTION is exact spoken-wording authority; legacy S001-S021 Resources are not source authority. Source SHA-256: 5b6fe2d0f237bc76072b5684c774c7c1f8840804af33470c1d8a08b467d0af42. Spoken-sequence SHA-256: 317104ce46fb620876f797b9053c75bbb25d1f3a78e8d93ed4f476ec9155477c. Spoken lines: 51."
beats = [
{"beat_id": "CH00_B07_L0001", "speaker_id": "convoy_officer", "text": "Dovaren. Amarin. Give me the field, not the story.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 19}},
{"beat_id": "CH00_B07_L0002", "speaker_id": "cyanis", "text": "East cut's clear. Nobody followed the withdrawal back in. Wreck line is still exposed on the south side, and I haven't checked beyond the last marked wagon because you told me not to turn a sweep into a pursuit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 23}},
{"beat_id": "CH00_B07_L0003", "speaker_id": "convoy_officer", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 25}},
{"beat_id": "CH00_B07_L0004", "speaker_id": "ilyra", "text": "Walking wounded can move if the pace stays slow. Two still can't sit upright, and I don't want either of them bouncing down the road on a wagon yet. Give me enough hands and I can move them flat when the first column goes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 29}},
{"beat_id": "CH00_B07_L0005", "speaker_id": "convoy_officer", "text": "Missing?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 31}},
{"beat_id": "CH00_B07_L0006", "speaker_id": "wounded_escort", "text": "Don't know. Rear roster went with one of the wagons. I can name who was near me, not the whole tail.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "WOUNDED ESCORT", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 35}},
{"beat_id": "CH00_B07_L0007", "speaker_id": "cyanis", "text": "Then we search before dark.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 39}},
{"beat_id": "CH00_B07_L0008", "speaker_id": "convoy_officer", "text": "Brackenwall can send people back at first light.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 41}},
{"beat_id": "CH00_B07_L0009", "speaker_id": "cyanis", "text": "If somebody's pinned, first light is too late. Same if they're bleeding where we can't see them. I'm not asking to chase the bastards north. Give us the wreck line and the ditch, one sweep, then we stop.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 43}},
{"beat_id": "CH00_B07_L0010", "speaker_id": "ilyra", "text": "He's right. We don't need the whole road. We need the places somebody could still be alive and unable to call loudly enough for camp to hear them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 45}},
{"beat_id": "CH00_B07_L0011", "speaker_id": "convoy_officer", "text": "You two met today and you're already taking turns making the same argument.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 49}},
{"beat_id": "CH00_B07_L0012", "speaker_id": "cyanis", "text": "Efficient.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 51}},
{"beat_id": "CH00_B07_L0013", "speaker_id": "ilyra", "text": "Concerning.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 53}},
{"beat_id": "CH00_B07_L0014", "speaker_id": "convoy_officer", "text": "One sweep. South ditch to the wreck markers, no farther. If you see Host stragglers beyond the boundary, you do not decide that technically they're close enough. You turn around.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 57}},
{"beat_id": "CH00_B07_L0015", "speaker_id": "convoy_officer", "text": "That sentence was for you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 61}},
{"beat_id": "CH00_B07_L0016", "speaker_id": "cyanis", "text": "I gathered.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 63}},
{"beat_id": "CH00_B07_L0017", "speaker_id": "ilyra", "text": "I was going to make sure.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 65}},
{"beat_id": "CH00_B07_L0018", "speaker_id": "convoy_officer", "text": "Wonderful. My work here is becoming redundant.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 67}},
{"beat_id": "CH00_B07_L0019", "speaker_id": "convoy_officer", "text": "That stays exactly where it is until Brackenwall. No testing, no handing it around because somebody gets curious, no `just for a second`, and no clever ideas on the road.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 77}},
{"beat_id": "CH00_B07_L0020", "speaker_id": "cyanis", "text": "Happily. I've had enough damn clever magic for one day.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 81}},
{"beat_id": "CH00_B07_L0021", "speaker_id": "ilyra", "text": "No argument from me. Twice was enough. I'm not asking that damn thing for a third demonstration before we have walls and records.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 83}},
{"beat_id": "CH00_B07_L0022", "speaker_id": "convoy_officer", "text": "Good. Brackenwall can decide what to do with it when we have walls, records, and people who aren't half dead.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 85}},
{"beat_id": "CH00_B07_L0023", "speaker_id": "convoy_officer", "text": "Your medical group goes with the first wounded column. You going with them?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 95}},
{"beat_id": "CH00_B07_L0024", "speaker_id": "ilyra", "text": "No. My people can move the wounded without me tonight. I'm staying until morning.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 99}},
{"beat_id": "CH00_B07_L0025", "speaker_id": "cyanis", "text": "You don't have to stay on my account.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 103}},
{"beat_id": "CH00_B07_L0026", "speaker_id": "ilyra", "text": "I'm not. I treated you through both Card responses, and I'm not handing that off blind when I still can't explain them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 107}},
{"beat_id": "CH00_B07_L0027", "speaker_id": "cyanis", "text": "Right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 111}},
{"beat_id": "CH00_B07_L0028", "speaker_id": "ilyra", "text": "And before you find a more respectable way to tell me to go with the column: they have competent people. I am not abandoning patients to stay here. I checked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 115}},
{"beat_id": "CH00_B07_L0029", "speaker_id": "cyanis", "text": "I was going to ask exactly that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 119}},
{"beat_id": "CH00_B07_L0030", "speaker_id": "ilyra", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 121}},
{"beat_id": "CH00_B07_L0031", "speaker_id": "cyanis", "text": "That's becoming unsettling.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 123}},
{"beat_id": "CH00_B07_L0032", "speaker_id": "ilyra", "text": "You're not subtle when you think responsibility belongs entirely to you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 125}},
{"beat_id": "CH00_B07_L0033", "speaker_id": "convoy_officer", "text": "And I assume you're doing the sweep too.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 131}},
{"beat_id": "CH00_B07_L0034", "speaker_id": "ilyra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 133}},
{"beat_id": "CH00_B07_L0035", "speaker_id": "convoy_officer", "text": "Of course you are.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 137}},
{"beat_id": "CH00_B07_L0036", "speaker_id": "ilyra", "text": "You could say no.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 139}},
{"beat_id": "CH00_B07_L0037", "speaker_id": "convoy_officer", "text": "I could. Then I'd have Dovaren in a ditch looking for survivors with nobody there who knows whether the headache he hasn't mentioned yet matters.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 141}},
{"beat_id": "CH00_B07_L0038", "speaker_id": "cyanis", "text": "I don't have a headache.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 145}},
{"beat_id": "CH00_B07_L0039", "speaker_id": "ilyra", "text": "Good. See how easy that was?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 149}},
{"beat_id": "CH00_B07_L0040", "speaker_id": "convoy_officer", "text": "Search first. Argue with me later if you still have the energy.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 153}},
{"beat_id": "CH00_B07_L0041", "speaker_id": "ilyra", "text": "Understood.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 155}},
{"beat_id": "CH00_B07_L0042", "speaker_id": "cyanis", "text": "Yes, sir.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ILYRA'S DECISION]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 157}},
{"beat_id": "CH00_B07_L0043", "speaker_id": "convoy_officer", "text": "First column's moving. Amarin, your people have the two who can't sit upright. Dovaren, you stay here with her until morning, then both of you go to Brackenwall with the Card. If anything happens tonight that can wait until sunrise, it waits until sunrise.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — CONVOY MOVES ON]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 187}},
{"beat_id": "CH00_B07_L0044", "speaker_id": "cyanis", "text": "Understood.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — CONVOY MOVES ON]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 189}},
{"beat_id": "CH00_B07_L0045", "speaker_id": "ilyra", "text": "Agreed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — CONVOY MOVES ON]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 191}},
{"beat_id": "CH00_B07_L0046", "speaker_id": "convoy_officer", "text": "And try not to make the night interesting. I've had enough interesting for one day.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — CONVOY MOVES ON]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 195}},
{"beat_id": "CH00_B07_L0047", "speaker_id": "cyanis", "text": "I'll do my best.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — CONVOY MOVES ON]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 197}},
{"beat_id": "CH00_B07_L0048", "speaker_id": "ilyra", "text": "That's not reassuring.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — CONVOY MOVES ON]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 201}},
{"beat_id": "CH00_B07_L0049", "speaker_id": "cyanis", "text": "I was being sincere.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — CONVOY MOVES ON]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 203}},
{"beat_id": "CH00_B07_L0050", "speaker_id": "ilyra", "text": "That's why it isn't reassuring.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — CONVOY MOVES ON]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 205}},
{"beat_id": "CH00_B07_L0051", "speaker_id": "convoy_officer", "text": "See? She learns quickly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "ROSTER_ADD_ILYRA_PERMANENT", "STORY_CHAPTER_00_COMPLETE", "ROUTE_BRACKENWALL_UNLOCKED", "UNLOCK_C01_SIX_MINUTES"], "source_section": "[STORY TRIGGER — CONVOY MOVES ON]", "source_speaker_label": "CONVOY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/CH00_B07_AFTERMATH_SURVIVOR_RECOVERY_DIALOGUE.md", "source_line": 209}}
