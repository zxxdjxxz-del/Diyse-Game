beats = [
{"beat_id": "CH00_P05_L0001", "speaker_id": "cyanis", "text": "Host. One coming in alone.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE PURSUER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 33}},
{"beat_id": "CH00_P05_L0002", "speaker_id": "ilyra", "text": "I see him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE PURSUER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 37}},
{"beat_id": "CH00_P05_L0003", "speaker_id": "cyanis", "text": "No bow support. No visible line behind him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE PURSUER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 41}},
{"beat_id": "CH00_P05_L0004", "speaker_id": "ilyra", "text": "You're saying that like it's reassuring.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE PURSUER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 43}},
{"beat_id": "CH00_P05_L0005", "speaker_id": "cyanis", "text": "I'm saying it because I don't know what the hell he's doing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE PURSUER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 45}},
{"beat_id": "CH00_P05_L0006", "speaker_id": "ilyra", "text": "Better reason.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE PURSUER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH00_P05_L0007", "speaker_id": "cyanis", "text": "Camp stays behind us. If he tries to pull us away from it, we don't go.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE PURSUER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 51}},
{"beat_id": "CH00_P05_L0008", "speaker_id": "ilyra", "text": "Agreed. I'm not chasing a man who volunteered to be the only obvious target.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE PURSUER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 53}},
{"beat_id": "CH00_P05_L0009", "speaker_id": "cyanis", "text": "Suspicious by profession?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE PURSUER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 57}},
{"beat_id": "CH00_P05_L0010", "speaker_id": "ilyra", "text": "No. Today has been educational.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE PURSUER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH00_P05_L0011", "speaker_id": "cyanis", "text": "He's leaving.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED DISENGAGEMENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 79}},
{"beat_id": "CH00_P05_L0012", "speaker_id": "ilyra", "text": "Let him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED DISENGAGEMENT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 81}},
{"beat_id": "CH00_P05_L0013", "speaker_id": "cyanis", "text": "I am.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED DISENGAGEMENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 85}},
{"beat_id": "CH00_P05_L0014", "speaker_id": "ilyra", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED DISENGAGEMENT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 87}},
{"beat_id": "CH00_P05_L0015", "speaker_id": "cyanis", "text": "You thought I was going after him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED DISENGAGEMENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 89}},
{"beat_id": "CH00_P05_L0016", "speaker_id": "ilyra", "text": "I met you less than an hour ago and watched you argue against a chase, then put yourself on the forward line twice. I was keeping the possibility open.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED DISENGAGEMENT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 91}},
{"beat_id": "CH00_P05_L0017", "speaker_id": "cyanis", "text": "That's unfairly fast pattern recognition.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED DISENGAGEMENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 95}},
{"beat_id": "CH00_P05_L0018", "speaker_id": "ilyra", "text": "He came here alone, fought until he chose not to, and now he's walking away. I don't want to learn what he wanted by following him into the part he picked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED DISENGAGEMENT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 97}},
{"beat_id": "CH00_P05_L0019", "speaker_id": "cyanis", "text": "Neither do I.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED DISENGAGEMENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 101}},
{"beat_id": "CH00_P05_L0020", "speaker_id": "ilyra", "text": "Good. I'd hate for our first disagreement to be that stupid.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED DISENGAGEMENT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 103}},
{"beat_id": "CH00_P05_L0021", "speaker_id": "cyanis", "text": "Ambitious to assume we'll find a better one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED DISENGAGEMENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 107}},
{"beat_id": "CH00_P05_L0022", "speaker_id": "ilyra", "text": "Give it time.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED DISENGAGEMENT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 109}},
{"beat_id": "CH00_P05_L0023", "speaker_id": "ilyra", "text": "Look at that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NONCOMBAT RESET — TRIAGE LINE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 129}},
{"beat_id": "CH00_P05_L0024", "speaker_id": "cyanis", "text": "Don't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NONCOMBAT RESET — TRIAGE LINE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 131}},
{"beat_id": "CH00_P05_L0025", "speaker_id": "ilyra", "text": "I didn't say anything.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NONCOMBAT RESET — TRIAGE LINE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 133}},
{"beat_id": "CH00_P05_L0026", "speaker_id": "cyanis", "text": "You were about to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NONCOMBAT RESET — TRIAGE LINE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 135}},
{"beat_id": "CH00_P05_L0027", "speaker_id": "ilyra", "text": "I was thinking.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NONCOMBAT RESET — TRIAGE LINE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 137}},
{"beat_id": "CH00_P05_L0028", "speaker_id": "cyanis", "text": "Worse.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NONCOMBAT RESET — TRIAGE LINE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 139}},
{"beat_id": "CH00_P05_L0029", "speaker_id": "cyanis", "text": "You think he wanted us to follow?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NONCOMBAT RESET — TRIAGE LINE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 147}},
{"beat_id": "CH00_P05_L0030", "speaker_id": "ilyra", "text": "I think he left when he meant to leave. That's enough reason for me not to give him the next choice too.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NONCOMBAT RESET — TRIAGE LINE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 151}},
{"beat_id": "CH00_P05_L0031", "speaker_id": "cyanis", "text": "You're comfortable with not knowing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NONCOMBAT RESET — TRIAGE LINE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 153}},
{"beat_id": "CH00_P05_L0032", "speaker_id": "ilyra", "text": "Absolutely not. I hate not knowing. I just hate inventing an answer because uncertainty is irritating.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NONCOMBAT RESET — TRIAGE LINE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 155}},
{"beat_id": "CH00_P05_L0033", "speaker_id": "cyanis", "text": "That's annoyingly reasonable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NONCOMBAT RESET — TRIAGE LINE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 159}},
{"beat_id": "CH00_P05_L0034", "speaker_id": "ilyra", "text": "I get that a lot.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NONCOMBAT RESET — TRIAGE LINE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 161}},
{"beat_id": "CH00_P05_L0035", "speaker_id": "cyanis", "text": "Less dizzy. Arm hurts more, weakness isn't worse, still no numbness.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NONCOMBAT RESET — TRIAGE LINE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 167}},
{"beat_id": "CH00_P05_L0036", "speaker_id": "ilyra", "text": "I wasn't going to ask yet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NONCOMBAT RESET — TRIAGE LINE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 171}},
{"beat_id": "CH00_P05_L0037", "speaker_id": "cyanis", "text": "Ruined the moment, then.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NONCOMBAT RESET — TRIAGE LINE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 173}},
{"beat_id": "CH00_P05_L0038", "speaker_id": "ilyra", "text": "Completely. I was enjoying having a conversation that wasn't about your symptoms.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NONCOMBAT RESET — TRIAGE LINE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_00/P05_CONCEALED_RUIN_VANGUARD_REHEARSAL_FIRST_DRAFT_A.md", "source_line": 175}},
