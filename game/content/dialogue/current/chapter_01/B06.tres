beats = [
{"beat_id": "CH01_B06_L0001", "speaker_id": "torren", "text": "That's not fort work anymore. Fort was built around this.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRIEF REACTION — EXCAVATION TRANSITION]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_06_HOLLOW_WATCH_EXCAVATION_DRAFT_A.md", "source_line": 31}},
{"beat_id": "CH01_B06_L0002", "speaker_id": "maevra", "text": "Host kept cutting anyway.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRIEF REACTION — EXCAVATION TRANSITION]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_06_HOLLOW_WATCH_EXCAVATION_DRAFT_A.md", "source_line": 33}},
{"beat_id": "CH01_B06_L0003", "speaker_id": "cyanis", "text": "Evacuation?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ENVIRONMENTAL DISCOVERY — CIVILIAN-USE RELIEF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_06_HOLLOW_WATCH_EXCAVATION_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH01_B06_L0004", "speaker_id": "torren", "text": "Maybe. They're moving both ways. Could've been people getting out, moving between places, sheltering. Relief doesn't tell us which.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ENVIRONMENTAL DISCOVERY — CIVILIAN-USE RELIEF]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_06_HOLLOW_WATCH_EXCAVATION_DRAFT_A.md", "source_line": 53}},
{"beat_id": "CH01_B06_L0005", "speaker_id": "ilyra", "text": "But they expected people who couldn't move on their own.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ENVIRONMENTAL DISCOVERY — CIVILIAN-USE RELIEF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_06_HOLLOW_WATCH_EXCAVATION_DRAFT_A.md", "source_line": 57}},
{"beat_id": "CH01_B06_L0006", "speaker_id": "maevra", "text": "And a lot of them. That's enough for now.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ENVIRONMENTAL DISCOVERY — CIVILIAN-USE RELIEF]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_06_HOLLOW_WATCH_EXCAVATION_DRAFT_A.md", "source_line": 61}}
]
