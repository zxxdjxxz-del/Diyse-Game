beats = [
{"beat_id": "CH01_B02_L0001", "speaker_id": "cyanis", "text": "How much farther?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HALFWAY STOP]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DIALOGUE.md", "source_line": 21}},
{"beat_id": "CH01_B02_L0002", "speaker_id": "maevra", "text": "Not much. Greenhollow's straightforward from here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HALFWAY STOP]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DIALOGUE.md", "source_line": 23}},
{"beat_id": "CH01_B02_L0003", "speaker_id": "ilyra", "text": "You say that like the first half wasn't a pain in the ass.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HALFWAY STOP]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DIALOGUE.md", "source_line": 25}},
{"beat_id": "CH01_B02_L0004", "speaker_id": "maevra", "text": "It wasn't difficult. It was Briar.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HALFWAY STOP]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DIALOGUE.md", "source_line": 27}},
{"beat_id": "CH01_B02_L0005", "speaker_id": "cyanis", "text": "Useful distinction.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HALFWAY STOP]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DIALOGUE.md", "source_line": 29}},
{"beat_id": "CH01_B02_L0006", "speaker_id": "maevra", "text": "You'll appreciate it later. This stretch I trust. South of Greenhollow, I don't trust my memory that much anymore.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HALFWAY STOP]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DIALOGUE.md", "source_line": 31}},
{"beat_id": "CH01_B02_L0007", "speaker_id": "ilyra", "text": "Changed that much?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HALFWAY STOP]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DIALOGUE.md", "source_line": 33}},
{"beat_id": "CH01_B02_L0008", "speaker_id": "maevra", "text": "Not all at once. That's the problem. One washout, one new cut, one route people stop using—and six months later you're confidently wrong.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HALFWAY STOP]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DIALOGUE.md", "source_line": 35}},
{"beat_id": "CH01_B02_L0009", "speaker_id": "maevra", "text": "That's why I want Torren. He spends more time out there than I do.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HALFWAY STOP]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DIALOGUE.md", "source_line": 39}},
{"beat_id": "CH01_B02_L0010", "speaker_id": "ilyra", "text": "Useful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HALFWAY STOP]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DIALOGUE.md", "source_line": 41}},
{"beat_id": "CH01_B02_L0011", "speaker_id": "maevra", "text": "Very.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HALFWAY STOP]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DIALOGUE.md", "source_line": 43}},
{"beat_id": "CH01_B02_L0012", "speaker_id": "maevra", "text": "Come on. Greenhollow before this becomes a briefing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HALFWAY STOP]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DIALOGUE.md", "source_line": 47}},
{"beat_id": "CH01_B02_L0013", "speaker_id": "ilyra", "text": "You started it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HALFWAY STOP]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DIALOGUE.md", "source_line": 49}},
{"beat_id": "CH01_B02_L0014", "speaker_id": "maevra", "text": "And I'm ending it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HALFWAY STOP]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DIALOGUE.md", "source_line": 51}}
]
