authoring_notes = "CURRENT runtime dialogue compiled from docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md. docs/03_DIALOGUE/PRODUCTION is exact spoken-wording authority; legacy S001-S021 Resources are not source authority. Source SHA-256: b98ded6538882566e68cadb3466964b6332a3730c9680924f00c348a8e5e4dae. Spoken-sequence SHA-256: 512be50c74f293e1ba4045fb99390731be7d6de3e1643846545ebe14e4250787. Spoken lines: 46."
beats = [
{"beat_id": "CH01_B02_L0001", "speaker_id": "maevra", "text": "Keep east here. The west line looks easier because people keep walking it, and people keep walking it because it looks easier. Then the ground drops and everybody acts surprised.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 35}},
{"beat_id": "CH01_B02_L0002", "speaker_id": "cyanis", "text": "You sound like you've had that argument before.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 37}},
{"beat_id": "CH01_B02_L0003", "speaker_id": "maevra", "text": "Several times. Once with Torren for an hour, which was especially irritating because he agreed with me from the beginning and just disliked the reason I gave.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 39}},
{"beat_id": "CH01_B02_L0004", "speaker_id": "ilyra", "text": "What was wrong with the reason?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 41}},
{"beat_id": "CH01_B02_L0005", "speaker_id": "maevra", "text": "I said the west line was bad because it washed out every wet season. He said that wasn't useful because it hadn't rained enough yet that year. Then he spent the next forty minutes explaining soil, runoff, root hold, two old wagon cuts, and why the road was still bad for a completely different reason.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 43}},
{"beat_id": "CH01_B02_L0006", "speaker_id": "cyanis", "text": "And he was right?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 45}},
{"beat_id": "CH01_B02_L0007", "speaker_id": "maevra", "text": "Unfortunately. That's the problem with Torren. The bastard earns too many of his objections.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 47}},
{"beat_id": "CH01_B02_L0008", "speaker_id": "ilyra", "text": "Forty minutes about soil.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 51}},
{"beat_id": "CH01_B02_L0009", "speaker_id": "maevra", "text": "Closer to forty-two, if you want to make it worse.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 53}},
{"beat_id": "CH01_B02_L0010", "speaker_id": "ilyra", "text": "I do, actually. I'm beginning to look forward to meeting him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 55}},
{"beat_id": "CH01_B02_L0011", "speaker_id": "maevra", "text": "That's because you haven't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 57}},
{"beat_id": "CH01_B02_L0012", "speaker_id": "cyanis", "text": "I'm getting mixed advertising here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH01_B02_L0013", "speaker_id": "maevra", "text": "It's accurate advertising.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 61}},
{"beat_id": "CH01_B02_L0014", "speaker_id": "maevra", "text": "Stay high until the trees open. Don't cut down toward the old road even if it looks faster.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE — LATER]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 89}},
{"beat_id": "CH01_B02_L0015", "speaker_id": "cyanis", "text": "You know all of this from memory?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE — LATER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 91}},
{"beat_id": "CH01_B02_L0016", "speaker_id": "maevra", "text": "This stretch, mostly. I used it enough when I was younger. But memory is exactly why I stop trusting myself farther south. A road can keep the same name for twenty years while the useful part moves fifty paces sideways.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE — LATER]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 93}},
{"beat_id": "CH01_B02_L0017", "speaker_id": "ilyra", "text": "Because the old path fails and people make another one beside it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE — LATER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 95}},
{"beat_id": "CH01_B02_L0018", "speaker_id": "maevra", "text": "Or a farmer fences it, or a storm eats half of it, or somebody builds a bridge that lasts eight years and then everybody keeps saying `bridge road` for twelve years after the bridge is gone. That's why paper and memory both get dangerous if nobody checks the ground.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE — LATER]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 97}},
{"beat_id": "CH01_B02_L0019", "speaker_id": "cyanis", "text": "And Torren checks it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE — LATER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 99}},
{"beat_id": "CH01_B02_L0020", "speaker_id": "maevra", "text": "Constantly. Sometimes before breakfast, because he has poor priorities.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE — LATER]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 101}},
{"beat_id": "CH01_B02_L0021", "speaker_id": "ilyra", "text": "If he starts a forty-minute soil argument with me before breakfast, I'm throwing him down the easier-looking road.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE — LATER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 103}},
{"beat_id": "CH01_B02_L0022", "speaker_id": "maevra", "text": "You may get along after all.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE — LATER]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 107}},
{"beat_id": "CH01_B02_L0023", "speaker_id": "ilyra", "text": "That sounded like a threat.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE — LATER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 109}},
{"beat_id": "CH01_B02_L0024", "speaker_id": "maevra", "text": "It wasn't entirely one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE — LATER]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 111}},
{"beat_id": "CH01_B02_L0025", "speaker_id": "cyanis", "text": "How bad is the south route right now?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE — LATER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 115}},
{"beat_id": "CH01_B02_L0026", "speaker_id": "maevra", "text": "Bad enough that I don't want to guess. I can tell you what was there the last time I used it. That's not the same thing as telling you what will hold under your feet tomorrow.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE — LATER]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 117}},
{"beat_id": "CH01_B02_L0027", "speaker_id": "cyanis", "text": "And Torren won't have to guess?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE — LATER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 119}},
{"beat_id": "CH01_B02_L0028", "speaker_id": "maevra", "text": "He'll still guess. He'll just tell you exactly which part is guesswork, which part he walked yesterday, and which part some drunk wagoner swears was fine because he survived it once.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE — LATER]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 121}},
{"beat_id": "CH01_B02_L0029", "speaker_id": "ilyra", "text": "All right. That part I like.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE — LATER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 123}},
{"beat_id": "CH01_B02_L0030", "speaker_id": "maevra", "text": "Don't tell him too early.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE — LATER]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 125}},
{"beat_id": "CH01_B02_L0031", "speaker_id": "ilyra", "text": "I haven't even met him and I'm already receiving instructions about managing his ego.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE — LATER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 127}},
{"beat_id": "CH01_B02_L0032", "speaker_id": "cyanis", "text": "Finally, something outside my department.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE — LATER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 129}},
{"beat_id": "CH01_B02_L0033", "speaker_id": "maevra", "text": "Greenhollow.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ENTRY — GREENHOLLOW]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 145}},
{"beat_id": "CH01_B02_L0034", "speaker_id": "cyanis", "text": "That's it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ENTRY — GREENHOLLOW]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 149}},
{"beat_id": "CH01_B02_L0035", "speaker_id": "maevra", "text": "That's a town, yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ENTRY — GREENHOLLOW]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 151}},
{"beat_id": "CH01_B02_L0036", "speaker_id": "cyanis", "text": "I meant the announcement.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ENTRY — GREENHOLLOW]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 153}},
{"beat_id": "CH01_B02_L0037", "speaker_id": "maevra", "text": "Were you expecting trumpets?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ENTRY — GREENHOLLOW]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 155}},
{"beat_id": "CH01_B02_L0038", "speaker_id": "cyanis", "text": "A sign would've been nice.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ENTRY — GREENHOLLOW]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 157}},
{"beat_id": "CH01_B02_L0039", "speaker_id": "ilyra", "text": "There is one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ENTRY — GREENHOLLOW]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 159}},
{"beat_id": "CH01_B02_L0040", "speaker_id": "cyanis", "text": "I meant earlier.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ENTRY — GREENHOLLOW]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_02_BRIAR_PASSAGE_FIRST_TRAVERSAL_DRAFT_A.md", "source_line": 163}},
