beats = [
{"beat_id": "CH01_B05_L0001", "speaker_id": "cyanis", "text": "They're not settling in. Enough people to hold the fort, but everything worth moving is going down.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER FORT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 35}},
{"beat_id": "CH01_B05_L0002", "speaker_id": "maevra", "text": "Agreed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER FORT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 37}},
{"beat_id": "CH01_B05_L0003", "speaker_id": "torren", "text": "Both directions too. People down, emptier crews back up. Supplies keep going below.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER FORT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 41}},
{"beat_id": "CH01_B05_L0004", "speaker_id": "cyanis", "text": "Regular rotation?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER FORT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 43}},
{"beat_id": "CH01_B05_L0005", "speaker_id": "torren", "text": "Could be. Or work gangs. Can't tell from wear alone.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER FORT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 45}},
{"beat_id": "CH01_B05_L0006", "speaker_id": "ilyra", "text": "Miserable way to live in a fort you've already stolen.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER FORT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH01_B05_L0007", "speaker_id": "maevra", "text": "They don't care about living here. Whatever they wanted wasn't the fort.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER FORT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 51}},
{"beat_id": "CH01_B05_L0008", "speaker_id": "cyanis", "text": "Blood.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER FORT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 55}},
{"beat_id": "CH01_B05_L0009", "speaker_id": "ilyra", "text": "Then the stairs can wait.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER FORT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH01_B05_L0010", "speaker_id": "torren", "text": "Agreed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER FORT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 61}},
{"beat_id": "CH01_B05_L0011", "speaker_id": "cyanis", "text": "Anyone?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 93}},
{"beat_id": "CH01_B05_L0012", "speaker_id": "ilyra", "text": "No. Nobody here is alive.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 97}},
{"beat_id": "CH01_B05_L0013", "speaker_id": "torren", "text": "Fuck.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 103}},
{"beat_id": "CH01_B05_L0014", "speaker_id": "maevra", "text": "We don't know whether this is all of them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 109}},
{"beat_id": "CH01_B05_L0015", "speaker_id": "torren", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 113}},
{"beat_id": "CH01_B05_L0016", "speaker_id": "maevra", "text": "Then we finish the fort before we decide what happened to everyone who isn't in this room.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 115}},
{"beat_id": "CH01_B05_L0017", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 119}},
{"beat_id": "CH01_B05_L0018", "speaker_id": "cyanis", "text": "We keep moving. If we find records, prisoner space, anything that changes the count, we stop and reassess.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 123}},
{"beat_id": "CH01_B05_L0019", "speaker_id": "ilyra", "text": "Give me a second.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 127}},
{"beat_id": "CH01_B05_L0020", "speaker_id": "ilyra", "text": "All right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 135}},
{"beat_id": "CH01_B05_L0021", "speaker_id": "cyanis", "text": "Come on.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 137}},
{"beat_id": "CH01_B05_L0022", "speaker_id": "cyanis", "text": "Riveting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WATCH ROOM]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 165}},
{"beat_id": "CH01_B05_L0023", "speaker_id": "maevra", "text": "Everything they logged goes below. Work crews, supplies, watch changes—the surface only matters because it protects the hole.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WATCH ROOM]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 169}},
{"beat_id": "CH01_B05_L0024", "speaker_id": "cyanis", "text": "Then we're done up here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WATCH ROOM]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 171}},
{"beat_id": "CH01_B05_L0025", "speaker_id": "torren", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WATCH ROOM]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 175}},
{"beat_id": "CH01_B05_L0026", "speaker_id": "ilyra", "text": "I preferred the dirt lecture.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WATCH ROOM]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 179}},
{"beat_id": "CH01_B05_L0027", "speaker_id": "torren", "text": "Told you it was useful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WATCH ROOM]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 183}},
{"beat_id": "CH01_B05_L0028", "speaker_id": "ilyra", "text": "I said preferred. Don't get ambitious.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WATCH ROOM]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 185}},
{"beat_id": "CH01_B05_L0029", "speaker_id": "cyanis", "text": "You knew this was here?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — BELOW THE FORT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 217}},
{"beat_id": "CH01_B05_L0030", "speaker_id": "torren", "text": "No. Knew the fort foundations were older in places. Not this. Not anything this big.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — BELOW THE FORT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 221}},
{"beat_id": "CH01_B05_L0031", "speaker_id": "maevra", "text": "Explains the digging gear.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — BELOW THE FORT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 223}},
{"beat_id": "CH01_B05_L0032", "speaker_id": "ilyra", "text": "Whatever they used, preservation wasn't part of the plan.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — BELOW THE FORT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 227}},
{"beat_id": "CH01_B05_L0033", "speaker_id": "cyanis", "text": "Subtle wasn't either.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — BELOW THE FORT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 229}},
{"beat_id": "CH01_B05_L0034", "speaker_id": "torren", "text": "Fresh. Edges haven't weathered and the debris hasn't settled. They opened this after taking the fort.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — BELOW THE FORT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 233}},
{"beat_id": "CH01_B05_L0035", "speaker_id": "cyanis", "text": "Doesn't tell us whether they knew it was here before they attacked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — BELOW THE FORT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 235}},
{"beat_id": "CH01_B05_L0036", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — BELOW THE FORT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 237}},
{"beat_id": "CH01_B05_L0037", "speaker_id": "maevra", "text": "Good distinction.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — BELOW THE FORT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 239}},
{"beat_id": "CH01_B05_L0038", "speaker_id": "torren", "text": "Learned from the annoying people around me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — BELOW THE FORT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 243}},
{"beat_id": "CH01_B05_L0039", "speaker_id": "maevra", "text": "You're welcome.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — BELOW THE FORT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 245}},
{"beat_id": "CH01_B05_L0040", "speaker_id": "ilyra", "text": "That's two of us now. You collect well.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — BELOW THE FORT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 247}},
{"beat_id": "CH01_B05_L0041", "speaker_id": "cyanis", "text": "Whatever they came for, we're behind them now.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — BELOW THE FORT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_05_OCCUPIED_HOLLOW_WATCH_FORT_DRAFT_A.md", "source_line": 251}},
