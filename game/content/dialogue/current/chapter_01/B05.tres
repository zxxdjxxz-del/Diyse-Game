{"beat_id": "CH01_B05_L0001", "speaker_id": "cyanis", "text": "Anyone?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B05_OCCUPIED_HOLLOW_WATCH_FORT_DIALOGUE.md", "source_line": 32}},
{"beat_id": "CH01_B05_L0002", "speaker_id": "ilyra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B05_OCCUPIED_HOLLOW_WATCH_FORT_DIALOGUE.md", "source_line": 36}},
{"beat_id": "CH01_B05_L0003", "speaker_id": "torren", "text": "Fuck.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B05_OCCUPIED_HOLLOW_WATCH_FORT_DIALOGUE.md", "source_line": 42}},
{"beat_id": "CH01_B05_L0004", "speaker_id": "torren", "text": "Should've come sooner.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B05_OCCUPIED_HOLLOW_WATCH_FORT_DIALOGUE.md", "source_line": 46}},
{"beat_id": "CH01_B05_L0005", "speaker_id": "maevra", "text": "You couldn't take that fort alone.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B05_OCCUPIED_HOLLOW_WATCH_FORT_DIALOGUE.md", "source_line": 50}},
{"beat_id": "CH01_B05_L0006", "speaker_id": "torren", "text": "I know. Doesn't make this better.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B05_OCCUPIED_HOLLOW_WATCH_FORT_DIALOGUE.md", "source_line": 52}},
{"beat_id": "CH01_B05_L0007", "speaker_id": "cyanis", "text": "We follow them down.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B05_OCCUPIED_HOLLOW_WATCH_FORT_DIALOGUE.md", "source_line": 60}},
{"beat_id": "CH01_B05_L0008", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B05_OCCUPIED_HOLLOW_WATCH_FORT_DIALOGUE.md", "source_line": 64}},
{"beat_id": "CH01_B05_L0009", "speaker_id": "ilyra", "text": "Give me a second.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B05_OCCUPIED_HOLLOW_WATCH_FORT_DIALOGUE.md", "source_line": 68}},
{"beat_id": "CH01_B05_L0010", "speaker_id": "ilyra", "text": "All right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — GARRISON DISCOVERY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B05_OCCUPIED_HOLLOW_WATCH_FORT_DIALOGUE.md", "source_line": 76}}
