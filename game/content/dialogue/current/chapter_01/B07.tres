beats = [
{"beat_id": "CH01_B07_L0001", "speaker_id": "ilyra", "text": "Same kind of movement as downstairs. More places.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LANDSCAPE DEPICTION]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_HOLLOW_WATCH_LANDSCAPE_DEPICTION_DRAFT_A.md", "source_line": 24}},
{"beat_id": "CH01_B07_L0002", "speaker_id": "maevra", "text": "So it wasn't local.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LANDSCAPE DEPICTION]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_HOLLOW_WATCH_LANDSCAPE_DEPICTION_DRAFT_A.md", "source_line": 26}},
{"beat_id": "CH01_B07_L0003", "speaker_id": "torren", "text": "Wait.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LANDSCAPE DEPICTION]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_HOLLOW_WATCH_LANDSCAPE_DEPICTION_DRAFT_A.md", "source_line": 30}},
{"beat_id": "CH01_B07_L0004", "speaker_id": "torren", "text": "That's Hollow Watch.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LANDSCAPE DEPICTION]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_HOLLOW_WATCH_LANDSCAPE_DEPICTION_DRAFT_A.md", "source_line": 34}},
{"beat_id": "CH01_B07_L0005", "speaker_id": "cyanis", "text": "You're sure?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LANDSCAPE DEPICTION]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_HOLLOW_WATCH_LANDSCAPE_DEPICTION_DRAFT_A.md", "source_line": 38}},
{"beat_id": "CH01_B07_L0006", "speaker_id": "torren", "text": "Yeah. Ridge, slope, the break west of it. It's simplified, but that's this ground.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LANDSCAPE DEPICTION]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_HOLLOW_WATCH_LANDSCAPE_DEPICTION_DRAFT_A.md", "source_line": 40}},
{"beat_id": "CH01_B07_L0007", "speaker_id": "maevra", "text": "Then the rest may be real too.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LANDSCAPE DEPICTION]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_HOLLOW_WATCH_LANDSCAPE_DEPICTION_DRAFT_A.md", "source_line": 44}},
{"beat_id": "CH01_B07_L0008", "speaker_id": "torren", "text": "Fuck.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LANDSCAPE DEPICTION]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_HOLLOW_WATCH_LANDSCAPE_DEPICTION_DRAFT_A.md", "source_line": 50}},
{"beat_id": "CH01_B07_L0009", "speaker_id": "ilyra", "text": "What?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LANDSCAPE DEPICTION]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_HOLLOW_WATCH_LANDSCAPE_DEPICTION_DRAFT_A.md", "source_line": 52}},
{"beat_id": "CH01_B07_L0010", "speaker_id": "torren", "text": "The Junction. Same basin, same road convergence. I know that ground.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LANDSCAPE DEPICTION]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_HOLLOW_WATCH_LANDSCAPE_DEPICTION_DRAFT_A.md", "source_line": 54}},
{"beat_id": "CH01_B07_L0011", "speaker_id": "torren", "text": "I don't know that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LANDSCAPE DEPICTION]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_HOLLOW_WATCH_LANDSCAPE_DEPICTION_DRAFT_A.md", "source_line": 58}},
{"beat_id": "CH01_B07_L0012", "speaker_id": "maevra", "text": "You've never seen it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LANDSCAPE DEPICTION]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_HOLLOW_WATCH_LANDSCAPE_DEPICTION_DRAFT_A.md", "source_line": 62}},
{"beat_id": "CH01_B07_L0013", "speaker_id": "torren", "text": "No. Could be gone, could be buried, could be the picture's wrong about the size. But if something like that were standing there now, I wouldn't have missed it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LANDSCAPE DEPICTION]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_HOLLOW_WATCH_LANDSCAPE_DEPICTION_DRAFT_A.md", "source_line": 64}},
{"beat_id": "CH01_B07_L0014", "speaker_id": "maevra", "text": "We're already going south.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LANDSCAPE DEPICTION]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_HOLLOW_WATCH_LANDSCAPE_DEPICTION_DRAFT_A.md", "source_line": 68}},
{"beat_id": "CH01_B07_L0015", "speaker_id": "torren", "text": "Junction's close enough to the route.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LANDSCAPE DEPICTION]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_HOLLOW_WATCH_LANDSCAPE_DEPICTION_DRAFT_A.md", "source_line": 70}},
{"beat_id": "CH01_B07_L0016", "speaker_id": "maevra", "text": "Then we look when we get there.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LANDSCAPE DEPICTION]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_HOLLOW_WATCH_LANDSCAPE_DEPICTION_DRAFT_A.md", "source_line": 72}},
{"beat_id": "CH01_B07_L0017", "speaker_id": "torren", "text": "Yeah. Until then, it's something that should be there and isn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LANDSCAPE DEPICTION]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_HOLLOW_WATCH_LANDSCAPE_DEPICTION_DRAFT_A.md", "source_line": 74}},
{"beat_id": "CH01_B07_L0018", "speaker_id": "cyanis", "text": "I'll take that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LANDSCAPE DEPICTION]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_HOLLOW_WATCH_LANDSCAPE_DEPICTION_DRAFT_A.md", "source_line": 76}}
]
