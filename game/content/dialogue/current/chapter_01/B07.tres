beats = [
{"beat_id": "CH01_B07_L0001", "speaker_id": "ilyra", "text": "Not military traffic. Too many ordinary people, too much movement built around carrying people who couldn't move themselves.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HUMAN-USE RELIEF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 41}},
{"beat_id": "CH01_B07_L0002", "speaker_id": "cyanis", "text": "Evacuation?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HUMAN-USE RELIEF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 43}},
{"beat_id": "CH01_B07_L0003", "speaker_id": "torren", "text": "Maybe. But they're moving both ways through all six. If everybody was just fleeing one danger, I'd expect more of one direction and less coming back.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HUMAN-USE RELIEF]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 47}},
{"beat_id": "CH01_B07_L0004", "speaker_id": "maevra", "text": "Unless different groups were moving at different times.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HUMAN-USE RELIEF]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH01_B07_L0005", "speaker_id": "torren", "text": "Could be.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HUMAN-USE RELIEF]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 51}},
{"beat_id": "CH01_B07_L0006", "speaker_id": "ilyra", "text": "Shelter, then?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HUMAN-USE RELIEF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 53}},
{"beat_id": "CH01_B07_L0007", "speaker_id": "torren", "text": "Could be that too.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HUMAN-USE RELIEF]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 55}},
{"beat_id": "CH01_B07_L0008", "speaker_id": "cyanis", "text": "You're enjoying saying `could be`.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HUMAN-USE RELIEF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH01_B07_L0009", "speaker_id": "torren", "text": "No. I'm enjoying not making shit up.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HUMAN-USE RELIEF]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 61}},
{"beat_id": "CH01_B07_L0010", "speaker_id": "maevra", "text": "That's one of his more lovable qualities.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HUMAN-USE RELIEF]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 65}},
{"beat_id": "CH01_B07_L0011", "speaker_id": "torren", "text": "Don't start.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HUMAN-USE RELIEF]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 67}},
{"beat_id": "CH01_B07_L0012", "speaker_id": "ilyra", "text": "Whatever the exact reason, civilians used this place in numbers. That much I'm comfortable saying.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HUMAN-USE RELIEF]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 71}},
{"beat_id": "CH01_B07_L0013", "speaker_id": "maevra", "text": "Same.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HUMAN-USE RELIEF]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 73}},
{"beat_id": "CH01_B07_L0014", "speaker_id": "cyanis", "text": "Which still leaves us with six ways to be wrong.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HUMAN-USE RELIEF]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 77}},
{"beat_id": "CH01_B07_L0015", "speaker_id": "torren", "text": "Five. Host already picked one for us.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HUMAN-USE RELIEF]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 79}},
{"beat_id": "CH01_B07_L0016", "speaker_id": "cyanis", "text": "They tried the others first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROUTE ONWARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 107}},
{"beat_id": "CH01_B07_L0017", "speaker_id": "maevra", "text": "This one worked well enough to keep investing in.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROUTE ONWARD]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 111}},
{"beat_id": "CH01_B07_L0018", "speaker_id": "torren", "text": "Or badly enough that they got stubborn. Either way, it's the one with their traffic through it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROUTE ONWARD]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 115}},
{"beat_id": "CH01_B07_L0019", "speaker_id": "ilyra", "text": "And whatever made them stop is farther in.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROUTE ONWARD]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 117}},
{"beat_id": "CH01_B07_L0020", "speaker_id": "torren", "text": "Maybe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROUTE ONWARD]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 121}},
{"beat_id": "CH01_B07_L0021", "speaker_id": "torren", "text": "Sorry. Couldn't resist that one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROUTE ONWARD]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 125}},
{"beat_id": "CH01_B07_L0022", "speaker_id": "ilyra", "text": "I noticed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROUTE ONWARD]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 129}},
{"beat_id": "CH01_B07_L0023", "speaker_id": "cyanis", "text": "Growth.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROUTE ONWARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 131}},
{"beat_id": "CH01_B07_L0024", "speaker_id": "maevra", "text": "Tragic, really.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROUTE ONWARD]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 133}},
{"beat_id": "CH01_B07_L0025", "speaker_id": "torren", "text": "Are we going?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROUTE ONWARD]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 135}},
{"beat_id": "CH01_B07_L0026", "speaker_id": "cyanis", "text": "Yeah. Carefully.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROUTE ONWARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_07_LOWER_JUNCTION_SIX_CHANNELS_DRAFT_A.md", "source_line": 137}}
]
