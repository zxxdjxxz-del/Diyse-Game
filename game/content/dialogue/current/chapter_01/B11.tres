beats = [
{"beat_id": "CH01_B11_L0001", "speaker_id": "torren", "text": "This is it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE HIDDEN MONUMENT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 26}},
{"beat_id": "CH01_B11_L0002", "speaker_id": "cyanis", "text": "Then where's the thing from the mural?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE HIDDEN MONUMENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 30}},
{"beat_id": "CH01_B11_L0003", "speaker_id": "torren", "text": "That's what I'm trying to figure out.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE HIDDEN MONUMENT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 32}},
{"beat_id": "CH01_B11_L0004", "speaker_id": "maevra", "text": "It was in the middle.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE HIDDEN MONUMENT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 36}},
{"beat_id": "CH01_B11_L0005", "speaker_id": "torren", "text": "...Shit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE HIDDEN MONUMENT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 42}},
{"beat_id": "CH01_B11_L0006", "speaker_id": "cyanis", "text": "That?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE HIDDEN MONUMENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 46}},
{"beat_id": "CH01_B11_L0007", "speaker_id": "torren", "text": "Maybe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE HIDDEN MONUMENT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 48}},
{"beat_id": "CH01_B11_L0008", "speaker_id": "maevra", "text": "You've walked past it before.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE HIDDEN MONUMENT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 50}},
{"beat_id": "CH01_B11_L0009", "speaker_id": "torren", "text": "I've walked past a lot of rocks.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE HIDDEN MONUMENT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 52}},
{"beat_id": "CH01_B11_L0010", "speaker_id": "maevra", "text": "I'm keeping that answer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE HIDDEN MONUMENT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 54}},
{"beat_id": "CH01_B11_L0011", "speaker_id": "torren", "text": "Of course you are.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE HIDDEN MONUMENT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 56}},
{"beat_id": "CH01_B11_L0012", "speaker_id": "torren", "text": "That's not a foundation.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE HIDDEN MONUMENT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 68}},
{"beat_id": "CH01_B11_L0013", "speaker_id": "torren", "text": "Route map, I think. Or close enough I'm willing to call it one. I know the ground; I don't know this system.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE HIDDEN MONUMENT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 72}},
{"beat_id": "CH01_B11_L0014", "speaker_id": "torren", "text": "This isn't a Junction map.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 96}},
{"beat_id": "CH01_B11_L0015", "speaker_id": "ilyra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 100}},
{"beat_id": "CH01_B11_L0016", "speaker_id": "torren", "text": "These are roads. These other lines aren't—or not any kind I know. They're everywhere, and I can't tell you what they mean.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 104}},
{"beat_id": "CH01_B11_L0017", "speaker_id": "maevra", "text": "And all of those?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 108}},
{"beat_id": "CH01_B11_L0018", "speaker_id": "torren", "text": "Built places. Settlements. Cities, maybe. A lot of them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 110}},
{"beat_id": "CH01_B11_L0019", "speaker_id": "torren", "text": "This southeast line matches our road. Same direction, same bend. Could be the old road under parts of it, could just be people choosing the same good ground. Can't tell from this.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 114}},
{"beat_id": "CH01_B11_L0020", "speaker_id": "maevra", "text": "Dunmere.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 116}},
{"beat_id": "CH01_B11_L0021", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 118}},
{"beat_id": "CH01_B11_L0022", "speaker_id": "cyanis", "text": "So this whole thing was connected.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 122}},
{"beat_id": "CH01_B11_L0023", "speaker_id": "torren", "text": "Looks that way. Doesn't tell us how it all worked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 124}},
{"beat_id": "CH01_B11_L0024", "speaker_id": "maevra", "text": "If the rest of this matches, Caelora should be around there.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 132}},
{"beat_id": "CH01_B11_L0025", "speaker_id": "torren", "text": "Around the break, yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 134}},
{"beat_id": "CH01_B11_L0026", "speaker_id": "torren", "text": "Whatever stood there, it was the biggest concentration on this part of the map. Center's gone.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 138}},
{"beat_id": "CH01_B11_L0027", "speaker_id": "cyanis", "text": "Of course it is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 140}},
{"beat_id": "CH01_B11_L0028", "speaker_id": "maevra", "text": "Copy what's here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 144}},
{"beat_id": "CH01_B11_L0029", "speaker_id": "cyanis", "text": "Works for me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 146}},
{"beat_id": "CH01_B11_L0030", "speaker_id": "torren", "text": "See? Trainable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 150}},
{"beat_id": "CH01_B11_L0031", "speaker_id": "cyanis", "text": "Careful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 154}},
{"beat_id": "CH01_B11_L0032", "speaker_id": "maevra", "text": "Dunmere tonight?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CAMP DECISION]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 181}},
{"beat_id": "CH01_B11_L0033", "speaker_id": "torren", "text": "No. Road's easy enough in daylight and annoying in the dark. After today, there's no reason to make it worse.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CAMP DECISION]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 185}},
{"beat_id": "CH01_B11_L0034", "speaker_id": "maevra", "text": "All right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CAMP DECISION]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 187}},
{"beat_id": "CH01_B11_L0035", "speaker_id": "torren", "text": "Camp here. Dunmere in the morning.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CAMP DECISION]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 189}},
{"beat_id": "CH01_B11_L0036", "speaker_id": "cyanis", "text": "Works for me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CAMP DECISION]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 193}},
{"beat_id": "CH01_B11_L0037", "speaker_id": "ilyra", "text": "Good. I was prepared to be a pain in the ass.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CAMP DECISION]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 197}},
{"beat_id": "CH01_B11_L0038", "speaker_id": "maevra", "text": "Prepared?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CAMP DECISION]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 201}},
{"beat_id": "CH01_B11_L0039", "speaker_id": "ilyra", "text": "More of one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CAMP DECISION]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 203}},
{"beat_id": "CH01_B11_L0040", "speaker_id": "maevra", "text": "There she is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CAMP DECISION]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/CH01_B11_THE_JUNCTION_HIDDEN_MONUMENT_DIALOGUE.md", "source_line": 205}},
