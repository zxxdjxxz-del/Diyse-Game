beats = [
{"beat_id": "CH01_B01_L0001", "speaker_id": "custody_officer", "text": "That's the Card?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CUSTODY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 11}},
{"beat_id": "CH01_B01_L0002", "speaker_id": "cyanis", "text": "Card survived. Casing didn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 13}},
{"beat_id": "CH01_B01_L0003", "speaker_id": "custody_officer", "text": "And right now?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CUSTODY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 15}},
{"beat_id": "CH01_B01_L0004", "speaker_id": "ilyra", "text": "Inert. That's not the same as safe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 17}},
{"beat_id": "CH01_B01_L0005", "speaker_id": "custody_officer", "text": "Wasn't hoping it was. Tell me what it actually did.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CUSTODY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 19}},
{"beat_id": "CH01_B01_L0006", "speaker_id": "ilyra", "text": "Twice, green-and-gold geometry spread from it and held damaged structure together around us. Both times Cyanis reacted with it—pulse up, tremor, dizziness afterward. We don't know why.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 21}},
{"beat_id": "CH01_B01_L0007", "speaker_id": "cyanis", "text": "Her favorite answer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 23}},
{"beat_id": "CH01_B01_L0008", "speaker_id": "ilyra", "text": "Only when it's true.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 25}},
{"beat_id": "CH01_B01_L0009", "speaker_id": "custody_officer", "text": "Anything now?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CUSTODY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 29}},
{"beat_id": "CH01_B01_L0010", "speaker_id": "cyanis", "text": "No dizziness. Head's clear. Nothing new.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 33}},
{"beat_id": "CH01_B01_L0011", "speaker_id": "custody_officer", "text": "Good enough for intake.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CUSTODY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 35}},
{"beat_id": "CH01_B01_L0012", "speaker_id": "ilyra", "text": "For intake.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 37}},
{"beat_id": "CH01_B01_L0013", "speaker_id": "custody_officer", "text": "I heard you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CUSTODY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 39}},
{"beat_id": "CH01_B01_L0014", "speaker_id": "custody_officer", "text": "Warded storage until Caelora tells us what we've got.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CUSTODY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 43}},
{"beat_id": "CH01_B01_L0015", "speaker_id": "ilyra", "text": "Cyanis.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH01_B01_L0016", "speaker_id": "cyanis", "text": "Yeah. I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 51}},
{"beat_id": "CH01_B01_L0017", "speaker_id": "ilyra", "text": "Don't move.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 55}},
{"beat_id": "CH01_B01_L0018", "speaker_id": "cyanis", "text": "Wasn't planning anything ambitious.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 57}},
{"beat_id": "CH01_B01_L0019", "speaker_id": "custody_officer", "text": "Bringing it back.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CUSTODY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 61}},
{"beat_id": "CH01_B01_L0020", "speaker_id": "ilyra", "text": "Better?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 67}},
{"beat_id": "CH01_B01_L0021", "speaker_id": "cyanis", "text": "Almost immediately.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 69}},
{"beat_id": "CH01_B01_L0022", "speaker_id": "ilyra", "text": "Pulse is settling.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 71}},
{"beat_id": "CH01_B01_L0023", "speaker_id": "custody_officer", "text": "That's the end of that experiment.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CUSTODY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 75}},
{"beat_id": "CH01_B01_L0024", "speaker_id": "cyanis", "text": "Best decision I've heard today.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 77}},
{"beat_id": "CH01_B01_L0025", "speaker_id": "custody_officer", "text": "It wasn't an experiment when I started it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CUSTODY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 79}},
{"beat_id": "CH01_B01_L0026", "speaker_id": "ilyra", "text": "It is now.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 81}},
{"beat_id": "CH01_B01_L0027", "speaker_id": "custody_officer", "text": "Fine. Accidental experiment. Finished.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CUSTODY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 85}},
{"beat_id": "CH01_B01_L0028", "speaker_id": "cyanis", "text": "Even better.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 87}},
{"beat_id": "CH01_B01_L0029", "speaker_id": "custody_officer", "text": "Get Commander Solmar.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CUSTODY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 89}},
{"beat_id": "CH01_B01_L0030", "speaker_id": "maevra", "text": "I'm assuming normal procedure went beautifully.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 95}},
{"beat_id": "CH01_B01_L0031", "speaker_id": "cyanis", "text": "Depends how attached you are to the word normal.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 97}},
{"beat_id": "CH01_B01_L0032", "speaker_id": "custody_officer", "text": "Storage failed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CUSTODY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 99}},
{"beat_id": "CH01_B01_L0033", "speaker_id": "maevra", "text": "Of course it did.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 101}},
{"beat_id": "CH01_B01_L0034", "speaker_id": "ilyra", "text": "Convoy?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 105}},
{"beat_id": "CH01_B01_L0035", "speaker_id": "maevra", "text": "Wagon threw me. Ground won.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 107}},
{"beat_id": "CH01_B01_L0036", "speaker_id": "ilyra", "text": "I'm redoing that before we leave.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 109}},
{"beat_id": "CH01_B01_L0037", "speaker_id": "maevra", "text": "Hello, Ilyra.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 111}},
{"beat_id": "CH01_B01_L0038", "speaker_id": "ilyra", "text": "Hello. I'm redoing that before we leave.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 113}},
{"beat_id": "CH01_B01_L0039", "speaker_id": "maevra", "text": "See what I live with?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 117}},
{"beat_id": "CH01_B01_L0040", "speaker_id": "cyanis", "text": "I was going to say she seems consistent.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 119}},
{"beat_id": "CH01_B01_L0041", "speaker_id": "ilyra", "text": "Thank you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 121}},
{"beat_id": "CH01_B01_L0042", "speaker_id": "maevra", "text": "Nobody asked you to encourage her.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 123}},
{"beat_id": "CH01_B01_L0043", "speaker_id": "custody_officer", "text": "I moved the Card away from Dovaren. He started going down. The Card reacted toward him. I brought it back. Both stopped.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CUSTODY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 127}},
{"beat_id": "CH01_B01_L0044", "speaker_id": "maevra", "text": "Anything still wrong?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 131}},
{"beat_id": "CH01_B01_L0045", "speaker_id": "ilyra", "text": "No tremor now. Pulse is nearly baseline. He says he feels normal again.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 133}},
{"beat_id": "CH01_B01_L0046", "speaker_id": "cyanis", "text": "I do.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 135}},
{"beat_id": "CH01_B01_L0047", "speaker_id": "maevra", "text": "I believe you. I also know your definition of normal.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 137}},
{"beat_id": "CH01_B01_L0048", "speaker_id": "cyanis", "text": "That's hurtful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 139}},
{"beat_id": "CH01_B01_L0049", "speaker_id": "maevra", "text": "Recover later.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 141}},
{"beat_id": "CH01_B01_L0050", "speaker_id": "maevra", "text": "Card stays with Dovaren. Amarin keeps an eye on him. If anything changes, we stop and reassess. Nobody tests the distance again.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 145}},
{"beat_id": "CH01_B01_L0051", "speaker_id": "custody_officer", "text": "Fine by me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CUSTODY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 147}},
{"beat_id": "CH01_B01_L0052", "speaker_id": "cyanis", "text": "Understood.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 149}},
{"beat_id": "CH01_B01_L0053", "speaker_id": "maevra", "text": "Brackenwall can't answer this. Caelora might.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 151}},
{"beat_id": "CH01_B01_L0054", "speaker_id": "custody_officer", "text": "So you're taking it there.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CUSTODY OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 153}},
{"beat_id": "CH01_B01_L0055", "speaker_id": "maevra", "text": "I'm taking responsibility for it. Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 155}},
{"beat_id": "CH01_B01_L0056", "speaker_id": "maevra", "text": "I can get us to Greenhollow. Before we go farther south, I want Torren Harth.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 159}},
{"beat_id": "CH01_B01_L0057", "speaker_id": "cyanis", "text": "All right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 161}},
{"beat_id": "CH01_B01_L0058", "speaker_id": "cyanis", "text": "And you're coming with us like that?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 165}},
{"beat_id": "CH01_B01_L0059", "speaker_id": "maevra", "text": "I'm traveling. I'm not fighting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 169}},
{"beat_id": "CH01_B01_L0060", "speaker_id": "cyanis", "text": "Wasn't telling you not to come.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 171}},
{"beat_id": "CH01_B01_L0061", "speaker_id": "maevra", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 173}},
{"beat_id": "CH01_B01_L0062", "speaker_id": "ilyra", "text": "Good. Sit down.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 175}},
{"beat_id": "CH01_B01_L0063", "speaker_id": "maevra", "text": "Fuck, I knew this part was coming.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 177}},
{"beat_id": "CH01_B01_L0064", "speaker_id": "cyanis", "text": "That sounded like an order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 179}},
{"beat_id": "CH01_B01_L0065", "speaker_id": "maevra", "text": "Hers usually do when bones are involved.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 181}},
{"beat_id": "CH01_B01_L0066", "speaker_id": "ilyra", "text": "Sit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 183}},
{"beat_id": "CH01_B01_L0067", "speaker_id": "maevra", "text": "Yes, Warden.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[BRACKENWALL — INTAKE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_01_BRACKENWALL_PROTOCOL_DRAFT_A.md", "source_line": 185}}
]
