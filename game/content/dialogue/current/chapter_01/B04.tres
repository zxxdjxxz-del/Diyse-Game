{"beat_id": "CH01_B04_L0061", "speaker_id": "cyanis", "text": "Still our way in?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD — OCCUPIED HOLLOW WATCH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 245}},
{"beat_id": "CH01_B04_L0062", "speaker_id": "torren", "text": "Yeah. Wall hasn't shifted. No fresh cut across the approach. We go now before somebody decides this is a good place for a patrol.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD — OCCUPIED HOLLOW WATCH]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 249}},
