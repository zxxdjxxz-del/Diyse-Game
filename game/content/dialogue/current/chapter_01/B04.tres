beats = [
{"beat_id": "CH01_B04_L0001", "speaker_id": "cyanis", "text": "That's Hollow Watch?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 32}},
{"beat_id": "CH01_B04_L0002", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 34}},
{"beat_id": "CH01_B04_L0003", "speaker_id": "maevra", "text": "They've done a hell of a lot more than occupy it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 36}},
{"beat_id": "CH01_B04_L0004", "speaker_id": "ilyra", "text": "Stone underneath is different.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 38}},
{"beat_id": "CH01_B04_L0005", "speaker_id": "torren", "text": "Yeah. Couldn't see that from the lower bend. Fort's sitting over something older.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 42}},
{"beat_id": "CH01_B04_L0006", "speaker_id": "ilyra", "text": "Any sign of the garrison?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 44}},
{"beat_id": "CH01_B04_L0007", "speaker_id": "torren", "text": "Nothing I trust from here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 48}},
{"beat_id": "CH01_B04_L0008", "speaker_id": "maevra", "text": "Main approach?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 52}},
{"beat_id": "CH01_B04_L0009", "speaker_id": "torren", "text": "No. West wall. Trees cover most of the climb, and the last stretch tucks under the cliff. I checked it to the ridge, not past it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 54}},
{"beat_id": "CH01_B04_L0010", "speaker_id": "cyanis", "text": "Then that's our way in.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 58}},
{"beat_id": "CH01_B04_L0011", "speaker_id": "torren", "text": "Stay low until we're under the wall.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 60}}
]
