authoring_notes = "CURRENT runtime dialogue compiled from docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md. docs/03_DIALOGUE/PRODUCTION is exact spoken-wording authority; legacy S001-S021 Resources are not source authority. Source SHA-256: 2783c40bd879d3d31587d481fc853f5a6b4ad3a8d3b33534b39359c15302cdb3. Spoken-sequence SHA-256: 9c81726a8a64e3329c5e428936260e91ac0ccb3a63e9f41558fb8c904aad181c. Spoken lines: 73."
beats = [
{"beat_id": "CH01_B04_L0001", "speaker_id": "torren", "text": "Everybody have what they actually need?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 19}},
{"beat_id": "CH01_B04_L0002", "speaker_id": "maevra", "text": "You gave us ten minutes, Harth.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 21}},
{"beat_id": "CH01_B04_L0003", "speaker_id": "torren", "text": "Was plenty.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 23}},
{"beat_id": "CH01_B04_L0004", "speaker_id": "maevra", "text": "For you. You pack like somebody's charging rent by the pocket.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 25}},
{"beat_id": "CH01_B04_L0005", "speaker_id": "torren", "text": "Because I carry my own shit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 27}},
{"beat_id": "CH01_B04_L0006", "speaker_id": "cyanis", "text": "I like him more every minute.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 29}},
{"beat_id": "CH01_B04_L0007", "speaker_id": "maevra", "text": "That's because neither of you has had to share a room with the other yet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 31}},
{"beat_id": "CH01_B04_L0008", "speaker_id": "ilyra", "text": "Give it another hour. They may discover a common philosophy about owning one shirt.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 33}},
{"beat_id": "CH01_B04_L0009", "speaker_id": "cyanis", "text": "I have more than one shirt.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 37}},
{"beat_id": "CH01_B04_L0010", "speaker_id": "ilyra", "text": "Then the friendship may not survive.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 39}},
{"beat_id": "CH01_B04_L0011", "speaker_id": "ilyra", "text": "Main road's out. What's the alternative actually like?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 43}},
{"beat_id": "CH01_B04_L0012", "speaker_id": "torren", "text": "First half is an old service path. Narrow, roots through it, but stable unless last night's rain did more than I think. After that we leave the path entirely and take the ridge shoulder under the trees. Last climb is steep enough you'll want your hands free. West wall covers us from the fort until we're close.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 47}},
{"beat_id": "CH01_B04_L0013", "speaker_id": "cyanis", "text": "You still taking us up there?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH01_B04_L0014", "speaker_id": "torren", "text": "I just described the route.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 53}},
{"beat_id": "CH01_B04_L0015", "speaker_id": "cyanis", "text": "Could've been a warning.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 55}},
{"beat_id": "CH01_B04_L0016", "speaker_id": "torren", "text": "It was both.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 57}},
{"beat_id": "CH01_B04_L0017", "speaker_id": "maevra", "text": "That's as warm as he gets before noon.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH01_B04_L0018", "speaker_id": "ilyra", "text": "I was promised a guide. Nobody mentioned continuing education.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 61}},
{"beat_id": "CH01_B04_L0019", "speaker_id": "torren", "text": "Free.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 63}},
{"beat_id": "CH01_B04_L0020", "speaker_id": "ilyra", "text": "Somehow worse.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 65}},
{"beat_id": "CH01_B04_L0021", "speaker_id": "torren", "text": "Move.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW NORTH EDGE — SCENE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 67}},
{"beat_id": "CH01_B04_L0022", "speaker_id": "torren", "text": "Off the road here. Stay on the darker ground under the firs.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 95}},
{"beat_id": "CH01_B04_L0023", "speaker_id": "cyanis", "text": "Darker means what?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 97}},
{"beat_id": "CH01_B04_L0024", "speaker_id": "torren", "text": "Holds moisture longer. Softer top, harder underneath. The pale strip looks cleaner because water runs across it. Cleaner is not stronger.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 99}},
{"beat_id": "CH01_B04_L0025", "speaker_id": "cyanis", "text": "Maevra was right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 103}},
{"beat_id": "CH01_B04_L0026", "speaker_id": "torren", "text": "About?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 105}},
{"beat_id": "CH01_B04_L0027", "speaker_id": "cyanis", "text": "You can turn dirt into a lecture.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 107}},
{"beat_id": "CH01_B04_L0028", "speaker_id": "torren", "text": "You asked what the dirt meant.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 109}},
{"beat_id": "CH01_B04_L0029", "speaker_id": "maevra", "text": "That's how he gets you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 111}},
{"beat_id": "CH01_B04_L0030", "speaker_id": "ilyra", "text": "I haven't decided whether I hate this or find it fascinating.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 113}},
{"beat_id": "CH01_B04_L0031", "speaker_id": "torren", "text": "Can do both.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 115}},
{"beat_id": "CH01_B04_L0032", "speaker_id": "ilyra", "text": "Oh, good. Permission.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 117}},
{"beat_id": "CH01_B04_L0033", "speaker_id": "torren", "text": "Keep laughing and step where I told you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GUIDED TRAVERSAL DIALOGUE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 121}},
{"beat_id": "CH01_B04_L0034", "speaker_id": "cyanis", "text": "They've been busy.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 143}},
{"beat_id": "CH01_B04_L0035", "speaker_id": "maevra", "text": "More than busy.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 145}},
{"beat_id": "CH01_B04_L0036", "speaker_id": "ilyra", "text": "The stone under it doesn't match the fort.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 149}},
{"beat_id": "CH01_B04_L0037", "speaker_id": "torren", "text": "No. Fort's sitting on older foundations, maybe more than foundations. I couldn't see that from the lower bend. They've opened enough of the slope now that the join's obvious.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 153}},
{"beat_id": "CH01_B04_L0038", "speaker_id": "cyanis", "text": "Any sign of the garrison?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 155}},
{"beat_id": "CH01_B04_L0039", "speaker_id": "torren", "text": "Not from here. No uniforms in the yard, no movement where I'd expect a prisoner detail, but distance is doing us no favors. Don't turn absence into bodies yet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 161}},
{"beat_id": "CH01_B04_L0040", "speaker_id": "ilyra", "text": "Good. I'm not interested in inventing an answer from this far away.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 163}},
{"beat_id": "CH01_B04_L0041", "speaker_id": "torren", "text": "Then we're getting along.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 165}},
{"beat_id": "CH01_B04_L0042", "speaker_id": "ilyra", "text": "Don't rush it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 167}},
{"beat_id": "CH01_B04_L0043", "speaker_id": "maevra", "text": "If they took the fort for whatever's underneath it, they knew enough to bring equipment before they knew whether they could open it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 171}},
{"beat_id": "CH01_B04_L0044", "speaker_id": "cyanis", "text": "Or they found it after they arrived and started hauling gear up.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 173}},
{"beat_id": "CH01_B04_L0045", "speaker_id": "maevra", "text": "Also possible.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 175}},
{"beat_id": "CH01_B04_L0046", "speaker_id": "torren", "text": "Traffic started after the fort changed hands. That's all I can give you from the route side.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — HOLLOW WATCH REVEAL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 177}},
{"beat_id": "CH01_B04_L0047", "speaker_id": "torren", "text": "We go in under the west wall. Trees carry us most of the way, then the slope folds inward under the cliff. From above it looks worse than it is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[APPROACH PLAN]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 187}},
{"beat_id": "CH01_B04_L0048", "speaker_id": "maevra", "text": "That's the route you checked?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[APPROACH PLAN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 189}},
{"beat_id": "CH01_B04_L0049", "speaker_id": "torren", "text": "To the ridge. Last part I only saw from outside. If the Host changed the wall or put somebody in the fold since then, we find out close.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[APPROACH PLAN]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 191}},
{"beat_id": "CH01_B04_L0050", "speaker_id": "cyanis", "text": "Comfortable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[APPROACH PLAN]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 193}},
{"beat_id": "CH01_B04_L0051", "speaker_id": "torren", "text": "You asked for accurate, not comfortable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[APPROACH PLAN]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 195}},
{"beat_id": "CH01_B04_L0052", "speaker_id": "cyanis", "text": "Starting to understand the pricing structure.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[APPROACH PLAN]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 197}},
{"beat_id": "CH01_B04_L0053", "speaker_id": "ilyra", "text": "If we have to pull someone back out, same route?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[APPROACH PLAN]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 199}},
{"beat_id": "CH01_B04_L0054", "speaker_id": "torren", "text": "One person, yes. Two if they're walking with help. A litter through the steep part would be miserable and slow. If we find a live garrison in numbers, we need another extraction plan.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[APPROACH PLAN]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 203}},
{"beat_id": "CH01_B04_L0055", "speaker_id": "ilyra", "text": "Miserable and slow. Your routes have a strong theme.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[APPROACH PLAN]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_04_HOLLOW_WATCH_APPROACH_DRAFT_A.md", "source_line": 207}},
