beats = [
{"beat_id": "CH01_B10_L0001", "speaker_id": "cyanis", "text": "There.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CLEAR SIGHTING]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 39}},
{"beat_id": "CH01_B10_L0002", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CLEAR SIGHTING]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 43}},
{"beat_id": "CH01_B10_L0003", "speaker_id": "maevra", "text": "That's your big one?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CLEAR SIGHTING]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 45}},
{"beat_id": "CH01_B10_L0004", "speaker_id": "torren", "text": "Bigger than I thought.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CLEAR SIGHTING]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 47}},
{"beat_id": "CH01_B10_L0005", "speaker_id": "ilyra", "text": "It's not moving on.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CLEAR SIGHTING]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 51}},
{"beat_id": "CH01_B10_L0006", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CLEAR SIGHTING]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 53}},
{"beat_id": "CH01_B10_L0007", "speaker_id": "cyanis", "text": "Way around?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CLEAR SIGHTING]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 57}},
{"beat_id": "CH01_B10_L0008", "speaker_id": "torren", "text": "Not without turning back a long way.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CLEAR SIGHTING]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH01_B10_L0009", "speaker_id": "torren", "text": "And I wouldn't turn our backs on it from here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CLEAR SIGHTING]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 63}},
{"beat_id": "CH01_B10_L0010", "speaker_id": "cyanis", "text": "Then we go through.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CLEAR SIGHTING]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 67}},
{"beat_id": "CH01_B10_L0011", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CLEAR SIGHTING]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 71}},
{"beat_id": "CH01_B10_L0012", "speaker_id": "maevra", "text": "Do it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CLEAR SIGHTING]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 75}},
{"beat_id": "CH01_B10_L0013", "speaker_id": "torren", "text": "Dead.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 105}},
{"beat_id": "CH01_B10_L0014", "speaker_id": "cyanis", "text": "Good. Damn thing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 109}},
{"beat_id": "CH01_B10_L0015", "speaker_id": "ilyra", "text": "I liked the forest better before it started producing shit that size.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 113}},
{"beat_id": "CH01_B10_L0016", "speaker_id": "torren", "text": "That's Briar.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 115}},
{"beat_id": "CH01_B10_L0017", "speaker_id": "ilyra", "text": "I'm developing opinions about Briar.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 117}},
{"beat_id": "CH01_B10_L0018", "speaker_id": "maevra", "text": "Junction?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 123}},
{"beat_id": "CH01_B10_L0019", "speaker_id": "torren", "text": "Over the rise.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 127}},
{"beat_id": "CH01_B10_L0020", "speaker_id": "cyanis", "text": "Let's go.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — AFTERMATH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_10_THORNHIDE_DRAFT_A.md", "source_line": 131}}
