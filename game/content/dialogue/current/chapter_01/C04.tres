beats = [
{"beat_id": "CH01_C04_L0001", "speaker_id": "ilyra", "text": "Give me the arm.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLINT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 15}},
{"beat_id": "CH01_C04_L0002", "speaker_id": "maevra", "text": "Attached to me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLINT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 17}},
{"beat_id": "CH01_C04_L0003", "speaker_id": "ilyra", "text": "I noticed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLINT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 19}},
{"beat_id": "CH01_C04_L0004", "speaker_id": "maevra", "text": "Fuck.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLINT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 25}},
{"beat_id": "CH01_C04_L0005", "speaker_id": "ilyra", "text": "Sorry. Not enough to stop.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLINT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 27}},
{"beat_id": "CH01_C04_L0006", "speaker_id": "maevra", "text": "Better.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLINT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 29}},
{"beat_id": "CH01_C04_L0007", "speaker_id": "ilyra", "text": "You've been using the hell out of it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLINT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 31}},
{"beat_id": "CH01_C04_L0008", "speaker_id": "maevra", "text": "I have duties.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLINT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 33}},
{"beat_id": "CH01_C04_L0009", "speaker_id": "ilyra", "text": "You also have a fracture.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLINT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 35}},
{"beat_id": "CH01_C04_L0010", "speaker_id": "maevra", "text": "Inconveniently, yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLINT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 37}},
{"beat_id": "CH01_C04_L0011", "speaker_id": "maevra", "text": "Better. Still broken?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLINT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 41}},
{"beat_id": "CH01_C04_L0012", "speaker_id": "ilyra", "text": "Still broken. I can settle the pain. I can't convince bone that time is optional.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLINT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 43}},
{"beat_id": "CH01_C04_L0013", "speaker_id": "ilyra", "text": "You and Torren are strange.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 49}},
{"beat_id": "CH01_C04_L0014", "speaker_id": "maevra", "text": "That's not a question.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 51}},
{"beat_id": "CH01_C04_L0015", "speaker_id": "ilyra", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 53}},
{"beat_id": "CH01_C04_L0016", "speaker_id": "ilyra", "text": "You argue like you've already had every version of the argument.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 55}},
{"beat_id": "CH01_C04_L0017", "speaker_id": "maevra", "text": "Usually have.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 57}},
{"beat_id": "CH01_C04_L0018", "speaker_id": "ilyra", "text": "And you both know exactly when the other's about to be difficult.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 59}},
{"beat_id": "CH01_C04_L0019", "speaker_id": "maevra", "text": "Torren is always about to be difficult.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 61}},
{"beat_id": "CH01_C04_L0020", "speaker_id": "ilyra", "text": "He'd say the same about you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 63}},
{"beat_id": "CH01_C04_L0021", "speaker_id": "maevra", "text": "Then he'd be wrong in a very familiar way.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 65}},
{"beat_id": "CH01_C04_L0022", "speaker_id": "ilyra", "text": "So you've known him a while.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 69}},
{"beat_id": "CH01_C04_L0023", "speaker_id": "maevra", "text": "Long enough.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 71}},
{"beat_id": "CH01_C04_L0024", "speaker_id": "ilyra", "text": "Deliberately useless.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 73}},
{"beat_id": "CH01_C04_L0025", "speaker_id": "maevra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 75}},
{"beat_id": "CH01_C04_L0026", "speaker_id": "maevra", "text": "He thinks if the ground tells you a plan is stupid, you change the plan.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 79}},
{"beat_id": "CH01_C04_L0027", "speaker_id": "ilyra", "text": "Sounds reasonable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 81}},
{"beat_id": "CH01_C04_L0028", "speaker_id": "maevra", "text": "It is. Then he tries to apply that to everything.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 83}},
{"beat_id": "CH01_C04_L0029", "speaker_id": "ilyra", "text": "And you don't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 85}},
{"beat_id": "CH01_C04_L0030", "speaker_id": "maevra", "text": "Sometimes the road is bad and somebody still has to get to the other end.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 87}},
{"beat_id": "CH01_C04_L0031", "speaker_id": "ilyra", "text": "Do you actually dislike each other?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT SHE WILL SAY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 91}},
{"beat_id": "CH01_C04_L0032", "speaker_id": "maevra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT SHE WILL SAY]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 93}},
{"beat_id": "CH01_C04_L0033", "speaker_id": "maevra", "text": "Don't do that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT SHE WILL SAY]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 97}},
{"beat_id": "CH01_C04_L0034", "speaker_id": "ilyra", "text": "Do what?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT SHE WILL SAY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 99}},
{"beat_id": "CH01_C04_L0035", "speaker_id": "maevra", "text": "Leave silence there like I'll fill it for you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT SHE WILL SAY]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 101}},
{"beat_id": "CH01_C04_L0036", "speaker_id": "ilyra", "text": "Worth trying.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT SHE WILL SAY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 105}},
{"beat_id": "CH01_C04_L0037", "speaker_id": "maevra", "text": "He matters to me. More than is convenient sometimes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT SHE WILL SAY]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 109}},
{"beat_id": "CH01_C04_L0038", "speaker_id": "maevra", "text": "That's all you're getting tonight.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT SHE WILL SAY]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 113}},
{"beat_id": "CH01_C04_L0039", "speaker_id": "ilyra", "text": "I wasn't going to ask.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT SHE WILL SAY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 115}},
{"beat_id": "CH01_C04_L0040", "speaker_id": "maevra", "text": "Bullshit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT SHE WILL SAY]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 117}},
{"beat_id": "CH01_C04_L0041", "speaker_id": "ilyra", "text": "Eventually.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT SHE WILL SAY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 121}},
{"beat_id": "CH01_C04_L0042", "speaker_id": "maevra", "text": "Wanting builds character.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT SHE WILL SAY]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 123}},
{"beat_id": "CH01_C04_L0043", "speaker_id": "ilyra", "text": "Cruel.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT SHE WILL SAY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 125}},
{"beat_id": "CH01_C04_L0044", "speaker_id": "ilyra", "text": "Fingers.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DONE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 131}},
{"beat_id": "CH01_C04_L0045", "speaker_id": "maevra", "text": "There.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DONE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 135}},
{"beat_id": "CH01_C04_L0046", "speaker_id": "ilyra", "text": "Good. Stop inventing reasons the arm isn't involved in what you're doing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DONE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/C04_NOT_PROFESSIONALLY_DIALOGUE.md", "source_line": 137}},
