{"beat_id": "CH01_B09_L0001", "speaker_id": "cyanis", "text": "That's a big son of a bitch.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THORNHIDE TRACK]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_09_SOUTHERN_BRIAR_PASSAGE_DRAFT_A.md", "source_line": 39}},
{"beat_id": "CH01_B09_L0002", "speaker_id": "torren", "text": "Thornhide.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THORNHIDE TRACK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_09_SOUTHERN_BRIAR_PASSAGE_DRAFT_A.md", "source_line": 43}},
{"beat_id": "CH01_B09_L0003", "speaker_id": "torren", "text": "Big one. Recent.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THORNHIDE TRACK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_09_SOUTHERN_BRIAR_PASSAGE_DRAFT_A.md", "source_line": 47}},
{"beat_id": "CH01_B09_L0004", "speaker_id": "maevra", "text": "How recent?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THORNHIDE TRACK]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_09_SOUTHERN_BRIAR_PASSAGE_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH01_B09_L0005", "speaker_id": "torren", "text": "Recent enough I don't give a shit whether it's ten minutes or thirty while we're standing in the track.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THORNHIDE TRACK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_09_SOUTHERN_BRIAR_PASSAGE_DRAFT_A.md", "source_line": 51}},
{"beat_id": "CH01_B09_L0006", "speaker_id": "ilyra", "text": "Ahead of us?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THORNHIDE TRACK]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_09_SOUTHERN_BRIAR_PASSAGE_DRAFT_A.md", "source_line": 55}},
{"beat_id": "CH01_B09_L0007", "speaker_id": "torren", "text": "Probably. Track's running the same direction we are.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THORNHIDE TRACK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_09_SOUTHERN_BRIAR_PASSAGE_DRAFT_A.md", "source_line": 57}},
{"beat_id": "CH01_B09_L0008", "speaker_id": "cyanis", "text": "Does it know we're here?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THORNHIDE TRACK]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_09_SOUTHERN_BRIAR_PASSAGE_DRAFT_A.md", "source_line": 61}},
{"beat_id": "CH01_B09_L0009", "speaker_id": "torren", "text": "Maybe. If it's close, probably.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THORNHIDE TRACK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_09_SOUTHERN_BRIAR_PASSAGE_DRAFT_A.md", "source_line": 65}},
{"beat_id": "CH01_B09_L0010", "speaker_id": "torren", "text": "Don't run if we see it. Don't crowd it unless it gives us no choice.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THORNHIDE TRACK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_09_SOUTHERN_BRIAR_PASSAGE_DRAFT_A.md", "source_line": 69}},
{"beat_id": "CH01_B09_L0011", "speaker_id": "maevra", "text": "And if it does?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THORNHIDE TRACK]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_09_SOUTHERN_BRIAR_PASSAGE_DRAFT_A.md", "source_line": 71}},
{"beat_id": "CH01_B09_L0012", "speaker_id": "torren", "text": "Then you'll know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THORNHIDE TRACK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_09_SOUTHERN_BRIAR_PASSAGE_DRAFT_A.md", "source_line": 73}},
{"beat_id": "CH01_B09_L0013", "speaker_id": "maevra", "text": "Comforting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THORNHIDE TRACK]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_09_SOUTHERN_BRIAR_PASSAGE_DRAFT_A.md", "source_line": 75}},
{"beat_id": "CH01_B09_L0014", "speaker_id": "torren", "text": "Wasn't meant to be.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THORNHIDE TRACK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_09_SOUTHERN_BRIAR_PASSAGE_DRAFT_A.md", "source_line": 77}}
