beats = [
{"beat_id": "CH01_B08_L0001", "speaker_id": "cyanis", "text": "They didn't open it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FORCED DOOR]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 39}},
{"beat_id": "CH01_B08_L0002", "speaker_id": "maevra", "text": "No. They accepted losing the argument with the door and started one with the wall.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FORCED DOOR]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 41}},
{"beat_id": "CH01_B08_L0003", "speaker_id": "torren", "text": "Went around the frame where the older stone meets the later repair. Weakest part they could actually reach.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FORCED DOOR]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 45}},
{"beat_id": "CH01_B08_L0004", "speaker_id": "ilyra", "text": "Subtle.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FORCED DOOR]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 47}},
{"beat_id": "CH01_B08_L0005", "speaker_id": "maevra", "text": "Worked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FORCED DOOR]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH01_B08_L0006", "speaker_id": "cyanis", "text": "That's the problem. Somebody willing to spend this much time getting around a locked door usually thinks the room on the other side matters.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FORCED DOOR]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 53}},
{"beat_id": "CH01_B08_L0007", "speaker_id": "torren", "text": "Or somebody ordered them not to come back without trying.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FORCED DOOR]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 55}},
{"beat_id": "CH01_B08_L0008", "speaker_id": "maevra", "text": "Still not the same thing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FORCED DOOR]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 57}},
{"beat_id": "CH01_B08_L0009", "speaker_id": "cyanis", "text": "No. Either one makes me want to know what stopped them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FORCED DOOR]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH01_B08_L0010", "speaker_id": "ilyra", "text": "Preferably before it tries to stop us.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FORCED DOOR]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 61}},
{"beat_id": "CH01_B08_L0011", "speaker_id": "torren", "text": "Good preference.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FORCED DOOR]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 63}},
{"beat_id": "CH01_B08_L0012", "speaker_id": "cyanis", "text": "This where they stopped?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — CASTELLAN CHAMBER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 115}},
{"beat_id": "CH01_B08_L0013", "speaker_id": "torren", "text": "Looks like. No forcing past this point that I can see.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — CASTELLAN CHAMBER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 119}},
{"beat_id": "CH01_B08_L0014", "speaker_id": "ilyra", "text": "Anything moving?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — CASTELLAN CHAMBER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 121}},
{"beat_id": "CH01_B08_L0015", "speaker_id": "cyanis", "text": "Not yet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — CASTELLAN CHAMBER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 127}},
{"beat_id": "CH01_B08_L0016", "speaker_id": "maevra", "text": "Then use the gift. Catch your breath, check yourselves, and get ready before `not yet` expires.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — CASTELLAN CHAMBER]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 131}},
{"beat_id": "CH01_B08_L0017", "speaker_id": "cyanis", "text": "No dizziness. No numbness. Nothing strange from the Card.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — CASTELLAN CHAMBER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 135}},
{"beat_id": "CH01_B08_L0018", "speaker_id": "ilyra", "text": "Look at that. Saved me two questions.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — CASTELLAN CHAMBER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 139}},
{"beat_id": "CH01_B08_L0019", "speaker_id": "torren", "text": "This a normal conversation now?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — CASTELLAN CHAMBER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 143}},
{"beat_id": "CH01_B08_L0020", "speaker_id": "cyanis", "text": "Apparently.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — CASTELLAN CHAMBER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 145}},
{"beat_id": "CH01_B08_L0021", "speaker_id": "cyanis", "text": "I'm very trainable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — CASTELLAN CHAMBER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 147}},
{"beat_id": "CH01_B08_L0022", "speaker_id": "torren", "text": "Doubt it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — CASTELLAN CHAMBER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 149}},
{"beat_id": "CH01_B08_L0023", "speaker_id": "cyanis", "text": "You met me this morning.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — CASTELLAN CHAMBER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 153}},
{"beat_id": "CH01_B08_L0024", "speaker_id": "torren", "text": "Enough data.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — CASTELLAN CHAMBER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 155}},
{"beat_id": "CH01_B08_L0025", "speaker_id": "maevra", "text": "Oh, this is going to get worse.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — CASTELLAN CHAMBER]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 159}},
{"beat_id": "CH01_B08_L0026", "speaker_id": "cyanis", "text": "For whom?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — CASTELLAN CHAMBER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 161}},
{"beat_id": "CH01_B08_L0027", "speaker_id": "maevra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — CASTELLAN CHAMBER]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 163}},
{"beat_id": "CH01_B08_L0028", "speaker_id": "torren", "text": "Ready when you are.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — CASTELLAN CHAMBER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 167}},
{"beat_id": "CH01_B08_L0029", "speaker_id": "cyanis", "text": "Let's find out what `not yet` means.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THRESHOLD SCENE — CASTELLAN CHAMBER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_FORCED_INNER_SECTION_DRAFT_A.md", "source_line": 169}}
]
