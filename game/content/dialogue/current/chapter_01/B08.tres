authoring_notes = "CURRENT runtime dialogue compiled from docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md. docs/03_DIALOGUE/PRODUCTION is exact spoken-wording authority; legacy S001-S021 Resources are not source authority. Source SHA-256: dd94b9af8cbd20de43c1cb42b8c0662ae976fed750ee4f6521a568e1aa8f08dd. Spoken-sequence SHA-256: f9616d4cad5578639dc67ad2f1a480b7acb79a6b5c6023785e9209466317afcc. Spoken lines: 22."
beats = [
{"beat_id": "CH01_B08_L0001", "speaker_id": "maevra", "text": "The garrison's dead. Host occupation is broken, but the fort isn't secure enough to call restored. Get word to Brackenwall. Recover the dead, hold the surface, and nobody goes below until a proper force gets here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GREENHOLLOW — RETURN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 18}},
{"beat_id": "CH01_B08_L0002", "speaker_id": "torren", "text": "They'll handle it from here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 28}},
{"beat_id": "CH01_B08_L0003", "speaker_id": "maevra", "text": "You satisfied with that?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 32}},
{"beat_id": "CH01_B08_L0004", "speaker_id": "torren", "text": "No. Doesn't matter. I stayed because nobody knew what happened at Hollow Watch and somebody had to keep watching it. Now we know, and Greenhollow's got people who can take it from here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 36}},
{"beat_id": "CH01_B08_L0005", "speaker_id": "maevra", "text": "So. You still taking us south?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 40}},
{"beat_id": "CH01_B08_L0006", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 42}},
{"beat_id": "CH01_B08_L0007", "speaker_id": "torren", "text": "And I'm not turning around at Dunmere. If you're still going to Caelora after that, I'm coming.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 46}},
{"beat_id": "CH01_B08_L0008", "speaker_id": "maevra", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 48}},
{"beat_id": "CH01_B08_L0009", "speaker_id": "torren", "text": "Don't sound so pleased.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 52}},
{"beat_id": "CH01_B08_L0010", "speaker_id": "maevra", "text": "I came here to ask you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[TORREN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 54}},
{"beat_id": "CH01_B08_L0011", "speaker_id": "maevra", "text": "Dunmere's still next.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SOUTHWARD PLAN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 60}},
{"beat_id": "CH01_B08_L0012", "speaker_id": "torren", "text": "Through southern Briar. Junction's close enough to check on the way.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SOUTHWARD PLAN]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 62}},
{"beat_id": "CH01_B08_L0013", "speaker_id": "cyanis", "text": "Then we resupply and move.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SOUTHWARD PLAN]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 68}},
{"beat_id": "CH01_B08_L0014", "speaker_id": "ilyra", "text": "After food. I'm starving.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SOUTHWARD PLAN]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 70}},
{"beat_id": "CH01_B08_L0015", "speaker_id": "cyanis", "text": "That sounded pretty damn final.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SOUTHWARD PLAN]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 74}},
{"beat_id": "CH01_B08_L0016", "speaker_id": "ilyra", "text": "I'm hungry.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SOUTHWARD PLAN]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 76}},
{"beat_id": "CH01_B08_L0017", "speaker_id": "torren", "text": "There's a place near the south road.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SOUTHWARD PLAN]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 78}},
{"beat_id": "CH01_B08_L0018", "speaker_id": "maevra", "text": "Finally, useful route information.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SOUTHWARD PLAN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 80}},
{"beat_id": "CH01_B08_L0019", "speaker_id": "torren", "text": "Been giving you useful route shit for years.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SOUTHWARD PLAN]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 84}},
{"beat_id": "CH01_B08_L0020", "speaker_id": "maevra", "text": "This one involves lunch.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SOUTHWARD PLAN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 86}},
{"beat_id": "CH01_B08_L0021", "speaker_id": "torren", "text": "Lower standard.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SOUTHWARD PLAN]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 88}},
{"beat_id": "CH01_B08_L0022", "speaker_id": "maevra", "text": "Better standard.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "ROSTER_ADD_TORREN_PERMANENT"], "source_section": "[SOUTHWARD PLAN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_01/BEAT_08_GREENHOLLOW_RESOLUTION_TORREN_RECRUITMENT_DRAFT_A.md", "source_line": 90}}
]
