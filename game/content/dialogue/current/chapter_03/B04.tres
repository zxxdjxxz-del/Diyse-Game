beats = [
{"beat_id": "CH03_B04_L0001", "speaker_id": "lysara", "text": "Mine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROYAL VERIFICATION ROOM]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 28}},
{"beat_id": "CH03_B04_L0002", "speaker_id": "othmar", "text": "No visible replacement. No reported damage. Casing record is continuous.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROYAL VERIFICATION ROOM]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 32}},
{"beat_id": "CH03_B04_L0003", "speaker_id": "lysara", "text": "Test it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROYAL VERIFICATION ROOM]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 34}},
{"beat_id": "CH03_B04_L0004", "speaker_id": "othmar", "text": "Normal.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROYAL VERIFICATION ROOM]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 42}},
{"beat_id": "CH03_B04_L0005", "speaker_id": "mirena", "text": "Same check on the transport order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROYAL VERIFICATION ROOM]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 46}},
{"beat_id": "CH03_B04_L0006", "speaker_id": "cyanis", "text": "That's inconvenient.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROYAL VERIFICATION ROOM]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 56}},
{"beat_id": "CH03_B04_L0007", "speaker_id": "mirena", "text": "Generous wording.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROYAL VERIFICATION ROOM]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 58}},
{"beat_id": "CH03_B04_L0008", "speaker_id": "lysara", "text": "Give me the useful version, not the comforting one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROYAL VERIFICATION ROOM]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 62}},
{"beat_id": "CH03_B04_L0009", "speaker_id": "othmar", "text": "Useful version: your physical seal is here, appears intact, and still produces its normal authority response. The transport order produces the same recognized core response despite your statement that you never authorized it. Our ordinary verification procedure therefore accepts both. I cannot honestly make those facts agree for you yet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROYAL VERIFICATION ROOM]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 66}},
{"beat_id": "CH03_B04_L0010", "speaker_id": "lysara", "text": "Good. Don't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROYAL VERIFICATION ROOM]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 68}},
{"beat_id": "CH03_B04_L0011", "speaker_id": "torren", "text": "Good?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROYAL VERIFICATION ROOM]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 72}},
{"beat_id": "CH03_B04_L0012", "speaker_id": "lysara", "text": "Better an honest contradiction than a convenient answer built to remove one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROYAL VERIFICATION ROOM]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 74}},
{"beat_id": "CH03_B04_L0013", "speaker_id": "torren", "text": "Fair.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — ROYAL VERIFICATION ROOM]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 76}},
{"beat_id": "CH03_B04_L0014", "speaker_id": "mirena", "text": "Walk me through the gap problem.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CUSTODY]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 84}},
{"beat_id": "CH03_B04_L0015", "speaker_id": "othmar", "text": "There is no clean documented interval where the seal leaves custody, disappears from record, and conveniently returns before the next verified use. That is all I can prove from the ledger.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CUSTODY]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 86}},
{"beat_id": "CH03_B04_L0016", "speaker_id": "othmar", "text": "Yes, Harth. `From the ledger.`", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CUSTODY]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 92}},
{"beat_id": "CH03_B04_L0017", "speaker_id": "torren", "text": "Wasn't going to argue.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CUSTODY]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 94}},
{"beat_id": "CH03_B04_L0018", "speaker_id": "othmar", "text": "You had the face.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CUSTODY]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 96}},
{"beat_id": "CH03_B04_L0019", "speaker_id": "torren", "text": "I have one face.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CUSTODY]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 98}},
{"beat_id": "CH03_B04_L0020", "speaker_id": "cyanis", "text": "He's been saving that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CUSTODY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 102}},
{"beat_id": "CH03_B04_L0021", "speaker_id": "ilyra", "text": "Worth it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CUSTODY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 104}},
{"beat_id": "CH03_B04_L0022", "speaker_id": "maevra", "text": "Could somebody have gotten physical access without creating a clean absence? Staff handoff, legitimate room access, anything that doesn't require the seal vanishing for half a day?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CUSTODY]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 110}},
{"beat_id": "CH03_B04_L0023", "speaker_id": "othmar", "text": "Possible is too cheap a word here. I can tell you the record does not prove such access occurred.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CUSTODY]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 112}},
{"beat_id": "CH03_B04_L0024", "speaker_id": "mirena", "text": "So the record is clean. The situation isn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CUSTODY]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 114}},
{"beat_id": "CH03_B04_L0025", "speaker_id": "othmar", "text": "Correct.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CUSTODY]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 116}},
{"beat_id": "CH03_B04_L0026", "speaker_id": "lysara", "text": "Can anyone in this room prove unrecorded physical access?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CUSTODY]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 120}},
{"beat_id": "CH03_B04_L0027", "speaker_id": "lysara", "text": "Can anyone prove the false order required physical access to the seal at all?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CUSTODY]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 124}},
{"beat_id": "CH03_B04_L0028", "speaker_id": "lysara", "text": "Then neither proposition leaves this room as fact. We investigate both only where evidence gives us something to investigate.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CUSTODY]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 128}},
{"beat_id": "CH03_B04_L0029", "speaker_id": "mirena", "text": "We're very good at proving a royal seal behaved like a royal seal.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 138}},
{"beat_id": "CH03_B04_L0030", "speaker_id": "cyanis", "text": "That sounded less impressive than I expected.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 140}},
{"beat_id": "CH03_B04_L0031", "speaker_id": "mirena", "text": "At the moment, it is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 142}},
{"beat_id": "CH03_B04_L0032", "speaker_id": "mirena", "text": "I want somebody whose work begins where our normal assumptions stop being useful. Old magical objects, damaged provenance, systems nobody can explain cleanly from current practice.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 146}},
{"beat_id": "CH03_B04_L0033", "speaker_id": "othmar", "text": "Pellan.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 150}},
{"beat_id": "CH03_B04_L0034", "speaker_id": "cyanis", "text": "Who?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 152}},
{"beat_id": "CH03_B04_L0035", "speaker_id": "mirena", "text": "Nimera Pellan. Card scholar. Old City archives.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 154}},
{"beat_id": "CH03_B04_L0036", "speaker_id": "torren", "text": "Good?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 156}},
{"beat_id": "CH03_B04_L0037", "speaker_id": "mirena", "text": "Annoyingly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 160}},
{"beat_id": "CH03_B04_L0038", "speaker_id": "ilyra", "text": "That sounded personal.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 162}},
{"beat_id": "CH03_B04_L0039", "speaker_id": "mirena", "text": "It is professional admiration expressed honestly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 164}},
{"beat_id": "CH03_B04_L0040", "speaker_id": "ilyra", "text": "Ah. Worse.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 166}},
{"beat_id": "CH03_B04_L0041", "speaker_id": "lysara", "text": "What does Pellan need?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 172}},
{"beat_id": "CH03_B04_L0042", "speaker_id": "mirena", "text": "Authenticated copies, the verification notes, and a look at the Card as it currently exists with Dovaren. She does not need your physical seal.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 174}},
{"beat_id": "CH03_B04_L0043", "speaker_id": "othmar", "text": "Agreed. Originals stay here. Physical seal stays here. Copies can be marked and tracked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 176}},
{"beat_id": "CH03_B04_L0044", "speaker_id": "lysara", "text": "Then that is what she gets.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 178}},
{"beat_id": "CH03_B04_L0045", "speaker_id": "lysara", "text": "The Card remains in your custody exactly as it is now. Pellan may observe it. Nobody separates it from you, tests it against another authority object, or invents a clever variation because a scholar becomes curious.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 182}},
{"beat_id": "CH03_B04_L0046", "speaker_id": "cyanis", "text": "Strongly agreed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 186}},
{"beat_id": "CH03_B04_L0047", "speaker_id": "ilyra", "text": "See? He can set his own boundaries.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 188}},
{"beat_id": "CH03_B04_L0048", "speaker_id": "cyanis", "text": "I've been practicing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 192}},
{"beat_id": "CH03_B04_L0049", "speaker_id": "ilyra", "text": "Proud of you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO MIGHT ACTUALLY HELP]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 194}},
{"beat_id": "CH03_B04_L0050", "speaker_id": "mirena", "text": "Maevra, stay with me. The transport chain is still ours to pull apart, and you know where field procedure matched the paperwork better than anyone in this room.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLIT]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 202}},
{"beat_id": "CH03_B04_L0051", "speaker_id": "maevra", "text": "Fine by me. I'd like to know who taught a false order to look that boring.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLIT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 204}},
{"beat_id": "CH03_B04_L0052", "speaker_id": "othmar", "text": "Boring is usually what makes a good administrative fraud useful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLIT]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 206}},
{"beat_id": "CH03_B04_L0053", "speaker_id": "maevra", "text": "See? This is why I'm staying with the fun group.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLIT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 208}},
{"beat_id": "CH03_B04_L0054", "speaker_id": "cyanis", "text": "Your definition of fun concerns me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLIT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 212}},
{"beat_id": "CH03_B04_L0055", "speaker_id": "maevra", "text": "Enjoy the basement.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLIT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 214}},
{"beat_id": "CH03_B04_L0056", "speaker_id": "cyanis", "text": "Enjoy the paperwork.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLIT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 216}},
{"beat_id": "CH03_B04_L0057", "speaker_id": "maevra", "text": "I will.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLIT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 218}},
{"beat_id": "CH03_B04_L0058", "speaker_id": "lysara", "text": "Dovaren. Amarin. Harth. Take the Card and the authenticated copies to Pellan. Mirena's authorization opens the archive levels you need. Nothing beyond that becomes permission by implication.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLIT]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 224}},
{"beat_id": "CH03_B04_L0059", "speaker_id": "torren", "text": "Old City.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLIT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 226}},
{"beat_id": "CH03_B04_L0060", "speaker_id": "mirena", "text": "Find Pellan. Show her what we actually have, including what we *don't* know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLIT]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 228}},
{"beat_id": "CH03_B04_L0061", "speaker_id": "mirena", "text": "Then let her tell us what any of it is worth.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLIT]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 232}},
{"beat_id": "CH03_B04_L0062", "speaker_id": "ilyra", "text": "Assuming she survives meeting Harth's notation.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLIT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 234}},
{"beat_id": "CH03_B04_L0063", "speaker_id": "torren", "text": "What notation?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLIT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 238}},
{"beat_id": "CH03_B04_L0064", "speaker_id": "ilyra", "text": "I have no idea. Felt safe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLIT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 240}},
{"beat_id": "CH03_B04_L0065", "speaker_id": "cyanis", "text": "She's learning from Maevra.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLIT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 242}},
{"beat_id": "CH03_B04_L0066", "speaker_id": "maevra", "text": "Finally, a useful legacy.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SPLIT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_04_SEAL_NOT_USED_DRAFT_A.md", "source_line": 244}}
