beats = [
{"beat_id": "CH03_B09_L0001", "speaker_id": "nimera", "text": "Here. Working seal damaged during transfer. Impression still looked correct. Magical response weakened afterward.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 17}},
{"beat_id": "CH03_B09_L0002", "speaker_id": "cyanis", "text": "Then restored?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 19}},
{"beat_id": "CH03_B09_L0003", "speaker_id": "nimera", "text": "Same physical seal body. Later keeper work restores the response.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 21}},
{"beat_id": "CH03_B09_L0004", "speaker_id": "ilyra", "text": "So the visible mark and the magical function were tracked separately.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 23}},
{"beat_id": "CH03_B09_L0005", "speaker_id": "nimera", "text": "Yes. That's the useful part.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 25}},
{"beat_id": "CH03_B09_L0006", "speaker_id": "torren", "text": "Method?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 27}},
{"beat_id": "CH03_B09_L0007", "speaker_id": "nimera", "text": "Referenced somewhere else, because apparently dead archivists enjoyed leaving future scholars damned treasure hunts.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 29}},
{"beat_id": "CH03_B09_L0008", "speaker_id": "cyanis", "text": "Does that mean Lysara doesn't have to consciously put magic into every document?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 31}},
{"beat_id": "CH03_B09_L0009", "speaker_id": "nimera", "text": "Probably. Historical model, not direct proof about her specific seal. Keep the qualifier attached or I will physically staple it to the sentence.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 33}},
{"beat_id": "CH03_B09_L0010", "speaker_id": "cyanis", "text": "I heard you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 35}},
{"beat_id": "CH03_B09_L0011", "speaker_id": "torren", "text": "You correct your own jokes too?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 37}},
{"beat_id": "CH03_B09_L0012", "speaker_id": "nimera", "text": "Especially the bad ones.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 39}},
{"beat_id": "CH03_B09_L0013", "speaker_id": "torren", "text": "Same kind of seal?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OLDER PRECEDENT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 47}},
{"beat_id": "CH03_B09_L0014", "speaker_id": "nimera", "text": "Similar physical authority object. Diysean context. Administrative use, apparently. Not Yahtrean royalty, not proven ancestry, and not permission to shove missing centuries up history's ass because two things resemble each other.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OLDER PRECEDENT]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH03_B09_L0015", "speaker_id": "ilyra", "text": "So the broad practice predates Yahtrea.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OLDER PRECEDENT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 51}},
{"beat_id": "CH03_B09_L0016", "speaker_id": "nimera", "text": "That I trust. Direct lineage is still a hell of a leap.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OLDER PRECEDENT]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 53}},
{"beat_id": "CH03_B09_L0017", "speaker_id": "torren", "text": "Same recent handling.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH03_B09_L0018", "speaker_id": "nimera", "text": "Same cut. Same fold. Same habit of treating support straps like they insulted someone's mother.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 63}},
{"beat_id": "CH03_B09_L0019", "speaker_id": "ilyra", "text": "That last one evidence?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 65}},
{"beat_id": "CH03_B09_L0020", "speaker_id": "nimera", "text": "Emotional evidence.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 67}},
{"beat_id": "CH03_B09_L0021", "speaker_id": "torren", "text": "Trail continues.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 71}},
{"beat_id": "CH03_B09_L0022", "speaker_id": "nimera", "text": "Oldest seal references are down in the deep collections. Whoever did this was not browsing. They knew what they wanted.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 75}},
{"beat_id": "CH03_B09_L0023", "speaker_id": "cyanis", "text": "And we still don't know what that was.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 77}},
{"beat_id": "CH03_B09_L0024", "speaker_id": "nimera", "text": "Correct. Same subjects does not mean same conclusion. I refuse to crawl up a stranger's ass and invent their theory for them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 79}},
{"beat_id": "CH03_B09_L0025", "speaker_id": "torren", "text": "Damn good policy.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 81}},
{"beat_id": "CH03_B09_L0026", "speaker_id": "nimera", "text": "Stop agreeing with me. It's unsettling.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_09_HALL_OF_SEALS_RECENT_READER_DRAFT_A.md", "source_line": 83}}
]
