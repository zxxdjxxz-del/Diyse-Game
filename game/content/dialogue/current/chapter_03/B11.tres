beats = [
{"beat_id": "CH03_B11_L0001", "speaker_id": "torren", "text": "Moving.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST COMMAND CHAMBER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 21}},
{"beat_id": "CH03_B11_L0002", "speaker_id": "nimera", "text": "Nobody make me regret following you in here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST COMMAND CHAMBER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 25}},
{"beat_id": "CH03_B11_L0003", "speaker_id": "cyanis", "text": "Mostly me?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST COMMAND CHAMBER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 27}},
{"beat_id": "CH03_B11_L0004", "speaker_id": "nimera", "text": "Obviously.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST COMMAND CHAMBER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 29}},
{"beat_id": "CH03_B11_L0005", "speaker_id": "cyanis", "text": "Nobody touch anything.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ASSESSMENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 37}},
{"beat_id": "CH03_B11_L0006", "speaker_id": "nimera", "text": "Happily.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ASSESSMENT]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 39}},
{"beat_id": "CH03_B11_L0007", "speaker_id": "nimera", "text": "It's changing as it crosses us.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ASSESSMENT]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 43}},
{"beat_id": "CH03_B11_L0008", "speaker_id": "ilyra", "text": "Which isn't necessarily the same as checking us individually.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ASSESSMENT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 45}},
{"beat_id": "CH03_B11_L0009", "speaker_id": "nimera", "text": "Correct. Keep that distinction.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ASSESSMENT]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH03_B11_L0010", "speaker_id": "torren", "text": "There it is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ASSESSMENT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH03_B11_L0011", "speaker_id": "nimera", "text": "Wait.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 85}},
{"beat_id": "CH03_B11_L0012", "speaker_id": "torren", "text": "Dead.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 106}},
{"beat_id": "CH03_B11_L0013", "speaker_id": "nimera", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 108}},
{"beat_id": "CH03_B11_L0014", "speaker_id": "nimera", "text": "Previous error. Then last sentinel confirmed. In that order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 112}},
{"beat_id": "CH03_B11_L0015", "speaker_id": "cyanis", "text": "You memorized it already.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 114}},
{"beat_id": "CH03_B11_L0016", "speaker_id": "nimera", "text": "Saying it keeps me from remembering a cleaner version later.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 116}},
{"beat_id": "CH03_B11_L0017", "speaker_id": "cyanis", "text": "Oh, shit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 126}},
{"beat_id": "CH03_B11_L0018", "speaker_id": "nimera", "text": "Let it finish.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 130}},
{"beat_id": "CH03_B11_L0019", "speaker_id": "cyanis", "text": "It's staying.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 140}},
{"beat_id": "CH03_B11_L0020", "speaker_id": "nimera", "text": "Stable so far.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 144}},
{"beat_id": "CH03_B11_L0021", "speaker_id": "ilyra", "text": "Same as Brackenwall?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 148}},
{"beat_id": "CH03_B11_L0022", "speaker_id": "cyanis", "text": "No. No cold, no shaking. I feel normal.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 150}},
{"beat_id": "CH03_B11_L0023", "speaker_id": "ilyra", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 152}},
{"beat_id": "CH03_B11_L0024", "speaker_id": "torren", "text": "Timing's ugly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 156}},
{"beat_id": "CH03_B11_L0025", "speaker_id": "nimera", "text": "Very.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 158}},
{"beat_id": "CH03_B11_L0026", "speaker_id": "cyanis", "text": "Connected?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 160}},
{"beat_id": "CH03_B11_L0027", "speaker_id": "nimera", "text": "The Card changed immediately after the Warden finished shutting down. That's what I know. I want the timing to mean more than that, which is exactly why I'm not giving it more yet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 164}},
{"beat_id": "CH03_B11_L0028", "speaker_id": "cyanis", "text": "A maybe with standards.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 166}},
{"beat_id": "CH03_B11_L0029", "speaker_id": "nimera", "text": "You're learning.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 170}},
{"beat_id": "CH03_B11_L0030", "speaker_id": "torren", "text": "Door's giving.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE INNER WAY]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 178}},
{"beat_id": "CH03_B11_L0031", "speaker_id": "nimera", "text": "Without the Card.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE INNER WAY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 180}},
{"beat_id": "CH03_B11_L0032", "speaker_id": "cyanis", "text": "Noted.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE INNER WAY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 182}},
{"beat_id": "CH03_B11_L0033", "speaker_id": "nimera", "text": "Good. `Card changed` and `door opened` are two events until we prove otherwise.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE INNER WAY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 184}},
{"beat_id": "CH03_B11_L0034", "speaker_id": "cyanis", "text": "Seal work.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE INNER WAY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 190}},
{"beat_id": "CH03_B11_L0035", "speaker_id": "nimera", "text": "Looks like it. Later.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE INNER WAY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 194}},
{"beat_id": "CH03_B11_L0036", "speaker_id": "ilyra", "text": "That hurt, didn't it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE INNER WAY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 198}},
{"beat_id": "CH03_B11_L0037", "speaker_id": "nimera", "text": "Deeply.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE INNER WAY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 200}}
]
