beats = [
{"beat_id": "CH03_B11_L0001", "speaker_id": "torren", "text": "Left assembly moves first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — INNER TRANSFER CHAMBER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 13}},
{"beat_id": "CH03_B11_L0002", "speaker_id": "nimera", "text": "Scribe system. Large one. Or a deeply unpleasant cousin.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — INNER TRANSFER CHAMBER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 15}},
{"beat_id": "CH03_B11_L0003", "speaker_id": "ilyra", "text": "Cousin wins.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — INNER TRANSFER CHAMBER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 19}},
{"beat_id": "CH03_B11_L0004", "speaker_id": "cyanis", "text": "Positions.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — INNER TRANSFER CHAMBER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 23}},
{"beat_id": "CH03_B11_L0005", "speaker_id": "nimera", "text": "If this thing ruins three centuries of records while trying to murder us, I'm going to be personally offended.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — INNER TRANSFER CHAMBER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 27}},
{"beat_id": "CH03_B11_L0006", "speaker_id": "torren", "text": "Think it cares?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — INNER TRANSFER CHAMBER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 29}},
{"beat_id": "CH03_B11_L0007", "speaker_id": "nimera", "text": "No. That's why the offense is pure.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — INNER TRANSFER CHAMBER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 31}},
{"beat_id": "CH03_B11_L0008", "speaker_id": "cyanis", "text": "Everybody still standing?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 57}},
{"beat_id": "CH03_B11_L0009", "speaker_id": "ilyra", "text": "Against my better judgment.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH03_B11_L0010", "speaker_id": "torren", "text": "Done.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 63}},
{"beat_id": "CH03_B11_L0011", "speaker_id": "nimera", "text": "Maybe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 67}},
{"beat_id": "CH03_B11_L0012", "speaker_id": "torren", "text": "You just agreed it was done.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 69}},
{"beat_id": "CH03_B11_L0013", "speaker_id": "nimera", "text": "Done trying to kill us. Different damn category.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 71}},
{"beat_id": "CH03_B11_L0014", "speaker_id": "nimera", "text": "It was enforcing something. Or continuing something. Fuck, those are not the same claim.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 75}},
{"beat_id": "CH03_B11_L0015", "speaker_id": "cyanis", "text": "What do we know?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 77}},
{"beat_id": "CH03_B11_L0016", "speaker_id": "nimera", "text": "We entered. It woke. It treated us as a problem. Breaking the active assemblies stopped it. Anything beyond that is me trying to make the corpse confess.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 79}},
{"beat_id": "CH03_B11_L0017", "speaker_id": "ilyra", "text": "That seems useful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 85}},
{"beat_id": "CH03_B11_L0018", "speaker_id": "nimera", "text": "Very.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 87}},
{"beat_id": "CH03_B11_L0019", "speaker_id": "torren", "text": "Door opened because the Engine stopped.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 89}},
{"beat_id": "CH03_B11_L0020", "speaker_id": "nimera", "text": "Good. Keep it boring. Boring causation is underrated.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 91}},
{"beat_id": "CH03_B11_L0021", "speaker_id": "cyanis", "text": "More records.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 95}},
{"beat_id": "CH03_B11_L0022", "speaker_id": "nimera", "text": "Now we're talking.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_ARCHIVE_SCRIBE_ENGINE_DRAFT_A.md", "source_line": 99}}
]
