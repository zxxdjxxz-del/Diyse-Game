beats = [
{"beat_id": "CH03_B11_L0001", "speaker_id": "torren", "text": "Moving.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST COMMAND CHAMBER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 39}},
{"beat_id": "CH03_B11_L0002", "speaker_id": "nimera", "text": "Nobody make me regret following you in here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST COMMAND CHAMBER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 45}},
{"beat_id": "CH03_B11_L0003", "speaker_id": "cyanis", "text": "That's aimed at me, isn't it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST COMMAND CHAMBER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 47}},
{"beat_id": "CH03_B11_L0004", "speaker_id": "nimera", "text": "Mostly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST COMMAND CHAMBER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH03_B11_L0005", "speaker_id": "cyanis", "text": "Nobody touch anything.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ASSESSMENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 63}},
{"beat_id": "CH03_B11_L0006", "speaker_id": "nimera", "text": "Happily. For once your plan is flawless.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ASSESSMENT]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 65}},
{"beat_id": "CH03_B11_L0007", "speaker_id": "nimera", "text": "It's checking us separately.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ASSESSMENT]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 69}},
{"beat_id": "CH03_B11_L0008", "speaker_id": "ilyra", "text": "Or checking something that changes as it crosses us.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ASSESSMENT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 71}},
{"beat_id": "CH03_B11_L0009", "speaker_id": "nimera", "text": "Yes. Better. Don't let me turn motion into intention yet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ASSESSMENT]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 75}},
{"beat_id": "CH03_B11_L0010", "speaker_id": "torren", "text": "There it is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ASSESSMENT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 85}},
{"beat_id": "CH03_B11_L0011", "speaker_id": "ilyra", "text": "Move.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ASSESSMENT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 87}},
{"beat_id": "CH03_B11_L0012", "speaker_id": "nimera", "text": "Wait.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY — THE WARDEN DOES NOT DIE QUIETLY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 122}},
{"beat_id": "CH03_B11_L0013", "speaker_id": "cyanis", "text": "What?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY — THE WARDEN DOES NOT DIE QUIETLY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 126}},
{"beat_id": "CH03_B11_L0014", "speaker_id": "nimera", "text": "It's still doing something. I don't know what. Just wait.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY — THE WARDEN DOES NOT DIE QUIETLY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 128}},
{"beat_id": "CH03_B11_L0015", "speaker_id": "cyanis", "text": "That's not ominous at all.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY — THE WARDEN DOES NOT DIE QUIETLY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 140}},
{"beat_id": "CH03_B11_L0016", "speaker_id": "nimera", "text": "Don't joke yet. I need to remember exactly what order this happens in.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY — THE WARDEN DOES NOT DIE QUIETLY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 142}},
{"beat_id": "CH03_B11_L0017", "speaker_id": "torren", "text": "That's dead.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY — THE WARDEN DOES NOT DIE QUIETLY]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 160}},
{"beat_id": "CH03_B11_L0018", "speaker_id": "nimera", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY — THE WARDEN DOES NOT DIE QUIETLY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 162}},
{"beat_id": "CH03_B11_L0019", "speaker_id": "nimera", "text": "Previous error. Then last sentinel confirmed. In that order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY — THE WARDEN DOES NOT DIE QUIETLY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 166}},
{"beat_id": "CH03_B11_L0020", "speaker_id": "cyanis", "text": "You already memorized it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY — THE WARDEN DOES NOT DIE QUIETLY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 168}},
{"beat_id": "CH03_B11_L0021", "speaker_id": "nimera", "text": "I know. Saying it keeps me from improving it accidentally.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY — THE WARDEN DOES NOT DIE QUIETLY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 170}},
{"beat_id": "CH03_B11_L0022", "speaker_id": "cyanis", "text": "Oh, shit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 182}},
{"beat_id": "CH03_B11_L0023", "speaker_id": "nimera", "text": "Nobody touch him. Nobody touch the Card. Let it finish before we add anything to the event.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 186}},
{"beat_id": "CH03_B11_L0024", "speaker_id": "cyanis", "text": "It's staying.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 198}},
{"beat_id": "CH03_B11_L0025", "speaker_id": "nimera", "text": "Yes. Stable so far.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 202}},
{"beat_id": "CH03_B11_L0026", "speaker_id": "ilyra", "text": "Same feeling as Brackenwall?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 206}},
{"beat_id": "CH03_B11_L0027", "speaker_id": "cyanis", "text": "No. No shaking, no cold, heart feels normal. It just changed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 208}},
{"beat_id": "CH03_B11_L0028", "speaker_id": "ilyra", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 210}},
{"beat_id": "CH03_B11_L0029", "speaker_id": "torren", "text": "Timing's ugly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 216}},
{"beat_id": "CH03_B11_L0030", "speaker_id": "nimera", "text": "Very.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 218}},
{"beat_id": "CH03_B11_L0031", "speaker_id": "cyanis", "text": "You think they're connected?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 220}},
{"beat_id": "CH03_B11_L0032", "speaker_id": "nimera", "text": "I think the Card changed immediately after that thing finished dying. That's the observation. I *want* to say connected because the timing is screaming at me, and that is exactly why I don't trust myself to say more yet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 224}},
{"beat_id": "CH03_B11_L0033", "speaker_id": "cyanis", "text": "That's a yes with paperwork.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 226}},
{"beat_id": "CH03_B11_L0034", "speaker_id": "nimera", "text": "No. That is a \"maybe\" with standards.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 230}},
{"beat_id": "CH03_B11_L0035", "speaker_id": "torren", "text": "Better phrase.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 232}},
{"beat_id": "CH03_B11_L0036", "speaker_id": "nimera", "text": "Thank you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 234}},
{"beat_id": "CH03_B11_L0037", "speaker_id": "cyanis", "text": "Don't encourage her.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[ONLY NOW — THE CARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 236}},
{"beat_id": "CH03_B11_L0038", "speaker_id": "torren", "text": "Door's giving.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE INNER WAY]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 248}},
{"beat_id": "CH03_B11_L0039", "speaker_id": "nimera", "text": "Without the Card.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE INNER WAY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 250}},
{"beat_id": "CH03_B11_L0040", "speaker_id": "cyanis", "text": "I noticed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE INNER WAY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 252}},
{"beat_id": "CH03_B11_L0041", "speaker_id": "nimera", "text": "I'm saying it because five minutes from now somebody is going to remember \"Card changed, door opened\" and quietly fuse those into one event.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE INNER WAY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_11_FIRST_COMMAND_WARDEN_DRAFT_A.md", "source_line": 254}},
