beats = [
{"beat_id": "CH03_B06_L0001", "speaker_id": "torren", "text": "That marker's wrong now.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 27}},
{"beat_id": "CH03_B06_L0002", "speaker_id": "nimera", "text": "How wrong?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 29}},
{"beat_id": "CH03_B06_L0003", "speaker_id": "torren", "text": "Floor dropped after it was painted. Weight's carrying through the left edge.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 31}},
{"beat_id": "CH03_B06_L0004", "speaker_id": "nimera", "text": "So the official route is lying.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 35}},
{"beat_id": "CH03_B06_L0005", "speaker_id": "torren", "text": "Outdated.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 37}},
{"beat_id": "CH03_B06_L0006", "speaker_id": "nimera", "text": "That's bureaucratic horseshit with a filing system.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 39}},
{"beat_id": "CH03_B06_L0007", "speaker_id": "ilyra", "text": "You two are going to be unbearable together.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 41}},
{"beat_id": "CH03_B06_L0008", "speaker_id": "torren", "text": "Don't include me in that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 43}},
{"beat_id": "CH03_B06_L0009", "speaker_id": "nimera", "text": "Too late. You noticed the floor.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 45}},
{"beat_id": "CH03_B06_L0010", "speaker_id": "cyanis", "text": "Other way?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 49}},
{"beat_id": "CH03_B06_L0011", "speaker_id": "torren", "text": "Better. Less likely to drop us through the damn floor.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 53}},
{"beat_id": "CH03_B06_L0012", "speaker_id": "nimera", "text": "Irritatingly, that's a measurement I can use.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 55}},
{"beat_id": "CH03_B06_L0013", "speaker_id": "nimera", "text": "Useful. Which makes me suspicious as hell.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD CATALOGUE ROOM]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 67}},
{"beat_id": "CH03_B06_L0014", "speaker_id": "ilyra", "text": "Comforting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD CATALOGUE ROOM]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 69}},
{"beat_id": "CH03_B06_L0015", "speaker_id": "nimera", "text": "Here. Same subject copied three times. Oldest hand doesn't explain the mark. Middle copy guesses. Latest copy turns the guess into a category.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD CATALOGUE ROOM]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 71}},
{"beat_id": "CH03_B06_L0016", "speaker_id": "torren", "text": "Normal?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD CATALOGUE ROOM]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 73}},
{"beat_id": "CH03_B06_L0017", "speaker_id": "nimera", "text": "Tragically. One person writes maybe, next person writes probably, third bastard writes obviously, and suddenly everybody has inherited certainty from a corpse.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD CATALOGUE ROOM]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 75}},
{"beat_id": "CH03_B06_L0018", "speaker_id": "cyanis", "text": "You really love archives.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD CATALOGUE ROOM]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 77}},
{"beat_id": "CH03_B06_L0019", "speaker_id": "nimera", "text": "I love evidence. Archives are where evidence goes to acquire opinions.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD CATALOGUE ROOM]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 79}},
{"beat_id": "CH03_B06_L0020", "speaker_id": "nimera", "text": "Also mold.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD CATALOGUE ROOM]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 83}},
{"beat_id": "CH03_B06_L0021", "speaker_id": "ilyra", "text": "Finally, a neutral party.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD CATALOGUE ROOM]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 85}},
{"beat_id": "CH03_B06_L0022", "speaker_id": "nimera", "text": "Catalogue stops here. Balls.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 109}},
{"beat_id": "CH03_B06_L0023", "speaker_id": "torren", "text": "Building doesn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 111}},
{"beat_id": "CH03_B06_L0024", "speaker_id": "nimera", "text": "Exactly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 113}},
{"beat_id": "CH03_B06_L0025", "speaker_id": "nimera", "text": "No closure note. No transfer note. No fire record. No formal sealing order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 117}},
{"beat_id": "CH03_B06_L0026", "speaker_id": "ilyra", "text": "So they just stopped using it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 119}},
{"beat_id": "CH03_B06_L0027", "speaker_id": "nimera", "text": "Maybe. Or stopped recording that they used it. Different problem.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 121}},
{"beat_id": "CH03_B06_L0028", "speaker_id": "nimera", "text": "There should be buried collections beyond this point. If the old references survived anywhere, that's where I'd look.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 125}},
{"beat_id": "CH03_B06_L0029", "speaker_id": "torren", "text": "Route's still passable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 129}},
{"beat_id": "CH03_B06_L0030", "speaker_id": "nimera", "text": "See? This is why I tolerate you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 131}},
{"beat_id": "CH03_B06_L0031", "speaker_id": "torren", "text": "Been an hour.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 133}},
{"beat_id": "CH03_B06_L0032", "speaker_id": "nimera", "text": "A difficult hour.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 135}},
{"beat_id": "CH03_B06_L0033", "speaker_id": "nimera", "text": "Here. Twelve years recorded as inert, then visible geometry during a later response.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 153}},
{"beat_id": "CH03_B06_L0034", "speaker_id": "cyanis", "text": "Same colors?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 155}},
{"beat_id": "CH03_B06_L0035", "speaker_id": "nimera", "text": "No, thank fuck. If it matched yours perfectly, we'd be tempted to marry the cases after one date. This gives us precedent for dormant becoming responsive without pretending the two Cards are the same thing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 157}},
{"beat_id": "CH03_B06_L0036", "speaker_id": "ilyra", "text": "Romantic.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 159}},
{"beat_id": "CH03_B06_L0037", "speaker_id": "nimera", "text": "Scholarship is mostly preventing bad marriages between facts.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 161}},
{"beat_id": "CH03_B06_L0038", "speaker_id": "torren", "text": "This note was added after the original report.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 165}},
{"beat_id": "CH03_B06_L0039", "speaker_id": "nimera", "text": "Yes. Different hand, different ink, twenty-eight years later. Good catch.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 169}},
{"beat_id": "CH03_B06_L0040", "speaker_id": "torren", "text": "I can read, Pellan.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 171}},
{"beat_id": "CH03_B06_L0041", "speaker_id": "nimera", "text": "I never doubted literacy. Judgment remains under review.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 173}},
{"beat_id": "CH03_B06_L0042", "speaker_id": "nimera", "text": "There's a phrase that keeps turning up in these old records. Prime Card.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 177}},
{"beat_id": "CH03_B06_L0043", "speaker_id": "cyanis", "text": "Prime?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 179}},
{"beat_id": "CH03_B06_L0044", "speaker_id": "nimera", "text": "In copied inscriptions. Quoted fragments. Later transcriptions of older writing. Enough independent appearances that the words are real, not one scholar's bad guess.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 181}},
{"beat_id": "CH03_B06_L0045", "speaker_id": "ilyra", "text": "Meaning?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 183}},
{"beat_id": "CH03_B06_L0046", "speaker_id": "nimera", "text": "Nobody fucking knows. That's the point.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 185}},
{"beat_id": "CH03_B06_L0047", "speaker_id": "nimera", "text": "The historians who found the term didn't understand it either. Half the useful notes are basically `Prime Card appears here again; meaning unknown.`", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 189}},
{"beat_id": "CH03_B06_L0048", "speaker_id": "torren", "text": "Then how do they know it isn't just an old name for a normal Card?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 191}},
{"beat_id": "CH03_B06_L0049", "speaker_id": "nimera", "text": "Context. When the old writing mentions ordinary Cards and Prime Cards in the same material, it treats them as different things. That's as far as the evidence goes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 193}},
{"beat_id": "CH03_B06_L0050", "speaker_id": "torren", "text": "Anyone ever see one?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 195}},
{"beat_id": "CH03_B06_L0051", "speaker_id": "nimera", "text": "Not that anyone can prove. No surviving specimen identified as one. No reliable eyewitness description. No account that tells us what one looks like or what the bastard actually does.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 197}},
{"beat_id": "CH03_B06_L0052", "speaker_id": "cyanis", "text": "Could this be one?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 199}},
{"beat_id": "CH03_B06_L0053", "speaker_id": "nimera", "text": "Could be a royal chamber pot if we lower the evidence bar far enough. We do not have evidence to call it Prime. Weird Card plus mysterious ancient term does not equal same thing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 203}},
{"beat_id": "CH03_B06_L0054", "speaker_id": "ilyra", "text": "So Prime Card is an old Diysean term we know they used. We still don't know what they meant by it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 205}},
{"beat_id": "CH03_B06_L0055", "speaker_id": "nimera", "text": "Exactly. The words survived. The fucking explanation didn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 207}},
{"beat_id": "CH03_B06_L0056", "speaker_id": "nimera", "text": "This distinguishes the seal from the impression it leaves. Copying the visible mark is not automatically copying whatever magical authority lives in the working object—which sounds obvious until somebody spends a century writing as though wax is the interesting part.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 219}},
{"beat_id": "CH03_B06_L0057", "speaker_id": "nimera", "text": "Renewal, maintenance, specialized keepers—then the procedure vanishes because the copyist considered it routine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 223}},
{"beat_id": "CH03_B06_L0058", "speaker_id": "ilyra", "text": "That's cruel.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 225}},
{"beat_id": "CH03_B06_L0059", "speaker_id": "nimera", "text": "That copyist can eat shit specifically.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 227}},
{"beat_id": "CH03_B06_L0060", "speaker_id": "torren", "text": "Dead a long time.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 229}},
{"beat_id": "CH03_B06_L0061", "speaker_id": "nimera", "text": "Then they have had ample time to reflect.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 231}},
{"beat_id": "CH03_B06_L0062", "speaker_id": "ilyra", "text": "Older source.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 235}},
{"beat_id": "CH03_B06_L0063", "speaker_id": "nimera", "text": "The copyist says the source tradition predates Yahtrea. That's what we actually have.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 239}},
{"beat_id": "CH03_B06_L0064", "speaker_id": "cyanis", "text": "Same tradition?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 241}},
{"beat_id": "CH03_B06_L0065", "speaker_id": "nimera", "text": "Maybe. Similar is not descended from. Two things can look alike without fucking and producing history. Bad biology for institutions, useful warning.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 243}},
{"beat_id": "CH03_B06_L0066", "speaker_id": "torren", "text": "Same fiber in all three. Pulled selectively.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 253}},
{"beat_id": "CH03_B06_L0067", "speaker_id": "nimera", "text": "Same cut too.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 257}},
{"beat_id": "CH03_B06_L0068", "speaker_id": "nimera", "text": "Card response. Authority seals. Westways ruins.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 261}},
{"beat_id": "CH03_B06_L0069", "speaker_id": "cyanis", "text": "Same shit we're chasing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 263}},
{"beat_id": "CH03_B06_L0070", "speaker_id": "nimera", "text": "Same subjects. Not necessarily same question.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 265}},
{"beat_id": "CH03_B06_L0071", "speaker_id": "nimera", "text": "And this one cross-references historical Face classifications.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 269}},
{"beat_id": "CH03_B06_L0072", "speaker_id": "ilyra", "text": "One reader?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 271}},
{"beat_id": "CH03_B06_L0073", "speaker_id": "nimera", "text": "Maybe. One research trail is safer. Could be multiple people sharing work, one person over time, or some poor bastard inheriting somebody else's obsession.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 273}},
{"beat_id": "CH03_B06_L0074", "speaker_id": "torren", "text": "Recent enough to matter.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 275}},
{"beat_id": "CH03_B06_L0075", "speaker_id": "nimera", "text": "How recent?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 277}},
{"beat_id": "CH03_B06_L0076", "speaker_id": "torren", "text": "Can't give you a day. Not old enough to disappear into normal use.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 281}},
{"beat_id": "CH03_B06_L0077", "speaker_id": "nimera", "text": "Good. That's an answer with bones in it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 283}},
{"beat_id": "CH03_B06_L0078", "speaker_id": "nimera", "text": "Whoever did this knew enough to skip introductory material.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE TRAIL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 289}},
{"beat_id": "CH03_B06_L0079", "speaker_id": "cyanis", "text": "Specialist?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE TRAIL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 291}},
{"beat_id": "CH03_B06_L0080", "speaker_id": "nimera", "text": "Or someone with a very good reading list. Don't promote them yet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE TRAIL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 293}},
{"beat_id": "CH03_B06_L0081", "speaker_id": "nimera", "text": "Hall of Seals.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE TRAIL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 297}},
{"beat_id": "CH03_B06_L0082", "speaker_id": "ilyra", "text": "Convenient.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE TRAIL]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 299}},
{"beat_id": "CH03_B06_L0083", "speaker_id": "nimera", "text": "Suspiciously.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE TRAIL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 301}},
{"beat_id": "CH03_B06_L0084", "speaker_id": "torren", "text": "You look happy and pissed off.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE TRAIL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 303}},
{"beat_id": "CH03_B06_L0085", "speaker_id": "nimera", "text": "Those are not opposites.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE TRAIL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 305}},
{"beat_id": "CH03_B06_L0086", "speaker_id": "nimera", "text": "Here. Working seal damaged during transfer. Impression still looked correct. Magical response weakened afterward.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 319}},
{"beat_id": "CH03_B06_L0087", "speaker_id": "cyanis", "text": "Then restored?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 321}},
{"beat_id": "CH03_B06_L0088", "speaker_id": "nimera", "text": "Same physical seal body. Later keeper work restores the response.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 323}},
{"beat_id": "CH03_B06_L0089", "speaker_id": "ilyra", "text": "So the visible mark and the magical function were tracked separately.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 325}},
{"beat_id": "CH03_B06_L0090", "speaker_id": "nimera", "text": "Yes. That's the useful part.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 327}},
{"beat_id": "CH03_B06_L0091", "speaker_id": "torren", "text": "Method?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 329}},
{"beat_id": "CH03_B06_L0092", "speaker_id": "nimera", "text": "Referenced somewhere else, because apparently dead archivists were pricks with a taste for treasure hunts.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 331}},
{"beat_id": "CH03_B06_L0093", "speaker_id": "cyanis", "text": "Does that mean Lysara doesn't have to consciously put magic into every document?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 333}},
{"beat_id": "CH03_B06_L0094", "speaker_id": "nimera", "text": "Probably. Historical model, not direct proof about her specific seal. Keep the qualifier attached or I will physically staple it to the sentence.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 335}},
{"beat_id": "CH03_B06_L0095", "speaker_id": "cyanis", "text": "I heard you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 337}},
{"beat_id": "CH03_B06_L0096", "speaker_id": "torren", "text": "You correct your own jokes too?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 339}},
{"beat_id": "CH03_B06_L0097", "speaker_id": "nimera", "text": "Especially the bad ones.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — WORKING SEAL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 341}},
{"beat_id": "CH03_B06_L0098", "speaker_id": "torren", "text": "Same kind of seal?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OLDER PRECEDENT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 349}},
{"beat_id": "CH03_B06_L0099", "speaker_id": "nimera", "text": "Similar authority object in a very old copied source. The writer thought the practice predated Yahtrea. Looks related, maybe it is. I'm not shoving six missing centuries up history's ass because the shapes rhyme.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OLDER PRECEDENT]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 351}},
{"beat_id": "CH03_B06_L0100", "speaker_id": "ilyra", "text": "So the broad practice predates Yahtrea.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OLDER PRECEDENT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 353}},
{"beat_id": "CH03_B06_L0101", "speaker_id": "nimera", "text": "That much I buy. Lineage is where I stop.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OLDER PRECEDENT]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 355}},
{"beat_id": "CH03_B06_L0102", "speaker_id": "torren", "text": "Same recent handling.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 361}},
{"beat_id": "CH03_B06_L0103", "speaker_id": "nimera", "text": "Same cut. Same fold. Same habit of treating support straps like they insulted someone's mother.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 365}},
{"beat_id": "CH03_B06_L0104", "speaker_id": "ilyra", "text": "That last one evidence?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 367}},
{"beat_id": "CH03_B06_L0105", "speaker_id": "nimera", "text": "Emotional evidence.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 369}},
{"beat_id": "CH03_B06_L0106", "speaker_id": "torren", "text": "Trail continues.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 373}},
{"beat_id": "CH03_B06_L0107", "speaker_id": "nimera", "text": "Oldest seal references are down in the deep collections. Whoever did this was not browsing. They knew what they wanted.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 377}},
{"beat_id": "CH03_B06_L0108", "speaker_id": "cyanis", "text": "So what the hell were they after?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 379}},
{"beat_id": "CH03_B06_L0109", "speaker_id": "nimera", "text": "Whatever it was, they weren't browsing. I'm not crawling up a stranger's ass and inventing the rest.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 381}},
{"beat_id": "CH03_B06_L0110", "speaker_id": "torren", "text": "Damn good policy.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 383}},
{"beat_id": "CH03_B06_L0111", "speaker_id": "nimera", "text": "Stop agreeing with me. It's unsettling.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT READER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B06_LOWER_ARCHIVES_INVESTIGATION_DIALOGUE.md", "source_line": 385}}
]
