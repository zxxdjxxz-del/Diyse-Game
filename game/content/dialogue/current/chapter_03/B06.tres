{"beat_id": "CH03_B06_L0076", "speaker_id": "torren", "text": "In, then up.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WALL WINS FOR NOW]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_06_SCHOLAR_IN_REDACTED_STACKS_DRAFT_A.md", "source_line": 215}},
{"beat_id": "CH03_B06_L0077", "speaker_id": "nimera", "text": "Mine moved down when it closed. Or—no. Two moved down. Third rotated first, then dropped. I assumed that was the same action because they happened together. That's not the same thing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WALL WINS FOR NOW]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_06_SCHOLAR_IN_REDACTED_STACKS_DRAFT_A.md", "source_line": 219}},
