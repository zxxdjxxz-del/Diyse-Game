beats = [
{"beat_id": "CH03_C07_L0001", "speaker_id": "nimera", "text": "That's not a category.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPTIONAL CHARACTER-LIFE — CRESTHAVEN SUPPLY ROOM]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 19}},
{"beat_id": "CH03_C07_L0002", "speaker_id": "ilyra", "text": "It is if you stop caring.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPTIONAL CHARACTER-LIFE — CRESTHAVEN SUPPLY ROOM]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 23}},
{"beat_id": "CH03_C07_L0003", "speaker_id": "nimera", "text": "No. That's bullshit surrender disguised as handwriting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPTIONAL CHARACTER-LIFE — CRESTHAVEN SUPPLY ROOM]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 27}},
{"beat_id": "CH03_C07_L0004", "speaker_id": "ilyra", "text": "It's a box.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPTIONAL CHARACTER-LIFE — CRESTHAVEN SUPPLY ROOM]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 29}},
{"beat_id": "CH03_C07_L0005", "speaker_id": "nimera", "text": "Boxes can participate in bad systems.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPTIONAL CHARACTER-LIFE — CRESTHAVEN SUPPLY ROOM]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 31}},
{"beat_id": "CH03_C07_L0006", "speaker_id": "ilyra", "text": "Brave position.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPTIONAL CHARACTER-LIFE — CRESTHAVEN SUPPLY ROOM]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 33}},
{"beat_id": "CH03_C07_L0007", "speaker_id": "nimera", "text": "Why is there a spoon?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPTIONAL CHARACTER-LIFE — CRESTHAVEN SUPPLY ROOM]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 41}},
{"beat_id": "CH03_C07_L0008", "speaker_id": "ilyra", "text": "Eating.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPTIONAL CHARACTER-LIFE — CRESTHAVEN SUPPLY ROOM]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 43}},
{"beat_id": "CH03_C07_L0009", "speaker_id": "nimera", "text": "I know what a spoon does.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPTIONAL CHARACTER-LIFE — CRESTHAVEN SUPPLY ROOM]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 45}},
{"beat_id": "CH03_C07_L0010", "speaker_id": "ilyra", "text": "You asked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPTIONAL CHARACTER-LIFE — CRESTHAVEN SUPPLY ROOM]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 47}},
{"beat_id": "CH03_C07_L0011", "speaker_id": "nimera", "text": "I asked why it's in here with cord, wax, hardware, chalk, and whatever else somebody got sick of sorting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPTIONAL CHARACTER-LIFE — CRESTHAVEN SUPPLY ROOM]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 49}},
{"beat_id": "CH03_C07_L0012", "speaker_id": "ilyra", "text": "Maybe they were tired.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPTIONAL CHARACTER-LIFE — CRESTHAVEN SUPPLY ROOM]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 51}},
{"beat_id": "CH03_C07_L0013", "speaker_id": "nimera", "text": "Annoyingly plausible.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPTIONAL CHARACTER-LIFE — CRESTHAVEN SUPPLY ROOM]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 55}},
{"beat_id": "CH03_C07_L0014", "speaker_id": "nimera", "text": "What are you doing?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SORT]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 65}},
{"beat_id": "CH03_C07_L0015", "speaker_id": "ilyra", "text": "Taking cord.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SORT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 67}},
{"beat_id": "CH03_C07_L0016", "speaker_id": "nimera", "text": "I just placed that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SORT]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 69}},
{"beat_id": "CH03_C07_L0017", "speaker_id": "ilyra", "text": "I noticed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SORT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 71}},
{"beat_id": "CH03_C07_L0018", "speaker_id": "nimera", "text": "Then why did you move it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SORT]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 73}},
{"beat_id": "CH03_C07_L0019", "speaker_id": "ilyra", "text": "I need cord.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SORT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 75}},
{"beat_id": "CH03_C07_L0020", "speaker_id": "nimera", "text": "You're contaminating the sort.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SORT]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 79}},
{"beat_id": "CH03_C07_L0021", "speaker_id": "ilyra", "text": "It's string.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SORT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 81}},
{"beat_id": "CH03_C07_L0022", "speaker_id": "nimera", "text": "Cord.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SORT]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 83}},
{"beat_id": "CH03_C07_L0023", "speaker_id": "ilyra", "text": "Somehow worse.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SORT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 85}},
{"beat_id": "CH03_C07_L0024", "speaker_id": "nimera", "text": "Wait. All of it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SORT]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 89}},
{"beat_id": "CH03_C07_L0025", "speaker_id": "ilyra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SORT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 93}},
{"beat_id": "CH03_C07_L0026", "speaker_id": "nimera", "text": "Fine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SORT]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 95}},
{"beat_id": "CH03_C07_L0027", "speaker_id": "nimera", "text": "You're doing this on purpose now.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SORT]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 99}},
{"beat_id": "CH03_C07_L0028", "speaker_id": "ilyra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SORT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 101}},
{"beat_id": "CH03_C07_L0029", "speaker_id": "nimera", "text": "Good. I was worried you were actually like this.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SORT]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 105}},
{"beat_id": "CH03_C07_L0030", "speaker_id": "ilyra", "text": "I can be both.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE SORT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 107}},
{"beat_id": "CH03_C07_L0031", "speaker_id": "ilyra", "text": "What's that?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE UNKNOWN PIECE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 115}},
{"beat_id": "CH03_C07_L0032", "speaker_id": "nimera", "text": "Don't know. Some kind of manufactured fitting. Bend might be damage.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE UNKNOWN PIECE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 117}},
{"beat_id": "CH03_C07_L0033", "speaker_id": "ilyra", "text": "Miscellaneous.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE UNKNOWN PIECE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 119}},
{"beat_id": "CH03_C07_L0034", "speaker_id": "nimera", "text": "Fuck no.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE UNKNOWN PIECE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 123}},
{"beat_id": "CH03_C07_L0035", "speaker_id": "ilyra", "text": "Seems accurate.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE UNKNOWN PIECE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 125}},
{"beat_id": "CH03_C07_L0036", "speaker_id": "nimera", "text": "Unknown function means I don't know what the damn thing is. Miscellaneous means somebody stopped sorting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE UNKNOWN PIECE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 127}},
{"beat_id": "CH03_C07_L0037", "speaker_id": "ilyra", "text": "It came from the miscellaneous box.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE UNKNOWN PIECE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 129}},
{"beat_id": "CH03_C07_L0038", "speaker_id": "nimera", "text": "Which is already an accusation against the box.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE UNKNOWN PIECE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 131}},
{"beat_id": "CH03_C07_L0039", "speaker_id": "nimera", "text": "Fine. Against whoever labeled the box. Maybe they were tired, rushed, inheriting somebody else's disaster—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE UNKNOWN PIECE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 137}},
{"beat_id": "CH03_C07_L0040", "speaker_id": "ilyra", "text": "You're defending them now.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE UNKNOWN PIECE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 139}},
{"beat_id": "CH03_C07_L0041", "speaker_id": "nimera", "text": "I'm correcting myself. Don't make it sentimental.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE UNKNOWN PIECE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 141}},
{"beat_id": "CH03_C07_L0042", "speaker_id": "nimera", "text": "There. You know I'm right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE UNKNOWN PIECE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C07_ILYRA_AND_NIMERA_DIALOGUE.md", "source_line": 145}},
