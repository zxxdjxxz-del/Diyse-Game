beats = [
{"beat_id": "CH03_B10_L0001", "speaker_id": "torren", "text": "Same six.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 21}},
{"beat_id": "CH03_B10_L0002", "speaker_id": "nimera", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 23}},
{"beat_id": "CH03_B10_L0003", "speaker_id": "nimera", "text": "Might. Elements. Grace. Memory. Perception. Ruin.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 27}},
{"beat_id": "CH03_B10_L0004", "speaker_id": "cyanis", "text": "Modern names?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 29}},
{"beat_id": "CH03_B10_L0005", "speaker_id": "nimera", "text": "Later names for symbol families that survived into Card scholarship. Useful comparison, not permission to pretend every Diysean used our exact definitions.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 31}},
{"beat_id": "CH03_B10_L0006", "speaker_id": "ilyra", "text": "They're all treated the same here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 33}},
{"beat_id": "CH03_B10_L0007", "speaker_id": "nimera", "text": "Structurally, yes. Which matters.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 35}},
{"beat_id": "CH03_B10_L0008", "speaker_id": "nimera", "text": "And before somebody decides Ruin belongs in the evil-ass corner, it doesn't. Same weight, same placement, same workmanship.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 39}},
{"beat_id": "CH03_B10_L0009", "speaker_id": "torren", "text": "Nobody said that shit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 41}},
{"beat_id": "CH03_B10_L0010", "speaker_id": "nimera", "text": "Preventive maintenance.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 43}},
{"beat_id": "CH03_B10_L0011", "speaker_id": "cyanis", "text": "On people again?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 45}},
{"beat_id": "CH03_B10_L0012", "speaker_id": "nimera", "text": "People are the highest-maintenance archive problem.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 47}},
{"beat_id": "CH03_B10_L0013", "speaker_id": "ilyra", "text": "That moved.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD COPYING FLOOR]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 63}},
{"beat_id": "CH03_B10_L0014", "speaker_id": "nimera", "text": "I saw.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD COPYING FLOOR]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 65}},
{"beat_id": "CH03_B10_L0015", "speaker_id": "torren", "text": "More behind it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD COPYING FLOOR]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 67}},
{"beat_id": "CH03_B10_L0016", "speaker_id": "cyanis", "text": "Still archive equipment?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD COPYING FLOOR]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 69}},
{"beat_id": "CH03_B10_L0017", "speaker_id": "nimera", "text": "Probably. Or archive equipment with the survival instincts of a cornered badger.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD COPYING FLOOR]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 73}},
{"beat_id": "CH03_B10_L0018", "speaker_id": "nimera", "text": "Badger was wrong. Too charming.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD COPYING FLOOR]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 77}},
{"beat_id": "CH03_B10_L0019", "speaker_id": "nimera", "text": "That's not one arm.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[LATE DEEP ARCHIVES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 89}},
{"beat_id": "CH03_B10_L0020", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[LATE DEEP ARCHIVES]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 91}},
{"beat_id": "CH03_B10_L0021", "speaker_id": "ilyra", "text": "You sound disappointed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[LATE DEEP ARCHIVES]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 93}},
{"beat_id": "CH03_B10_L0022", "speaker_id": "nimera", "text": "I'm deciding whether this is fascinating or an intellectual hemorrhoid.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[LATE DEEP ARCHIVES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 95}},
{"beat_id": "CH03_B10_L0023", "speaker_id": "cyanis", "text": "Decision made?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[LATE DEEP ARCHIVES]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 99}},
{"beat_id": "CH03_B10_L0024", "speaker_id": "nimera", "text": "Both.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[LATE DEEP ARCHIVES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B10_DEEP_ARCHIVES_DIALOGUE.md", "source_line": 103}}
]
