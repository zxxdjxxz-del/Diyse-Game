{"beat_id": "CH03_C06_L0008", "speaker_id": "torren", "text": "Didn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPTIONAL CHARACTER-LIFE TRIGGER — CRESTHAVEN RECORDS / MAP ROOM]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C06_NIMERA_TAKES_OVER_A_TABLE_DIALOGUE.md", "source_line": 47}},
{"beat_id": "CH03_C06_L0009", "speaker_id": "nimera", "text": "I don't care. Continue. I want enough evidence to assign blame properly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPTIONAL CHARACTER-LIFE TRIGGER — CRESTHAVEN RECORDS / MAP ROOM]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C06_NIMERA_TAKES_OVER_A_TABLE_DIALOGUE.md", "source_line": 49}},
{"beat_id": "CH03_C06_L0010", "speaker_id": "cyanis", "text": "Absolutely not.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPTIONAL CHARACTER-LIFE TRIGGER — CRESTHAVEN RECORDS / MAP ROOM]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C06_NIMERA_TAKES_OVER_A_TABLE_DIALOGUE.md", "source_line": 51}},
{"beat_id": "CH03_C06_L0011", "speaker_id": "nimera", "text": "Coward.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPTIONAL CHARACTER-LIFE TRIGGER — CRESTHAVEN RECORDS / MAP ROOM]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/C06_NIMERA_TAKES_OVER_A_TABLE_DIALOGUE.md", "source_line": 53}},
