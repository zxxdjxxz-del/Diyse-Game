beats = [
{"beat_id": "CH03_B01_L0001", "speaker_id": "maevra", "text": "Palace first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — CAELORA GATE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 29}},
{"beat_id": "CH03_B01_L0002", "speaker_id": "cyanis", "text": "I can see three places selling food from here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — CAELORA GATE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 33}},
{"beat_id": "CH03_B01_L0003", "speaker_id": "maevra", "text": "Then you can admire them on the way uphill.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — CAELORA GATE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 35}},
{"beat_id": "CH03_B01_L0004", "speaker_id": "torren", "text": "Palace is uphill.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — CAELORA GATE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 37}},
{"beat_id": "CH03_B01_L0005", "speaker_id": "cyanis", "text": "I hadn't asked you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — CAELORA GATE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 41}},
{"beat_id": "CH03_B01_L0006", "speaker_id": "torren", "text": "Still true.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — CAELORA GATE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 43}},
{"beat_id": "CH03_B01_L0007", "speaker_id": "ilyra", "text": "Devastating. Beaten by topography.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — CAELORA GATE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 45}},
{"beat_id": "CH03_B01_L0008", "speaker_id": "cyanis", "text": "You're enjoying this.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — CAELORA GATE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 47}},
{"beat_id": "CH03_B01_L0009", "speaker_id": "ilyra", "text": "More than I expected.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — CAELORA GATE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH03_B01_L0010", "speaker_id": "maevra", "text": "Keep moving.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — CAELORA GATE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 51}},
{"beat_id": "CH03_B01_L0011", "speaker_id": "torren", "text": "Wayfinder had more city than this.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FIRST CAELORA STRETCH]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 61}},
{"beat_id": "CH03_B01_L0012", "speaker_id": "maevra", "text": "How much more?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FIRST CAELORA STRETCH]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 65}},
{"beat_id": "CH03_B01_L0013", "speaker_id": "torren", "text": "Enough that this wall would've been inside it. Not near the edge. Road alignment's changed, and the Wayfinder is broken through the middle of the old capital cluster, so I can't lay one over the other cleanly. But larger isn't a guess.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FIRST CAELORA STRETCH]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 67}},
{"beat_id": "CH03_B01_L0014", "speaker_id": "cyanis", "text": "So the modern wall sits inside the old footprint.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FIRST CAELORA STRETCH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 71}},
{"beat_id": "CH03_B01_L0015", "speaker_id": "torren", "text": "Yeah. How far inside, I can't defend from the copy.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FIRST CAELORA STRETCH]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 73}},
{"beat_id": "CH03_B01_L0016", "speaker_id": "maevra", "text": "Say that upstairs.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FIRST CAELORA STRETCH]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 75}},
{"beat_id": "CH03_B01_L0017", "speaker_id": "torren", "text": "Was planning to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FIRST CAELORA STRETCH]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 77}},
{"beat_id": "CH03_B01_L0018", "speaker_id": "ilyra", "text": "You look offended she thought you might overstate it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FIRST CAELORA STRETCH]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 81}},
{"beat_id": "CH03_B01_L0019", "speaker_id": "torren", "text": "Bad measurements piss me off.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FIRST CAELORA STRETCH]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 83}},
{"beat_id": "CH03_B01_L0020", "speaker_id": "cyanis", "text": "There he is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FIRST CAELORA STRETCH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 85}},
{"beat_id": "CH03_B01_L0021", "speaker_id": "cyanis", "text": "Still hungry.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FIRST CAELORA STRETCH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 89}},
{"beat_id": "CH03_B01_L0022", "speaker_id": "torren", "text": "Palace is still uphill.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FIRST CAELORA STRETCH]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 91}},
{"beat_id": "CH03_B01_L0023", "speaker_id": "ilyra", "text": "I think that's becoming his answer to you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FIRST CAELORA STRETCH]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 93}},
{"beat_id": "CH03_B01_L0024", "speaker_id": "cyanis", "text": "I regret this entire group.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FIRST CAELORA STRETCH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 95}},
{"beat_id": "CH03_B01_L0025", "speaker_id": "maevra", "text": "No, you don't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FIRST CAELORA STRETCH]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 97}},
{"beat_id": "CH03_B01_L0026", "speaker_id": "cyanis", "text": "Not yet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FIRST CAELORA STRETCH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_01_CAELORA_GATE_ARRIVAL_DRAFT_A.md", "source_line": 99}}
]
