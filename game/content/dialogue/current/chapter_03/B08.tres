beats = [
{"beat_id": "CH03_B08_L0001", "speaker_id": "nimera", "text": "Here. Twelve years recorded as inert, then visible geometry during a later response.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 19}},
{"beat_id": "CH03_B08_L0002", "speaker_id": "cyanis", "text": "Same colors?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 21}},
{"beat_id": "CH03_B08_L0003", "speaker_id": "nimera", "text": "No, thank fuck. If it matched yours perfectly, we'd be tempted to marry the cases after one date. This gives us precedent for dormant becoming responsive without pretending the two Cards are the same thing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 23}},
{"beat_id": "CH03_B08_L0004", "speaker_id": "ilyra", "text": "Romantic.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 25}},
{"beat_id": "CH03_B08_L0005", "speaker_id": "nimera", "text": "Scholarship is mostly preventing bad marriages between facts.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 27}},
{"beat_id": "CH03_B08_L0006", "speaker_id": "torren", "text": "This note was added after the original report.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 31}},
{"beat_id": "CH03_B08_L0007", "speaker_id": "nimera", "text": "Yes. Different hand, different ink, twenty-eight years later. Good catch.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 35}},
{"beat_id": "CH03_B08_L0008", "speaker_id": "torren", "text": "I can read, Pellan.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 37}},
{"beat_id": "CH03_B08_L0009", "speaker_id": "nimera", "text": "I never doubted literacy. Judgment remains under review.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 39}},
{"beat_id": "CH03_B08_L0010", "speaker_id": "nimera", "text": "There's a phrase that keeps turning up in Diysean material. Prime Card.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 43}},
{"beat_id": "CH03_B08_L0011", "speaker_id": "cyanis", "text": "Prime?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 45}},
{"beat_id": "CH03_B08_L0012", "speaker_id": "nimera", "text": "In inscriptions. Fragmentary texts. Later copies of older writing. Enough independent appearances that the words are real, not one scholar's bad guess.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 47}},
{"beat_id": "CH03_B08_L0013", "speaker_id": "ilyra", "text": "Meaning?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 49}},
{"beat_id": "CH03_B08_L0014", "speaker_id": "nimera", "text": "Nobody fucking knows. That's the point.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 51}},
{"beat_id": "CH03_B08_L0015", "speaker_id": "nimera", "text": "The historians who found the term didn't understand it either. Half the useful notes are basically `Prime Card appears here again; meaning unknown.`", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 55}},
{"beat_id": "CH03_B08_L0016", "speaker_id": "torren", "text": "Then how do they know it isn't just an old name for a normal Card?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 57}},
{"beat_id": "CH03_B08_L0017", "speaker_id": "nimera", "text": "Context. When the old writing mentions ordinary Cards and Prime Cards in the same material, it treats them as different things. That's as far as the evidence goes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 59}},
{"beat_id": "CH03_B08_L0018", "speaker_id": "torren", "text": "Anyone ever see one?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 61}},
{"beat_id": "CH03_B08_L0019", "speaker_id": "nimera", "text": "Not that anyone can prove. No surviving specimen identified as one. No reliable eyewitness description. No account that tells us what one looks like or what the bastard actually does.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 63}},
{"beat_id": "CH03_B08_L0020", "speaker_id": "cyanis", "text": "Could this be one?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 65}},
{"beat_id": "CH03_B08_L0021", "speaker_id": "nimera", "text": "Could be a royal chamber pot if we lower the evidence bar far enough. We do not have evidence to call it Prime. Weird Card plus mysterious ancient term does not equal same thing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 69}},
{"beat_id": "CH03_B08_L0022", "speaker_id": "ilyra", "text": "So Prime Card is an old Diysean term we know they used. We still don't know what they meant by it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 71}},
{"beat_id": "CH03_B08_L0023", "speaker_id": "nimera", "text": "Exactly. The words survived. The fucking explanation didn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — CARD CASES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 73}},
{"beat_id": "CH03_B08_L0024", "speaker_id": "nimera", "text": "This distinguishes the seal from the impression it leaves. Copying the visible mark is not automatically copying whatever magical authority lives in the working object—which sounds obvious until somebody spends a century writing as though wax is the interesting part.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 85}},
{"beat_id": "CH03_B08_L0025", "speaker_id": "nimera", "text": "Renewal, maintenance, specialized keepers—then the procedure vanishes because the copyist considered it routine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 89}},
{"beat_id": "CH03_B08_L0026", "speaker_id": "ilyra", "text": "That's cruel.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 91}},
{"beat_id": "CH03_B08_L0027", "speaker_id": "nimera", "text": "That copyist can eat shit specifically.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 93}},
{"beat_id": "CH03_B08_L0028", "speaker_id": "torren", "text": "Dead a long time.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 95}},
{"beat_id": "CH03_B08_L0029", "speaker_id": "nimera", "text": "Then they have had ample time to reflect.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 97}},
{"beat_id": "CH03_B08_L0030", "speaker_id": "ilyra", "text": "Older source.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 101}},
{"beat_id": "CH03_B08_L0031", "speaker_id": "nimera", "text": "Older than Yahtrea. Diysean authority-seal material, or at least a later copy claiming that provenance.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 105}},
{"beat_id": "CH03_B08_L0032", "speaker_id": "cyanis", "text": "Same tradition?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 107}},
{"beat_id": "CH03_B08_L0033", "speaker_id": "nimera", "text": "Maybe. Similar is not descended from. Two things can look alike without fucking and producing history. Bad biology for institutions, useful warning.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORED STOP — AUTHORITY RECORD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 109}},
{"beat_id": "CH03_B08_L0034", "speaker_id": "torren", "text": "Same fiber in all three. Pulled selectively.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 119}},
{"beat_id": "CH03_B08_L0035", "speaker_id": "nimera", "text": "Same cut too.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 123}},
{"beat_id": "CH03_B08_L0036", "speaker_id": "nimera", "text": "Card response. Authority seals. Westways ruins.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 127}},
{"beat_id": "CH03_B08_L0037", "speaker_id": "cyanis", "text": "Same shit we're chasing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 129}},
{"beat_id": "CH03_B08_L0038", "speaker_id": "nimera", "text": "Same subjects. Not necessarily same question.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 131}},
{"beat_id": "CH03_B08_L0039", "speaker_id": "nimera", "text": "And this one cross-references historical Face classifications.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 135}},
{"beat_id": "CH03_B08_L0040", "speaker_id": "ilyra", "text": "One reader?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 137}},
{"beat_id": "CH03_B08_L0041", "speaker_id": "nimera", "text": "Maybe. One research trail is safer. Could be multiple people sharing work, one person over time, or some poor bastard inheriting somebody else's obsession.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 139}},
{"beat_id": "CH03_B08_L0042", "speaker_id": "torren", "text": "Recent enough to matter.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 141}},
{"beat_id": "CH03_B08_L0043", "speaker_id": "nimera", "text": "How recent?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 143}},
{"beat_id": "CH03_B08_L0044", "speaker_id": "torren", "text": "Can't give you a day. Not old enough to disappear into normal use.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 147}},
{"beat_id": "CH03_B08_L0045", "speaker_id": "nimera", "text": "Good. That's an answer with bones in it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RECENT USE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 149}},
{"beat_id": "CH03_B08_L0046", "speaker_id": "nimera", "text": "Whoever did this knew enough to skip introductory material.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE TRAIL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 155}},
{"beat_id": "CH03_B08_L0047", "speaker_id": "cyanis", "text": "Specialist?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE TRAIL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 157}},
{"beat_id": "CH03_B08_L0048", "speaker_id": "nimera", "text": "Or someone with a very good reading list. Don't promote them yet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE TRAIL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 159}},
{"beat_id": "CH03_B08_L0049", "speaker_id": "nimera", "text": "Hall of Seals.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE TRAIL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 163}},
{"beat_id": "CH03_B08_L0050", "speaker_id": "ilyra", "text": "Convenient.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE TRAIL]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 165}},
{"beat_id": "CH03_B08_L0051", "speaker_id": "nimera", "text": "Suspiciously.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE TRAIL]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 167}},
{"beat_id": "CH03_B08_L0052", "speaker_id": "torren", "text": "You look happy and pissed off.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE TRAIL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B08_BURIED_COLLECTIONS_RECENT_READER_DIALOGUE.md", "source_line": 169}},
