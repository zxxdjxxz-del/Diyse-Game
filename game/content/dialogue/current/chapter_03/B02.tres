beats = [
{"beat_id": "CH03_B02_L0001", "speaker_id": "lysara", "text": "Start with the people.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 15}},
{"beat_id": "CH03_B02_L0002", "speaker_id": "maevra", "text": "Everyone still being held at the Bastion is out. The road is open again. Rhazek survived and withdrew with what he could still organize. Earlier groups were already gone before we reached them, and none of the people we recovered knew where they'd been taken.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 17}},
{"beat_id": "CH03_B02_L0003", "speaker_id": "lysara", "text": "Their condition?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 19}},
{"beat_id": "CH03_B02_L0004", "speaker_id": "ilyra", "text": "Exhausted. Some injuries had gone too long without proper care. Several could walk, but not through the route we used to get inside.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 23}},
{"beat_id": "CH03_B02_L0005", "speaker_id": "mirena", "text": "So the road had to be taken first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 25}},
{"beat_id": "CH03_B02_L0006", "speaker_id": "ilyra", "text": "Yes. Three armed people could manage the old route. That group couldn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 27}},
{"beat_id": "CH03_B02_L0007", "speaker_id": "lysara", "text": "The route.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 31}},
{"beat_id": "CH03_B02_L0008", "speaker_id": "othmar", "text": "The Old Waterworks?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 35}},
{"beat_id": "CH03_B02_L0009", "speaker_id": "maevra", "text": "At first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 37}},
{"beat_id": "CH03_B02_L0010", "speaker_id": "torren", "text": "Then older construction. Much older. The Bastion was built into it in places and cut through it in others. We followed the old structure under the fort and came up inside.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 41}},
{"beat_id": "CH03_B02_L0011", "speaker_id": "othmar", "text": "Black Host work?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 43}},
{"beat_id": "CH03_B02_L0012", "speaker_id": "torren", "text": "No. I can defend that. I can't tell you what the older place was built for.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 45}},
{"beat_id": "CH03_B02_L0013", "speaker_id": "mirena", "text": "A distinction I appreciate.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH03_B02_L0014", "speaker_id": "torren", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 51}},
{"beat_id": "CH03_B02_L0015", "speaker_id": "torren", "text": "This is a field copy. Placement and route relationships are good. It is not a survey.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 55}},
{"beat_id": "CH03_B02_L0016", "speaker_id": "mirena", "text": "This is Caelora.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH03_B02_L0017", "speaker_id": "torren", "text": "Same location. Older city was much larger. The wall we just entered through would've been inside its footprint.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 61}},
{"beat_id": "CH03_B02_L0018", "speaker_id": "mirena", "text": "And this is separate.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 65}},
{"beat_id": "CH03_B02_L0019", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 67}},
{"beat_id": "CH03_B02_L0020", "speaker_id": "mirena", "text": "That's the Yahtrean Crest.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 71}},
{"beat_id": "CH03_B02_L0021", "speaker_id": "lysara", "text": "How certain?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 77}},
{"beat_id": "CH03_B02_L0022", "speaker_id": "torren", "text": "About the mark? Certain. About why it's there, what that structure was, or whether it meant then what it means now? I don't know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 79}},
{"beat_id": "CH03_B02_L0023", "speaker_id": "lysara", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 81}},
{"beat_id": "CH03_B02_L0024", "speaker_id": "mirena", "text": "If enough of the Old City archives survived, there may be something comparable below us.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 85}},
{"beat_id": "CH03_B02_L0025", "speaker_id": "othmar", "text": "There may also be several centuries of useless fragments.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 87}},
{"beat_id": "CH03_B02_L0026", "speaker_id": "mirena", "text": "Those aren't mutually exclusive.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 89}},
{"beat_id": "CH03_B02_L0027", "speaker_id": "lysara", "text": "Later. Finish the report.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 91}},
{"beat_id": "CH03_B02_L0028", "speaker_id": "maevra", "text": "The Card came from the Diysean ruins in the Westways. Before the convoy was attacked, it was already being moved toward Caelora under what we understood to be Crown authority.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 95}},
{"beat_id": "CH03_B02_L0029", "speaker_id": "lysara", "text": "It remains with you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 99}},
{"beat_id": "CH03_B02_L0030", "speaker_id": "cyanis", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 101}},
{"beat_id": "CH03_B02_L0031", "speaker_id": "lysara", "text": "By choice?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 103}},
{"beat_id": "CH03_B02_L0032", "speaker_id": "cyanis", "text": "By experience. Brackenwall tried separating us. My pulse dropped, I started shaking, and the Card lit toward me. Putting it back stopped it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 105}},
{"beat_id": "CH03_B02_L0033", "speaker_id": "ilyra", "text": "His pulse recovered after contact was restored. We didn't repeat the test.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 109}},
{"beat_id": "CH03_B02_L0034", "speaker_id": "cyanis", "text": "I was strongly in favor of that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 111}},
{"beat_id": "CH03_B02_L0035", "speaker_id": "lysara", "text": "Sensible.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 115}},
{"beat_id": "CH03_B02_L0036", "speaker_id": "othmar", "text": "The transport to Caelora was formally authorized?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 119}},
{"beat_id": "CH03_B02_L0037", "speaker_id": "maevra", "text": "That's what the chain showed. Direct Crown authority.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 121}},
{"beat_id": "CH03_B02_L0038", "speaker_id": "othmar", "text": "You still have the order?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 123}},
{"beat_id": "CH03_B02_L0039", "speaker_id": "maevra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 125}},
