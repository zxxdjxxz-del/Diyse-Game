beats = [
{"beat_id": "CH03_B02_L0001", "speaker_id": "lysara", "text": "Start with the people.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 23}},
{"beat_id": "CH03_B02_L0002", "speaker_id": "maevra", "text": "Everyone still being held at the Bastion is out. The road is open again. Rhazek survived and withdrew with what he could still organize. Earlier groups were already gone before we reached them, and none of the people we recovered knew where they'd been taken.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 25}},
{"beat_id": "CH03_B02_L0003", "speaker_id": "lysara", "text": "Their condition?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 27}},
{"beat_id": "CH03_B02_L0004", "speaker_id": "ilyra", "text": "Exhausted. Some injuries had gone too long without proper care. Several could walk, but not through the route we used to get inside.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 31}},
{"beat_id": "CH03_B02_L0005", "speaker_id": "mirena", "text": "So opening the road mattered as much as taking the Bastion.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 33}},
{"beat_id": "CH03_B02_L0006", "speaker_id": "ilyra", "text": "For getting them home, yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 35}},
{"beat_id": "CH03_B02_L0007", "speaker_id": "lysara", "text": "The route.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 39}},
{"beat_id": "CH03_B02_L0008", "speaker_id": "othmar", "text": "Old Waterworks?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 43}},
{"beat_id": "CH03_B02_L0009", "speaker_id": "maevra", "text": "At first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 45}},
{"beat_id": "CH03_B02_L0010", "speaker_id": "torren", "text": "Then older construction. Much older. The Bastion was built into it in places and cut through it in others. We followed the old structure under the fort and came up inside.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH03_B02_L0011", "speaker_id": "othmar", "text": "Black Host work?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 51}},
{"beat_id": "CH03_B02_L0012", "speaker_id": "torren", "text": "No. I can defend that. I can't tell you what the older place was built for.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 53}},
{"beat_id": "CH03_B02_L0013", "speaker_id": "mirena", "text": "A distinction I appreciate.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 57}},
{"beat_id": "CH03_B02_L0014", "speaker_id": "torren", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — WORKING ROYAL AUDIENCE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH03_B02_L0015", "speaker_id": "torren", "text": "This isn't new from the Bastion. It's the Wayfinder copy from Briar Passage.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER EVIDENCE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 65}},
{"beat_id": "CH03_B02_L0016", "speaker_id": "mirena", "text": "The western network.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER EVIDENCE]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 69}},
{"beat_id": "CH03_B02_L0017", "speaker_id": "torren", "text": "Yeah. Roads everywhere, built sites everywhere, biggest concentration around Caelora. But the actual Wayfinder is broken straight through the center here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER EVIDENCE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 71}},
{"beat_id": "CH03_B02_L0018", "speaker_id": "torren", "text": "We know the old capital stood here. We don't have its complete center from this source.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER EVIDENCE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 75}},
{"beat_id": "CH03_B02_L0019", "speaker_id": "lysara", "text": "And the scale outside the break?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER EVIDENCE]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 77}},
{"beat_id": "CH03_B02_L0020", "speaker_id": "torren", "text": "Bigger than modern Caelora by a lot. I can defend that much.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER EVIDENCE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 79}},
{"beat_id": "CH03_B02_L0021", "speaker_id": "mirena", "text": "The second system of marks?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER EVIDENCE]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 81}},
{"beat_id": "CH03_B02_L0022", "speaker_id": "torren", "text": "Still don't know what they mean.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER EVIDENCE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 83}},
{"beat_id": "CH03_B02_L0023", "speaker_id": "othmar", "text": "Then the Old City archives may contain comparable records.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER EVIDENCE]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 85}},
{"beat_id": "CH03_B02_L0024", "speaker_id": "mirena", "text": "Or several centuries of people confidently copying things they didn't understand.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER EVIDENCE]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 87}},
{"beat_id": "CH03_B02_L0025", "speaker_id": "torren", "text": "Those aren't mutually exclusive.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER EVIDENCE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 89}},
{"beat_id": "CH03_B02_L0026", "speaker_id": "lysara", "text": "Later. Finish the report.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE WAYFINDER EVIDENCE]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 93}},
{"beat_id": "CH03_B02_L0027", "speaker_id": "maevra", "text": "The Card came from the Diysean ruins in the Westways. Before the convoy was attacked, it was already being moved toward Caelora under what we understood to be Crown authority.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD TRANSPORT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 99}},
{"beat_id": "CH03_B02_L0028", "speaker_id": "lysara", "text": "It remains with you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD TRANSPORT]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 103}},
{"beat_id": "CH03_B02_L0029", "speaker_id": "cyanis", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD TRANSPORT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 105}},
{"beat_id": "CH03_B02_L0030", "speaker_id": "lysara", "text": "By choice?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD TRANSPORT]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 107}},
{"beat_id": "CH03_B02_L0031", "speaker_id": "cyanis", "text": "By experience. Brackenwall tried separating us. My pulse dropped, I started shaking, and the Card lit toward me. Putting it back stopped it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD TRANSPORT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 109}},
{"beat_id": "CH03_B02_L0032", "speaker_id": "ilyra", "text": "His pulse recovered after contact was restored. We didn't repeat the test.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD TRANSPORT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 113}},
{"beat_id": "CH03_B02_L0033", "speaker_id": "cyanis", "text": "Strongly in favor of that decision.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD TRANSPORT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 115}},
{"beat_id": "CH03_B02_L0034", "speaker_id": "lysara", "text": "Sensible.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD TRANSPORT]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 119}},
{"beat_id": "CH03_B02_L0035", "speaker_id": "othmar", "text": "The transport toward Caelora was formally authorized?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD TRANSPORT]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 123}},
{"beat_id": "CH03_B02_L0036", "speaker_id": "maevra", "text": "That's what the chain showed. Direct Crown authority.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD TRANSPORT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 125}},
{"beat_id": "CH03_B02_L0037", "speaker_id": "othmar", "text": "You retained the order?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD TRANSPORT]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 127}},
{"beat_id": "CH03_B02_L0038", "speaker_id": "maevra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD TRANSPORT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 129}},
{"beat_id": "CH03_B02_L0039", "speaker_id": "lysara", "text": "Bring the original authorization and everything attached to that transport.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD TRANSPORT]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 133}},
{"beat_id": "CH03_B02_L0040", "speaker_id": "othmar", "text": "Routing, escort assignment, expenditures, countersigns.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD TRANSPORT]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_02_ROYAL_AUDIENCE_CH2_REPORT_DRAFT_A.md", "source_line": 135}},
