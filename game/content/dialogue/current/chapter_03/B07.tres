beats = [
{"beat_id": "CH03_B07_L0001", "speaker_id": "torren", "text": "Same six.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 19}},
{"beat_id": "CH03_B07_L0002", "speaker_id": "nimera", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 21}},
{"beat_id": "CH03_B07_L0003", "speaker_id": "nimera", "text": "Might. Elements. Grace. Memory. Perception. Ruin.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 25}},
{"beat_id": "CH03_B07_L0004", "speaker_id": "cyanis", "text": "Modern names?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 27}},
{"beat_id": "CH03_B07_L0005", "speaker_id": "nimera", "text": "Later names for symbol families that survived into Card scholarship. Useful comparison, not permission to pretend every Diysean used our exact definitions.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 29}},
{"beat_id": "CH03_B07_L0006", "speaker_id": "ilyra", "text": "They're all treated the same here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 31}},
{"beat_id": "CH03_B07_L0007", "speaker_id": "nimera", "text": "Structurally, yes. Which matters.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 33}},
{"beat_id": "CH03_B07_L0008", "speaker_id": "nimera", "text": "And before somebody decides Ruin belongs in the evil-ass corner, it doesn't. Same weight, same placement, same workmanship.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 37}},
{"beat_id": "CH03_B07_L0009", "speaker_id": "torren", "text": "Nobody said that shit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 39}},
{"beat_id": "CH03_B07_L0010", "speaker_id": "nimera", "text": "Preventive maintenance.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 41}},
{"beat_id": "CH03_B07_L0011", "speaker_id": "cyanis", "text": "On people again?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 43}},
{"beat_id": "CH03_B07_L0012", "speaker_id": "nimera", "text": "People are the highest-maintenance archive problem.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — SIX MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 45}},
{"beat_id": "CH03_B07_L0013", "speaker_id": "ilyra", "text": "That moved.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD COPYING FLOOR]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 61}},
{"beat_id": "CH03_B07_L0014", "speaker_id": "nimera", "text": "I saw.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD COPYING FLOOR]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 63}},
{"beat_id": "CH03_B07_L0015", "speaker_id": "torren", "text": "More behind it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD COPYING FLOOR]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 65}},
{"beat_id": "CH03_B07_L0016", "speaker_id": "cyanis", "text": "Still archive equipment?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD COPYING FLOOR]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 67}},
{"beat_id": "CH03_B07_L0017", "speaker_id": "nimera", "text": "Probably. Or archive equipment with the survival instincts of a cornered badger.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD COPYING FLOOR]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 71}},
{"beat_id": "CH03_B07_L0018", "speaker_id": "nimera", "text": "Badger was wrong. Too charming.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD COPYING FLOOR]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 75}},
{"beat_id": "CH03_B07_L0019", "speaker_id": "nimera", "text": "That's not one arm.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[LATE DEEP ARCHIVES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 87}},
{"beat_id": "CH03_B07_L0020", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[LATE DEEP ARCHIVES]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 89}},
{"beat_id": "CH03_B07_L0021", "speaker_id": "ilyra", "text": "You sound disappointed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[LATE DEEP ARCHIVES]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 91}},
{"beat_id": "CH03_B07_L0022", "speaker_id": "nimera", "text": "I'm deciding whether this is fascinating or an intellectual hemorrhoid.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[LATE DEEP ARCHIVES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 93}},
{"beat_id": "CH03_B07_L0023", "speaker_id": "cyanis", "text": "Decision made?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[LATE DEEP ARCHIVES]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 97}},
{"beat_id": "CH03_B07_L0024", "speaker_id": "nimera", "text": "Both.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[LATE DEEP ARCHIVES]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 101}},
{"beat_id": "CH03_B07_L0025", "speaker_id": "torren", "text": "Left assembly moves first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — INNER TRANSFER CHAMBER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 109}},
{"beat_id": "CH03_B07_L0026", "speaker_id": "nimera", "text": "Scribe system. Large one. Or a deeply unpleasant cousin.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — INNER TRANSFER CHAMBER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 111}},
{"beat_id": "CH03_B07_L0027", "speaker_id": "ilyra", "text": "Cousin wins.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — INNER TRANSFER CHAMBER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 115}},
{"beat_id": "CH03_B07_L0028", "speaker_id": "cyanis", "text": "Positions.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — INNER TRANSFER CHAMBER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 119}},
{"beat_id": "CH03_B07_L0029", "speaker_id": "nimera", "text": "If this thing ruins three centuries of records while trying to murder us, I'm going to be personally offended.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — INNER TRANSFER CHAMBER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 123}},
{"beat_id": "CH03_B07_L0030", "speaker_id": "torren", "text": "Think it cares?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — INNER TRANSFER CHAMBER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 125}},
{"beat_id": "CH03_B07_L0031", "speaker_id": "nimera", "text": "No. That's why the offense is pure.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — INNER TRANSFER CHAMBER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 127}},
{"beat_id": "CH03_B07_L0032", "speaker_id": "cyanis", "text": "Everybody still standing?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 153}},
{"beat_id": "CH03_B07_L0033", "speaker_id": "ilyra", "text": "Against my better judgment.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 155}},
{"beat_id": "CH03_B07_L0034", "speaker_id": "torren", "text": "Done.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 159}},
{"beat_id": "CH03_B07_L0035", "speaker_id": "nimera", "text": "Maybe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 163}},
{"beat_id": "CH03_B07_L0036", "speaker_id": "torren", "text": "You just agreed it was done.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 165}},
{"beat_id": "CH03_B07_L0037", "speaker_id": "nimera", "text": "Done trying to kill us. Different bastard category.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 167}},
{"beat_id": "CH03_B07_L0038", "speaker_id": "nimera", "text": "It was enforcing something. Or continuing something. Fuck, those are not the same claim.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 171}},
{"beat_id": "CH03_B07_L0039", "speaker_id": "cyanis", "text": "So what was that thing actually doing?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 173}},
{"beat_id": "CH03_B07_L0040", "speaker_id": "nimera", "text": "We walked in, it woke up angry, and breaking the active assemblies stopped it. If you want motive, ask the corpse.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 175}},
{"beat_id": "CH03_B07_L0041", "speaker_id": "ilyra", "text": "That seems useful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[VICTORY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/CH03_B07_DEEP_ARCHIVES_MEMORY_CONSTRUCT_DIALOGUE.md", "source_line": 181}},
