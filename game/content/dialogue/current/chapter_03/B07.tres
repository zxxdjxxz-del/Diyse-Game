beats = [
{"beat_id": "CH03_B07_L0001", "speaker_id": "torren", "text": "That marker's wrong now.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 27}},
{"beat_id": "CH03_B07_L0002", "speaker_id": "nimera", "text": "How wrong?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 29}},
{"beat_id": "CH03_B07_L0003", "speaker_id": "torren", "text": "Floor dropped after it was painted. Weight's carrying through the left edge.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 31}},
{"beat_id": "CH03_B07_L0004", "speaker_id": "nimera", "text": "So the official route is lying.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 35}},
{"beat_id": "CH03_B07_L0005", "speaker_id": "torren", "text": "Outdated.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 37}},
{"beat_id": "CH03_B07_L0006", "speaker_id": "nimera", "text": "That's bureaucratic horseshit with a filing system.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 39}},
{"beat_id": "CH03_B07_L0007", "speaker_id": "ilyra", "text": "You two are going to be unbearable together.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 41}},
{"beat_id": "CH03_B07_L0008", "speaker_id": "torren", "text": "Don't include me in that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 43}},
{"beat_id": "CH03_B07_L0009", "speaker_id": "nimera", "text": "Too late. You noticed the floor.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 45}},
{"beat_id": "CH03_B07_L0010", "speaker_id": "cyanis", "text": "Other way?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH03_B07_L0011", "speaker_id": "torren", "text": "Better. Less likely to drop us through the damn floor.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 53}},
{"beat_id": "CH03_B07_L0012", "speaker_id": "nimera", "text": "Irritatingly, that's a measurement I can use.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — ROUTE MARKS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 55}},
{"beat_id": "CH03_B07_L0013", "speaker_id": "nimera", "text": "Useful. Which makes me suspicious as hell.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD CATALOGUE ROOM]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 67}},
{"beat_id": "CH03_B07_L0014", "speaker_id": "ilyra", "text": "Comforting.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD CATALOGUE ROOM]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 69}},
{"beat_id": "CH03_B07_L0015", "speaker_id": "nimera", "text": "Here. Same subject copied three times. Oldest hand doesn't explain the mark. Middle copy guesses. Latest copy turns the guess into a category.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD CATALOGUE ROOM]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 71}},
{"beat_id": "CH03_B07_L0016", "speaker_id": "torren", "text": "Normal?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD CATALOGUE ROOM]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 73}},
{"beat_id": "CH03_B07_L0017", "speaker_id": "nimera", "text": "Tragically. One person writes maybe, next person writes probably, third bastard writes obviously, and suddenly everybody has inherited certainty from a corpse.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD CATALOGUE ROOM]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 75}},
{"beat_id": "CH03_B07_L0018", "speaker_id": "cyanis", "text": "You really love archives.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD CATALOGUE ROOM]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 77}},
{"beat_id": "CH03_B07_L0019", "speaker_id": "nimera", "text": "I love evidence. Archives are where evidence goes to acquire opinions.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD CATALOGUE ROOM]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 79}},
{"beat_id": "CH03_B07_L0020", "speaker_id": "nimera", "text": "Also mold.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD CATALOGUE ROOM]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 83}},
{"beat_id": "CH03_B07_L0021", "speaker_id": "ilyra", "text": "Finally, a neutral party.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STOP — OLD CATALOGUE ROOM]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 85}},
{"beat_id": "CH03_B07_L0022", "speaker_id": "nimera", "text": "Catalogue stops here. Balls.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 109}},
{"beat_id": "CH03_B07_L0023", "speaker_id": "torren", "text": "Building doesn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 111}},
{"beat_id": "CH03_B07_L0024", "speaker_id": "nimera", "text": "Exactly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 113}},
{"beat_id": "CH03_B07_L0025", "speaker_id": "nimera", "text": "No closure note. No transfer note. No fire record. No formal sealing order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 117}},
{"beat_id": "CH03_B07_L0026", "speaker_id": "ilyra", "text": "So they just stopped using it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 119}},
{"beat_id": "CH03_B07_L0027", "speaker_id": "nimera", "text": "Maybe. Or stopped recording that they used it. Different problem.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 121}},
{"beat_id": "CH03_B07_L0028", "speaker_id": "nimera", "text": "There should be buried collections beyond this point. If the old references survived anywhere, that's where I'd look.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 125}},
{"beat_id": "CH03_B07_L0029", "speaker_id": "torren", "text": "Route's still passable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 129}},
{"beat_id": "CH03_B07_L0030", "speaker_id": "nimera", "text": "See? This is why I tolerate you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 131}},
{"beat_id": "CH03_B07_L0031", "speaker_id": "torren", "text": "Been an hour.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 133}},
{"beat_id": "CH03_B07_L0032", "speaker_id": "nimera", "text": "A difficult hour.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY STOP — DEEPER CATALOGUE BREAK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_07_LOWER_ARCHIVES_DRAFT_A.md", "source_line": 135}}
]
