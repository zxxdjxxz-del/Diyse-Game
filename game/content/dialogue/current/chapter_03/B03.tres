authoring_notes = "CURRENT runtime dialogue compiled from docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md. docs/03_DIALOGUE/PRODUCTION is exact spoken-wording authority; legacy S001-S021 Resources are not source authority. Source SHA-256: e35611912c111cdf71c3836a6f99b9f285f9d3f19764ca53975f0e149ec2f7c2. Spoken-sequence SHA-256: 4435c2ca9226cd599cd99f97dcb968d6ba0963955ff68914f5c03ee1436169f4. Spoken lines: 45."
beats = [
{"beat_id": "CH03_B03_L0001", "speaker_id": "lysara", "text": "I did not issue this.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE TRANSPORT ORDERS]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 19}},
{"beat_id": "CH03_B03_L0002", "speaker_id": "lysara", "text": "And I did not know the Card had been recovered until you told me in this room.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE TRANSPORT ORDERS]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 25}},
{"beat_id": "CH03_B03_L0003", "speaker_id": "maevra", "text": "The chain presented it as direct Crown authority. Not rumor, not somebody invoking your name. We had authorization, escort assignment, routing, and money attached to it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE TRANSPORT ORDERS]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 29}},
{"beat_id": "CH03_B03_L0004", "speaker_id": "othmar", "text": "Which matters. We do not spend Crown coin and assign escorts to move an inactive Card from a ruin because somebody thinks it might be interesting. Whatever else is wrong here, these records were built to survive ordinary scrutiny.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE TRANSPORT ORDERS]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 33}},
{"beat_id": "CH03_B03_L0005", "speaker_id": "maevra", "text": "Somebody still spent the money.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE TRANSPORT ORDERS]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 35}},
{"beat_id": "CH03_B03_L0006", "speaker_id": "othmar", "text": "Yes. I am not calling the expenditure imaginary. I am saying the authority behind it now requires proof.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE TRANSPORT ORDERS]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 37}},
{"beat_id": "CH03_B03_L0007", "speaker_id": "mirena", "text": "It passed through enough hands to behave like an ordinary order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE TRANSPORT ORDERS]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 41}},
{"beat_id": "CH03_B03_L0008", "speaker_id": "othmar", "text": "Good. That gives us people, timestamps, countersigns, and accounts to audit instead of one mysterious piece of paper and a room full of guesses.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE TRANSPORT ORDERS]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 43}},
{"beat_id": "CH03_B03_L0009", "speaker_id": "cyanis", "text": "Encouraging way to describe fraud against the Crown.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE TRANSPORT ORDERS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 47}},
{"beat_id": "CH03_B03_L0010", "speaker_id": "othmar", "text": "I prefer problems with records.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE TRANSPORT ORDERS]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH03_B03_L0011", "speaker_id": "cyanis", "text": "I believe you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE TRANSPORT ORDERS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 51}},
{"beat_id": "CH03_B03_L0012", "speaker_id": "lysara", "text": "Authenticate it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE TRANSPORT ORDERS]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 55}},
{"beat_id": "CH03_B03_L0013", "speaker_id": "mirena", "text": "That's not only the printed Crest.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 69}},
{"beat_id": "CH03_B03_L0014", "speaker_id": "othmar", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 71}},
{"beat_id": "CH03_B03_L0015", "speaker_id": "lysara", "text": "Say it plainly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 75}},
{"beat_id": "CH03_B03_L0016", "speaker_id": "othmar", "text": "By the checks we use, this document carries the genuine authority response of your personal royal seal.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 77}},
{"beat_id": "CH03_B03_L0017", "speaker_id": "lysara", "text": "I did not seal it. I did not order anyone to seal it for me. I did not authorize this transport.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 81}},
{"beat_id": "CH03_B03_L0018", "speaker_id": "mirena", "text": "Could the response itself be copied?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 87}},
{"beat_id": "CH03_B03_L0019", "speaker_id": "othmar", "text": "Not by anything our ordinary authentication practice recognizes as forgery. That is the useful answer. The less useful answer is that I cannot turn `our checks do not know how` into `there is no way.`", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 91}},
{"beat_id": "CH03_B03_L0020", "speaker_id": "torren", "text": "So response is real. Mechanism isn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 95}},
{"beat_id": "CH03_B03_L0021", "speaker_id": "othmar", "text": "Mechanism is unknown.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 97}},
{"beat_id": "CH03_B03_L0022", "speaker_id": "torren", "text": "Better.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 99}},
{"beat_id": "CH03_B03_L0023", "speaker_id": "maevra", "text": "Then everyone who handled this did exactly what they were trained to do. They saw valid authority and moved the Card.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 103}},
{"beat_id": "CH03_B03_L0024", "speaker_id": "lysara", "text": "Then they acted under Crown authority as they reasonably understood it. Nobody in that chain is to be treated as culpable for obeying a document our own systems accepted unless the audit gives us evidence otherwise.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 107}},
{"beat_id": "CH03_B03_L0025", "speaker_id": "mirena", "text": "That includes whoever countersigned downstream.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 109}},
{"beat_id": "CH03_B03_L0026", "speaker_id": "lysara", "text": "It includes everyone until evidence makes a distinction.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 111}},
{"beat_id": "CH03_B03_L0027", "speaker_id": "mirena", "text": "Which leaves the object the false order was trying to move.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 119}},
{"beat_id": "CH03_B03_L0028", "speaker_id": "cyanis", "text": "If the next suggestion is `move it somewhere secure`, I should mention that Brackenwall already made that unpleasant.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 123}},
{"beat_id": "CH03_B03_L0029", "speaker_id": "ilyra", "text": "Very unpleasant.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 125}},
{"beat_id": "CH03_B03_L0030", "speaker_id": "lysara", "text": "I heard the report.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 127}},
{"beat_id": "CH03_B03_L0031", "speaker_id": "lysara", "text": "Any change since the separation attempt?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 131}},
{"beat_id": "CH03_B03_L0032", "speaker_id": "cyanis", "text": "Nothing comparable. It stays with me; I stay upright. I'm comfortable preserving that arrangement until somebody has a better idea.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 133}},
{"beat_id": "CH03_B03_L0033", "speaker_id": "ilyra", "text": "I am also comfortable not recreating the part where his pulse dropped.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 135}},
{"beat_id": "CH03_B03_L0034", "speaker_id": "lysara", "text": "Then the Card stays where it is. Solmar retains responsibility for its custody. Nobody moves it merely because the palace is more secure than a road.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 141}},
{"beat_id": "CH03_B03_L0035", "speaker_id": "maevra", "text": "Understood.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 143}},
{"beat_id": "CH03_B03_L0036", "speaker_id": "cyanis", "text": "Works for me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 145}},
{"beat_id": "CH03_B03_L0037", "speaker_id": "lysara", "text": "That was not a reward.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 147}},
{"beat_id": "CH03_B03_L0038", "speaker_id": "cyanis", "text": "Still works for me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 149}},
{"beat_id": "CH03_B03_L0039", "speaker_id": "mirena", "text": "Originals secured. I want every hand in the chain, every routing change, every expenditure, and every countersign. If something looked ordinary because five ordinary systems agreed with one another, I want to know where the agreement started.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVIDENCE / NEXT STEP]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 157}},
{"beat_id": "CH03_B03_L0040", "speaker_id": "othmar", "text": "And legitimate sealed orders from the same period. Similar offices, similar routing if possible. We need comparison, not intuition.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVIDENCE / NEXT STEP]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 159}},
{"beat_id": "CH03_B03_L0041", "speaker_id": "lysara", "text": "My physical seal. Bring it with the full custody record and every recorded use from the same period.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVIDENCE / NEXT STEP]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 163}},
{"beat_id": "CH03_B03_L0042", "speaker_id": "othmar", "text": "I'll have the verification room prepared.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVIDENCE / NEXT STEP]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 165}},
{"beat_id": "CH03_B03_L0043", "speaker_id": "cyanis", "text": "What are we hoping for?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVIDENCE / NEXT STEP]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 167}},
{"beat_id": "CH03_B03_L0044", "speaker_id": "lysara", "text": "Something we can prove.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVIDENCE / NEXT STEP]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 171}},
{"beat_id": "CH03_B03_L0045", "speaker_id": "lysara", "text": "Until then: no accusations. Not against seal staff, not against the transport chain, not against anyone whose name happens to appear on a page. We follow evidence, or we make this worse ourselves.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVIDENCE / NEXT STEP]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 175}}
