authoring_notes = "CURRENT runtime dialogue compiled from docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md. docs/03_DIALOGUE/PRODUCTION is exact spoken-wording authority; legacy S001-S021 Resources are not source authority. Source SHA-256: d921f1c66b13ddf47254fe0580261972dfa16abe4eadf880f25b402886fb9edd. Spoken-sequence SHA-256: 41545fb0438e7da96aa6025ef3b8c6974e9a9ee8f69091c20268eb732b4c206e. Spoken lines: 32."
beats = [
{"beat_id": "CH03_B03_L0001", "speaker_id": "lysara", "text": "I did not issue this.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE TRANSPORT ORDERS]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 17}},
{"beat_id": "CH03_B03_L0002", "speaker_id": "lysara", "text": "I did not know this Card had been recovered until today.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE TRANSPORT ORDERS]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 21}},
{"beat_id": "CH03_B03_L0003", "speaker_id": "maevra", "text": "The chain presented it as direct Crown authority. Escort, routing, money. Nothing about it looked provisional.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE TRANSPORT ORDERS]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 25}},
{"beat_id": "CH03_B03_L0004", "speaker_id": "othmar", "text": "Which means it was built to survive ordinary scrutiny.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE TRANSPORT ORDERS]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 29}},
{"beat_id": "CH03_B03_L0005", "speaker_id": "mirena", "text": "And apparently did.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE TRANSPORT ORDERS]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 31}},
{"beat_id": "CH03_B03_L0006", "speaker_id": "othmar", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE TRANSPORT ORDERS]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 33}},
{"beat_id": "CH03_B03_L0007", "speaker_id": "lysara", "text": "Authenticate it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — THE TRANSPORT ORDERS]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 37}},
{"beat_id": "CH03_B03_L0008", "speaker_id": "mirena", "text": "That's real.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH03_B03_L0009", "speaker_id": "othmar", "text": "By every check we use, yes. This document carries the genuine authority response of the Queen's personal seal.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 53}},
{"beat_id": "CH03_B03_L0010", "speaker_id": "lysara", "text": "I did not seal it. I did not authorize anyone to seal it for me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 57}},
{"beat_id": "CH03_B03_L0011", "speaker_id": "mirena", "text": "Can the response be copied?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 61}},
{"beat_id": "CH03_B03_L0012", "speaker_id": "othmar", "text": "Not by anything our current authentication practice recognizes. That is not the same as saying it cannot be done.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 63}},
{"beat_id": "CH03_B03_L0013", "speaker_id": "torren", "text": "Real response. Unknown method.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 67}},
{"beat_id": "CH03_B03_L0014", "speaker_id": "othmar", "text": "Correct.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 71}},
{"beat_id": "CH03_B03_L0015", "speaker_id": "torren", "text": "Better than pretending we know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 73}},
{"beat_id": "CH03_B03_L0016", "speaker_id": "maevra", "text": "Then everyone who handled this saw valid authority.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 77}},
{"beat_id": "CH03_B03_L0017", "speaker_id": "lysara", "text": "And until evidence says otherwise, they are not culpable for obeying it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 81}},
{"beat_id": "CH03_B03_L0018", "speaker_id": "mirena", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHENTICATION]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 85}},
{"beat_id": "CH03_B03_L0019", "speaker_id": "lysara", "text": "The Card stays with you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 91}},
{"beat_id": "CH03_B03_L0020", "speaker_id": "cyanis", "text": "That was faster than I expected.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 95}},
{"beat_id": "CH03_B03_L0021", "speaker_id": "lysara", "text": "We already know forced separation caused harm. I see no reason to repeat it for the comfort of having the object inside palace custody.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 97}},
{"beat_id": "CH03_B03_L0022", "speaker_id": "ilyra", "text": "I support not recreating that experiment.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 101}},
{"beat_id": "CH03_B03_L0023", "speaker_id": "cyanis", "text": "Strongly seconded.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 103}},
{"beat_id": "CH03_B03_L0024", "speaker_id": "lysara", "text": "This is custody, not ownership.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 105}},
{"beat_id": "CH03_B03_L0025", "speaker_id": "cyanis", "text": "Understood.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CARD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 107}},
{"beat_id": "CH03_B03_L0026", "speaker_id": "mirena", "text": "Then we audit the chain. Every hand, routing change, expenditure, and countersign.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEXT STEP]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 113}},
{"beat_id": "CH03_B03_L0027", "speaker_id": "othmar", "text": "And compare this against unquestionably legitimate sealed orders from the same period.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEXT STEP]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 115}},
{"beat_id": "CH03_B03_L0028", "speaker_id": "lysara", "text": "Bring my physical seal. Full custody record. Every recorded use from the same window.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEXT STEP]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 119}},
{"beat_id": "CH03_B03_L0029", "speaker_id": "othmar", "text": "I'll prepare the verification room.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEXT STEP]", "source_speaker_label": "OTHMAR", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 121}},
{"beat_id": "CH03_B03_L0030", "speaker_id": "cyanis", "text": "What are we hoping to find?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEXT STEP]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 125}},
{"beat_id": "CH03_B03_L0031", "speaker_id": "lysara", "text": "Something we can prove.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEXT STEP]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 129}},
{"beat_id": "CH03_B03_L0032", "speaker_id": "lysara", "text": "Until then, no accusations. We follow evidence.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NEXT STEP]", "source_speaker_label": "LYSARA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_03_IMPOSSIBLE_ORDERS_DRAFT_A.md", "source_line": 133}}
]
