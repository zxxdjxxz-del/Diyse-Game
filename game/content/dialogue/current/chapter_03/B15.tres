beats = [
{"beat_id": "CH03_B15_L0001", "speaker_id": "mirena", "text": "That was not Ruby when you went down.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RETURN TO NORMAL CRESTHAVEN]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 15}},
{"beat_id": "CH03_B15_L0002", "speaker_id": "cyanis", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RETURN TO NORMAL CRESTHAVEN]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 17}},
{"beat_id": "CH03_B15_L0003", "speaker_id": "maevra", "text": "What happened?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RETURN TO NORMAL CRESTHAVEN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 19}},
{"beat_id": "CH03_B15_L0004", "speaker_id": "cyanis", "text": "Warden. Big one. It assessed all four of us, decided something was wrong, and attacked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RETURN TO NORMAL CRESTHAVEN]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 23}},
{"beat_id": "CH03_B15_L0005", "speaker_id": "mirena", "text": "Then?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RETURN TO NORMAL CRESTHAVEN]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 25}},
{"beat_id": "CH03_B15_L0006", "speaker_id": "nimera", "text": "We killed it. During shutdown it gave two messages. Exact order matters.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RETURN TO NORMAL CRESTHAVEN]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 27}},
{"beat_id": "CH03_B15_L0007", "speaker_id": "nimera", "text": "PREVIOUS ERROR.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RETURN TO NORMAL CRESTHAVEN]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 31}},
{"beat_id": "CH03_B15_L0008", "speaker_id": "nimera", "text": "LAST SENTINEL CONFIRMED.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RETURN TO NORMAL CRESTHAVEN]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 35}},
{"beat_id": "CH03_B15_L0009", "speaker_id": "mirena", "text": "And then the Card changed?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RETURN TO NORMAL CRESTHAVEN]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 39}},
{"beat_id": "CH03_B15_L0010", "speaker_id": "nimera", "text": "No. Important correction. Then the Warden went fully inert. **After that** the Card changed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RETURN TO NORMAL CRESTHAVEN]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 41}},
{"beat_id": "CH03_B15_L0011", "speaker_id": "mirena", "text": "Meaning?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RETURN TO NORMAL CRESTHAVEN]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 43}},
{"beat_id": "CH03_B15_L0012", "speaker_id": "nimera", "text": "Nothing proven. The timing is suspicious as fuck. Suspicion remains cheaper than mechanism.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RETURN TO NORMAL CRESTHAVEN]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 45}},
{"beat_id": "CH03_B15_L0013", "speaker_id": "maevra", "text": "Anyone hurt?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RETURN TO NORMAL CRESTHAVEN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 47}},
{"beat_id": "CH03_B15_L0014", "speaker_id": "ilyra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RETURN TO NORMAL CRESTHAVEN]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH03_B15_L0015", "speaker_id": "maevra", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RETURN TO NORMAL CRESTHAVEN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 51}},
{"beat_id": "CH03_B15_L0016", "speaker_id": "mirena", "text": "Last Sentinel.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RETURN TO NORMAL CRESTHAVEN]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 55}},
{"beat_id": "CH03_B15_L0017", "speaker_id": "cyanis", "text": "That's all we have.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RETURN TO NORMAL CRESTHAVEN]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 57}},
{"beat_id": "CH03_B15_L0018", "speaker_id": "mirena", "text": "Then that's all we're calling it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[RETURN TO NORMAL CRESTHAVEN]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH03_B15_L0019", "speaker_id": "mirena", "text": "This room is yours for maps and records. Sleeping rooms are usable. Supply room is ugly but stocked. The old treatment room needs work, but it has water and a door that closes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HEADQUARTERS]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 69}},
{"beat_id": "CH03_B15_L0020", "speaker_id": "ilyra", "text": "Luxury.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HEADQUARTERS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 71}},
{"beat_id": "CH03_B15_L0021", "speaker_id": "mirena", "text": "I was told adventurers enjoy deprivation.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HEADQUARTERS]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 73}},
{"beat_id": "CH03_B15_L0022", "speaker_id": "cyanis", "text": "Slander.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HEADQUARTERS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 75}},
{"beat_id": "CH03_B15_L0023", "speaker_id": "maevra", "text": "Accurate slander.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HEADQUARTERS]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 77}},
{"beat_id": "CH03_B15_L0024", "speaker_id": "torren", "text": "Enough to work from.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HEADQUARTERS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 81}},
{"beat_id": "CH03_B15_L0025", "speaker_id": "mirena", "text": "That's the point. Cresthaven is your headquarters while this investigation stays active. Not a title. Not a command. A place to put your things and stop carrying the entire problem on your backs.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HEADQUARTERS]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 83}},
{"beat_id": "CH03_B15_L0026", "speaker_id": "nimera", "text": "That table is going to regret meeting me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HEADQUARTERS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 87}},
{"beat_id": "CH03_B15_L0027", "speaker_id": "torren", "text": "Already does.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HEADQUARTERS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 89}},
{"beat_id": "CH03_B15_L0028", "speaker_id": "nimera", "text": "It has no evidence.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[HEADQUARTERS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 91}},
{"beat_id": "CH03_B15_L0029", "speaker_id": "mirena", "text": "One more thing before Maevra and I head back. Crown crews in the Old City opened a side passage that wasn't accessible during your run.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OLD CITY ARCHIVE HUNT UNLOCK]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 97}},
{"beat_id": "CH03_B15_L0030", "speaker_id": "cyanis", "text": "Know what's in it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OLD CITY ARCHIVE HUNT UNLOCK]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 99}},
{"beat_id": "CH03_B15_L0031", "speaker_id": "mirena", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OLD CITY ARCHIVE HUNT UNLOCK]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 101}},
{"beat_id": "CH03_B15_L0032", "speaker_id": "nimera", "text": "Beautiful.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OLD CITY ARCHIVE HUNT UNLOCK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 103}},
{"beat_id": "CH03_B15_L0033", "speaker_id": "mirena", "text": "I thought you'd say that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OLD CITY ARCHIVE HUNT UNLOCK]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 105}},
{"beat_id": "CH03_B15_L0034", "speaker_id": "nimera", "text": "Unknown room in an archive with a history of murderous furniture. What's not to love?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OLD CITY ARCHIVE HUNT UNLOCK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 107}},
{"beat_id": "CH03_B15_L0035", "speaker_id": "ilyra", "text": "The murderous furniture.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OLD CITY ARCHIVE HUNT UNLOCK]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 109}},
{"beat_id": "CH03_B15_L0036", "speaker_id": "nimera", "text": "Narrow thinking.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OLD CITY ARCHIVE HUNT UNLOCK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 111}},
{"beat_id": "CH03_B15_L0037", "speaker_id": "torren", "text": "One thing left.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE NORTHERN LEAD]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 121}},
{"beat_id": "CH03_B15_L0038", "speaker_id": "torren", "text": "Tower was real.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE NORTHERN LEAD]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 129}},
{"beat_id": "CH03_B15_L0039", "speaker_id": "cyanis", "text": "So the routes probably were too.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE NORTHERN LEAD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 131}},
{"beat_id": "CH03_B15_L0040", "speaker_id": "nimera", "text": "Broadly, yes. Careful with probably, but yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE NORTHERN LEAD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 133}},
{"beat_id": "CH03_B15_L0041", "speaker_id": "ilyra", "text": "We still don't know where they go.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE NORTHERN LEAD]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 135}},
{"beat_id": "CH03_B15_L0042", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE NORTHERN LEAD]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 137}},
{"beat_id": "CH03_B15_L0043", "speaker_id": "torren", "text": "If we follow north, Ivorybridge is where I'd start looking.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE NORTHERN LEAD]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 141}},
{"beat_id": "CH03_B15_L0044", "speaker_id": "mirena", "text": "Because it's the next major place that gives you something to test.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE NORTHERN LEAD]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 145}},
{"beat_id": "CH03_B15_L0045", "speaker_id": "torren", "text": "Exactly.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE NORTHERN LEAD]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 147}},
{"beat_id": "CH03_B15_L0046", "speaker_id": "cyanis", "text": "Not because the Ancient map says Ivorybridge.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE NORTHERN LEAD]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 149}},
{"beat_id": "CH03_B15_L0047", "speaker_id": "nimera", "text": "Thank fuck. No. The Ancient map says north until the copy ends. Ivorybridge is our hypothesis, not their label.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE NORTHERN LEAD]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 151}},
{"beat_id": "CH03_B15_L0048", "speaker_id": "ilyra", "text": "So we go north and see whether the ground agrees.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE NORTHERN LEAD]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 153}},
{"beat_id": "CH03_B15_L0049", "speaker_id": "torren", "text": "That's the idea.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE NORTHERN LEAD]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 155}},
{"beat_id": "CH03_B15_L0050", "speaker_id": "mirena", "text": "Then Cresthaven holds the work while you test it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE NORTHERN LEAD]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 159}},
{"beat_id": "CH03_B15_L0051", "speaker_id": "maevra", "text": "We'll send anything the Crown side turns up.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MIRENA / MAEVRA DEPARTURE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 165}},
{"beat_id": "CH03_B15_L0052", "speaker_id": "cyanis", "text": "Same from us.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MIRENA / MAEVRA DEPARTURE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 167}},
{"beat_id": "CH03_B15_L0053", "speaker_id": "mirena", "text": "Try not to destroy my abandoned fort before I get political value out of reopening it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MIRENA / MAEVRA DEPARTURE]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 171}},
{"beat_id": "CH03_B15_L0054", "speaker_id": "nimera", "text": "Define destroy.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MIRENA / MAEVRA DEPARTURE]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 173}},
{"beat_id": "CH03_B15_L0055", "speaker_id": "mirena", "text": "I knew I disliked that question.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MIRENA / MAEVRA DEPARTURE]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 175}},
{"beat_id": "CH03_B15_L0056", "speaker_id": "ilyra", "text": "Too late.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "STORY_CHAPTER_03_COMPLETE", "UNLOCK_C06_NIMERA_TAKES_OVER_A_TABLE", "UNLOCK_C07_ILYRA_AND_NIMERA"], "source_section": "[MIRENA / MAEVRA DEPARTURE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_IVORYBRIDGE_DECISION_DRAFT_A.md", "source_line": 177}}
]
