{"beat_id": "CH03_B15_L0073", "speaker_id": "mirena", "text": "It won't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "STORY_CHAPTER_03_COMPLETE", "UNLOCK_C06_NIMERA_TAKES_OVER_A_TABLE", "UNLOCK_C07_ILYRA_AND_NIMERA"], "source_section": "[MIRENA AND MAEVRA LEAVE]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_15_CRESTHAVEN_HEADQUARTERS_CLEANUP_WINDOW_DRAFT_A.md", "source_line": 274}}
