beats = [
{"beat_id": "CH03_B05_L0001", "speaker_id": "archive_keeper", "text": "Dovaren. Amarin. Harth. You're looking for Nimera Pellan.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "ARCHIVE KEEPER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 22}},
{"beat_id": "CH03_B05_L0002", "speaker_id": "cyanis", "text": "That's us.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 24}},
{"beat_id": "CH03_B05_L0003", "speaker_id": "archive_keeper", "text": "She's below the maintained stacks. Follow the marked route.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "ARCHIVE KEEPER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 26}},
{"beat_id": "CH03_B05_L0004", "speaker_id": "torren", "text": "How far does `maintained` mean maintained?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 30}},
{"beat_id": "CH03_B05_L0005", "speaker_id": "archive_keeper", "text": "Routes we use. Doors we understand. Repairs we know won't interfere with older work. Past that, the word gets optimistic.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "ARCHIVE KEEPER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 34}},
{"beat_id": "CH03_B05_L0006", "speaker_id": "torren", "text": "Good answer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 38}},
{"beat_id": "CH03_B05_L0007", "speaker_id": "archive_keeper", "text": "If the marked route and the room disagree, the room wins.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "ARCHIVE KEEPER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 40}},
{"beat_id": "CH03_B05_L0008", "speaker_id": "ilyra", "text": "I like them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 42}},
{"beat_id": "CH03_B05_L0009", "speaker_id": "cyanis", "text": "That was fast.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 44}},
{"beat_id": "CH03_B05_L0010", "speaker_id": "ilyra", "text": "Good rules.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 46}},
{"beat_id": "CH03_B05_L0011", "speaker_id": "torren", "text": "Crown work ends here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 68}},
{"beat_id": "CH03_B05_L0012", "speaker_id": "cyanis", "text": "Sure?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 72}},
{"beat_id": "CH03_B05_L0013", "speaker_id": "torren", "text": "New mortar stops. Braces stop. Floor repair stops. Old fitted stone keeps going.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 74}},
{"beat_id": "CH03_B05_L0014", "speaker_id": "torren", "text": "Upper archive was built into this. Not the other way around.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 78}},
{"beat_id": "CH03_B05_L0015", "speaker_id": "cyanis", "text": "And this route is still approved.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 80}},
{"beat_id": "CH03_B05_L0016", "speaker_id": "torren", "text": "Means somebody checked it. Doesn't mean the building promised anything.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 82}},
{"beat_id": "CH03_B05_L0017", "speaker_id": "ilyra", "text": "You stole that from the keeper.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 86}},
{"beat_id": "CH03_B05_L0018", "speaker_id": "torren", "text": "Good rule.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 88}},
{"beat_id": "CH03_B05_L0019", "speaker_id": "ilyra", "text": "Still theft.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 90}},
{"beat_id": "CH03_B05_L0020", "speaker_id": "cyanis", "text": "Nobody curious?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — DIYSEAN DESCENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 104}},
{"beat_id": "CH03_B05_L0021", "speaker_id": "ilyra", "text": "Extremely.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — DIYSEAN DESCENT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 106}},
{"beat_id": "CH03_B05_L0022", "speaker_id": "ilyra", "text": "Still not opening it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — DIYSEAN DESCENT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 110}},
{"beat_id": "CH03_B05_L0023", "speaker_id": "cyanis", "text": "I didn't say we should.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — DIYSEAN DESCENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 112}},
{"beat_id": "CH03_B05_L0024", "speaker_id": "torren", "text": "Marked route's left.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — DIYSEAN DESCENT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 114}},
{"beat_id": "CH03_B05_L0025", "speaker_id": "cyanis", "text": "And there goes wonder.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — DIYSEAN DESCENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 116}},
{"beat_id": "CH03_B05_L0026", "speaker_id": "torren", "text": "Wonder can turn left.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — DIYSEAN DESCENT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 118}}
]
