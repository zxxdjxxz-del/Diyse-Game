beats = [
{"beat_id": "CH03_B05_L0001", "speaker_id": "archive_keeper", "text": "Dovaren. Amarin. Harth.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "ARCHIVE KEEPER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 30}},
{"beat_id": "CH03_B05_L0002", "speaker_id": "cyanis", "text": "That's us.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 32}},
{"beat_id": "CH03_B05_L0003", "speaker_id": "archive_keeper", "text": "You're looking for Nimera Pellan.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "ARCHIVE KEEPER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 34}},
{"beat_id": "CH03_B05_L0004", "speaker_id": "cyanis", "text": "That's the idea.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 36}},
{"beat_id": "CH03_B05_L0005", "speaker_id": "archive_keeper", "text": "She's below the maintained stacks. Deeper work section.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "ARCHIVE KEEPER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 38}},
{"beat_id": "CH03_B05_L0006", "speaker_id": "torren", "text": "How much of the route do you actually maintain?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 42}},
{"beat_id": "CH03_B05_L0007", "speaker_id": "archive_keeper", "text": "Routes we use. Doors we understand. Repairs we know won't interfere with older work. Wards we know how to leave alone. Past that, `maintained` starts becoming a dangerous word.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "ARCHIVE KEEPER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 46}},
{"beat_id": "CH03_B05_L0008", "speaker_id": "torren", "text": "Better answer than I expected.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 50}},
{"beat_id": "CH03_B05_L0009", "speaker_id": "archive_keeper", "text": "It's kept me employed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "ARCHIVE KEEPER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 52}},
{"beat_id": "CH03_B05_L0010", "speaker_id": "ilyra", "text": "High praise for institutional caution.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 54}},
{"beat_id": "CH03_B05_L0011", "speaker_id": "archive_keeper", "text": "Down here, caution gets promoted faster than confidence.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "ARCHIVE KEEPER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 56}},
{"beat_id": "CH03_B05_L0012", "speaker_id": "cyanis", "text": "I like this place already.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 60}},
{"beat_id": "CH03_B05_L0013", "speaker_id": "ilyra", "text": "Give it time.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 62}},
{"beat_id": "CH03_B05_L0014", "speaker_id": "archive_keeper", "text": "Pellan has clearance for the deeper work section. So do you, for this investigation. Follow the marked route. If something is sealed, leave it sealed. If the marked route and the room disagree, the room wins and you come back.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "ARCHIVE KEEPER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 66}},
{"beat_id": "CH03_B05_L0015", "speaker_id": "torren", "text": "Definitely better than expected.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 70}},
{"beat_id": "CH03_B05_L0016", "speaker_id": "cyanis", "text": "That's practically affection from him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 72}},
{"beat_id": "CH03_B05_L0017", "speaker_id": "torren", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 74}},
{"beat_id": "CH03_B05_L0018", "speaker_id": "archive_keeper", "text": "I'll survive.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "ARCHIVE KEEPER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 76}},
{"beat_id": "CH03_B05_L0019", "speaker_id": "ilyra", "text": "Also high praise.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — RESTRICTED ACCESS DESK]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 78}},
{"beat_id": "CH03_B05_L0020", "speaker_id": "torren", "text": "Crown work stops here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 108}},
{"beat_id": "CH03_B05_L0021", "speaker_id": "cyanis", "text": "You can tell that quickly?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 110}},
{"beat_id": "CH03_B05_L0022", "speaker_id": "torren", "text": "New mortar ends at that seam. Same with the braces. Crown floor repair stops three paces behind us, but the old fitted stone keeps going without a break. Whoever adapted the upper rooms worked *into* this structure. They didn't rebuild this part.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 114}},
{"beat_id": "CH03_B05_L0023", "speaker_id": "cyanis", "text": "And the route is still approved.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 118}},
{"beat_id": "CH03_B05_L0024", "speaker_id": "torren", "text": "Marked approved. That's a record of somebody checking it, not a promise the building signed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 120}},
{"beat_id": "CH03_B05_L0025", "speaker_id": "ilyra", "text": "You've known the archive keeper for thirty seconds and already stolen their philosophy.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 122}},
{"beat_id": "CH03_B05_L0026", "speaker_id": "torren", "text": "Good philosophy.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 124}},
{"beat_id": "CH03_B05_L0027", "speaker_id": "ilyra", "text": "I know. That's what makes it irritating.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 126}},
{"beat_id": "CH03_B05_L0028", "speaker_id": "cyanis", "text": "I preferred when only Maevra did this with him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 130}},
{"beat_id": "CH03_B05_L0029", "speaker_id": "torren", "text": "Did what?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 132}},
{"beat_id": "CH03_B05_L0030", "speaker_id": "ilyra", "text": "Encourage him accidentally.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 134}},
{"beat_id": "CH03_B05_L0031", "speaker_id": "torren", "text": "Keep moving.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[SHORT STORY STOP — MAINTAINED EDGE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 136}},
{"beat_id": "CH03_B05_L0032", "speaker_id": "cyanis", "text": "Nobody curious?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — DIYSEAN DESCENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 162}},
{"beat_id": "CH03_B05_L0033", "speaker_id": "torren", "text": "About what?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — DIYSEAN DESCENT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 164}},
{"beat_id": "CH03_B05_L0034", "speaker_id": "cyanis", "text": "Door nobody understands in an ancient archive.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — DIYSEAN DESCENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 166}},
{"beat_id": "CH03_B05_L0035", "speaker_id": "ilyra", "text": "Extremely curious.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — DIYSEAN DESCENT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 168}},
{"beat_id": "CH03_B05_L0036", "speaker_id": "ilyra", "text": "Still not opening it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — DIYSEAN DESCENT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 172}},
{"beat_id": "CH03_B05_L0037", "speaker_id": "cyanis", "text": "I didn't say we should.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — DIYSEAN DESCENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 174}},
{"beat_id": "CH03_B05_L0038", "speaker_id": "ilyra", "text": "Neither did I. See? Growth everywhere.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — DIYSEAN DESCENT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 176}},
{"beat_id": "CH03_B05_L0039", "speaker_id": "torren", "text": "Marked route's left.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — DIYSEAN DESCENT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 180}},
{"beat_id": "CH03_B05_L0040", "speaker_id": "cyanis", "text": "And there goes wonder.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — DIYSEAN DESCENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 182}},
{"beat_id": "CH03_B05_L0041", "speaker_id": "torren", "text": "Wonder can turn left.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — DIYSEAN DESCENT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_05_OLD_CITY_ACCESS_ARCHIVE_DESCENT_DRAFT_A.md", "source_line": 184}}
]
