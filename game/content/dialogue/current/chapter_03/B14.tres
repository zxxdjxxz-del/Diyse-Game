beats = [
{"beat_id": "CH03_B14_L0001", "speaker_id": "cyanis", "text": "We could be out before midnight.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CONTINUATION — AFTER CRESTHAVEN IS IDENTIFIED]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 15}},
{"beat_id": "CH03_B14_L0002", "speaker_id": "mirena", "text": "Absolutely not.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CONTINUATION — AFTER CRESTHAVEN IS IDENTIFIED]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 17}},
{"beat_id": "CH03_B14_L0003", "speaker_id": "cyanis", "text": "No?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CONTINUATION — AFTER CRESTHAVEN IS IDENTIFIED]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 21}},
{"beat_id": "CH03_B14_L0004", "speaker_id": "mirena", "text": "You have spent most of the day underground, fought an Ancient Warden, watched a Card change state in your hand, and then stood in a seal workshop arguing about whether somebody successfully copied royal authority. Cresthaven has been abandoned for years. It can survive one more night without you. Eat, sleep, leave in the morning when you're ready.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CONTINUATION — AFTER CRESTHAVEN IS IDENTIFIED]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 23}},
{"beat_id": "CH03_B14_L0005", "speaker_id": "ilyra", "text": "I was going to let you finish that argument before I enjoyed the answer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CONTINUATION — AFTER CRESTHAVEN IS IDENTIFIED]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 27}},
{"beat_id": "CH03_B14_L0006", "speaker_id": "cyanis", "text": "You could've warned me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CONTINUATION — AFTER CRESTHAVEN IS IDENTIFIED]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 29}},
{"beat_id": "CH03_B14_L0007", "speaker_id": "ilyra", "text": "This was better.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CONTINUATION — AFTER CRESTHAVEN IS IDENTIFIED]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 31}},
{"beat_id": "CH03_B14_L0008", "speaker_id": "nimera", "text": "For the record, I support the princess's tyrannical food-and-sleep policy.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CONTINUATION — AFTER CRESTHAVEN IS IDENTIFIED]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 33}},
{"beat_id": "CH03_B14_L0009", "speaker_id": "cyanis", "text": "Nobody asked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CONTINUATION — AFTER CRESTHAVEN IS IDENTIFIED]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 35}},
{"beat_id": "CH03_B14_L0010", "speaker_id": "nimera", "text": "I am learning that does not reliably stop me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CONTINUATION — AFTER CRESTHAVEN IS IDENTIFIED]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 37}},
{"beat_id": "CH03_B14_L0011", "speaker_id": "mirena", "text": "I'll bring Maevra and a proper work crew later tomorrow. Don't wait for us.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CONTINUATION — AFTER CRESTHAVEN IS IDENTIFIED]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 41}},
{"beat_id": "CH03_B14_L0012", "speaker_id": "torren", "text": "What kind of crew?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CONTINUATION — AFTER CRESTHAVEN IS IDENTIFIED]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 43}},
{"beat_id": "CH03_B14_L0013", "speaker_id": "mirena", "text": "The kind that can tell me whether the roof is going to fall on you before one of you decides standing under it is investigative rigor.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CONTINUATION — AFTER CRESTHAVEN IS IDENTIFIED]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 45}},
{"beat_id": "CH03_B14_L0014", "speaker_id": "mirena", "text": "That was not aimed only at Cyanis.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CONTINUATION — AFTER CRESTHAVEN IS IDENTIFIED]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 49}},
{"beat_id": "CH03_B14_L0015", "speaker_id": "nimera", "text": "Unfairly perceptive.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CONTINUATION — AFTER CRESTHAVEN IS IDENTIFIED]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 53}},
{"beat_id": "CH03_B14_L0016", "speaker_id": "mirena", "text": "Consider this a temporary royal prohibition on usefulness.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CONTINUATION — AFTER CRESTHAVEN IS IDENTIFIED]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 55}},
{"beat_id": "CH03_B14_L0017", "speaker_id": "nimera", "text": "I don't think that's a power you have.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CONTINUATION — AFTER CRESTHAVEN IS IDENTIFIED]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 57}},
{"beat_id": "CH03_B14_L0018", "speaker_id": "mirena", "text": "Then challenge the order after breakfast.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[CONTINUATION — AFTER CRESTHAVEN IS IDENTIFIED]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH03_B14_L0019", "speaker_id": "nimera", "text": "I knew where that was. You moving it after I reached for the spoon does not prove I was about to dip a spoon in ink.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 93}},
{"beat_id": "CH03_B14_L0020", "speaker_id": "torren", "text": "Spoon didn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 95}},
{"beat_id": "CH03_B14_L0021", "speaker_id": "nimera", "text": "That's not evidence. That's a failed outcome.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 97}},
{"beat_id": "CH03_B14_L0022", "speaker_id": "cyanis", "text": "That's true.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 101}},
{"beat_id": "CH03_B14_L0023", "speaker_id": "nimera", "text": "You stay out of this. I already have one person manufacturing a case against me from cutlery.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 105}},
{"beat_id": "CH03_B14_L0024", "speaker_id": "cyanis", "text": "Happily.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 107}},
{"beat_id": "CH03_B14_L0025", "speaker_id": "ilyra", "text": "He moved it because you were about to put the spoon in it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 111}},
{"beat_id": "CH03_B14_L0026", "speaker_id": "nimera", "text": "You cannot know that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 113}},
{"beat_id": "CH03_B14_L0027", "speaker_id": "ilyra", "text": "I watched you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 115}},
{"beat_id": "CH03_B14_L0028", "speaker_id": "nimera", "text": "Eyewitness testimony is famously—", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 117}},
{"beat_id": "CH03_B14_L0029", "speaker_id": "ilyra", "text": "Then prove him wrong and use the spoon on the stew.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 119}},
{"beat_id": "CH03_B14_L0030", "speaker_id": "nimera", "text": "That is manipulation.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 125}},
{"beat_id": "CH03_B14_L0031", "speaker_id": "ilyra", "text": "Effective?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 127}},
{"beat_id": "CH03_B14_L0032", "speaker_id": "nimera", "text": "Irrelevant.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 131}},
{"beat_id": "CH03_B14_L0033", "speaker_id": "cyanis", "text": "You going to eat that, or are you just guarding it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 145}},
{"beat_id": "CH03_B14_L0034", "speaker_id": "torren", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 149}},
{"beat_id": "CH03_B14_L0035", "speaker_id": "cyanis", "text": "Cruel.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 151}},
{"beat_id": "CH03_B14_L0036", "speaker_id": "torren", "text": "Slow.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 153}},
{"beat_id": "CH03_B14_L0037", "speaker_id": "nimera", "text": "That one was excellent. Brief, accurate, needlessly unpleasant. Very efficient.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 157}},
{"beat_id": "CH03_B14_L0038", "speaker_id": "torren", "text": "Thanks.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 159}},
{"beat_id": "CH03_B14_L0039", "speaker_id": "nimera", "text": "Don't get smug. You'll ruin it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[EVENING — CROWN GUEST QUARTERS]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_14_REST_IN_CAELORA_MORNING_DEPARTURE_DRAFT_A.md", "source_line": 161}},
