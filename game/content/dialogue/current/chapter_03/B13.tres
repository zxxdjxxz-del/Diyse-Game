beats = [
{"beat_id": "CH03_B13_L0001", "speaker_id": "mirena", "text": "What changed?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DIRECT CUT — PRIVATE ROOM, CAELORA]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 31}},
{"beat_id": "CH03_B13_L0002", "speaker_id": "cyanis", "text": "Someone's been using the Old City.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DIRECT CUT — PRIVATE ROOM, CAELORA]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 35}},
{"beat_id": "CH03_B13_L0003", "speaker_id": "mirena", "text": "Using it how?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DIRECT CUT — PRIVATE ROOM, CAELORA]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 39}},
{"beat_id": "CH03_B13_L0004", "speaker_id": "nimera", "text": "Reading first. Then practicing. Probably in that order—no, strike probably. The physical work gets cleaner as it goes inward, and the research trail points toward the same subjects first. That's consistent with reading before practice. It is not a timestamp.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DIRECT CUT — PRIVATE ROOM, CAELORA]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 41}},
{"beat_id": "CH03_B13_L0005", "speaker_id": "maevra", "text": "Practicing what?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DIRECT CUT — PRIVATE ROOM, CAELORA]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 45}},
{"beat_id": "CH03_B13_L0006", "speaker_id": "cyanis", "text": "The royal seal.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DIRECT CUT — PRIVATE ROOM, CAELORA]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 47}},
{"beat_id": "CH03_B13_L0007", "speaker_id": "mirena", "text": "The Crest?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DIRECT CUT — PRIVATE ROOM, CAELORA]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 51}},
{"beat_id": "CH03_B13_L0008", "speaker_id": "cyanis", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DIRECT CUT — PRIVATE ROOM, CAELORA]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 53}},
{"beat_id": "CH03_B13_L0009", "speaker_id": "nimera", "text": "Ancient forms first, then older Yahtrean forms, then royal examples, then repeated Crest copies. Visually, the later ones get very good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DIRECT CUT — PRIVATE ROOM, CAELORA]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 57}},
{"beat_id": "CH03_B13_L0010", "speaker_id": "torren", "text": "Cleaner every time.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DIRECT CUT — PRIVATE ROOM, CAELORA]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 59}},
{"beat_id": "CH03_B13_L0011", "speaker_id": "mirena", "text": "Did any of them answer like the Queen's?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DIRECT CUT — PRIVATE ROOM, CAELORA]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 61}},
{"beat_id": "CH03_B13_L0012", "speaker_id": "nimera", "text": "Nothing we found proves that. We can prove somebody tried to make the copies more than visual marks. We can prove they pushed hard enough to scorch equipment built for sealcraft. We cannot prove they got royal authority out of it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DIRECT CUT — PRIVATE ROOM, CAELORA]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 63}},
{"beat_id": "CH03_B13_L0013", "speaker_id": "mirena", "text": "Could they have?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DIRECT CUT — PRIVATE ROOM, CAELORA]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 67}},
{"beat_id": "CH03_B13_L0014", "speaker_id": "nimera", "text": "Could? Yes. Proven? No. I know that's an ugly answer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DIRECT CUT — PRIVATE ROOM, CAELORA]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 69}},
{"beat_id": "CH03_B13_L0015", "speaker_id": "mirena", "text": "Ugly is fine. Wrong is expensive.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DIRECT CUT — PRIVATE ROOM, CAELORA]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 71}},
{"beat_id": "CH03_B13_L0016", "speaker_id": "nimera", "text": "Good. Keep saying things like that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DIRECT CUT — PRIVATE ROOM, CAELORA]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 75}},
{"beat_id": "CH03_B13_L0017", "speaker_id": "cyanis", "text": "She's a princess, Pellan.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DIRECT CUT — PRIVATE ROOM, CAELORA]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 79}},
{"beat_id": "CH03_B13_L0018", "speaker_id": "nimera", "text": "That doesn't make good methodology less rare.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DIRECT CUT — PRIVATE ROOM, CAELORA]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 81}},
{"beat_id": "CH03_B13_L0019", "speaker_id": "torren", "text": "Any luck up here?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CROWN-SIDE PROBLEM HAS NOT BECOME EASIER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 89}},
{"beat_id": "CH03_B13_L0020", "speaker_id": "maevra", "text": "No clean gap. No theft window we can prove. Everyone who signed for the seal still swears the same sequence.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CROWN-SIDE PROBLEM HAS NOT BECOME EASIER]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 93}},
{"beat_id": "CH03_B13_L0021", "speaker_id": "mirena", "text": "Which means the paperwork remains annoyingly innocent.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CROWN-SIDE PROBLEM HAS NOT BECOME EASIER]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 95}},
{"beat_id": "CH03_B13_L0022", "speaker_id": "nimera", "text": "The paperwork can be innocent and still wrong.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CROWN-SIDE PROBLEM HAS NOT BECOME EASIER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 97}},
{"beat_id": "CH03_B13_L0023", "speaker_id": "mirena", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CROWN-SIDE PROBLEM HAS NOT BECOME EASIER]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 99}},
{"beat_id": "CH03_B13_L0024", "speaker_id": "nimera", "text": "Right. Sorry. You already know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CROWN-SIDE PROBLEM HAS NOT BECOME EASIER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 103}},
{"beat_id": "CH03_B13_L0025", "speaker_id": "mirena", "text": "I appreciate the restraint.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CROWN-SIDE PROBLEM HAS NOT BECOME EASIER]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 105}},
{"beat_id": "CH03_B13_L0026", "speaker_id": "nimera", "text": "Don't. It may not happen twice.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE CROWN-SIDE PROBLEM HAS NOT BECOME EASIER]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 107}},
{"beat_id": "CH03_B13_L0027", "speaker_id": "mirena", "text": "And the Card?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 113}},
{"beat_id": "CH03_B13_L0028", "speaker_id": "mirena", "text": "That's new.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 121}},
{"beat_id": "CH03_B13_L0029", "speaker_id": "cyanis", "text": "Very.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 123}},
{"beat_id": "CH03_B13_L0030", "speaker_id": "nimera", "text": "It happened after a Diysean Warden tried to kill us.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 125}},
{"beat_id": "CH03_B13_L0031", "speaker_id": "mirena", "text": "I was hoping that sentence improved.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 129}},
{"beat_id": "CH03_B13_L0032", "speaker_id": "nimera", "text": "It gets worse before it gets more precise.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 131}},
{"beat_id": "CH03_B13_L0033", "speaker_id": "cyanis", "text": "It assessed all four of us first. Then attacked.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 135}},
{"beat_id": "CH03_B13_L0034", "speaker_id": "mirena", "text": "Assessed how?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 137}},
{"beat_id": "CH03_B13_L0035", "speaker_id": "ilyra", "text": "Old ward-work. Light across the whole group. Deliberate movement, but we don't know what it was measuring.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 139}},
{"beat_id": "CH03_B13_L0036", "speaker_id": "nimera", "text": "Thank you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 141}},
{"beat_id": "CH03_B13_L0037", "speaker_id": "ilyra", "text": "For what?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 145}},
{"beat_id": "CH03_B13_L0038", "speaker_id": "nimera", "text": "Saying measuring instead of judging.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 147}},
{"beat_id": "CH03_B13_L0039", "speaker_id": "cyanis", "text": "It tried to kill us either way.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 149}},
{"beat_id": "CH03_B13_L0040", "speaker_id": "nimera", "text": "Outcome is not vocabulary.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 151}},
{"beat_id": "CH03_B13_L0041", "speaker_id": "cyanis", "text": "There she is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 153}},
{"beat_id": "CH03_B13_L0042", "speaker_id": "cyanis", "text": "After we beat it, it stayed active long enough to give us two messages.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 157}},
{"beat_id": "CH03_B13_L0043", "speaker_id": "cyanis", "text": "`PREVIOUS ERROR.`", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 161}},
{"beat_id": "CH03_B13_L0044", "speaker_id": "cyanis", "text": "Then `LAST SENTINEL CONFIRMED.`", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 165}},
{"beat_id": "CH03_B13_L0045", "speaker_id": "mirena", "text": "Exact wording?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 169}},
{"beat_id": "CH03_B13_L0046", "speaker_id": "nimera", "text": "As close as the surviving language allows. And the order is exact. Previous error first. Last sentinel confirmed second. Then complete shutdown.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 171}},
{"beat_id": "CH03_B13_L0047", "speaker_id": "mirena", "text": "Card?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 173}},
{"beat_id": "CH03_B13_L0048", "speaker_id": "cyanis", "text": "Changed only after the Warden went completely dead.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 175}},
{"beat_id": "CH03_B13_L0049", "speaker_id": "nimera", "text": "Immediately after, which is suspicious as hell and still not proof of causation.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 177}},
{"beat_id": "CH03_B13_L0050", "speaker_id": "mirena", "text": "Do we know what Last Sentinel is?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 181}},
{"beat_id": "CH03_B13_L0051", "speaker_id": "nimera", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 183}},
{"beat_id": "CH03_B13_L0052", "speaker_id": "mirena", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 185}},
{"beat_id": "CH03_B13_L0053", "speaker_id": "nimera", "text": "That's my line.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 189}},
{"beat_id": "CH03_B13_L0054", "speaker_id": "mirena", "text": "You left it unattended.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 191}},
{"beat_id": "CH03_B13_L0055", "speaker_id": "nimera", "text": "Fine. That's technically on me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OTHER THING THAT CHANGED]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 193}},
{"beat_id": "CH03_B13_L0056", "speaker_id": "mirena", "text": "I don't yet know whether our breach is physical, magical, political, or some miserable combination of all three. I know the Queen did not issue those orders. I know her seal answered them. I know somebody has been researching old seal practice and practicing the royal Crest beneath my city.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MIRENA'S CONCERN]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 199}},
{"beat_id": "CH03_B13_L0057", "speaker_id": "mirena", "text": "What I do not know is the part that decides who I can safely tell.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MIRENA'S CONCERN]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 203}},
{"beat_id": "CH03_B13_L0058", "speaker_id": "torren", "text": "Could be more than one person.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MIRENA'S CONCERN]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 209}},
{"beat_id": "CH03_B13_L0059", "speaker_id": "mirena", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MIRENA'S CONCERN]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 211}},
{"beat_id": "CH03_B13_L0060", "speaker_id": "cyanis", "text": "You think someone's inside the Crown.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MIRENA'S CONCERN]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 213}},
{"beat_id": "CH03_B13_L0061", "speaker_id": "mirena", "text": "I think somebody has access they should not have. That is enough for caution and not enough for treason.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MIRENA'S CONCERN]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 217}},
{"beat_id": "CH03_B13_L0062", "speaker_id": "nimera", "text": "Thank you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MIRENA'S CONCERN]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 219}},
{"beat_id": "CH03_B13_L0063", "speaker_id": "nimera", "text": "Sorry. Reflex. People love promoting suspicion into accusation because accusation feels like progress.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MIRENA'S CONCERN]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 223}},
{"beat_id": "CH03_B13_L0064", "speaker_id": "maevra", "text": "It usually isn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MIRENA'S CONCERN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 225}},
{"beat_id": "CH03_B13_L0065", "speaker_id": "nimera", "text": "I also like you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MIRENA'S CONCERN]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 229}},
{"beat_id": "CH03_B13_L0066", "speaker_id": "maevra", "text": "Dangerous habit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MIRENA'S CONCERN]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 231}},
{"beat_id": "CH03_B13_L0067", "speaker_id": "mirena", "text": "Keep working this with me. Directly. If you find something that changes the problem, it comes to me or Maevra first. Not a clerk, not a commander who happens to outrank you, not a friend who asks the right question in the wrong hallway.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE REQUEST]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 237}},
{"beat_id": "CH03_B13_L0068", "speaker_id": "cyanis", "text": "Understood.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE REQUEST]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 239}},
{"beat_id": "CH03_B13_L0069", "speaker_id": "ilyra", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE REQUEST]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 241}},
{"beat_id": "CH03_B13_L0070", "speaker_id": "nimera", "text": "You do understand I followed these three into a sealed dead civilization, got trapped behind a wall, fought its furniture, and then voluntarily kept going.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE REQUEST]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 247}},
{"beat_id": "CH03_B13_L0071", "speaker_id": "mirena", "text": "Is she always going to be like this?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE REQUEST]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 251}},
{"beat_id": "CH03_B13_L0072", "speaker_id": "cyanis", "text": "I met her today.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE REQUEST]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 253}},
{"beat_id": "CH03_B13_L0073", "speaker_id": "nimera", "text": "Promising start, though.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE REQUEST]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 255}},
{"beat_id": "CH03_B13_L0074", "speaker_id": "ilyra", "text": "Very long day.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE REQUEST]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 257}},
{"beat_id": "CH03_B13_L0075", "speaker_id": "nimera", "text": "See? She understands me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE REQUEST]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 259}},
{"beat_id": "CH03_B13_L0076", "speaker_id": "ilyra", "text": "I didn't say that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE REQUEST]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 261}},
{"beat_id": "CH03_B13_L0077", "speaker_id": "torren", "text": "There's one other thing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 267}},
{"beat_id": "CH03_B13_L0078", "speaker_id": "mirena", "text": "I've spent years reading old Crown history for fun, and I still don't have a version of that mark that makes this reasonable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 278}},
{"beat_id": "CH03_B13_L0079", "speaker_id": "nimera", "text": "The Crest?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 280}},
{"beat_id": "CH03_B13_L0080", "speaker_id": "mirena", "text": "The impossible one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 282}},
{"beat_id": "CH03_B13_L0081", "speaker_id": "torren", "text": "That's the part.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 284}},
{"beat_id": "CH03_B13_L0082", "speaker_id": "mirena", "text": "Show me the scale again.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 288}},
{"beat_id": "CH03_B13_L0083", "speaker_id": "torren", "text": "Best fit. Mountains here. Old route comes out of Caelora on this side. Position's approximate.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 294}},
{"beat_id": "CH03_B13_L0084", "speaker_id": "nimera", "text": "How approximate?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 296}},
{"beat_id": "CH03_B13_L0085", "speaker_id": "torren", "text": "Enough that I wouldn't build a house on it. Not enough that I'd ignore a fort-sized match.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 298}},
{"beat_id": "CH03_B13_L0086", "speaker_id": "mirena", "text": "Wait.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 306}},
{"beat_id": "CH03_B13_L0087", "speaker_id": "mirena", "text": "I think I know where that is.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 312}},
{"beat_id": "CH03_B13_L0088", "speaker_id": "cyanis", "text": "Where?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 314}},
{"beat_id": "CH03_B13_L0089", "speaker_id": "mirena", "text": "Cresthaven.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 318}},
{"beat_id": "CH03_B13_L0090", "speaker_id": "torren", "text": "The old forest fort?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 322}},
{"beat_id": "CH03_B13_L0091", "speaker_id": "mirena", "text": "If your placement is close, yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 324}},
{"beat_id": "CH03_B13_L0092", "speaker_id": "torren", "text": "Close enough to check.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 328}},
{"beat_id": "CH03_B13_L0093", "speaker_id": "nimera", "text": "And the Crest on the old source is still completely impossible.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 330}},
{"beat_id": "CH03_B13_L0094", "speaker_id": "mirena", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 332}},
{"beat_id": "CH03_B13_L0095", "speaker_id": "nimera", "text": "Unless the symbol predates—no. Stop. That's exactly the kind of leap we don't get to make yet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 336}},
{"beat_id": "CH03_B13_L0096", "speaker_id": "cyanis", "text": "Did you just interrupt yourself?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 340}},
{"beat_id": "CH03_B13_L0097", "speaker_id": "nimera", "text": "Somebody had to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "NIMERA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 342}},
{"beat_id": "CH03_B13_L0098", "speaker_id": "mirena", "text": "Still impossible. But now it has an address.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE OLD MAP COMES BACK]", "source_speaker_label": "MIRENA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_03/BEAT_13_MIRENAS_CONCERN_CRESTHAVEN_LEAD_DRAFT_A.md", "source_line": 346}}
