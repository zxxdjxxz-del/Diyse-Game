beats = [
{"beat_id": "CH02_B02_L0001", "speaker_id": "cyanis", "text": "Inn still two streets?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 16}},
{"beat_id": "CH02_B02_L0002", "speaker_id": "torren", "text": "Unless Dunmere finally moved.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 18}},
{"beat_id": "CH02_B02_L0003", "speaker_id": "ilyra", "text": "Don't encourage him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 20}},
{"beat_id": "CH02_B02_L0004", "speaker_id": "torren", "text": "Hold on.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 26}},
{"beat_id": "CH02_B02_L0005", "speaker_id": "carter", "text": "If you're heading out that way, don't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "CARTER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 30}},
{"beat_id": "CH02_B02_L0006", "speaker_id": "cyanis", "text": "Why?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 34}},
{"beat_id": "CH02_B02_L0007", "speaker_id": "carter", "text": "People leave for Caelora and don't reach it. Enough of them that I'm not putting another wagon on that road.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "CARTER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 36}},
{"beat_id": "CH02_B02_L0008", "speaker_id": "returned_guard", "text": "They're not missing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "RETURNED GUARD", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 40}},
{"beat_id": "CH02_B02_L0009", "speaker_id": "ilyra", "text": "You hit your head?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 46}},
{"beat_id": "CH02_B02_L0010", "speaker_id": "returned_guard", "text": "No. Bruised ribs. Scraped arm. Head's fine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "RETURNED GUARD", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 48}},
{"beat_id": "CH02_B02_L0011", "speaker_id": "ilyra", "text": "All right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 52}},
{"beat_id": "CH02_B02_L0012", "speaker_id": "cyanis", "text": "What happened?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 56}},
{"beat_id": "CH02_B02_L0013", "speaker_id": "returned_guard", "text": "Black Host hit us on the road. Didn't take the wagon. Didn't take the cargo. Took the people with me and dragged them toward the Old Bastion. I got loose before they closed the road behind them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "RETURNED GUARD", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 58}},
{"beat_id": "CH02_B02_L0014", "speaker_id": "maevra", "text": "Bastion's occupied?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 62}},
{"beat_id": "CH02_B02_L0015", "speaker_id": "returned_guard", "text": "Has been. They weren't stopping everybody before.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "RETURNED GUARD", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 64}},
{"beat_id": "CH02_B02_L0016", "speaker_id": "torren", "text": "You saw them enter the fort?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 68}},
{"beat_id": "CH02_B02_L0017", "speaker_id": "returned_guard", "text": "No. Toward it. Couldn't see farther than that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "RETURNED GUARD", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 70}},
{"beat_id": "CH02_B02_L0018", "speaker_id": "torren", "text": "Good. Don't turn `toward` into `inside`.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 74}},
{"beat_id": "CH02_B02_L0019", "speaker_id": "torren", "text": "Toward is enough to start.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 78}},
{"beat_id": "CH02_B02_L0020", "speaker_id": "carter", "text": "He's not the only one who came back saying the same thing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "CARTER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 82}},
{"beat_id": "CH02_B02_L0021", "speaker_id": "cyanis", "text": "Bastion can hold the whole corridor?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 88}},
{"beat_id": "CH02_B02_L0022", "speaker_id": "torren", "text": "Pretty much. Road narrows there. Bad ground one side, higher stone the other. Hold the fort and you see traffic coming, stop it where you want, and make everybody use ground you already own.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 92}},
{"beat_id": "CH02_B02_L0023", "speaker_id": "maevra", "text": "Then the damn road belongs to them until we change that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 96}},
{"beat_id": "CH02_B02_L0024", "speaker_id": "carter", "text": "Elder's been collecting every report that comes back. If anybody knows another way near the place, it'll be them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "CARTER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 100}},
{"beat_id": "CH02_B02_L0025", "speaker_id": "maevra", "text": "Where?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 104}},
{"beat_id": "CH02_B02_L0026", "speaker_id": "maevra", "text": "Come on.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[DUNMERE — ARRIVAL]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B02_DUNMERE_ARRIVAL_MISSING_TRAVELERS_DIALOGUE.md", "source_line": 110}}
]
