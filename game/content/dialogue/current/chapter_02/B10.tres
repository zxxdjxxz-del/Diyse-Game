beats = [
{"beat_id": "CH02_B10_L0001", "speaker_id": "maevra", "text": "This'll hold better than the gallery corridor. Two ways in from the Bastion side. If either one goes bad, everybody falls back through that door.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER SAFE AREA]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 16}},
{"beat_id": "CH02_B10_L0002", "speaker_id": "greenhollow_man", "text": "I can watch that side.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER SAFE AREA]", "source_speaker_label": "GREENHOLLOW MAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 22}},
{"beat_id": "CH02_B10_L0003", "speaker_id": "maevra", "text": "Watch it. Don't follow anybody out.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER SAFE AREA]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 24}},
{"beat_id": "CH02_B10_L0004", "speaker_id": "greenhollow_man", "text": "Wasn't planning to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER SAFE AREA]", "source_speaker_label": "GREENHOLLOW MAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 26}},
{"beat_id": "CH02_B10_L0005", "speaker_id": "wounded_soldier", "text": "I can see the other one from here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER SAFE AREA]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 30}},
{"beat_id": "CH02_B10_L0006", "speaker_id": "ilyra", "text": "From there is fine. If that starts bleeding again, pressure and stay put.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER SAFE AREA]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 34}},
{"beat_id": "CH02_B10_L0007", "speaker_id": "wounded_soldier", "text": "Happily.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER SAFE AREA]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 36}},
{"beat_id": "CH02_B10_L0008", "speaker_id": "cyanis", "text": "When they brought you in, how?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE REAL WAY OUT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 44}},
{"beat_id": "CH02_B10_L0009", "speaker_id": "dunmere_woman", "text": "Road gate. Into a yard, through the fort, then down. Wide route. Easy enough when you're being marched through it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE REAL WAY OUT]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 46}},
{"beat_id": "CH02_B10_L0010", "speaker_id": "greenhollow_man", "text": "Same for us.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE REAL WAY OUT]", "source_speaker_label": "GREENHOLLOW MAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 50}},
{"beat_id": "CH02_B10_L0011", "speaker_id": "torren", "text": "Maintained entrance, maintained path. That's how we get everybody out.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE REAL WAY OUT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 54}},
{"beat_id": "CH02_B10_L0012", "speaker_id": "dunmere_woman", "text": "Host still owns it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE REAL WAY OUT]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 58}},
{"beat_id": "CH02_B10_L0013", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE REAL WAY OUT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 60}},
{"beat_id": "CH02_B10_L0014", "speaker_id": "cyanis", "text": "Then that's what we take.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE REAL WAY OUT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 64}},
{"beat_id": "CH02_B10_L0015", "speaker_id": "maevra", "text": "I'm staying here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MAEVRA STAYS]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 72}},
{"beat_id": "CH02_B10_L0016", "speaker_id": "cyanis", "text": "I figured.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MAEVRA STAYS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 74}},
{"beat_id": "CH02_B10_L0017", "speaker_id": "maevra", "text": "You three can move fast and fight. I can keep this room together if the fort pushes back down.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MAEVRA STAYS]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 78}},
{"beat_id": "CH02_B10_L0018", "speaker_id": "torren", "text": "Better use of you here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MAEVRA STAYS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 80}},
{"beat_id": "CH02_B10_L0019", "speaker_id": "maevra", "text": "Somehow still not flattering.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MAEVRA STAYS]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 82}},
{"beat_id": "CH02_B10_L0020", "speaker_id": "torren", "text": "Wasn't trying to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MAEVRA STAYS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 84}},
{"beat_id": "CH02_B10_L0021", "speaker_id": "maevra", "text": "If I say fall back, we fall back together. Nobody runs off alone, nobody chases Host into a corridor, and nobody gets brave because they found a weapon.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MAEVRA STAYS]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 90}},
{"beat_id": "CH02_B10_L0022", "speaker_id": "dunmere_woman", "text": "You expecting trouble?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MAEVRA STAYS]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 94}},
{"beat_id": "CH02_B10_L0023", "speaker_id": "maevra", "text": "I'm expecting a fort.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[MAEVRA STAYS]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 96}},
{"beat_id": "CH02_B10_L0024", "speaker_id": "cyanis", "text": "We're going up. We take the damn road exit, then we come back.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE COMMITMENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 106}},
{"beat_id": "CH02_B10_L0025", "speaker_id": "dunmere_woman", "text": "You said that already.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE COMMITMENT]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 110}},
{"beat_id": "CH02_B10_L0026", "speaker_id": "cyanis", "text": "Good. Remember it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE COMMITMENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 112}},
{"beat_id": "CH02_B10_L0027", "speaker_id": "torren", "text": "Quiet's probably about to run out.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE COMMITMENT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 116}},
{"beat_id": "CH02_B10_L0028", "speaker_id": "ilyra", "text": "Then let's not waste what's left of it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE COMMITMENT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 120}},
{"beat_id": "CH02_B10_L0029", "speaker_id": "maevra", "text": "Go.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE COMMITMENT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B10_PRISONER_SAFE_AREA_EXIT_PROBLEM_DIALOGUE.md", "source_line": 126}}
]
