beats = [
{"beat_id": "CH02_B10_L0001", "speaker_id": "dunmere_woman", "text": "Quiet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST CONTACT]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 17}},
{"beat_id": "CH02_B10_L0002", "speaker_id": "dunmere_woman", "text": "Who the hell are you?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST CONTACT]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 21}},
{"beat_id": "CH02_B10_L0003", "speaker_id": "cyanis", "text": "Not Host. We're here to get you out.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST CONTACT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 23}},
{"beat_id": "CH02_B10_L0004", "speaker_id": "dunmere_woman", "text": "Then explain the wall later and get the fucking doors open now.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST CONTACT]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 27}},
{"beat_id": "CH02_B10_L0005", "speaker_id": "cyanis", "text": "Works for me.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST CONTACT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 29}},
{"beat_id": "CH02_B10_L0006", "speaker_id": "wounded_soldier", "text": "Gallery watch has the keys. Around the bend. Usually two down here, more above. Shifts change around meals and whatever command has them doing upstairs, so I can't promise who is there right now.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST CONTACT]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 33}},
{"beat_id": "CH02_B10_L0007", "speaker_id": "torren", "text": "That's enough. You don't see the whole route from the cell; don't guess the rest for us.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST CONTACT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 37}},
{"beat_id": "CH02_B10_L0008", "speaker_id": "ilyra", "text": "When we get these doors open, can I look at that?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST CONTACT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 43}},
{"beat_id": "CH02_B10_L0009", "speaker_id": "wounded_soldier", "text": "Please.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST CONTACT]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 45}},
{"beat_id": "CH02_B10_L0010", "speaker_id": "cyanis", "text": "Keys first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[FIRST CONTACT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 47}},
{"beat_id": "CH02_B10_L0011", "speaker_id": "ilyra", "text": "Still all right with me checking it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPEN THE CELLS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 61}},
{"beat_id": "CH02_B10_L0012", "speaker_id": "wounded_soldier", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPEN THE CELLS]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 63}},
{"beat_id": "CH02_B10_L0013", "speaker_id": "maevra", "text": "If you can stand without help, make room for someone who can't. If somebody beside you needs an arm, give them one. We don't need a parade; we need everybody accounted for.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPEN THE CELLS]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 69}},
{"beat_id": "CH02_B10_L0014", "speaker_id": "greenhollow_man", "text": "Here. Take my shoulder.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPEN THE CELLS]", "source_speaker_label": "GREENHOLLOW MAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 73}},
{"beat_id": "CH02_B10_L0015", "speaker_id": "cyanis", "text": "Is this everyone they're holding here?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPEN THE CELLS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 77}},
{"beat_id": "CH02_B10_L0016", "speaker_id": "dunmere_woman", "text": "Everyone here now, maybe. Not everyone they've brought through. Groups leave the galleries on different days, different sizes. Once they go up through the fort, they don't come back down where we can see them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPEN THE CELLS]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 81}},
{"beat_id": "CH02_B10_L0017", "speaker_id": "cyanis", "text": "Where do they take them after that?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPEN THE CELLS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 85}},
{"beat_id": "CH02_B10_L0018", "speaker_id": "greenhollow_man", "text": "Don't know. Nobody down here does.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPEN THE CELLS]", "source_speaker_label": "GREENHOLLOW MAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 87}},
{"beat_id": "CH02_B10_L0019", "speaker_id": "wounded_soldier", "text": "I saw groups taken out of the galleries and up through the Bastion. That's it. I never saw where the route ended.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPEN THE CELLS]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 91}},
{"beat_id": "CH02_B10_L0020", "speaker_id": "ilyra", "text": "Anyone ever return after being moved?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPEN THE CELLS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 93}},
{"beat_id": "CH02_B10_L0021", "speaker_id": "dunmere_woman", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPEN THE CELLS]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 95}},
{"beat_id": "CH02_B10_L0022", "speaker_id": "maevra", "text": "Transit point.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[OPEN THE CELLS]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 101}},
{"beat_id": "CH02_B10_L0023", "speaker_id": "cyanis", "text": "Who runs the Bastion?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO COMMANDS THE BASTION]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 109}},
{"beat_id": "CH02_B10_L0024", "speaker_id": "wounded_soldier", "text": "Rhazek. I've seen him down here twice. Guards call him Commander and report to him when he comes through, so I'm not repeating a rumor.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO COMMANDS THE BASTION]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 113}},
{"beat_id": "CH02_B10_L0025", "speaker_id": "cyanis", "text": "Commander Rhazek.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO COMMANDS THE BASTION]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 117}},
{"beat_id": "CH02_B10_L0026", "speaker_id": "maevra", "text": "Then the gallery guards aren't the job.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO COMMANDS THE BASTION]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 121}},
{"beat_id": "CH02_B10_L0027", "speaker_id": "torren", "text": "Shit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO COMMANDS THE BASTION]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 125}},
{"beat_id": "CH02_B10_L0028", "speaker_id": "dunmere_woman", "text": "That's how you came in?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING THEM OUT]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 135}},
{"beat_id": "CH02_B10_L0029", "speaker_id": "cyanis", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING THEM OUT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 137}},
{"beat_id": "CH02_B10_L0030", "speaker_id": "dunmere_woman", "text": "Then we're not all making that route. Not through whatever soaked you four on the way here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING THEM OUT]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 141}},
{"beat_id": "CH02_B10_L0031", "speaker_id": "ilyra", "text": "No. Some of these people need a maintained path, not a flooded ruin and a boss chamber.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING THEM OUT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 145}},
{"beat_id": "CH02_B10_L0032", "speaker_id": "cyanis", "text": "Bastion-side exit?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING THEM OUT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 149}},
{"beat_id": "CH02_B10_L0033", "speaker_id": "torren", "text": "Has to be one if they bring prisoners in and move them out in groups. It'll be controlled by the Host.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING THEM OUT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 151}},
{"beat_id": "CH02_B10_L0034", "speaker_id": "maevra", "text": "Then that's the problem we solve next.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING THEM OUT]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 153}},
{"beat_id": "CH02_B10_L0035", "speaker_id": "cyanis", "text": "Nobody goes back through the Archive. We put you somewhere defensible down here, find the proper exit, make it safe, and come back for everyone.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING THEM OUT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 157}},
{"beat_id": "CH02_B10_L0036", "speaker_id": "dunmere_woman", "text": "You'd better.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING THEM OUT]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 161}},
{"beat_id": "CH02_B10_L0037", "speaker_id": "cyanis", "text": "We will.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING THEM OUT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 163}}
]
