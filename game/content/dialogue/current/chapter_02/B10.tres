beats = [
{"beat_id": "CH02_B10_L0001", "speaker_id": "dunmere_woman", "text": "Quiet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 14}},
{"beat_id": "CH02_B10_L0002", "speaker_id": "dunmere_woman", "text": "Who the hell are you?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 18}},
{"beat_id": "CH02_B10_L0003", "speaker_id": "cyanis", "text": "Not Host.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 20}},
{"beat_id": "CH02_B10_L0004", "speaker_id": "cyanis", "text": "We're getting you out.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 24}},
{"beat_id": "CH02_B10_L0005", "speaker_id": "dunmere_woman", "text": "Then explain the wall later.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 28}},
{"beat_id": "CH02_B10_L0006", "speaker_id": "dunmere_woman", "text": "Doors first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 32}},
{"beat_id": "CH02_B10_L0007", "speaker_id": "cyanis", "text": "Agreed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 34}},
{"beat_id": "CH02_B10_L0008", "speaker_id": "wounded_soldier", "text": "Gallery watch has the keys. Around the bend. Usually two down here. Could be more with the alarm.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 38}},
{"beat_id": "CH02_B10_L0009", "speaker_id": "torren", "text": "Anything past that you actually know?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 42}},
{"beat_id": "CH02_B10_L0010", "speaker_id": "wounded_soldier", "text": "Not from in here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 46}},
{"beat_id": "CH02_B10_L0011", "speaker_id": "torren", "text": "Good enough.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 48}},
{"beat_id": "CH02_B10_L0012", "speaker_id": "ilyra", "text": "When the door's open, can I look at that?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 52}},
{"beat_id": "CH02_B10_L0013", "speaker_id": "wounded_soldier", "text": "Please.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 56}},
{"beat_id": "CH02_B10_L0014", "speaker_id": "cyanis", "text": "Keys first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 60}},
{"beat_id": "CH02_B10_L0015", "speaker_id": "dunmere_woman", "text": "Easy. I've got you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 78}},
{"beat_id": "CH02_B10_L0016", "speaker_id": "maevra", "text": "If you can stand on your own, make room for someone who can't. Pair up before anybody starts wandering.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 84}},
{"beat_id": "CH02_B10_L0017", "speaker_id": "ilyra", "text": "Still all right with me checking it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 90}},
{"beat_id": "CH02_B10_L0018", "speaker_id": "wounded_soldier", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 92}},
{"beat_id": "CH02_B10_L0019", "speaker_id": "cyanis", "text": "Is this everyone they brought here?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 98}},
{"beat_id": "CH02_B10_L0020", "speaker_id": "dunmere_woman", "text": "Everyone here now, maybe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 102}},
{"beat_id": "CH02_B10_L0021", "speaker_id": "dunmere_woman", "text": "Not everyone they've brought through.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 106}},
{"beat_id": "CH02_B10_L0022", "speaker_id": "dunmere_woman", "text": "Groups leave. Different days, different sizes. Guards take them upstairs through the fort. Nobody comes back down.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 112}},
{"beat_id": "CH02_B10_L0023", "speaker_id": "greenhollow_man", "text": "We never find out where they went.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "GREENHOLLOW MAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 116}},
{"beat_id": "CH02_B10_L0024", "speaker_id": "wounded_soldier", "text": "I've seen them moved out of the galleries. That's all I can swear to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 120}},
{"beat_id": "CH02_B10_L0025", "speaker_id": "cyanis", "text": "Who gives the orders here?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 126}},
{"beat_id": "CH02_B10_L0026", "speaker_id": "wounded_soldier", "text": "Commander Rhazek.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 130}},
{"beat_id": "CH02_B10_L0027", "speaker_id": "maevra", "text": "You're sure?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 136}},
{"beat_id": "CH02_B10_L0028", "speaker_id": "wounded_soldier", "text": "Seen him down here twice. Guards report to him when he comes through.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 138}},
{"beat_id": "CH02_B10_L0029", "speaker_id": "torren", "text": "Shit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 142}},
{"beat_id": "CH02_B10_L0030", "speaker_id": "cyanis", "text": "All right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 146}},
{"beat_id": "CH02_B10_L0031", "speaker_id": "dunmere_woman", "text": "That's your way in?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE EXIT PROBLEM]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 154}},
{"beat_id": "CH02_B10_L0032", "speaker_id": "cyanis", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE EXIT PROBLEM]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 156}},
{"beat_id": "CH02_B10_L0033", "speaker_id": "dunmere_woman", "text": "We're not all making that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE EXIT PROBLEM]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 162}},
{"beat_id": "CH02_B10_L0034", "speaker_id": "ilyra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE EXIT PROBLEM]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 166}},
{"beat_id": "CH02_B10_L0035", "speaker_id": "ilyra", "text": "Some could. Some shouldn't. A few absolutely shouldn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE EXIT PROBLEM]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 170}},
{"beat_id": "CH02_B10_L0036", "speaker_id": "cyanis", "text": "Bastion has a real way out.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE EXIT PROBLEM]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 178}},
{"beat_id": "CH02_B10_L0037", "speaker_id": "torren", "text": "Has to. They're moving groups through it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE EXIT PROBLEM]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 180}},
{"beat_id": "CH02_B10_L0038", "speaker_id": "maevra", "text": "Which means the Host controls it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE EXIT PROBLEM]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 182}},
{"beat_id": "CH02_B10_L0039", "speaker_id": "cyanis", "text": "We keep you down here somewhere we can defend. We take the proper exit from them. Then we come back.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE EXIT PROBLEM]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_10_PRISONER_GALLERIES_FIRST_CONTACT_NATURAL_TURN_WORKING_DIALOGUE.md", "source_line": 188}},
