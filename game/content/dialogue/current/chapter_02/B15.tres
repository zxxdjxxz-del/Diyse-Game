beats = [
{"beat_id": "CH02_B15_L0001", "speaker_id": "elder", "text": "Everyone?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — BACK IN DUNMERE]", "source_speaker_label": "ELDER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 25}},
{"beat_id": "CH02_B15_L0002", "speaker_id": "maevra", "text": "Everyone who was still there.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — BACK IN DUNMERE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 29}},
{"beat_id": "CH02_B15_L0003", "speaker_id": "maevra", "text": "Earlier groups were already gone.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — BACK IN DUNMERE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 33}},
{"beat_id": "CH02_B15_L0004", "speaker_id": "elder", "text": "You know where?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — BACK IN DUNMERE]", "source_speaker_label": "ELDER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 37}},
{"beat_id": "CH02_B15_L0005", "speaker_id": "cyanis", "text": "No. Rhazek wouldn't give us a destination.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — BACK IN DUNMERE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 41}},
{"beat_id": "CH02_B15_L0006", "speaker_id": "elder", "text": "Then they're still missing.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — BACK IN DUNMERE]", "source_speaker_label": "ELDER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 45}},
{"beat_id": "CH02_B15_L0007", "speaker_id": "cyanis", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — BACK IN DUNMERE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 47}},
{"beat_id": "CH02_B15_L0008", "speaker_id": "elder", "text": "Bastion?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT CHANGED]", "source_speaker_label": "ELDER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 55}},
{"beat_id": "CH02_B15_L0009", "speaker_id": "torren", "text": "Host pulled out. Gate's open. Checkpoints are gone.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT CHANGED]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 57}},
{"beat_id": "CH02_B15_L0010", "speaker_id": "elder", "text": "Rhazek?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT CHANGED]", "source_speaker_label": "ELDER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 59}},
{"beat_id": "CH02_B15_L0011", "speaker_id": "cyanis", "text": "Alive. He was running the seizures himself. We beat him and he withdrew the garrison.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT CHANGED]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 61}},
{"beat_id": "CH02_B15_L0012", "speaker_id": "elder", "text": "So he lost the fort.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT CHANGED]", "source_speaker_label": "ELDER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 63}},
{"beat_id": "CH02_B15_L0013", "speaker_id": "cyanis", "text": "Here, yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT CHANGED]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 65}},
{"beat_id": "CH02_B15_L0014", "speaker_id": "elder", "text": "Road usable?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT CHANGED]", "source_speaker_label": "ELDER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 69}},
{"beat_id": "CH02_B15_L0015", "speaker_id": "torren", "text": "Yeah. Bastion isn't controlling the corridor anymore. Normal road caution still applies, but Greenhollow to Dunmere is open.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT CHANGED]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 73}},
{"beat_id": "CH02_B15_L0016", "speaker_id": "elder", "text": "Then we reopen it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHAT CHANGED]", "source_speaker_label": "ELDER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 77}},
{"beat_id": "CH02_B15_L0017", "speaker_id": "cyanis", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 93}},
{"beat_id": "CH02_B15_L0018", "speaker_id": "ilyra", "text": "The road or the inn?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 97}},
{"beat_id": "CH02_B15_L0019", "speaker_id": "cyanis", "text": "Both.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 99}},
{"beat_id": "CH02_B15_L0020", "speaker_id": "torren", "text": "Inn first in your head.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 103}},
{"beat_id": "CH02_B15_L0021", "speaker_id": "cyanis", "text": "We rescued people before I ate. That's heroic as hell.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 105}},
{"beat_id": "CH02_B15_L0022", "speaker_id": "maevra", "text": "Deeply moving.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 109}},
{"beat_id": "CH02_B15_L0023", "speaker_id": "cyanis", "text": "Thank you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 111}},
{"beat_id": "CH02_B15_L0024", "speaker_id": "ilyra", "text": "That wasn't praise.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 113}},
{"beat_id": "CH02_B15_L0025", "speaker_id": "cyanis", "text": "I'm taking what I can get.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 115}},
{"beat_id": "CH02_B15_L0026", "speaker_id": "elder", "text": "Get food. Get dry. Sleep if any of you remember how.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "ELDER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 119}},
{"beat_id": "CH02_B15_L0027", "speaker_id": "torren", "text": "He won't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 123}},
{"beat_id": "CH02_B15_L0028", "speaker_id": "cyanis", "text": "Excuse me?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 127}},
{"beat_id": "CH02_B15_L0029", "speaker_id": "torren", "text": "You'll think of something else you want to ask before the food arrives.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 129}},
{"beat_id": "CH02_B15_L0030", "speaker_id": "ilyra", "text": "Two questions.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 133}},
{"beat_id": "CH02_B15_L0031", "speaker_id": "maevra", "text": "Three.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 135}},
{"beat_id": "CH02_B15_L0032", "speaker_id": "cyanis", "text": "Why are we betting on this?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 137}},
{"beat_id": "CH02_B15_L0033", "speaker_id": "torren", "text": "Four.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 139}},
{"beat_id": "CH02_B15_L0034", "speaker_id": "ilyra", "text": "Bullshit. Complaint.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 143}},
{"beat_id": "CH02_B15_L0035", "speaker_id": "torren", "text": "Had a question in it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 145}},
{"beat_id": "CH02_B15_L0036", "speaker_id": "maevra", "text": "We need rules now?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 147}},
{"beat_id": "CH02_B15_L0037", "speaker_id": "ilyra", "text": "If we're wagering on it, obviously.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 149}},
{"beat_id": "CH02_B15_L0038", "speaker_id": "cyanis", "text": "I preferred the damn Bastion.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 153}},
{"beat_id": "CH02_B15_L0039", "speaker_id": "torren", "text": "No, you didn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 159}},
{"beat_id": "CH02_B15_L0040", "speaker_id": "cyanis", "text": "No. I really didn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE", "STORY_CHAPTER_02_COMPLETE", "UNLOCK_C05_STILL_BURNS"], "source_section": "[THE PRESSURE DROPS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B15_RETURN_TO_DUNMERE_ROAD_REOPENED_CLEANUP_DIALOGUE.md", "source_line": 163}}
