beats = [
{"beat_id": "CH02_B12_L0001", "speaker_id": "masked_officer", "text": "South stair is lost. Upper east still holds. Road gate is secure.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — COMMAND ROOM]", "source_speaker_label": "MASKED OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 26}},
{"beat_id": "CH02_B12_L0002", "speaker_id": "rhazek", "text": "Lower galleries?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — COMMAND ROOM]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 28}},
{"beat_id": "CH02_B12_L0003", "speaker_id": "masked_officer", "text": "No report since the alarm.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — COMMAND ROOM]", "source_speaker_label": "MASKED OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 30}},
{"beat_id": "CH02_B12_L0004", "speaker_id": "rhazek", "text": "Keep the gate staffed. Do not strip it to reinforce the interior.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — COMMAND ROOM]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 34}},
{"beat_id": "CH02_B12_L0005", "speaker_id": "masked_officer", "text": "Understood.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — COMMAND ROOM]", "source_speaker_label": "MASKED OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 36}},
{"beat_id": "CH02_B12_L0006", "speaker_id": "rhazek", "text": "There you are.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — COMMAND ROOM]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 46}},
{"beat_id": "CH02_B12_L0007", "speaker_id": "cyanis", "text": "Commander Rhazek.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — COMMAND ROOM]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 50}},
{"beat_id": "CH02_B12_L0008", "speaker_id": "rhazek", "text": "Your prisoners gave you my name.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — COMMAND ROOM]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 52}},
{"beat_id": "CH02_B12_L0009", "speaker_id": "cyanis", "text": "They did.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — COMMAND ROOM]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 54}},
{"beat_id": "CH02_B12_L0010", "speaker_id": "cyanis", "text": "You've been taking people off the road. Your order?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ORDER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 68}},
{"beat_id": "CH02_B12_L0011", "speaker_id": "rhazek", "text": "Mine. The corridor is under Black Host authority. Those taken into custody were assigned for transfer.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ORDER]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 70}},
{"beat_id": "CH02_B12_L0012", "speaker_id": "ilyra", "text": "Assigned.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ORDER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 74}},
{"beat_id": "CH02_B12_L0013", "speaker_id": "rhazek", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ORDER]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 78}},
{"beat_id": "CH02_B12_L0014", "speaker_id": "ilyra", "text": "Some of them can barely walk.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ORDER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 80}},
{"beat_id": "CH02_B12_L0015", "speaker_id": "rhazek", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ORDER]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 82}},
{"beat_id": "CH02_B12_L0016", "speaker_id": "ilyra", "text": "And you moved them anyway.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ORDER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 84}},
{"beat_id": "CH02_B12_L0017", "speaker_id": "rhazek", "text": "Their condition changes how they are moved. It does not cancel the order.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ORDER]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 86}},
{"beat_id": "CH02_B12_L0018", "speaker_id": "cyanis", "text": "They didn't agree to any of this.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ORDER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 96}},
{"beat_id": "CH02_B12_L0019", "speaker_id": "rhazek", "text": "Agreement is not the standard.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ORDER]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 98}},
{"beat_id": "CH02_B12_L0020", "speaker_id": "cyanis", "text": "For you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ORDER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 100}},
{"beat_id": "CH02_B12_L0021", "speaker_id": "rhazek", "text": "For a functioning state. Refusal does not dissolve authority.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ORDER]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 102}},
{"beat_id": "CH02_B12_L0022", "speaker_id": "torren", "text": "Convenient as hell.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ORDER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 106}},
{"beat_id": "CH02_B12_L0023", "speaker_id": "rhazek", "text": "Necessary.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ORDER]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 108}},
{"beat_id": "CH02_B12_L0024", "speaker_id": "cyanis", "text": "Where did you send the earlier groups?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHERE THE OTHERS WENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 118}},
{"beat_id": "CH02_B12_L0025", "speaker_id": "rhazek", "text": "You do not have authority to receive that information.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHERE THE OTHERS WENT]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 120}},
{"beat_id": "CH02_B12_L0026", "speaker_id": "cyanis", "text": "You put people in cages and still want me to ask nicely?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHERE THE OTHERS WENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 124}},
{"beat_id": "CH02_B12_L0027", "speaker_id": "rhazek", "text": "You object to the policy. That does not give you standing inside my command.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHERE THE OTHERS WENT]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 126}},
{"beat_id": "CH02_B12_L0028", "speaker_id": "cyanis", "text": "Pretty sure we're past that shit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHERE THE OTHERS WENT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 130}},
{"beat_id": "CH02_B12_L0029", "speaker_id": "rhazek", "text": "Yes. That is becoming obvious.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHERE THE OTHERS WENT]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 134}},
{"beat_id": "CH02_B12_L0030", "speaker_id": "host_voice", "text": "West stair falling back!", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE MASKED OFFICER LEAVES]", "source_speaker_label": "HOST VOICE", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 144}},
{"beat_id": "CH02_B12_L0031", "speaker_id": "rhazek", "text": "West stair.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE MASKED OFFICER LEAVES]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 148}},
{"beat_id": "CH02_B12_L0032", "speaker_id": "rhazek", "text": "Clear the wounded from the upper corridor. Gate stays staffed. No one abandons a post to chase intruders into the lower levels.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE MASKED OFFICER LEAVES]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 152}},
{"beat_id": "CH02_B12_L0033", "speaker_id": "masked_officer", "text": "Understood.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE MASKED OFFICER LEAVES]", "source_speaker_label": "MASKED OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 154}},
{"beat_id": "CH02_B12_L0034", "speaker_id": "rhazek", "text": "Leave him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE MASKED OFFICER LEAVES]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 162}},
{"beat_id": "CH02_B12_L0035", "speaker_id": "rhazek", "text": "You came here for command authority. It is here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE MASKED OFFICER LEAVES]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 166}},
{"beat_id": "CH02_B12_L0036", "speaker_id": "rhazek", "text": "You have disrupted my interior. That is not the same as taking the Bastion.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORITY]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 184}},
{"beat_id": "CH02_B12_L0037", "speaker_id": "cyanis", "text": "Then we'll take the rest.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORITY]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 188}},
{"beat_id": "CH02_B12_L0038", "speaker_id": "rhazek", "text": "The detainees are not leaving through that gate.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORITY]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 190}},
{"beat_id": "CH02_B12_L0039", "speaker_id": "ilyra", "text": "They are.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORITY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 194}},
{"beat_id": "CH02_B12_L0040", "speaker_id": "rhazek", "text": "On whose authority?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORITY]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 198}},
{"beat_id": "CH02_B12_L0041", "speaker_id": "ilyra", "text": "Theirs.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORITY]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 202}},
{"beat_id": "CH02_B12_L0042", "speaker_id": "rhazek", "text": "You intend to substitute your judgment for mine by force.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[AUTHORITY]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B12_RHAZEK_MASKED_OFFICER_DIALOGUE.md", "source_line": 210}},
