beats = [
{"beat_id": "CH02_B01_L0001", "speaker_id": "torren", "text": "High side.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FINAL APPROACH]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 25}},
{"beat_id": "CH02_B01_L0002", "speaker_id": "cyanis", "text": "That one looks easier.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FINAL APPROACH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 29}},
{"beat_id": "CH02_B01_L0003", "speaker_id": "torren", "text": "Yeah. That's how it gets you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FINAL APPROACH]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 31}},
{"beat_id": "CH02_B01_L0004", "speaker_id": "cyanis", "text": "Mud?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FINAL APPROACH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 33}},
{"beat_id": "CH02_B01_L0005", "speaker_id": "torren", "text": "Knee-deep under the crust.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FINAL APPROACH]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 35}},
{"beat_id": "CH02_B01_L0006", "speaker_id": "cyanis", "text": "Right.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FINAL APPROACH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 39}},
{"beat_id": "CH02_B01_L0007", "speaker_id": "torren", "text": "See? Trainable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FINAL APPROACH]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 43}},
{"beat_id": "CH02_B01_L0008", "speaker_id": "cyanis", "text": "You kept that one.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FINAL APPROACH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 47}},
{"beat_id": "CH02_B01_L0009", "speaker_id": "torren", "text": "Works.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GAMEPLAY — FINAL APPROACH]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 49}},
{"beat_id": "CH02_B01_L0010", "speaker_id": "torren", "text": "There. Dunmere. Still where I left it. Damn good start.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — DUNMERE IN VIEW]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 63}},
{"beat_id": "CH02_B01_L0011", "speaker_id": "cyanis", "text": "You sound relieved.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — DUNMERE IN VIEW]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 65}},
{"beat_id": "CH02_B01_L0012", "speaker_id": "torren", "text": "I like towns that stay put.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — DUNMERE IN VIEW]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 67}},
{"beat_id": "CH02_B01_L0013", "speaker_id": "ilyra", "text": "Demanding.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — DUNMERE IN VIEW]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 69}},
{"beat_id": "CH02_B01_L0014", "speaker_id": "torren", "text": "Roads move enough.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — DUNMERE IN VIEW]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 71}},
{"beat_id": "CH02_B01_L0015", "speaker_id": "cyanis", "text": "First time here. Anything I should know?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — DUNMERE IN VIEW]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 75}},
{"beat_id": "CH02_B01_L0016", "speaker_id": "torren", "text": "Fish smell's normal. Cooper's sign lies. Black onion stew looks like ditch water and tastes better than it has any right to.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — DUNMERE IN VIEW]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 79}},
{"beat_id": "CH02_B01_L0017", "speaker_id": "cyanis", "text": "That was three recommendations.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — DUNMERE IN VIEW]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 83}},
{"beat_id": "CH02_B01_L0018", "speaker_id": "torren", "text": "Two warnings and a stew.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — DUNMERE IN VIEW]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 85}},
{"beat_id": "CH02_B01_L0019", "speaker_id": "ilyra", "text": "Of course you'd call that different.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — DUNMERE IN VIEW]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 87}},
{"beat_id": "CH02_B01_L0020", "speaker_id": "maevra", "text": "Keep walking before he gives you lodging advice.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — DUNMERE IN VIEW]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 91}},
{"beat_id": "CH02_B01_L0021", "speaker_id": "torren", "text": "Piss off.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — DUNMERE IN VIEW]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B01_PATH_OUTSIDE_DUNMERE_DIALOGUE.md", "source_line": 95}}
]
