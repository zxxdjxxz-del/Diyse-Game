{"beat_id": "CH02_B14_L0001", "speaker_id": "maevra", "text": "Three.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER SAFE AREA]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 14}},
{"beat_id": "CH02_B14_L0002", "speaker_id": "cyanis", "text": "Three.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER SAFE AREA]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 18}},
{"beat_id": "CH02_B14_L0003", "speaker_id": "dunmere_woman", "text": "Gate?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER SAFE AREA]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 24}},
{"beat_id": "CH02_B14_L0004", "speaker_id": "torren", "text": "Open.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER SAFE AREA]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 28}},
{"beat_id": "CH02_B14_L0005", "speaker_id": "greenhollow_man", "text": "Host?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER SAFE AREA]", "source_speaker_label": "GREENHOLLOW MAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 30}},
{"beat_id": "CH02_B14_L0006", "speaker_id": "torren", "text": "Gone from the Bastion.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER SAFE AREA]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 32}},
{"beat_id": "CH02_B14_L0007", "speaker_id": "wounded_soldier", "text": "Rhazek?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER SAFE AREA]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 36}},
{"beat_id": "CH02_B14_L0008", "speaker_id": "cyanis", "text": "Beat him. He's alive, but he pulled his people out.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER SAFE AREA]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 38}},
{"beat_id": "CH02_B14_L0009", "speaker_id": "wounded_soldier", "text": "So they lost it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER SAFE AREA]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 40}},
{"beat_id": "CH02_B14_L0010", "speaker_id": "cyanis", "text": "Here, yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER SAFE AREA]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 42}},
{"beat_id": "CH02_B14_L0011", "speaker_id": "dunmere_woman", "text": "Then we're leaving.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER SAFE AREA]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 46}},
{"beat_id": "CH02_B14_L0012", "speaker_id": "cyanis", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LOWER SAFE AREA]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 50}},
{"beat_id": "CH02_B14_L0013", "speaker_id": "ilyra", "text": "Before the stairs make anybody stupid—if you're dizzy or can't put weight on something, say it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING READY TO MOVE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 58}},
{"beat_id": "CH02_B14_L0014", "speaker_id": "wounded_soldier", "text": "I can walk.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING READY TO MOVE]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 62}},
{"beat_id": "CH02_B14_L0015", "speaker_id": "ilyra", "text": "Good. You're still taking his arm.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING READY TO MOVE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 64}},
{"beat_id": "CH02_B14_L0016", "speaker_id": "greenhollow_man", "text": "Happily.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING READY TO MOVE]", "source_speaker_label": "GREENHOLLOW MAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 68}},
{"beat_id": "CH02_B14_L0017", "speaker_id": "wounded_soldier", "text": "You say that now.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING READY TO MOVE]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 70}},
{"beat_id": "CH02_B14_L0018", "speaker_id": "greenhollow_man", "text": "I've heard you complain for two days. Walking will be quieter.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING READY TO MOVE]", "source_speaker_label": "GREENHOLLOW MAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 72}},
{"beat_id": "CH02_B14_L0019", "speaker_id": "maevra", "text": "Pair up if you need to. Help somebody if you don't. Nobody goes off alone.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING READY TO MOVE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 78}},
{"beat_id": "CH02_B14_L0020", "speaker_id": "maevra", "text": "And nobody gets damn heroic because the door's finally open.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING READY TO MOVE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 82}},
{"beat_id": "CH02_B14_L0021", "speaker_id": "torren", "text": "Including commanders.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING READY TO MOVE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 86}},
{"beat_id": "CH02_B14_L0022", "speaker_id": "maevra", "text": "I knew you were going to enjoy this.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING READY TO MOVE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 90}},
{"beat_id": "CH02_B14_L0023", "speaker_id": "torren", "text": "Little bit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[GETTING READY TO MOVE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 92}},
{"beat_id": "CH02_B14_L0024", "speaker_id": "torren", "text": "We're not using the way we came in. Up through the Bastion, east court, road gate. Maintained ground all the way out.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ROUTE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 100}},
{"beat_id": "CH02_B14_L0025", "speaker_id": "dunmere_woman", "text": "Clear?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ROUTE]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 104}},
{"beat_id": "CH02_B14_L0026", "speaker_id": "torren", "text": "Organized Host is gone. I'll check ahead as we move.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ROUTE]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 108}},
{"beat_id": "CH02_B14_L0027", "speaker_id": "ilyra", "text": "I'll stay with anybody who needs help on the stairs.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ROUTE]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 116}},
{"beat_id": "CH02_B14_L0028", "speaker_id": "cyanis", "text": "I'll take rear.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ROUTE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 120}},
{"beat_id": "CH02_B14_L0029", "speaker_id": "maevra", "text": "Of course you will.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ROUTE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 124}},
{"beat_id": "CH02_B14_L0030", "speaker_id": "cyanis", "text": "Somebody should.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ROUTE]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 128}},
{"beat_id": "CH02_B14_L0031", "speaker_id": "maevra", "text": "Didn't say you shouldn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ROUTE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 130}},
{"beat_id": "CH02_B14_L0032", "speaker_id": "maevra", "text": "Just predictable.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE ROUTE]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 134}},
{"beat_id": "CH02_B14_L0033", "speaker_id": "dunmere_woman", "text": "You actually came back.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THEY CAME BACK]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 144}},
{"beat_id": "CH02_B14_L0034", "speaker_id": "cyanis", "text": "Said we would.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THEY CAME BACK]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 146}},
{"beat_id": "CH02_B14_L0035", "speaker_id": "dunmere_woman", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THEY CAME BACK]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 150}},
{"beat_id": "CH02_B14_L0036", "speaker_id": "dunmere_woman", "text": "Come on.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THEY CAME BACK]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 154}},
{"beat_id": "CH02_B14_L0037", "speaker_id": "torren", "text": "Slow on the stairs. Keep the person ahead of you in sight. If I stop, everybody stops.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THEY CAME BACK]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 160}},
{"beat_id": "CH02_B14_L0038", "speaker_id": "maevra", "text": "You heard him.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THEY CAME BACK]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B14_RETURN_TO_THE_PRISONERS_RELEASE_DIALOGUE.md", "source_line": 164}}
]
