beats = [
{"beat_id": "CH02_B13_L0001", "speaker_id": "masked_officer", "text": "South stair is lost. Upper east still holds. Road gate is secure.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[REPORT IN PROGRESS]", "source_speaker_label": "MASKED OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 21}},
{"beat_id": "CH02_B13_L0002", "speaker_id": "rhazek", "text": "Lower galleries?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[REPORT IN PROGRESS]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 23}},
{"beat_id": "CH02_B13_L0003", "speaker_id": "masked_officer", "text": "No report since the alarm.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[REPORT IN PROGRESS]", "source_speaker_label": "MASKED OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 25}},
{"beat_id": "CH02_B13_L0004", "speaker_id": "rhazek", "text": "Keep the gate staffed. Do not strip it to reinforce the interior.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[REPORT IN PROGRESS]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 29}},
{"beat_id": "CH02_B13_L0005", "speaker_id": "masked_officer", "text": "Understood.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[REPORT IN PROGRESS]", "source_speaker_label": "MASKED OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 31}},
{"beat_id": "CH02_B13_L0006", "speaker_id": "rhazek", "text": "So that's what reached my command stair.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[REPORT IN PROGRESS]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 39}},
{"beat_id": "CH02_B13_L0007", "speaker_id": "cyanis", "text": "Commander Rhazek.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[REPORT IN PROGRESS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 43}},
{"beat_id": "CH02_B13_L0008", "speaker_id": "rhazek", "text": "You know my name.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[REPORT IN PROGRESS]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 47}},
{"beat_id": "CH02_B13_L0009", "speaker_id": "cyanis", "text": "Your prisoners do.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[REPORT IN PROGRESS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 49}},
{"beat_id": "CH02_B13_L0010", "speaker_id": "torren", "text": "Gate's still held.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[REPORT IN PROGRESS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 57}},
{"beat_id": "CH02_B13_L0011", "speaker_id": "ilyra", "text": "Then we're not finished.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[REPORT IN PROGRESS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 59}},
{"beat_id": "CH02_B13_L0012", "speaker_id": "rhazek", "text": "No. You're not.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[REPORT IN PROGRESS]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 63}},
{"beat_id": "CH02_B13_L0013", "speaker_id": "cyanis", "text": "You've been taking people off the road.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO OWNS THE ORDER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 71}},
{"beat_id": "CH02_B13_L0014", "speaker_id": "rhazek", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO OWNS THE ORDER]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 73}},
{"beat_id": "CH02_B13_L0015", "speaker_id": "cyanis", "text": "Your order?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO OWNS THE ORDER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 77}},
{"beat_id": "CH02_B13_L0016", "speaker_id": "rhazek", "text": "Mine.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO OWNS THE ORDER]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 79}},
{"beat_id": "CH02_B13_L0017", "speaker_id": "rhazek", "text": "If you came looking for a guard to blame, don't waste your time. The seizures are authorized here because I authorized them.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO OWNS THE ORDER]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 83}},
{"beat_id": "CH02_B13_L0018", "speaker_id": "ilyra", "text": "Some of those people can barely walk.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO OWNS THE ORDER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 87}},
{"beat_id": "CH02_B13_L0019", "speaker_id": "rhazek", "text": "I know.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO OWNS THE ORDER]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 89}},
{"beat_id": "CH02_B13_L0020", "speaker_id": "ilyra", "text": "And groups were still being moved out.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO OWNS THE ORDER]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 91}},
{"beat_id": "CH02_B13_L0021", "speaker_id": "rhazek", "text": "They were never meant to remain here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO OWNS THE ORDER]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 93}},
{"beat_id": "CH02_B13_L0022", "speaker_id": "cyanis", "text": "Moved where?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO OWNS THE ORDER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 95}},
{"beat_id": "CH02_B13_L0023", "speaker_id": "rhazek", "text": "Not information you need.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO OWNS THE ORDER]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 99}},
{"beat_id": "CH02_B13_L0024", "speaker_id": "cyanis", "text": "You put people in cages. I think we passed \"need.\"", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO OWNS THE ORDER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 101}},
{"beat_id": "CH02_B13_L0025", "speaker_id": "rhazek", "text": "You found a holding site and mistook access for authority.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO OWNS THE ORDER]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 105}},
{"beat_id": "CH02_B13_L0026", "speaker_id": "torren", "text": "Transit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[WHO OWNS THE ORDER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 109}},
{"beat_id": "CH02_B13_L0027", "speaker_id": "rhazek", "text": "West stair.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE MASKED OFFICER LEAVES]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 123}},
{"beat_id": "CH02_B13_L0028", "speaker_id": "rhazek", "text": "Get the wounded clear of the upper corridor. Keep the road gate secured. No one abandons a post to chase intruders through the lower levels.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE MASKED OFFICER LEAVES]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 127}},
{"beat_id": "CH02_B13_L0029", "speaker_id": "masked_officer", "text": "Commander.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE MASKED OFFICER LEAVES]", "source_speaker_label": "MASKED OFFICER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 129}},
{"beat_id": "CH02_B13_L0030", "speaker_id": "rhazek", "text": "You came for me. Stay focused.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE MASKED OFFICER LEAVES]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 135}},
{"beat_id": "CH02_B13_L0031", "speaker_id": "torren", "text": "Gate first after this.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE MASKED OFFICER LEAVES]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 141}},
{"beat_id": "CH02_B13_L0032", "speaker_id": "cyanis", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE MASKED OFFICER LEAVES]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 143}},
{"beat_id": "CH02_B13_L0033", "speaker_id": "ilyra", "text": "After this.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE MASKED OFFICER LEAVES]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 147}},
{"beat_id": "CH02_B13_L0034", "speaker_id": "rhazek", "text": "You disrupted my fort. That is not the same as taking it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NOTHING LEFT TO DISCUSS]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 155}},
{"beat_id": "CH02_B13_L0035", "speaker_id": "cyanis", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NOTHING LEFT TO DISCUSS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 157}},
{"beat_id": "CH02_B13_L0036", "speaker_id": "cyanis", "text": "That's why we're still here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NOTHING LEFT TO DISCUSS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 161}},
{"beat_id": "CH02_B13_L0037", "speaker_id": "rhazek", "text": "The prisoners are not leaving through that gate.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NOTHING LEFT TO DISCUSS]", "source_speaker_label": "RHAZEK", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 165}},
{"beat_id": "CH02_B13_L0038", "speaker_id": "ilyra", "text": "They are.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[NOTHING LEFT TO DISCUSS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/BEAT_13_RHAZEK_MASKED_OFFICER_REHEARSAL_FIRST_WORKING_DIALOGUE.md", "source_line": 167}},
