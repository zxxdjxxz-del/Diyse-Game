beats = [
{"beat_id": "CH02_B09_L0001", "speaker_id": "dunmere_woman", "text": "Quiet.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 14}},
{"beat_id": "CH02_B09_L0002", "speaker_id": "dunmere_woman", "text": "Who the hell are you?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 18}},
{"beat_id": "CH02_B09_L0003", "speaker_id": "cyanis", "text": "Not Host. We're getting you out.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 20}},
{"beat_id": "CH02_B09_L0004", "speaker_id": "dunmere_woman", "text": "Then explain the wall later. Doors first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 24}},
{"beat_id": "CH02_B09_L0005", "speaker_id": "cyanis", "text": "Agreed.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 26}},
{"beat_id": "CH02_B09_L0006", "speaker_id": "wounded_soldier", "text": "Gallery watch has the keys. Around the bend. Usually two down here. Could be more with the alarm.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 30}},
{"beat_id": "CH02_B09_L0007", "speaker_id": "torren", "text": "Anything past that you actually know?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 34}},
{"beat_id": "CH02_B09_L0008", "speaker_id": "wounded_soldier", "text": "Not from in here.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 38}},
{"beat_id": "CH02_B09_L0009", "speaker_id": "torren", "text": "Good enough.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 40}},
{"beat_id": "CH02_B09_L0010", "speaker_id": "ilyra", "text": "When the door's open, can I look at that?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 44}},
{"beat_id": "CH02_B09_L0011", "speaker_id": "wounded_soldier", "text": "Please.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 48}},
{"beat_id": "CH02_B09_L0012", "speaker_id": "cyanis", "text": "Keys first.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — FIRST CONTACT]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 52}},
{"beat_id": "CH02_B09_L0013", "speaker_id": "dunmere_woman", "text": "Easy. I've got you.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 70}},
{"beat_id": "CH02_B09_L0014", "speaker_id": "maevra", "text": "If you can stand on your own, make room for someone who can't. Pair up before anybody starts wandering.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 76}},
{"beat_id": "CH02_B09_L0015", "speaker_id": "ilyra", "text": "Still all right with me checking it?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 82}},
{"beat_id": "CH02_B09_L0016", "speaker_id": "wounded_soldier", "text": "Yes.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 84}},
{"beat_id": "CH02_B09_L0017", "speaker_id": "cyanis", "text": "Is this everyone they brought here?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 90}},
{"beat_id": "CH02_B09_L0018", "speaker_id": "dunmere_woman", "text": "Everyone here now, maybe.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 94}},
{"beat_id": "CH02_B09_L0019", "speaker_id": "dunmere_woman", "text": "Not everyone they've brought through.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 98}},
{"beat_id": "CH02_B09_L0020", "speaker_id": "dunmere_woman", "text": "Groups leave. Different days, different sizes. Guards take them upstairs through the fort. Nobody comes back down.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 104}},
{"beat_id": "CH02_B09_L0021", "speaker_id": "greenhollow_man", "text": "We never find out where they went.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "GREENHOLLOW MAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 108}},
{"beat_id": "CH02_B09_L0022", "speaker_id": "cyanis", "text": "Who gives the orders here?", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 114}},
{"beat_id": "CH02_B09_L0023", "speaker_id": "wounded_soldier", "text": "Commander Rhazek. Seen him down here twice. Guards report to him when he comes through.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "WOUNDED SOLDIER", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 118}},
{"beat_id": "CH02_B09_L0024", "speaker_id": "torren", "text": "Shit.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 122}},
{"beat_id": "CH02_B09_L0025", "speaker_id": "cyanis", "text": "All right. Damn.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — OPEN THE CELLS]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 126}},
{"beat_id": "CH02_B09_L0026", "speaker_id": "dunmere_woman", "text": "That's your way in? We're not all making that.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE EXIT PROBLEM]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 136}},
{"beat_id": "CH02_B09_L0027", "speaker_id": "ilyra", "text": "No.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE EXIT PROBLEM]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 140}},
{"beat_id": "CH02_B09_L0028", "speaker_id": "ilyra", "text": "Some could. Some shouldn't. A few absolutely shouldn't.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE EXIT PROBLEM]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 144}},
{"beat_id": "CH02_B09_L0029", "speaker_id": "cyanis", "text": "Bastion has a real way out.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE EXIT PROBLEM]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 152}},
{"beat_id": "CH02_B09_L0030", "speaker_id": "torren", "text": "Has to. They're moving groups through it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE EXIT PROBLEM]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 154}},
{"beat_id": "CH02_B09_L0031", "speaker_id": "maevra", "text": "Which means the Host controls it.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE EXIT PROBLEM]", "source_speaker_label": "MAEVRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 156}},
{"beat_id": "CH02_B09_L0032", "speaker_id": "cyanis", "text": "We keep you down here somewhere we can defend. We take the proper exit from them. Then we come back.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE EXIT PROBLEM]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 162}},
{"beat_id": "CH02_B09_L0033", "speaker_id": "dunmere_woman", "text": "You come back.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE EXIT PROBLEM]", "source_speaker_label": "DUNMERE WOMAN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 166}},
{"beat_id": "CH02_B09_L0034", "speaker_id": "cyanis", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE EXIT PROBLEM]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 172}},
{"beat_id": "CH02_B09_L0035", "speaker_id": "cyanis", "text": "We come back.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[THE EXIT PROBLEM]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B09_PRISONER_GALLERIES_FIRST_CONTACT_DIALOGUE.md", "source_line": 176}}
]
