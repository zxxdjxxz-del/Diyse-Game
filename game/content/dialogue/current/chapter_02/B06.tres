{"beat_id": "CH02_B06_L0010", "speaker_id": "torren", "text": "Good.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LEVIATHAN CHAMBER APPROACH]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B06_ARCHIVE_DEPTHS_DIALOGUE.md", "source_line": 91}},
{"beat_id": "CH02_B06_L0011", "speaker_id": "cyanis", "text": "We need through.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LEVIATHAN CHAMBER APPROACH]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B06_ARCHIVE_DEPTHS_DIALOGUE.md", "source_line": 95}},
{"beat_id": "CH02_B06_L0012", "speaker_id": "ilyra", "text": "Then through.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — LEVIATHAN CHAMBER APPROACH]", "source_speaker_label": "ILYRA", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B06_ARCHIVE_DEPTHS_DIALOGUE.md", "source_line": 99}},
