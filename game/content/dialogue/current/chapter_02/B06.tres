{"beat_id": "CH02_B06_L0007", "speaker_id": "torren", "text": "Yeah.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — MOVEMENT IN THE WATER]", "source_speaker_label": "TORREN", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B06_ARCHIVE_DEPTHS_DIALOGUE.md", "source_line": 59}},
{"beat_id": "CH02_B06_L0008", "speaker_id": "cyanis", "text": "Of fucking course.", "left": {}, "right": {}, "active_side": "none", "advance_mode": "manual", "cues": {"pause_ms": 80, "interrupt": false, "implementation_flags": ["IN_WORLD_DIALOGUE"], "source_section": "[STORY TRIGGER — MOVEMENT IN THE WATER]", "source_speaker_label": "CYANIS", "source_path": "docs/03_DIALOGUE/PRODUCTION/CHAPTER_02/CH02_B06_ARCHIVE_DEPTHS_DIALOGUE.md", "source_line": 63}},
