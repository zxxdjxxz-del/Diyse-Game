FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
WORKDIR /app
COPY external-services/canary/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY external-services/canary/orchestrator.py /app/orchestrator.py
COPY external-services/canary/context /app/context
ENV PORT=8090
EXPOSE 8090
CMD ["python", "/app/orchestrator.py"]
